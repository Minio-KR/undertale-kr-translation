ds_map_add(global.text_data_en, "obj_royal_rabbitbounce_87", "* 미 안 해 ..^1.&  언 다 인 이 ^1, 정 말 ^1, 이  구 역 에&  인 간 이  있 다 고  해 서  말 야 ./");
ds_map_add(global.text_data_en, "obj_royal_rabbitbounce_88", "* 그 래 서 ^1, 정 말 이 지 ,^1 우 리 &  왕 실  근 위 대 가&  엘 리 베 이 터 를  막 고  있 지 ./");
ds_map_add(global.text_data_en, "obj_royal_rabbitbounce_89", "* 느 아 ^1! 엘 리 베 이 터 가  동 작 을&  하 든  말 든 , 저 흰  최 선 을&  다 하 겠 습 니 다 . 언 다 인 !/%%");
ds_map_add(global.text_data_en, "obj_royal_rabbitbounce_93", "* 정 말 이 지 ^1, 네 가  우 릴&  지 나 갈  방 법 은  없 다 ./");
ds_map_add(global.text_data_en, "obj_royal_rabbitbounce_94", "* 너 와  나  사 이  얘 긴 데 ...&* 저 쪽 의  끔 찍 한  실 험 실 을&  지 나 갈  수 는  있 을  거 야 ./");
ds_map_add(global.text_data_en, "obj_royal_rabbitbounce_95", "* 너 랑 ^1, 나 랑 ^1, 여 기  내  친 구&  사 이  얘 기 란  말 야 ./");
ds_map_add(global.text_data_en, "obj_royal_rabbitbounce_96", "* 내  비 밀 도  다&  말 해 주 거 든 ./%%");
ds_map_add(global.text_data_en, "obj_royal_rabbitbounce_101", "* 이 봐 ^1!&* 알 짱 거 리 지  마 !/");
ds_map_add(global.text_data_en, "obj_royal_rabbitbounce_102", "* 정 말 ^1, 농 담 이 야 ^1.&* 난  신 경  안  써 ^1. 정 말 ^1.&  마 음 껏  알 짱 거 리 라 구 ./%%");
ds_map_add(global.text_data_en, "obj_royal_rabbitbounce_107", "* 오 ^1, 이 봐 ./");
ds_map_add(global.text_data_en, "obj_royal_rabbitbounce_108", "* 우 리 ^1, 정 말 ^1,&  널  죽 이 려 는  그  기 계 의&  공 연 에  갈  거 거 든 ./");
ds_map_add(global.text_data_en, "obj_royal_rabbitbounce_109", "* 정 말 ^1, 언 다 인 에 겐&  말 하 지  말 아  줘 ^1.&  알 겠 지 ?/%%");
ds_map_add(global.text_data_en, "obj_royal_rabbitbounce_113", "* 말 하 지  않 았 지 ^1, 응 ...?/%%");
ds_map_add(global.text_data_en, "obj_royal_rabbitbounce_118", "* 언 다 인 이  왕 실  근 위 대 는&  해 체 될  거 래 ./");
ds_map_add(global.text_data_en, "obj_royal_rabbitbounce_119", "* 정 말 이 지 ^1, 젠 장 ..^1.&* 사 랑 과  평 화 에&  익 숙 해 져 야 겠 군 ./%%");
ds_map_add(global.text_data_en, "obj_saddragon_70", "* 그 래 ^1,&  오 늘  밤 은  집 에  가 지&  않 을  테 니 ... 음 .../");
ds_map_add(global.text_data_en, "obj_saddragon_71", "* 내  보 물  더 미 에  네 가&  데 워 먹 을  수  있 는&  피 자 가  있 었 을  텐 데 .../%%");
ds_map_add(global.text_data_en, "obj_saddragon_75", "* 음 ^1, 너 희  나 가 는&  길 이 라 고 ^1?/");
ds_map_add(global.text_data_en, "obj_saddragon_76", "* 나 중 에  따 라 가 야&  할  것  같 군 /%%");
ds_map_add(global.text_data_en, "obj_saddragon_81", "* 그 래 ^1,&  오 늘  밤 은  집 에  가 지&  않 을  테 니 ... 음 .../");
ds_map_add(global.text_data_en, "obj_saddragon_82", "* 사 실 ^1, 이 런  식 으 로 는&  내 일 도  집 에  갈  것^1,&  같 지  않 아 .../%%");
ds_map_add(global.text_data_en, "obj_sans_friendc_75", "* 어 ^1, 프 리 스 크 ^1.&  표 정 이  왜  그 래 ?/");
ds_map_add(global.text_data_en, "obj_sans_friendc_77", "\E2* 샌 즈 ^1, 프 리 스 크 가  제 게&  작 업 을  건  적 이  있 다 고&  말 했 었 나 요 ?/");
ds_map_add(global.text_data_en, "obj_sans_friendc_79", '\E8* 그  뒤 에  날&  "엄 마 "라 고&  불 렀 던  것 도 ?/');
ds_map_add(global.text_data_en, "obj_sans_friendc_81", "\E0* 정 말 로&  당 황 스 러 웠 어 요 ./");
ds_map_add(global.text_data_en, "obj_sans_friendc_83", "\E1* 아 , 이 런 ./");
ds_map_add(global.text_data_en, "obj_sans_friendc_85", "\E3세상에^1, 프리스크.../");
ds_map_add(global.text_data_en, "obj_sans_friendc_86", "\E0우리 관계를&새로운 국면으로&전환시키는구나./");
ds_map_add(global.text_data_en, "obj_sans_friendc_88", "\E1* 저 ^1, 토 리 ^1. 다 른&  당 황 스 러 웠 던&  이 야 기  있 나 요 ?/");
ds_map_add(global.text_data_en, "obj_sans_friendc_90", "\E0* 아 , 있 지 요 !/");
ds_map_add(global.text_data_en, "obj_sans_friendc_91", "\E1* 하 지 만 , 방 금  그 게  가 장&  믿 기 지  않 을&  이 야 기 인  것  같 아 요 ./");
ds_map_add(global.text_data_en, "obj_sans_friendc_92", "\E0* 나 한 테  매 력 을&  느 끼 는  이 가  있 다 니&  생 각 도  못 할  일 이 죠 ./");
ds_map_add(global.text_data_en, "obj_sans_friendc_94", "\E0* 에 헤 헤 .../");
ds_map_add(global.text_data_en, "obj_sans_friendc_95", "\E7* 에 헤 헤 헤 .../");
ds_map_add(global.text_data_en, "obj_sans_friendc_96", "\E1* 아 하 ^1! 아 하 하 ^1!&* 하 ^1! 하 !!!/");
ds_map_add(global.text_data_en, "obj_sans_friendc_97", "\E2* 아 ^1, 토 리 엘  님 ^1.&* 큰 코 다 치 실  거 예 요 ./%%");
ds_map_add(global.text_data_en, "obj_sans_friendc_102", "\E0* 여 어 ^1, 어 때 ^1.&  프 리 스 크 ?/");
ds_map_add(global.text_data_en, "obj_sans_friendc_103", "\E2* 막  네  얘 기&  중 이 었 어 ./");
ds_map_add(global.text_data_en, "obj_sans_friendc_104", "\E1* 토 리 엘 을  만 나 고  바 로&  '엄 마 '라 고  부 르 게&  해  달 라 고  했 다 지 ?/");
ds_map_add(global.text_data_en, "obj_sans_friendc_106", "\E1* 음 , 바 로 는  아 니 고 ./");
ds_map_add(global.text_data_en, "obj_sans_friendc_107", "\E0* 몇  분  지 나 서 요 ./");
ds_map_add(global.text_data_en, "obj_sans_friendc_109", "\E0* 프 리 스 크 ..^1.&* 하 나  말 해 줄 게 ./");
ds_map_add(global.text_data_en, "obj_sans_friendc_110", "\E2* 그 건 ^1, 어 ^1.&  누 군 가 랑  친 해 지 는&  최 고 의  방 법 은  아 냐 ./");
ds_map_add(global.text_data_en, "obj_sans_friendc_112", "\E3아니야???/");
ds_map_add(global.text_data_en, "obj_sans_friendc_114", "\E9* 파 피 루 스 ^1,&  다  끝 난  일 이 야 ./");
ds_map_add(global.text_data_en, "obj_sans_friendc_116", "\E4그래도요^1, 엄마!!!/");
ds_map_add(global.text_data_en, "obj_sans_friendc_118", "\E1* 말 대 답 하 는  것  봐 라 !/");
ds_map_add(global.text_data_en, "obj_sans_friendc_119", "\E6* 벽 에  가 서  손  들 고 ^1,&  서  있 어 , 파 피 루 스 !/");
ds_map_add(global.text_data_en, "obj_sans_friendc_121", "\E6네^1, 언다인 님./");
ds_map_add(global.text_data_en, "obj_sans_friendc_123", "\E1* 잠 깐 ^1!&* 진 짜 로  벽  쪽 에&  가 지  말 고 !!/");
ds_map_add(global.text_data_en, "obj_sans_friendc_125", "\E7도대체 뭘 해야&하는 거야!!!/%%");
ds_map_add(global.text_data_en, "obj_sans_friendc_131", "\E0* 프 리 스 크 , 토 리 가  내 게&  버 터 스 카 치  파 이&  만 드 는  법 을  알 려 준 대 ./");
ds_map_add(global.text_data_en, "obj_sans_friendc_133", "\E0* 오 ^1, 언 젠 가  모 두 에 게&  구 워 줘 봐 야 겠 어 요 !/");
ds_map_add(global.text_data_en, "obj_sans_friendc_135", "* .../");
ds_map_add(global.text_data_en, "obj_sans_friendc_137", "\E3* (오 -오 ^1, 그 거  정 말&  좋 은 데 .)/");
ds_map_add(global.text_data_en, "obj_sans_friendc_139", "\E3요리???/");
ds_map_add(global.text_data_en, "obj_sans_friendc_140", "\E0내가 도울 수 있어요?/");
ds_map_add(global.text_data_en, "obj_sans_friendc_142", "* 잠 깐 만 !!!/");
ds_map_add(global.text_data_en, "obj_sans_friendc_143", "\E6* 나 도  도 울  수&  있 어 요 !?/");
ds_map_add(global.text_data_en, "obj_sans_friendc_145", "\E0* 물 론 ^1!&* 함 께  요 리 하 는  것 도&  재 미 있 을  거 예 요 !/");
ds_map_add(global.text_data_en, "obj_sans_friendc_147", "\E9* (다 시  생 각 해 보 니 ^1,&  그 -그 냥  피 자 를&  주 문 해 야 겠 어 .)/%%");
ds_map_add(global.text_data_en, "obj_sans_friendc_154", "\E0* 미 안 ..^1.&* 말 할  시 간 이&  없 어 ^1, 프 리 스 크 ./");
ds_map_add(global.text_data_en, "obj_sans_friendc_155", "\E1* 지 금 은  일 해 야&  하 거 든 ./");
ds_map_add(global.text_data_en, "obj_sans_friendc_157", "\E4근데 일 안 하고&있잖아!!/");
ds_map_add(global.text_data_en, "obj_sans_friendc_159", "\E2* 그 래 ^1, 온  힘 을  다 해&  집 중 하 는  중 이 야 ./%%");
ds_map_add(global.text_data_en, "obj_sans_interactable1_68", "* 빨 리  가 는  게  좋 아 ^1.&* 다 시  돌 아 올  수 도  있 어 ^1.&* 그 렇 게  된 다 면 .../");
ds_map_add(global.text_data_en, "obj_sans_interactable1_69", "\E2* ...참  재 미 있 는&  농 담 들 을  더  듣 고&  있 어 야  할  거 야 ./%%");
ds_map_add(global.text_data_en, "obj_sans_interactable1_74", "* 왜  그 리  얼 어  있 어 ^1?&* 자 ^1, 더  이 상  두 려 워&  할  건  없 어 ./");
ds_map_add(global.text_data_en, "obj_sans_interactable1_75", "\E2* 그 냥  해 골 과&  무 서 운  괴 물 로  가 득 한&  어 두 운  동 굴 일  뿐 이 야 ./%%");
ds_map_add(global.text_data_en, "obj_sans_interactable1_79", "* 그 래 서 ?/%%");
ds_map_add(global.text_data_en, "obj_sans_interactable1_85", "* ...그 냥  이 렇 게  날&  쳐 다 만  보 고  있 을 래 ^1,&  아 님 ...?/%%");
ds_map_add(global.text_data_en, "obj_sans_prefinaldate_127", "* 끔 찍 한  에 러 /%%");
ds_map_add(global.text_data_en, "obj_sans_prefinaldate_297", "* 이 쪽 이 야 ^1.&* 내 가  지 름 길 을  알 지 ./%%");
ds_map_add(global.text_data_en, "obj_sans_room_114", "* 자 ^1, 이 건  중 요 하 니&  기 억 해  둬 ./");
ds_map_add(global.text_data_en, "obj_sans_room_115", "\W* 내  동 생 에 겐&  아 주  특 별 한&  \B필 살 기 \W가  있 어 ./");
ds_map_add(global.text_data_en, "obj_sans_room_116", "\W* 만 약  \L파 란 색  공 격\W 을  보 게&  된 다 면 , 움 직 이 지  않 으 면&  다 치 지  않 을  거 야 ./");
ds_map_add(global.text_data_en, "obj_sans_room_117", "* 기 억 하 기  쉬 운  방 법 이&  있 지 ./");
ds_map_add(global.text_data_en, "obj_sans_room_118", "\W* 정 지  표 지 판 을  상 상 해  봐 ^1.&* 정 지  표 지 판 을  보 면 ^1,&  넌  \R멈 춰\W ^1, 맞 지 ?/");
ds_map_add(global.text_data_en, "obj_sans_room_119", "\W* 정 지  표 지 판 은  \R빨 갛 잖 아\W .&* 대 신  \L파 란  표 지 판\W 을&  생 각 해  봐 ./");
ds_map_add(global.text_data_en, "obj_sans_room_120", "\W* 간 단 하 지 ^1, 안  그 래 ^1?&* 싸 우 게  된 다 면 ^1,&  \Y파 란  표 지 판\W 을  생 각 해 ./%%");
ds_map_add(global.text_data_en, "obj_sans_room_123", "* 기 억 해 ..^1.&* 파 란  정 지  표 지 판 ./%%");
ds_map_add(global.text_data_en, "obj_sans_room_128", "* ... 안 녕 ./%%");
ds_map_add(global.text_data_en, "obj_sans_room_135", "* 이 봐 ^1, 고 마 워 ..^1.&* 내  동 생 이  즐 거 워&  하 는  것  같 네 ./");
ds_map_add(global.text_data_en, "obj_sans_room_136", "* 그 나 저 나 ^1, 걔 가&  입 고  있 던  웃 기 는&  옷  봤 어 ?/");
ds_map_add(global.text_data_en, "obj_sans_room_137", "* 몇  주  전 에  있 던&  코 스 튬  파 티 를  위 해&  만 들 었 던  거 야 ./");
ds_map_add(global.text_data_en, "obj_sans_room_138", "* 그  이 후 로  다 른  옷 을&  입 으 려  하 지  않 아 .../");
ds_map_add(global.text_data_en, "obj_sans_room_139", '* 계 속  그 걸&  "전 투  육 체 "라 고&  부 르 면 서 ./');
ds_map_add(global.text_data_en, "obj_sans_room_140", "* 참 나 ./");
ds_map_add(global.text_data_en, "obj_sans_room_141", "\E1* 내  동 생  정 말&  죽 여 주 지  않 아 ?/%%");
ds_map_add(global.text_data_en, "obj_sans_room_145", "* 계 속  우 리  동 생 이 랑&  놀 아 줬 다 면  좋 았 을  텐 데 ./%%");
ds_map_add(global.text_data_en, "obj_sans_room_160", '* 내  동 생 을  달 래 주 려 고&  "어 린 이 용  끝 말 잇 기 "&  라 고  말 해  줘 서  고 마 워 ./');
ds_map_add(global.text_data_en, "obj_sans_room_161", '\E1* 어 제  걘  별 자 리 를&  "풀 려 고 " 하 는 데&  애 를  먹 고  있 었 지 ./%%');
ds_map_add(global.text_data_en, "obj_sans_room_166", "* 파 피 루 스 는 ..^1.&* ... 늘  독 특 한  곳 에 서&  힘 들 어 하 는  녀 석 이 라 ./");
ds_map_add(global.text_data_en, "obj_sans_room_167", '\E1* 어 제  걘  별 자 리 를&  "풀 려 고 " 하 는 데&  애 를  먹 고  있 었 지 ./%%');
ds_map_add(global.text_data_en, "obj_sans_room_175", "* 단 어  찾 기  같 은  건&  별 로  안  좋 아 하 나  봐 ^1,&  응 ?/");
ds_map_add(global.text_data_en, "obj_sans_room_176", "\E2* 나 도  그 래 ^1.&* 난  뭐 랄 까 , 신 문 의&  만 평 같 은  사 람 이 지 ./");
ds_map_add(global.text_data_en, "obj_sans_room_177", "\E0* .../");
ds_map_add(global.text_data_en, "obj_sans_room_178", "\E1* .../%%");
ds_map_add(global.text_data_en, "obj_sans_room_182", "\E1* 이 런 데 도 ^1, 여 전 히&  단 어  찾 기 를  좋 아 한 단 ^1,&  말 이 야 ...?/");
ds_map_add(global.text_data_en, "obj_sans_room_183", "\E0* 그 렇 다 면  네 가&  완 전 히  나 쁘 진&  않 다 는  뜻 이 겠 네 ./%%");
ds_map_add(global.text_data_en, "obj_sans_room_191", "* 사 실 ^1, 요 전 의  그&  스 파 게 티  말 이 야 ..^1./");
ds_map_add(global.text_data_en, "obj_sans_room_192", "* 내  동 생 치 곤&  그 렇 게  나 쁘 지&  않 은  맛 이 었 어 ./");
ds_map_add(global.text_data_en, "obj_sans_room_193", "* 요 리  교 습 을  듣 더 니 만 ^1,&  실 력 이  제 법  늘 던 걸 ./");
ds_map_add(global.text_data_en, "obj_sans_room_194", "\E1* 계 속 한 다 면 ^1, 아 마&  내 년 쯤 엔  먹 을  수  있 는  걸&  만 들 어 낼 지 도  모 르 지 ./%%");
ds_map_add(global.text_data_en, "obj_sans_room_198", "* 이 봐 ..^1.&* 퍼 즐 도  해  보 면&  정 말  재 밌 을  거 야 ./%%");
ds_map_add(global.text_data_en, "obj_sans_room_211", "* 그 렇 게  빨 리&  풀 어 버 리 다 니&  잘 했 어 ^1./");
ds_map_add(global.text_data_en, "obj_sans_room_212", "* 내  도 움 이  필 요 하 지 도&  않 았 잖 아 ./");
ds_map_add(global.text_data_en, "obj_sans_room_213", "* 좋 았 어 ^1, 왜 냐 하 면  난&  아 무 것 도  안  하 는  걸&  좋 아 하 거 든 ./%%");
ds_map_add(global.text_data_en, "obj_sans_room_217", "* ...너  퍼 즐  푸 는  걸&  정 말 ^1, 잘  하 나  봐 ?/");
ds_map_add(global.text_data_en, "obj_sans_room_218", "* 그 러 니 까 ./");
ds_map_add(global.text_data_en, "obj_sans_room_219", "* 이 걸  전 에 도&  풀 어 봤 을  리 가&  없 을  텐 데 ./%%");
ds_map_add(global.text_data_en, "obj_sans_room_223", "* 이 봐 ^1, 왜  도 와 달 라 고&  안  한  거 야 ?/");
ds_map_add(global.text_data_en, "obj_sans_room_224", "\E1* 바 로  여 기  있 었 잖 아 ./%%");
ds_map_add(global.text_data_en, "obj_sans_room_229", "* 거 뜬 하 지 ^1, 응 ?/%%");
ds_map_add(global.text_data_en, "obj_sans_room_237", "* 안 녕 ?/%%");
ds_map_add(global.text_data_en, "obj_sans_room_238", "* 참  활 동 적 이 구 나 ./%%");
ds_map_add(global.text_data_en, "obj_sans_room_246", "* 내  동 생 이  이 제&  무 슨  짓 을  할 지 는&  모 르 겠 다 ./");
ds_map_add(global.text_data_en, "obj_sans_room_247", "\W* 내 가  너 라 면 , 파 란  공 격 에&  대 해  확 실 히  이 해 하 려 고&  할  거 야 ./%%");
ds_map_add(global.text_data_en, "obj_sans_room_250", "* 자 ^1, 내  동 생 과 의  싸 움 에&  대 해  몇  가 지  조 언 을&  해  줄 게 ./");
ds_map_add(global.text_data_en, "obj_sans_room_251", "\E1* 싸 우 지  마 ^1.&* 이 해 했 지 ?/%%");
ds_map_add(global.text_data_en, "obj_sans_room_256", "\E1* 흐 음 .../");
ds_map_add(global.text_data_en, "obj_sans_room_257", "\E2* 좋 은  시 간 을  보 내 는  데&  네  도 움 은  필 요 하 지&  않 았 던  것  같 네 ./");
ds_map_add(global.text_data_en, "obj_sans_room_258", "\E3* .../");
ds_map_add(global.text_data_en, "obj_sans_room_259", "\E2* 저 기 ^1, 내 가&  생 각 해 봤 는 데  말 야 ./");
ds_map_add(global.text_data_en, "obj_sans_room_260", "\E1* 아 마  네 가  내  동 생 과&  곧  싸 우 게  될  것&  같 단  말 이 지 ./");
ds_map_add(global.text_data_en, "obj_sans_room_261", "\E2* 좀  와 닿 는  충 고 를&  해 줄 게 ./");
ds_map_add(global.text_data_en, "obj_sans_room_262", "\E3* 만 약  네 가  지 금&  가 고  있 는  그  길 로&  계 속  간 다 면 .../");
ds_map_add(global.text_data_en, "obj_sans_room_263", "* .../");
ds_map_add(global.text_data_en, "obj_sans_room_264", "\E4* 끔 찍 한  시 간 을&  보 내 게  될  거 야 ./%%");
ds_map_add(global.text_data_en, "obj_sans_room_280", "\E0* 젠 장 , 파 라 솔  좀&  가 져 올  걸  그 랬 네 ./");
ds_map_add(global.text_data_en, "obj_sans_room_281", "\E1* 태 양 빛 에  형 편 없 이&  타 고  있 다 구./%%");
ds_map_add(global.text_data_en, "obj_sans_sentry2_127", "* 끔 찍 한  에 러 /%%");
ds_map_add(global.text_data_en, "obj_sans_sentry2_134", "* 언 제  또  같 이&  보 내 자 구 ./%%");
ds_map_add(global.text_data_en, "obj_sans_sentry2_141", "\E3* 어 이 ^1, 네 가  한  일 은&  정 말  존 경 받 을  만 해 ./");
ds_map_add(global.text_data_en, "obj_sans_sentry2_142", "\E2* 고 맙 다 ./%%");
ds_map_add(global.text_data_en, "obj_sans_sentry2_306", "* 이 쪽 이 야 ^1.&* 내 가  지 름 길 을  알 지 ./%%");
ds_map_add(global.text_data_en, "obj_sansb_90", "* 아 무 거 나 .");
ds_map_add(global.text_data_en, "obj_sansb_252", "뭐 ^1?&내 가  가 만 히  서 서&맞 아 줄  거 라&생 각 했 어 ?/%%");
ds_map_add(global.text_data_en, "obj_sansb_256", "우 린  시 공 간 의&연 속 성 에&막 대 한  변 칙 이&있 다 는  걸  발 견 했 어 ./");
ds_map_add(global.text_data_en, "obj_sansb_257", "시 간 선 이  좌 충 우 돌&움 직 이 고 , 멈 추 고&다 시  시 작 하 지 .../%%");
ds_map_add(global.text_data_en, "obj_sansb_262", "\E4그 리 고  갑 자 기 ^1,&모 든  것 이  끝 나  버 려 ./%%");
ds_map_add(global.text_data_en, "obj_sansb_266", "\E4헤  헤  헤 .../");
ds_map_add(global.text_data_en, "obj_sansb_267", "\E5네 가  그 런  거 지 ^1, 응 ?/%%");
ds_map_add(global.text_data_en, "obj_sansb_272", "\E1넌  어 떤&느 낌 일 지  이 해&못  할 걸 ./%%");
ds_map_add(global.text_data_en, "obj_sansb_277", "\E4어 느  날  갑 자 기 ^1,&아 무  말  없 이 .../");
ds_map_add(global.text_data_en, "obj_sansb_278", "\E9모 든  게  리 셋 된 다 는&사 실 을  안 다 는  것&말 이 야 ./%%");
ds_map_add(global.text_data_en, "obj_sansb_284", "\E9이 봐 ^1. 난  진 작 에&되 돌 아 가 는  걸&포 기 했 어 ./%%");
ds_map_add(global.text_data_en, "obj_sansb_290", "\E4지 상 으 로&나 가 는  것 도&더 는  관 심  없 고 ./%%");
ds_map_add(global.text_data_en, "obj_sansb_296", "\E4나 간 다 고  한 들 .../");
ds_map_add(global.text_data_en, "obj_sansb_297", "\E5아 무 런  기 억  없 이 ^1,&다 시  여 기 로&되 돌 아 와  있 을&테 니 까 ^1. 그 렇 지 ?/%%");
ds_map_add(global.text_data_en, "obj_sansb_303", "\E1솔 직 히  말 하 자 면 .../");
ds_map_add(global.text_data_en, "obj_sansb_304", "\E4그 래 서  내 가&매 사 에  최 선 을&다 하 질  못  해 ./%%");
ds_map_add(global.text_data_en, "obj_sansb_310", "\E1...아 니 면  그 저&내  게 으 름 에  대 한&같 잖 은  변 명 인  건 가&...?/");
ds_map_add(global.text_data_en, "obj_sansb_311", "\E3알  게  뭐 야 ./%%");
ds_map_add(global.text_data_en, "obj_sansb_317", "\E4그 런 데 ..^1.&이 다 음 에  벌 어 질&일 을  알 고  있 자 니 .../");
ds_map_add(global.text_data_en, "obj_sansb_318", "\E9더  이 상  신 경  끄 고&있 기  어 렵 더 라 고 ./%%");
ds_map_add(global.text_data_en, "obj_sansb_334", "\E9으 ..^1.&그 나 저 나  말 이 야 .../");
ds_map_add(global.text_data_en, "obj_sansb_335", "\E1너 , 그 렇 게  휘 두 르 고&다 니 는  걸  참&좋 아 하 네 ^1, 그 렇 지 ?/");
ds_map_add(global.text_data_en, "obj_sansb_336", "\E0.../");
ds_map_add(global.text_data_en, "obj_sansb_337", "\E4잘  들 어 ./");
ds_map_add(global.text_data_en, "obj_sansb_338", "네 가  전 에 도  답 을&안  한  건  알 아 ^1,&하 지 만 .../");
ds_map_add(global.text_data_en, "obj_sansb_339", "\E4그  안  어 딘 가 에 서 ^1,&느 낄  수  있 어 ./");
ds_map_add(global.text_data_en, "obj_sansb_340", "\E0네  내 면 엔&희 미 하 게 나 마&착 한  사 람 이  있 어 ./");
ds_map_add(global.text_data_en, "obj_sansb_341", "\E4옳 은  일 을  하 려 고&했 던  어 떤  사 람 의&기 억 이 ./");
ds_map_add(global.text_data_en, "obj_sansb_342", "\E1다 른  시 간 선 에 서 는 ^1,&심 지 어 .../");
ds_map_add(global.text_data_en, "obj_sansb_343", "\E4친 구 였 을 지 도&모 를  사 람 이 ?/");
ds_map_add(global.text_data_en, "obj_sansb_344", "\E3제 발 ^1, 친 구 야 ./");
ds_map_add(global.text_data_en, "obj_sansb_345", "\E0나  기 억 나 ?/");
ds_map_add(global.text_data_en, "obj_sansb_346", "\E4제 발 ^1, 이 걸  듣 고&있 다 면 .../");
ds_map_add(global.text_data_en, "obj_sansb_347", "\E9그 냥  다&잊 어 버 리 자 고 ^1,&알 겠 지 ?/");
ds_map_add(global.text_data_en, "obj_sansb_348", "\E3그 냥  무 기 를  내 려 놔 ^1,&그 러 면 .../");
ds_map_add(global.text_data_en, "obj_sansb_349", "\E4뭐 ^1, 일 이  훨 씬&쉬 워 질  거 야 ./%%");
ds_map_add(global.text_data_en, "obj_sansb_353", "\E9으 ..^1.&그 러 니 까  말 이 야 .../");
ds_map_add(global.text_data_en, "obj_sansb_354", "\E1너 , 그 렇 게  휘 두 르 고&다 니 는  걸  참&좋 아 하 네 ^1, 그 렇 지 ?/");
ds_map_add(global.text_data_en, "obj_sansb_355", "\E0.../");
ds_map_add(global.text_data_en, "obj_sansb_356", "\E4잘  들 어 ./");
ds_map_add(global.text_data_en, "obj_sansb_357", "우 정 이 란  건 .../");
ds_map_add(global.text_data_en, "obj_sansb_358", "\E3정 말  위 대 한&거 잖 아 ^1, 그 렇 지 ?/");
ds_map_add(global.text_data_en, "obj_sansb_359", "그 만  싸 우 자 ./%%");
ds_map_add(global.text_data_en, "obj_sansb_380", "\E3뭐 ^1,&시 도 해 볼  만&했 어 ./");
ds_map_add(global.text_data_en, "obj_sansb_381", "\E5그 런  식 으 로&해  보 자 ^1, 이 거 지 ?/%%");
ds_map_add(global.text_data_en, "obj_sansb_384", "\E3와 ^1, 너  정 말&빡 쳤 구 나 .../");
ds_map_add(global.text_data_en, "obj_sansb_385", "\E4헤 헤 헤 .../");
ds_map_add(global.text_data_en, "obj_sansb_386", "\E5나 한 테  한  방&먹 었 었 나  봐 ?/");
ds_map_add(global.text_data_en, "obj_sansb_387", "\E4그 래 ^1,&어 쨌 거 나  네 가&돌 아 왔 다 는  건 .../");
ds_map_add(global.text_data_en, "obj_sansb_388", "\E1우 리 는  애 시 당 초&친 구 가  아 니 었 다 는&뜻 이 잖 아 ^1, 응 ?/");
ds_map_add(global.text_data_en, "obj_sansb_389", "\E4헤 ./");
ds_map_add(global.text_data_en, "obj_sansb_390", "\E9다 른  샌 즈 들 한 테 는&말 하 지  말 라 고 ^1,&알 겠 어 ?/%%");
ds_map_add(global.text_data_en, "obj_sansb_398", "\E4이 상 하 겠 지 만 ^1,&이  일  전 까 진  우 리 가&친 구 가  될  거 라 고&내 심  기 대 했 었 거 든 ./");
ds_map_add(global.text_data_en, "obj_sansb_399", "\E1시 간 이  불 규 칙 한  건&만 족 하 지  못 해 서&생 긴  일 이 라 고&늘  생 각 했 었 지 ./");
ds_map_add(global.text_data_en, "obj_sansb_400", "그 리 고  원 하 는  걸&얻 고  나 면 , 그  짓 을&멈 춰 줄  거 라&생 각 했 어 ./%%");
ds_map_add(global.text_data_en, "obj_sansb_405", "\E3아 마 도  녀 석 이&원 하 던  건 ..^1.&글 쎄 ./");
ds_map_add(global.text_data_en, "obj_sansb_406", "\M1좋 은  음 식 ^1,&따 뜻 한  농 담 ^1,&좋 은  친 구 들&이 었 으 려 나 ./%%");
ds_map_add(global.text_data_en, "obj_sansb_411", "\E4근 데  그 럴  리 가  없 지 ^1,&안  그 래 ?/");
ds_map_add(global.text_data_en, "obj_sansb_412", "\E5그 래 ^1, 넌  절 대&만 족 할  수  없 는&부 류 잖 아 ./%%");
ds_map_add(global.text_data_en, "obj_sansb_417", "\E5넌  계 속 해 서  시 간 선 을&쓰 고  버 리 고&또  쓰 고  버 리 고 ^1,&결 국 .../");
ds_map_add(global.text_data_en, "obj_sansb_418", "\E4뭐 ./");
ds_map_add(global.text_data_en, "obj_sansb_419", "\M1야 ./");
ds_map_add(global.text_data_en, "obj_sansb_420", "\E3내  말  잘  들 어 둬 ^1,&꼬 맹 아 ./");
ds_map_add(global.text_data_en, "obj_sansb_421", "언 젠 가 는 .../");
ds_map_add(global.text_data_en, "obj_sansb_422", "적 절 한  시 기 에&그 만 두 는  법 을&배 워 야  할  거 야 ./%%");
ds_map_add(global.text_data_en, "obj_sansb_423", "%%%");
ds_map_add(global.text_data_en, "obj_sansb_427", "\E3그 리 고  그  언 제 가&바 로  오 늘 이 지 ./%%");
ds_map_add(global.text_data_en, "obj_sansb_433", "\E4왜 냐 하 면 ..^1.&너 도  알 겠 지 만 ../");
ds_map_add(global.text_data_en, "obj_sansb_434", "\E1이  싸 움  정 말&지 긋 지 긋 하 거 든 ./%%");
ds_map_add(global.text_data_en, "obj_sansb_441", "\E4그 리 고  네 가  계 속&날  밀 어 붙 인 다 면 .../");
ds_map_add(global.text_data_en, "obj_sansb_442", "\X내\E3  \R필 살 기 \X를&사 용 할  수 밖 에&없 을  거 야 ./%%");
ds_map_add(global.text_data_en, "obj_sansb_448", "\X그\E3 래 ^1, \R필 살 기 \X.&어 디 서  많 이&들 어  봤 지 ?/");
ds_map_add(global.text_data_en, "obj_sansb_449", " \X그\E3 래 ^1, 준 비 하 라 고 ^1.& 이  다 음 번 에 ^1,& \R사 용\X 할  거 거 든 ./");
ds_map_add(global.text_data_en, "obj_sansb_450", "\E3그 러 니  보 기  싫 다 면 ^1,&지 금 이  죽 기  딱&좋 은  때 야 ./%%");
ds_map_add(global.text_data_en, "obj_sansb_456", "\E4자 ^1, 별  거  없 지 만&간 다 .../");
ds_map_add(global.text_data_en, "obj_sansb_457", "\E3준 비 됐 어 ?/");
ds_map_add(global.text_data_en, "obj_sansb_458", "\X이\E5 번  공 격 을  버 티 면 ^1,&내  \R필 살 기 \X를&보 여  주 지 !/%%");
ds_map_add(global.text_data_en, "obj_sansb_477", ".../");
ds_map_add(global.text_data_en, "obj_sansb_478", "나 한 테  자 비 를&베 푸 는  거 야 ?/");
ds_map_add(global.text_data_en, "obj_sansb_479", "\E1드 디 어 ./");
ds_map_add(global.text_data_en, "obj_sansb_480", "\E3친 구 ^1.&벗 ./");
ds_map_add(global.text_data_en, "obj_sansb_481", "\E4이  선 택 이 .../");
ds_map_add(global.text_data_en, "obj_sansb_482", "정 말  힘 든&결 정 이 었 다 는  거&알 아 ./");
ds_map_add(global.text_data_en, "obj_sansb_483", "네 가  쌓 아 온  것 들 을&전 부  무 너 뜨 리 는  것 ./");
ds_map_add(global.text_data_en, "obj_sansb_484", "\E0그 게  무 의 미 한  일 이&아 니 었 단  걸&알 아 줬 으 면  좋 겠 어 ./");
ds_map_add(global.text_data_en, "obj_sansb_485", "\M1.../");
ds_map_add(global.text_data_en, "obj_sansb_486", "\E3이 리  와 ^1, 친 구 ./%%");
ds_map_add(global.text_data_en, "obj_sansb_954", "* 계 속  공 격 하 자 .");
ds_map_add(global.text_data_en, "obj_sansb_956", "* 샌 즈 의  움 직 임 에 서&  점 차  피 로 감 이  느 껴 진 다 .");
ds_map_add(global.text_data_en, "obj_sansb_958", "* 샌 즈 의  움 직 임 이  점 점&  느 려 지 는  것  같 다 .");
ds_map_add(global.text_data_en, "obj_sansb_960", "* 전 환 점 인 가 .");
ds_map_add(global.text_data_en, "obj_sansb_962", "* 당 신 은  죄 악 이  등 을  타 고&  오 르 는  것 을  느 꼈 다 .");
ds_map_add(global.text_data_en, "obj_sansb_963", "* 당 신 은  죄 악 이  목 을  짓 누 르 는&  걸  느 꼈 다 .");
ds_map_add(global.text_data_en, "obj_sansb_964", "* 업 보 가  당 신 의&  혈 관 을  따 라  흐 른 다 .");
ds_map_add(global.text_data_en, "obj_sansb_965", "* 업 보 는  사 그 라 들 지 어 니 !");
ds_map_add(global.text_data_en, "obj_sansb_969", "* 진 짜  전 투 가&  드 디 어  시 작 된 다 .");
ds_map_add(global.text_data_en, "obj_sansb_971", "* 이 걸  읽 는  것 도&  시 간  낭 비 인  것  같 다 .");
ds_map_add(global.text_data_en, "obj_sansb_973", "* 샌 즈 는  정 말  피 곤 한  기 색 을&  보 이 기  시 작 했 다 .");
ds_map_add(global.text_data_en, "obj_sansb_975", "* 샌 즈 는  뭔 가  준 비 하 고  있 다 .");
ds_map_add(global.text_data_en, "obj_sansb_977", "* 샌 즈 는  필 살 기 를  사 용 할&  준 비 를  하 고  있 다 .");
ds_map_add(global.text_data_en, "obj_sansb_985", "* 샌 즈 가  당 신 에 게  자 비 를&  베 풀 고  있 다 .");
ds_map_add(global.text_data_en, "obj_sansb_1013", "* 샌 즈  1 ATK 1 DEF&* 가 장  쉬 운  적 ^1.&* 1 대 미 지 만  줄  수  있 다 ./");
ds_map_add(global.text_data_en, "obj_sansb_1014", "* 영 원 히  피 할  수 는  없 다 ^1.&* 계 속  공 격 하 자 ./^");
ds_map_add(global.text_data_en, "obj_sansb_1018", "* 샌 즈  1 ATK 1 DEF&* 가 장  쉬 운  적 ^1.&* 1 대 미 지 만  줄  수  있 다 ./^");
ds_map_add(global.text_data_en, "obj_sansb_1079", "정 말  아 름 다 운&날 이 야 ./");
ds_map_add(global.text_data_en, "obj_sansb_1080", "새 들 은  지 저 귀 고 ^1,&꽃 들 은  피 어 나 고 .../");
ds_map_add(global.text_data_en, "obj_sansb_1081", "이 런  날 엔 ^1, 너  같 은&꼬 마 들 은 .../%%");
ds_map_add(global.text_data_en, "obj_sansb_1084", "정 말  아 름 다 운&날 이 야 ./");
ds_map_add(global.text_data_en, "obj_sansb_1085", "새 들 은  지 저 귀 고 ^1,%%");
ds_map_add(global.text_data_en, "obj_sansb_1089", "준 비 됐 어 ?/%%");
ds_map_add(global.text_data_en, "obj_sansb_1152", "지 옥 에 서&불 타&버 려 야&해 ./%%");
ds_map_add(global.text_data_en, "obj_sansb_body_1446", "\E1흠 ./");
ds_map_add(global.text_data_en, "obj_sansb_body_1447", "\M1왜  다 들  처 음 부 터&강 한  공 격 을&쓰 지  않 는 지&모 르 겠 다 니 까 ./%%");
ds_map_add(global.text_data_en, "obj_sansb_body_1450", "\E3어 쨌 든 ^1, 내 가&말 한  대 로 ^1, 날 씨 가&참  좋 아 ./");
ds_map_add(global.text_data_en, "obj_sansb_body_1451", "\M1잠 깐  앉 아 서&쉬 는  건  어 때 ?/%%");
ds_map_add(global.text_data_en, "obj_sansb_body_1455", "그 럼  간 다 ./%%");
ds_map_add(global.text_data_en, "obj_sansb_body_1468", "* 당 신 은  끔 찍 한  시 간 을&  보 내 게  될  것  같 은&  기 분 이  든 다 .");
ds_map_add(global.text_data_en, "obj_sansb_body_2091", "헉 ..^1. 헉 .../");
ds_map_add(global.text_data_en, "obj_sansb_body_2092", "좋 아 ^1.&이 제  끝 이 야 ./");
ds_map_add(global.text_data_en, "obj_sansb_body_2093", "\X내\M1  \R필 살 기 \X를&사 용 해 야 겠 군 ./");
ds_map_add(global.text_data_en, "obj_sansb_body_2094", "\E3준 비 됐 어 ?/");
ds_map_add(global.text_data_en, "obj_sansb_body_2095", "\E4별  거  없 지 만  간 다 ./%%");
ds_map_add(global.text_data_en, "obj_sansb_body_2111", "\E1그 래 ./");
ds_map_add(global.text_data_en, "obj_sansb_body_2112", "\E1맞 아 ./");
ds_map_add(global.text_data_en, "obj_sansb_body_2113", "\E3말  그 대 로&별  거  없 는  거 야 ./");
ds_map_add(global.text_data_en, "obj_sansb_body_2114", "\E1그 리 고  어 떤  일 도&일 어 나 지  않 겠 지 ./");
ds_map_add(global.text_data_en, "obj_sansb_body_2115", "\E4헤  헤  헤 ..^1.&알 아  들 었 어 ?/");
ds_map_add(global.text_data_en, "obj_sansb_body_2116", "\E1내 가  널  이 길  수&없 다 는  걸  알 아 ./");
ds_map_add(global.text_data_en, "obj_sansb_body_2117", "\E4네  턴 이  돌 아 오 면 .../");
ds_map_add(global.text_data_en, "obj_sansb_body_2118", "\E9넌  날  죽 이 겠 지 ./");
ds_map_add(global.text_data_en, "obj_sansb_body_2119", "\E1그 래 서 ^1, 말 이 야 ./");
ds_map_add(global.text_data_en, "obj_sansb_body_2120", "\E4결 심 했 는 데 .../");
ds_map_add(global.text_data_en, "obj_sansb_body_2121", "네  턴 이  오 는  날 은&없 을  거 야 ^1.&절 대 로 ./");
ds_map_add(global.text_data_en, "obj_sansb_body_2122", "\E3세 상 이  끝 날  때 까 지&서  있 어 야  한 다 고&해 도 ,/");
ds_map_add(global.text_data_en, "obj_sansb_body_2123", "\E5네 가  포 기 할  때 까 지&난  계 속  내  턴 을&유 지 할  거 야 ./");
ds_map_add(global.text_data_en, "obj_sansb_body_2124", "\E1알 겠 지 ?/%%");
ds_map_add(global.text_data_en, "obj_sansb_body_2141", "\E9곧  지 루 해 질  거 야 ./");
ds_map_add(global.text_data_en, "obj_sansb_body_2142", "\E1아 직 까 지 도&지 루 해 지 지&않 았 다 면  말 이 야 ./");
ds_map_add(global.text_data_en, "obj_sansb_body_2143", "\E5하 지 만  조 금  있 으 면 ^1,&결 국  그 만 두 겠 지 ./%%");
ds_map_add(global.text_data_en, "obj_sansb_body_2161", "\E5너  같 은  부 류 는&잘  알 고  있 어 ./");
ds_map_add(global.text_data_en, "obj_sansb_body_2162", "\E1넌 ^1, 음 ^1, 결 의 가&매 우  강 해 ^1,&그 렇 지 ?/");
ds_map_add(global.text_data_en, "obj_sansb_body_2163", "\E4정 말 로  아 무 런&이 득 이  없 어 도 .../");
ds_map_add(global.text_data_en, "obj_sansb_body_2164", "\E3절 대  포 기 하 지&않 겠 지 ./");
ds_map_add(global.text_data_en, "obj_sansb_body_2165", "\E1정 확 히  말 하 자 면 .../");
ds_map_add(global.text_data_en, "obj_sansb_body_2166", "\E4무 슨  일 이  있 건 ^1,&계 속  나 아 가 겠 지 ./");
ds_map_add(global.text_data_en, "obj_sansb_body_2167", "\E9네  욕 망 이  선 하 든&나 쁘 든  간 에 .../");
ds_map_add(global.text_data_en, "obj_sansb_body_2168", "\E3단 지  네 가  할  수&있 다 고  믿 으 니 까 ./");
ds_map_add(global.text_data_en, "obj_sansb_body_2169", '\E1그 리 고&"할  수  있 으 니 까 ".../');
ds_map_add(global.text_data_en, "obj_sansb_body_2170", '\E9..."해 야 만  하 는 "&거 겠 지 ./%%');
ds_map_add(global.text_data_en, "obj_sansb_body_2188", "\E9하 지 만  이 젠 ^1,&넌  끝 까 지  왔 어 ./");
ds_map_add(global.text_data_en, "obj_sansb_body_2189", "\E4네  앞 에  남 은  건&이 제  없 어 ./");
ds_map_add(global.text_data_en, "obj_sansb_body_2190", "\E1그 래 서  말 이 야 ^1,&개 인 적 인&의 견 인 데 .../");
ds_map_add(global.text_data_en, "obj_sansb_body_2191", '\E3이 쯤 에 서  네  "결 의 "로&할  만 한  가 장&엄 청 난  일 이  뭐 겠 어 ?/');
ds_map_add(global.text_data_en, "obj_sansb_body_2192", "\E1그 건  모 든  걸&포 기 하 는  거 야 ./");
ds_map_add(global.text_data_en, "obj_sansb_body_2193", "\E3그 리 고 ..^1. (흐 암 )&말  그 대 로  다 른&일 이 나  하 는  거 지 ./%%");
ds_map_add(global.text_data_en, "obj_sansb_body_2344", "헤  헤  헤  헤 ^1,&너  진 짜 로  그 게&가 능 할  거 라  생 각 한");
ds_map_add(global.text_data_en, "obj_sansb_body_2495", ".../");
ds_map_add(global.text_data_en, "obj_sansb_body_2496", ".../");
ds_map_add(global.text_data_en, "obj_sansb_body_2497", ".../");
ds_map_add(global.text_data_en, "obj_sansb_body_2498", "뭐 .../");
ds_map_add(global.text_data_en, "obj_sansb_body_2499", "결 국  이 렇 게 ^1,&되 는  건 가 ?/");
ds_map_add(global.text_data_en, "obj_sansb_body_2500", ".../");
ds_map_add(global.text_data_en, "obj_sansb_body_2501", "그 냥 .../");
ds_map_add(global.text_data_en, "obj_sansb_body_2502", "경 고  안  했 다 고 만&하 지  말 아 줘 ./%%");
ds_map_add(global.text_data_en, "obj_sansb_body_2539", "뭐 ./");
ds_map_add(global.text_data_en, "obj_sansb_body_2540", "그 릴 비 에 나  가 야 겠 군 ./%%");
ds_map_add(global.text_data_en, "obj_sansb_body_2574", "파 피 루 스 ^1,&뭐  먹 고  싶 은  거&없 어 ?/%%");
ds_map_add(global.text_data_en, "obj_sansbyetrigger_124", "* 사 실 ^1, 이 봐 ..^1.&* 내  동 생 이  별 로 일 진&  몰 라 도 ^1, 부 탁  좀  들 어 줘 ./");
ds_map_add(global.text_data_en, "obj_sansbyetrigger_125", "* 내  생 각 엔 ..^1.&* 요 즘  동 생 이  좀  우 울 해&  보 이 는  것  같 아 서  말 야 .../");
ds_map_add(global.text_data_en, "obj_sansbyetrigger_126", "* 한  번 도  인 간 을  본  적 이&  없 거 든 ^1. 널  보 면  엄 청&  기 뻐 할  것  같 아 ./");
ds_map_add(global.text_data_en, "obj_sansbyetrigger_127", "* 걱 정  마 ^1, 녀 석 은&  위 험 하 지  않 아 ./");
ds_map_add(global.text_data_en, "obj_sansbyetrigger_128", "\E1* 그 러 려 고  한 다&  해 도  말 이 야 ./");
ds_map_add(global.text_data_en, "obj_sansbyetrigger_129", "\E0* 정 말  고 마 워 ^1.&* 먼 저  가  있 을 게 ./%%");
ds_map_add(global.text_data_en, "obj_sansbyetrigger_132", "\E0* 음 ^1, 거 두 절 미 하 고&  말 해 주 는  건 데 ,/");
ds_map_add(global.text_data_en, "obj_sansbyetrigger_133", "\E1* 내  동 생 이&  인 간 을  아 주  보 고&  싶 어 하 더 라 고 ./");
ds_map_add(global.text_data_en, "obj_sansbyetrigger_134", "\E2* 그 러 니 까 ^1, 도 와 줄&  사 람 이  필 요 해 ./");
ds_map_add(global.text_data_en, "obj_sansbyetrigger_135", "\E1* 네 가  인 간 인  척  좀  해 줘 ./%%");
ds_map_add(global.text_data_en, "obj_sanscheckpoint_98", "* 일 종 의  고 지 거 나&  감 시 탑 인  것  같 다 ./");
ds_map_add(global.text_data_en, "obj_sanscheckpoint_99", "* 안 쪽 에 는  케 첩 ^1,&  머 스 타 드 ^1, 렐 리 시  소 스&  병 들 이  놓 여  있 다 .../%%");
ds_map_add(global.text_data_en, "obj_sansdate3_116", "* 자 ^1, 여 기 까 지  왔 네 ./%%");
ds_map_add(global.text_data_en, "obj_sansdate3_124", "* 그 래 서 .../");
ds_map_add(global.text_data_en, "obj_sansdate3_125", "* 네  여 정 도  거 의&  끝 난  거 지 ^1, 응 ?/");
ds_map_add(global.text_data_en, "obj_sansdate3_126", "\E0* 정 말  집 에&  가 고  싶 겠 군 ./");
ds_map_add(global.text_data_en, "obj_sansdate3_127", "\E1* 자 ^1.&* 네  기 분  알 아 ^1, 친 구 ./");
ds_map_add(global.text_data_en, "obj_sansdate3_128", "\E0* 하 지 만 .../");
ds_map_add(global.text_data_en, "obj_sansdate3_129", "\E1* 때 론  주 어 진  걸  그 대 로&  받 아 들 이 는  게&  더  나 을  수 도  있 어 ./");
ds_map_add(global.text_data_en, "obj_sansdate3_130", "\E0* 이  아 래 에 는  음 식 도 ^1,&  마 실  것 도 ^1,&  친 구 도  있 는 데 .../");
ds_map_add(global.text_data_en, "obj_sansdate3_131", "* 네 가  해 야&  하 는  그  일 이 .../");
ds_map_add(global.text_data_en, "obj_sansdate3_132", "\E1* 그 렇 게  가 치  있 는&  일 일 까 ?/%%");
ds_map_add(global.text_data_en, "obj_sansdate3_149", "* .../");
ds_map_add(global.text_data_en, "obj_sansdate3_150", "\E1* 아 ^1, 잊 어 버 려 ./");
ds_map_add(global.text_data_en, "obj_sansdate3_151", "\E0* 널  정 말 로&  응 원 하 고  있 어 ^1, 꼬 맹 이 ./%%");
ds_map_add(global.text_data_en, "obj_sansdate3_168", "* 저 기 ./");
ds_map_add(global.text_data_en, "obj_sansdate3_169", "\E1* 이 야 기  하 나  해  주 지 ./");
ds_map_add(global.text_data_en, "obj_sansdate3_170", "\E0* 그 래 , 난  스 노 우 딘  숲 을&  정 찰 하 잖 아 ^1. 그 렇 지 ?/");
ds_map_add(global.text_data_en, "obj_sansdate3_171", "* 거 기  앉 아 서  인 간 들 이&  있 는 지  감 시 해 ^1.&* 참  지 루 한  일 이 야 ./");
ds_map_add(global.text_data_en, "obj_sansdate3_172", "\E2* 다 행 히 도 ^1,&  숲  깊 숙 히  들 어 가 면 .../");
ds_map_add(global.text_data_en, "obj_sansdate3_173", "\E0* 커 다 란  잠 긴  문 이&  있 단  말 야 ./");
ds_map_add(global.text_data_en, "obj_sansdate3_174", "* 노 크  장 난 을  연 습 하 기 에&  완 벽 한  곳 이 지 ./");
ds_map_add(global.text_data_en, "obj_sansdate3_175", "* 그 래 서  어 느  날 ^1,&  평 소 처 럼  노 크 를&  하 는  중 이 었 어 ./");
ds_map_add(global.text_data_en, "obj_sansdate3_176", "* 문 을  두 드 리 며&  '똑 똑 '이 라 고  말  했 지 ./");
ds_map_add(global.text_data_en, "obj_sansdate3_177", "* 그 런 데 ^1, 갑 자 기&  반 대 편 에 서 .../");
ds_map_add(global.text_data_en, "obj_sansdate3_178", "* 한  여 자 의  목 소 리 가&  들 려 오 는  거 야 ./");
ds_map_add(global.text_data_en, "obj_sansdate3_179", '\Tt*\E0 "누 구 세 요 ?" /');
ds_map_add(global.text_data_en, "obj_sansdate3_180", "\Ts*\E1 그 래 서 ^1, 난 ^1,&  자 연 스 레  답 했 지 ./");
ds_map_add(global.text_data_en, "obj_sansdate3_181", "\E0* 마 요 네 즈 요 ./");
ds_map_add(global.text_data_en, "obj_sansdate3_182", "\Tt* 무 슨  마 요 네 즈 ?/");
ds_map_add(global.text_data_en, "obj_sansdate3_183", "\Ts*\E2 썰 렁 한  농 담 이 니 까&  듣 지  '마 요 './");
ds_map_add(global.text_data_en, "obj_sansdate3_184", "\E0* 그 러 니 까  숨 이&  넘 어 갈  정 도 로&  웃 더 라 고 ./");
ds_map_add(global.text_data_en, "obj_sansdate3_185", "\E1* 꼭  한  백  년  만 에&  들 어 본  최 고 의&  농 담 인  것 처 럼 ./");
ds_map_add(global.text_data_en, "obj_sansdate3_186", "\E0* 그 래 서  나 는  계 속&  했 고 ^1, 그  여 성 분 은&  계 속  웃 었 지 ./");
ds_map_add(global.text_data_en, "obj_sansdate3_187", "\E1* 내 가  본  이 래&  최 고 의  관 객 이 었 어 ./");
ds_map_add(global.text_data_en, "obj_sansdate3_188", "\E0* 그 리 고 , 한  열  개 쯤&  한  뒤 에 , '그  여 성 이 '&  말 하 길 .../");
ds_map_add(global.text_data_en, "obj_sansdate3_189", '\Tt* "똑 똑 "/');
ds_map_add(global.text_data_en, "obj_sansdate3_190", '\Ts*\E1 "누 구 세 요 ?" 라 고&  말 했 지 ./');
ds_map_add(global.text_data_en, "obj_sansdate3_191", '\Tt*\E0 "괴 물 이 요 !"/');
ds_map_add(global.text_data_en, "obj_sansdate3_192", '\Ts*\E1 "무 슨  괴 물 ?"/');
ds_map_add(global.text_data_en, "obj_sansdate3_193", "\Tt*\E2 '똑 똑 ' 한&  괴 물 이 요 !/");
ds_map_add(global.text_data_en, "obj_sansdate3_194", "\Ts*\E1 와 우 ./");
ds_map_add(global.text_data_en, "obj_sansdate3_195", "\E2* 말 할  것 도  없 이 ^1,&  그  여 자 는  정 말&  대 단 했 어 ./");
ds_map_add(global.text_data_en, "obj_sansdate3_196", "\E0* 우 리 는  몇  시 간 동 안&  계 속  서 로 에 게&  농 담 을  했 지 ./");
ds_map_add(global.text_data_en, "obj_sansdate3_197", "\E0* 잠 시  뒤 ^1,&  가 야  할  때 가  됐 어 ./");
ds_map_add(global.text_data_en, "obj_sansdate3_198", "\E2* 파 피 루 스 는  자 기  전 에&  옛 날  얘 기  안  해 주 면&  삐 지 거 든 ./");
ds_map_add(global.text_data_en, "obj_sansdate3_199", "\E0* 하 지 만  그  여 자 가&  또  오 라 고  해 서 ^1,&  또  갔 어 ./");
ds_map_add(global.text_data_en, "obj_sansdate3_200", "\E0* 그 리 고  또  갔 어 ^1.&* 그 리 고  또 ^1.&* 일 과 가  되 었 지 ./");
ds_map_add(global.text_data_en, "obj_sansdate3_201", "* 문  너 머 로&  썰 렁 한  농 담  하 는  거&  말 이 야 ./");
ds_map_add(global.text_data_en, "obj_sansdate3_202", "\E1* 최 고 라 고 ./%%");
ds_map_add(global.text_data_en, "obj_sansdate3_221", "* .../");
ds_map_add(global.text_data_en, "obj_sansdate3_222", "\E0* 그 런 데  하 루 는 ^1,&  그 분 이  별 로&  웃 질  않 았 어 ./");
ds_map_add(global.text_data_en, "obj_sansdate3_223", "* 무 슨  일 이 냐 고&  물 어  봤 지 ./");
ds_map_add(global.text_data_en, "obj_sansdate3_224", "* 그 러 자  이 상 한  얘 기 를&  하 는  거 야 ./");
ds_map_add(global.text_data_en, "obj_sansdate3_225", "* \Tt만 약  인 간 이  이  문&  너 머 로  나 온 다 면 .../");
