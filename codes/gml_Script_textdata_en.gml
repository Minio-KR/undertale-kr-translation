ds_map_add(global.text_data_en, "obj_jerry_164", "얘 들 아 , 추 운 데&아 무 도  신 경  안  써 ?");
ds_map_add(global.text_data_en, "obj_jerry_165", "우 리  여 기 서&뭐 하 는  거 야 ?&정 말  실 망 이 네 .");
ds_map_add(global.text_data_en, "obj_jerry_166", "와 , 너 희 들  완 전&젬 병 이 네 .");
ds_map_add(global.text_data_en, "obj_jerry_167", "쉬 이 이 잇 ! 나&생 각  중 이 잖 아 ,&얘 들 아 !!");
ds_map_add(global.text_data_en, "obj_jerry_168", "에 -휴 .");
ds_map_add(global.text_data_en, "obj_jerry_171", "너 ... 나  좀&집 에  바 래 다&줄  수  있 어 ?");
ds_map_add(global.text_data_en, "obj_jerry_172", "허 ? 쟤 네  나&버 리 고  간  거 야 ...?&친 구 들 !");
ds_map_add(global.text_data_en, "obj_jerry_173", "이 -상 해 .");
ds_map_add(global.text_data_en, "obj_jerry_174", "음 , 그 러 니 까 , 너&여 기 서  대 체&뭐 하 는  거 야 ?");
ds_map_add(global.text_data_en, "obj_jerry_175", "여 기  와 이 파 이&구 려 .");
ds_map_add(global.text_data_en, "obj_jerry_199", "하 하 하 !&재 밌 는 &말  또&해 봐 !");
ds_map_add(global.text_data_en, "obj_jerry_200", "하 하 ! 와 !&드 레 이 크 &너  못  한 다 !");
ds_map_add(global.text_data_en, "obj_jerry_201", "하 하 하 !&그  아 이 디 어 &어 디 서  났 어 !?!");
ds_map_add(global.text_data_en, "obj_jerry_207", "%%%");
ds_map_add(global.text_data_en, "obj_jerry_407", "* 제 리 는  가 루  묻 은  음 식 을&  먹 고  손 가 락 을  쩝 쩝 대 며&  핥 는 다 .");
ds_map_add(global.text_data_en, "obj_jerry_408", "* 제 리 는  입 을  막 지  않 고&  기 침 을  한 다 .");
ds_map_add(global.text_data_en, "obj_jerry_409", "* 제 리 는  화 장 실 에  갈  거 라 고&  모 두 에 게  말 한 다 .");
ds_map_add(global.text_data_en, "obj_jerry_410", "* 제 리 는  하 품 을  한 다 .");
ds_map_add(global.text_data_en, "obj_jerry_411", "* 제 리 ... 냄 새 가  난 다 .");
ds_map_add(global.text_data_en, "obj_jerry_412", "* 제 리 는  다 쳤 다 .");
ds_map_add(global.text_data_en, "obj_jerry_414", "* 다 른  괴 물 들 은&  제 리 가  없 어 져 서 &  기 뻐 하 고  있 다 .");
ds_map_add(global.text_data_en, "obj_jerry_415", "* 제 리 의  귀 환 .");
ds_map_add(global.text_data_en, "obj_jerry_442", "* 제 리  - ATK 0 DEF 30&* 모 두 가  제 리 를  알 고  있 다 .&* 공 격 이  2초  더  지 속 된 다 ./^");
