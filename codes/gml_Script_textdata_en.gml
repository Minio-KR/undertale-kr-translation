ds_map_add(global.text_data_en, "obj_torieltrigger5_194", "* 이 리  오 렴 ^1, 아 가 야 !/%%");
ds_map_add(global.text_data_en, "obj_torieltrigger5_260", "* 아 , 이 런 ^1, 생 각 보 다&  오 래  걸 렸 네 ./%%");
ds_map_add(global.text_data_en, "obj_torieltrigger6_39", "* 저  냄 새 를  맡 았 니 ^1?/");
ds_map_add(global.text_data_en, "obj_torieltrigger6_40", "* 놀 랐 지 !/");
