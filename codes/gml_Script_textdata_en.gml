ds_map_add(global.text_data_en, "SCR_TEXT_7016", "* 연 결  중 ...\TT /");
ds_map_add(global.text_data_en, "SCR_TEXT_7017", "\F1 %");
ds_map_add(global.text_data_en, "SCR_TEXT_7018", "* 음 ^1, 이  순 한&  아 가 야 ./");
ds_map_add(global.text_data_en, "SCR_TEXT_7019", "* 얘 기 하 고  싶 은  거 면 ^1,&  여 기  있 으 니  말 하 렴 ./");
ds_map_add(global.text_data_en, "SCR_TEXT_7020", "\TS \F0 \T0 %");
ds_map_add(global.text_data_en, "SCR_TEXT_7021", "* 삑 .../%%");
ds_map_add(global.text_data_en, "SCR_TEXT_7025", "* 연 결  중 ... /");
ds_map_add(global.text_data_en, "SCR_TEXT_7026", "* ... /");
ds_map_add(global.text_data_en, "SCR_TEXT_7027", "* (어 디 엔 가 ^1, 신 호 가&  개 에  막 혀  있 다 .)/%%");
ds_map_add(global.text_data_en, "SCR_TEXT_7040", "* (응 답 이  없 다 ^1.)&* (전 화 기  배 터 리 가&  다  된  것  같 다 .)/%%");
ds_map_add(global.text_data_en, "SCR_TEXT_7052", "* (박 스 가  개 털 로&  막 혀  있 다 .)/%%");
ds_map_add(global.text_data_en, "SCR_TEXT_7079", "* 연 습 용  인 형 과  만 났 다 !");
ds_map_add(global.text_data_en, "SCR_TEXT_7080", "%%%");
ds_map_add(global.text_data_en, "SCR_TEXT_7084", "* 프 로 깃 이  당 신 을  공 격 했 다 !");
ds_map_add(global.text_data_en, "SCR_TEXT_7085", "%%%");
ds_map_add(global.text_data_en, "SCR_TEXT_7089", "* 프 로 깃 이  근 처 로  뛰 어 왔 다 !");
ds_map_add(global.text_data_en, "SCR_TEXT_7090", "%%%");
ds_map_add(global.text_data_en, "SCR_TEXT_7094", "* 윔 선 이  순 하 게  다 가 왔 다 !");
ds_map_add(global.text_data_en, "SCR_TEXT_7095", "%%%");
ds_map_add(global.text_data_en, "SCR_TEXT_7099", "* 프 로 깃 과  윔 선 이  다 가 왔 다 !");
ds_map_add(global.text_data_en, "SCR_TEXT_7100", "%%%");
ds_map_add(global.text_data_en, "SCR_TEXT_7104", "* 몰 드 스 멀 이  길 을  막 아 섰 다 !");
ds_map_add(global.text_data_en, "SCR_TEXT_7105", "%%%");
ds_map_add(global.text_data_en, "SCR_TEXT_dogshrine_5913", "* (개  신 사 다 .)/");
ds_map_add(global.text_data_en, "SCR_TEXT_dogshrine_5914", "* (기 부 할 까 ?)& &         개 부 한 다     하 지  않 는 다 \C");
ds_map_add(global.text_data_en, "SCR_TEXT_dogshrine_5919", "* (\[2]G 중  \[1]G를 &  기 부 했 다 .)&         개 부 한 다     하 지  않 는 다 \C");
ds_map_add(global.text_data_en, "SCR_TEXT_dogshrine_5924", "* (기 부 금 으 로  줄  전 구 를 &  산  모 양 이 다 .)/");
ds_map_add(global.text_data_en, "SCR_TEXT_dogshrine_5925", "* (저 번 에 는  꽤  어 두 웠 다 .)/");
ds_map_add(global.text_data_en, "SCR_TEXT_dogshrine_5933", "* (기 부 금 으 로  신 사  규 모 를 &  확 장 한  모 양 이 다 .)/");
ds_map_add(global.text_data_en, "SCR_TEXT_dogshrine_5941", "* (이 제  모 금 함  구 멍 이 &  훨 씬  커 졌 다 .)/");
ds_map_add(global.text_data_en, "SCR_TEXT_dogshrine_5942", "* (기 부 금 을  한  번 에 &  더  많 이  넣 을  수  있 겠 다 !)/");
ds_map_add(global.text_data_en, "SCR_TEXT_dogshrine_5943", "* (... 사 실 은 ^1, 그 냥  구 멍 의  양 옆 을 &  그 려 넣 은  모 양 이 다 ...)/");
ds_map_add(global.text_data_en, "SCR_TEXT_dogshrine_5944", "* (여 전 히  1G씩 &  기 부 해 야  하 는  듯 하 다 ...)/");
ds_map_add(global.text_data_en, "SCR_TEXT_dogshrine_5954", "* (모 금 함 이  봉 해 졌 다 .)/");
ds_map_add(global.text_data_en, "SCR_TEXT_dogshrine_5955", "* (아 무 런  의 미 도 &  없 었 던  것  같 다 ...)/%");
ds_map_add(global.text_data_en, "SCR_TEXT_dogshrine_5958", "* (모 험 을  마 치 고  보 니 ^1,&  멍 멍 이 의 &  신 사 가  얼 마 나  도 움 이  됐 는 지 가 &  새 록 새 록  떠 오 른 다 ...)/");
ds_map_add(global.text_data_en, "SCR_TEXT_dogshrine_5959", "* (... 전 혀  도 움 이  안  됐 다 .)/%");
ds_map_add(global.text_data_en, "SCR_TEXT_dogshrine_5970", "* (모 금 함 에  문 제 가  생 겼 다 .)/%");
ds_map_add(global.text_data_en, "SCR_TEXT_dogshrine_5977", "* (모 금 함 이  가 득  찼 다 .)/%");
ds_map_add(global.text_data_en, "SCR_TEXT_dogshrine_5982", "* (돈 이  부 족 하 다 .)/");
ds_map_add(global.text_data_en, "SCR_TEXT_dogshrine_5983", "* (안 심 이  된 다 ...)/%");
ds_map_add(global.text_data_en, "SCR_TEXT_dogshrine_5993", "* (당 신 은  1G를  기 부 했 다 .)/%");
ds_map_add(global.text_data_en, "SCR_TEXT_dogshrine_5997", "* (당 신 은  1G를 &  모 금 함 에  넣 었 다 .)/");
ds_map_add(global.text_data_en, "SCR_TEXT_dogshrine_5998", "* (엄 청 나 게  시 간  낭 비 를 &  할  듯 한  예 감 이  든 다 ...)/%");
ds_map_add(global.text_data_en, "SCR_TEXT_dogshrine_6003", "* (짤 랑 !)&* (모 금 함 에  동 전 을  채 웠 다 .)/");
ds_map_add(global.text_data_en, "SCR_TEXT_dogshrine_6004", "* (떠 났 다 가  다 시  오 면 ^1,&  기 부 금 이  무 언 가 에 &  사 용 되 어  있 을 지 도  모 른 다 .)/%");
ds_map_add(global.text_data_en, "SCR_TEXT_dogshrine_6015", "* (당 신 은  안 도 감 을  느 낀 다 .)/%");
ds_map_add(global.text_data_en, "SCR_TEXT_dogshrine_6024", "* (모 금 함 이 다 .)& &         이 용 한 다     그 냥  둔 다 \C");
ds_map_add(global.text_data_en, "SCR_TEXT_dogshrine_6031", "* (... 손 이  들 어 가 지  않 는 다 .)/");
ds_map_add(global.text_data_en, "SCR_TEXT_dogshrine_6032", "* (다 시  확 인 하 면 &  기 부 할  수  있 다 .)/%");
ds_map_add(global.text_data_en, "SCR_TEXT_dogshrine_6037", "* (옳 지 .)/%");
ds_map_add(global.text_data_en, "SCR_TEXT_dogshrine_6045", "* (붐 박 스 가  틀 어 져  있 다 ...)&* (신 나 는  곡 이 다 .)/");
ds_map_add(global.text_data_en, "SCR_TEXT_dogshrine_6046", "* (당 신 의  기 부  욕 구 를 &  심 리 적 으 로  자 극 하 고  있 다 .)/");
ds_map_add(global.text_data_en, "SCR_TEXT_dogshrine_6047", "* (... 어 떤  자 극 인 지 &  확 실 치  않 다 .)/");
ds_map_add(global.text_data_en, "SCR_TEXT_dogshrine_6048", "* (트 랙 을  바 꿀 까 ?)& &         바 꾼 다       그 냥  둔 다 \C");
ds_map_add(global.text_data_en, "SCR_TEXT_dogshrine_6059", "* (으 응 !?)&* (다 음  트 랙 은  같 은  곡 의 &  빠 른  버 전 일  뿐 이 다 ...!?)/%");
ds_map_add(global.text_data_en, "SCR_TEXT_dogshrine_6065", "* (당 신 은  바 꿀  이 유 를  모 르 겠 다 .)/%");
ds_map_add(global.text_data_en, "SCR_TEXT_dogshrine_6070", "* (당 신 은  곡 을  원 래 대 로 &  돌 려 놓 았 다 .)/%");
ds_map_add(global.text_data_en, "SCR_TEXT_dogshrine_6076", "* (\[1]G가  들 어 있 다 .)& &         기 부 한 다     하 지  않 는 다 \C");
ds_map_add(global.text_data_en, "SCR_TEXT_dogshrine_6095", "* (1G를  집 어 넣 었 다 .)/%");
ds_map_add(global.text_data_en, "SCR_TEXT_dogshrine_6101", "* (골 드 가  부 족 하 다 .)/%");
ds_map_add(global.text_data_en, "SCR_TEXT_dogshrine_6106", "* (이 제  충 분 하 다 .)/%");
ds_map_add(global.text_data_en, "SCR_TEXT_dogshrine_6112", "* (아 무 것 도  넣 지  않 았 다 .)/%");
ds_map_add(global.text_data_en, "blt_sizebone_115", " THIS IS AN ERROR& MESSAGE^1.& REALLY!!!/%%");
ds_map_add(global.text_data_en, "blt_sizebone_118", " 너 너무 약하잖아!!& 너무 쉽게 잡혔어!!!/");
ds_map_add(global.text_data_en, "blt_sizebone_119", " 이제 널& 포획 구역으로& 보내도록 하지!!/");
ds_map_add(global.text_data_en, "blt_sizebone_120", " 샌즈 형이^1, 말한& 바로는^1.../");
ds_map_add(global.text_data_en, "blt_sizebone_121", " 우리 집& 창고라고& 하던가???/");
ds_map_add(global.text_data_en, "blt_sizebone_122", " 넌 이제& 개집으로 & 가는 거야!/");
ds_map_add(global.text_data_en, "blt_sizebone_123", " 니 예 헹 헤 헤& 헤 헹 헹 헤 !!!/%%");
ds_map_add(global.text_data_en, "blt_sizebone_127", " 그래!!^1! 전에는& 아주 영리하게& 감옥을 탈출할 수& 있었을지 몰라도.../");
ds_map_add(global.text_data_en, "blt_sizebone_128", " 이번에는^1, 시설을& 업그레이드& 해뒀지./");
ds_map_add(global.text_data_en, "blt_sizebone_129", " 넌 갇힐 뿐만& 아니라.../");
ds_map_add(global.text_data_en, "blt_sizebone_130", " 떠나고 싶지도& 않아질 걸!!!/");
ds_map_add(global.text_data_en, "blt_sizebone_131", " 니 예 헹 헤 헤& 헤 헹 헹 헤 !!!/%%");
ds_map_add(global.text_data_en, "blt_sizebone_136", " 너 정말...& 끈질기구나!/");
ds_map_add(global.text_data_en, "blt_sizebone_137", " 하지만^1!& 나에게는& 소용 없지!/");
ds_map_add(global.text_data_en, "blt_sizebone_138", " 내가 가장& 끈끈질기거든!/");
ds_map_add(global.text_data_en, "blt_sizebone_139", " 그리고 만약 네가& 가장 끈끈질기다고& 생각하고& 있었다면.../");
ds_map_add(global.text_data_en, "blt_sizebone_140", " 틀렸어^1!& 문법적으로& 틀렸다고!/");
ds_map_add(global.text_data_en, "blt_sizebone_141", " 왜냐하면& 올바른& 표현은.../");
ds_map_add(global.text_data_en, "blt_sizebone_142", " 가장 끈끈끈질긴& 파피루스만큼은& 끈끈질기지 않는다!/");
ds_map_add(global.text_data_en, "blt_sizebone_143", " 이 가르침이& 즐거웠길& 바라./");
ds_map_add(global.text_data_en, "blt_sizebone_144", " 니 예 헹 헤 헤& 헤 헹 헹 헤 !!!/%%");
ds_map_add(global.text_data_en, "obj_6book_master_384", "당 신 은&도 움 을 &요 청 &했 다 &...");
