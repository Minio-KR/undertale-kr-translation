ds_map_add(global.text_data_en, "SCR_TEXT_5669", "* (응 답 이  없 다 .)/%%");
ds_map_add(global.text_data_en, "SCR_TEXT_5676", "* (...)/");
ds_map_add(global.text_data_en, "SCR_TEXT_5677", "* (하 지 만  당 신 은&  적 당 한  걸  가 지 고&  있 지  않 다 .)/%%");
ds_map_add(global.text_data_en, "SCR_TEXT_5705", "* (문  앞 에  핫 도 그 를&  내 려 놓 았 다 .)/");
ds_map_add(global.text_data_en, "SCR_TEXT_5706", "* (하 얀  앞 발 이  문&  아 래 에 서  튀 어 나 왔 다 .)/");
ds_map_add(global.text_data_en, "SCR_TEXT_5707", "* (핫 도 그 를  문  안 쪽 으 로&  당 기 고  있 다 .)/");
ds_map_add(global.text_data_en, "SCR_TEXT_5708", "* (너 무  세 게  누 른  나 머 지&  핫 도 그 가  제 자 리 에 서&  돌 고  있 다 .)/");
ds_map_add(global.text_data_en, "SCR_TEXT_5709", "* (...)/");
ds_map_add(global.text_data_en, "SCR_TEXT_5710", "* (마 침 내  성 공 했 다 .)/");
ds_map_add(global.text_data_en, "SCR_TEXT_5711", "* (...)/");
ds_map_add(global.text_data_en, "SCR_TEXT_5712", "* (돌 이  갈 리 는&  소 리 가  들 린 다 .)/");
ds_map_add(global.text_data_en, "SCR_TEXT_5713", "* (허 쉬  퍼 피  하 나 가&  문  밑 으 로  미 끄 러 져  나 왔 다 .)/");
ds_map_add(global.text_data_en, "SCR_TEXT_5714", "* (허 쉬  퍼 피 를  얻 었 다 .)/%%");
ds_map_add(global.text_data_en, "SCR_TEXT_5720", "* (핫 캣 을&  문  앞 에  두 었 다 .)/");
ds_map_add(global.text_data_en, "SCR_TEXT_5721", "* (으 르 렁 대 는  소 리 가  들 린 다 .)/%%");
ds_map_add(global.text_data_en, "SCR_TEXT_5727", "* (멍 멍  샐 러 드 를&  문  앞 에  두 었 다 ^1.)&* (문  밑 으 로  사 라 졌 다 .)/");
ds_map_add(global.text_data_en, "SCR_TEXT_5728", "* (...)/");
ds_map_add(global.text_data_en, "SCR_TEXT_5729", "* (멍 멍  샐 러 드 가&  어 둠 에  삼 켜 졌 다 .)/%%");
ds_map_add(global.text_data_en, "SCR_TEXT_5736", "* (멍 멍 이  잔 여 물 을&  문  앞 에  두 었 다 .)/");
ds_map_add(global.text_data_en, "SCR_TEXT_5737", "* (자 석 이 라 도  붙 인  듯 ^1,&  안 으 로  쏙  들 어 갔 다 .)/");
ds_map_add(global.text_data_en, "SCR_TEXT_5738", "* (...)/");
ds_map_add(global.text_data_en, "SCR_TEXT_5743", "* (뾰 오 옹 !!^1!)&* (엄 청 난  속 도 로  다 시&  튕 겨 져 나 왔 다 !)/%%");
ds_map_add(global.text_data_en, "SCR_TEXT_5747", "* (두  개 의  멍 멍 이  잔 여 물 이&  천 천 히  문  밑 으 로&  되 돌 아 나 왔 다 .)/%%");
ds_map_add(global.text_data_en, "SCR_TEXT_5755", " %%");
ds_map_add(global.text_data_en, "SCR_TEXT_5761", "* 네 ^1, 알 고  있 습 니 다 ^1.&* 도 시 로  향 하 는  엘 리 베 이 터 가&  작 동 하 지  않 는 다 고 요 ./");
ds_map_add(global.text_data_en, "SCR_TEXT_5762", "* 이 번  일  덕 분 에 ^1,&  특 별 한  가 격 에&  모 십 니 다 !/");
ds_map_add(global.text_data_en, "SCR_TEXT_5763", "* 방  하 나 에  200G^1. 어 때 요 ^1?& &         머 무 른 다     아 니 \C");
ds_map_add(global.text_data_en, "SCR_TEXT_5764", " ");
ds_map_add(global.text_data_en, "SCR_TEXT_5768", "* 방  하 나 에  200G^1. 어 때 요 ^1?& &         머 무 른 다     아 니 \C");
ds_map_add(global.text_data_en, "SCR_TEXT_5769", " ");
ds_map_add(global.text_data_en, "SCR_TEXT_5774", "* 푹  쉬 셨 습 니 까 ?/");
ds_map_add(global.text_data_en, "SCR_TEXT_5775", "* 네 ^1?&* 방 ..^1.&* 열 쇠 요 ?/");
ds_map_add(global.text_data_en, "SCR_TEXT_5776", "* 아 뇨 ^1, 저 희 는&  그 런  건  없 습 니 다 ./");
ds_map_add(global.text_data_en, "SCR_TEXT_5777", "* 방 을  나 가 면 ^1, 다 시&  돈 을  지 불 하 셔 야  합 니 다 ./");
ds_map_add(global.text_data_en, "SCR_TEXT_5778", "* 방  하 나 에  200G^1. 어 때 요 ^1?& &         머 무 른 다     아 니 \C");
ds_map_add(global.text_data_en, "SCR_TEXT_5779", " ");
ds_map_add(global.text_data_en, "SCR_TEXT_5791", "* 정 말  멋 지 십 니 다 ^1!&* 방 으 로  안 내 해&  드 리 겠 습 니 다 !/%%");
ds_map_add(global.text_data_en, "SCR_TEXT_5797", "* ...돈 이  부 족 하 잖 습 니 까 ./%%");
ds_map_add(global.text_data_en, "SCR_TEXT_5802", "* 맘 이  바 뀌 면&  언 제 라 도  알 려 주 세 요 ^1.&* 좋 은  하 루  보 내 세 요 !/%%");
ds_map_add(global.text_data_en, "SCR_TEXT_5807", "* ...제  운 명 의  사 랑 인 가 요 ?/");
ds_map_add(global.text_data_en, "SCR_TEXT_5808", "* .../");
ds_map_add(global.text_data_en, "SCR_TEXT_5809", "* (지 루 해  보 이 시 네 요 ^1, 달 링 .)/");
ds_map_add(global.text_data_en, "SCR_TEXT_5810", "* (멋 진  공 연 이  되 었 음&  하 지 만 ^1, 당 신 이  최 선 을&  다 하 지  않 는 다 면 ...)/");
ds_map_add(global.text_data_en, "SCR_TEXT_5811", "* (시 청 자 들 을  위 해&  건 너 뛰 겠 습 니 다 .)/");
ds_map_add(global.text_data_en, "SCR_TEXT_5812", "* (공 연 할 까 요 ?)& &         하 자         안  해 \C");
ds_map_add(global.text_data_en, "SCR_TEXT_5813", " ");
ds_map_add(global.text_data_en, "SCR_TEXT_5819", "* (알 겠 어 요 ^1.)&* (모 두  감 동 의  물 결 에&  휩 쓸 려  보 자 고 요 !)/%%");
ds_map_add(global.text_data_en, "SCR_TEXT_5823", "* (하 아 ...^1)&* (쇼 는  계 속 됩 니 다 !)/%%");
ds_map_add(global.text_data_en, "SCR_TEXT_5829", "흥 미 로 워 ./");
ds_map_add(global.text_data_en, "SCR_TEXT_5830", "돌 아 가 고  싶 어  하 다 니 ./");
ds_map_add(global.text_data_en, "SCR_TEXT_5831", "네 가  파 괴 한  세 계 ^1로&돌 아 가 ^2고  싶 다 니 ./");
ds_map_add(global.text_data_en, "SCR_TEXT_5832", "모 두 를  사 지 로  몰 아 넣 은&사 람 ^1은  너 였 어 ./");
ds_map_add(global.text_data_en, "SCR_TEXT_5833", "세 계 를  멸 망 으 로  이 끈&사 람 ^1이  너 였 다 고 ./");
ds_map_add(global.text_data_en, "SCR_TEXT_5834", "하 지 만  받 아 들 이 지  못 하 는 군 ./");
ds_map_add(global.text_data_en, "SCR_TEXT_5835", "결 과 는  그 저  뒤 집 으 면&그 만 이 라 는  건 가 ?&         맞 아         아 니 \C");
ds_map_add(global.text_data_en, "SCR_TEXT_5836", "");
ds_map_add(global.text_data_en, "SCR_TEXT_5842", "그 럼  그 렇 지 ./%%");
ds_map_add(global.text_data_en, "SCR_TEXT_5846", "그 렇 다 면  도 대 체  뭘&찾 고  있 는  거 지 ?/%%");
ds_map_add(global.text_data_en, "SCR_TEXT_5851", "어 쩌 면 ./");
ds_map_add(global.text_data_en, "SCR_TEXT_5852", "거 래 를  할  수 도  있 겠 군 ./");
ds_map_add(global.text_data_en, "SCR_TEXT_5853", "네 겐  아 직  내 가&원 하 는  ^1게  남 아 있 어 ./");
ds_map_add(global.text_data_en, "SCR_TEXT_5854", "나 한 테  줘 ./");
ds_map_add(global.text_data_en, "SCR_TEXT_5855", "그 러 면  세 계 를  다 시  되 돌 려 주 지 ./");
ds_map_add(global.text_data_en, "SCR_TEXT_5856", " & &         예           아 니 요 \C");
ds_map_add(global.text_data_en, "SCR_TEXT_5857", "");
ds_map_add(global.text_data_en, "SCR_TEXT_5863", "그 럼  동 의 한  거 네 ./");
ds_map_add(global.text_data_en, "SCR_TEXT_5864", "네  영 혼 을  나 한 테  줘 .& &         그 래         아 니 \C");
ds_map_add(global.text_data_en, "SCR_TEXT_5865", " ");
