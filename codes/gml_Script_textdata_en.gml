ds_map_add(global.text_data_en, "SCR_TEXT_4207", " %%");
ds_map_add(global.text_data_en, "SCR_TEXT_4214", "\M3* 미 지 근 한  물 을  이 렇 게&  사 랑 하 는  자 가  있 다 니&  정 말  영 광 입 니 다 ^1, 여 러 분 !/");
ds_map_add(global.text_data_en, "SCR_TEXT_4215", "\M2* (이 것 을  보 고 합 니 까 ?)& &         보 고 한 다     아 직 \C");
