ds_map_add(global.text_data_en, "obj_floweytrigger_122", "\E1* 안 녕 ..^1.&* 괜 찮 니 ?/");
ds_map_add(global.text_data_en, "obj_floweytrigger_123", "* 길 을  잃 어  정 말&  혼 란 스 럽 겠 구 나 ./");
ds_map_add(global.text_data_en, "obj_floweytrigger_124", "\E2* 아 , 무 서 워 하 지&  말 렴 ^1, 아 가 ./");
ds_map_add(global.text_data_en, "obj_floweytrigger_125", "\W* 내  이 름 은  \B토 리 엘 \W,&  \R폐 허 \W의  관 리 자 란 다 ./");
ds_map_add(global.text_data_en, "obj_floweytrigger_126", "* 떨 어 진  아 이 는  없 나&  매 일  이 곳 을&  둘 러 보 고  있 지 ./");
ds_map_add(global.text_data_en, "obj_floweytrigger_127", "* 너 같 은  인 간 이&  떨 어 진  건  무 척&  오 랜 만 이 로 구 나 ./");
ds_map_add(global.text_data_en, "obj_floweytrigger_128", "* 네 가  여 기  있 는&  동 안 에 는  최 선 을&  다 해  지 켜 주 마 ./");
ds_map_add(global.text_data_en, "obj_floweytrigger_129", "* 이 리  오 렴 ^1!&* 유 적 을  지 나 가 도 록&  도 와 줄 게 ./%%");
ds_map_add(global.text_data_en, "obj_floweytrigger_316", "\W* 반 가 워 ^2!&* 내  이 름 은  \Y플 라 위 \W.^2 &*\Y 작 은  꽃  플 라 위 \W야 !!/");
ds_map_add(global.text_data_en, "obj_floweytrigger_317", "* 히  히  히 .../");
ds_map_add(global.text_data_en, "obj_floweytrigger_318", "* 왜  계 속  나 한 테&  자 기 소 개 를&  시 키 려 는  거 야 ?/");
ds_map_add(global.text_data_en, "obj_floweytrigger_319", "* 내 가  누 군 지 도  모 른 다 는&  듯 이  그 러 다 니&  예 의 가  없 네 ./");
ds_map_add(global.text_data_en, "obj_floweytrigger_320", "* 누 가  예 절  교 육 을&  좀  해 줘 야 겠 어 ./");
ds_map_add(global.text_data_en, "obj_floweytrigger_321", "* 작 고  힘 없 는  나 라 도&  알 려 줘 야 겠 네 ./");
ds_map_add(global.text_data_en, "obj_floweytrigger_322", "* 준 비 됐 어 ^2?&* 간 다 !/%%");
ds_map_add(global.text_data_en, "obj_floweytrigger_327", "* 너  달 리  할  일 이  없 니 ?/%%");
ds_map_add(global.text_data_en, "obj_floweytrigger_338", "* Error/%%");
ds_map_add(global.text_data_en, "obj_floweytrigger_342", "* 진 심 이 야 ^1, \[차]?/");
ds_map_add(global.text_data_en, "obj_floweytrigger_343", "\E5* 뭐 , 내 키 는  대 로  해 ./");
ds_map_add(global.text_data_en, "obj_floweytrigger_344", "\E4* 기 다 리 고&  있 을  테 니 까 !/%%");
ds_map_add(global.text_data_en, "obj_floweytrigger_348", "\E0* 있 잖 아 ^1.&* 잘  들 어 ./");
ds_map_add(global.text_data_en, "obj_floweytrigger_349", "\E2* 아 무 도  죽 이 지  마 ./");
ds_map_add(global.text_data_en, "obj_floweytrigger_350", "\E2* .../");
ds_map_add(global.text_data_en, "obj_floweytrigger_351", "\E1* 내 가  너 한 테  이 런  말 을&  해  줘 야  한 다 니 ./");
ds_map_add(global.text_data_en, "obj_floweytrigger_352", "\E0* 히  히  히 .../");
ds_map_add(global.text_data_en, "obj_floweytrigger_353", "* 행 운 을  빌 어 !/%%");
ds_map_add(global.text_data_en, "obj_floweytrigger_357", "* 잘  들 어 .../");
ds_map_add(global.text_data_en, "obj_floweytrigger_358", "\E1* 이 번 엔 , 모 두 랑&  친 구 가  되 는  거 야 ./");
ds_map_add(global.text_data_en, "obj_floweytrigger_359", "\E2* 알 겠 지 ?/");
ds_map_add(global.text_data_en, "obj_floweytrigger_360", "\E5* 만 약  안  그 런 다 면 ^1,&  넌  평 생  비 참 하 게  살 겠 지 ./");
ds_map_add(global.text_data_en, "obj_floweytrigger_361", "\E1* 그 런  건  원 하 지&  않 잖 아 ^1, 그 렇 지 ?/");
ds_map_add(global.text_data_en, "obj_floweytrigger_362", "\E0* 그 래 ..^1.&* 넌  행 복 해 지 길&  바 라 잖 아 ^1, 맞 지 ?/");
ds_map_add(global.text_data_en, "obj_floweytrigger_363", "* 행 운 을  빌 어 /%%");
ds_map_add(global.text_data_en, "obj_floweytrigger2_158", "* Error/%%");
ds_map_add(global.text_data_en, "obj_floweytrigger2_162", "* 히  히  히 .../");
ds_map_add(global.text_data_en, "obj_floweytrigger2_163", "\E2* 네  선 택 에&  만 족 했 길  바 라 ./");
ds_map_add(global.text_data_en, "obj_floweytrigger2_164", "* 어 차 피 ^1, 돌 아 가 서&  운 명 을  바 꿀  수  있 다 거 나&  그 런  것 도  아 니 잖 아 ./");
ds_map_add(global.text_data_en, "obj_floweytrigger2_165", "\E0* 이  세 상 에 선 ^1,&  죽 거 나  죽 이 거 나 야 ./");
ds_map_add(global.text_data_en, "obj_floweytrigger2_166", "\E2* 그  늙 어 빠 진  년 은&  규 칙 을  깰  수  있 다 고&  생 각 했 겠 지 ./");
ds_map_add(global.text_data_en, "obj_floweytrigger2_167", "\E1* 그 년 은  너  같 은&  인 간 을  지 키 려 고&  노 력 했 지 만 .../");
ds_map_add(global.text_data_en, "obj_floweytrigger2_168", "\E0* 하 지 만  정 작 .../");
ds_map_add(global.text_data_en, "obj_floweytrigger2_169", "\TF*\E5 히  히 .../");
ds_map_add(global.text_data_en, "obj_floweytrigger2_170", "\E4* 자 기  자 신 도&  지 키 지  못 했 어 ./");
ds_map_add(global.text_data_en, "obj_floweytrigger2_171", "* 참  멍 청 하 기 도  해 라 !!/%%");
ds_map_add(global.text_data_en, "obj_floweytrigger2_175", "\E2* 히 히 히 히 ./");
ds_map_add(global.text_data_en, "obj_floweytrigger2_176", "* 그 걸 로  충 분 하 지&  않 았 나  봐 ^1, 응 !?/");
ds_map_add(global.text_data_en, "obj_floweytrigger2_177", "\E4* .../");
ds_map_add(global.text_data_en, "obj_floweytrigger2_178", "\E6* 얼 마 나  더  그 년 을&  죽 일  거 야 ?/");
ds_map_add(global.text_data_en, "obj_floweytrigger2_179", "* 하  하  하  하  하 .../");
ds_map_add(global.text_data_en, "obj_floweytrigger2_180", "\E4*\TF 이  역 겨 운&  짐 승 놈  같 으 니 ./");
ds_map_add(global.text_data_en, "obj_floweytrigger2_181", "* 그  여 자 한 테&  자 비 를  베 풀  생 각 조 차&  안  했 네 ./%%");
ds_map_add(global.text_data_en, "obj_floweytrigger2_186", "* 와 ^1, 정 말  그 걸 론&  충 분 하 지  않 았 나&  보 네 ./");
ds_map_add(global.text_data_en, "obj_floweytrigger2_187", "\E5* 널  보 면  한  번 씩  내 가&  생 각 난 다 니 까 ./");
ds_map_add(global.text_data_en, "obj_floweytrigger2_195", "* 와 ^1, 진 짜  역 겹 네 ./");
ds_map_add(global.text_data_en, "obj_floweytrigger2_196", "\E6* 그  여 자 를&  살 려 줬 고 .../");
ds_map_add(global.text_data_en, "obj_floweytrigger2_197", "* 그 걸 론  충 분 히&  재 밌 지  않 다 고&  생 각 한  거 야 ./");
ds_map_add(global.text_data_en, "obj_floweytrigger2_198", "\E7* 그 래 서  무 슨  일 이&  일 어 날 지  보 려 고&  토 리 엘 을  죽 였 어 ./");
ds_map_add(global.text_data_en, "obj_floweytrigger2_199", "\E5* 단 지  심 심 해 서&  죽 인  것 뿐 이 야 ./");
ds_map_add(global.text_data_en, "obj_floweytrigger2_200", "* 진 짜  역 겨 워 .../%%");
ds_map_add(global.text_data_en, "obj_floweytrigger2_203", "* 히  히 .../");
ds_map_add(global.text_data_en, "obj_floweytrigger2_204", "\E4* 바 보  천 치  같 으 니 ./");
ds_map_add(global.text_data_en, "obj_floweytrigger2_205", "* 너 만  그  힘 을&  가 지 고  있 다 고&  생 각 했 어 ?/");
ds_map_add(global.text_data_en, "obj_floweytrigger2_206", "\E4* 세 상 을&  재 조 립 하 는  힘 .../");
ds_map_add(global.text_data_en, "obj_floweytrigger2_207", "* 오 직  네  결 의 로 만&  쓸  수  있 는 ./");
ds_map_add(global.text_data_en, "obj_floweytrigger2_208", "* 신 이  되 어&  놀 아 볼  수  있 는&  능 력 !/");
ds_map_add(global.text_data_en, "obj_floweytrigger2_209", '* "저 장 "할  수&  있 는  능 력  말 이 야 ./');
ds_map_add(global.text_data_en, "obj_floweytrigger2_210", "\E0* 그  힘 을  가 진  게&  나 뿐 이 라 고&  생 각 했 었 는 데 .../");
ds_map_add(global.text_data_en, "obj_floweytrigger2_211", "\E1* 이 제  난  더  이 상  저 장 을&  할  수  없 어 ./");
ds_map_add(global.text_data_en, "obj_floweytrigger2_212", "* 이  세 계 에  대 한&  네  욕 망 이  내  것 보 다&  더  큰  거 겠 지 ./");
ds_map_add(global.text_data_en, "obj_floweytrigger2_213", "\E5* 이 런  이 런 ./");
ds_map_add(global.text_data_en, "obj_floweytrigger2_214", "* 할  수  있 을  때&  그  힘 을  즐 기 라 고 ./");
ds_map_add(global.text_data_en, "obj_floweytrigger2_215", "\E4* 지 켜 보 고  있 을  테 니&  말 이 야 ./%%");
ds_map_add(global.text_data_en, "obj_floweytrigger2_226", "* 하 하 하 .../");
ds_map_add(global.text_data_en, "obj_floweytrigger2_227", "\E1* 넌  인 간 이  아 니 야 ^1,&  그 렇 지 ?/");
ds_map_add(global.text_data_en, "obj_floweytrigger2_228", "\E1* 그 래 ^2. 네  안 은  공 허 해 ^2.&* \E4나 처 럼  말 이 지 ^1.&* 사 실 .../");
ds_map_add(global.text_data_en, "obj_floweytrigger2_229", "\E8* 너  \[차] 맞 지 ^1,&  그 렇 지 ?/");
ds_map_add(global.text_data_en, "obj_floweytrigger2_230", "\E0* 시 간 이  그 렇 게&  지 났 는 데 도 ^1, 우 릴&  못  떼 어 놓 다 니 .../");
ds_map_add(global.text_data_en, "obj_floweytrigger2_231", "* 들 어 봐 ^1.&* 내 게  정 말  강 해 질  수&  있 는  계 획 이  있 어 ./");
ds_map_add(global.text_data_en, "obj_floweytrigger2_232", "\E2* 네  영 혼 과  네 가&  빼 앗 은  영 혼 들 보 다 도&  말 이 야 ./");
ds_map_add(global.text_data_en, "obj_floweytrigger2_233", "\E4* 같 이  이  저 주 받 은&  세 상 의  모 든  것 을&  박 살  내 자 ./");
ds_map_add(global.text_data_en, "obj_floweytrigger2_234", "\E6* 쓸 모 없 는  기 억  속 의&  모 든  사 람 들 을 ^1,&  모 든  것 들 을 .../");
ds_map_add(global.text_data_en, "obj_floweytrigger2_235", "\E5* 모 두  먼 지 로&  만 들 어  버 리 자 고 ./%%");
ds_map_add(global.text_data_en, "obj_floweytrigger2_245", "* 영 리 하 군 .&* 저 어 어 어 엉 말&  영 리 해 ./");
ds_map_add(global.text_data_en, "obj_floweytrigger2_246", "* 정 말  자 기 가  똑 똑 하 다 고&  생 각 하 나  보 네 ^1,&  그 렇 지 ?/");
ds_map_add(global.text_data_en, "obj_floweytrigger2_247", "\E0* 이  세 상 에 선 ^1,&  죽 거 나  죽 이 거 나 인 데 ./");
ds_map_add(global.text_data_en, "obj_floweytrigger2_248", "\E1* 결 국  너 만 의  규 칙 으 로&  나 아 가  보 였 구 나 ./");
ds_map_add(global.text_data_en, "obj_floweytrigger2_249", "*\E4 그  한  년  목 숨 은&  살 려 뒀 으 니  말 이 야 ./");
ds_map_add(global.text_data_en, "obj_floweytrigger2_250", "* 히  히  히 .../");
ds_map_add(global.text_data_en, "obj_floweytrigger2_253", "* 프 로 깃 ^1, 윔 선 ^1.&* 베 지 토 이 드 ^1, 룩 스 ^1.&* 미 고 습 ^1, 몰 드 스 멀 ./");
ds_map_add(global.text_data_en, "obj_floweytrigger2_254", "* 이  이 름 들 을&  생 각 해  봐 ./");
ds_map_add(global.text_data_en, "obj_floweytrigger2_255", "* 그  괴 물 들 에 게&  가 족 이  있 을  거 라 고&  생 각 해 본  적  있 어 ?/");
ds_map_add(global.text_data_en, "obj_floweytrigger2_256", "* 그 들 에 게  친 구 가&  있 을  거 라 고&  생 각 해 본  적  있 어 ?/");
ds_map_add(global.text_data_en, "obj_floweytrigger2_257", "\E6* 각 자 가  누 군 가 의&  토 리 엘 일  수 도&  있 었 어 ./");
ds_map_add(global.text_data_en, "obj_floweytrigger2_258", "\E7* 이 기 적 인  놈 ./");
ds_map_add(global.text_data_en, "obj_floweytrigger2_259", "* 누 군 가 는  너  때 문 에&  죽 은  거 야 ./%%");
ds_map_add(global.text_data_en, "obj_floweytrigger2_264", "\E2* 기 분  꽤  좋 았 겠 네 ./");
ds_map_add(global.text_data_en, "obj_floweytrigger2_265", "* 이 번 엔  아 무 도&  안  죽 였 으 니 ./");
ds_map_add(global.text_data_en, "obj_floweytrigger2_266", "\E0* 근 데  무 자 비 한&  살 인 마 를  만 난 다 면&  어 떻 게  할  거 야 ?/");
ds_map_add(global.text_data_en, "obj_floweytrigger2_267", "* 넌  죽 고 , 죽 고&  또  죽 겠 지 ./");
ds_map_add(global.text_data_en, "obj_floweytrigger2_268", "\E1* 네 가  지 칠  때 까 지&  말 이 야 ./");
ds_map_add(global.text_data_en, "obj_floweytrigger2_269", "\E0* 그  다 음 엔&  뭘  할  거 야 ?/");
ds_map_add(global.text_data_en, "obj_floweytrigger2_270", "\E5* 겁 에  질 려 서&  살 인 을  저 지 를  거 야 ?/");
ds_map_add(global.text_data_en, "obj_floweytrigger2_271", "* 아 님  이  세 계 를&  완 전 히  포 기 하 고 .../");
ds_map_add(global.text_data_en, "obj_floweytrigger2_272", "\E4* ... 나 한 테  그  힘 을&  넘 겨 줄  거 야 ?/");
ds_map_add(global.text_data_en, "obj_floweytrigger2_273", "\E5* 나 는  장 차  이  세 계 를&  다 스 릴  몸 이 야 ./");
ds_map_add(global.text_data_en, "obj_floweytrigger2_274", "* 걱 정  마 요 ^1, 꼬 마  대 왕 님 ^1,&  왕 위 를  뺏 을  생 각 은&  없 으 니 까 ./");
ds_map_add(global.text_data_en, "obj_floweytrigger2_275", "* 훨 씬  더  재 밌 는  걸&  계 획 해 뒀 거 든 !/%%");
ds_map_add(global.text_data_en, "obj_floweytrigger2_283", "* 그 래 도  너 무&  자 만 하 진  마 ./");
ds_map_add(global.text_data_en, "obj_floweytrigger2_284", "* 난  네 가  뭘  했 는 지&  알 고  있 어 ./");
ds_map_add(global.text_data_en, "obj_floweytrigger2_285", "\E6* 넌  그  여 자 를  죽 였 어 ./");
ds_map_add(global.text_data_en, "obj_floweytrigger2_286", "\E7* 그 리 고  다 시  돌 아 왔 지 ^1,&  그 걸  후 회 했 으 니 까 ./");
ds_map_add(global.text_data_en, "obj_floweytrigger2_287", "* 하  하  하  하 .../");
ds_map_add(global.text_data_en, "obj_floweytrigger2_288", "\E5* 이  순 진 한  멍 청 이 ./");
ds_map_add(global.text_data_en, "obj_floweytrigger2_289", "* 너 만  그  힘 을&  가 지 고  있 다 고&  생 각 했 어 ?/");
ds_map_add(global.text_data_en, "obj_floweytrigger2_290", "\E4* 세 상 을&  재 조 립 하 는  힘 .../");
ds_map_add(global.text_data_en, "obj_floweytrigger2_291", "* 오 직  네  결 의 로 만&  쓸  수  있 는 ./");
ds_map_add(global.text_data_en, "obj_floweytrigger2_292", "* 신 이  되 어&  놀 아 볼  수  있 는&  능 력 !/");
ds_map_add(global.text_data_en, "obj_floweytrigger2_293", '* "저 장 "할  수&  있 는  능 력  말 이 야 ./');
ds_map_add(global.text_data_en, "obj_floweytrigger2_294", "\E0* 그  힘 을  가 진  게&  나 뿐 이 라 고&  생 각 했 었 는 데 .../");
ds_map_add(global.text_data_en, "obj_floweytrigger2_295", "\E1* 이 제  난  더  이 상  저 장 을&  할  수  없 어 ./");
ds_map_add(global.text_data_en, "obj_floweytrigger2_296", "* 이  세 계 에  대 한&  네  욕 망 이  내  것 보 다&  더  큰  거 겠 지 ./");
ds_map_add(global.text_data_en, "obj_floweytrigger2_297", "\E5* 이 런  이 런 ./");
ds_map_add(global.text_data_en, "obj_floweytrigger2_298", "* 할  수  있 을  때&  그  힘 을  즐 기 라 고 ./");
ds_map_add(global.text_data_en, "obj_floweytrigger2_299", "\E4* 지 켜 보 고  있 을  테 니&  말 이 야 ./%%");
ds_map_add(global.text_data_en, "obj_forcedright_142", "* 이 게  무 슨  냄 새 지 ^1?&* (어 디 서  나 는  냄 새 지 ?)/");
ds_map_add(global.text_data_en, "obj_forcedright_143", "* 네 가  냄 새 가  난 다 면 ^1...&* (...냄 새 를  드 러 내 라 !)/%%");
ds_map_add(global.text_data_en, "obj_forcedright_175", "* 흠 ^1.&* 여 기 서  그  이 상 한&  냄 새 가  나 는 군 .../");
ds_map_add(global.text_data_en, "obj_forcedright_176", "* 확  없 애 버 리 고&  싶 게  만 드 는  냄 새 야 ./");
ds_map_add(global.text_data_en, "obj_forcedright_177", "* (...너 를  없 애 버 릴  거 야 !)/%%");
ds_map_add(global.text_data_en, "obj_forcedright_220", "* 개 가  다 른  개 를&  쓰 다 듬 을  수  있 나 ??^1?&* (신 세 계 가  열 렸 어 ...)/");
ds_map_add(global.text_data_en, "obj_forcedright_221", "* 고 마 워 ^1, 괴 짜  멍 멍 이 !/%%");
ds_map_add(global.text_data_en, "obj_forcedright_224", "* 이 상 한  냄 새 에 도  좋 은&  일 이  있 을  수  있 군 ..^1.&* (신 나 는  놀 이 였 어 !)/");
ds_map_add(global.text_data_en, "obj_forcedright_225", '* 고 마 워 ^1, 괴 상 한  냄 새 야 ^1!&* ("막  대 "리 고  놀 아 줘 서&  좋 았 어 !)/%%');
ds_map_add(global.text_data_en, "obj_friendc_event_115", "  프 리 스 크 !/");
ds_map_add(global.text_data_en, "obj_friendc_event_116", "  다  그 냥&  나 쁜  꿈 일  뿐 이 야 !/");
ds_map_add(global.text_data_en, "obj_friendc_event_117", "  제 발 ^1, 일 어 나 렴 ...!/%%");
ds_map_add(global.text_data_en, "obj_friendc_event_181", "* 오 ^1!&* 일 어 났 구 나 ^1!&* 신 이 시 여  감 사 합 니 다 !/");
ds_map_add(global.text_data_en, "obj_friendc_event_183", "* 저 -정 말&  걱 정 했 어 ...!/");
ds_map_add(global.text_data_en, "obj_friendc_event_184", "* 영 원 히  쓰 러 져&  있 는  줄  알 았 어 !/");
ds_map_add(global.text_data_en, "obj_friendc_event_186", "* 맞 아 ^1! 조 금 만  더  오 래&  그 러 고  있 었 다 면&  난  기 절 했 을  거 야 !/");
ds_map_add(global.text_data_en, "obj_friendc_event_187", "\E2* 다 음 에  낮 잠  잘&  생 각 이 라 면  말 부 터&  해  달 라 구 ^1, 알 겠 지 ?/");
ds_map_add(global.text_data_en, "obj_friendc_event_189", "* 그 래 ^1.&* 파 피 루 스 가  애 처 럼&  울 었 다 니 까 ./");
ds_map_add(global.text_data_en, "obj_friendc_event_191", "뭐!^1!&난 울지 않았어!!^1!&난 안 울었다고!/");
ds_map_add(global.text_data_en, "obj_friendc_event_192", "\E3그냥..^1.&눈에 뭐가&들어간 것뿐이야./");
ds_map_add(global.text_data_en, "obj_friendc_event_194", "* 뭐 가  들 어 갔 는 데 ?/");
ds_map_add(global.text_data_en, "obj_friendc_event_196", "눈물!!!/");
ds_map_add(global.text_data_en, "obj_friendc_event_198", "* 자 ^1, 자 ./");
ds_map_add(global.text_data_en, "obj_friendc_event_199", "* 중 요 한  건  프 리 스 크 가&  무 사 하 다 는  거 야 ./");
ds_map_add(global.text_data_en, "obj_friendc_event_200", "* 자 ^1, 프 리 스 크 ^1.&* 차 나  마 시 는  건&  어 떤 가 ?/");
ds_map_add(global.text_data_en, "obj_friendc_event_201", "* 그 러 면  좀&  나 아 질  걸 세 ./");
ds_map_add(global.text_data_en, "obj_friendc_event_203", "* 어 ..^1.&* 일 단  잠 시  여 유 를&  주 는  건  어 때 요 ?/");
ds_map_add(global.text_data_en, "obj_friendc_event_204", "\E2* 분 명  아 주&  지 쳤 을  거 예 요 ./");
ds_map_add(global.text_data_en, "obj_friendc_event_205", "\E8* 그 렇 지 만 서 도 ^1,&  확 실 히 는&  모 르 겠 네 요 ./");
ds_map_add(global.text_data_en, "obj_friendc_event_206", "\E1* 프 리 스 크 ..^1.&* 무 슨  일 이  있 었 는 지&  우 린  기 억 이  안  나 ./");
ds_map_add(global.text_data_en, "obj_friendc_event_207", "\E1* 꽃 이  있 었 고 ..^1.&* 그  다 음 은 ^1, 모 든  게&  하 얘 져 버 렸 지 ./");
ds_map_add(global.text_data_en, "obj_friendc_event_208", "\E0* 그 리 고  이 제&  결 계 가  사 라 졌 어 ./");
ds_map_add(global.text_data_en, "obj_friendc_event_209", "* 네 가  준 비 됐 다 면 ^1,&  모 두 들  지 상 으 로&  돌 아 갈  거 야 ./");
ds_map_add(global.text_data_en, "obj_friendc_event_210", "* 이 제  동 쪽 의  문 으 로  가 면&  나 갈  수  있 을  거 야 ./");
ds_map_add(global.text_data_en, "obj_friendc_event_211", "\E2* 하 지 만  그  전 에 .../");
ds_map_add(global.text_data_en, "obj_friendc_event_212", "\E0* 잠 깐  산 책 이 라 도&  하 고  싶 을  것  같 은 데 ?/");
ds_map_add(global.text_data_en, "obj_friendc_event_213", "* 멋 진  친 구 들 에 게&  작 별  인 사 를&  해  줄  수 도  있 고 ./");
ds_map_add(global.text_data_en, "obj_friendc_event_214", "* 좋 을 대 로  하 렴 ^1.&* 우 린  여 기 에 서&  기 다 려  줄 게 ./%%");
ds_map_add(global.text_data_en, "obj_friendscene_182", "\E4저 런  추 악 한  것&같 으 니 ^1, 순 수 하 고&가 여 운  아 이 를 ^1,&괴 롭 히 다 니 .../");
ds_map_add(global.text_data_en, "obj_friendscene_183", "\E0무 서 워 하 지  말 렴 ^1,&아 가 야 ./");
ds_map_add(global.text_data_en, "obj_friendscene_184", "\E0나 란 다 ^1, 토 리 엘 ^1.&네  친 구 이 자  수 호 자 ./");
ds_map_add(global.text_data_en, "obj_friendscene_185", "\E1처 음 엔 ^1, 너  혼 자&이  여 행 을  떠 나 게 끔&했 었 지 만 ... /");
ds_map_add(global.text_data_en, "obj_friendscene_186", "\E4계 속  네  걱 정 이  되 어 서&야 단 이 었 단 다 ./");
ds_map_add(global.text_data_en, "obj_friendscene_187", "\E4정 말  위 험 한&모 험 을  했 었 구 나 ./");
ds_map_add(global.text_data_en, "obj_friendscene_188", "\E2...끔 찍 한  선 택 을&해 야  하 는  부 담 도&져 야  했 었 겠 지 ./");
ds_map_add(global.text_data_en, "obj_friendscene_189", "이 곳 을  떠 나 려 면 ^1,&다 른  이 의  목 숨 을&빼 앗 아 야  한 단 다 ./");
ds_map_add(global.text_data_en, "obj_friendscene_190", "\E2저  아 스 고 어 를&무 찔 렀 어 야  했 겠 지 ./");
ds_map_add(global.text_data_en, "obj_friendscene_191", "\E4하 지 만 ..^1.&생 각 을  해 봤 는 데 .../");
ds_map_add(global.text_data_en, "obj_friendscene_192", "\E1그 런  일 은  차 마&못  보 겠 더 구 나 ./");
ds_map_add(global.text_data_en, "obj_friendscene_193", "이  지 하 를&탈 출 하 기  위 해&누 군 가 를  희 생 하 는  건&옳 지  않 은  일 이 야 ./");
ds_map_add(global.text_data_en, "obj_friendscene_194", "\E4그 게  내 가&지 금 껏  막 으 려 고&했 던  일  아 니 겠 니 ?/");
ds_map_add(global.text_data_en, "obj_friendscene_195", "\E1그 러 니 ^1, 지 금 은 ^1,&이  싸 움 은  멈 추 자 꾸 나 ./");
ds_map_add(global.text_data_en, "obj_friendscene_196", "\E4아 스 고 어 처 럼&끔 찍 한  사 람 도 .../");
ds_map_add(global.text_data_en, "obj_friendscene_197", "\E0자 비 를 ^1, 받 을  자 격 은&있 으 니 까 ./%%");
ds_map_add(global.text_data_en, "obj_friendscene_226", "토 리 ..^1.&돌 아&왔 구 려&...!/%%");
ds_map_add(global.text_data_en, "obj_friendscene_236", "\E5토 리 라  부 르 지&마 요 ^1, 드 리 무 어 !/");
ds_map_add(global.text_data_en, "obj_friendscene_237", "\E2한 심 한  강 아 지&같 으 니 라 고 ./");
ds_map_add(global.text_data_en, "obj_friendscene_238", "진 정  우 리 를&자 유 롭 게  해  주 고&싶 었 다 면 .../");
ds_map_add(global.text_data_en, "obj_friendscene_239", "첫  영 혼 을  얻 었 을  때&결 계 를  뚫 고  나 가 서 .../");
ds_map_add(global.text_data_en, "obj_friendscene_240", "...6개 의  인 간  영 혼 을&얻 은  뒤 에 ^1, 돌 아 와&모 두 를  평 화 롭 게&풀 어 줄  수  있 었 잖 아 요 ./");
ds_map_add(global.text_data_en, "obj_friendscene_241", "\E5하 지 만  그  대 신 에 ^1,&당 신 은  모 두 의  삶 을&절 망  속 에  살 게&만 들 었 어 요 .../");
ds_map_add(global.text_data_en, "obj_friendscene_242", "당 신 이  다 른  인 간 이&오 지  않 기 만  얌 전 히&바 라 면 서 ^1, 그 저&여 기 서  기 다 렸 기 에 ./%%");
ds_map_add(global.text_data_en, "obj_friendscene_271", ".../");
ds_map_add(global.text_data_en, "obj_friendscene_272", "...토 리 .../");
ds_map_add(global.text_data_en, "obj_friendscene_273", "당 신 이  옳 소 .../");
ds_map_add(global.text_data_en, "obj_friendscene_274", "난  추 악 한  사 람 이 오 .../");
ds_map_add(global.text_data_en, "obj_friendscene_275", "...하 지 만 ^1, 다 시&친 구 라 도  될  수  있 진&않 겠 소 ?/%%");
ds_map_add(global.text_data_en, "obj_friendscene_301", "(하 아 .)/");
ds_map_add(global.text_data_en, "obj_friendscene_302", "싫 어 요 ^1,&아 스 고 어&./%%");
ds_map_add(global.text_data_en, "obj_friendscene_353", "느 아 아 아 아 아 아 !!^1!&아 스 고 어 ^1! 인 간 !!/");
ds_map_add(global.text_data_en, "obj_friendscene_354", "아 무 도&싸 우 면  안  돼 !!/");
ds_map_add(global.text_data_en, "obj_friendscene_355", "서 로  친 구 가  돼 야 지 ^1,&아 니 면  내 가 ...!!/");
ds_map_add(global.text_data_en, "obj_friendscene_356", "내 가 .../");
ds_map_add(global.text_data_en, "obj_friendscene_357", ".../%%");
ds_map_add(global.text_data_en, "obj_friendscene_376", "안 녕 ^1.&전&토 리 엘&이 에 요 ./");
ds_map_add(global.text_data_en, "obj_friendscene_377", "인 간 의&친 구&인 가 요 ?/");
ds_map_add(global.text_data_en, "obj_friendscene_378", "만 나 서&반 가&워 요 ./%%");
ds_map_add(global.text_data_en, "obj_friendscene_388", "어 ^1,&네 ...?/");
ds_map_add(global.text_data_en, "obj_friendscene_389", "만 나 서&반 가&워 요 !/%%");
ds_map_add(global.text_data_en, "obj_friendscene_413", "아 스 고 어 ^1,&혹 시&전&마 누 라 ?/");
ds_map_add(global.text_data_en, "obj_friendscene_414", "이 런 ^1.&꽤  고 생&많 네 ^1,&친 구 ./%%");
ds_map_add(global.text_data_en, "obj_friendscene_450", "자 -잠 깐 ^1!/");
ds_map_add(global.text_data_en, "obj_friendscene_451", "아 무 도&해 칠&생 각 하 지&마 !!/");
ds_map_add(global.text_data_en, "obj_friendscene_452", ".../");
ds_map_add(global.text_data_en, "obj_friendscene_453", ".../%%");
ds_map_add(global.text_data_en, "obj_friendscene_477", "아 ^1!&또  다 른^1 &친 구 ?/");
ds_map_add(global.text_data_en, "obj_friendscene_478", "토 리 엘&이 에 요 ^1.&안 녕&하 세 요 !/%%");
ds_map_add(global.text_data_en, "obj_friendscene_487", "어 ^1,&아 -아 -&안 녕&하 세 요 !/");
ds_map_add(global.text_data_en, "obj_friendscene_488", ".../");
ds_map_add(global.text_data_en, "obj_friendscene_489", "(두&명 이 나&있 어 ?)/%%");
ds_map_add(global.text_data_en, "obj_friendscene_546", "이봐^1!&아무도 서로&싸우면 안 돼...!/");
ds_map_add(global.text_data_en, "obj_friendscene_547", "만약 누군가&서로 싸운다면...!/");
ds_map_add(global.text_data_en, "obj_friendscene_548", "내가!!^1!&바로!!!/");
ds_map_add(global.text_data_en, "obj_friendscene_549", "언다인한테&도와달라고&할 거야!!!/%%");
ds_map_add(global.text_data_en, "obj_friendscene_572", "안 녕&하 세 요 !/%%");
ds_map_add(global.text_data_en, "obj_friendscene_582", "오^1!&안녕하세요^1,&폐하!/");
ds_map_add(global.text_data_en, "obj_friendscene_583", "쉬이잇^1!&이봐^1, 인간.../");
ds_map_add(global.text_data_en, "obj_friendscene_584", "아스고어께서&면도를 하신거야...?/");
ds_map_add(global.text_data_en, "obj_friendscene_585", "그리고..^1.&자신을 복제하신 거야???/%%");
ds_map_add(global.text_data_en, "obj_friendscene_631", "얘 들 아 .^1.&무 슨&일 이 야 ?/%%");
ds_map_add(global.text_data_en, "obj_friendscene_644", "이&목 소 리&...!!/%%");
ds_map_add(global.text_data_en, "obj_friendscene_678", "안 녕&하 세 요 ^1,&우 리&.../");
ds_map_add(global.text_data_en, "obj_friendscene_679", "아 는&사 이&같 은 데 ?/%%");
ds_map_add(global.text_data_en, "obj_friendscene_691", "아 ..^1.&그 쪽  목 소 리 도&기 억 나 네 요 ./%%");
ds_map_add(global.text_data_en, "obj_friendscene_705", "전&토 리 엘&이 에 요 ./");
ds_map_add(global.text_data_en, "obj_friendscene_706", "만 나 서&반 가&워 요 ./%%");
ds_map_add(global.text_data_en, "obj_friendscene_717", "제&이 름 은&샌 즈 ./");
ds_map_add(global.text_data_en, "obj_friendscene_718", "그 리 고 ^1,&어 ^1,&동 감 !/%%");
ds_map_add(global.text_data_en, "obj_friendscene_733", "오 !&잠 깐 ^1,&그 러 면 ...!/%%");
ds_map_add(global.text_data_en, "obj_friendscene_760", "이 쪽 이&동 생 ^1, 파 피 루 스 구 나 !/");
ds_map_add(global.text_data_en, "obj_friendscene_761", "반 가 워 요 ^1, 파 피 루 스 ^1!&드 디 어  만 나 게  돼 서&정 말 로  기 뻐 요 !/");
ds_map_add(global.text_data_en, "obj_friendscene_762", "형 이  당 신 에  대 해&엄 청  말 해 줬 어 요 ./%%");
ds_map_add(global.text_data_en, "obj_friendscene_779", "세에상에.../");
ds_map_add(global.text_data_en, "obj_friendscene_780", "아스고어의 클론이&날 알고 있다니!!!/");
ds_map_add(global.text_data_en, "obj_friendscene_781", "오늘은 내 인생&최고의 날이야!!!!!!!/%%");
ds_map_add(global.text_data_en, "obj_friendscene_795", "저 기 ^1, 파 피 루 스 .../");
ds_map_add(global.text_data_en, "obj_friendscene_796", "뼈 다 귀 들 은  지 붕 을&뭘 로  만 들 까 요 ?/%%");
ds_map_add(global.text_data_en, "obj_friendscene_808", "흠 ..^1.&방설 지붕&타일???/%%");
ds_map_add(global.text_data_en, "obj_friendscene_819", "아 니 에 요 ^1!&뼈 다 귀 들 은  지 붕 을 .../");
ds_map_add(global.text_data_en, "obj_friendscene_820", " '골 '판 지 로  만 들 죠 !!!/%%");
ds_map_add(global.text_data_en, "obj_friendscene_846", "생각을 바꿨어!!!/");
ds_map_add(global.text_data_en, "obj_friendscene_847", "오늘은 내 인생&최악의 날이야!!!/%%");
ds_map_add(global.text_data_en, "obj_friendscene_863", "이 봐 ^1, 아 스 고 어 ^1!&괜 찮 을  거 야 !/");
ds_map_add(global.text_data_en, "obj_friendscene_864", "바 다 에  생 선 은&많 다 구 .../%%");
ds_map_add(global.text_data_en, "obj_friendscene_880", "마 -맞 아 요 ^1,&아 스 고 어  님 !!/");
ds_map_add(global.text_data_en, "obj_friendscene_881", "언 다 인 의&생 선  어 쩌 구 가&맞 아 요 !/");
ds_map_add(global.text_data_en, "obj_friendscene_882", "하 -한  번 씩 은&그 냥 ^1, 어 .../");
ds_map_add(global.text_data_en, "obj_friendscene_883", "터 -털  많 은&보 스  몬 스 터 는&그 만  따 라 다 니 고 ^1,&어 .../");
ds_map_add(global.text_data_en, "obj_friendscene_884", "그 -그 냥&진 짜  귀 여 운  생 선 을&만 나 야  한 다 ...?/");
ds_map_add(global.text_data_en, "obj_friendscene_885", ".../");
