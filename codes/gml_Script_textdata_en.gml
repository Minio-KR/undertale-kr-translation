ds_map_add(global.text_data_en, "SCR_TEXT_5617", "* 오 아 아 아 ^1!&* 룸 서 비 스 !/");
ds_map_add(global.text_data_en, "SCR_TEXT_5618", '* "시 나 몬 버 니 " 가 져 왔 어 요 ?& &         예           아 니 \C');
ds_map_add(global.text_data_en, "SCR_TEXT_5619", " ");
ds_map_add(global.text_data_en, "SCR_TEXT_5623", "* 룸 서 비 스 가  오 질  않 네 ^1.&* (한 숨 ...)/%%");
ds_map_add(global.text_data_en, "SCR_TEXT_5628", "* 정 말  저 엉 말&  고 마 워 요 . /%%");
ds_map_add(global.text_data_en, "SCR_TEXT_5632", "* (응 답 이  없 다 .)/%%");
ds_map_add(global.text_data_en, "SCR_TEXT_5646", "* (시 나 몬 버 니 를  종 잇 장 처 럼&  납 작 해 지 게  눌 렀 다 .)&* (문  아 래 로  밀 어 넣 었 다 .)/");
ds_map_add(global.text_data_en, "SCR_TEXT_5647", "* 아 !?!?!?!^2?&* 제 가  원 하 던  그 대 로 예 요 ^1!&* 여 기  팁 이 에 요 ./");
ds_map_add(global.text_data_en, "SCR_TEXT_5648", "* (99G를  얻 었 다 .)/%%");
