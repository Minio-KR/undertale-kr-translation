ds_map_add(global.text_data_en, "obj_endflowey_205", "\E0저 기 ./");
ds_map_add(global.text_data_en, "obj_endflowey_206", "\E9만 약 에  내 가 .../");
ds_map_add(global.text_data_en, "obj_endflowey_207", "\E0더  나 은  엔 딩 을  보 는  법 을&알 고  있 다 고  말 한 다 면 ?/");
ds_map_add(global.text_data_en, "obj_endflowey_208", "\E9너  저 장 된  파 일 을&불 러 온  다 음 .../");
ds_map_add(global.text_data_en, "obj_endflowey_211", "\E9너  처 음 부 터&다 시  시 작 하 거 나 ^1, 해 서 .../");
ds_map_add(global.text_data_en, "obj_endflowey_216", "\E0흠 , 언 제  한  번 ^1,&알 피 스  박 사 를&보 러  가 는  게  어 때 ?/");
ds_map_add(global.text_data_en, "obj_endflowey_219", "\E0흠 , 언 제  한  번 ^1,&언 다 인 을&보 러  가 는  게  어 때 ?/");
ds_map_add(global.text_data_en, "obj_endflowey_223", "\E0흠 , 언 제  한  번 ^1,&파 피 루 스 랑  언 다 인 을&보 러  가 는  게  어 때 ?/");
ds_map_add(global.text_data_en, "obj_endflowey_226", "\E9더  좋 은  친 구 가&될  수 도  있 었 던  것&같 은 데  말 이 야 ./");
ds_map_add(global.text_data_en, "obj_endflowey_227", "혹 시  모 르 지 ..^1. 어 쩌 면&걔 가  네  행 복 의  열 쇠 를&쥐 고  있 을 지 도 ...?/");
ds_map_add(global.text_data_en, "obj_endflowey_228", "\E4나 중 에  보 자 고 ./%%");
ds_map_add(global.text_data_en, "obj_endflowey_242", "하 지 만 ^1, 그 럼 에 도 ^1,&네  해 피  엔 딩 은&오 지  않 았 어 ./");
ds_map_add(global.text_data_en, "obj_endflowey_243", "\E5왜 일 까 ...?/");
ds_map_add(global.text_data_en, "obj_endflowey_244", "\E4난  알 고  있 지 ./");
ds_map_add(global.text_data_en, "obj_endflowey_245", "\E4알 피 스  박 사 에 게  가 봐 ./");
ds_map_add(global.text_data_en, "obj_endflowey_246", "\E5데 이 트 는  이 제&막  시 작 이 었 잖 아 ./%%");
ds_map_add(global.text_data_en, "obj_endflowey_259", "한  명 도  죽 이 지  않 으 면 서&여 기 까 지  와  놓 고 .../");
ds_map_add(global.text_data_en, "obj_endflowey_260", "\E5그 러 고 선  아 스 고 어 는&죽 이 기 로  작 정 했 던  거 야 ?/");
ds_map_add(global.text_data_en, "obj_endflowey_261", "\E6넌  대 체&어 떻 게  돼  먹 은  놈 이 야 ?/");
ds_map_add(global.text_data_en, "obj_endflowey_262", "\E4요 점 을  전 혀&짚 지  못 했 네 ./");
ds_map_add(global.text_data_en, "obj_endflowey_263", "\E2날  엿 먹 이 려 는  건 가 ?/");
ds_map_add(global.text_data_en, "obj_endflowey_264", "\E0왜 냐 하 면 ./");
ds_map_add(global.text_data_en, "obj_endflowey_265", "\E4아 냐 ./");
ds_map_add(global.text_data_en, "obj_endflowey_266", "\E5넌  네  자 신 을&갖 고  놀 고  있 을&뿐 이 야 ./");
ds_map_add(global.text_data_en, "obj_endflowey_267", "\E6모 든  이 들 의&시 간 을  낭 비 했 어 ./");
ds_map_add(global.text_data_en, "obj_endflowey_268", "\E7네 가  해 야 했 던  건&친 구 를  만 드 는  것&뿐 이 었 다 고 ./");
ds_map_add(global.text_data_en, "obj_endflowey_269", "파 피 루 스 ^1, 언 다 인 ^1,&그 리 고  알 피 스 ./");
ds_map_add(global.text_data_en, "obj_endflowey_270", "\E2하 지 만  넌  전 부&망 쳐 버 리 는  데 에 만&여 념 이  없 었 지 !/%%");
ds_map_add(global.text_data_en, "obj_endflowey_284", "이 봐 ./");
ds_map_add(global.text_data_en, "obj_endflowey_285", "네 가  날  이 겼 으 니 ./");
ds_map_add(global.text_data_en, "obj_endflowey_286", "생 각 해 봤 는 데 ./");
ds_map_add(global.text_data_en, "obj_endflowey_287", "\E3누 군 가 를  죽 이 는  게&정 말 로  꼭  필 요 한 가 ?/");
ds_map_add(global.text_data_en, "obj_endflowey_288", "\E1난 .../");
ds_map_add(global.text_data_en, "obj_endflowey_289", "\E3난  솔 직 히&더  이 상  잘  모 르 겠 어 ./");
ds_map_add(global.text_data_en, "obj_endflowey_290", "\E0너 한 테  부 탁 이  있 어 ./");
ds_map_add(global.text_data_en, "obj_endflowey_291", "\E4증 명 해  봐 .../");
ds_map_add(global.text_data_en, "obj_endflowey_292", "\E5네 가  살 아 남 을  정 도 로&강 하 다 는  걸  증 명 해  봐 ./");
ds_map_add(global.text_data_en, "obj_endflowey_293", "\E6처 음 부 터  다 시&여 기 까 지  와  봐 ./");
ds_map_add(global.text_data_en, "obj_endflowey_294", "\E0단  한  명 도&죽 이 지  않 고 .../");
ds_map_add(global.text_data_en, "obj_endflowey_296", "\E4...그 러 면  나 는  왕 을&죽 이 지  않 을 게 ./");
ds_map_add(global.text_data_en, "obj_endflowey_298", "\E4...그 렇 게 ^1, 어 쩌 면 .../");
ds_map_add(global.text_data_en, "obj_endflowey_299", '\E7넌  소 위  말 하 는&"해 피  엔 딩 "이 란  걸&볼  수  있 겠 지 ./');
ds_map_add(global.text_data_en, "obj_endflowey_300", "\E6그 래 서 ^1, 어 떻 게  될 까 ?/");
ds_map_add(global.text_data_en, "obj_endflowey_301", "\E5할  수  있 단  걸&증 명 할  수  있 을 까 ?/");
ds_map_add(global.text_data_en, "obj_endflowey_302", "\E8아 니 면  내 가&네  고 통 을  지 켜 보 게&될 까 ...?/");
ds_map_add(global.text_data_en, "obj_endflowey_303", "어 느  쪽 이 든 ^1,&재 미 있 겠 는 데 !!!/");
ds_map_add(global.text_data_en, "obj_endflowey_304", "\E4히  히  히 .../%%");
ds_map_add(global.text_data_en, "obj_endflowey_319", "재 미 있 어 .../");
ds_map_add(global.text_data_en, "obj_endflowey_320", "\E6그 래 서 ^1, 네 가  한  모 든  일 들&끝 에 도 .../");
ds_map_add(global.text_data_en, "obj_endflowey_321", "\E5결 과 는  여 전 히  똑 같 네 ./");
ds_map_add(global.text_data_en, "obj_endflowey_322", "\E9결 국 에 ^1, 네  선 택 지 들 은&그 저  허 상 이 었 던&것 뿐 이 야 ./");
ds_map_add(global.text_data_en, "obj_endflowey_323", "\E9네 가  뭘  하 든&아 무  영 향 이  없 다 고 !/");
ds_map_add(global.text_data_en, "obj_endflowey_324", "\E8히  히  히 !/");
ds_map_add(global.text_data_en, "obj_endflowey_325", "\E8.../");
ds_map_add(global.text_data_en, "obj_endflowey_326", "\E0뭐 ./");
ds_map_add(global.text_data_en, "obj_endflowey_327", "\E6진 짜 로&내 가  말 한  대 로  했 구 나 ./");
ds_map_add(global.text_data_en, "obj_endflowey_328", "\E5너 한 테  '진 짜 '&해 피  엔 딩 을  보 여 주 는  게&내  일 인  것  같 네 ./");
ds_map_add(global.text_data_en, "obj_endflowey_329", "\E0처 음  시 작 할  때 는 ^1,&혼 자 서  모 든  걸&해  낼  수 는  없 지 ./");
ds_map_add(global.text_data_en, "obj_endflowey_330", "파 피 루 스 ^1, 언 다 인 ^1,&알 피 스 ..^1. 얘 들  말 이 야 ./");
ds_map_add(global.text_data_en, "obj_endflowey_331", "\E4얘 들 이 랑  아 직&친 구 가  못  된 거 야 ?/");
ds_map_add(global.text_data_en, "obj_endflowey_332", '\E5다 시  돌 아 가 서&녀 석 들 이 랑 ..^1. "어 울 려 "&보 는  게  어 때 ./');
ds_map_add(global.text_data_en, "obj_endflowey_333", "\E4우 정 의  힘 .../");
ds_map_add(global.text_data_en, "obj_endflowey_334", "그 게  항 상&세 상 을  구 하 잖 아 ^1,&안  그 래 ?/%%");
ds_map_add(global.text_data_en, "obj_endflowey_349", "\E0그 래 서 ^1,&사 람 들 을  죽 이 는  건&'정 말 로 ' 괜 찮 다 고 ...?/");
ds_map_add(global.text_data_en, "obj_endflowey_350", "\E4물 론 ./");
ds_map_add(global.text_data_en, "obj_endflowey_351", "우 리  둘 이  삶 에  대 한&가 치 관 이  같 아 서  기 뻐 ./");
ds_map_add(global.text_data_en, "obj_endflowey_352", "너 한 테  배 운  게&정 말  많 아 ./");
ds_map_add(global.text_data_en, "obj_endflowey_353", "\E0그 런 데 ..^1. 너  정 말 로&죄 다  하 다  말 기 만&할  거 야 ?/");
ds_map_add(global.text_data_en, "obj_endflowey_354", "\E8네 가  죽 인&사 람 들 의  머 릿 수 .../");
ds_map_add(global.text_data_en, "obj_endflowey_355", "\E9솔 직 히  정 말&실 망 스 러 워 ./");
ds_map_add(global.text_data_en, "obj_endflowey_356", "\E8이  멍 청 이 ./");
ds_map_add(global.text_data_en, "obj_endflowey_357", "\E4넌  정 말  할  수  있 는  게&아 무 것 도  없 구 나 ./%%");
ds_map_add(global.text_data_en, "obj_endflowey_372", "왜 ^1, \[차]...?/");
ds_map_add(global.text_data_en, "obj_endflowey_373", "\E3왜 ?/");
ds_map_add(global.text_data_en, "obj_endflowey_374", "\E1왜 ?/");
ds_map_add(global.text_data_en, "obj_endflowey_375", "\E8우 리 는  진 짜  승 리 를  향 해&다 가 가 고  있 었 어 .../");
ds_map_add(global.text_data_en, "obj_endflowey_376", "\E9최 후 의  순 간 을  향 해&가 고  있 었 다 고 !/");
ds_map_add(global.text_data_en, "obj_endflowey_377", "\E2왜  전 부  이 딴  식 으 로&망 쳐 버 린  건 데 ?/");
ds_map_add(global.text_data_en, "obj_endflowey_378", "\E5하 하 하 .../");
ds_map_add(global.text_data_en, "obj_endflowey_379", "\E9복 수 인 가 ?/");
ds_map_add(global.text_data_en, "obj_endflowey_382", "\E1네 가  순 수 하 고  행 복 하 게&행 동 하 는  걸  보 게  해 놓 고 ^1,&그 럼  나 는 ...?/");
ds_map_add(global.text_data_en, "obj_endflowey_386", "\E1네 가  네  방 식 으 로&살 아 가 는  걸  보 게  해 놓 고 ^1,&그 럼  나 는 ...?/");
ds_map_add(global.text_data_en, "obj_endflowey_389", "\E1.../");
ds_map_add(global.text_data_en, "obj_endflowey_390", "\E7아 냐 ./");
ds_map_add(global.text_data_en, "obj_endflowey_391", "\E8아 냐 ./");
ds_map_add(global.text_data_en, "obj_endflowey_392", "네 가  뭘  하 고&있 는 지  알 아 ./");
ds_map_add(global.text_data_en, "obj_endflowey_393", "넌  그 냥  뭐 가  어 떤 지&다  보 고  싶 은 거 야 ./");
ds_map_add(global.text_data_en, "obj_endflowey_394", "우 리 가  다  앗 아 가 기&전 에  말 이 야 ./");
ds_map_add(global.text_data_en, "obj_endflowey_395", "아 하 하 하 .../");
ds_map_add(global.text_data_en, "obj_endflowey_396", "\E9천 재 적 이 야 ^1, \[차]./");
ds_map_add(global.text_data_en, "obj_endflowey_397", "\E4그 래 ^1, 네 가  그 러 고&다 니 게  놔  둘 게 ./");
ds_map_add(global.text_data_en, "obj_endflowey_398", "\E8결 국 엔  돌 아 올  걸&알 고  있 으 니 ./");
ds_map_add(global.text_data_en, "obj_endflowey_399", "\E9그 리 고&그 때 가  오 면 .../");
ds_map_add(global.text_data_en, "obj_endflowey_400", "\E4\[차]./");
ds_map_add(global.text_data_en, "obj_endflowey_401", "\E4내 가  널&기 다 리 고  있 을  거 야 ./%%");
ds_map_add(global.text_data_en, "obj_endflowey_415", "왜  계 속&여 기 로  돌 아 오 는  거 지 ?/");
ds_map_add(global.text_data_en, "obj_endflowey_416", "\E5아 ^1, 알 겠 다 ^1.&친 구 가  되 려 는  거 지 ^1,&응 ...?/");
ds_map_add(global.text_data_en, "obj_endflowey_417", "\E8불 쌍 한  놈 ./");
ds_map_add(global.text_data_en, "obj_endflowey_418", "\E8너  정 말 로  내 가  '너 '랑&친 구 가  되 길  바 란 다 고&생 각 하 는  거 야 ?/");
ds_map_add(global.text_data_en, "obj_endflowey_419", "\E5헤 .../");
ds_map_add(global.text_data_en, "obj_endflowey_420", "\E9정 말 로  이 해 를&못 하 는 구 나 ^1, 응 ?/");
ds_map_add(global.text_data_en, "obj_endflowey_421", "\E5내 가  아 낄  수  있 는&사 람 은  이 제  오 직&한  명  뿐 이 야 ./");
ds_map_add(global.text_data_en, "obj_endflowey_422", "\E6그 렇 지 만 서 도 ^1,&난  진 심 으 로&아 껴 주 지 는  않 았 어 ./");
ds_map_add(global.text_data_en, "obj_endflowey_423", "\E5난  그 냥  저  밖  어 딘 가 에&누 군 가 .../");
ds_map_add(global.text_data_en, "obj_endflowey_424", "질 리 지  않 는  녀 석 이&있 다 고  생 각 하 는  게&좋 았 어 ./");
ds_map_add(global.text_data_en, "obj_endflowey_425", "\E8나  같 은  녀 석 이 랄 까 ./");
ds_map_add(global.text_data_en, "obj_endflowey_426", "\E8.../");
ds_map_add(global.text_data_en, "obj_endflowey_427", "\E0저 기 ./");
ds_map_add(global.text_data_en, "obj_endflowey_428", "\E4그  멍 청 한  표 정 으 로&나  좀  그 만&쳐 다 볼 래 ./");
ds_map_add(global.text_data_en, "obj_endflowey_429", "너  때 문 에&빡 치 거 든 ./%%");
ds_map_add(global.text_data_en, "obj_endflowey_443", "\E0그 래  너  또&여 길  왔 네 ./");
ds_map_add(global.text_data_en, "obj_endflowey_444", "\E2넌  도 대 체  뭐 가&문 제 인 거 야 ?/");
ds_map_add(global.text_data_en, "obj_endflowey_445", "\E4너  설 마&플 라 위  팬  클 럽 이 라 도&만 드 려 는  거 야 ?/");
ds_map_add(global.text_data_en, "obj_endflowey_446", "\E5왜 냐 하 면  네 가&거 기 에  가 입 하 려 면 .../");
ds_map_add(global.text_data_en, "obj_endflowey_447", "\E4파 피 루 스 한 테&말 해 야  할  거 거 든 ./");
ds_map_add(global.text_data_en, "obj_endflowey_448", "\E6그 래 ^1, 걔 가&만 들 었 어 ./");
ds_map_add(global.text_data_en, "obj_endflowey_449", "\E5어 찌 보 면  몇  번 이 나^1, 아 무 튼 ./");
ds_map_add(global.text_data_en, "obj_endflowey_450", "\E0솔 직 히  말 할 게 ./");
ds_map_add(global.text_data_en, "obj_endflowey_451", "\E4걔 는  정 말&장 난 치 기  좋 은&녀 석 이 야 ./");
ds_map_add(global.text_data_en, "obj_endflowey_452", "\E5걔 한 테  질 리 기 까 지 는&꽤  오 래  걸 렸 지 ./");
ds_map_add(global.text_data_en, "obj_endflowey_453", "\E7...그 래 ./");
ds_map_add(global.text_data_en, "obj_endflowey_454", "\E4걔 한 테  말 해  봐 ./%%");
ds_map_add(global.text_data_en, "obj_endflowey_468", "\E0그 래 서 ./");
ds_map_add(global.text_data_en, "obj_endflowey_469", "\E4플 라 위  팬  클 럽 은&결 성 했 어 ?/");
ds_map_add(global.text_data_en, "obj_endflowey_470", "\E5하 ^1.&농 담 이 야 ./");
ds_map_add(global.text_data_en, "obj_endflowey_471", "\E9다  보 고  있 었 어 ^1.&안  그 런  거  알 아 ./");
ds_map_add(global.text_data_en, "obj_endflowey_472", "\E5하 지 만  상 관 없 어 ^1. 정 말 로 ./");
ds_map_add(global.text_data_en, "obj_endflowey_473", "\E6아 마  걔 는&자 기  쓰 레 기  형 을&초 대 했 겠 지 ./");
ds_map_add(global.text_data_en, "obj_endflowey_474", "\E4알 잖 아 ^1.&실 실  웃 는  얼 굴 의  똥 자 루 ./");
ds_map_add(global.text_data_en, "obj_endflowey_475", "\E0.../");
ds_map_add(global.text_data_en, "obj_endflowey_476", "\E4그 래 ./");
ds_map_add(global.text_data_en, "obj_endflowey_477", "내 가  너 한 테  충 고 할  게&한  가 지  있 다 면 .../");
ds_map_add(global.text_data_en, "obj_endflowey_478", "\E9절 대 로 ./");
ds_map_add(global.text_data_en, "obj_endflowey_479", "걔 네  형 이 ./");
ds_map_add(global.text_data_en, "obj_endflowey_480", "너 에  대 해&아 무 것 도  모 르 게  해./");
ds_map_add(global.text_data_en, "obj_endflowey_481", "\E6놈 은 ..^1. 음 .../");
ds_map_add(global.text_data_en, "obj_endflowey_482", "\E5그 냥  이 렇 게  말 하 지 ./");
ds_map_add(global.text_data_en, "obj_endflowey_483", "\E9놈 은  내 가  예 상 했 던&리 셋  수 보 다  리 셋 을&훨 씬  많 이  하 게  했 어 ./");
ds_map_add(global.text_data_en, "obj_endflowey_484", "\E4그 놈 을&조 심 하 라 고 ./%%");
ds_map_add(global.text_data_en, "obj_endflowey_498", "\E0왜  계 속  여 기 로&돌 아 오 는  거 야 ?/");
ds_map_add(global.text_data_en, "obj_endflowey_499", "정 말  친 구 가  되 고&싶 다 는  건  아 니 겠 지 ^1,&안  그 래 ...?/");
ds_map_add(global.text_data_en, "obj_endflowey_500", ".../");
ds_map_add(global.text_data_en, "obj_endflowey_501", "\E4아 냐 ^1. 알 겠 어 ./");
ds_map_add(global.text_data_en, "obj_endflowey_502", "넌  나 랑  똑 같 아 ^1.&안  그 래 ?/");
ds_map_add(global.text_data_en, "obj_endflowey_503", "넌  아 무 도&신 경  쓰 지  않 아 ./");
ds_map_add(global.text_data_en, "obj_endflowey_504", "\E4넌  그 냥  심 심 했 던  거 야 ./");
ds_map_add(global.text_data_en, "obj_endflowey_505", "그 냥  내 가  뭐 라 고&말 할 지  보 고  싶 었 던  거 야 ./");
ds_map_add(global.text_data_en, "obj_endflowey_506", "\E5네 가  웃 으 며  날&망 가 진  장 난 감 처 럼&버 릴  수  있 을  거 라 고 ./");
ds_map_add(global.text_data_en, "obj_endflowey_507", "\E8글 쎄 ^1, 그 것  참  안 됐 네 !/");
ds_map_add(global.text_data_en, "obj_endflowey_508", "\E9난  다 른  사 람 들 과 는&달 라 ./");
ds_map_add(global.text_data_en, "obj_endflowey_509", "\E9그 러 니 까 , 이 제 부 터 는 .../");
ds_map_add(global.text_data_en, "obj_endflowey_510", "\E4넌  아 무 것 도&얻 지  못  할  거 야 ./%%");
ds_map_add(global.text_data_en, "obj_endflowey_524", ".../");
ds_map_add(global.text_data_en, "obj_endflowey_525", "\E4달 리  할  일 이  없 니 ?/%%");
ds_map_add(global.text_data_en, "obj_endflowey_regret_111", "안 녕 ./%%");
ds_map_add(global.text_data_en, "obj_endflowey_regret_128", "모 두 가  엄 청&행 복 해 진  것  같 네 ./");
ds_map_add(global.text_data_en, "obj_endflowey_regret_129", "괴 물 들 은&지 상 으 로  돌 아 갔 어 ./");
ds_map_add(global.text_data_en, "obj_endflowey_regret_130", "평 화 와  번 영 이  세 상  곳 곳 에&퍼 져 나 갈  거 야 ./");
ds_map_add(global.text_data_en, "obj_endflowey_regret_131", "\E6숨  좀  돌 려 ./");
ds_map_add(global.text_data_en, "obj_endflowey_regret_132", "\E5더  걱 정 할  건&이 제  없 어 ./%%");
ds_map_add(global.text_data_en, "obj_endflowey_regret_148", "\E7.../");
ds_map_add(global.text_data_en, "obj_endflowey_regret_149", "\E6뭐 ./");
ds_map_add(global.text_data_en, "obj_endflowey_regret_150", "\E1아 직  하 나 가  남 았 지 ./");
ds_map_add(global.text_data_en, "obj_endflowey_regret_151", "\E3마 지 막  위 협 ./");
ds_map_add(global.text_data_en, "obj_endflowey_regret_152", "모 두 가  노 력 해  만 든&모 든  것 을 .../");
ds_map_add(global.text_data_en, "obj_endflowey_regret_153", "\E1지 워 버 리 는  힘 을  가 진&누 군 가 가  남 아 있 지 ./");
ds_map_add(global.text_data_en, "obj_endflowey_regret_154", "\E7.../");
ds_map_add(global.text_data_en, "obj_endflowey_regret_155", "\E6내 가  누 굴  말 하 고  있 는 지&알 겠 지 ^1, 응 ?/");
ds_map_add(global.text_data_en, "obj_endflowey_regret_156", "\E1맞 아 ./");
ds_map_add(global.text_data_en, "obj_endflowey_regret_157", "\E4널  말 하 는  거 야 ./");
ds_map_add(global.text_data_en, "obj_endflowey_regret_158", "\E7네 겐  아 직  모 든  걸&리 셋 시 킬  수  있 는&힘 이  있 어 ./");
ds_map_add(global.text_data_en, "obj_endflowey_regret_159", "\E0토 리 엘 ^1, 샌 즈 ^1, 아 스 고 어 ^1,&알 피 스 , 파 피 루 스 ,&언 다 인 .../");
ds_map_add(global.text_data_en, "obj_endflowey_regret_160", "네 가  리 셋 을  선 택 한 다 면 .../");
ds_map_add(global.text_data_en, "obj_endflowey_regret_161", "모 두 가  이  시 간 선 에 서&뜯 겨  나 가 서 .../");
ds_map_add(global.text_data_en, "obj_endflowey_regret_162", "...이  모 든  일 이&일 어 나 지  않 았 던&과 거 로  돌 아 가 겠 지 ./");
ds_map_add(global.text_data_en, "obj_endflowey_regret_163", "\E6아 무 도  아 무 것 도&기 억  못  할  거 야 ./");
ds_map_add(global.text_data_en, "obj_endflowey_regret_164", "\E5원 하 는  대 로  할  수  있 어 ./");
ds_map_add(global.text_data_en, "obj_endflowey_regret_165", "\E0.../");
ds_map_add(global.text_data_en, "obj_endflowey_regret_166", "\E7그  힘 ./");
ds_map_add(global.text_data_en, "obj_endflowey_regret_167", "\E3나 도  그  힘 을  알 아 ./");
ds_map_add(global.text_data_en, "obj_endflowey_regret_168", "\E6네 가  막 으 려 고  계 속&싸 워 왔 던  그  힘 이 잖 아 ^1,&안  그 래 ?/");
ds_map_add(global.text_data_en, "obj_endflowey_regret_169", "\E7내 가  그 렇 게 나&쓰 고  싶 었 던  그  힘 ./");
ds_map_add(global.text_data_en, "obj_endflowey_regret_170", "\E6근 데  지 금 은 ^1, 모 든  걸&리 셋 시 킨 다 는  그  생 각 은 .../");
ds_map_add(global.text_data_en, "obj_endflowey_regret_171", "\E7난 .../");
ds_map_add(global.text_data_en, "obj_endflowey_regret_172", "\E1그 런  생 각 은  절 대 로&다 시  못  할  것  같 아 ./");
ds_map_add(global.text_data_en, "obj_endflowey_regret_173", "그  일  뒤 로 는 ./");
ds_map_add(global.text_data_en, "obj_endflowey_regret_174", "\E7.../");
ds_map_add(global.text_data_en, "obj_endflowey_regret_175", "\E1그 러 니 , 제 발 ./");
ds_map_add(global.text_data_en, "obj_endflowey_regret_176", "\E3그 냥  놔  줘 ./");
ds_map_add(global.text_data_en, "obj_endflowey_regret_177", "프 리 스 크 가  행 복 하 도 록 ./");
ds_map_add(global.text_data_en, "obj_endflowey_regret_178", "프 리 스 크 가&자 신 의  삶 을  살 도 록 ./%%");
ds_map_add(global.text_data_en, "obj_endflowey_regret_195", "\E1.../");
ds_map_add(global.text_data_en, "obj_endflowey_regret_197", "\E3하 지 만 ./");
ds_map_add(global.text_data_en, "obj_endflowey_regret_199", "만 약  네 가  마 음 을&바 꾸 지  않 을  거 라 면 ./");
ds_map_add(global.text_data_en, "obj_endflowey_regret_201", "만 약  모 든  걸&지 울  생 각 이 라 면 .../");
ds_map_add(global.text_data_en, "obj_endflowey_regret_203", "\E7.../");
ds_map_add(global.text_data_en, "obj_endflowey_regret_205", "\E6내  기 억  역 시 도 ^1,&지 워 야  할  거 야 ./");
ds_map_add(global.text_data_en, "obj_endflowey_regret_207", "\E7.../");
ds_map_add(global.text_data_en, "obj_endflowey_regret_209", "\E6미 안 해 ./");
ds_map_add(global.text_data_en, "obj_endflowey_regret_211", "\E5어 쩌 면  벌 써  천  번 도&넘 게  들 은  얘 기 겠 네 ^1,&응 ...?/");
ds_map_add(global.text_data_en, "obj_endflowey_regret_213", ".../");
ds_map_add(global.text_data_en, "obj_endflowey_regret_215", "\E0뭐 ^1, 이 게  다 야 ./");
ds_map_add(global.text_data_en, "obj_endflowey_regret_217", "\E6나 중 에  봐 .../");
