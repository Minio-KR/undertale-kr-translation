ds_map_add(global.text_data_en, "obj_grillbynpc_womandog_81", "* (그  해 골 들 은  어 딨 어 ?^1)&* (뼈 를  좀  받 고  싶 은 데 ...)/%%");
ds_map_add(global.text_data_en, "obj_grillbynpc_womandog_86", "* (의 사 를  보 러  갈 지&  생 각  중 이 야 .)/");
ds_map_add(global.text_data_en, "obj_grillbynpc_womandog_87", "* (아 니 ^1! 수 의 사  말 고 !^1)&* (...뭐 ^1, 약 간  수 의 사&  비 슷 할 지 도  모 르 지 만 .)/%%");
ds_map_add(global.text_data_en, "obj_grillbynpc_womandog_92", "* (난  샌 즈 가  좋 아 .^1)&* (가 끔  테 이 블  밑 으 로&  음 식 을  준 단  말 이 지 .)/");
ds_map_add(global.text_data_en, "obj_grillbynpc_womandog_93", "* (그 러 면  그  동 생 이  화 를  내 ...^1)&* (어 째 서 !^1? 우 린  어 른 이 라 고 !^1)&* (알 아 서  할  수  있 다 고 !)/%%");
ds_map_add(global.text_data_en, "obj_grillbynpc_womandog_97", "* (도 고 는  어 디 에  있 는  거 지 ?^1)&* (다 시  길 을  잃 은  게&  아 니 었 음  좋 겠 어 .)/%%");
ds_map_add(global.text_data_en, "obj_grillbynpc_womandog_99", "* (오 늘 은  좀  쓸 쓸 하 네 .^1)&* (친 구 들 이  안  나 오 면 ^1,&  네 가  우 리 랑  놀 아  줄 래 ?)/%%");
