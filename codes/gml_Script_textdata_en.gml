ds_map_add(global.text_data_en, "obj_crygen3_56", "* 냅 스 타 블 룩 이  당 신 의  반 응 을&  애 타 게  기 다 리 고  있 다 .");
ds_map_add(global.text_data_en, "obj_crygen3_80", "마 음 에&드 니 ...");
