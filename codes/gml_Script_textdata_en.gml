ds_map_add(global.text_data_en, "obj_pyrope_492", "* 파 이 로 프 는  매 력 적 인  미 소 로&  몸 을  감 싸 고  있 다 .");
ds_map_add(global.text_data_en, "obj_pyrope_493", "* 파 이 로 프 는  화 재 경 보 기 를&  누 르 는  척  하 고  있 다 .");
ds_map_add(global.text_data_en, "obj_pyrope_494", "* 파 이 로 프 는  이 를  드 러 내 며&  빙 그 레  웃 고  있 다 .");
ds_map_add(global.text_data_en, "obj_pyrope_495", "* 파 이 로 프 는  양 초 인  척&  하 고  있 다 .");
ds_map_add(global.text_data_en, "obj_pyrope_496", "* 로 프 가  타 는  냄 새 가  난 다 .");
ds_map_add(global.text_data_en, "obj_pyrope_497", "* 파 이 로 프 는  더  많 은  열 을&  원 한 다 .");
ds_map_add(global.text_data_en, "obj_pyrope_498", "* 방 이  찌 는  듯  더 워 진 다 !");
ds_map_add(global.text_data_en, "obj_pyrope_524", "* 파 이 로 프  - ATK 29 DEF 14&* 이  짓 궂 은  괴 물 은&  적 당 히  뜨 겁 지 가  않 다 ./^");
ds_map_add(global.text_data_en, "obj_pyrope_534", "* 당 신 은  파 이 로 프 에 게  바 람 을&  불 었 다 ^1. 불 꽃 이  사 그 라 든 다 .&* 파 이 로 프 의  공 격 력  감 소 !/^");
ds_map_add(global.text_data_en, "obj_pyrope_555", "* 당 신 은  온 도  조 절 기 를  돌 렸 다 .&* 파 이 로 프 가  흥 분 하 기  시 작 했 다 ./^");
ds_map_add(global.text_data_en, "obj_pyrope_556", "* 당 신 은  온 도  조 절 기 를  돌 렸 다 .&* 엄 청  뜨 겁 다 !&* 파 이 로 프 는  만 족 한  것  같 다 ./^");
ds_map_add(global.text_data_en, "obj_pyrope_557", "* 당 신 은  온 도  조 절 기 를  돌 렸 다 .&* 저 어 어 어 엉 말 로&  뜨 겁 다 !/^");
ds_map_add(global.text_data_en, "obj_pyrope_571", "* 당 신 은  파 이 로 프 에 게&  놀 자 고  했 다 ./^");
ds_map_add(global.text_data_en, "obj_pyropenpc_72", "* 하 하 ^1, 하  하  하 ^1.&* 비 밀 ^1, 비 밀 이 야 ^1.&* 내 가  말 썽 을  피 워  놨 지 ./");
ds_map_add(global.text_data_en, "obj_pyropenpc_73", "* 용 암 에  불 을  질 렀 어 ./");
ds_map_add(global.text_data_en, "obj_pyropenpc_74", "* 아 무 도  그  사 실 을&  절 대  모 를  거 야 ^1.&* 이 건  완 전  범 죄 야 .../%%");
ds_map_add(global.text_data_en, "obj_pyropenpc_78", "* 하 하 ^1, 하  하  하 ^1.&* 우 리 가  떠 나 면 ^1, 정 말 로&  아 무 도  절 대  모 를  거 야 !/%%");
ds_map_add(global.text_data_en, "obj_pyropenpc_82", "* 이  용 암 은  이 제&  너 무  화 끈 하 군 ./%%");
ds_map_add(global.text_data_en, "obj_pyropenpc_87", '* 하 하 ^1, 하  하  하 ^1.&* 너  나 랑  "놀 고 " 싶 어 ?/');
ds_map_add(global.text_data_en, "obj_pyropenpc_88", "* 하 하 ^1, 하  하  하 ^1.&* 미 안 ^1, 난  이 미  바 쁘 다 고 !!!/");
ds_map_add(global.text_data_en, "obj_pyropenpc_89", "* 속 았 지 ^1! 당 했 지 ^1!&* 누 구 도  내  친 구 가&  되 고  싶 어 하 지  않 아 !!!/%%");
ds_map_add(global.text_data_en, "obj_pyropenpc_93", "* 하 하 ^1, 하  하  하 ^1.&* 인 간 이  내  친 구 가&  되 고  싶 어 할 까 ./");
ds_map_add(global.text_data_en, "obj_pyropenpc_94", "* 속 아 았 지 ^1!&* 그 런  일 은  절 대 로&  일 어 나 지  않 을  거 야 !/%%");
