ds_map_add(global.text_data_en, "obj_maddummy_1654", "...미 안 ^1, 내 가&방 해 했 나  보 네 ^1,&그 렇 지 ?/");
ds_map_add(global.text_data_en, "obj_maddummy_1655", "내 가  오 자 마 자 ^1,&네  친 구 가  바 로&떠 나  버 렸 어 .../");
ds_map_add(global.text_data_en, "obj_maddummy_1656", "이 런 ..^1.&너 희 들  즐 거 워&보 였 는 데 .../");
ds_map_add(global.text_data_en, "obj_maddummy_1657", "이 런 ..^1.&나 는  그 냥  안 녕 이 라 고&말 하 고  싶 었 는 데 .../");
ds_map_add(global.text_data_en, "obj_maddummy_1658", "이 런 ........................................%%");
ds_map_add(global.text_data_en, "obj_maddummy_1663", "잠 깐 ..^1. 전 에  나 를&공 격 하 지  않 았 었 나 .../");
ds_map_add(global.text_data_en, "obj_maddummy_1664", "어 ..^1.&이 상 한 데 ./");
ds_map_add(global.text_data_en, "obj_maddummy_1665", "미 안 해 ^1.&좋 은  날  보 내 ./%%");
ds_map_add(global.text_data_en, "obj_mainend_158", "* (따 르 릉 ^1, 따 르 릉 ...)/");
ds_map_add(global.text_data_en, "obj_mainend_160", "* 어 이 ./");
ds_map_add(global.text_data_en, "obj_mainend_161", "\E1* 여 보 세 요 ...?/");
ds_map_add(global.text_data_en, "obj_mainend_162", "\E2* 음 ^1, 그 냥  메 시 지&  남 기 지  뭐 .../%%");
ds_map_add(global.text_data_en, "obj_mainend_169", "\E1* 여 보 세 요 ...?/");
ds_map_add(global.text_data_en, "obj_mainend_170", "\E2* 어 ..^1. 그 냥&  전 해 주 려 고 ./");
ds_map_add(global.text_data_en, "obj_mainend_171", "\E1* 한  눈 사 람 을  정 말&  행 복 하 게  해  줬 더 군 ./");
ds_map_add(global.text_data_en, "obj_mainend_172", "\E2* ... 다 른  말 도&  해  줘 야  할  것 ^1, 같 네 ./%%");
ds_map_add(global.text_data_en, "obj_mainend_177", "* 어 이 ./");
ds_map_add(global.text_data_en, "obj_mainend_178", "\E2* 어 ..^1. 그 냥&  전 해 주 려 고 ./");
ds_map_add(global.text_data_en, "obj_mainend_179", "\E1* 꽤  오 래  됐 는 데 ^1.&* 저 장 해 봐 야  하 는  거&  아 니 야 ?/");
ds_map_add(global.text_data_en, "obj_mainend_180", "\E2* ... 다 른  말 도&  해  줘 야  할  것 ^1, 같 네 ./%%");
ds_map_add(global.text_data_en, "obj_mainend_186", "\E1* 여 보 세 요 ...?/");
ds_map_add(global.text_data_en, "obj_mainend_187", "\E2* 음 ...^1 그 냥&  물 어 보 려 고 ./");
ds_map_add(global.text_data_en, "obj_mainend_188", "\E1* 그  더 러 운  밴 드&한  번 이 라 도  뗐 어 ...?/");
ds_map_add(global.text_data_en, "obj_mainend_189", "\E2* ... 다 른  말 도&  해  줘 야  할  것 ^1, 같 네 ./%%");
ds_map_add(global.text_data_en, "obj_mainend_195", "\E1* 여 보 세 요 ...?/");
ds_map_add(global.text_data_en, "obj_mainend_196", "\E2* 음 ...^1 그 냥&  물 어 보 려 고 ./");
ds_map_add(global.text_data_en, "obj_mainend_197", "\E1* 뭐 라 도  먹 어 야 &  하 는  거  아 냐 ?/");
ds_map_add(global.text_data_en, "obj_mainend_198", "\E2* ... 다 른  말 도&  해  줘 야  할  것 ^1, 같 네 ./%%");
ds_map_add(global.text_data_en, "obj_mainend_204", "\E1* 여 보 세 요 ...?/");
ds_map_add(global.text_data_en, "obj_mainend_205", "\E2* 음 ...^1 그 냥&  물 어 보 려 고 ./");
ds_map_add(global.text_data_en, "obj_mainend_206", "\E1* 도 전 하 는  걸&  참  좋 아 하 는 구 나 ^1,&  응 ...?/");
ds_map_add(global.text_data_en, "obj_mainend_207", "\E2* 음 ...^1 잘 했 어 ./");
ds_map_add(global.text_data_en, "obj_mainend_208", "\E1* 그 걸 로  우 쭐 대 고&  다 니 지 만  말 라 고 ^1.&  알 겠 어 ?/");
ds_map_add(global.text_data_en, "obj_mainend_209", "\E2* ... 다 른  말 도&  해  줘 야  할  것 ^1, 같 네 ./%%");
ds_map_add(global.text_data_en, "obj_mainend_214", "* .../");
ds_map_add(global.text_data_en, "obj_mainend_215", "* 좋 아 ^1. 번 호  알 았 어 ./%%");
ds_map_add(global.text_data_en, "obj_mainend_250", "* 그 래 ..^1.&* 시 간 이  꽤  지 났 네 ./");
ds_map_add(global.text_data_en, "obj_mainend_251", "\E0* 여 왕 님 이  돌 아 와 서 ^1, &  지 금  지 하  세 계 를&  다 스 리 고  있 어 ./");
ds_map_add(global.text_data_en, "obj_mainend_252", "* 또  새 로 운  정 책 을&  선 포 했 는 데 .../");
ds_map_add(global.text_data_en, "obj_mainend_253", "\E3* 이 곳 으 로  떨 어 지 는&  모 든  인 간 은  적 이  아 닌 .../");
ds_map_add(global.text_data_en, "obj_mainend_254", "\E0* 친 구 로  대 접 받 게&  될  거 야 ./");
ds_map_add(global.text_data_en, "obj_mainend_255", "\E1* 아 마  그 게  최 선 이 겠 지 ^1,&  아 무 튼 ./");
ds_map_add(global.text_data_en, "obj_mainend_256", "\E0* 왕 이  모 았 던&  인 간 의  영 혼 들 이 .../");
ds_map_add(global.text_data_en, "obj_mainend_257", "\E3* 사 라 져 버 린  것  같 아 ./");
ds_map_add(global.text_data_en, "obj_mainend_258", "\E1* 그 러 니 까 ^1, 어 ^1, 왕 의&  계 획 은  당 분 간 은&  취 소 된  것  같 네 ./");
ds_map_add(global.text_data_en, "obj_mainend_263", "* 이 곳  사 람 들 은&  왕 께  벌 어 진  일 에&  가 슴  아 파 하 고  있 고 .../");
ds_map_add(global.text_data_en, "obj_mainend_264", "\E1* ...우 리 의  자 유 는&  암 담 해 서  보 이 지 도&  않 지 만 .../");
ds_map_add(global.text_data_en, "obj_mainend_265", "\E0* 여 왕 님 은  우 리 가&  희 망 을  버 리 지  않 도 록&  최 선 을  다 하 고  있 어 ./");
ds_map_add(global.text_data_en, "obj_mainend_267", "\E1* 그 러 니 ^1, 어 ^1, 이 봐 .../");
ds_map_add(global.text_data_en, "obj_mainend_268", "\E1* 우 리 가  이  아 래 에 서&  포 기 하 지  않 는  한 .../");
ds_map_add(global.text_data_en, "obj_mainend_269", "\E2* 너 도  어 디 에  있 든&  포 기 하 지  말 라 구 ^1,&  알 겠 어 ?/");
ds_map_add(global.text_data_en, "obj_mainend_270", "\E3* 얼 마 나  걸 릴 진&  모 르 겠 지 만 .../");
ds_map_add(global.text_data_en, "obj_mainend_271", "\E0* 우 리 는  여 기 서&  나 갈  거 야 ./");
ds_map_add(global.text_data_en, "obj_mainend_272", "\E2* 약 속 할 게 ./");
ds_map_add(global.text_data_en, "obj_mainend_274", "샌즈 형!!!&누구랑 얘기해???/");
ds_map_add(global.text_data_en, "obj_mainend_276", "* 어 ^1, 아 무 도  아 냐 ./");
ds_map_add(global.text_data_en, "obj_mainend_278", "뭐!^1?&아무랑도 말&안 하고 있었다고!?/");
ds_map_add(global.text_data_en, "obj_mainend_279", "\E0난 아무랑&말할 수 있을까???/");
ds_map_add(global.text_data_en, "obj_mainend_281", "* 여 기 ^1. 마 음 껏  해 봐 ./%%");
ds_map_add(global.text_data_en, "obj_mainend_292", "잠깐만 기다려 봐.../");
ds_map_add(global.text_data_en, "obj_mainend_293", "\E1나 이 번호 알아!!!/");
ds_map_add(global.text_data_en, "obj_mainend_294", "\E0주목하라^1, 인간!/");
ds_map_add(global.text_data_en, "obj_mainend_295", "\E2나^1, 위대한&파피루스 님이.../");
ds_map_add(global.text_data_en, "obj_mainend_296", "\E0이젠 왕실 근위대의&수장이라고!/");
ds_map_add(global.text_data_en, "obj_mainend_297", "\E2바로 내가&꿈꿔왔던 거야.../");
ds_map_add(global.text_data_en, "obj_mainend_298", "\E3싸우진 않고^1,&꽃에 물이나 주는&점은^1, 빼고 말야./");
ds_map_add(global.text_data_en, "obj_mainend_299", "\E0그러니까 그 점이&아주 약간 다르지./");
ds_map_add(global.text_data_en, "obj_mainend_300", "\E0또 우리는&알피스 박사의&연구를 도와준다고!/");
ds_map_add(global.text_data_en, "obj_mainend_301", "\E0우릴 여기서&꺼내 줄 방법을&찾아낼 거야!/");
ds_map_add(global.text_data_en, "obj_mainend_302", "언다인도 돕고 있고!/");
ds_map_add(global.text_data_en, "obj_mainend_303", "\E3하지만^1,&솔직히 말하면^1,&그 돕는 방식이.../");
ds_map_add(global.text_data_en, "obj_mainend_304", "\E2좀 뭐랄까.../");
ds_map_add(global.text_data_en, "obj_mainend_305", "\E3꼭 폭발이 나./");
ds_map_add(global.text_data_en, "obj_mainend_306", "\E0그렇지만 내 생각엔&알피스가 걜 곁에 두기를&좋아하는 것 같아./");
ds_map_add(global.text_data_en, "obj_mainend_307", "\E5아이고!!!/%%");
ds_map_add(global.text_data_en, "obj_mainend_311", "\E0야!!^1! 인간!!!/");
ds_map_add(global.text_data_en, "obj_mainend_312", "요즘 어떠냐^1?&나는 잘 지낸다!!!/");
ds_map_add(global.text_data_en, "obj_mainend_313", "\E3음, 하나 빼고.../");
ds_map_add(global.text_data_en, "obj_mainend_314", "\E3여왕이 왕실 근위대를&해산시켰어./");
ds_map_add(global.text_data_en, "obj_mainend_315", "우리가 인간과&싸울 필요가 없어서&그렇대./");
ds_map_add(global.text_data_en, "obj_mainend_316", "\E0와!!!/");
ds_map_add(global.text_data_en, "obj_mainend_317", "\E3이제 내 인생&뭐 하고 살아야&하나 몰라./");
ds_map_add(global.text_data_en, "obj_mainend_318", "\E0그래도^1, 괜찮아!/");
ds_map_add(global.text_data_en, "obj_mainend_319", "나는 아직 열심히&일하고 있으니까!/");
ds_map_add(global.text_data_en, "obj_mainend_320", "\E4이게 아무 의미도&없는 짓일지라도!/");
ds_map_add(global.text_data_en, "obj_mainend_321", "\E0그러니 너무&안타까워하지 마!/");
ds_map_add(global.text_data_en, "obj_mainend_322", "파피루스는 괜찮아!/");
ds_map_add(global.text_data_en, "obj_mainend_323", "\E5지금 나쁜 건&언다인이지!/");
ds_map_add(global.text_data_en, "obj_mainend_324", "\E3걘 직장을 잃었어.../");
ds_map_add(global.text_data_en, "obj_mainend_325", "그리고 집도 잃고.../");
ds_map_add(global.text_data_en, "obj_mainend_326", "\E2슬픈 일이었지..^1.&하지만 우리가 걜&돌봐주고 있어!/");
ds_map_add(global.text_data_en, "obj_mainend_327", "\E0걘 이제 우리&소파에서 살아./");
ds_map_add(global.text_data_en, "obj_mainend_328", "매일 밤&밤샘 파티하는 것&같다니깐!/");
ds_map_add(global.text_data_en, "obj_mainend_329", "벗어날 길이&없는 밤샘 파티./");
ds_map_add(global.text_data_en, "obj_mainend_330", "아^1, 그리고 우리가&직업도 줬어^1. 응./");
ds_map_add(global.text_data_en, "obj_mainend_331", "\E3샌즈 형이 걜&불법 핫도그 노점에&고용했어./");
ds_map_add(global.text_data_en, "obj_mainend_332", "\E5거기서 일하는 건&싫어하던데!/");
ds_map_add(global.text_data_en, "obj_mainend_333", "\E3그래도 계속 그&기분 나쁜 핫도그를&만들어./");
ds_map_add(global.text_data_en, "obj_mainend_334", "\E3.../");
ds_map_add(global.text_data_en, "obj_mainend_335", "\E5아 맞다./");
ds_map_add(global.text_data_en, "obj_mainend_338", "이걸 어떻게 말해줘야&할지 모르겠지만..^1./");
ds_map_add(global.text_data_en, "obj_mainend_339", "\E3걘^1, 음^1, 지금&널 정말 싫어해./");
ds_map_add(global.text_data_en, "obj_mainend_340", "\E6생각보다 훨씬 더 심해./");
ds_map_add(global.text_data_en, "obj_mainend_341", "그게 네가 언다인이랑&친구가 되고^1, 그 뒤에.../");
ds_map_add(global.text_data_en, "obj_mainend_342", "\E5누군가를 죽였다고&하던데?/");
ds_map_add(global.text_data_en, "obj_mainend_343", "\E3알아^1, 정말 말도&안 되는 소리야.&그치?/");
ds_map_add(global.text_data_en, "obj_mainend_344", "\E6하지만 아주 상처받았고&배신당한 기분이래./");
ds_map_add(global.text_data_en, "obj_mainend_345", "자신에게도 화가&났다더라고^1. 음./");
ds_map_add(global.text_data_en, "obj_mainend_346", "걔는.../");
ds_map_add(global.text_data_en, "obj_mainend_347", "도저히 이해가&가질 않는대./");
ds_map_add(global.text_data_en, "obj_mainend_348", "모든 걸 다 걸고&너랑 친구가 되었는데./");
ds_map_add(global.text_data_en, "obj_mainend_349", "인간이 어떠한지는&알고 있었지만.../");
ds_map_add(global.text_data_en, "obj_mainend_350", "\E3그렇지만 결국&어쩔 수 없었다고 했어./");
ds_map_add(global.text_data_en, "obj_mainend_351", "\E6많은 사람들이&자신의 실수로&상처받았다고 해./");
ds_map_add(global.text_data_en, "obj_mainend_352", "\E5정말로 뭐라&말 할 수가 없어./");
ds_map_add(global.text_data_en, "obj_mainend_353", "걔가 널 얼마나&싫어하는지를 말야./");
ds_map_add(global.text_data_en, "obj_mainend_354", "\E6이런말 하는 게&너무 가슴아프지만^1,&하지만.../");
ds_map_add(global.text_data_en, "obj_mainend_355", "다시 이곳으로&오지 않는 게&좋을 것 같아./");
ds_map_add(global.text_data_en, "obj_mainend_356", "\E3다시 돌아 온다면^1,&언다인은 분명 널&박살낼거야./");
ds_map_add(global.text_data_en, "obj_mainend_357", "\E5여왕님조차도&막을 수 없다고./");
ds_map_add(global.text_data_en, "obj_mainend_358", "\E6그러니까^1, 어..^1.&안녕. 영원히./");
ds_map_add(global.text_data_en, "obj_mainend_359", "네가 그리울 거야^1,&친구야./%%");
ds_map_add(global.text_data_en, "obj_mainend_364", "\E5그리고 네가&아스고어를 사라지게&만들었다고?/");
ds_map_add(global.text_data_en, "obj_mainend_365", "\E3또 알피스도&사라지게 만들었고./");
ds_map_add(global.text_data_en, "obj_mainend_366", "\E6언다인은 그다지&행복해 보이지 않아./");
ds_map_add(global.text_data_en, "obj_mainend_367", "걔는 이런 말만&하는 중이야.../");
ds_map_add(global.text_data_en, "obj_mainend_368", "내가 지켜주지 못했어.../");
ds_map_add(global.text_data_en, "obj_mainend_369", "얘 지금 아무것도 할&의욕이 없는 것 같아./");
ds_map_add(global.text_data_en, "obj_mainend_370", "\E5심지어 내가&너한테 복수하자고&제안했다니깐./");
ds_map_add(global.text_data_en, "obj_mainend_371", "\E0그럼^1, 널 다시&볼 수 있을 테니까./");
ds_map_add(global.text_data_en, "obj_mainend_372", "\E5하지만 언다인은&나를 보고선.../");
ds_map_add(global.text_data_en, "obj_mainend_373", "\E6복수로는 누구도&되돌릴 수 없다고 했어./");
ds_map_add(global.text_data_en, "obj_mainend_374", "\E3네가 한 일에 대해서&난^1, 아무것도 모르지만.../");
ds_map_add(global.text_data_en, "obj_mainend_375", "\E5친구들을 다시 돌아오게&해 줄 순 없을까?/");
ds_map_add(global.text_data_en, "obj_mainend_376", "네가 사라지게&만들었다면 말야?/");
ds_map_add(global.text_data_en, "obj_mainend_377", "\E6제발.../");
ds_map_add(global.text_data_en, "obj_mainend_378", "언다인은 요즘&잘 못 지내./");
ds_map_add(global.text_data_en, "obj_mainend_379", "안녕./%%");
ds_map_add(global.text_data_en, "obj_mainend_385", "\E3걘 아직도 널 비난해.../");
ds_map_add(global.text_data_en, "obj_mainend_386", "\E3아스고어가 사라진&일 때문에 말이야./");
ds_map_add(global.text_data_en, "obj_mainend_387", "\E3.../");
ds_map_add(global.text_data_en, "obj_mainend_388", "\E3요새 걔는.../");
ds_map_add(global.text_data_en, "obj_mainend_389", "\E5네게 복수하는 일에&대해서 말을 많이 해./");
ds_map_add(global.text_data_en, "obj_mainend_390", "지금 상당히&기가 막히는 계획을&짜고 있던데.../");
ds_map_add(global.text_data_en, "obj_mainend_391", "세계를 갈라놓은&그 결계를 넘어 널 마구&두들겨 패는 거야./");
ds_map_add(global.text_data_en, "obj_mainend_392", "\E3솔직히^1, 난&불가능할 거라고 봐./");
ds_map_add(global.text_data_en, "obj_mainend_393", "\E0하지만 그렇지 않을 거라&믿고 싶어!!!/");
ds_map_add(global.text_data_en, "obj_mainend_394", "왜냐하면 난&언다인이랑 같이&나가고 싶거든!/");
ds_map_add(global.text_data_en, "obj_mainend_395", "그리고 너를 다시&보게 될 수 있겠지!/");
ds_map_add(global.text_data_en, "obj_mainend_396", "\E3너와 싸워야만 하게 될 수&있을지라도 말이야./");
ds_map_add(global.text_data_en, "obj_mainend_397", "\E0음^1, 행운을 빌어!/");
ds_map_add(global.text_data_en, "obj_mainend_398", "그리고 자주 연락해.../");
ds_map_add(global.text_data_en, "obj_mainend_399", "그럼 우리 계획이&더 쉬워질 거야./");
ds_map_add(global.text_data_en, "obj_mainend_400", "안녕!/%%");
ds_map_add(global.text_data_en, "obj_mainend_404", "\E5그리고 알피스가&사라진 것도^1. 말야./");
ds_map_add(global.text_data_en, "obj_mainend_405", "\E3언다인은 그다지&행복하지 않아./");
ds_map_add(global.text_data_en, "obj_mainend_406", "\E6계속 그런 말을&하곤 하지.../");
ds_map_add(global.text_data_en, "obj_mainend_407", "내가 지켜주지 못했어.../");
ds_map_add(global.text_data_en, "obj_mainend_408", "얘 지금 아무것도 할&의욕이 없는 것 같아./");
ds_map_add(global.text_data_en, "obj_mainend_409", "\E5심지어 내가&너한테 복수하자고&제안했다니깐./");
ds_map_add(global.text_data_en, "obj_mainend_410", "\E0그럼^1, 널 다시&볼 수 있을 테니까./");
ds_map_add(global.text_data_en, "obj_mainend_411", "\E3걘 나를 보고선.../");
ds_map_add(global.text_data_en, "obj_mainend_412", "\E6복수로는 누구도&되돌릴 수 없다고 했어./");
ds_map_add(global.text_data_en, "obj_mainend_413", "네가 무슨 짓을 했는지는&잘 모르겠지만.../");
ds_map_add(global.text_data_en, "obj_mainend_414", "\E5친구들을 다시 돌아오게&해 줄 순 없을까?/");
ds_map_add(global.text_data_en, "obj_mainend_415", "네가 사라지게&만들었다면 말야?/");
ds_map_add(global.text_data_en, "obj_mainend_416", "\E6제발.../");
ds_map_add(global.text_data_en, "obj_mainend_417", "언다인은 요즘&잘 못 지내./");
ds_map_add(global.text_data_en, "obj_mainend_418", "안녕./%%");
ds_map_add(global.text_data_en, "obj_mainend_434", "* 야  임 마 ^1!&* 뭐 하 고  있 는  거 냐 ^1, 엉 !?/");
ds_map_add(global.text_data_en, "obj_mainend_435", "\E1* 느 아 아 아 아 !/");
ds_map_add(global.text_data_en, "obj_mainend_437", "제발 전화기는&때리지 말아줘./");
ds_map_add(global.text_data_en, "obj_mainend_439", "\E2* 이 봐 ^1!&* 여 기  대 장 이  누 구 지 ?/");
ds_map_add(global.text_data_en, "obj_mainend_441", "저요./");
ds_map_add(global.text_data_en, "obj_mainend_443", "* 아 ..^1. 그 래 ^1,&  맞 아 !/");
ds_map_add(global.text_data_en, "obj_mainend_444", "\E0* 난  왕 실  근 위 대 장&  일 을  그 만 두 었 어 ./");
ds_map_add(global.text_data_en, "obj_mainend_445", "\E4* 사 실 ^1, 우 리 가&  더  이 상  싸 울  일 이&  없 을  테 니 까 .../");
ds_map_add(global.text_data_en, "obj_mainend_446", "\E1* 왕 실  근 위 병 은&  완 전 히  해 체 되 었 어 ./");
ds_map_add(global.text_data_en, "obj_mainend_447", "\E9* 음 ^1, 뭐 ^1,&  한  명  남 아 있 긴  하 네 ./");
ds_map_add(global.text_data_en, "obj_mainend_449", "아주 실력 있는&녀석이 말이야./");
ds_map_add(global.text_data_en, "obj_mainend_451", "* 고 럼 !^1! 고 렇 고  말 고 !!^1!&* 이 리  와  봐 !!/");
ds_map_add(global.text_data_en, "obj_mainend_453", "제발 뼈다귀 친구를&때리지 말아줘./");
ds_map_add(global.text_data_en, "obj_mainend_455", "* 여 튼 ^1, 난  지 금 은&  알 피 스 의  연 구 실&  조 수 로  일 하 고  있 어 ./");
ds_map_add(global.text_data_en, "obj_mainend_456", "\E2* 우 리 는  이  쓰 레 기 장 에 서&  탈 출 할  방 법 을&  찾 아 낼  것 이 다 !!/");
ds_map_add(global.text_data_en, "obj_mainend_457", "\E9* 아 ^1, 그 렇 지 ^1. 또&  여 왕 님  새  학 교 의&  체 육 선 생  일 도  해 ./");
ds_map_add(global.text_data_en, "obj_mainend_458", "\E6* 내 가  어 린 이  7명 을&  벤 치 프 레 스 로  들  수&  있 는  거  알 고  있 었 어 ?/");
ds_map_add(global.text_data_en, "obj_mainend_459", "\E9* 대 단 하 지 ^1? 그 렇 지 ?/");
ds_map_add(global.text_data_en, "obj_mainend_460", "* .../");
ds_map_add(global.text_data_en, "obj_mainend_461", "\E0* 이 봐 ./");
ds_map_add(global.text_data_en, "obj_mainend_462", "\E4* 아 스 고 어  일 은&  정 말  유 감 이 야 ./");
ds_map_add(global.text_data_en, "obj_mainend_463", "\E4* 네 가  해 야  할  일 을&  했 을  뿐 이 야 ./");
ds_map_add(global.text_data_en, "obj_mainend_464", "* 네  잘 못 이  아 니 .../");
ds_map_add(global.text_data_en, "obj_mainend_465", "* .../");
ds_map_add(global.text_data_en, "obj_mainend_466", "\E7* 하 ^1, 빌 어 먹 을 ./");
ds_map_add(global.text_data_en, "obj_mainend_467", "* 그  덩 치 가  그 립 군 ./");
ds_map_add(global.text_data_en, "obj_mainend_469", "\E7* .../");
ds_map_add(global.text_data_en, "obj_mainend_470", "\E1* 젠 장 ^1, 언 다 인 ^1!&* 떨 쳐 버 리 라 고 !/");
ds_map_add(global.text_data_en, "obj_mainend_471", "\E4* 아 ^1, 알 피 스 가&  어 떻 게  지 내 는 지&  말 해 줘 야 겠 네 ./");
ds_map_add(global.text_data_en, "obj_mainend_472", "\E0* 글 쎄 ^1, 알 피 스 는&  평 소 처 럼  잘  지 내 ./");
ds_map_add(global.text_data_en, "obj_mainend_473", "\E4* 평 소 보 단  더&  쓸 쓸 해 보 이 는  것&  같 기 도  하 고 ./");
ds_map_add(global.text_data_en, "obj_mainend_474", "\E7* 무 언 가 에  엄 청&  시 달 리 고  있 는  것&  같 던 데 .../");
ds_map_add(global.text_data_en, "obj_mainend_475", "\E1* 하 지 만  극 복 해 낼  거 야 !/");
ds_map_add(global.text_data_en, "obj_mainend_476", "\E2* 내 가  항 상&  도 와 줄  테 니 까 !/");
ds_map_add(global.text_data_en, "obj_mainend_477", "\E9* 친 구 란  그 런  거 지 ^1,&  안  그 래 ?/");
ds_map_add(global.text_data_en, "obj_mainend_478", "\E9* .../");
ds_map_add(global.text_data_en, "obj_mainend_479", "\E0* 야 ^1, 네 가  어 디 에&  있 든  간 에 .../");
ds_map_add(global.text_data_en, "obj_mainend_480", "\E4* 여 기 보 다 는  낫 길  바 라 ./");
ds_map_add(global.text_data_en, "obj_mainend_481", "\E7* 거 기 까 지  가 기  위 해&  많 은  희 생 을  치 렀 잖 아 .../");
ds_map_add(global.text_data_en, "obj_mainend_482", "* 그 러 니 까 ^1,&  네 가  어 디 에  있 든 .../");
ds_map_add(global.text_data_en, "obj_mainend_483", "\E6* 행 복 해 야  한 다 ^1,&  알 았 어 !?/");
ds_map_add(global.text_data_en, "obj_mainend_484", "\E2* 우 리 를  봐 서 라 도  말 야 !/");
ds_map_add(global.text_data_en, "obj_mainend_485", "\E0* 우 리  고 생 이  헛 된  게&  아 니 었 단  걸  알 면&  좀  나 을  테 니 까 ./");
ds_map_add(global.text_data_en, "obj_mainend_486", "\E9* 우 린  다  네  편 이 야 ^1!&  모 두 가 ^1!&  여 왕 님 도 !/");
ds_map_add(global.text_data_en, "obj_mainend_487", "\E1* .../");
ds_map_add(global.text_data_en, "obj_mainend_488", "\E2* 저 기 ^1!&* 잠 깐 만 !/");
ds_map_add(global.text_data_en, "obj_mainend_489", "\E6* 토 리 엘 ^1!&* 토 리 엘 ^1!&* 전 화  바 꿔 드 릴 ...?/");
ds_map_add(global.text_data_en, "obj_mainend_490", "\E1* .../");
ds_map_add(global.text_data_en, "obj_mainend_491", "\E9* 헤 ^1, 바 쁘 시 다 네 ./");
ds_map_add(global.text_data_en, "obj_mainend_493", "하지만 우리가 누구랑&말하고 있었는지&알게 된다면.../");
ds_map_add(global.text_data_en, "obj_mainend_495", "* 우 린  최 소  몇  시 간 은&  핸 드 폰 을  돌 려 받 지&  못 하 겠 지 ./");
ds_map_add(global.text_data_en, "obj_mainend_497", "우린 여왕님으로부터&널 풀어줄 자비는&갖고 있으니까!!/");
ds_map_add(global.text_data_en, "obj_mainend_499", "* 언 제 든  다 시  전 화 해 ^1,&  알 겠 지 ?&* 여 왕 님 도  기 뻐 하 실  거 야 !/");
ds_map_add(global.text_data_en, "obj_mainend_501", "* 아 ^1, 이 런 ./");
ds_map_add(global.text_data_en, "obj_mainend_502", "\E0* 배 터 리 가  거 의&  다  됐 네 ./");
ds_map_add(global.text_data_en, "obj_mainend_503", "\E1* 그 래 ^1,&  짧 게  끊 긴  싫 지 만 ^1,&  음 .../");
ds_map_add(global.text_data_en, "obj_mainend_504", "\E2* 언 제  또  보 자 ^1, 알 겠 어 ^1,&  친 구 ?/");
ds_map_add(global.text_data_en, "obj_mainend_506", "지금은 일단 안녕!/");
ds_map_add(global.text_data_en, "obj_mainend_508", "* 나 중 에  보 자 구 ^1,&  꼬 맹 아 !/%%");
ds_map_add(global.text_data_en, "obj_mainend_524", "* 저 -저 기 ^1, 언 다 인 ^1,&  괜 찮 아 ...?/");
ds_map_add(global.text_data_en, "obj_mainend_526", "* 난  괜 찮 아 ^1.&* 너 도  몇  마 디  하 지  그 래 ?/");
ds_map_add(global.text_data_en, "obj_mainend_528", "* 어 ..^1. 어 ^1, 알 았 어 !/%%");
ds_map_add(global.text_data_en, "obj_mainend_541", "* 세 상 에 ^1, 완 전  츤 데 레 네 ../");
ds_map_add(global.text_data_en, "obj_mainend_542", "\E1* .../");
ds_map_add(global.text_data_en, "obj_mainend_543", "\E2* .../");
ds_map_add(global.text_data_en, "obj_mainend_544", "\E7* 음 ^1, 안 녕 .../");
ds_map_add(global.text_data_en, "obj_mainend_545", "\E4* 미 -미 안 ^1,&  난  전 화 하 는  걸&  별 로  안  좋 아 해 ./");
ds_map_add(global.text_data_en, "obj_mainend_546", "\E3* 무 슨  말 을  해 야  할 지&  잘  모 르 겠 거 든 ./");
ds_map_add(global.text_data_en, "obj_mainend_547", "\E1* .../");
ds_map_add(global.text_data_en, "obj_mainend_548", "\E7* 음 , 여 왕 님 이  이 렇 게&  귀 여 우 시 다 고&  왜  말  안  했 어 ?/");
ds_map_add(global.text_data_en, "obj_mainend_549", "\E3* 어 ^1, 그 러 니 까 ^1, 어 .../");
ds_map_add(global.text_data_en, "obj_mainend_550", "\E6* 메 타 톤 은  잘  지 내 !/");
ds_map_add(global.text_data_en, "obj_mainend_551", "* 그 리 고 ^1! 음 !/");
ds_map_add(global.text_data_en, "obj_mainend_552", "\E6* 난  우 리 가&  자 유 로 워 질  방 법 을&  찾 고  있 어 !/");
ds_map_add(global.text_data_en, "obj_mainend_553", "\E4* 하 -하 지 만  나 도&  내 가  뭘  하 고  있 는 진&  잘  몰 라 ./");
ds_map_add(global.text_data_en, "obj_mainend_554", "\E0* 그 래 도  결 국 에 는 ^1,&  알 게  되 겠 지 ./");
ds_map_add(global.text_data_en, "obj_mainend_555", "\E3* 여 왕 님 은  아 스 고 어 와 는&  많 이  달 라 .../");
ds_map_add(global.text_data_en, "obj_mainend_556", "\E7* 내 가  제 대 로  하 고  있 는 지&  정 말 로  확 인 하 시 거 든 ./");
ds_map_add(global.text_data_en, "obj_mainend_557", "\E0* 여 왕 님 이  여 길  완 전 히&  바 꿔 버 리 셨 어 !/");
ds_map_add(global.text_data_en, "obj_mainend_558", "\E2* .../");
ds_map_add(global.text_data_en, "obj_mainend_559", "\E3* 어 ^1!&* 저 기 ^1!&* 잠 깐 만  있 어 봐 !/");
ds_map_add(global.text_data_en, "obj_mainend_560", "\E0* 저 기 ^1! 토 리 엘 ^1!&* 전 화  바 꾸 실 ...?/");
ds_map_add(global.text_data_en, "obj_mainend_561", "\E1* .../");
ds_map_add(global.text_data_en, "obj_mainend_562", "\E0* 어 ^1, 바 쁘 시 다 네 ./");
ds_map_add(global.text_data_en, "obj_mainend_564", "* 음 ^1, 말 은  바 쁘 다 고&  하 시 네 ./");
ds_map_add(global.text_data_en, "obj_mainend_566", "하지만 우리가&누구랑 말하고&있었는지 아신다면.../");
ds_map_add(global.text_data_en, "obj_mainend_568", "* 우 린  최 소  몇  시 간 은&  핸 드 폰 을  돌 려 받 지&  못 하 겠 지 ./");
ds_map_add(global.text_data_en, "obj_mainend_570", "우린 여왕님으로부터&널 풀어줄 자비는&갖고 있으니까!!/");
ds_map_add(global.text_data_en, "obj_mainend_572", "* 하 -하 지 만 ^1, 하 고  싶 으 면 ^1,&  언 제 든  다 시  전 화 해 ./");
ds_map_add(global.text_data_en, "obj_mainend_574", "* 그 래 ^1!&* 여 왕 님 도  네  전 화&  받 아 서  기 뻐 하 실  거 야 !/");
ds_map_add(global.text_data_en, "obj_mainend_576", "* 아 ^1, 이 런 ./");
ds_map_add(global.text_data_en, "obj_mainend_577", "\E0* 배 터 리 가  거 의&  다  됐 네 ./");
ds_map_add(global.text_data_en, "obj_mainend_578", "\E1* 그 래 ^1,&  짧 게  끊 긴  싫 지 만 ^1,&  음 .../");
ds_map_add(global.text_data_en, "obj_mainend_579", "\E2* 언 제  또  보 자 ^1, 알 겠 어 ^1,&  친 구 ?/");
ds_map_add(global.text_data_en, "obj_mainend_581", "지금은 일단 안녕!/");
ds_map_add(global.text_data_en, "obj_mainend_583", "* 그 리 고 ^1, 또  보 자 구 !/");
ds_map_add(global.text_data_en, "obj_mainend_585", "* 자 -잘 ..^1.&* 잘  지 내 .../");
ds_map_add(global.text_data_en, "obj_mainend_586", "\E4* 야 ^1, 왜  내 가&  끊 어 야  하 는  건 데 ?/");
ds_map_add(global.text_data_en, "obj_mainend_587", "\E7* 에 헤 헤 ..^1.&* 작 별  인 사 하 긴  싫 은 데 .../");
ds_map_add(global.text_data_en, "obj_mainend_588", "\E3* 음 ^1,&  언 제  다 시  보 자 !/%%");
ds_map_add(global.text_data_en, "obj_mainend_612", "* (삑 ...)/%%");
ds_map_add(global.text_data_en, "obj_mainend_650", "* 그 래 ..^1.&* 시 간 이  꽤  지 났 네 ./");
ds_map_add(global.text_data_en, "obj_mainend_651", "\E0* 여 왕 님 은  돌 아 와 서 ^1,&  지 하  세 계 를  다 시&  다 스 리 려 고  했 지 ./");
ds_map_add(global.text_data_en, "obj_mainend_652", "* 여 왕 님 은  새  정 책 을&  펼 쳤 어 .../");
ds_map_add(global.text_data_en, "obj_mainend_653", "\E3* 이 곳 에  떨 어 지 는  모 든&  인 간 들 은  적 으 로  대 하 면&  안  된 다 는 .../");
ds_map_add(global.text_data_en, "obj_mainend_654", "\E0* 친 구 로  대 접 받 게&  될  거 야 ./");
ds_map_add(global.text_data_en, "obj_mainend_655", "\E3* .../");
ds_map_add(global.text_data_en, "obj_mainend_656", "\E1* 하 지 만  사 람 들 은&  그  정 책 을  정 말 로&  싫 어 했 지 ./");
ds_map_add(global.text_data_en, "obj_mainend_665", "\E0* 너  때 문 에 ^1, 왕 만&  사 라 진  게  아 니 라 .../");
ds_map_add(global.text_data_en, "obj_mainend_666", "\E3* 모 아  온&  인 간 들 의  영 혼 도&  사 라 져 버 렸 으 니 까 .../");
ds_map_add(global.text_data_en, "obj_mainend_667", "* 수 많 은  시 민 들 의&  목 숨 과  함 께 ./");
ds_map_add(global.text_data_en, "obj_mainend_669", "* 그 리 고  또 .../");
ds_map_add(global.text_data_en, "obj_mainend_671", "* 그 들 의  위 대 한  영 웅 ^1,&  언 다 인 의  목 숨 과  함 께 ./");
ds_map_add(global.text_data_en, "obj_mainend_673", "* 수 많 은  시 민 들 의&  목 숨 과  함 께 ./");
ds_map_add(global.text_data_en, "obj_mainend_674", "* 아 무 도  그 런  일 은&  다 시  보 고&  싶 어 하 지  않 았 어 ./");
ds_map_add(global.text_data_en, "obj_mainend_675", "\E0* 그 래 서  사 람 들 은&  여 왕 님 을  몰 아 내 려 고&  반 란 을  일 으 켰 지 ./");
ds_map_add(global.text_data_en, "obj_mainend_676", "\E2* 하 지 만 ^1, 여 왕 님 은 ^1, 음 ^1,&  그  사 실 을  알 고&  자 애 롭 게  포 기 하 셨 어 ./");
ds_map_add(global.text_data_en, "obj_mainend_677", "\E1* 그 리 고  폐 허 로&  돌 아 갔 어 ./");
ds_map_add(global.text_data_en, "obj_mainend_678", "\E0* 지 하  세 계 는  이 제&  불 안 한  무 정 부  상 태 야 ./");
ds_map_add(global.text_data_en, "obj_mainend_679", "\E0* 모 두 가  전 처 럼&  살 아  보 려 고&  노 력 하 지 만 .../");
ds_map_add(global.text_data_en, "obj_mainend_680", "\E3* 절 대  쉬 운  일 이&  아 니 지 ^1, 안  그 래 ?/");
ds_map_add(global.text_data_en, "obj_mainend_681", "* 희 망 이  박 살 났 으 니&  당 연 도  하 지 .../%%");
ds_map_add(global.text_data_en, "obj_mainend_682", "* .../%%");
ds_map_add(global.text_data_en, "obj_mainend_688", "\E1* 당 연 히 ^1, 언 다 인 이&  혁 명 을  이 끌 었 지 ./");
ds_map_add(global.text_data_en, "obj_mainend_691", "\E3* 아 스 고 어  일  때 문 에&  상 당 히  분 노 했 거 든 ./");
ds_map_add(global.text_data_en, "obj_mainend_695", "\E3* 아 스 고 어 와&  알 피 스  일  때 문 에&  상 당 히  분 노 했 거 든 ./");
ds_map_add(global.text_data_en, "obj_mainend_697", "\E1* 언 다 인 은  무 력 으 로&  여 왕 님 을  성 에 서&  몰 아 냈 어 ./");
ds_map_add(global.text_data_en, "obj_mainend_698", "\E0* 그 러 고  나 서&  지 하  세 계 의  여 제 가&  되 었 고 .../");
ds_map_add(global.text_data_en, "obj_mainend_699", "* 여 왕 님 은  폐 허 로&  다 시 ^1, 추 방 당 했 지 ./");
ds_map_add(global.text_data_en, "obj_mainend_700", "\E1* 언 다 인 은 ..^1.&* 흠 .../");
ds_map_add(global.text_data_en, "obj_mainend_701", "\E3* 아 스 고 어 보 다 도  더&  인 류 를  파 괴 하 고&  싶 어 하 는  것  같 아 ./");
ds_map_add(global.text_data_en, "obj_mainend_702", "\E1* .../%%");
ds_map_add(global.text_data_en, "obj_mainend_716", "\E2* 하 지 만  야 ^1!&* 그 렇 게 까 지&  나 쁜  건  아 냐 !/");
ds_map_add(global.text_data_en, "obj_mainend_717", "\E0* 여 왕 은  더  이 상&  외 롭 지  않 아 ./");
ds_map_add(global.text_data_en, "obj_mainend_718", "\E1* 나 랑  파 피 루 스 가&  가 끔  놀 러 가 서 .../");
ds_map_add(global.text_data_en, "obj_mainend_719", "\E0* 도 서 관 에 서  책 을&  갖 다  주 거 나 ^1,&  게 임 을  하 거 나 .../");
ds_map_add(global.text_data_en, "obj_mainend_720", "\E2* 가 끔 은  나 가 보 자 고&  설 득 하 기 도  했 어 ./");
ds_map_add(global.text_data_en, "obj_mainend_721", "\E1* 나 나  파 피 루 스 와&  인 간 을  찾 으 러&  같 이  가 자 고  말 야 ./");
ds_map_add(global.text_data_en, "obj_mainend_722", "\E2* 그 리 고  파 피 루 스 도&  그 걸  참  좋 아 하 니 까 ./");
ds_map_add(global.text_data_en, "obj_mainend_724", "맞아!!^1!&난 여왕님 편에&서는 걸 좋아해!!!/");
ds_map_add(global.text_data_en, "obj_mainend_725", "인간이 또 떨어지면&어떻게 할지&예행연습중이야./");
ds_map_add(global.text_data_en, "obj_mainend_726", "난 정말로&좋은 엄마가&될 거야!!!/");
ds_map_add(global.text_data_en, "obj_mainend_727", "\E3그건 그렇고^1,&지금 누구랑&대화하는 거야?/");
ds_map_add(global.text_data_en, "obj_mainend_729", "* 어 ^1, 아 무 도  아 냐 ./");
ds_map_add(global.text_data_en, "obj_mainend_731", "오, 좋았어^1.&내가 안부 전했다고&알려줘!!!/");
ds_map_add(global.text_data_en, "obj_mainend_733", "* 파 피 루 스 가&  안 부  전 해 달 래 ./");
ds_map_add(global.text_data_en, "obj_mainend_734", "\E0* 음 ^1, 네 가  있 는  곳 은&  좀  나 았 으 면  좋 겠 네 ./");
ds_map_add(global.text_data_en, "obj_mainend_735", "\E2* 나 중 에  봐 ./%%");
ds_map_add(global.text_data_en, "obj_mainend_740", "\E2* 하 지 만  야 ^1!&* 그 렇 게 까 지&  나 쁜  건  아 냐 !/");
ds_map_add(global.text_data_en, "obj_mainend_741", "\E1* 여 왕 님 이  폐 허 로&  돌 아 갔 을  때 .../");
ds_map_add(global.text_data_en, "obj_mainend_742", "\E2* 나 도  함 께&  가 기 로  했 어 ./");
ds_map_add(global.text_data_en, "obj_mainend_743", "\E1* 도 서 관 에 서  책 도&  좀  꺼 내 갔 지 ^1, 뭐 ./");
ds_map_add(global.text_data_en, "obj_mainend_744", "\E1* 여 왕 님 이  같 은  책 만&  계 속  읽 지  않 게&  말 이 야 ./");
ds_map_add(global.text_data_en, "obj_mainend_745", "\E0* 여 왕 님 은&  좋 은  룸 메 이 트 야 ^1.&  재 미 있 게  지 내 고  있 어 ./");
ds_map_add(global.text_data_en, "obj_mainend_746", "\E1* .../");
ds_map_add(global.text_data_en, "obj_mainend_747", "\E1* 있 잖 아 ./");
ds_map_add(global.text_data_en, "obj_mainend_748", "\E1* 여 왕 님 은  가 끔 씩 .../");
ds_map_add(global.text_data_en, "obj_mainend_749", "\E0* 네 가  다 시&  보 고  싶 다 고&  말 하 곤  해 ./");
ds_map_add(global.text_data_en, "obj_mainend_750", "\E1* 근 사 하 지  않 아 ?/");
ds_map_add(global.text_data_en, "obj_mainend_751", "\E3* .../");
ds_map_add(global.text_data_en, "obj_mainend_752", "\E3* 나 한 텐  여 왕 님 께&  네 가  한  짓 을  말 할&  용 기 가  없 지 만 ./");
ds_map_add(global.text_data_en, "obj_mainend_753", "\E0* 여 왕 님 이  어 떻 게&  반 응 할  것  같 아 ?/");
ds_map_add(global.text_data_en, "obj_mainend_754", "\E3* 여 왕 님 이  너 를&  지 켜 준  것  때 문 에 .../");
ds_map_add(global.text_data_en, "obj_mainend_755", "\E4* ...네 가  내  동 생 을&  죽 였 다 고  말 하 면 ...?/");
ds_map_add(global.text_data_en, "obj_mainend_756", "\E3* .../");
ds_map_add(global.text_data_en, "obj_mainend_757", "\E1* 어 쨌 든 ^1, 다 신&  돌 아 오 지  말 라 고 ./");
ds_map_add(global.text_data_en, "obj_mainend_758", "\E0* 넌  환 영 받 지  못 해 ./");
ds_map_add(global.text_data_en, "obj_mainend_759", "\E2* 나 중 에  봐 ./%%");
ds_map_add(global.text_data_en, "obj_mainend_784", "* 네 가  떠 난  후 로 ^1,&  이 곳 은 .../");
ds_map_add(global.text_data_en, "obj_mainend_785", "\E3* 많 이  달 라 졌 어 ./");
ds_map_add(global.text_data_en, "obj_mainend_786", "* 아 스 고 어 가  없 어 지 고 .../");
ds_map_add(global.text_data_en, "obj_mainend_787", "\E0* 언 다 인 이  지 하  세 계 의&  통 치 자 가  됐 지 ./");
ds_map_add(global.text_data_en, "obj_mainend_788", "\E3* 언 다 인 은  여 기  오 는&  모 든  인 간 을&  죽 이 기 로  했 어 ./");
ds_map_add(global.text_data_en, "obj_mainend_789", "\E3* 그 리 고  인 간 의&  영 혼 들 이  사 라 졌 으 니 .../");
ds_map_add(global.text_data_en, "obj_mainend_790", "\E0* 결 계 를  부 수 고&  나 갈  다 른  방 법 도&  찾 고  있 어 .../");
ds_map_add(global.text_data_en, "obj_mainend_791", "* 결 계 를  부 수 면 ^1,&  그  다 음 엔  인 류 에 게&  전 쟁 을  선 포 할  거 야 ./");
ds_map_add(global.text_data_en, "obj_mainend_792", "\E1* 그 게 ^1, 아 스 고 어 의&  계 획 이 기 도  했 지 만 ^1,&뭐 ./");
ds_map_add(global.text_data_en, "obj_mainend_793", "\E2* 아 스 고 어 는 ^1,&  어 ^1, 일  한 번  되 게&  못 했 잖 아 ./");
ds_map_add(global.text_data_en, "obj_mainend_794", "\E0* 언 다 인 은  왕 실&  근 위 대 의  규 모 도&  크 게  확 대 시 켰 어 ./");
ds_map_add(global.text_data_en, "obj_mainend_795", "* 여 기 서&  나 가 기 만  하 면&  제 일  먼 저  할  일 이 .../");
ds_map_add(global.text_data_en, "obj_mainend_796", "* 자 기  군 대 를&  이 끌 고  가 서 .../");
ds_map_add(global.text_data_en, "obj_mainend_797", "\E3* 널  직 접  만 나&  죽 여 버 리 는&  거 라 더 라 고 ./");
ds_map_add(global.text_data_en, "obj_mainend_801", "\E1* 한 편  나 는  말 야 .../");
ds_map_add(global.text_data_en, "obj_mainend_802", "* 요 새  폐 허 로  통 하 는&  문 에  노 크 하 고&  있 었 어 .../");
ds_map_add(global.text_data_en, "obj_mainend_803", "\E3* 하 지 만  내  노 크 에&  답 해 주 던  여 자 는&  어 째  답 이  없 네 ./");
ds_map_add(global.text_data_en, "obj_mainend_804", "\E1* 몸 이  안  좋 은  걸 까 ?/");
ds_map_add(global.text_data_en, "obj_mainend_805", "\E3* 헤 ./");
ds_map_add(global.text_data_en, "obj_mainend_806", "\E4* 아 니 면  아 예&  아 무 것 도  못  느 끼 는&  걸 지 도 ...?/");
ds_map_add(global.text_data_en, "obj_mainend_807", "\E4* 조 심 해 야  할  거 야 ^1,&  꼬 맹 이 ./");
ds_map_add(global.text_data_en, "obj_mainend_808", "\E4* 너 한 테  엄 청  불 리 하 게&  돌 아 가 고  있 는  것&  같 거 든 ./%%");
ds_map_add(global.text_data_en, "obj_mainend_813", "\E1* 한 편  나 는  말 야 .../");
ds_map_add(global.text_data_en, "obj_mainend_814", "\E3* 요 새  폐 허 로  통 하 는&  문 에  노 크 하 고&  있 었 어 .../");
ds_map_add(global.text_data_en, "obj_mainend_815", "\E3* 하 지 만  내  노 크 에&  답 해 주 던  여 자 는 .../");
ds_map_add(global.text_data_en, "obj_mainend_816", "\E1* 몸 이  안  좋 은  걸 까 ?/");
ds_map_add(global.text_data_en, "obj_mainend_818", "이봐^1, 샌즈 형^1,&누구한테&얘기하는 거야?/");
ds_map_add(global.text_data_en, "obj_mainend_820", "* 아 ^1, 그 냥  인 간 ./");
ds_map_add(global.text_data_en, "obj_mainend_822", "아^1, 그래./");
ds_map_add(global.text_data_en, "obj_mainend_823", "\E3.../");
ds_map_add(global.text_data_en, "obj_mainend_824", "\E5잠깐, 인간이라고!?/");
ds_map_add(global.text_data_en, "obj_mainend_825", "\E0나도 얘기해도 돼???/");
ds_map_add(global.text_data_en, "obj_mainend_827", "* 그 래 ^1, 잘  해 봐 ./");
ds_map_add(global.text_data_en, "obj_mainend_829", "야!!^1!&이제 언다인이&여제가 됐어!!/");
ds_map_add(global.text_data_en, "obj_mainend_830", "근사하지!!!/");
ds_map_add(global.text_data_en, "obj_mainend_831", "그리고 나한테.../");
ds_map_add(global.text_data_en, "obj_mainend_832", "왕실 근위대에서&제일 중한 직책'을&준다고 약속했어!!!/");
ds_map_add(global.text_data_en, "obj_mainend_833", "\E3.../");
ds_map_add(global.text_data_en, "obj_mainend_834", "\E3그게 끝이야^1.&그게 그 직책 이름이야./");
ds_map_add(global.text_data_en, "obj_mainend_835", "\E0뭘 하냐고?/");
ds_map_add(global.text_data_en, "obj_mainend_836", "\E3언다인은 나한테^1,&음.../");
ds_map_add(global.text_data_en, "obj_mainend_837", "\E3그냥 귀엽게 서 있으래./");
ds_map_add(global.text_data_en, "obj_mainend_838", "\E0참!!^1!&나한테 딱&어울리는 직책이지!!!/");
ds_map_add(global.text_data_en, "obj_mainend_839", "노력 없이도 계속^1,&할 수 있는 거니까!!/");
ds_map_add(global.text_data_en, "obj_mainend_840", "드디어!^1!&나도 중요한 녀석이라고./");
ds_map_add(global.text_data_en, "obj_mainend_841", "이게 다 네 덕이야./");
ds_map_add(global.text_data_en, "obj_mainend_842", "그리고 네가 한&끔찍한 짓 덕분이야./");
ds_map_add(global.text_data_en, "obj_mainend_843", "고마워^1, 인간!/");
ds_map_add(global.text_data_en, "obj_mainend_844", "언제 한번&돌아오라고!!/");
ds_map_add(global.text_data_en, "obj_mainend_845", "\E3잠깐..^1.&언다인이 널&죽일지도 몰라./");
ds_map_add(global.text_data_en, "obj_mainend_846", "\E0하지만..^1.&날 볼 수 있겠지./");
ds_map_add(global.text_data_en, "obj_mainend_847", "위험은 감수해야지!/");
ds_map_add(global.text_data_en, "obj_mainend_848", "정말로!/");
ds_map_add(global.text_data_en, "obj_mainend_849", "다시 보자./%%");
ds_map_add(global.text_data_en, "obj_mainend_875", "* 그 래 ^1, 시 간 이  꽤&  흘 렀 지 ./");
ds_map_add(global.text_data_en, "obj_mainend_876", "\E1* 네 가  떠 난  후 로 ^1,&  이 곳 은 ..^1.&* 흥 미 로 워 졌 어 ./");
ds_map_add(global.text_data_en, "obj_mainend_877", "\E0* 아 스 고 어 가  사 라 지 고 ^1,&  사 람 들 은  언 다 인 이&  통 치 하 길  바 랬 지 만 .../");
ds_map_add(global.text_data_en, "obj_mainend_878", "\E3* 언 다 인 은   어 디 서 도&  찾 아 볼  수  없 었 어 ./");
ds_map_add(global.text_data_en, "obj_mainend_879", "\E2* 그 래 서  메 타 톤 이 ..^1.&  이 어 받 은  것  같 네 ?/");
ds_map_add(global.text_data_en, "obj_mainend_880", "\E1* 메 타 톤 은  멍 청 한  자 기&  TV 쇼 로  사 람 들 을&  세 뇌 시 키 고  있 어 ./");
ds_map_add(global.text_data_en, "obj_mainend_881", "* 그 리 고  지 하  세 계 를&  자 신 만 의  낙 원 으 로&  만 들 어 버 렸 지 ./");
ds_map_add(global.text_data_en, "obj_mainend_882", "\E3* 솔 직 히 ..^1.&  좀  짜 증 나 ./");
ds_map_add(global.text_data_en, "obj_mainend_883", "\E1* 나 ^1?&* 음 ^1, 그 래 .../");
ds_map_add(global.text_data_en, "obj_mainend_884", "\E2* 난  그 의  매 니 저 야 ./%%");
ds_map_add(global.text_data_en, "obj_mainend_896", "\E0* 안 녕 ^1! 달 링 !/");
ds_map_add(global.text_data_en, "obj_mainend_897", "* 노 력 해 줘 서&  정 말  고 맙 군 요 .../");
ds_map_add(global.text_data_en, "obj_mainend_898", "* 당 신  덕 분 에 , 지 하 는&  그  언 제 보 다 도  신 나 는&  곳 이  됐 습 니 다 !/");
ds_map_add(global.text_data_en, "obj_mainend_899", "\E7* 울 랄 라 ...&* 조 각 상 들 ...&  내  미 모 의  기 념 비 .../");
ds_map_add(global.text_data_en, "obj_mainend_900", "\E6* 내  이 름  모 양 대 로&  심 어 진  꽃 들 .../");
ds_map_add(global.text_data_en, "obj_mainend_901", "\E5* 나 의  웃 는  모 양 으 로&  된  울 타 리 들 .../");
ds_map_add(global.text_data_en, "obj_mainend_902", "\E8* 내  통 치  하 에 ,&  지 하 의  문 제 들 은&  모 두  처 리 됐 습 니 다 !/");
ds_map_add(global.text_data_en, "obj_mainend_903", "\E7* 빽 빽 함 ?&* 따 분 함 ???/");
ds_map_add(global.text_data_en, "obj_mainend_904", "\E9* 스 포 트 라 이 트 가  있 는 데&  햇 빛 이  왜  필 요 한 가 요 !!?/");
ds_map_add(global.text_data_en, "obj_mainend_905", "\E1* 경 제 붕 괴 ?&* 교 육 문 제 ?&* 뭐 라 고 요 !?/");
ds_map_add(global.text_data_en, "obj_mainend_906", "\E8* 전 부  반 짝 이 에&  뒤 덮 였 는 걸 요 !/");
ds_map_add(global.text_data_en, "obj_mainend_907", "\E6* 아 무  문 제 도  없 어 요 ,&  영 롱 하 지 요 !/");
ds_map_add(global.text_data_en, "obj_mainend_908", "\E0* 그 리 고 ,&  나 는  인 류 에  대 한&  새  정 책 을  세 웠 습 니 다 ./");
ds_map_add(global.text_data_en, "obj_mainend_909", "\E1* 인 간 이  이 곳 에&  떨 어 지 면 .../");
ds_map_add(global.text_data_en, "obj_mainend_910", "\E6* 내  팬 클 럽 에  공 짜 로&  가 입 할  수  있 어 요 !/");
ds_map_add(global.text_data_en, "obj_mainend_911", "\E1* 아 , 알 피 스 에  대 해 서&  궁 금 하 시 겠 군 요 ./");
ds_map_add(global.text_data_en, "obj_mainend_912", "\E0* 걱 정 마 시 라 !/");
ds_map_add(global.text_data_en, "obj_mainend_913", "\E9* 그 녀 의  동 상 도&  세 워  뒀 으 니 !/");
ds_map_add(global.text_data_en, "obj_mainend_914", "\E1* .../");
ds_map_add(global.text_data_en, "obj_mainend_915", "\E3* 근 데  사 실 . 내 가 .../");
ds_map_add(global.text_data_en, "obj_mainend_916", "\E4* 알 피 스 한 테&  잘  못 해 줬 단  걸&  깨 달 았 어 요 ./");
ds_map_add(global.text_data_en, "obj_mainend_917", "\E1* 그 래 서  사 과 하 러&  갔 지 요 ./");
ds_map_add(global.text_data_en, "obj_mainend_918", "\E9* 그 리 고 , 내 가&  통 치 하 는  것 도&  좀  도 와 달 라 고 ./");
ds_map_add(global.text_data_en, "obj_mainend_919", "\E1* .../");
ds_map_add(global.text_data_en, "obj_mainend_920", "\E3* 하 지 만  찾 을  수&  없 었 어 요 ./");
ds_map_add(global.text_data_en, "obj_mainend_921", "\E4* 진 짜 예 요 .&* 찾 아 봤 다 고 요 ./");
ds_map_add(global.text_data_en, "obj_mainend_922", "\E3* .../");
ds_map_add(global.text_data_en, "obj_mainend_923", "\E1* 어 쨌 든 ./");
ds_map_add(global.text_data_en, "obj_mainend_924", "\E2* 날  만 나 고  난&  이 후 의  생 이 .../");
ds_map_add(global.text_data_en, "obj_mainend_925", "\E7* 살  만 한  가 치 가&  있 기 를  바 라 요 ./");
ds_map_add(global.text_data_en, "obj_mainend_926", "\E6* 힘 들 겠 지 만  말 이 죠 ./");
ds_map_add(global.text_data_en, "obj_mainend_927", "\E0* 부 디 , 항 상&  절  생 각 해 줘 요 ./");
ds_map_add(global.text_data_en, "obj_mainend_928", "\E5* 계 속 해 서&* 아 름 답 게  포 즈 를&  취 하 는  절  말 입 니 다 .../");
ds_map_add(global.text_data_en, "obj_mainend_929", "\E6* 오 예 에 에 에 쓰 !!!/");
ds_map_add(global.text_data_en, "obj_mainend_933", "\E6* 오 예 에 에 에 쓰 !!!/%%");
ds_map_add(global.text_data_en, "obj_mainend_937", "\E2* 오 ^1, 다 른  매 니 저 가&  말 하 고  싶 어 하 나&  보 군 요 ./");
ds_map_add(global.text_data_en, "obj_mainend_939", "야!!^1!&나다^1, 파피루스!/");
ds_map_add(global.text_data_en, "obj_mainend_940", "\E2내가 멋진 안경이랑&정장을 입고 있는&모습을 상상해보라고./");
ds_map_add(global.text_data_en, "obj_mainend_941", "\E0그리고 샌즈형이&선글라스 끼고&문지기를 하는 모습도./");
ds_map_add(global.text_data_en, "obj_mainend_942", "그게 우리 일상이야..^1.&정말 멋있지 않냐!!!/");
ds_map_add(global.text_data_en, "obj_mainend_943", "네가 여기 온 이후&모든 게 훨씬&좋아졌어!!!/");
ds_map_add(global.text_data_en, "obj_mainend_944", "\E3음^1, 메타톤을&좋아하지 않는&사람들에게는.../");
ds_map_add(global.text_data_en, "obj_mainend_945", "\E5모든 것이&엿같다는 사실만&빼면 말이야.../");
ds_map_add(global.text_data_en, "obj_mainend_946", "\E3그리고 내 친구&언다인이 사라졌다는&사실도./");
ds_map_add(global.text_data_en, "obj_mainend_947", "어디 간 건지&아무도 몰라./");
ds_map_add(global.text_data_en, "obj_mainend_948", "언다인은 메타톤을&단 한번도&좋아한 적이 없거든./");
ds_map_add(global.text_data_en, "obj_mainend_949", "\E3절대로.../");
ds_map_add(global.text_data_en, "obj_mainend_950", "\E5사라지거나 할&애가 아닌데./");
ds_map_add(global.text_data_en, "obj_mainend_951", "\E6가끔은 언다인이&너무 그리워./");
ds_map_add(global.text_data_en, "obj_mainend_952", "\E0만약 본다면^1,&안부 좀 전해줄 수&있겠어?/");
ds_map_add(global.text_data_en, "obj_mainend_953", "고마워^1!&나중에 보자고!/%%");
ds_map_add(global.text_data_en, "obj_mainend_984", "\E3* 그 래 ..^1.&* 오 래 간 만 이 네 ./");
ds_map_add(global.text_data_en, "obj_mainend_985", "* 네 가  떠 난  이 후 로 .../");
ds_map_add(global.text_data_en, "obj_mainend_986", "\E1* 이 곳 은  정 말&  이 상 해 졌 어 ./");
ds_map_add(global.text_data_en, "obj_mainend_987", "\E0* 한 밤 중 에 ^1, 수 십 명 의&  사 람 들 이  돌 연&  실 종 되 었 어 ./");
ds_map_add(global.text_data_en, "obj_mainend_988", "\E3* 인 간  영 혼 들 도&  사 라 졌 고 ./");
ds_map_add(global.text_data_en, "obj_mainend_989", "\E3* 사 람 들 의  마 음 은&  무 너 져 내 렸 어 .&  모 두 가  바 라 던 .../");
ds_map_add(global.text_data_en, "obj_mainend_990", "* 모 두 가  의 지 하 던&  모 든  것 이 ^1, 하 룻 밤  새&  사 라 진  거 야 ./");
ds_map_add(global.text_data_en, "obj_mainend_991", "* 급 히  새  왕 을&  뽑 으 려 고  모 두 가&  혈 안 이  되 었 지 ./");
ds_map_add(global.text_data_en, "obj_mainend_992", "\E1* 그 래 서 ^1, 어 ..^1.&* 선 출 과 정 에 서 .../");
ds_map_add(global.text_data_en, "obj_mainend_993", "\E2* 파 피 루 스 가&  왕 이  되 었 다 고 ?/");
ds_map_add(global.text_data_en, "obj_mainend_994", "\E1* 왜  너 한 테  이  사 실 을&  말 하 지  않 은  거 지 .../");
ds_map_add(global.text_data_en, "obj_mainend_996", "\E0안뇽!!^1! 인간!!!/");
ds_map_add(global.text_data_en, "obj_mainend_997", "\E3이상하네./");
ds_map_add(global.text_data_en, "obj_mainend_998", "\E3아스고어^1, 알피스^1,&메타톤^1, 그리고&언다인이 사라졌어./");
ds_map_add(global.text_data_en, "obj_mainend_999", "\E0샌즈 형이 말하기를&전부 휴가 떠났대./");
ds_map_add(global.text_data_en, "obj_mainend_1000", "즐거운 시간 보내고&있으면 좋겠네!!!/");
ds_map_add(global.text_data_en, "obj_mainend_1001", "\E3아 그래./");
ds_map_add(global.text_data_en, "obj_mainend_1002", "\E0이제 내가&지하 세계의 왕이야!!!/");
ds_map_add(global.text_data_en, "obj_mainend_1003", "모든 게 전보다&많이 발전했어./");
ds_map_add(global.text_data_en, "obj_mainend_1004", "생산성이 늘었지!/");
ds_map_add(global.text_data_en, "obj_mainend_1005", "왜냐하면 내가&모두에게 열심히&일하라고 하거든./");
ds_map_add(global.text_data_en, "obj_mainend_1006", "그리고^1, 아무도&굶주리지 않아!!!/");
ds_map_add(global.text_data_en, "obj_mainend_1007", "왜냐하면 내가&모두에게 스파게티를&만들어 주거든./");
ds_map_add(global.text_data_en, "obj_mainend_1008", "\E3그러는 동안^1,&내 형은 문서작업을 해./");
ds_map_add(global.text_data_en, "obj_mainend_1009", "\E3이상하지..^1.&형이 일을 열심히&하고 있다니 말야?/");
ds_map_add(global.text_data_en, "obj_mainend_1010", "\E3이상하게 들릴지&모르겠지만..^1. 그래도.../");
ds_map_add(global.text_data_en, "obj_mainend_1011", "\E5샌즈 형이..^1.&자랑스러...워???/");
ds_map_add(global.text_data_en, "obj_mainend_1012", "오, 안 돼!!!/");
ds_map_add(global.text_data_en, "obj_mainend_1013", "\E0우리세계의 인간에 대한&법률에 따르면.../");
ds_map_add(global.text_data_en, "obj_mainend_1014", "\E3우리는....^1, 어./");
ds_map_add(global.text_data_en, "obj_mainend_1015", "샌즈 형^1, 그게 뭐였지?/");
ds_map_add(global.text_data_en, "obj_mainend_1017", "\E2* 우 린  인 간 이  무 조 건&  착 하 거 나  나 쁘 다 고&  판 단 할  수  없 다 ./");
ds_map_add(global.text_data_en, "obj_mainend_1019", "\E0그래 맞아^1!&그러니까 상황에 따라&다르다는 거지!/");
ds_map_add(global.text_data_en, "obj_mainend_1020", "인간이 나쁘다면..^1.&우리는 그 녀석에게&퍼즐을 줄 거야!/");
ds_map_add(global.text_data_en, "obj_mainend_1021", "인간이 착하다면..^1.&그래도 우리는 녀석에게&퍼즐을 줄 거다!/");
ds_map_add(global.text_data_en, "obj_mainend_1022", "정말 최고의 방법이지!/");
ds_map_add(global.text_data_en, "obj_mainend_1023", "\E0.../");
ds_map_add(global.text_data_en, "obj_mainend_1024", "\E3.../");
ds_map_add(global.text_data_en, "obj_mainend_1025", "...샌즈 형은 갔나?/");
ds_map_add(global.text_data_en, "obj_mainend_1026", "\E6너도 알다시피.../");
ds_map_add(global.text_data_en, "obj_mainend_1027", "형한테는 말하지 마,&그게.../");
ds_map_add(global.text_data_en, "obj_mainend_1028", "우린 많은 발전을&이뤄냈지만.../");
ds_map_add(global.text_data_en, "obj_mainend_1029", "가끔은 이 일이&힘들 때가 있어./");
ds_map_add(global.text_data_en, "obj_mainend_1030", "왕이 떠난 이후로.../");
ds_map_add(global.text_data_en, "obj_mainend_1031", "많은 사람들은 그냥&포기하려고 해./");
ds_map_add(global.text_data_en, "obj_mainend_1032", "가끔은, 나의&최선을 다한 격려도.../");
ds_map_add(global.text_data_en, "obj_mainend_1033", "통하지를 않아./");
ds_map_add(global.text_data_en, "obj_mainend_1034", "그리고^1, 또^1, 있지^1,&나 언다인이 그리워./");
ds_map_add(global.text_data_en, "obj_mainend_1035", "전화를 했는데&받은 적이 한 번도 없어./");
ds_map_add(global.text_data_en, "obj_mainend_1036", "\E5휴가를 떠나서&엄청 즐기고 있겠지./");
ds_map_add(global.text_data_en, "obj_mainend_1037", "\E6엽서 한 장이라도&보냈으면 좋겠네./");
ds_map_add(global.text_data_en, "obj_mainend_1038", ".../");
ds_map_add(global.text_data_en, "obj_mainend_1039", "\E5근데 이봐!!!/");
ds_map_add(global.text_data_en, "obj_mainend_1040", "\E4나 포기 안 해!/");
ds_map_add(global.text_data_en, "obj_mainend_1041", "포기할 수 없어!/");
ds_map_add(global.text_data_en, "obj_mainend_1042", "모두가 포기하려는 걸&포기하게 해야 돼!/");
ds_map_add(global.text_data_en, "obj_mainend_1043", "\E0우린 여기서&나갈 거라고^1,&언젠간!!!/");
ds_map_add(global.text_data_en, "obj_mainend_1044", "그러면 우리끼리&다시 놀 수 있겠지!!!/");
ds_map_add(global.text_data_en, "obj_mainend_1045", "녜 헤 헤!!!/%%");
ds_map_add(global.text_data_en, "obj_mainend_1055", "\E3* 오 랜 만 이 네 ^1,&  안  그 래 ?/");
ds_map_add(global.text_data_en, "obj_mainend_1056", "* .../");
ds_map_add(global.text_data_en, "obj_mainend_1057", "* 여 긴  상 황 이&  꽤 나  심 각 해 졌 다 ./");
ds_map_add(global.text_data_en, "obj_mainend_1058", "\E0* 모 두 들  밤  사 이 에&  사 라 진  왕 을&  생 각 하 고  있 어 ./");
ds_map_add(global.text_data_en, "obj_mainend_1059", "\E1* 너 무  조 용 해 졌 어 ./");
ds_map_add(global.text_data_en, "obj_mainend_1060", "\E3* 모 두 에 게  좋 지  않 은&  조 짐 이  느 껴 져 ./");
ds_map_add(global.text_data_en, "obj_mainend_1061", "* 어 둠  속 에  갇 힌  채&  모 두  여 기 서  죽 으 려 고&  하 는  것  같 네 ./");
ds_map_add(global.text_data_en, "obj_mainend_1062", "\E2* ...왜  내 가  왕 이&  안  됐 는 지  궁 금 하 겠 지 ./");
ds_map_add(global.text_data_en, "obj_mainend_1063", "\E1* 난  말 야 ./");
ds_map_add(global.text_data_en, "obj_mainend_1064", "\E1* 그 렇 게  똑 부 러 진&  사 람 이  아 니 라 서 ./");
ds_map_add(global.text_data_en, "obj_mainend_1065", "\E2* 그 냥  만 사  유 하 게&  흘 러 갔 으 면 ^1, 하 고&  바 라 는  타 입 이 거 든 ./");
ds_map_add(global.text_data_en, "obj_mainend_1066", "\E2* .../");
ds_map_add(global.text_data_en, "obj_mainend_1067", "\E3* ... 농 담 이 야 ./");
ds_map_add(global.text_data_en, "obj_mainend_1068", "\E3* 나 같 은  사 람 이&  유 하 게  행 동 하 니&  이 런  일 이  생 기 지 ./");
ds_map_add(global.text_data_en, "obj_mainend_1069", "* .../");
ds_map_add(global.text_data_en, "obj_mainend_1070", "\E4* 또  보 자 ./%%");
ds_map_add(global.text_data_en, "obj_mainend_1074", "\E0* 이 봐 ^1, 적 어 도  여 기&  붐 비 지 는  않 아 ./");
ds_map_add(global.text_data_en, "obj_mainend_1075", "\E1* 네 가  죽 이 고  간&  모 든  사 람 들  때 문 이 지 ./");
ds_map_add(global.text_data_en, "obj_mainend_1076", "\E2* 너 한 테&  좋 은  경 험 이 었 기 를&  바 라 ./");
ds_map_add(global.text_data_en, "obj_mainend_1077", "\E3* .../");
ds_map_add(global.text_data_en, "obj_mainend_1078", "\E2* 농 담 이 야 ^1.&* 전 혀  바 라 지  않 아 ./");
ds_map_add(global.text_data_en, "obj_mainend_1079", "\E4* 지 옥 에 나  떨 어 져 ./%%");
ds_map_add(global.text_data_en, "obj_mainend_1092", "\E3* 오 랜 만 이 네 ^1,&  안  그 래 ?/");
ds_map_add(global.text_data_en, "obj_mainend_1093", "* .../");
ds_map_add(global.text_data_en, "obj_mainend_1094", "\E1* 많 은  중 요 한  사 람 들 이&  하 룻 밤  사 이 에&  사 라 진  것  같 네 ./");
ds_map_add(global.text_data_en, "obj_mainend_1095", "* 하 지 만  다 친  사 람 은&  아 무 도  없 어 ./");
ds_map_add(global.text_data_en, "obj_mainend_1096", "\E0* 사 람 들 은  혼 란 에  빠 졌 지 ^1.&* 완 전 한  무 아 지 경 이 었 어 ./");
