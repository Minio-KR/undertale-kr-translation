ds_map_add(global.text_data_en, "obj_readable_room1_518", "* (꺼 진  것  같 다 .)/%%");
ds_map_add(global.text_data_en, "obj_readable_room1_523", "* 실 험  기 록  제 4번 /");
ds_map_add(global.text_data_en, "obj_readable_room1_524", "* 인 간 의  영 혼 에  대 한&  정 보 를  얻 기  위 해 , &  인 간 에  대 해  조 사  중 이 다 ./");
ds_map_add(global.text_data_en, "obj_readable_room1_525", "* 성  근 처 를  탐 색 하 는  데 에&  그 쳤 다 ... 이 상 한  테 이 프 를&  발 견 했 다 ./");
ds_map_add(global.text_data_en, "obj_readable_room1_526", "* 아 스 고 어 가  본  것&  같 지 는  않 다 .../");
ds_map_add(global.text_data_en, "obj_readable_room1_527", "* 그 가  보 면  안 될  것  같 다 ./%%");
ds_map_add(global.text_data_en, "obj_readable_room1_528", "* (꺼 진  것  같 다 .)/%%");
ds_map_add(global.text_data_en, "obj_readable_room1_538", "* 실 험  기 록  제 19번 /");
ds_map_add(global.text_data_en, "obj_readable_room1_539", "* 유 족 들 이  자 기  가 족 이&  언 제  돌 아 오 냐 고&  묻 고  있 다 ./");
ds_map_add(global.text_data_en, "obj_readable_room1_540", "* 뭐 라 고  대 답 해 야  하 지 ?/");
ds_map_add(global.text_data_en, "obj_readable_room1_541", "* 난  이 제  전 화 도&  받 지  않 는 다 ./%%");
ds_map_add(global.text_data_en, "obj_readable_room1_542", "* (꺼 진  것  같 다 .)/%%");
ds_map_add(global.text_data_en, "obj_readable_room1_543", "* (너 무  어 두 워 서&  벽 이  보 이 지  않 는 다 .)/%%");
ds_map_add(global.text_data_en, "obj_readable_room1_548", "* (꺼 진  것  같 다 .)/%%");
ds_map_add(global.text_data_en, "obj_readable_room1_551", "* 실 험  기 록  제 8번 /");
ds_map_add(global.text_data_en, "obj_readable_room1_552", "* 실 험 군 을  골 랐 다 ./");
ds_map_add(global.text_data_en, "obj_readable_room1_553", "* 아 스 고 어 에 겐  아 직&  말 하 지  않 았 다 ^1.&* 놀 래 켜 주 고  싶 었 다 .../");
ds_map_add(global.text_data_en, "obj_readable_room1_554", "* 그 의  정 원  가 운 데 에 ^1,&  특 이 한  것 이  있 다 ./");
ds_map_add(global.text_data_en, "obj_readable_room1_555", "* 다 른  꽃 들  보 다&  더  빨 리  자 라 난 ^1,&  첫  황 금 꽃 ./");
ds_map_add(global.text_data_en, "obj_readable_room1_556", "* 바 깥  세 상 에 서  온  꽃 ./");
