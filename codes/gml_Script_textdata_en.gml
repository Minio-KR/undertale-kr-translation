ds_map_add(global.text_data_en, "obj_cookshowevent_91", "* 어 -어 라 ^1, 여 기  좀&  \M9어 둡 네 ^1. 그 렇 지 ?/");
ds_map_add(global.text_data_en, "obj_cookshowevent_92", "\E6* 걱 정  마 !/");
ds_map_add(global.text_data_en, "obj_cookshowevent_93", "\E0*\M8 조 명  시 스 템 을&  해 킹 해 서  밝 혀  줄 게 !/%%");
