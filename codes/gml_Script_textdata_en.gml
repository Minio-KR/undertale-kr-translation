ds_map_add(global.text_data_en, "SCR_TEXT_1294", "* (그 을 린  프 라 이 팬 을  얻 었 다 .)/%%");
ds_map_add(global.text_data_en, "SCR_TEXT_1297", "* (너 무  많 이  들 고  있 다 .)/%%");
ds_map_add(global.text_data_en, "SCR_TEXT_1301", " %%");
ds_map_add(global.text_data_en, "SCR_TEXT_1308", "* (바 닥 에  앞 치 마 가  놓 여  있 다 .)/");
ds_map_add(global.text_data_en, "SCR_TEXT_1309", "* (가 져 갑 니 까 ?)& &         가 져 간 다     놔 둔 다 \C");
