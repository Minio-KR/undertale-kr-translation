ds_map_add(global.text_data_en, "SCR_TEXT_6300", "   * 살 펴 보 기 ");
ds_map_add(global.text_data_en, "SCR_TEXT_6313", "   * 살 펴 보 기       * 울 기");
ds_map_add(global.text_data_en, "SCR_TEXT_6323", "   * 살 펴 보 기       * 속 삭 이 기 &   * 갑 옷 닦 기");
ds_map_add(global.text_data_en, "SCR_TEXT_6333", "   * 살 펴 보 기       * 속 삭 이 기 &   * 갑 옷 닦 기");
ds_map_add(global.text_data_en, "SCR_TEXT_6343", "   * 살 펴 보 기       * 작 업 걸 기 &   * 접 근 하 기");
ds_map_add(global.text_data_en, "SCR_TEXT_6353", "   * 살 펴 보 기       * 비 난 하 기 &   * 격 려 하 기       * 안 아 주 기");
ds_map_add(global.text_data_en, "SCR_TEXT_6363", "   * 살 펴 보 기       * 식 히 기 &   * 덥 히 기         * 초 대 하 기");
ds_map_add(global.text_data_en, "SCR_TEXT_6374", "\W   * 살 펴 보 기       * 몸 부 림 치 기 &   * \[1]G 내 기 &         \Y소 지 금 : \[G]G \W");
ds_map_add(global.text_data_en, "SCR_TEXT_6384", "   * 살 펴 보 기       * 소 리 치 기");
ds_map_add(global.text_data_en, "SCR_TEXT_6387", "\W   * 살 펴 보 기       \Y* 노 란 색 \W");
ds_map_add(global.text_data_en, "SCR_TEXT_6398", "   * 살 펴 보 기       * 공 격 하 는 척");
ds_map_add(global.text_data_en, "SCR_TEXT_6408", "   * 살 펴 보 기       * 대 화 하 기 &   * 노 려 보 기       * 마 음 비 우 기");
ds_map_add(global.text_data_en, "SCR_TEXT_6418", "   * 살 펴 보 기       * 대 화 하 기 &   * 노 래 하 기");
ds_map_add(global.text_data_en, "SCR_TEXT_6428", "   * 살 펴 보 기       * 칭 찬 하 기 &   * 위 협 하 기       * 교 란 하 기");
ds_map_add(global.text_data_en, "SCR_TEXT_6438", "   * 살 펴 보 기       * 괴 롭 히 기 &   * 안 괴 롭 히 기     * 이 의 제 기");
ds_map_add(global.text_data_en, "SCR_TEXT_6449", "   * 살 펴 보 기       * 위 로 하 기 &   * 겁 주 기         * 기 도 하 기");
ds_map_add(global.text_data_en, "SCR_TEXT_6460", "   * 살 펴 보 기       * 폭 탄 해 체");
ds_map_add(global.text_data_en, "SCR_TEXT_6470", "   * 살 펴 보 기       * 속 삭 이 기 &   * 갑 옷 닦 기");
ds_map_add(global.text_data_en, "SCR_TEXT_6480", "   * 살 펴 보 기       * 속 삭 이 기 &   * 갑 옷 닦 기");
ds_map_add(global.text_data_en, "SCR_TEXT_6490", "   * 살 펴 보 기       * 불 지 르 기");
ds_map_add(global.text_data_en, "SCR_TEXT_6493", "\W   * 살 펴 보 기       \Y* 돌 리 기 \W");
ds_map_add(global.text_data_en, "SCR_TEXT_6504", "   * 살 펴 보 기       * 뽐 내 기 &   * 포 즈           * 돌 기");
ds_map_add(global.text_data_en, "SCR_TEXT_6514", "   * 살 펴 보 기       * 대 화 하 기");
ds_map_add(global.text_data_en, "SCR_TEXT_6524", "   * 부 르 기         * 흥 얼 대 기 &   * 절 규 하 기       * 몸 풀 기 &   * 포 옹 풀 기       * 울 기");
ds_map_add(global.text_data_en, "SCR_TEXT_6534", "   * 살 펴 보 기       * 괴 롭 히 기 &   * 교 란 하 기       * 씻 기 &   * 흥 얼 거 리 기     * 기 도 하 기");
ds_map_add(global.text_data_en, "SCR_TEXT_6544", "   * 살 펴 보 기       * 웃 기 &   * 야 유 하 기       * 농 담 하 기");
ds_map_add(global.text_data_en, "SCR_TEXT_6554", "   * 살 펴 보 기       * 아 이 템 &   * 스 탯           * 휴 대 폰");
ds_map_add(global.text_data_en, "SCR_TEXT_6565", "   * 살 펴 보 기       * 합 류 하 기 &   * 거 절 하 기");
ds_map_add(global.text_data_en, "SCR_TEXT_6579", "   * 살 펴 보 기       * 쓰 다 듬 기 &   * 부 르 기         * 놀 아 주 기 &   * 무 시 하 기");
ds_map_add(global.text_data_en, "SCR_TEXT_6589", "   * 공 격 하 는 척     * 요 리 배 우 기 &   * 미 소 짓 기       * 대 련 하 기");
ds_map_add(global.text_data_en, "SCR_TEXT_6599", "   * 응 원 하 기       * 전 화 하 기 &   * 덕 밍 아 웃       * 퀴 즈");
ds_map_add(global.text_data_en, "SCR_TEXT_6609", "   * 농 담 하 기       * 퍼 즐 &   * 요 리           * 모 욕 하 기");
ds_map_add(global.text_data_en, "SCR_TEXT_6619", "   * 휴 식 하 기       * 농 담 하 기 &   * 심 판 받 기       * 십 자 말 풀 이");
ds_map_add(global.text_data_en, "SCR_TEXT_6629", "   * 대 화 하 기       * 자 비 &   * 포 옹 하 기       * 좋 아 하 는 것");
ds_map_add(global.text_data_en, "SCR_TEXT_6639", "   * 대 화 하 기       * 자 비 &   * 들 여 다 보 기     * 포 옹 하 기");
