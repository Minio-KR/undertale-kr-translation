ds_map_add(global.text_data_en, "SCR_TEXT_2881", '* (이  CD는  "오 싹 웨 이 브 "라 고&  표 시 되 어  있 다 .)/');
ds_map_add(global.text_data_en, "SCR_TEXT_2882", "* (재 생 할 까 요 ?)& &         재 생         아 니 요 \C");
