ds_map_add(global.text_data_en, "SCR_TEXT_6709", "   * 살 펴 보 기       * 괴 롭 히 기 &   * 안 괴 롭 히 기     * 이 의 제 기");
ds_map_add(global.text_data_en, "SCR_TEXT_6720", "   * 살 펴 보 기       * 위 로 하 기 &   * 겁 주 기         * 기 도 하 기");
ds_map_add(global.text_data_en, "SCR_TEXT_6731", "   * 살 펴 보 기       * 대 화 하 기");
ds_map_add(global.text_data_en, "SCR_TEXT_6741", "   * 살 펴 보 기       * 바 꾸 기 &   * 고 정 하 기       * 눕 기");
ds_map_add(global.text_data_en, "SCR_TEXT_6751", "   * 살 펴 보 기       * 쉭 쉭 거 리 기 &   * 삼 키 기         * 간 식 먹 기");
ds_map_add(global.text_data_en, "SCR_TEXT_6761", "   * 살 펴 보 기       * 박 수 치 기 &   * 야 유 하 기       * 가 만 있 기");
