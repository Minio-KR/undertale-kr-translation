ds_map_add(global.text_data_en, "obj_chilldrake_272", "틀 렸 어 !&그 냥&싸 우 다&죽 자 ");
ds_map_add(global.text_data_en, "obj_chilldrake_273", "정 말 ...&죽 었 어 ?");
ds_map_add(global.text_data_en, "obj_chilldrake_274", "반 항 은&반 항 할  수&없 다 !");
ds_map_add(global.text_data_en, "obj_chilldrake_279", "내 가&했 던&거 랑&똑 같 잖 아 .");
ds_map_add(global.text_data_en, "obj_chilldrake_280", "하 하&유 후 ");
ds_map_add(global.text_data_en, "obj_chilldrake_281", "넌&성 공 했 네 .");
ds_map_add(global.text_data_en, "obj_chilldrake_286", "스 노 위 는&지 금&어 디  있 지 ?");
