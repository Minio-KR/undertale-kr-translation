ds_map_add(global.text_data_en, "obj_boysnightout_113", "* 우 린 ^1, 정 말 이 지 ^1, 누 군 가 가  보 낸 &  줄 무 늬  셔 츠 를  입 은  인 간 에&  대 한  제 보 를  받 았 다 ./");
ds_map_add(global.text_data_en, "obj_boysnightout_114", "* 지 금  핫 랜 드 를  떠 돌 아 다 니 고&  있 다 더 군 .../");
ds_map_add(global.text_data_en, "obj_boysnightout_115", "* 알 아 ^1, 참  무 섭 지 ^1. 응 ?/");
ds_map_add(global.text_data_en, "obj_boysnightout_116", "* 자 ^1, 안 심 해 ^1.&* 안 전 한  곳 으 로&  데 려 다  줄 게 , 알 겠 어 ?/%%");
ds_map_add(global.text_data_en, "obj_boysnightout_117", "%%%");
ds_map_add(global.text_data_en, "obj_boysnightout_156", "* ...허 ^1?&* 무 슨  일 이 야 , 친 구 ?/");
