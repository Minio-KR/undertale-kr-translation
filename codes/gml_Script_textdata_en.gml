ds_map_add(global.text_data_en, "obj_labtv_event_95", "* (순 서 대 로  라 벨 이  붙 어  있 다 .)/");
ds_map_add(global.text_data_en, "obj_labtv_event_96", "* (보 겠 습 니 까 ...?)/%%");
ds_map_add(global.text_data_en, "obj_labtv_event_98", "* (볼  테 이 프 를  선 택 하 시 오 .)/%%");
ds_map_add(global.text_data_en, "obj_labtv_event_287", "* 저 기 ^1.&* 고 리 ^1, 일 어 나  봐 요 . \Ta/");
ds_map_add(global.text_data_en, "obj_labtv_event_288", "* 음 ^1?&* 무 슨  일 이 오 ^1, 여 보 ?/");
ds_map_add(global.text_data_en, "obj_labtv_event_289", "* ...어 어 ^1, 그 리 고&  왜  카 메 라 를  들 고&  있 는  거 요 ? \TT/");
ds_map_add(global.text_data_en, "obj_labtv_event_290", "* 쉿 ^1!&* 당 신  반 응 을&  찍 고  싶 어 서  그 래 요 ./");
ds_map_add(global.text_data_en, "obj_labtv_event_291", "* 고 리 ^1, 내  사 랑 ^1.&* 제 가  제 일  좋 아 하 는&  식 물 이  뭐 게 요 ?\Ta/");
ds_map_add(global.text_data_en, "obj_labtv_event_292", "* 흠 ..^1.&* 당 근 ^1, 맞 소 ?\TT/");
ds_map_add(global.text_data_en, "obj_labtv_event_293", "* 아 뇨 , 아 뇨 , 아 뇨 ^1!&* 제 가  제 일  좋 아 하 는&  식 물 은 .../");
ds_map_add(global.text_data_en, "obj_labtv_event_294", "* 어 미 -자 예 요 ./");
ds_map_add(global.text_data_en, "obj_labtv_event_295", "* ... 이 해 했 어 요 ???\Ta/");
ds_map_add(global.text_data_en, "obj_labtv_event_296", "* .../");
ds_map_add(global.text_data_en, "obj_labtv_event_297", "* 다 시  자 러  가 시 구 려 ^1,&  여 보 .\TT/");
ds_map_add(global.text_data_en, "obj_labtv_event_298", "* 아 니  아 니 !^1!&* 아 직 은  안  돼 요 ^1!&* 히  히  히 ./");
ds_map_add(global.text_data_en, "obj_labtv_event_299", "* 자 ^1,&  만 약  제 가  개 였 다 면 ^1,&  무 슨  품 종 이 었 을 까 요 ?\Ta/");
ds_map_add(global.text_data_en, "obj_labtv_event_300", "* 흠 ..^1. 모 르 겠 소 ^1, 여 보 ^1.&* 무 슨  개 일  것  같 소 ?\TT/");
ds_map_add(global.text_data_en, "obj_labtv_event_301", "* 전 .../");
ds_map_add(global.text_data_en, "obj_labtv_event_302", '* "엄 마 시 안 "이 었 을  것&  같 아 요 .\Ta/');
ds_map_add(global.text_data_en, "obj_labtv_event_303", "* 허 허 허 !/");
ds_map_add(global.text_data_en, "obj_labtv_event_304", "* 아 이 를  가 져&  기 쁜 가  보 구 려 ./");
ds_map_add(global.text_data_en, "obj_labtv_event_305", "* 뭐 ^1, 계 속  이 런  농 담 을&  하 다 보 면 .../");
ds_map_add(global.text_data_en, "obj_labtv_event_306", "* 언 젠 가 ^1, 당 신 은 .../");
ds_map_add(global.text_data_en, "obj_labtv_event_307", '* ...유 명 한  코 "모 "디 언 이&  되 겠 구 려 .\TT/');
ds_map_add(global.text_data_en, "obj_labtv_event_308", "* .../");
ds_map_add(global.text_data_en, "obj_labtv_event_309", "* 에 ^1, 자 러  가 야 겠 네 .\Ta/");
ds_map_add(global.text_data_en, "obj_labtv_event_310", "* 에 이 ^1!&* 왜  그 러 시 오 ^1, 토 리 ^1!&* 재 밌 잖 소 !\TT/");
ds_map_add(global.text_data_en, "obj_labtv_event_311", "* 하 하 하 ^1, 알 아 요 ^1.&* 그 냥  장 난 친  거 예 요 ./");
ds_map_add(global.text_data_en, "obj_labtv_event_312", "* 잘 자 요 ^1, 여 보 .\Ta/");
ds_map_add(global.text_data_en, "obj_labtv_event_313", "* 잘 자 시 오 , 여 보 .\TT/");
ds_map_add(global.text_data_en, "obj_labtv_event_314", "* .../");
ds_map_add(global.text_data_en, "obj_labtv_event_315", "* 어 머 나 ^1, 녹 화 하 기 엔&  너 무  어 두 웠 겠 구 나 .../%%");
ds_map_add(global.text_data_en, "obj_labtv_event_350", "* 좋 아 ^1, \[차]^1, 준 비 됐 어 ?/");
ds_map_add(global.text_data_en, "obj_labtv_event_351", "* 무 서 운  표 정  지 어  봐 !/");
ds_map_add(global.text_data_en, "obj_labtv_event_352", "* 아 아 악 ^1!&* 헤  헤  헤 !/");
ds_map_add(global.text_data_en, "obj_labtv_event_353", "* 어 ^1! 잠 깐 ^1!&* 렌 즈  뚜 껑  빼 는  걸&  깜 박 했 어 .../");
ds_map_add(global.text_data_en, "obj_labtv_event_354", "* 응 ^1?&* 이 제  더 이 상&  안  할  거 라 고 ...?/");
ds_map_add(global.text_data_en, "obj_labtv_event_355", "* 아 , 제 발 ^1,&  장 난  그 만  좀  쳐 ^1!&* 하 하 !/%%");
ds_map_add(global.text_data_en, "obj_labtv_event_391", "* 반 가 워 ^1, \[차]^1!&* 한 번  웃 어  줘 !/");
ds_map_add(global.text_data_en, "obj_labtv_event_392", "* 하 ^1, 이 번 엔  내 가  속 였 지 ^1!&* 이 번 엔  렌 즈  뚜 껑 을 ..^1.&* 일 부 러  안  뽑 았 지 롱 !/");
ds_map_add(global.text_data_en, "obj_labtv_event_393", "* 결 국  넌  아 아 무&  이 유  없 이  웃 은  거 야 ^1!&* 헤  헤  헤 !/");
ds_map_add(global.text_data_en, "obj_labtv_event_394", "* 응 ^1?&* 아 ^1, 물 론 ^1, 기 억 나 지 ./");
ds_map_add(global.text_data_en, "obj_labtv_event_395", "* 아 빠 께  드 릴&  버 터 스 카 치  파 이 ^1,&  그 거  만 들 었 었 잖 아 ./");
ds_map_add(global.text_data_en, "obj_labtv_event_396", "* 요 리 법 에 는&  버 터  1컵 을  넣 으 라 고&  되 어  있 었 는 데 .../");
ds_map_add(global.text_data_en, "obj_labtv_event_397", "* 실 수 로  버 터 컵  꽃 을&  넣 어  버 렸 지 ./");
ds_map_add(global.text_data_en, "obj_labtv_event_398", "* 응 ^1!&* 그  꽃  때 문 에&  아 빠 가  엄 청  아 팠 어 ./");
ds_map_add(global.text_data_en, "obj_labtv_event_399", "* 정 말 로  죄 송 스 러 웠 어 ^1.&* 엄 마 는  언 짢 아 하 셨 고 ./");
ds_map_add(global.text_data_en, "obj_labtv_event_400", "* 나 도  너 처 럼  그 때 ^1,&  웃 어 넘 겼 어 야  하 는  건 데 .../");
ds_map_add(global.text_data_en, "obj_labtv_event_401", "* 음 ^1, 근 데 ^1,&  그 거  들 고  어 디  가 ?/");
ds_map_add(global.text_data_en, "obj_labtv_event_402", "* 어 ^1?&* 일 단  카 메 라 를  끄 라 고 ...^1?&* 알 았 어 ./%%");
ds_map_add(global.text_data_en, "obj_labtv_event_435", "* 나 ..^1. 난  이  계 획 이&  마 음 에  안  들 어 ^1,&  \[차]./");
ds_map_add(global.text_data_en, "obj_labtv_event_436", "* 뭐 .^1. 뭐 ^1?&* 아 -아 냐 , 나 는 .../");
ds_map_add(global.text_data_en, "obj_labtv_event_437", "* ... 다  큰  애 는&  울 지  않 아 ./");
