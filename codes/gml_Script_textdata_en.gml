ds_map_add(global.text_data_en, "obj_townnpc_reddemon_95", "* 방 금 은 ^1, 좀  떨 면 서&  웃 은  것  같 은 데 /");
ds_map_add(global.text_data_en, "obj_townnpc_reddemon_96", "* 뭐 가  문 제 인  거 지 ?/%%");
ds_map_add(global.text_data_en, "obj_townnpc_slimedad_70", "* 아 ^1, 다 시  어 려 진 다 면 ^1.&  이  세 계 는  끝 없 이  넓 게&  느 껴 질  텐 데 ./%%");
ds_map_add(global.text_data_en, "obj_townnpc_slimedad_74", "* 넌  방 랑 을  좋 아 하 는 구 나 ^1.&* 젊 은  녀 석  같 으 니 /%%");
ds_map_add(global.text_data_en, "obj_townnpc_slimedad_79", "* 이  새 롭 고 ^1, 끝 없 는  세 계 가&  시 작 된  걸  보 고  있 자 니 .../");
ds_map_add(global.text_data_en, "obj_townnpc_slimedad_80", "* 와 -하 ^1!&* 이  모 험 심  넘 치 는  영 혼 ^1!&* 아 이 로  돌 아 간  느 낌 이 군 !/");
ds_map_add(global.text_data_en, "obj_townnpc_slimedad_81", "* 그 리 고  내  아 이 들 은  그 ..^1.&* 아 이 -아 이 같 은 거 고 ./%%");
ds_map_add(global.text_data_en, "obj_townnpc_slimedad_86", "* 내  아 이 들 을&  안 으 로  돌 려 보 냈 다 ./");
ds_map_add(global.text_data_en, "obj_townnpc_slimedad_87", "* 오 늘  이 곳 은  뭔 가&  안 전 하 지  않 은  느 낌 이 군 ./%%");
ds_map_add(global.text_data_en, "obj_townnpc_slimedaughter_80", "* 너  또  나 한 테  인 간  역 할&  시 킬  거 지 ^1, 그 치 ?/%%");
ds_map_add(global.text_data_en, "obj_townnpc_slimedaughter_84", "* 제 발  다 른  놀 이  하 면&  안  돼 ...?/%%");
ds_map_add(global.text_data_en, "obj_townnpc_slimedaughter_89", "* 음 ..^1.&* 만 약 에  인 간 이&  괴 물 과  인 간  놀 이 를  하 면 .../");
ds_map_add(global.text_data_en, "obj_townnpc_slimedaughter_90", "* 그 들 은  인 간 과  인 간&  놀 이 라 고  하 는  걸 까 ?/%%");
ds_map_add(global.text_data_en, "obj_townnpc_slimeson_75", "* 괴 물 과  인 간  놀 이 하 자 !/%%");
ds_map_add(global.text_data_en, "obj_townnpc_slimeson_79", "* 계 속 해 서&  괴 물 과  인 간  놀 이  하 자 !/%%");
ds_map_add(global.text_data_en, "obj_townnpc_slimeson_84", "* 이 제  우 리  괴 물 과  인 간&  놀 이 를  진 짜  인 간 과&  할  수  있 겠 다 !/%%");
ds_map_add(global.text_data_en, "obj_townnpc_unfunny_70", "* 모 두 들  언 제 나  웃 고 ^1,&  농 담 하 고 ^1, 우 리 의  위 기 를&  잊 으 려  노 력 하 고 .../");
ds_map_add(global.text_data_en, "obj_townnpc_unfunny_71", "* 쓸 쓸 함 ^1.&* 인 구  과 잉 ^1.&* 태 양 빛 의  부 족 ./");
ds_map_add(global.text_data_en, "obj_townnpc_unfunny_72", "* 모 두 와  함 께 할  수 는&  있 겠 지 만 ^1, 난  그 리&  웃 기 지  않 아 서  말 야 ./%%");
ds_map_add(global.text_data_en, "obj_townnpc_unfunny_73", "* 적 어 도  말 장 난 은  못 해 ./%%");
ds_map_add(global.text_data_en, "obj_townnpc_unfunny_77", "* 잠 깐 만 ^1!&* 나  농 담 이  생 각 났 어 !/");
ds_map_add(global.text_data_en, "obj_townnpc_unfunny_78", "* 똑  똑 !/");
ds_map_add(global.text_data_en, "obj_townnpc_unfunny_79", "* 어 ..^1.&* 그 게  전 부 야 ./%%");
ds_map_add(global.text_data_en, "obj_townnpc_unfunny_85", "* 이 젠  끝 내 주 는  농 담 들 에&  대 해  걱 정 하 지  않 아 도&  되 는  모 양 이 네 ./");
ds_map_add(global.text_data_en, "obj_townnpc_unfunny_86", "* .../");
ds_map_add(global.text_data_en, "obj_townnpc_unfunny_87", "* 여 기 서  농 담 을  하 려  했 는 데 ^1,&  사 실  아 무 것 도  생 각 난  게&  없 어 ./%%");
ds_map_add(global.text_data_en, "obj_townnpc_unfunny_92", "* 마 치 ..^1. &* 마 치  모 든  게  점 점  더&  최 악 이  되 어  가 는  기 분 이 야 ./%%");
ds_map_add(global.text_data_en, "obj_townnpc_weirdfish_72", "* 오 늘  여 자 를  좀  낚 으 려 고&  낚 싯 줄 을  던 져  놨 어 ./");
ds_map_add(global.text_data_en, "obj_townnpc_weirdfish_73", "* '바 다 에  생 선 은  많 다 '란&  말 이  있 지 .../");
ds_map_add(global.text_data_en, "obj_townnpc_weirdfish_74", "* 음 ^1, 진 지 하 게&  받 아 들 일  거 야 ./");
ds_map_add(global.text_data_en, "obj_townnpc_weirdfish_75", "* 정 말  말  그 대 로&  생 선 이 랑  사 귈  거 라 고 ./%%");
ds_map_add(global.text_data_en, "obj_townnpc_weirdfish_76", "* 언 다 인 한 테  고 백 해 야 겠 지 만 ^1,&  이 미  언 다 인 은  좋 아 하 는&  사 람 이  있 는  것  같 아 ./%%");
ds_map_add(global.text_data_en, "obj_townnpc_weirdfish_80", "* 누 구 라 도  낚 았 나 ^1?&* 잘  볼  수 가  없 어 서 .../%%");
ds_map_add(global.text_data_en, "obj_townnpc_weirdfish_85", "* 샌 즈 는  이  중 에 서&  가 장  가 장  평 범 한&  녀 석 이 야 ./");
ds_map_add(global.text_data_en, "obj_townnpc_weirdfish_86", "* 근 데  최 근 엔  모 습 을&  잘  못  봤 어 ./%%");
ds_map_add(global.text_data_en, "obj_townnpc_weirdfish_91", "* 샌 즈 는  대 체&  어 디  있 는  거 야 ?/");
ds_map_add(global.text_data_en, "obj_townnpc_weirdfish_92", "* 나 더 러  쓸  수  있 는  떡 밥 이&  좀  있 다 고  했 었 는 데 ./");
ds_map_add(global.text_data_en, "obj_townnpc_weirdfish_93", "* 생 각 해 보 면  뭔 가&  말 장 난  같 기 도  했 어 ./");
ds_map_add(global.text_data_en, "obj_townnpc_weirdfish_94", "* 그 래 도  그 게  무 슨&  말 장 난 이 었 는 지 는&  알 고  싶 다 고 !/%%");
ds_map_add(global.text_data_en, "obj_townnpc_weirdfish_99", "* 결 국 ^1, 내  낚 싯 줄 로 는&  어 떠 한  여 자 도  낚 을  수&  없 었 어 .../");
ds_map_add(global.text_data_en, "obj_townnpc_weirdfish_100", "* 그 러 니  꼬 마 야 ^1, 잘  들 어  둬 .../");
ds_map_add(global.text_data_en, "obj_townnpc_weirdfish_101", "* 핫 한  사 람 들 을  낚 싯 대 로&  낚 으 려 는  건  시 도 도  하 지&  말 라 구 ./");
ds_map_add(global.text_data_en, "obj_townnpc_weirdfish_102", "* (어 디 선 가 에 서 ^1, 실 망 에  찬&  훌 쩍 거 림 이  들 린 다 .)/%%");
ds_map_add(global.text_data_en, "obj_treadmill_event_103", "저기^1, 샌즈 형^1,&혹시 내.../");
ds_map_add(global.text_data_en, "obj_treadmill_event_104", "\E0아, 안녕^1,&넌 샌즈 형이 아니잖아./");
ds_map_add(global.text_data_en, "obj_treadmill_event_105", "\E3잠깐만./");
ds_map_add(global.text_data_en, "obj_treadmill_event_106", "\E0불을 꺼놓고&러닝머신을 하고&있는 거야?/");
ds_map_add(global.text_data_en, "obj_treadmill_event_107", "\E3설마 샌즈 형이&또 시공간 골탕을&먹이는 거야?/");
ds_map_add(global.text_data_en, "obj_treadmill_event_108", "\E1그럴 때마다&정말 싫단 말이야!/");
ds_map_add(global.text_data_en, "obj_treadmill_event_109", "\E1형은 도대체&언제쯤 철이 들까?/");
ds_map_add(global.text_data_en, "obj_treadmill_event_110", "\E3그리고, 혹시&내 피규어&어디 있는지 알아?/");
ds_map_add(global.text_data_en, "obj_treadmill_event_111", "\E0아^1!&어딨는지 알겠다!/");
ds_map_add(global.text_data_en, "obj_treadmill_event_112", "내 콜렉션 안에 있겠지^1!&녜 헤 헤!!/");
ds_map_add(global.text_data_en, "obj_treadmill_event_113", "가끔^1,&난 천재야^1.&항상./%%");
ds_map_add(global.text_data_en, "obj_triswitchevent_120", "* 따 르 릉 .../");
ds_map_add(global.text_data_en, "obj_triswitchevent_121", "\TS \E3 \F6 \TA %");
ds_map_add(global.text_data_en, "obj_triswitchevent_122", "\E6* 좋 아 ^1!&* 이 제  세  번 째 를&  눌 러 !!!/%%");
ds_map_add(global.text_data_en, "obj_triswitchevent_123", "\TS \F0 \E0 \T0 %");
