ds_map_add(global.text_data_en, "obj_chilldrake_255", "네 가&정 말 ...");
ds_map_add(global.text_data_en, "obj_chilldrake_256", "사 실 을&말 할&리 가 ...");
ds_map_add(global.text_data_en, "obj_chilldrake_258", "넌&내&사 정 을&몰 라 !");
