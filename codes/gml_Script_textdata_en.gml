ds_map_add(global.text_data_en, "obj_napstablook_300", "헤 ...");
ds_map_add(global.text_data_en, "obj_napstablook_301", "헤&헤 ...");
ds_map_add(global.text_data_en, "obj_napstablook_302", "이 것&봐 봐 ...");
