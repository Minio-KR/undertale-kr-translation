ds_map_add(global.text_data_en, "obj_torboss_2ndtime_153", "그 리 고  그 게&하 드  모 드 의&끝 이 었 습 니 다 !/%%");
ds_map_add(global.text_data_en, "obj_torboss_2ndtime_175", "\E1에 ??/");
ds_map_add(global.text_data_en, "obj_torboss_2ndtime_176", "\E2지 금  끝 낸 다 고 ?/");
ds_map_add(global.text_data_en, "obj_torboss_2ndtime_177", "\E1이 런  극 적 인&순 간 에 ...?/%%");
