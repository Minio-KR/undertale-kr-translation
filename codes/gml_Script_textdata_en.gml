ds_map_add(global.text_data_en, "SCR_TEXT_6071", "   * 살 펴 보 기       * 쓰 다 듬 기 &   * 쓰 다 듬 기       * 쓰 다 듬 기 &   * 쓰 다 듬 기       * 쓰 다 듬 기");
ds_map_add(global.text_data_en, "SCR_TEXT_6081", "   * 살 펴 보 기       * 쓰 다 듬 기 &   * 냄 새 맡 게 함     * 굴 러 다 니 기");
ds_map_add(global.text_data_en, "SCR_TEXT_6091", "   * 살 펴 보 기       * 쓰 다 듬 기 &   * 냄 새 맡 게 함     * 굴 러 다 니 기");
ds_map_add(global.text_data_en, "SCR_TEXT_6101", "   * 살 펴 보 기       * 쓰 다 듬 기 &   * 부 르 기         * 놀 아 주 기 &   * 무 시 하 기");
ds_map_add(global.text_data_en, "SCR_TEXT_6114", "   * 살 펴 보 기       * 동 의 하 기 &   * 말 싸 움         * 농 담");
ds_map_add(global.text_data_en, "SCR_TEXT_6124", "   * 살 펴 보 기       * 웃 기 &   * 야 유 하 기       * 농 담 하 기");
ds_map_add(global.text_data_en, "SCR_TEXT_6135", "   * 살 펴 보 기       * 칭 찬 하 기 &   * 무 시 하 기       * 뺏 기 ");
ds_map_add(global.text_data_en, "SCR_TEXT_6145", "   * 살 펴 보 기       * 칭 찬 하 기");
