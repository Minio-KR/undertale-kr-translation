ds_map_add(global.text_data_en, "obj_otherphonecall_115", "* 어 -어 어 ..^1.&* (세 상 에 ^1, 도 와 줘 ...)/");
ds_map_add(global.text_data_en, "obj_otherphonecall_116", "* 저 기  음 ..^1.&* 그 러 니 까 ..^1.&* 피 자  주 문 하 려 는 데 요 ...?/");
ds_map_add(global.text_data_en, "obj_otherphonecall_117", "* 그 리 고 ^1, 어 어 ..^1.&* 토 핑 은 ^1, 어 .../");
ds_map_add(global.text_data_en, "obj_otherphonecall_118", "* 토 핑 은  문 자 로  보 내 준  대 로 ^1,&  주 세 요 . 지 금  보 내 드 릴 게 요 ./");
ds_map_add(global.text_data_en, "obj_otherphonecall_119", "\T0 %");
ds_map_add(global.text_data_en, "obj_otherphonecall_120", "* (이  휴 대 폰 은  문 자 를&  받 기 에 는  너 무  구 형 이 다 ...)/");
ds_map_add(global.text_data_en, "obj_otherphonecall_121", "* (고 양 이 소 녀  애 니 의 ^1,&  아 스 키  아 트 에 ^1, 사 용 된&  알 파 벳 을  읽 고  있 다 .)/");
ds_map_add(global.text_data_en, "obj_otherphonecall_122", "\TA* .../%%");
ds_map_add(global.text_data_en, "obj_otherphonecall_133", "* (삑 ...)/%%");
ds_map_add(global.text_data_en, "obj_outsideworld_event_158", "\E0* 쩝 ./");
ds_map_add(global.text_data_en, "obj_outsideworld_event_159", "\E1* 문 제  안  생 기 게&  누 가  계 속&  봐 줘 야 겠 는 데 ./");
ds_map_add(global.text_data_en, "obj_outsideworld_event_160", "\E2* 이 따  봐 , 친 구 들 ./%%");
ds_map_add(global.text_data_en, "obj_outsideworld_event_183", "\E0* 으 ^1, 꼭  내 가  다&  봐 줘 야  하 나 ?/");
ds_map_add(global.text_data_en, "obj_outsideworld_event_184", "\E6* 파 피 루 스 ^1, 기 다 려 !/%%");
ds_map_add(global.text_data_en, "obj_outsideworld_event_219", "\E0* 어 ^1, 언 다 인 ^1!&* 기 다 려 줘 !/%%");
ds_map_add(global.text_data_en, "obj_outsideworld_event_255", "* 이 런 ./%%");
ds_map_add(global.text_data_en, "obj_outsideworld_event_273", "* 어 ^1, 내 가  뭔 가&  해 야  하 는  거 요 ?/");
ds_map_add(global.text_data_en, "obj_outsideworld_event_275", "* .../");
ds_map_add(global.text_data_en, "obj_outsideworld_event_277", "* 음 ^1, 가 야 겠 군 !/%%");
ds_map_add(global.text_data_en, "obj_outsideworld_event_309", "* 모 두  다  신 나 서&  떠 나 려 는  것&  같 구 나 ./%%");
ds_map_add(global.text_data_en, "obj_outsideworld_event_344", "* 뭐 야 ?/");
ds_map_add(global.text_data_en, "obj_outsideworld_event_345", "\E1* 프 리 스 크 .../");
ds_map_add(global.text_data_en, "obj_outsideworld_event_346", "\E0* 정 말  재 미 있 는&  아 이 로 구 나 ./");
ds_map_add(global.text_data_en, "obj_outsideworld_event_347", "\E1* 예 전 에  그  말 을  했 다 면 ^1,&  이  모 든  일 도  전 혀&  없 었 을  텐 데  말 이 야 ./");
ds_map_add(global.text_data_en, "obj_outsideworld_event_348", "\E0* 오 랜  시 간 이  지 난  뒤 에&  마 음 을  바 꿔 줘 서&  정 말  다 행 이 야 ./");
ds_map_add(global.text_data_en, "obj_outsideworld_event_349", "* 히  히  히 ./");
ds_map_add(global.text_data_en, "obj_outsideworld_event_350", "* 음 ..^1.&* 아 마 도 ./");
ds_map_add(global.text_data_en, "obj_outsideworld_event_351", "* 네 가  정 말 로  달 리&  갈  곳 이  없 다 면 .../");
ds_map_add(global.text_data_en, "obj_outsideworld_event_352", "* 네 게  필 요 한  시 간 만 큼&  내 가  최 선 을  다 해 서&  길 러 줄 게 ./");
ds_map_add(global.text_data_en, "obj_outsideworld_event_353", "* 알 겠 지 ?/");
ds_map_add(global.text_data_en, "obj_outsideworld_event_354", "* 자 ^1, 가 자 ./%%");
ds_map_add(global.text_data_en, "obj_outsideworld_event_372", "* 모 두 가  우 릴&  기 다 리 고  있 단 다 !/%%");
ds_map_add(global.text_data_en, "obj_outsideworld_event_413", "\E1* 아 ./");
ds_map_add(global.text_data_en, "obj_outsideworld_event_414", "\E0* ...알 겠 어 ./");
ds_map_add(global.text_data_en, "obj_outsideworld_event_415", "\E1* .../");
ds_map_add(global.text_data_en, "obj_outsideworld_event_416", "\E0* 음 ^1, 내 가  널&  막 으 려 는  게&  아 니 었 음  좋 겠 구 나 ./%%");
ds_map_add(global.text_data_en, "obj_outsideworld_event_478", "* 프 리 스 크 ./");
ds_map_add(global.text_data_en, "obj_outsideworld_event_479", '* "또  보 자 ."/%%');
ds_map_add(global.text_data_en, "obj_papbookshelf_63", "내가 좋아하는&책들 중 하나야./");
ds_map_add(global.text_data_en, "obj_papbookshelf_64", "비판적 사고를 위한&고급 퍼즐 만들기./");
ds_map_add(global.text_data_en, "obj_papbookshelf_66", "다음 책도&내가 좋아하는 거야./");
ds_map_add(global.text_data_en, "obj_papbookshelf_67", "복슬이 토끼와&숨바꼭질./");
ds_map_add(global.text_data_en, "obj_papbookshelf_68", "결말은&늘 좋다니깐./%%");
ds_map_add(global.text_data_en, "obj_papbookshelf_71", "* (복 잡 한  매 뉴 얼 과&  애 들  동 화 책 .)/%%");
ds_map_add(global.text_data_en, "obj_papbookshelf_76", "* (이  책 장 은  퍼 즐  만 들 기 에&  대 한  두 꺼 운  책 들 로&  가 득  차  있 다 .)/");
ds_map_add(global.text_data_en, "obj_papbookshelf_77", "* (그 리 고  애 들  동 화 책 이 랑 .)/%%");
ds_map_add(global.text_data_en, "obj_papcheckpoint_98", "* 판 지  상 자 에  글 이&  몇  줄  쓰 여  있 다 ./");
ds_map_add(global.text_data_en, "obj_papcheckpoint_99", "\TP %");
ds_map_add(global.text_data_en, "obj_papcheckpoint_100", "당신은 지금&잘 만들어진&감시탑을 보고 있다./");
ds_map_add(global.text_data_en, "obj_papcheckpoint_101", "누가 이것을 지었는지,&당신은 궁금할 것이다.../");
ds_map_add(global.text_data_en, "obj_papcheckpoint_102", "장담하건대, 이건&바로 엄청나게 유명한&왕실 근위병의 작품이다./");
ds_map_add(global.text_data_en, "obj_papcheckpoint_103", "(추신: 아직은 엄청나게&유명한 왕실 근위병이 아님^1.)/%%");
ds_map_add(global.text_data_en, "obj_papcheckpoint_107", "(추신: 아직은 엄청나게&유명한 왕실 근위병이 아님^1.)/");
ds_map_add(global.text_data_en, "obj_papcheckpoint_108", "(추가: 아직도&왕실 근위병이 아냐???)/%%");
ds_map_add(global.text_data_en, "obj_papcheckpoint_112", "* 설 명 글 이&  지 렁 이 같 은  글 씨 로&  쓰 여  있 다 ./%%");
ds_map_add(global.text_data_en, "obj_papcomputer_63", "인터넷^1!&나 거기서&꽤 유명해./");
ds_map_add(global.text_data_en, "obj_papcomputer_64", "이제 12명만&더 있으면.../");
ds_map_add(global.text_data_en, "obj_papcomputer_65", "구독자 수가&2자리가 된다고!/");
ds_map_add(global.text_data_en, "obj_papcomputer_66", "물론, 명예라는 건&꽤 큰 대가가&따르는 법이지./");
ds_map_add(global.text_data_en, "obj_papcomputer_67", "질투심 많은 자식이&내 온라인 인격을&공격하고 있어./");
ds_map_add(global.text_data_en, "obj_papcomputer_68", "늘 이상한 폰트로&썰렁한 말장난을&보내고 있다고.../%%/");
ds_map_add(global.text_data_en, "obj_papcomputer_73", "* (컴 퓨 터 의  인 터 넷&  브 라 우 저 가  소 셜  미 디 어&  사 이 트 에  접 속 해  있 다 .)/%%");
ds_map_add(global.text_data_en, "obj_papcomputer_79", "* (컴 퓨 터 의  인 터 넷&  브 라 우 저 가  소 셜  미 디 어&  사 이 트 에  접 속 해  있 다 .)/%%");
ds_map_add(global.text_data_en, "obj_papcomputer_84", "* (컴 퓨 터 의  인 터 넷&  브 라 우 저 가  음 악  공 유&  포 럼 에  접 속 해  있 다 .)/%%");
ds_map_add(global.text_data_en, "obj_papcomputer_90", "* (보 아 하 니  이  개 는&  온 라 인 에  나 쁜  글 들 을&  많 이  올 리 는  것  같 다 .)/");
ds_map_add(global.text_data_en, "obj_papcomputer_91", "* (음 성  변 환 이  켜 져 있 다 .)/");
ds_map_add(global.text_data_en, "obj_papcomputer_92", "* (보 아 하 니  개 가  짖 으 면 ^1,&  이 걸  나 쁜  글 들 로&  해 석 해 주 는  것  같 다 .)/");
ds_map_add(global.text_data_en, "obj_papcomputer_93", "* (자 기 가  뭐 라 고  말 하 는 지&  모 르 는  것  같 다 .)/");
ds_map_add(global.text_data_en, "obj_papcomputer_94", "* (온 라 인  대 부 분 의&  나 쁜  글 들 은 ^1, 그 냥&  이  개 인 가  보 다 .)/");
ds_map_add(global.text_data_en, "obj_papcomputer_95", "* (곰 곰 히  생 각 해 보 고 ..^1.)&* (당 신 은  안 심 이  되 었 다 .)/%%");
ds_map_add(global.text_data_en, "obj_papcouch_62", "* (소 파 를  만 져 보 았 다 ^1.)&* (뭔 가  덜 컹 거 리 는&  소 리 가  난 다 .)/");
ds_map_add(global.text_data_en, "obj_papcouch_63", "* (소 파  안 에  떨 어 진&  동 전  무 더 기 를  발 견 했 다 .)/");
ds_map_add(global.text_data_en, "obj_papcouch_64", "* (20G를  얻 었 다 .)/%%");
ds_map_add(global.text_data_en, "obj_papcouch_70", "* (그 냥  낡 은  소 파 다 .)/%%");
ds_map_add(global.text_data_en, "obj_papdate_150", "        데 이 트 ^1 시 작 !^5 %%");
ds_map_add(global.text_data_en, "obj_papdate_151", "        같 이  놀 기 ^1 시 작 !^5 %%");
ds_map_add(global.text_data_en, "obj_papdate_166", "도착했다!!^1!&데이트 할 장소에 말이야!!!/");
ds_map_add(global.text_data_en, "obj_papdate_167", "도착했다!!^1!&같이 놀 장소에 말이야!!!/");
ds_map_add(global.text_data_en, "obj_papdate_169", "\E3나 사실 이런 건&해 본 적 없거든./");
ds_map_add(global.text_data_en, "obj_papdate_170", "\E0하지만 걱정하지 마!!!/");
ds_map_add(global.text_data_en, "obj_papdate_171", "내 이름에는&'철저한'이라는 의미가&새겨져 있으니까!/%%");
ds_map_add(global.text_data_en, "obj_papdate_198", "내가 몰래&데이트 교본을&도서관에서 가져왔지!/");
ds_map_add(global.text_data_en, "obj_papdate_199", "내가 몰래&같이 놀기 가이드북을&도서관에서 가져왔지!/");
ds_map_add(global.text_data_en, "obj_papdate_201", "우린 이제 즐거운&시간을 보낼&준비는 다 된 거야!/");
ds_map_add(global.text_data_en, "obj_papdate_202", "\F4 \E8 %");
ds_map_add(global.text_data_en, "obj_papdate_203", "어디 볼까.../");
ds_map_add(global.text_data_en, "obj_papdate_204", "\X1단계..^1. 키보드에 있는&[ C ] 키를 눌러서&\R데이트 HUD\X를 작동하시오./");
ds_map_add(global.text_data_en, "obj_papdate_205", "\X1단계..^1. 키보드에 있는&[ C ] 키를 눌러서&\R우정 HUD\X를 작동하시오./");
ds_map_add(global.text_data_en, "obj_papdate_206", "\X1단계..^1. 컨트롤러에 있는&\*C 버튼을 눌러서&\R데이트 HUD\X를 작동하시오./");
ds_map_add(global.text_data_en, "obj_papdate_207", "\X1단계..^1. 컨트롤러에 있는&\*C 버튼을 눌러서&\R우정 HUD\X를 작동하시오./");
ds_map_add(global.text_data_en, "obj_papdate_208", "\E3네가 이미&한 것 같긴 한데.../%%");
ds_map_add(global.text_data_en, "obj_papdate_220", "\E3네가 이미&한 것 같긴 한데.../%%");
ds_map_add(global.text_data_en, "obj_papdate_232", "\E3.../");
ds_map_add(global.text_data_en, "obj_papdate_233", "\E3좋아^1, 넘어가자./%%");
ds_map_add(global.text_data_en, "obj_papdate_279", "\E0세에상에!!^1!&정보통이 된&기분이야!!!/");
ds_map_add(global.text_data_en, "obj_papdate_280", " %");
ds_map_add(global.text_data_en, "obj_papdate_281", "두 번째 단계로 갈&준비가 된 것 같군!!!/");
ds_map_add(global.text_data_en, "obj_papdate_282", "\F4 \E8 %");
ds_map_add(global.text_data_en, "obj_papdate_283", "2단계..^1.&데이트를 하자고&제안을 한다./");
ds_map_add(global.text_data_en, "obj_papdate_284", "2단계..^1.&같이 놀자고&제안을 한다./");
ds_map_add(global.text_data_en, "obj_papdate_286", "\E0에\F0헴!/");
ds_map_add(global.text_data_en, "obj_papdate_287", "\E1인간이여^1!&나^1, 위대한&파피루스 님은.../");
ds_map_add(global.text_data_en, "obj_papdate_288", "너와 데이트를&하겠노라!!!/*");
ds_map_add(global.text_data_en, "obj_papdate_289", "너와 같이&놀겠노라!!!/*");
ds_map_add(global.text_data_en, "obj_papdate_302", "                              &   그 래             아 니      &                            ");
ds_map_add(global.text_data_en, "obj_papdate_326", "저-정말로??^1?&세에상에!!!/");
ds_map_add(global.text_data_en, "obj_papdate_332", "다행히도^1,&부탁하라고만&쓰여 있네!!!/");
ds_map_add(global.text_data_en, "obj_papdate_334", "\E0내 생각엔&3단계로 넘어갈&때가 됐다는&뜻인 것 같군!!!/");
ds_map_add(global.text_data_en, "obj_papdate_335", "\F4 \E8 %");
ds_map_add(global.text_data_en, "obj_papdate_336", "3단계..^1.&진심을 보여주기 위해&멋진 옷을 입어라!/");
ds_map_add(global.text_data_en, "obj_papdate_337", "\E3. . ./%%");
ds_map_add(global.text_data_en, "obj_papdate_357", "\E3잠시만 기다려봐./%%");
ds_map_add(global.text_data_en, "obj_papdate_367", "옷을 입어라.../");
ds_map_add(global.text_data_en, "obj_papdate_369", "네 몸에 있는&그것.../");
ds_map_add(global.text_data_en, "obj_papdate_370", "네 몸에 붙은&그 반창고.../");
ds_map_add(global.text_data_en, "obj_papdate_371", "네 머리에 달린&그 리본.../");
ds_map_add(global.text_data_en, "obj_papdate_372", "네 머리에 두른&그 두건.../");
ds_map_add(global.text_data_en, "obj_papdate_373", "네 허리에 있는&그 발레복.../");
ds_map_add(global.text_data_en, "obj_papdate_374", "네가 쓰고 있는&그 안경.../");
ds_map_add(global.text_data_en, "obj_papdate_375", "네가 입고 있는&그 앞치마.../");
ds_map_add(global.text_data_en, "obj_papdate_376", "네가 머리에 쓴&그 카우보이 모자.../");
ds_map_add(global.text_data_en, "obj_papdate_377", "네 목에 걸린&그 펜던트./");
ds_map_add(global.text_data_en, "obj_papdate_378", "\E1넌 지금 옷을&입고 있잖아!!!/");
ds_map_add(global.text_data_en, "obj_papdate_379", "\E3그뿐만이 이냐.../");
ds_map_add(global.text_data_en, "obj_papdate_380", "\E1오늘 일찍부터^1,&너는 옷을 입고&있었어!/");
ds_map_add(global.text_data_en, "obj_papdate_381", "\F3 \E2 %");
ds_map_add(global.text_data_en, "obj_papdate_382", "아냐..^1.&그럴 리가???/");
ds_map_add(global.text_data_en, "obj_papdate_383", "\F0 \E1 %");
ds_map_add(global.text_data_en, "obj_papdate_386", "처음부터 나와&데이트를 하고&싶었다고!??/*");
ds_map_add(global.text_data_en, "obj_papdate_389", "처음부터 나하고&놀고 싶었단&말야!??/*");
ds_map_add(global.text_data_en, "obj_papdate_404", "                              &   그 래             아 니      &                            ");
ds_map_add(global.text_data_en, "obj_papdate_453", "이럴 수가!!/");
ds_map_add(global.text_data_en, "obj_papdate_454", "다 계획하고&있었어!!!/");
ds_map_add(global.text_data_en, "obj_papdate_457", "나보다 데이트를&훨씬 더 잘&하잖아!/");
ds_map_add(global.text_data_en, "obj_papdate_458", "\X아\E6-안 돼!!!&너의 \B데이트 파워\X가 ...!!!/%%");
ds_map_add(global.text_data_en, "obj_papdate_460", "나보다 노는 걸&훨씬 더 잘&하잖아!/");
ds_map_add(global.text_data_en, "obj_papdate_461", "\X아\E6-안 돼!!!&너의 \B우정 파워\X가 ...!!!/%%");
ds_map_add(global.text_data_en, "obj_papdate_465", "\E3그럼에도^1,&다른 날도 아닌 오늘&옷을 입기로 한 거야??/");
ds_map_add(global.text_data_en, "obj_papdate_468", "\E2너의 나를 향한&그 마음.../");
ds_map_add(global.text_data_en, "obj_papdate_469", "\X아\E6-안 돼!!!&너의 \B데이트 파워\X가 ...!!!/%%");
ds_map_add(global.text_data_en, "obj_papdate_470", "\E2너의 그 우정.../");
ds_map_add(global.text_data_en, "obj_papdate_471", "\X아\E6-안 돼!!!&너의 \B우정 파워\X가 ...!!!/%%");
ds_map_add(global.text_data_en, "obj_papdate_472", "\F3처음부터&예정된 거였나!?!?/");
ds_map_add(global.text_data_en, "obj_papdate_520", "녜헹!/");
ds_map_add(global.text_data_en, "obj_papdate_521", "녜 헤 헤!!!/%%");
ds_map_add(global.text_data_en, "obj_papdate_535", "\F0아직 나를&넘어섰다고&생각하진 마!/");
ds_map_add(global.text_data_en, "obj_papdate_536", "나^1, 이 위대한&파피루스 님은.../");
ds_map_add(global.text_data_en, "obj_papdate_539", "데이트에서&한 번도 진 적&없고^1, 앞으로도&안 질 거야!/");
ds_map_add(global.text_data_en, "obj_papdate_540", "누가 나한테&데이트 신청 할까봐&이야기하는 거야!!!/");
ds_map_add(global.text_data_en, "obj_papdate_541", "놀기에서&한 번도 진 적&없고^1, 앞으로도&안 질 거야!/");
ds_map_add(global.text_data_en, "obj_papdate_542", "누가 나하고&놀자고 할까봐&이야기하는 거야!/");
ds_map_add(global.text_data_en, "obj_papdate_543", "\E0너쯤은&손쉽게&따라잡을 수&있어!!/");
ds_map_add(global.text_data_en, "obj_papdate_544", "\E1나 역시도^1, 옷을^1,&입을 수 있다는&말씀!!!/");
ds_map_add(global.text_data_en, "obj_papdate_545", "\E3게다가. . ./");
ds_map_add(global.text_data_en, "obj_papdate_546", '\E1난 평상복 안에&내 "특별한" 옷을&늘 입고 다니지!!/');
ds_map_add(global.text_data_en, "obj_papdate_547", "\E0보시라!!/%%");
ds_map_add(global.text_data_en, "obj_papdate_573", "\E1녜헹!&나의 비밀스런&스타일이&어때!?!/*");
ds_map_add(global.text_data_en, "obj_papdate_586", "                              &   맘 에  든 다        안  든 다   &                            ");
ds_map_add(global.text_data_en, "obj_papdate_611", "\E6안 돼!!!/");
ds_map_add(global.text_data_en, "obj_papdate_614", "진심어린 칭찬...!!!/%%");
ds_map_add(global.text_data_en, "obj_papdate_618", "네 진심...^1!&네가 날 얼마나&생각하는지&알 것 같아!!!/%%");
ds_map_add(global.text_data_en, "obj_papdate_667", "\E3하지만.../");
ds_map_add(global.text_data_en, "obj_papdate_668", "\X넌\E0 이 옷의&\R숨겨진 힘\X을&제대로 이해&못 하고 있어!!!/");
ds_map_add(global.text_data_en, "obj_papdate_669", "\E3그러므로.../%%");
ds_map_add(global.text_data_en, "obj_papdate_679", "\E1네가 방금 한&말은 무효다!!!/");
ds_map_add(global.text_data_en, "obj_papdate_681", "데이트의&진전은&더 이상&없을 거야!!!/");
ds_map_add(global.text_data_en, "obj_papdate_683", "더 이상&같이 놀 수&없을 거야!!!/");
ds_map_add(global.text_data_en, "obj_papdate_684", "\X.\E7..네가 \R내 비밀\X을&찾아내지 못한다면&말이야!!/");
ds_map_add(global.text_data_en, "obj_papdate_685", "하지만 절대&못 찾을걸!!/%%");
ds_map_add(global.text_data_en, "obj_papdate_705", "* (움 직 여 서  \*Z를  눌 러  조 사 .)");
ds_map_add(global.text_data_en, "obj_papdate_721", "\E3내 모자...?/");
ds_map_add(global.text_data_en, "obj_papdate_722", "\E8내 모자./");
ds_map_add(global.text_data_en, "obj_papdate_723", "\E0내 모자!/");
ds_map_add(global.text_data_en, "obj_papdate_724", "녜 헤 헤!/%%");
ds_map_add(global.text_data_en, "obj_papdate_740", "그-그래..^1.&내 비밀을&찾았군!/");
ds_map_add(global.text_data_en, "obj_papdate_741", "선택의 여지가&없구만!/");
ds_map_add(global.text_data_en, "obj_papdate_742", "선물이야.../");
ds_map_add(global.text_data_en, "obj_papdate_743", "바-바로 널 위한&선물이-지!!!/");
ds_map_add(global.text_data_en, "obj_papdate_744", "어서^1!&열어 봐!/*");
ds_map_add(global.text_data_en, "obj_papdate_756", "                              &   연 다             안  연 다   &                            ");
ds_map_add(global.text_data_en, "obj_papdate_780", "\E2섬세한 포장을&망치고 싶지&않은 거야??/");
ds_map_add(global.text_data_en, "obj_papdate_781", "\E7아-안 돼..^1.&이 솜씨는!/");
ds_map_add(global.text_data_en, "obj_papdate_782", "\E6너무 강력해!/");
ds_map_add(global.text_data_en, "obj_papdate_783", "\E7반격이다^1!&내가 직접 선물을&열어줄 거야!!/%%");
ds_map_add(global.text_data_en, "obj_papdate_802", "\E0이게 뭔지&알아?/*");
ds_map_add(global.text_data_en, "obj_papdate_815", "                              &   당 연 하 지         모 르 겠 어  &                            ");
ds_map_add(global.text_data_en, "obj_papdate_842", '\E0 "스파게티"./');
ds_map_add(global.text_data_en, "obj_papdate_843", "\E3네가 생각하고&있는 게 그거지?&그치?/");
ds_map_add(global.text_data_en, "obj_papdate_844", "\E0맞아!/");
ds_map_add(global.text_data_en, "obj_papdate_845", "\E1그런데 아니기도 해!/%%");
ds_map_add(global.text_data_en, "obj_papdate_849", "\E0녜 헤 헤 헤 헤!!^1!&그래 맞아./");
ds_map_add(global.text_data_en, "obj_papdate_850", "전혀 모르겠지!/");
ds_map_add(global.text_data_en, "obj_papdate_851", "\E3이게 스파게티처럼&보일지는 몰라도.../%%");
ds_map_add(global.text_data_en, "obj_papdate_864", "\E1그저 평범한&파스타가 아니야!/");
ds_map_add(global.text_data_en, "obj_papdate_865", "\E0장인의&작품이라고!/");
ds_map_add(global.text_data_en, "obj_papdate_866", "\E3오크 통에서&잘 숙성된&비단결 같은&스파게티.../");
ds_map_add(global.text_data_en, "obj_papdate_867", "\E0그리고&마스터 셰프인^1,&파피루스 님께서&요리했지!/");
ds_map_add(global.text_data_en, "obj_papdate_868", "\E1인간이여!!^1!&끝을 낼&시간이다!!/");
ds_map_add(global.text_data_en, "obj_papdate_869", "더 이상&도망갈 곳은&없다!/");
ds_map_add(global.text_data_en, "obj_papdate_870", "이걸 먹어라^1!&나의 궁극의 오의!!!/*");
ds_map_add(global.text_data_en, "obj_papdate_885", "                              &   먹 는 다           거 절 한 다  &                            ");
ds_map_add(global.text_data_en, "obj_papdate_911", "* (한  입  조 금  먹 었 다 .)/");
ds_map_add(global.text_data_en, "obj_papdate_912", "* (얼 굴 이  반 사 적 으 로&  일 그 러 진 다 .)/");
ds_map_add(global.text_data_en, "obj_papdate_913", "* (형 용 할  수  없 는&  맛 이  난 다 ...)/%%");
ds_map_add(global.text_data_en, "obj_papdate_928", "\E0아주 열정이&가득한 반응이야!!!/");
ds_map_add(global.text_data_en, "obj_papdate_929", "\E3분명 내 요리를&좋아하는 게&틀림없어!/");
ds_map_add(global.text_data_en, "obj_papdate_930", "\E2그리고 무엇보다^1,&나도 좋아하고!!!/");
ds_map_add(global.text_data_en, "obj_papdate_931", "\E6내가 좋아하는&것보다도 훨씬 더!/%%");
ds_map_add(global.text_data_en, "obj_papdate_935", "\E3그건.../");
ds_map_add(global.text_data_en, "obj_papdate_936", "\E2내가 대신&먹으라는 소리야?/");
ds_map_add(global.text_data_en, "obj_papdate_937", "\E2내가 얼마나&파스타를 좋아하는지&알아서.../");
ds_map_add(global.text_data_en, "obj_papdate_938", "\E6그럴 리가 없어!^1!&내 선물을 받고서&나에게 다시&돌려주다니!/%%");
ds_map_add(global.text_data_en, "obj_papdate_948", "억!!^5!%%");
ds_map_add(global.text_data_en, "obj_papdate_967", "으어어억!!^5!%%");
ds_map_add(global.text_data_en, "obj_papdate_987", "안돼애애애애!!^4!%%");
ds_map_add(global.text_data_en, "obj_papdate_1021", "인 간^1.&모든 게 명확해졌어./");
ds_map_add(global.text_data_en, "obj_papdate_1022", "넌 나와&사랑에 빠진 거야./");
ds_map_add(global.text_data_en, "obj_papdate_1023", "네가 하는 모든 것^1.&네가 하는 모든 말./");
ds_map_add(global.text_data_en, "obj_papdate_1024", "모두 나를 위한 거였어./");
ds_map_add(global.text_data_en, "obj_papdate_1025", "인간^1. 나도 네가&행복해졌으면 좋겠어./");
ds_map_add(global.text_data_en, "obj_papdate_1026", "이제 내 기분을&말해 줄 거야./");
ds_map_add(global.text_data_en, "obj_papdate_1027", "이제 네게&말해 줄 거야./");
ds_map_add(global.text_data_en, "obj_papdate_1028", "나^1, 파피루스는.../%%");
ds_map_add(global.text_data_en, "obj_papdate_1032", "인 간^1.&모든 게 명확해졌어./");
ds_map_add(global.text_data_en, "obj_papdate_1033", "넌 내게&완전히 사로잡혔군./");
ds_map_add(global.text_data_en, "obj_papdate_1034", "네가 하는 모든 것^1.&네가 하는 모든 말./");
ds_map_add(global.text_data_en, "obj_papdate_1035", "모두 나를 위한 거였어./");
ds_map_add(global.text_data_en, "obj_papdate_1036", "인간^1. 나도 네가&행복해졌으면 좋겠어./");
ds_map_add(global.text_data_en, "obj_papdate_1037", "이제 내 기분을&말해 줄 거야./");
ds_map_add(global.text_data_en, "obj_papdate_1038", "이제 네게&말해 줄 거야./");
ds_map_add(global.text_data_en, "obj_papdate_1039", "\E8나^1, 파피루스는.../%%");
ds_map_add(global.text_data_en, "obj_papdate_1079", "나는.../");
ds_map_add(global.text_data_en, "obj_papdate_1080", "음.../");
ds_map_add(global.text_data_en, "obj_papdate_1081", "\E4어후^1, 여기 좀&덥지 않아^1, 아니면&나만 그런가??/");
ds_map_add(global.text_data_en, "obj_papdate_1082", "\E4.../");
ds_map_add(global.text_data_en, "obj_papdate_1083", "\E5이런^1, 젠장./");
ds_map_add(global.text_data_en, "obj_papdate_1084", "인간^1, 나는.../");
ds_map_add(global.text_data_en, "obj_papdate_1085", "미안해./");
ds_map_add(global.text_data_en, "obj_papdate_1086", "네가 그런 식으로&날 좋아하는 건&좋지 않아./");
ds_map_add(global.text_data_en, "obj_papdate_1087", "\E4내 말은 그러니까^1,&로맨틱하게./");
ds_map_add(global.text_data_en, "obj_papdate_1088", "\E6내 말은^1, 나도 진짜&노력해봤어!/");
ds_map_add(global.text_data_en, "obj_papdate_1089", "\E8네가 나한테&작업을 계속 걸어서.../");
ds_map_add(global.text_data_en, "obj_papdate_1090", "난 너랑 데이트를&해야만 한다고&생각했어./");
ds_map_add(global.text_data_en, "obj_papdate_1091", "\E0그리고^1, 데이트를 하면^1,&서로에 대한 연정이&피어날거라고!!!/");
ds_map_add(global.text_data_en, "obj_papdate_1092", "\E2나에게 너의 열정을&맞출 수 있을 줄&알았어!/");
ds_map_add(global.text_data_en, "obj_papdate_1093", "\E4하지만 하아..^1.&나^1, 위대한 파피루스 님은.../");
ds_map_add(global.text_data_en, "obj_papdate_1094", "\E5실패했어./");
ds_map_add(global.text_data_en, "obj_papdate_1095", "전과 같은&기분이야./");
ds_map_add(global.text_data_en, "obj_papdate_1096", "그리고 대신^1, 너와 데이트를&하면서.../");
ds_map_add(global.text_data_en, "obj_papdate_1097", "너를 더 깊게&끌어들이기만&했어.../");
ds_map_add(global.text_data_en, "obj_papdate_1098", "\E6나를 향한 너의&강렬한 사랑으로!/");
ds_map_add(global.text_data_en, "obj_papdate_1099", "\E5탈출할 수도 없는^1,&열정이란 어두운&감옥으로./");
ds_map_add(global.text_data_en, "obj_papdate_1100", "내 소중한 친구에게&어떻게 이런 짓을&해버린 거지...?/");
ds_map_add(global.text_data_en, "obj_papdate_1101", ".../");
ds_map_add(global.text_data_en, "obj_papdate_1102", "\E6아니야^1! 잠깐^1!&틀렸어!/");
ds_map_add(global.text_data_en, "obj_papdate_1103", "난 어떤 것도&실패하지 않아!!!/");
ds_map_add(global.text_data_en, "obj_papdate_1104", "\E1인간!!^1!&내가 널 이 괴로운&시간 속에서&구해주도록 하지!!!/");
ds_map_add(global.text_data_en, "obj_papdate_1105", "\E0너의 멋진 친구로&계속 남아줄게.../");
ds_map_add(global.text_data_en, "obj_papdate_1106", "\E8그리고 이 모든 일들이&일어나지 않았던&척 하고./");
ds_map_add(global.text_data_en, "obj_papdate_1107", "\E0어쨌든^1, 넌&정말 멋지니까./");
ds_map_add(global.text_data_en, "obj_papdate_1108", "\E5너와의 우정을 잃는 건&너무 비극적일 거야./");
ds_map_add(global.text_data_en, "obj_papdate_1109", "\E0그러니 제발.../");
ds_map_add(global.text_data_en, "obj_papdate_1110", "\E5너에게 키스를&안 해준다고 해서&울지는 말아줘./");
ds_map_add(global.text_data_en, "obj_papdate_1111", "\E4왜냐하면^1, 난&입술도 없거든./");
ds_map_add(global.text_data_en, "obj_papdate_1112", "\E0그리고 말야^1, 언젠간^1,&나만큼 굉장한 사람을&찾게 될 거야./");
ds_map_add(global.text_data_en, "obj_papdate_1113", "\E8음, 아니^1.&그건 아니겠지만./");
ds_map_add(global.text_data_en, "obj_papdate_1114", "\E0하지만 두 번째로 굉장한&사람을 찾는 걸&도와줄게!!!/");
ds_map_add(global.text_data_en, "obj_papdate_1115", "녜 헤 헤&헤 헤!!!/%%");
ds_map_add(global.text_data_en, "obj_papdate_1121", "\E8흐음.../");
ds_map_add(global.text_data_en, "obj_papdate_1122", "\E0뭐^1, 네가&날 아껴줘서&기분은 좋았어./");
ds_map_add(global.text_data_en, "obj_papdate_1123", "\E4하지만 조금은&진정하는 게 좋을지도...?/");
ds_map_add(global.text_data_en, "obj_papdate_1124", "\E0넌 정말&좋은 녀석이야./");
ds_map_add(global.text_data_en, "obj_papdate_1125", "우리가 친구라서&정말 다행이야./");
ds_map_add(global.text_data_en, "obj_papdate_1126", "\E8하지만^1, 나 말고&네 삶에 더&전념한다면,,,/");
ds_map_add(global.text_data_en, "obj_papdate_1127", "\E0네 잠재성의 최고치에&도달할 수 있을 것&같아./");
ds_map_add(global.text_data_en, "obj_papdate_1128", "\E8흐으음.../");
ds_map_add(global.text_data_en, "obj_papdate_1129", "\E0야^1, 나 어떻게&해야 할지 알겠어!!!/");
ds_map_add(global.text_data_en, "obj_papdate_1130", "내 상관인 언다인과&놀게 해 줘야겠다!!!/");
ds_map_add(global.text_data_en, "obj_papdate_1131", "내 생각에, 만약 네가&너의 친구 에너지를&더 분산시킨다면.../");
ds_map_add(global.text_data_en, "obj_papdate_1132", "더 건강한&생활 방식을&가지게 될 거야./");
ds_map_add(global.text_data_en, "obj_papdate_1133", "좋았어!!^1! 언다인과&친구가 되자!!!/");
ds_map_add(global.text_data_en, "obj_papdate_1134", "녜 헤 헤&헤 헤!!!/%%");
ds_map_add(global.text_data_en, "obj_papdate_1175", "아^1, 만약 나한테&연락하고 싶다면.../");
ds_map_add(global.text_data_en, "obj_papdate_1176", "\X여기 내 \R핸드폰 번호\X야./");
ds_map_add(global.text_data_en, "obj_papdate_1177", "언제든지 전화해도 좋아!/");
ds_map_add(global.text_data_en, "obj_papdate_1178", "\E4물론 플라토닉하게./");
ds_map_add(global.text_data_en, "obj_papdate_1179", "\E0그럼^1, 이제 갈게^1!&녜 헤 헤!/%%");
ds_map_add(global.text_data_en, "obj_papfridge_71", "아하^1!&내 음식 박물관에&관심이 가는 건가?/");
ds_map_add(global.text_data_en, "obj_papfridge_72", "자^1,&내 예술과 같은&작품을 감상해 봐./");
ds_map_add(global.text_data_en, "obj_papfridge_73", "\TS \F0 \T0 %");
ds_map_add(global.text_data_en, "obj_papfridge_74", '* (냉 장 고 의  절 반 은&  "스 파 게 티 "라 고  적 힌&  통 이  가 득  차  있 다 .)/');
ds_map_add(global.text_data_en, "obj_papfridge_75", "* (나 머 지  공 간 은  다  먹 은&  감 자 칩  봉 투 가&  우 겨 져  있 다 .)/%%");
ds_map_add(global.text_data_en, "obj_papfridge_77", "대단한 냉장고야^1,&그렇지?/%%");
ds_map_add(global.text_data_en, "obj_papfridge_81", '* (냉 장 고 의  절 반 은&  "스 파 게 티 "라 고  적 힌&  통 이  가 득  차  있 다 .)/');
ds_map_add(global.text_data_en, "obj_papfridge_82", "* (나 머 지  공 간 은  다  먹 은&  감 자 칩  봉 투 가&  우 겨 져  있 다 .)/%%");
ds_map_add(global.text_data_en, "obj_paphouse_entrance_91", "* (잠 겨 있 다 .)/%%");
ds_map_add(global.text_data_en, "obj_paphouse_entrance_96", "와^1, 나랑 엄청&데이트 하고&싶어하네.../");
ds_map_add(global.text_data_en, "obj_paphouse_entrance_97", "와^1, 너 진짜&놀고 싶구나.../");
ds_map_add(global.text_data_en, "obj_paphouse_entrance_98", "너 나 없이 내 집에&들어가려고 하고&있어!/");
ds_map_add(global.text_data_en, "obj_paphouse_entrance_99", "그거 정말&이상하잖아!!!/%%");
ds_map_add(global.text_data_en, "obj_paphouse_entrance_103", "* (열 려  있 다 .)/%%");
ds_map_add(global.text_data_en, "obj_papmailbox_74", "나를 위해 내 우편함을&확인해주다니 고마워./");
ds_map_add(global.text_data_en, "obj_papmailbox_75", "\E3아니^1, 잠깐만^1.&그건 엄청&이상하잖아./%%");
ds_map_add(global.text_data_en, "obj_papmailbox_78", "\E3내 빈 편지함&그만 봐/");
ds_map_add(global.text_data_en, "obj_papmailbox_79", "\E0내 공허함이라고^1,&네 것이 아니라/%%");
ds_map_add(global.text_data_en, "obj_papmailbox_96", "* 세 상 에 ^1!&* 파 피 루 스 에 게  가 는&  편 지 가  아 니 야 !/");
ds_map_add(global.text_data_en, "obj_papmailbox_98", "그래^1, 언다인이&제대로 말했네!/");
ds_map_add(global.text_data_en, "obj_papmailbox_99", "\E0왜 내게 대신&편지를 보내지&않았던 거지?/");
ds_map_add(global.text_data_en, "obj_papmailbox_101", "* 좋 아 ^1, 편 지 를  원 해 ?/");
ds_map_add(global.text_data_en, "obj_papmailbox_102", "* 한  통  써  주 도 록  하 지 !!!/");
ds_map_add(global.text_data_en, "obj_papmailbox_103", "\E6* F 통 보 서 다 !/");
ds_map_add(global.text_data_en, "obj_papmailbox_105", "안 돼!!!/");
ds_map_add(global.text_data_en, "obj_papmailbox_106", "\E3F가 무슨 뜻이야?/");
ds_map_add(global.text_data_en, "obj_papmailbox_108", "* 프 렌 드 !!!/%%");
ds_map_add(global.text_data_en, "obj_papsink_100", "인상적이지^1?&싱크대 높이를&좀 높였지./");
ds_map_add(global.text_data_en, "obj_papsink_101", "이제 아래에 뼈를&더 넣을 수 있어^1!&한번 보시라!/%%");
ds_map_add(global.text_data_en, "obj_papsink_106", "잊어버려./%%");
ds_map_add(global.text_data_en, "obj_papsink_111", "* (이  싱 크 대 는  너 무  높 아 서 ^1,&  손 조 차  닦 을  수  없 다 ...)/%%");
ds_map_add(global.text_data_en, "obj_papsink_234", "아닛!?!?/%%");
ds_map_add(global.text_data_en, "obj_papsink_244", "저 망할&개를 잡아!/%%");
ds_map_add(global.text_data_en, "obj_papsink_284", "젠장할!!!/%%");
ds_map_add(global.text_data_en, "obj_papsink_313", "샌즈 형!/");
ds_map_add(global.text_data_en, "obj_papsink_314", "이런 불쾌한 음악으로&내 삶을 오염시키지 마!!/%%");
ds_map_add(global.text_data_en, "obj_papstove_71", "* (스 토 브  안 에 는  텅  빈&  파 이  틀 이  들 어  있 다 .)/%%");
ds_map_add(global.text_data_en, "obj_papstove_75", "\E0우리 형은 항상&밖에서 식사를 해^1.&하지만.../");
ds_map_add(global.text_data_en, "obj_papstove_76", "\E3최근에^1, 무언가를&'굽기' 시작했어/");
ds_map_add(global.text_data_en, "obj_papstove_77", "그것은..^1.&키슈 같았어./");
ds_map_add(global.text_data_en, "obj_papstove_78", "하지만 달걀을&넣은 게 아닌^1, 뭔가&달달한 게 들어 있었어./");
ds_map_add(global.text_data_en, "obj_papstove_79", "\E0정말 이상하지!/%%");
ds_map_add(global.text_data_en, "obj_papstove_82", "* (스 토 브  안 에 는  텅  빈&  파 이  틀 이  들 어  있 다 .)/%%");
ds_map_add(global.text_data_en, "obj_paptrash_68", "* (당 신 은  쓰 레 기 통 을&  만 났 다 .)/%%");
ds_map_add(global.text_data_en, "obj_paptrash_72", "그건 쓰레기통이야./");
ds_map_add(global.text_data_en, "obj_paptrash_73", "언제든지&만나봐도 돼./%%");
ds_map_add(global.text_data_en, "obj_paptv_152", "\E0오, 이건 내가&제일 좋아하는&게임 쇼야!/");
ds_map_add(global.text_data_en, "obj_paptv_153", "\TS \F0 \T0 %");
ds_map_add(global.text_data_en, "obj_paptv_154", '* ("새  프 로 가  나 올  때 까 지&  채 널 을  고 정 해 주 세 요 - MTT."&  라 고  나 오 고  있 다 .)/');
ds_map_add(global.text_data_en, "obj_paptv_156", "\E1뭐야!!^1!&평소엔 이것보다&훨씬 더 나았어!/");
ds_map_add(global.text_data_en, "obj_paptv_157", "\E2이건 재미 없는&에피소드야!!^1!&이걸로 판단하지 마!!/%%");
ds_map_add(global.text_data_en, "obj_paptv_159", '* ("새  프 로 가  나 올  때 까 지&  채 널 을  고 정 해 주 세 요 - MTT."&  라 고  나 오 고  있 다 .)/%%');
ds_map_add(global.text_data_en, "obj_paptv_160", '* ("새  프 로 가  나 올  때 까 지&  채 널 을  고 정 해 주 세 요 - MTT."&  라 고  나 오 고  있 다 .)/%%');
ds_map_add(global.text_data_en, "obj_papyrus1_407", "그러니까^1, 내가&전에 언다인에 대해&말했던 것처럼,/%%");
ds_map_add(global.text_data_en, "obj_papyrus1_411", "\E2그러니까 샌즈 형^1!&언제 인간이 나타나는&거야?/");
ds_map_add(global.text_data_en, "obj_papyrus1_412", "\E3쫙 빼입은 모습&좀 보여주고&싶은데.../");
ds_map_add(global.text_data_en, "obj_papyrus1_413", "\E0아님 적어도&쭉 빼입은 모습이나./");
ds_map_add(global.text_data_en, "obj_papyrus1_415", "\E1* 너  입 을  게  그 거&  하 나 밖 에  없 지  않 아 ?/");
ds_map_add(global.text_data_en, "obj_papyrus1_417", "\E2응^1, 그래도&헤어 스타일 정도는&다듬을 수 있겠지!/");
ds_map_add(global.text_data_en, "obj_papyrus1_419", "\E0* 아 ^1, 그 래 ^1.&* 좋 은  생 각 이 네 ./");
ds_map_add(global.text_data_en, "obj_papyrus1_420", "\E1* 야 ^1, 저 기  한 번&  보 는  게  어 때 ?/%%");
ds_map_add(global.text_data_en, "obj_papyrus1_443", "샌즈 형!!&세상에!&저거.../");
ds_map_add(global.text_data_en, "obj_papyrus1_444", "인간이잖아!?!?&!??!?!/%%");
ds_map_add(global.text_data_en, "obj_papyrus1_453", "샌즈 형!!&세상에!&저거.../");
ds_map_add(global.text_data_en, "obj_papyrus1_454", "인간이잖아!?!?&!??!?!/");
ds_map_add(global.text_data_en, "obj_papyrus1_455", "게다가 어디선가&본 것 같아...!!!/%%");
ds_map_add(global.text_data_en, "obj_papyrus1_459", "\E0샌즈 형!!^1!&세상에!!!/");
ds_map_add(global.text_data_en, "obj_papyrus1_460", "\E3어지럽네^1.&내가 뭘 보고&있는 거지?/");
ds_map_add(global.text_data_en, "obj_papyrus1_462", "\E1* 봐 봐 ./%%");
ds_map_add(global.text_data_en, "obj_papyrus1_496", "* 어 .../");
ds_map_add(global.text_data_en, "obj_papyrus1_497", "\E1* 근 데 ^1, 저 건  그 냥&  돌  같 은 데 ./%%");
ds_map_add(global.text_data_en, "obj_papyrus1_500", "* 어 ..^1.&* 익 숙 하 게  생 긴  것&  같 은 데 ./");
ds_map_add(global.text_data_en, "obj_papyrus1_501", "\E1* 돌 이 라 서  그 런 가 ?/%%");
ds_map_add(global.text_data_en, "obj_papyrus1_509", "\E0세상에!!!/%%");
ds_map_add(global.text_data_en, "obj_papyrus1_532", "오^1./%%");
ds_map_add(global.text_data_en, "obj_papyrus1_534", "왜 돌을&쳐다보라고&하는 거야./%%");
ds_map_add(global.text_data_en, "obj_papyrus1_547", "* 야 ^1, 돌  앞 에&  있 는  저 게  뭘 까 ?/%%");
ds_map_add(global.text_data_en, "obj_papyrus1_567", "세상에!!!/%%");
ds_map_add(global.text_data_en, "obj_papyrus1_579", "(저거... 저거 인간인가.)/%%");
ds_map_add(global.text_data_en, "obj_papyrus1_581", "저게 뭔지 전혀&모르겠는데./%%");
ds_map_add(global.text_data_en, "obj_papyrus1_592", "(맞 아 .)/%%");
ds_map_add(global.text_data_en, "obj_papyrus1_594", "* 음 ^1.&* 돌 은  아 니 네 ./%%");
ds_map_add(global.text_data_en, "obj_papyrus1_607", "세상에!!!/");
ds_map_add(global.text_data_en, "obj_papyrus1_608", "샌즈 형!&내가 드디어&해냈어!!/");
ds_map_add(global.text_data_en, "obj_papyrus1_609", "언다인이 날.../");
ds_map_add(global.text_data_en, "obj_papyrus1_610", "난 이제.../");
ds_map_add(global.text_data_en, "obj_papyrus1_611", "정말로.../");
ds_map_add(global.text_data_en, "obj_papyrus1_612", "유명해질 거야!!^1!&유명해질 거야!!^1!&유명해질 거라고!!^1!/");
ds_map_add(global.text_data_en, "obj_papyrus1_613", "\E3..^1.'에헴'/");
ds_map_add(global.text_data_en, "obj_papyrus1_614", "\E1인간^1!&넌 이 구역을&지나갈 수 없다!/");
ds_map_add(global.text_data_en, "obj_papyrus1_615", "나^1, 위대한&파피루스 님께서^1,&널 막겠노라!!!/");
ds_map_add(global.text_data_en, "obj_papyrus1_616", "그러고 나서&널 사로잡겠다!/");
ds_map_add(global.text_data_en, "obj_papyrus1_617", "너는 수도로 이송될&것이다!/");
ds_map_add(global.text_data_en, "obj_papyrus1_618", "그리고..^1.&그리고!!^1!/");
ds_map_add(global.text_data_en, "obj_papyrus1_619", "\E3그 다음은 모르겠네./");
ds_map_add(global.text_data_en, "obj_papyrus1_620", "\E1어쨌든!/");
ds_map_add(global.text_data_en, "obj_papyrus1_621", "덤빌 자신 있다면...&오너라!!!/%%");
ds_map_add(global.text_data_en, "obj_papyrus1_624", "\E3돌이 아니야...?/");
ds_map_add(global.text_data_en, "obj_papyrus1_625", "\E0맙소사!!^1!&하나씩&지워가다보니!!!/");
ds_map_add(global.text_data_en, "obj_papyrus1_626", "\E0바로 인간이잖아!!!/");
ds_map_add(global.text_data_en, "obj_papyrus1_627", "\E3에헴!^1!&인간!!/");
ds_map_add(global.text_data_en, "obj_papyrus1_628", "\E4준비하시라!^1!&하이 개그를^1!&저질 개그를!/");
ds_map_add(global.text_data_en, "obj_papyrus1_629", "각종 위험^1!&퍼즐들^1!&장난들^1! 농담들!/");
ds_map_add(global.text_data_en, "obj_papyrus1_630", "잡혀서!^1!&다른 여러 재밌는&활동들도 하고./");
ds_map_add(global.text_data_en, "obj_papyrus1_631", "간단한 다과도&제공될 예정이다.../");
ds_map_add(global.text_data_en, "obj_papyrus1_632", "먹을 용기만&있다면 말이지!/%%");
ds_map_add(global.text_data_en, "obj_papyrus1_647", "녜 헤 헤&헤 헤 헤&헤 헤!!!/%%");
ds_map_add(global.text_data_en, "obj_papyrus1_667", "* 뭐 ^1, 어 떻 게 든&  잘  넘 어 갔 네 ./");
ds_map_add(global.text_data_en, "obj_papyrus1_668", "* 땀  빼 지  말 라 고 ^1,&  꼬 맹 이 ./");
ds_map_add(global.text_data_en, "obj_papyrus1_669", "\E2* 눈 구 멍 으 로  널  지 켜 보 고&  있 을  테 니 까 ./%%");
ds_map_add(global.text_data_en, "obj_papyrus1_672", "* ...이 렇 게  해 도  &  눈  하 나  깜 작&  안  하 네 ^1, 응 ?/%%");
ds_map_add(global.text_data_en, "obj_papyrus2_201", "정말&게으르군!!/");
ds_map_add(global.text_data_en, "obj_papyrus2_202", "형 밤새도록&낮잠잤잖아!!/");
ds_map_add(global.text_data_en, "obj_papyrus2_204", "* 내  생 각 에&  그 건  그 냥 .../");
ds_map_add(global.text_data_en, "obj_papyrus2_205", '\E1* "잠 "인  것  같 은 데 ./');
ds_map_add(global.text_data_en, "obj_papyrus2_207", "또 핑계야^1, 핑계!/%%");
ds_map_add(global.text_data_en, "obj_papyrus2_213", "하지만 정말로!!^1!&저 인간 말야!!!/");
ds_map_add(global.text_data_en, "obj_papyrus2_214", "\E2내가 저 사람을&알던가???/");
ds_map_add(global.text_data_en, "obj_papyrus2_216", "* 혹 시  네 가  누 굴  아 는 지 .../");
ds_map_add(global.text_data_en, "obj_papyrus2_217", "\E1* 모 르 는  거 야 ?/");
ds_map_add(global.text_data_en, "obj_papyrus2_219", "프 브 프 브 픕 픕 !/");
ds_map_add(global.text_data_en, "obj_papyrus2_220", "당연히 난 내가&아는 사람을&알고 있지!!/");
ds_map_add(global.text_data_en, "obj_papyrus2_221", "그저 형이 아는지&알고 싶었다구.../");
ds_map_add(global.text_data_en, "obj_papyrus2_222", "내가 누구를 아는지&알고 있는만큼 누군가를&알고 있는걸 알고 있다고!/");
ds_map_add(global.text_data_en, "obj_papyrus2_223", "\E2...알아들었어?/%%");
ds_map_add(global.text_data_en, "obj_papyrus2_256", "오-호^1!&인간이 왔다!/");
ds_map_add(global.text_data_en, "obj_papyrus2_259", "오-호^1!&호랑이도 제 말하면&온다더니!/");
ds_map_add(global.text_data_en, "obj_papyrus2_261", "너를&막기 위해서^1.../");
ds_map_add(global.text_data_en, "obj_papyrus2_262", "우리 형제가&몇 가지 퍼즐을&준비했지!/");
ds_map_add(global.text_data_en, "obj_papyrus2_263", "이걸 보게 된다면.../");
ds_map_add(global.text_data_en, "obj_papyrus2_264", "\E2꽤 놀라게 될 거야!!!/");
ds_map_add(global.text_data_en, "obj_papyrus2_265", "\E0보다시피^1,&이건 투명한.../");
ds_map_add(global.text_data_en, "obj_papyrus2_266", "전기 미로다!!!/");
ds_map_add(global.text_data_en, "obj_papyrus2_267", "이 미로의 벽을&건드릴 때마다,/");
ds_map_add(global.text_data_en, "obj_papyrus2_268", "이 공이 널 짜릿하게&만들어줄 거야!/");
ds_map_add(global.text_data_en, "obj_papyrus2_269", "\E2재밌어 보이지???/");
ds_map_add(global.text_data_en, "obj_papyrus2_270", "왜냐하면!/");
ds_map_add(global.text_data_en, "obj_papyrus2_271", "나아아중에&네가 놀면서&느낄 재미는,/");
ds_map_add(global.text_data_en, "obj_papyrus2_272", "\E3이에 비하면&발톱 때만 할 테니&말이야./");
ds_map_add(global.text_data_en, "obj_papyrus2_273", "\E0아^1, 이제&시작해봐도 좋아./%%");
ds_map_add(global.text_data_en, "obj_papyrus2_334", "샌즈 형!!^1!&무슨 짓을 한 거야!?!/%%");
ds_map_add(global.text_data_en, "obj_papyrus2_347", "* 내  생 각 엔  인 간 이&  공 을  들 고  있 어 야&  할  것  같 은 데 ./%%");
ds_map_add(global.text_data_en, "obj_papyrus2_359", "오^1, 그렇군./%%");
ds_map_add(global.text_data_en, "obj_papyrus2_396", "이 공을 받아 줘!!!/%%");
ds_map_add(global.text_data_en, "obj_papyrus2_430", "그래^1, 이제 해 봐!/%%");
ds_map_add(global.text_data_en, "obj_papyrus2_452", "\E1믿을 수가 없군!!!&이 미꾸라지 같은&녀석!!/");
ds_map_add(global.text_data_en, "obj_papyrus2_453", "\E3이걸 쉽게&풀어 버렸어..^1.&너무 쉽게 풀었어!/");
ds_map_add(global.text_data_en, "obj_papyrus2_454", "\E0하지만!!/");
ds_map_add(global.text_data_en, "obj_papyrus2_455", "다음 퍼즐은 쉽지&않을 거다!/");
ds_map_add(global.text_data_en, "obj_papyrus2_456", "우리 샌즈 형이^1,&설계했지!/");
ds_map_add(global.text_data_en, "obj_papyrus2_457", "확실히 어지러울 거야!/");
ds_map_add(global.text_data_en, "obj_papyrus2_458", "다 알아!&나도 어지럽거든!/");
ds_map_add(global.text_data_en, "obj_papyrus2_459", "녜 헤 헤&헤 헤!!/%%");
ds_map_add(global.text_data_en, "obj_papyrus2_506", "오-호^1!&인간이 왔다!/");
ds_map_add(global.text_data_en, "obj_papyrus2_507", "너를&막기 위해서^1.../");
ds_map_add(global.text_data_en, "obj_papyrus2_508", "우리 형제가&몇 가지 퍼즐을&준비했지!/");
ds_map_add(global.text_data_en, "obj_papyrus2_509", "이걸 보게 된다면.../");
ds_map_add(global.text_data_en, "obj_papyrus2_510", "\E2꽤 놀라게 될 거야!!!/");
ds_map_add(global.text_data_en, "obj_papyrus2_511", "\E5보다시피^1,&이건^1.&그^1, 보이지 않는.../%%");
ds_map_add(global.text_data_en, "obj_papyrus2_552", "\E5어어어어....?/");
ds_map_add(global.text_data_en, "obj_papyrus2_553", "\E3흠..^1. 문화 충격을&받은 모양이군./");
ds_map_add(global.text_data_en, "obj_papyrus2_554", "\E0내가^1, 온 곳에서는^1,&이게 전통이야./");
ds_map_add(global.text_data_en, "obj_papyrus2_555", "아무 이유 없이&끔찍한 퍼즐로&고통받는 것./");
ds_map_add(global.text_data_en, "obj_papyrus2_556", "\E5그러니까^1, 음^1,&그냥 다시 뒤로^1,&걸어가서.../");
ds_map_add(global.text_data_en, "obj_papyrus2_557", ".../%%");
ds_map_add(global.text_data_en, "obj_papyrus2_601", "\E3하아.../");
ds_map_add(global.text_data_en, "obj_papyrus2_602", "\E3우리는 왜 퍼즐을&좋아하는 인간을&못 잡는 거지???/%%");
ds_map_add(global.text_data_en, "obj_papyrus3_177", "인간!!^1!&준비는&되었나.../%%");
ds_map_add(global.text_data_en, "obj_papyrus3_200", "샌즈 형!^1!&퍼즐 어디 있어!!!/");
ds_map_add(global.text_data_en, "obj_papyrus3_202", "* 저 기 ^1.&* 땅  위 에 ./");
ds_map_add(global.text_data_en, "obj_papyrus3_203", "\E1* 믿 어 봐 ^1.&* 절 대  이 건&  통 과  못  해 ./%%");
ds_map_add(global.text_data_en, "obj_papyrus3_206", "\E1* 믿 어 봐 ^1.&* 절 대  이 건&  못  지 나 칠 걸 ./%%");
ds_map_add(global.text_data_en, "obj_papyrus3_245", "뭐야!!^1!&지나치지&않았잖아!?!?/");
ds_map_add(global.text_data_en, "obj_papyrus3_247", "* 말 했 잖 아 ^1.&* 모 든  사 람 은&  단 어  찾 기 를  좋 아 해 ./");
ds_map_add(global.text_data_en, "obj_papyrus3_249", "세상에!!!/");
ds_map_add(global.text_data_en, "obj_papyrus3_250", "이런 환경에선&일할 수 없어!!/%%");
ds_map_add(global.text_data_en, "obj_papyrus3_254", "샌즈 형!!^1!&아무 일도 일어나지&않았잖아!!!/");
ds_map_add(global.text_data_en, "obj_papyrus3_256", "* 어 이 쿠 ./");
ds_map_add(global.text_data_en, "obj_papyrus3_257", "\E2* 아 무 래 도  어 린 이 용&  끝 말 잇 기 를  대 신&  둘  걸  그 랬 다 ./");
ds_map_add(global.text_data_en, "obj_papyrus3_259", "뭐라고?!^1?&어린이용 끝말잇기!?/");
ds_map_add(global.text_data_en, "obj_papyrus3_260", "\E0마침내^1, 우리가&둘 다 납득할 수 있는&것이로군./%%");
ds_map_add(global.text_data_en, "obj_papyrus4_209", "어이!/");
ds_map_add(global.text_data_en, "obj_papyrus4_210", "인간이다!/");
ds_map_add(global.text_data_en, "obj_papyrus4_211", "\E0이 퍼즐은 정말 맘에&쏙 들 거야!/");
ds_map_add(global.text_data_en, "obj_papyrus4_212", "이걸 만든 사람은&바로 그 위대한.../%%");
ds_map_add(global.text_data_en, "obj_papyrus4_405", "\E3...너&진심이야?/");
ds_map_add(global.text_data_en, "obj_papyrus4_406", "\E1샌즈 형!!^1!&도와줘!!!/");
ds_map_add(global.text_data_en, "obj_papyrus4_407", "내 퍼즐 위로 계속&걸어다니고 있어!/");
ds_map_add(global.text_data_en, "obj_papyrus4_408", "\E3먼저 내가&설명해줘야 한다구./");
ds_map_add(global.text_data_en, "obj_papyrus4_409", "\E0그리고 위험한 농담으로&쟤를 겁주고 당황하게&만들었어야 한단 말야/");
ds_map_add(global.text_data_en, "obj_papyrus4_411", "* 뭐 ^1, 아 마  농 담 을&  안  좋 아 하 나  보 지 ./");
ds_map_add(global.text_data_en, "obj_papyrus4_413", "모두가 농담을&좋아한다고!!!/");
ds_map_add(global.text_data_en, "obj_papyrus4_415", "* 언 다 인 은  어 때 ^1?&* 걔 는  퍼 즐&  싫 어 하 지  않 아 ?/");
ds_map_add(global.text_data_en, "obj_papyrus4_417", "퍼즐은 싫어하지^1.&하지만 농담은&좋아해./");
ds_map_add(global.text_data_en, "obj_papyrus4_419", "* 뭐 , 그 거  말  되 네 ./");
ds_map_add(global.text_data_en, "obj_papyrus4_421", "인간!^1!&넌 어떻게 생각하지!?/");
ds_map_add(global.text_data_en, "obj_papyrus4_422", "퍼즐이냐 농담이냐?/");
ds_map_add(global.text_data_en, "obj_papyrus4_423", ".../");
ds_map_add(global.text_data_en, "obj_papyrus4_424", "\E3.../");
ds_map_add(global.text_data_en, "obj_papyrus4_425", "좋아^1, 여기가&보통은 중요한&부분이지./");
ds_map_add(global.text_data_en, "obj_papyrus4_426", "네가 동의하거나&반대하거나./");
ds_map_add(global.text_data_en, "obj_papyrus4_427", "그리고&네 대답에 따라./");
ds_map_add(global.text_data_en, "obj_papyrus4_428", "\E0그에 대한 대답으로&우리가 멋진 말을&해 주는 거야./");
ds_map_add(global.text_data_en, "obj_papyrus4_429", "\E3.../");
ds_map_add(global.text_data_en, "obj_papyrus4_430", "\E0에이^1, 이 퍼즐&혼자 풀어보는게&어때./%%");
ds_map_add(global.text_data_en, "obj_papyrus5_209", "인간!/");
ds_map_add(global.text_data_en, "obj_papyrus5_210", "\E3흐으음..^1.&이걸 뭐라고&해야 할지.../");
ds_map_add(global.text_data_en, "obj_papyrus5_211", "\E0너 여기까지 오는 데&시간이 엄청 오래&걸리더라^1, 그래서.../");
ds_map_add(global.text_data_en, "obj_papyrus5_212", "그동안 이 퍼즐을 조금&발전시키기로 했지.../");
ds_map_add(global.text_data_en, "obj_papyrus5_213", "이 눈의 위치를 조금&바꿔서 내 얼굴처럼&보이도록 말이야./");
ds_map_add(global.text_data_en, "obj_papyrus5_214", "\E3근데 안타깝게도^1,&눈이 바닥에서&얼어버렸어./");
ds_map_add(global.text_data_en, "obj_papyrus5_215", "\E1이제 해답이&달라졌지!/");
ds_map_add(global.text_data_en, "obj_papyrus5_216", "그리고^1, 여느 때처럼^1,&내 게으른 형은 또&어딘가로 사라졌어./");
ds_map_add(global.text_data_en, "obj_papyrus5_217", "\E3그러니까&내가 하려던 말은.../");
ds_map_add(global.text_data_en, "obj_papyrus5_218", "\E0걱정하지 마라^1,&인간이여!/");
ds_map_add(global.text_data_en, "obj_papyrus5_219", "바로 나^1, 위대한&파피루스 님이^1, 이 난제를&풀어주도록 하마!/");
ds_map_add(global.text_data_en, "obj_papyrus5_220", "그럼 우리 둘 다&전진할 수 있겠지!/");
ds_map_add(global.text_data_en, "obj_papyrus5_221", "그동안^1, 마음껏&혼자서 퍼즐을&풀어보도록!/");
ds_map_add(global.text_data_en, "obj_papyrus5_222", "나도 답을&알려주려고 하진&않을 테니까!!!/%%");
ds_map_add(global.text_data_en, "obj_papyrus5_281", "와우!!^1!&너 풀었잖아!!/");
ds_map_add(global.text_data_en, "obj_papyrus5_282", "내 도움조차&필요로 하지 않고&해냈어.../");
ds_map_add(global.text_data_en, "obj_papyrus5_283", "내 조언이 먹혔잖아^1!&정말로 네게&도움이 됐어!/");
ds_map_add(global.text_data_en, "obj_papyrus5_289", "엄청난데^1!&감명받았어!!/");
ds_map_add(global.text_data_en, "obj_papyrus5_290", "나처럼 퍼즐을&아주 아끼는 게&틀림없어!/");
ds_map_add(global.text_data_en, "obj_papyrus5_291", "음^1, 그럼 다음 퍼즐&역시 아주 좋아할 게&확실하군!/");
ds_map_add(global.text_data_en, "obj_papyrus5_292", "심지어 너한텐&너무 쉬울 수도&있겠어!!/");
ds_map_add(global.text_data_en, "obj_papyrus5_293", "녜^1!&헤 헤^1!&헤헤헤!!!/%%");
ds_map_add(global.text_data_en, "obj_papyrus6_138", "인간!/%%");
ds_map_add(global.text_data_en, "obj_papyrus7_156", "인간!/");
ds_map_add(global.text_data_en, "obj_papyrus7_157", "네가 겪을&마지막이자 가장&위험한 도전이다!/");
ds_map_add(global.text_data_en, "obj_papyrus7_158", "기대하시라^1!&충격과 공포의&죽음의 시련!/%%");
ds_map_add(global.text_data_en, "obj_papyrus7_194", "내가 명령을&내리면^1, 모든 게&작동할 거야!!!/");
ds_map_add(global.text_data_en, "obj_papyrus7_195", "대포가 발사되고^1!&가시가 휘날리고^1!&칼날이 썰어버리지^1!/");
ds_map_add(global.text_data_en, "obj_papyrus7_196", "모든 것들이 맹렬하게&위 아래로 요동칠&것이다!/");
ds_map_add(global.text_data_en, "obj_papyrus7_197", "살아남을 확률은&희박하다!!!/");
ds_map_add(global.text_data_en, "obj_papyrus7_198", "준비됐나!?/");
ds_map_add(global.text_data_en, "obj_papyrus7_199", "왜냐하면!/");
ds_map_add(global.text_data_en, "obj_papyrus7_200", "바로!/");
ds_map_add(global.text_data_en, "obj_papyrus7_201", "지금!/");
ds_map_add(global.text_data_en, "obj_papyrus7_202", "당장!/");
ds_map_add(global.text_data_en, "obj_papyrus7_203", "시작할 거니까!/%%");
ds_map_add(global.text_data_en, "obj_papyrus7_221", " %");
ds_map_add(global.text_data_en, "obj_papyrus7_222", "* 그 래 ^1?&* 그 럼  뭘  기 다 리 고&  있 는  거 야 ?/");
ds_map_add(global.text_data_en, "obj_papyrus7_224", "기다린다고!^1?&기다린다니!?/");
ds_map_add(global.text_data_en, "obj_papyrus7_225", "지금..^1.&지금 작동시키겠다!/%%");
ds_map_add(global.text_data_en, "obj_papyrus7_244", " %");
ds_map_add(global.text_data_en, "obj_papyrus7_245", "* 저 거 ^1, 어 ^1, 딱 히&  작 동 된  것 처 럼&  보 이 진  않 는 데 ./");
ds_map_add(global.text_data_en, "obj_papyrus7_247", "그래!!!/");
ds_map_add(global.text_data_en, "obj_papyrus7_248", "이 시련은!!!/");
ds_map_add(global.text_data_en, "obj_papyrus7_249", "\E3아마도.../");
ds_map_add(global.text_data_en, "obj_papyrus7_250", "아마..^1. 이걸로&인간을 꺾는 건 너무&쉬울 것 같아./");
ds_map_add(global.text_data_en, "obj_papyrus7_251", "\E1그래^1!&이걸 사용할&순 없어!!!/");
ds_map_add(global.text_data_en, "obj_papyrus7_252", "난 공정한&뼈다귀라고!!!/");
ds_map_add(global.text_data_en, "obj_papyrus7_253", "내 퍼즐은&정정당당해!/");
ds_map_add(global.text_data_en, "obj_papyrus7_254", "함정도 장인의 솜씨로&설계되었단 말야!/");
ds_map_add(global.text_data_en, "obj_papyrus7_255", "근데 이 방법은&너무 단도직입적이야^1!&품격없어!/");
ds_map_add(global.text_data_en, "obj_papyrus7_256", "\E0치워버릴 거야!/%%");
ds_map_add(global.text_data_en, "obj_papyrus7_260", "그래!!!/");
ds_map_add(global.text_data_en, "obj_papyrus7_261", "\E3...또 그냥&지나가겠지./");
ds_map_add(global.text_data_en, "obj_papyrus7_262", "그럼 또 재미라곤&하나도 없을 거야./");
ds_map_add(global.text_data_en, "obj_papyrus7_264", "* 흠 ...&* 그 래 서  인 간  어 쩌 구 는 ^1,&  말 짱  꽝 인 건 가 ?/");
ds_map_add(global.text_data_en, "obj_papyrus7_266", "아니^1. 그러니까^1.&붙잡는 건 정말&즐거운 일이지/");
ds_map_add(global.text_data_en, "obj_papyrus7_267", "\E0유명한 왕실 근위대의&일원이 될 수&있으니까!!!/");
ds_map_add(global.text_data_en, "obj_papyrus7_268", "\E3그런데 이&퍼즐들 갖고 시간을&보낼 때마다.../");
ds_map_add(global.text_data_en, "obj_papyrus7_269", "무슨 생일 파티&준비하는 기분이나&들고.../");
ds_map_add(global.text_data_en, "obj_papyrus7_271", "* 함 정 이 랑  불 길  없 는 ?/");
ds_map_add(global.text_data_en, "obj_papyrus7_273", "바로 그거야!^1!&무의미해!!!/");
ds_map_add(global.text_data_en, "obj_papyrus7_274", "\E3아무래도 형처럼&게으름이나 피우는 게&맞았나 봐./");
ds_map_add(global.text_data_en, "obj_papyrus7_276", "* 뭐 ^1?&* 내 가  옳 았 다 고 ^1?&* 정 말 로 ?/");
ds_map_add(global.text_data_en, "obj_papyrus7_278", ".../");
ds_map_add(global.text_data_en, "obj_papyrus7_279", "\E0아니!^1!&내가 지금 돌았나!/");
ds_map_add(global.text_data_en, "obj_papyrus7_280", "형은 아직도&완전히 잘못됐어!/");
ds_map_add(global.text_data_en, "obj_papyrus7_281", "그냥 오늘의 관객이&이상할 뿐이야!/");
ds_map_add(global.text_data_en, "obj_papyrus7_282", "언다인이라면&신나게 놀고 있었을&거라고!/");
ds_map_add(global.text_data_en, "obj_papyrus7_283", "화염^1, 폭력^1.&전부 언다인&취향이잖아!/");
ds_map_add(global.text_data_en, "obj_papyrus7_284", "그러니 난 너에게&더 이상 퍼즐을&허비하지 않을 거야./");
ds_map_add(global.text_data_en, "obj_papyrus7_285", "난 그냥.../");
ds_map_add(global.text_data_en, "obj_papyrus7_286", "내가 가진 친구들로&만족하겠어!!!/%%");
ds_map_add(global.text_data_en, "obj_papyrus7_316", "휴!/%%");
ds_map_add(global.text_data_en, "obj_papyrus7_333", "뭘 보고&있는 거야!?/");
ds_map_add(global.text_data_en, "obj_papyrus7_334", "이번에도&파피루스의 간사한&1승 추가다!!/");
ds_map_add(global.text_data_en, "obj_papyrus7_335", "녜!!/");
ds_map_add(global.text_data_en, "obj_papyrus7_336", "헤!!/");
ds_map_add(global.text_data_en, "obj_papyrus7_337", ".../");
ds_map_add(global.text_data_en, "obj_papyrus7_338", "\E3헤???/%%");
ds_map_add(global.text_data_en, "obj_papyrus7_341", "값진 인생&교훈이라고!/");
ds_map_add(global.text_data_en, "obj_papyrus7_342", "녜 헤 헤!!!/%%");
ds_map_add(global.text_data_en, "obj_papyrus8_184", "인간./");
ds_map_add(global.text_data_en, "obj_papyrus8_185", "복잡한 감정에 대한&이야기를 들려주겠어./");
ds_map_add(global.text_data_en, "obj_papyrus8_188", "어째선지^1, 난 네가&내 오랜 친구처럼&느껴져.../");
ds_map_add(global.text_data_en, "obj_papyrus8_189", "널 한 번도&본 적이 없는데도!!/");
ds_map_add(global.text_data_en, "obj_papyrus8_190", "왜 이런 감정을&느끼는지는&알 수가 없어.../");
ds_map_add(global.text_data_en, "obj_papyrus8_191", "인터넷에서 봤나???/");
ds_map_add(global.text_data_en, "obj_papyrus8_192", '난 "소셜 미디어&인맥"이 꽤 넓거든./');
ds_map_add(global.text_data_en, "obj_papyrus8_193", "전부 다 신경써주기&힘들어./");
ds_map_add(global.text_data_en, "obj_papyrus8_194", "10명 정도만^1,&더 있으면.../");
ds_map_add(global.text_data_en, "obj_papyrus8_195", "드디어 두 자릿수에&도달하게 될 거야!!!/");
ds_map_add(global.text_data_en, "obj_papyrus8_196", "...어 ^1, &잠깐만!/");
ds_map_add(global.text_data_en, "obj_papyrus8_197", "넌 내 친구가&되면 안 되지!!^1!&넌 인간이잖아!/");
ds_map_add(global.text_data_en, "obj_papyrus8_198", "날 속여서 공격을&포기하게 하다니&믿을 수가 없군!!/");
ds_map_add(global.text_data_en, "obj_papyrus8_199", "이런 이런!/%%");
ds_map_add(global.text_data_en, "obj_papyrus8_202", "예를 들면.../");
ds_map_add(global.text_data_en, "obj_papyrus8_203", "또 다른&파스타 매니아를&찾게 된 기쁨./");
ds_map_add(global.text_data_en, "obj_papyrus8_204", "다른 이의&퍼즐 푸는 실력에&대한 동경./");
ds_map_add(global.text_data_en, "obj_papyrus8_205", "멋지고 똑똑한 사람에게&네가 멋지단 생각을&심어주고픈 욕망./");
ds_map_add(global.text_data_en, "obj_papyrus8_206", "이 감정들.../");
ds_map_add(global.text_data_en, "obj_papyrus8_207", "분명히 지금 네가&느끼고 있는&감정들이겠지!!!/");
ds_map_add(global.text_data_en, "obj_papyrus8_208", "그런 감정이라니&어떤 느낌일지 나로서는&상상도 못하겠군./");
ds_map_add(global.text_data_en, "obj_papyrus8_209", "그래^1, 난 엄청&위대하니까./");
ds_map_add(global.text_data_en, "obj_papyrus8_210", "친구들이 많다는 게&어떤 기분인지&궁금했던 적도 없으니./");
ds_map_add(global.text_data_en, "obj_papyrus8_211", "널 동정하마..^1.&외로운 인간.../");
ds_map_add(global.text_data_en, "obj_papyrus8_212", "걱정하진 마시라!!^1!&더 이상은 외롭지&않을 것이다!/");
ds_map_add(global.text_data_en, "obj_papyrus8_213", "나^1, 위대한&파피루스 님이^1,&너의.../");
ds_map_add(global.text_data_en, "obj_papyrus8_214", " ^2.^2../");
ds_map_add(global.text_data_en, "obj_papyrus8_215", "아니야.../");
ds_map_add(global.text_data_en, "obj_papyrus8_216", "아니야^1, 이건 전부&다 잘못됐어!/");
ds_map_add(global.text_data_en, "obj_papyrus8_217", "난 네 친구가&될 수 없어!!/");
ds_map_add(global.text_data_en, "obj_papyrus8_218", "넌 인간이잖아!/");
ds_map_add(global.text_data_en, "obj_papyrus8_219", "널 꼭 잡아야만&한다고!!!/");
ds_map_add(global.text_data_en, "obj_papyrus8_220", "그리고^1, 마침내&내 꿈을 완전히&이루게 되는 거야!!!!/");
ds_map_add(global.text_data_en, "obj_papyrus8_221", "힘^1!&인기^1!&명예!/");
ds_map_add(global.text_data_en, "obj_papyrus8_222", "바로 나 파피루스!!!/");
ds_map_add(global.text_data_en, "obj_papyrus8_223", "왕실 근위대의.../");
ds_map_add(global.text_data_en, "obj_papyrus8_224", "새로운 멤버로서!/%%");
ds_map_add(global.text_data_en, "obj_papyrus8_227", "어..^1.&그 인간이&어디 갔을까./");
ds_map_add(global.text_data_en, "obj_papyrus8_228", "...잠깐만..^1.&바로 내 앞에&있잖아!!!/");
ds_map_add(global.text_data_en, "obj_papyrus8_229", "안녕^1!&네가 길 잃은 줄&알고 걱정했었어!/");
ds_map_add(global.text_data_en, "obj_papyrus8_230", "여기 있는 걸&보니 참 안심이군.../");
ds_map_add(global.text_data_en, "obj_papyrus8_231", "...잠깐만 기다려!!!/");
ds_map_add(global.text_data_en, "obj_papyrus8_232", "넌 탈출하면&안 되는 거잖아!!!/");
ds_map_add(global.text_data_en, "obj_papyrus8_233", "돌아가!!!/%%");
ds_map_add(global.text_data_en, "obj_papyrus8_237", "결국 내가 말한&것들이 전부&들어맞는군./");
ds_map_add(global.text_data_en, "obj_papyrus8_238", "우린 정말로&서로 이어진&운명이었어./");
ds_map_add(global.text_data_en, "obj_papyrus8_239", "마치 두 뼈가&접합될 운명처럼!!!/");
ds_map_add(global.text_data_en, "obj_papyrus8_240", "그래, 지금 여기&나타났다는 거지./");
ds_map_add(global.text_data_en, "obj_papyrus8_241", "어차피 여기서&탈출하는 건 아주&불가능하지만 말야./");
ds_map_add(global.text_data_en, "obj_papyrus8_242", "놀라워!!!/");
ds_map_add(global.text_data_en, "obj_papyrus8_243", "나 진심으로.../");
ds_map_add(global.text_data_en, "obj_papyrus8_244", "자아아아아암깐!!/");
ds_map_add(global.text_data_en, "obj_papyrus8_245", "나 그래도&너 잡아야&된다니까!!!/");
ds_map_add(global.text_data_en, "obj_papyrus8_246", "이런-저런!/%%");
ds_map_add(global.text_data_en, "obj_papyrus8_252", "다시 돌아왔구만^1, 흠?/");
ds_map_add(global.text_data_en, "obj_papyrus8_253", "아마 내 잘못인 것&같네.../");
ds_map_add(global.text_data_en, "obj_papyrus8_254", "네게 스파게티를&만들어줄 거라고&말해줬었는데./");
ds_map_add(global.text_data_en, "obj_papyrus8_255", "내가 보고 싶어지는 건&아주 자연스러운 일이지.../");
ds_map_add(global.text_data_en, "obj_papyrus8_256", "스파게티를 만들어주리란&간절한 소망을 지닌&채로./");
ds_map_add(global.text_data_en, "obj_papyrus8_257", "뭐..^1. 난 이해해./");
ds_map_add(global.text_data_en, "obj_papyrus8_258", "파피루스^1,&역시 배가 고프다고!/");
ds_map_add(global.text_data_en, "obj_papyrus8_259", "정의가 고프지!/%%");
ds_map_add(global.text_data_en, "obj_papyrus8_271", "멈춰라^1, 인간!/%%");
ds_map_add(global.text_data_en, "obj_papyrus8_386", "난 결코 거시기한&녀석이 아냐!/%%");
ds_map_add(global.text_data_en, "obj_papyrus8_414", "\E1아^1, 깜빡 잊고&말 못할 뻔했군.../");
ds_map_add(global.text_data_en, "obj_papyrus8_415", "출구로 가려면^1,&너는.../");
ds_map_add(global.text_data_en, "obj_papyrus8_416", "\W바로\Y 왕\W의 성을&지나가야 해./");
ds_map_add(global.text_data_en, "obj_papyrus8_419", "출구로 가려면^1,&너는.../");
ds_map_add(global.text_data_en, "obj_papyrus8_420", "왕을 만나야 해./");
ds_map_add(global.text_data_en, "obj_papyrus8_422", "\Y모든 괴물들의 왕.../");
ds_map_add(global.text_data_en, "obj_papyrus8_423", "그는.../");
ds_map_add(global.text_data_en, "obj_papyrus8_424", "...음.../%%");
ds_map_add(global.text_data_en, "obj_papyrus8_441", "\E0그냥 만만한&털뭉치 덩어리야!!!/");
ds_map_add(global.text_data_en, "obj_papyrus8_442", "다들 그분을&좋아하지./");
ds_map_add(global.text_data_en, "obj_papyrus8_443", "그냥 네가&이렇게.../");
ds_map_add(global.text_data_en, "obj_papyrus8_444", "실례합니다^1, 드리무어 씨..^1.&집에 가도 되나요?&라고 하기만 하면.../");
ds_map_add(global.text_data_en, "obj_papyrus8_445", "아마 알아서&널 결계까지&데려다 줄걸!/");
ds_map_add(global.text_data_en, "obj_papyrus8_446", "아무튼!!^1!&잡담은 각설하고!!!/");
ds_map_add(global.text_data_en, "obj_papyrus8_447", "나는 집에서&멋진 친구가 될&준비를 하고 있을게!!!/");
ds_map_add(global.text_data_en, "obj_papyrus8_448", "언제든지&놀러 올 수&있도록!!/");
ds_map_add(global.text_data_en, "obj_papyrus8_449", "놀러와서&데이트도&즐기도록!/");
ds_map_add(global.text_data_en, "obj_papyrus8_450", "녜 헤 헤 헤&헤 헤 헤!!!/%%");
ds_map_add(global.text_data_en, "obj_papyrus8_515", "야^1, 내가 말하고&있으면 움직이지&좀 마!/");
ds_map_add(global.text_data_en, "obj_papyrus8_516", "나^1,&위대한 파피루스 님께서^1,&할 말이 있노라./");
ds_map_add(global.text_data_en, "obj_papyrus8_517", "첫 번째로^1 넌 진짜&이상한 놈이야!/");
ds_map_add(global.text_data_en, "obj_papyrus8_518", "퍼즐을 싫어할&뿐만 아니라./");
ds_map_add(global.text_data_en, "obj_papyrus8_519", "네가 여기저기&돌아다니면서&하는 일.../");
ds_map_add(global.text_data_en, "obj_papyrus8_520", "먼지투성이인&네 손까지 말야./");
ds_map_add(global.text_data_en, "obj_papyrus8_521", "마치.../");
ds_map_add(global.text_data_en, "obj_papyrus8_522", "네가 위험한 길로&빠져들고 있는 것&같단 말이지./");
ds_map_add(global.text_data_en, "obj_papyrus8_523", "하지만!/");
ds_map_add(global.text_data_en, "obj_papyrus8_524", "나^1, 위대한 파피루스 님은^1,&너에게서 엄청난&가능성을 보았노라!/");
ds_map_add(global.text_data_en, "obj_papyrus8_525", "노력만 한다면&모두 훌륭한 사람이&될 수 있어!/");
ds_map_add(global.text_data_en, "obj_papyrus8_526", "나로 말하자면^1,&난 별 노력 없이도&가능하지!!!/");
ds_map_add(global.text_data_en, "obj_papyrus8_527", "녜 헤 헤&헤 헤 헤!!!/%%");
ds_map_add(global.text_data_en, "obj_papyrus8_555", "야^1, 그만 움직여!/");
ds_map_add(global.text_data_en, "obj_papyrus8_556", "방금 그렇게&말 했잖아!/");
ds_map_add(global.text_data_en, "obj_papyrus8_557", "인간! 아무래도&너는 교육이&필요한 것 같다!/");
ds_map_add(global.text_data_en, "obj_papyrus8_558", "누군가가 널&똑바른 길로 가게끔&만들어야겠군!!/");
ds_map_add(global.text_data_en, "obj_papyrus8_559", "하지만 걱정 말라!&나^1, 파피루스 님께서.../");
ds_map_add(global.text_data_en, "obj_papyrus8_560", "기쁘게 네 친구이자&선생님이 되어줄 테니&말이다!!!/");
ds_map_add(global.text_data_en, "obj_papyrus8_561", "네 삶을 똑바로&바로잡아주마!!!/%%");
ds_map_add(global.text_data_en, "obj_papyrus8_590", "다가오고 있군./");
ds_map_add(global.text_data_en, "obj_papyrus8_591", "받아들인다는&의미의 포옹인가?/");
ds_map_add(global.text_data_en, "obj_papyrus8_592", "세에상에!^1!  벌써&내 가르침이 효과가&보이잖아!!/");
ds_map_add(global.text_data_en, "obj_papyrus8_593", "나^1, 파피루스는^1,&널 두 팔 벌려&환영하노라!/%%");
ds_map_add(global.text_data_en, "obj_papyrus_friendc_76", "\E3그러니까^1, 아스고어.../");
ds_map_add(global.text_data_en, "obj_papyrus_friendc_77", "\E0절 왕실 근위병으로&만들어 주시는 건&어때요?/");
ds_map_add(global.text_data_en, "obj_papyrus_friendc_79", "\E2* 음 ^1, 파 피 루 스 ^1.&  이 제  전 쟁 은  끝 났 으 니 .../");
ds_map_add(global.text_data_en, "obj_papyrus_friendc_80", "\E0* 더  이 상  왕 실  근 위 대 는&  필 요 하 지  않 단 다 ./");
ds_map_add(global.text_data_en, "obj_papyrus_friendc_82", "\E7네!?/");
ds_map_add(global.text_data_en, "obj_papyrus_friendc_83", "\E1그럼 인간의 모험은&무슨 의미가 있는 거죠!?/");
ds_map_add(global.text_data_en, "obj_papyrus_friendc_84", "\E3그 길고 긴&여정을 해 왔는데.../");
ds_map_add(global.text_data_en, "obj_papyrus_friendc_85", "\E4난 아직도&왕실 근위병이&아니라니!?/");
ds_map_add(global.text_data_en, "obj_papyrus_friendc_86", "\E0정말^1, 이건&최악의 엔딩이야./%%");
ds_map_add(global.text_data_en, "obj_papyrus_friendc_91", "\E3모험을 망쳐 버린&것 같네^1, 프리스크./");
ds_map_add(global.text_data_en, "obj_papyrus_friendc_92", "\E0하지만^1, 나^1,&위대한 파피루스 님은.../");
ds_map_add(global.text_data_en, "obj_papyrus_friendc_93", "언제나&네 친구로&있겠노라!!!/");
ds_map_add(global.text_data_en, "obj_papyrus_friendc_95", "\E1* 떼 어 내 려 고  안 간 힘 을&  쓰 겠 지 만  소 용 없 겠 지 ./");
ds_map_add(global.text_data_en, "obj_papyrus_friendc_97", "\E1형!/");
ds_map_add(global.text_data_en, "obj_papyrus_friendc_98", "\E0맞는 말이야./%%");
ds_map_add(global.text_data_en, "obj_papyrus_friendc_103", "\E3프리스크^1, 산책이나&좀 하고 오지 그래?/");
ds_map_add(global.text_data_en, "obj_papyrus_friendc_105", "\E1* 프 리 스 크 ^1, 날 고  올 래 ?&* 그 게  더  빨 라 ./");
ds_map_add(global.text_data_en, "obj_papyrus_friendc_107", "\E0그래^1, 프리스크^1.&왜 안 나는 거야?/");
ds_map_add(global.text_data_en, "obj_papyrus_friendc_109", "\E1* 흠 ..^1. 난 다 는  건&  좀  위 험 하 게&  들 리 는 데 ./");
ds_map_add(global.text_data_en, "obj_papyrus_friendc_111", "\E3* 못  날 잖 아 ./");
ds_map_add(global.text_data_en, "obj_papyrus_friendc_113", "\E2* 못  난 다 는  마 음 가 짐&  때 문 이 겠 지 !/%%");
ds_map_add(global.text_data_en, "obj_papyrus_friendc_118", "\E3프리스크..^1.&등산을 해./");
ds_map_add(global.text_data_en, "obj_papyrus_friendc_119", "\E0등산은 뼈에 좋대./%%");
ds_map_add(global.text_data_en, "obj_papyrus_guide_82", "전망 좋은 우리 집에&온 걸 환영해!/");
ds_map_add(global.text_data_en, "obj_papyrus_guide_83", "마음껏 편하게&지내라고!!!/%%");
ds_map_add(global.text_data_en, "obj_papyrus_guide_84", "와우!&좋은 집주인이 되는 건&정말 고된 일이군!/%%");
ds_map_add(global.text_data_en, "obj_papyrus_guide_88", "\E3다리에 감각이&없잖아.../");
ds_map_add(global.text_data_en, "obj_papyrus_guide_89", "\E0내가 아주 훌륭한&집주인이라는 증거겠지!!!/%%");
ds_map_add(global.text_data_en, "obj_papyrus_hisroom_86", "어디 한번 둘러봐!/%%");
ds_map_add(global.text_data_en, "obj_papyrus_houseoutside_109", "그래, 나랑 데이트 하러&돌아왔구나!/");
ds_map_add(global.text_data_en, "obj_papyrus_houseoutside_110", "그래, 날 다시&보러 왔구나!/");
ds_map_add(global.text_data_en, "obj_papyrus_houseoutside_111", "\E3정말로 진지했었나&보구나.../");
ds_map_add(global.text_data_en, "obj_papyrus_houseoutside_112", "\E2널 정말 특별한 장소로&데려가야겠군.../");
ds_map_add(global.text_data_en, "obj_papyrus_houseoutside_113", "\E0내가 아주 많은 시간을&보내기 좋아하는 곳이야!!!/%%");
ds_map_add(global.text_data_en, "obj_papyrus_houseoutside_303", "우리 집!!!/%%");
ds_map_add(global.text_data_en, "obj_papyrus_room_119", "우리 형은 최근에&양말 수집을 시작했어./");
ds_map_add(global.text_data_en, "obj_papyrus_room_120", "\E3참 딱하기도 하지.../");
ds_map_add(global.text_data_en, "obj_papyrus_room_121", "\E0가끔 형이 앞으로&뭘 하고 살지 걱정이 돼.../");
ds_map_add(global.text_data_en, "obj_papyrus_room_122", "나같이 아주 멋진&사나이가 돌봐주지&않는다면???/");
ds_map_add(global.text_data_en, "obj_papyrus_room_123", "녜 헤 헤!/%%");
ds_map_add(global.text_data_en, "obj_papyrus_room_129", "그래^1, 힌트가&필요하시군^1, 응?/");
ds_map_add(global.text_data_en, "obj_papyrus_room_130", "\E3음..^1.&내가 이 퍼즐을 계속&보고 있었는데.../");
ds_map_add(global.text_data_en, "obj_papyrus_room_131", "내 생각엔&이 퍼즐은.../");
ds_map_add(global.text_data_en, "obj_papyrus_room_132", "\E0 X들을 전부 O들로&바꾸는 퍼즐인 것&같아!/");
ds_map_add(global.text_data_en, "obj_papyrus_room_133", "그렇게 한번 해봐!/");
ds_map_add(global.text_data_en, "obj_papyrus_room_134", "더 훌륭한 힌트가&필요하면 또 물어봐!/%%");
ds_map_add(global.text_data_en, "obj_papyrus_room_135", "\W아마 \Y저번 퍼즐\W을&다시 풀어보는 게&도움이 될 거야./");
ds_map_add(global.text_data_en, "obj_papyrus_room_136", "더 훌륭한 힌트가&필요하면 또&물어봐!!/%%");
ds_map_add(global.text_data_en, "obj_papyrus_room_157", "에러, 피핍./%%");
ds_map_add(global.text_data_en, "obj_papyrus_room_161", "언다인한테 같이&놀아도 좋은지&물어봤었어.../");
ds_map_add(global.text_data_en, "obj_papyrus_room_162", "\E3근데 걔는 뭔가&이상한 말을&했었지./");
ds_map_add(global.text_data_en, "obj_papyrus_room_163", "\E0살인자들과는 같이&놀지 않을 거라고&했어./");
ds_map_add(global.text_data_en, "obj_papyrus_room_164", "\E3하지만..^1. 흐음.../");
ds_map_add(global.text_data_en, "obj_papyrus_room_165", "\E5난 누구도 살해한&기억이 없어.../");
ds_map_add(global.text_data_en, "obj_papyrus_room_166", "\E3내가 꽤나 잔혹한&타입이긴 하지만&말이야./");
ds_map_add(global.text_data_en, "obj_papyrus_room_167", "\E3그러고 나선 자기가&하고 싶은 걸&말했었지.../");
ds_map_add(global.text_data_en, "obj_papyrus_room_168", "\E1나쁜 놈들과&싸우고 싶다고./");
ds_map_add(global.text_data_en, "obj_papyrus_room_169", "\E3언다인은 뭐랄까 무슨 일&때문에 많이..^1. 약해진&것처럼 보였어./");
ds_map_add(global.text_data_en, "obj_papyrus_room_170", "\E5나가다가 출입문에서&넘어졌었지./");
ds_map_add(global.text_data_en, "obj_papyrus_room_171", "\E0그래서 난 혹시라도&날 필요로 할 때를 대비해&그냥 기다리고 있어./");
ds_map_add(global.text_data_en, "obj_papyrus_room_172", "\E3걘 누가 그냥&도와주는 건&되게 싫어하거든./");
ds_map_add(global.text_data_en, "obj_papyrus_room_173", "\E5아마 나중에 같이&놀아야 할 것 같아.../%%");
ds_map_add(global.text_data_en, "obj_papyrus_room_176", "이봐^1, 난.../");
ds_map_add(global.text_data_en, "obj_papyrus_room_177", "\E5우리가 정말&같이 어울릴 수&있을까?/");
ds_map_add(global.text_data_en, "obj_papyrus_room_178", "\E3이런 생각하긴&힘겹겠지만.../");
ds_map_add(global.text_data_en, "obj_papyrus_room_179", "\E0그냥 나 없이&놀아야 할 것 같아./%%");
ds_map_add(global.text_data_en, "obj_papyrus_room_185", "오^1! 너도 언다인이랑&놀러 온 거야???/");
ds_map_add(global.text_data_en, "obj_papyrus_room_186", "좋았어!!^1!&나도야!!!/");
ds_map_add(global.text_data_en, "obj_papyrus_room_187", "\E3근데^1, 오늘은&집에 없네./");
ds_map_add(global.text_data_en, "obj_papyrus_room_188", "\E0원래 이시간이면&돌아오는데 말야./");
ds_map_add(global.text_data_en, "obj_papyrus_room_189", "\E3그런데 오늘은 늦네.../");
ds_map_add(global.text_data_en, "obj_papyrus_room_190", "\E3그리고 전화도 안 받아./");
ds_map_add(global.text_data_en, "obj_papyrus_room_191", "\E0이상하기도 하지./");
ds_map_add(global.text_data_en, "obj_papyrus_room_192", "그냥 여기서&언다인이 올 때까지&기다리려고./");
ds_map_add(global.text_data_en, "obj_papyrus_room_193", "언다인이 오면&너한테도 전화할게^1,&알았지!?/%%");
ds_map_add(global.text_data_en, "obj_papyrus_room_196", "아니!^1!&아직 안 왔어!!!/%%");
ds_map_add(global.text_data_en, "obj_papyrus_room_202", "언다인이 돌아오긴&했는데^1, 상태가 영&안 좋아,/");
ds_map_add(global.text_data_en, "obj_papyrus_room_203", "\E5오늘은 같이&못 놀 것 같아./");
ds_map_add(global.text_data_en, "obj_papyrus_room_204", "\E3어디서 열사병을&걸려온 것 같은데./");
ds_map_add(global.text_data_en, "obj_papyrus_room_205", "누군가 얘를 집까지&끌고 왔을 거야./");
ds_map_add(global.text_data_en, "obj_papyrus_room_206", "\E5지금 거의 움직이질&못하고 있거든./");
ds_map_add(global.text_data_en, "obj_papyrus_room_207", "\E0그리고 어째서인지&널 짓밟아버리겠다고&중얼거리고 있어./");
ds_map_add(global.text_data_en, "obj_papyrus_room_208", "뭐, 정신은&말짱하네./");
ds_map_add(global.text_data_en, "obj_papyrus_room_209", "\E3어쨋든^1, 오늘은 같이&놀지 못할 것 같아./");
ds_map_add(global.text_data_en, "obj_papyrus_room_210", "\E0그냥 여기서 언다인을&보살펴주려고./");
ds_map_add(global.text_data_en, "obj_papyrus_room_211", "그러니까^1, 오늘은&그냥 가도 돼./%%");
ds_map_add(global.text_data_en, "obj_papyrus_room_214", "언다인은 몸이 아파서&오늘은 못 놀아./%%");
ds_map_add(global.text_data_en, "obj_papyrus_room_220", "오^1! 너도 언다인이랑&놀러 온 거야???/");
ds_map_add(global.text_data_en, "obj_papyrus_room_221", "좋았어!!! 왜냐하면&오늘 오지도 않았거든./");
ds_map_add(global.text_data_en, "obj_papyrus_room_222", "일찍부터 준비 중이야^1!&상대를 신경써준다는 걸&보여줘야지!!/");
ds_map_add(global.text_data_en, "obj_papyrus_room_223", "\E3그걸 봐 줄&언다인이 없어도 말이야./%%");
ds_map_add(global.text_data_en, "obj_papyrus_room_226", "아니!^1!&아직 안 왔어!!!/%%");
ds_map_add(global.text_data_en, "obj_papyrus_room_244", "안녕^1, 친구./");
ds_map_add(global.text_data_en, "obj_papyrus_room_245", "파피루스 마을에는&무슨 일로 왔나?/%%");
ds_map_add(global.text_data_en, "obj_papyrus_room_248", "안녕..^1.&요즘 어-어때^1,&내 친구?/");
ds_map_add(global.text_data_en, "obj_papyrus_room_249", "\E5오늘은 꽤 감이 좋아./%%");
ds_map_add(global.text_data_en, "obj_papyrus_room_253", "야^1, 좋은 생각이&있어./");
ds_map_add(global.text_data_en, "obj_papyrus_room_254", "다음에 언다인이랑&같이 놀자./");
ds_map_add(global.text_data_en, "obj_papyrus_room_255", "준비되면 전화 줄게!/%%");
ds_map_add(global.text_data_en, "obj_papyrus_room_259", "언다인과 친구가&되었다니&정말로 기쁘군./");
ds_map_add(global.text_data_en, "obj_papyrus_room_260", "파스타와 불과 같은&좋은 조합이야!/%%");
ds_map_add(global.text_data_en, "obj_papyrus_room_263", "아^1, 안녕.../");
ds_map_add(global.text_data_en, "obj_papyrus_room_264", "\E3곧 떠날 거지^1,&맞지?/");
ds_map_add(global.text_data_en, "obj_papyrus_room_265", "\E1작별 인사하러&여기 오진 마!/");
ds_map_add(global.text_data_en, "obj_papyrus_room_266", "\E3우리 마을에선&작별 따윈 없어./");
ds_map_add(global.text_data_en, "obj_papyrus_room_267", "\E0그냥 다음에 보자고&할 뿐이지!/%%");
ds_map_add(global.text_data_en, "obj_papyrus_room_272", "언다인이 네게 줄 게&있는 모양이야./");
ds_map_add(global.text_data_en, "obj_papyrus_room_273", "내 옆에 있는 사람이&언다인이야./%%");
ds_map_add(global.text_data_en, "obj_papyrus_room_278", "언다인은 편지를&많이 써./");
ds_map_add(global.text_data_en, "obj_papyrus_room_279", "\E3하지만, 딱히&적당한 말을 찾지는&못하는 것 같아./");
ds_map_add(global.text_data_en, "obj_papyrus_room_280", "그래서 직접&전해주려 했다간.../");
ds_map_add(global.text_data_en, "obj_papyrus_room_281", "항상 관두고 돌아와서&다시 쓰곤 하지./");
ds_map_add(global.text_data_en, "obj_papyrus_room_282", "\E0그래서 네게&부탁하는 거야!/");
ds_map_add(global.text_data_en, "obj_papyrus_room_283", "넌 줏대가 없으니까!/%%");
ds_map_add(global.text_data_en, "obj_papyrus_room_287", "알피스는 사라진 것 같아./");
ds_map_add(global.text_data_en, "obj_papyrus_room_288", "걱정 마^1, 늘 있는 일이야./");
ds_map_add(global.text_data_en, "obj_papyrus_room_289", "실험실에 가 보는 게&좋을 거야./");
ds_map_add(global.text_data_en, "obj_papyrus_room_290", "난 이 숫자들을&지금 조합해야 해서&말이야./%%");
ds_map_add(global.text_data_en, "obj_papyrusboss_270", " 오^1, 가련한& 파피루스!/%%");
ds_map_add(global.text_data_en, "obj_papyrusboss_272", " 무-뭐^1, 이건 내가& 기대했던 게& 아닌데.../%%");
ds_map_add(global.text_data_en, "obj_papyrusboss_282", " 뭐^1, 그래도 아직& 머리는 있네!/%%");
ds_map_add(global.text_data_en, "obj_papyrusboss_285", " 하지만.../");
ds_map_add(global.text_data_en, "obj_papyrusboss_286", " 그..^1. 그래도^1!& 난 널 믿어!/");
ds_map_add(global.text_data_en, "obj_papyrusboss_287", " 넌 좀 더 좋은& 사람이 될 수& 있을 거야!/");
ds_map_add(global.text_data_en, "obj_papyrusboss_288", " 넌 그렇게& 생각 안 할지라도!/");
ds_map_add(global.text_data_en, "obj_papyrusboss_289", " 내..^1.& 내가 보증할게.../%%");
ds_map_add(global.text_data_en, "obj_papyrusboss_402", " 흠...! *헉^1*& 너는... 날 이길 수^1!& *헉^1* 없는 게& 확실하네!!!/");
ds_map_add(global.text_data_en, "obj_papyrusboss_403", " 그래!!!& 네가 다리를 떠는 게& 신발을 신고 있어도& 보인다고!!!/");
ds_map_add(global.text_data_en, "obj_papyrusboss_404", " 그러므로 나^1, 위대한& 파피루스 님께서^1,& 너를 불쌍히& 여기겠노라!!/");
ds_map_add(global.text_data_en, "obj_papyrusboss_405", " \X널 \R살려줄게\X,& 인간!!!/");
ds_map_add(global.text_data_en, "obj_papyrusboss_406", " \X지금이 내 \R자비\X를& 받아들일 기회야./%%");
ds_map_add(global.text_data_en, "obj_papyrusboss_423", "* 파 피 루 스 는  당 신 에 게&  자 비 를  베 풀 고  있 다 .");
ds_map_add(global.text_data_en, "obj_papyrusboss_456", " 저게 뭐야!/");
ds_map_add(global.text_data_en, "obj_papyrusboss_457", " 저게 내 필살기인데!/%%");
ds_map_add(global.text_data_en, "obj_papyrusboss_466", " 야^1! 멍청한 멍멍아!/%%");
ds_map_add(global.text_data_en, "obj_papyrusboss_477", " 들리냐!?/");
ds_map_add(global.text_data_en, "obj_papyrusboss_478", " 그 뼈다귀 좀& 그만 뜯어!!!/%%");
ds_map_add(global.text_data_en, "obj_papyrusboss_487", " 야!!!& 어디 가는 거야!!!/");
ds_map_add(global.text_data_en, "obj_papyrusboss_488", " 내 필살기& 다시 가져 와!!!/%%");
ds_map_add(global.text_data_en, "obj_papyrusboss_502", " .../");
ds_map_add(global.text_data_en, "obj_papyrusboss_503", " 그럼./");
ds_map_add(global.text_data_en, "obj_papyrusboss_504", " 엄청 멋있는 보통 공격을& 써야겠네./%%");
ds_map_add(global.text_data_en, "obj_papyrusboss_514", "* 파 피 루 스 는  보 통  공 격 을&  준 비 하 고  있 다 .");
ds_map_add(global.text_data_en, "obj_papyrusboss_548", "  ...");
ds_map_add(global.text_data_en, "obj_papyrusboss_552", " 이런^1, & 하나를 가져왔어야& 했는데.");
ds_map_add(global.text_data_en, "obj_papyrusboss_558", " 진지한가 보군.../");
ds_map_add(global.text_data_en, "obj_papyrusboss_559", " 그러니까 넌& 싸우지 않을 거란& 말이지.../");
ds_map_add(global.text_data_en, "obj_papyrusboss_560", " 그러면^1, 네가 나의& 전설적인 '파란 공격'을& 버틸 수 있나 보자구!/%%");
ds_map_add(global.text_data_en, "obj_papyrusboss_561", "%%%");
ds_map_add(global.text_data_en, "obj_papyrusboss_570", " 잘 보시라!");
ds_map_add(global.text_data_en, "obj_papyrusboss_571", " 흐음... 뭘& 입어야 할지& 모르겠는걸...");
ds_map_add(global.text_data_en, "obj_papyrusboss_572", " 얼마나 높이& 점프할 수& 있느냐?");
ds_map_add(global.text_data_en, "obj_papyrusboss_573", " 뭐!? 나 데이트& 같은 건 생각& 안 했어!!");
ds_map_add(global.text_data_en, "obj_papyrusboss_574", " '위' 버튼을 계속& 누르는 걸로& 점프를 해 봐!!!");
ds_map_add(global.text_data_en, "obj_papyrusboss_575", "\X 그래!& 내가 \R필살기\X를& 쓰고픈 마음이& 들지 않게끔!");
ds_map_add(global.text_data_en, "obj_papyrusboss_576", " 위 버튼을 눌러& 높게 점프해 봐!& 정말이지!!!");
ds_map_add(global.text_data_en, "obj_papyrusboss_577", " 미래의 인기가& 벌써 눈에& 보이는군!!!");
ds_map_add(global.text_data_en, "obj_papyrusboss_578", " 파피루스, 왕실 근위대의& 수장!");
ds_map_add(global.text_data_en, "obj_papyrusboss_579", " 파피루스, 전무후무한& 스파게티 요리사!");
ds_map_add(global.text_data_en, "obj_papyrusboss_580", " 언다인이 나를& 정말 자랑스러워& 할 거야!!");
ds_map_add(global.text_data_en, "obj_papyrusboss_581", " 왕은 내 미소를 본따& 정원을 다듬겠지!!!");
ds_map_add(global.text_data_en, "obj_papyrusboss_582", " 내 형은... 음,& 그닥 바뀌진& 않겠고.");
ds_map_add(global.text_data_en, "obj_papyrusboss_583", " 나의 팬도 정말& 많이 생기겠지!!& 근데...");
ds_map_add(global.text_data_en, "obj_papyrusboss_584", " 사람들이 날& 진짜 좋아하는 줄& 어떻게 알지?");
ds_map_add(global.text_data_en, "obj_papyrusboss_585", " 너처럼 진심으로& 나를 좋아하는& 사람이 있을까?");
ds_map_add(global.text_data_en, "obj_papyrusboss_586", " 너같은 사람은& 정말 드물어...");
ds_map_add(global.text_data_en, "obj_papyrusboss_587", " 너를 잡고 놔 줄 것& 같진 않아...");
ds_map_add(global.text_data_en, "obj_papyrusboss_588", " 그리고 데이트도& 조금 어렵겠지...");
ds_map_add(global.text_data_en, "obj_papyrusboss_589", " 붙잡혀서 보내진 후에는& 말이야...");
ds_map_add(global.text_data_en, "obj_papyrusboss_590", " 음... 알 게 뭐야!& 포기해!!");
ds_map_add(global.text_data_en, "obj_papyrusboss_591", "\X 포기하지 않는다면& 내... \R필살기\X를& 맛보게 될 것이다!!!");
ds_map_add(global.text_data_en, "obj_papyrusboss_592", "\X 그래!!!& 조금 있다& \R필살기\X를& 쓸 거라고! ");
ds_map_add(global.text_data_en, "obj_papyrusboss_593", "\X 조금 뒤에 그& \R필살기\X를& 쓸 거니까!!!");
ds_map_add(global.text_data_en, "obj_papyrusboss_594", "\X 네 마지막 기회야...& 곧 \R필살기\X가& 나간다!!");
ds_map_add(global.text_data_en, "obj_papyrusboss_595", "\X 보시라...!& 나의 \R필살기\X를!");
ds_map_add(global.text_data_en, "obj_papyrusboss_596", " 하아... 여기,& 완전 평범한 공격이야.");
ds_map_add(global.text_data_en, "obj_papyrusboss_604", " 녜 헤 헤!");
ds_map_add(global.text_data_en, "obj_papyrusboss_605", " 난 네게서 그런& 친절함을 받을& 자격이 못 돼..");
ds_map_add(global.text_data_en, "obj_papyrusboss_606", " 네 가시 돋친& 말엔 숨겨진 애정이& 있어! 이 정많은& 선인장 같으니!");
ds_map_add(global.text_data_en, "obj_papyrusboss_607", " 쓸데없는 말& 하지 마!");
ds_map_add(global.text_data_en, "obj_papyrusboss_608", " 나-나중에& 데이트 하자!!& 널 붙잡고 나서& 말이야!");
ds_map_add(global.text_data_en, "obj_papyrusboss_612", "  ...");
ds_map_add(global.text_data_en, "obj_papyrusboss_1584", "* 파 피 루 스 는  뼈 다 귀  공 격 을&  준 비 하 고  있 다 .");
ds_map_add(global.text_data_en, "obj_papyrusboss_1585", "* 파 피 루 스 는  뼈  없 이  공 격 을&  준 비 하 다 가  곧  실 수 를&  바 로 잡 는 다 .");
ds_map_add(global.text_data_en, "obj_papyrusboss_1586", "* 파 피 루 스 는  낄 낄  웃 고  있 다 .");
ds_map_add(global.text_data_en, "obj_papyrusboss_1587", '* 파 피 루 스 가  "녜 헤 헤 !"라 고&  속 삭 였 다 .');
ds_map_add(global.text_data_en, "obj_papyrusboss_1588", "* 파 피 루 스 는  뼈 다 귀 를&  흔 들 고  있 다 .");
ds_map_add(global.text_data_en, "obj_papyrusboss_1589", "* 파 피 루 스 는  멋 진  척&  하 고  있 다 .");
ds_map_add(global.text_data_en, "obj_papyrusboss_1590", "* 파 피 루 스 는  자 기  상 황 을&  돌 아 보 고  있 다 .");
ds_map_add(global.text_data_en, "obj_papyrusboss_1591", "* 뼈 다 귀  냄 새 가  난 다 .");
ds_map_add(global.text_data_en, "obj_papyrusboss_1592", "* 파 피 루 스 는  샌 즈 가  했 던&  썰 렁 한  농 담 을  떠 올 리 고&  얼 굴 을  찌 푸 린 다 .");
ds_map_add(global.text_data_en, "obj_papyrusboss_1596", "* 파 피 루 스 는  데 이 트  때&  뭘  입 을 지  생 각  중 이 다 .");
ds_map_add(global.text_data_en, "obj_papyrusboss_1597", "* 파 피 루 스 는  데 이 트  때&  뭘  요 리 할 지  생 각  중 이 다 .");
ds_map_add(global.text_data_en, "obj_papyrusboss_1598", "* 파 피 루 스 는  귀  뒤 에&  뼈 다 귀  향 수 를  바 른 다 .");
ds_map_add(global.text_data_en, "obj_papyrusboss_1599", "* 파 피 루 스 는  귀  뒤 에&  마 리 나 라  소 스 를  바 른 다 .");
ds_map_add(global.text_data_en, "obj_papyrusboss_1600", "* 파 피 루 스 는  귀  뒤 에&  MTT 브 랜 드&  미 소 년  크 림 을  바 른 다 .");
ds_map_add(global.text_data_en, "obj_papyrusboss_1601", "* 파 피 루 스 는  귀  뒤 에&  MTT 브 랜 드&  애 니  파 우 더 를  바 른 다 .");
ds_map_add(global.text_data_en, "obj_papyrusboss_1602", "* 파 피 루 스 는  귀  뒤 에&  MTT 브 랜 드&  귀 요 미  주 스 를  바 른 다 .");
ds_map_add(global.text_data_en, "obj_papyrusboss_1603", "* 파 피 루 스 는  귀  뒤 에&  MTT 브 랜 드&  매 혹  젤 을  바 른 다 .");
ds_map_add(global.text_data_en, "obj_papyrusboss_1604", "* 파 피 루 스 는  귀  뒤 에&  MTT 브 랜 드&  미 백  요 거 트 를  바 른 다 .");
ds_map_add(global.text_data_en, "obj_papyrusboss_1605", "* 파 피 루 스 는  자 신 에 게&  귀 가  없 음 을  깨 닫 는 다 .");
ds_map_add(global.text_data_en, "obj_papyrusboss_1609", "* 파 피 루 스 는  패 배&   직 전 이 다 .");
ds_map_add(global.text_data_en, "obj_papyrusboss_1611", "* 파 피 루 스 는  당 신 에 게&  자 비 를  베 풀 고  있 다 .");
ds_map_add(global.text_data_en, "obj_papyrusboss_1613", "* 파 피 루 스 는  당 신 에 게&  자 비 를  베 풀 고  있 다 .");
ds_map_add(global.text_data_en, "obj_papyrusboss_1645", '* 파 피 루 스  - ATK 20 DEF 20&* "녜 헤 헤 !"라 고  말 하 는  걸&  좋 아 한 다 ./^');
ds_map_add(global.text_data_en, "obj_papyrusboss_1647", "* 파 피 루 스  -  ATK 3 DEF 3&* 별  거  없 다 ./^");
ds_map_add(global.text_data_en, "obj_papyrusboss_1661", " 참 배려심이 깊구나.../");
ds_map_add(global.text_data_en, "obj_papyrusboss_1662", " 너와 싸우는& 내 기분을& 나아지게 하고& 싶어하는 거지 .../%%");
ds_map_add(global.text_data_en, "obj_papyrusboss_1663", " 너 스스로를& 속일 필요는& 없어!!!/%%");
ds_map_add(global.text_data_en, "obj_papyrusboss_1664", " 괜찮아...!/%%");
ds_map_add(global.text_data_en, "obj_papyrusboss_1678", "* 모 욕 을  했 지 만 ^1, 소 용 이  없 다 ^1.&* '행 동 ' 만 으 로 는  이  승 부 엔&  진 전 이  없 을  것  같 다 .../^");
ds_map_add(global.text_data_en, "obj_papyrusboss_1680", "* 파 피 루 스 는  싸 우 느 라&  당 신 의  모 욕 을  받 아 줄  수  없 다 ./^");
ds_map_add(global.text_data_en, "obj_papyrusboss_1696", " 뭣!^1?& 자, 작업을 걸다니!?/");
ds_map_add(global.text_data_en, "obj_papyrusboss_1697", "\X 드디어& 네 \R궁극의 감정\X을 & 드러내는구나!/");
ds_map_add(global.text_data_en, "obj_papyrusboss_1698", " 하-하지만^1!& 나는 눈이& 아주 높은& 해골이라고!!!/%%");
ds_map_add(global.text_data_en, "obj_papyrusboss_1700", " 안 돼!!!/%%");
ds_map_add(global.text_data_en, "obj_papyrusboss_1713", "* 작 업 을  걸 었 지 만 ^1, 소 용 이  없 다 ^1.&* '행 동 ' 만 으 로 는  이  승 부 엔&  진 전 이  없 을  것  같 다 .../^");
ds_map_add(global.text_data_en, "obj_papyrusboss_1715", "* 파 피 루 스 는  싸 우 느 라&  작 업 에  장 단 을&  맞 춰 줄  수  없 다 ./^");
ds_map_add(global.text_data_en, "obj_papyrusboss_1754", " 안 돼!!^1! 내 눈높이에& 딱 맞잖아!!!/");
ds_map_add(global.text_data_en, "obj_papyrusboss_1755", " 그러면 너랑& 데이트 해야& 하는 건가...?/%%");
ds_map_add(global.text_data_en, "obj_papyrusboss_1769", " 오, 안 돼!!^1!& 그 겸손함은..^1. 마치,/");
ds_map_add(global.text_data_en, "obj_papyrusboss_1770", " 나 자신을& 떠오르게 해!!!/");
ds_map_add(global.text_data_en, "obj_papyrusboss_1771", " 넌 내 눈높이에& 딱 맞잖아!!!/%%");
ds_map_add(global.text_data_en, "obj_papyrusboss_1804", "   난               난&   스 파 게 티 를       잘 하 는  게 &   잘  만 들 어        없 어 \C");
ds_map_add(global.text_data_en, "obj_papyrussnowman_98", "* (눈  파 피 루 스 다 .)/%%");
ds_map_add(global.text_data_en, "obj_parsnik_205", "그 르 르 르");
ds_map_add(global.text_data_en, "obj_parsnik_206", "그 르 르 르");
ds_map_add(global.text_data_en, "obj_parsnik_207", "그 르 르 르");
ds_map_add(global.text_data_en, "obj_parsnik_208", "그 녀 르 르");
ds_map_add(global.text_data_en, "obj_parsnik_211", "네&초 록&뱀 들 을&먹 었 다 .");
ds_map_add(global.text_data_en, "obj_parsnik_215", "무 례&하 게&굴 지 마 .");
ds_map_add(global.text_data_en, "obj_parsnik_219", "맛 있 는&초 록&뱀 들 을&먹 어 라 .");
