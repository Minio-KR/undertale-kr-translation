ds_map_add(global.text_data_en, "SCR_TEXT_1144", "* 여 긴  아 무 것 도  없 다 !!!/%%");
ds_map_add(global.text_data_en, "SCR_TEXT_1160", "* (발 레 신 발 을  얻 었 다 .)/%%");
ds_map_add(global.text_data_en, "SCR_TEXT_1163", "* (너 무  많 이  들 고  있 다 .)/%%");
ds_map_add(global.text_data_en, "SCR_TEXT_1167", " %%");
ds_map_add(global.text_data_en, "SCR_TEXT_1172", "* (작 은  새 가  당 신 을  태 우 고&  건 너 고  싶 어 합 니 다 .)/");
ds_map_add(global.text_data_en, "SCR_TEXT_1173", "* (새 의  제 안 을  받 아 들 입 니 까 ?)& &         탄 다         아 니       \C");
ds_map_add(global.text_data_en, "SCR_TEXT_1174", "  ");
ds_map_add(global.text_data_en, "SCR_TEXT_1177", "* (우 산 과  새 ...^1)&* (좋 지  않 은  조 합 이 다 .)/%%");
ds_map_add(global.text_data_en, "SCR_TEXT_1182", " %%");
ds_map_add(global.text_data_en, "SCR_TEXT_1197", "* (이 것 은  전 설 의  유 물 이 다 .)/");
ds_map_add(global.text_data_en, "SCR_TEXT_1198", "* (가 져 갑 니 까 ?)& &         가 져 간 다     놔 둔 다 \C");
ds_map_add(global.text_data_en, "SCR_TEXT_1199", " ");
ds_map_add(global.text_data_en, "SCR_TEXT_1202", "* (유 물 은  사 라 졌 다 .)/%%");
ds_map_add(global.text_data_en, "SCR_TEXT_1221", "* (이 런  일 이  일 어 날  리  없 겠 지 .)/%%");
ds_map_add(global.text_data_en, "SCR_TEXT_1224", "* (너 무  많 이  들 고  있 다 .)/%%");
ds_map_add(global.text_data_en, "SCR_TEXT_1225", "* (너 무  많 은  개 를&  가 지 고  있 다 .)/%%");
ds_map_add(global.text_data_en, "SCR_TEXT_1229", " %%");
ds_map_add(global.text_data_en, "SCR_TEXT_1237", "* (냉 장 고 는  컵 라 면 과&  탄 산 음 료 로  가 득  차  있 다 .)/");
ds_map_add(global.text_data_en, "SCR_TEXT_1238", "* (라 면 을  가 져 갑 니 까 ?)& &         가 져 간 다     놔 둔 다 \C");
ds_map_add(global.text_data_en, "SCR_TEXT_1239", " ");
ds_map_add(global.text_data_en, "SCR_TEXT_1242", "* (냉 장 고 는  컵 라 면 과&  탄 산 음 료 로  가 득  차  있 다 .)/%%");
ds_map_add(global.text_data_en, "SCR_TEXT_1258", "* (컵 라 면 을  얻 었 다 .)/%%");
ds_map_add(global.text_data_en, "SCR_TEXT_1261", "* (너 무  많 이  들 고  있 다 .)/%%");
ds_map_add(global.text_data_en, "SCR_TEXT_1265", "* (건 강 하 게  살 기 로  했 다 .)/%%");
ds_map_add(global.text_data_en, "SCR_TEXT_1273", "* (바 닥 에  프 라 이 팬 이&  놓 여  있 다 .)/");
