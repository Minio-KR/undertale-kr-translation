ds_map_add(global.text_data_en, "obj_carbed_67", "따스한 햇빛이&내 살갗을 태우겠지.../");
ds_map_add(global.text_data_en, "obj_carbed_68", "\E3물론^1, 이건&그냥 꿈에 불과해./");
