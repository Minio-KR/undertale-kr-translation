ds_map_add(global.text_data_en, "obj_mettatonex_642", "* 메 타 톤  냄 새 가  난 다 .");
ds_map_add(global.text_data_en, "obj_mettatonex_644", "* 메 타 톤 의  HP가  낮 아 졌 다 .");
ds_map_add(global.text_data_en, "obj_mettatonex_677", "* 메 타 톤  EX - ATK 47 DEF 47&* 그 의  약 점 은&  심 장  모 양 의  핵 이 다 ./^");
ds_map_add(global.text_data_en, "obj_mettatonex_691", "* 당 신 은  한  대 도&  안  맞 을  거 라 고&  말 했 다 ./");
ds_map_add(global.text_data_en, "obj_mettatonex_692", "* 메 타 톤 의  턴  동 안&  시 청 률 이  천 천 히&  오 른 다 ./^");
ds_map_add(global.text_data_en, "obj_mettatonex_706", "* 당 신 은  드 라 마 틱 한&  포 즈 를  취 했 다 .&  시 청 자 들 이  고 개 를  끄 덕 였 다 ./^");
ds_map_add(global.text_data_en, "obj_mettatonex_708", "* 당 신 은  다 쳤 지 만 ^1,&  드 라 마 틱 한  포 즈 를  취 했 다 ^1.&* 시 청 자 들 이  갈 채 를  보 냈 다 ./^");
ds_map_add(global.text_data_en, "obj_mettatonex_710", "* 당 신 은  상 처 가  났 지 만 ^1,&  드 라 마 틱 한  포 즈 를  취 했 다 ^1.&* 시 청 자 들 이  놀 랐 다 ./^");
ds_map_add(global.text_data_en, "obj_mettatonex_712", "* 당 신 은  마 지 막  남 은  힘 으 로 ^1,&  드 라 마 틱 한  포 즈 를  취 했 다 ^1.&* 시 청 자 들 이  비 명 을  질 렀 다 ./^");
ds_map_add(global.text_data_en, "obj_mettatonex_726", "* 당 신 은  돌 면 서&  시 청 자 들 을  조 롱 했 다 ./");
ds_map_add(global.text_data_en, "obj_mettatonex_727", "* 시 청 자 들 은  당 신 이&  짓 밟 히 길  원 한 다 !/^");
ds_map_add(global.text_data_en, "obj_mettatonex_770", "하 ... 하 .../");
ds_map_add(global.text_data_en, "obj_mettatonex_771", "제 가  틀 렸 다 는&거 네 요 ./");
ds_map_add(global.text_data_en, "obj_mettatonex_772", "달 링 .../");
ds_map_add(global.text_data_en, "obj_mettatonex_773", "\E1당 신 은  아 스 고 어 를&지 나 갈  수  있 을&만 큼  강 하 시 군 요 ./");
ds_map_add(global.text_data_en, "obj_mettatonex_774", "\E0뭐  그 럼 .../");
ds_map_add(global.text_data_en, "obj_mettatonex_775", "보 내 드 려 야&겠 지 요 ./");
ds_map_add(global.text_data_en, "obj_mettatonex_776", "\E0저 는  걱 정 하 지&마 세 요 ./");
ds_map_add(global.text_data_en, "obj_mettatonex_777", "지 금 은  죽 어 가 고&있 는  것 처 럼&보 이 겠 지 만 .../");
ds_map_add(global.text_data_en, "obj_mettatonex_778", "\E1알 피 스  박 사 님 은&늘  저 를&고 쳐 주 실  수&있 거 든 요 ./");
ds_map_add(global.text_data_en, "obj_mettatonex_779", "\E0그 리 고 ... 또 .../");
ds_map_add(global.text_data_en, "obj_mettatonex_780", "제 가  스 타 가  될  수&없 다 고  해 도 .../");
ds_map_add(global.text_data_en, "obj_mettatonex_781", "\E1인 간 들 을  위 해&공 연 할  수 는&있 잖 아 요 ?/");
ds_map_add(global.text_data_en, "obj_mettatonex_782", "그 러 니 까 , 고 마 워 요 ,&달 링 .../%%");
ds_map_add(global.text_data_en, "obj_mettatonex_804", "\E1당 신 은  정 말  훌 륭 한&관 객 이 었 어 요 !/%%");
ds_map_add(global.text_data_en, "obj_mettatonex_836", "오 우 ^1, 저  시 청 률&좀  보 세 요 !!!/");
ds_map_add(global.text_data_en, "obj_mettatonex_837", "\E6역 대  최 고 의&시 청 률 이 에 요 !!!/");
ds_map_add(global.text_data_en, "obj_mettatonex_838", "드 디 어&전 화  이 벤 트 를&할  수  있 겠 군 요 !/");
ds_map_add(global.text_data_en, "obj_mettatonex_839", "\E8시 청 자  중  한  분 이&저 와  대 화 할  기 회 를&가 지 게  될  겁 니 다 .../");
ds_map_add(global.text_data_en, "obj_mettatonex_840", "\E7...제 가  이  지 하 를&영 원 히  떠 나 기  전 에&말 이 죠 !!/");
ds_map_add(global.text_data_en, "obj_mettatonex_841", "\E9누 가  가 장  먼 저&전 화 를  거 나  볼 까 요 !/%%");
ds_map_add(global.text_data_en, "obj_mettatonex_866", "\E0안 녕 하 세 요 ^1,&지 금  TV에&나 오 셨 습 니 다 !/");
ds_map_add(global.text_data_en, "obj_mettatonex_867", "제  마 지 막  쇼 에 서&하 실  말 씀 ^1,&있 으 신 가 요 ?/%%");
ds_map_add(global.text_data_en, "obj_mettatonex_880", "...../");
ds_map_add(global.text_data_en, "obj_mettatonex_881", "오 ......../");
ds_map_add(global.text_data_en, "obj_mettatonex_882", "\E1안 녕 ..^1.&메 타 톤 .../");
ds_map_add(global.text_data_en, "obj_mettatonex_883", "네  쇼  정 말 로&마 음 에  들 었 어 .../");
ds_map_add(global.text_data_en, "obj_mettatonex_884", "내  삶 은  꽤 &지 루 했 는 데 ..^1.&그 런 데 .../");
ds_map_add(global.text_data_en, "obj_mettatonex_885", "널  TV에 서  보 고 ..^1.&대 리 만 족 으 로 나 마 ..^1.&즐 거 웠 어 ./");
ds_map_add(global.text_data_en, "obj_mettatonex_886", "말 하 긴  좀  그 렇 지 만 ^1,&이 게 ..^1.&마 지 막  화 인  거 지 ...?/");
ds_map_add(global.text_data_en, "obj_mettatonex_887", "\E3네 가  그 리 울  거 야 ..^1.&메 타 톤 ....../");
ds_map_add(global.text_data_en, "obj_mettatonex_888", "...오 ..^1.&이 렇 게  길 게  끌 려 고&한  건  아 니 었 는 데 .../");
ds_map_add(global.text_data_en, "obj_mettatonex_889", "\E2오 ......../%%");
ds_map_add(global.text_data_en, "obj_mettatonex_900", "잠 깐 만 ^1, 기 다 려 ^1!&기 다 려 ^1, 블 .../");
ds_map_add(global.text_data_en, "obj_mettatonex_901", "\E1헤 ..^1.&벌 써  끊 었 네 ./");
ds_map_add(global.text_data_en, "obj_mettatonex_902", "\E3.../");
ds_map_add(global.text_data_en, "obj_mettatonex_903", "\E0한  분  더  받 도 록&하 겠 습 니 다 !!!/%%");
ds_map_add(global.text_data_en, "obj_mettatonex_915", "\E1메 타 톤 ^1, 당 신 의  쇼 가&저 희 를  행 복 하 게&만 들 어 줬 어 요 !/%%");
ds_map_add(global.text_data_en, "obj_mettatonex_928", "메 타 톤 ^1, 당 신  말 고&뭘  봐 야  할 지&모 르 겠 어 요 ./%%");
ds_map_add(global.text_data_en, "obj_mettatonex_941", "메 타 톤 ^1, 제  메 타 톤&모 양  마 음 속 엔  항 상&메 타 톤  모 양  구 멍 이&있 을  거 예 요 ./%%");
ds_map_add(global.text_data_en, "obj_mettatonex_964", "\E3아 ..^1. 난 .../");
ds_map_add(global.text_data_en, "obj_mettatonex_965", "그 래 .../");
ds_map_add(global.text_data_en, "obj_mettatonex_966", "\E4.../");
ds_map_add(global.text_data_en, "obj_mettatonex_967", "모 두 들 ..^1.&정 말 로  고 마 워 요 ./");
ds_map_add(global.text_data_en, "obj_mettatonex_968", ".../");
ds_map_add(global.text_data_en, "obj_mettatonex_969", "\E0달 링 ./");
ds_map_add(global.text_data_en, "obj_mettatonex_970", "\E1아 마 도 ..^1. 여 기  좀  더&있 는  게  나 을  수 도&있 을  것  같 네 요 ./");
ds_map_add(global.text_data_en, "obj_mettatonex_971", "\E2인 간 들 에 겐  스 타 나&아 이 돌 이  있 어 요 ^1,&하 지 만  괴 물 들 은 .../");
ds_map_add(global.text_data_en, "obj_mettatonex_972", "\E0괴 물 들 에 겐  저  밖 에&없 어 요 ./");
ds_map_add(global.text_data_en, "obj_mettatonex_973", "\E1제 가  떠 난 다 면 ..^1.&지 하  세 계 는  빛 을&잃 을  겁 니 다 ./");
ds_map_add(global.text_data_en, "obj_mettatonex_974", "\E3저 들  마 음 속 에 &채 워 질  수  없 는&빈  공 간 만  남 기 겠 죠 ./");
ds_map_add(global.text_data_en, "obj_mettatonex_975", "\E0그 러 니 ..^1. 제&데 뷔 를  살 짝  미 뤄 야&할  것  같 네 요 ./");
ds_map_add(global.text_data_en, "obj_mettatonex_976", "\E2그 리 고 ./");
ds_map_add(global.text_data_en, "obj_mettatonex_977", "\E1당 신 은  충 분 히&강 하 다 는  걸&입 증 해 줬 어 요 ./");
ds_map_add(global.text_data_en, "obj_mettatonex_978", "\E0아 마 도 ..^1. 아 스 고 어 를&지 나 갈  만 큼&강 할  수 도  있 겠 죠 ./");
ds_map_add(global.text_data_en, "obj_mettatonex_979", "\E0당 신 이 라 면  인 류 를&지 킬  수  있 을&겁 니 다 ./");
ds_map_add(global.text_data_en, "obj_mettatonex_980", "\E4하 ^1, 하 .../");
ds_map_add(global.text_data_en, "obj_mettatonex_981", "그 게  최 선 이 에 요 ^1,&그 나 저 나 ./");
ds_map_add(global.text_data_en, "obj_mettatonex_982", "\E3사 실 ^1, 이  모 습 에 서&소 모 하 는  에 너 지 의&양 은 .../");
ds_map_add(global.text_data_en, "obj_mettatonex_983", "엄 청 나 요 ./");
ds_map_add(global.text_data_en, "obj_mettatonex_984", "조 금 만  있 으 면 ^1,&제  배 터 리 가  다&떨 어 질  거 고 ^1, 그 리 고 .../");
ds_map_add(global.text_data_en, "obj_mettatonex_985", "\E4뭐 ./");
ds_map_add(global.text_data_en, "obj_mettatonex_986", "\E0전  괜 찮 을  겁 니 다 ./");
ds_map_add(global.text_data_en, "obj_mettatonex_987", "\E5잘 해 보 세 요 ^1,&달 링 ./");
ds_map_add(global.text_data_en, "obj_mettatonex_988", "\E0그 리 고  모 두 들 ..^1.&고 마 워 요 ./");
ds_map_add(global.text_data_en, "obj_mettatonex_989", "당 신 들 은  최 고 의&관 객 이 었 습 니 다 !/%%");
ds_map_add(global.text_data_en, "obj_mettboss_event_170", "* 정 말 ^1?&* 어 디 에 요 ?/%%");
ds_map_add(global.text_data_en, "obj_mettboss_event_187", "* 영 리 해 ..^1.&* 정 말 로  영 리 하 군 요 ./%%");
ds_map_add(global.text_data_en, "obj_mettboss_event_230", "* 아 , 그 래 요 .&* 거 기  있 으 시 네 요 , 달 링 ./");
ds_map_add(global.text_data_en, "obj_mettboss_event_231", "* 간 단 한  승 부 를  볼  때 가&  온  것  같 아 요 ./");
ds_map_add(global.text_data_en, "obj_mettboss_event_232", '* 마 침 내  "오 작 동 " 로 봇 을&  막 을  때 가  된  거 죠 ./');
ds_map_add(global.text_data_en, "obj_mettboss_event_233", "* ...개 뿔 이 나 !!!/");
ds_map_add(global.text_data_en, "obj_mettboss_event_234", "* 오 작 동 ?&* 재 프 로 그 래 밍 ?&* 제 발 요 ./");
ds_map_add(global.text_data_en, "obj_mettboss_event_235", "* 그 냥  성 대 한&  쇼 일  뿐 이 라 구 요 ./");
ds_map_add(global.text_data_en, "obj_mettboss_event_236", "* 연 기 예 요 ./");
ds_map_add(global.text_data_en, "obj_mettboss_event_237", "* 알 피 스 는  내 내  당 신 을&  바 보 처 럼  갖 고  놀 았 다 고 요 ./");
ds_map_add(global.text_data_en, "obj_mettboss_event_238", "* 스 크 린 으 로  쭉  보 면 서 ,&  당 신 의  모 험 에&  정 이  들 어 버 린  겁 니 다 ./");
ds_map_add(global.text_data_en, "obj_mettboss_event_239", "* 절 실 하 게  그  여 정 의&  일 부 가  되 고  싶 어 했 어 요 ./");
ds_map_add(global.text_data_en, "obj_mettboss_event_240", "* 그 래 서  자 기  자 신 을&  그  이 야 기 에  넣 기 로  한  거 죠 ./");
ds_map_add(global.text_data_en, "obj_mettboss_event_241", "* 퍼 즐 을  다 시  작 동 시 키 고 ^1,&  엘 리 베 이 터  전 원 을  끄 고 ^1,&  저 더 러  당 신 을  괴 롭 히 랬 어 요 ./");
ds_map_add(global.text_data_en, "obj_mettboss_event_242", "* 있 지 도  않 은  위 험 에 서&  당 신 을  지 켜  줄  수&  있 도 록 이 요 ./");
ds_map_add(global.text_data_en, "obj_mettboss_event_243", "* 그 렇 게  자 신 을&  대 단 한  사 람 이 라&  생 각 해  줄  수  있 도 록 .../");
ds_map_add(global.text_data_en, "obj_mettboss_event_244", "* 사 실  아 니 지 만 요 ./");
ds_map_add(global.text_data_en, "obj_mettboss_event_245", "* 자 , 이 제 ^1. 가 장  멋 진&  시 간 이  왔 습 니 다 ./");
ds_map_add(global.text_data_en, "obj_mettboss_event_247", "* 바 로  이  순 간 ,&  알 피 스 는  방  밖 에 서  당 신 을&  기 다 리 고  있 어 요 ./");
ds_map_add(global.text_data_en, "obj_mettboss_event_248", '* 우 리  "전 투 " 중 에 ,&  알 피 스 가  끼 어 들  겁 니 다 ./');
ds_map_add(global.text_data_en, "obj_mettboss_event_249", '* 마 지 막 으 로  날&  "정 지 시 키 고 " 당 신 을&  "구 하 는 " 척 을  하 겠 죠 ./');
