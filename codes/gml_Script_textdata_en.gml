ds_map_add(global.text_data_en, "obj_tembattle_506", "* 테 미 는  격 렬 하 게  떨 고  있 다 .");
ds_map_add(global.text_data_en, "obj_tembattle_507", "* 테 미 는  머 리 털 을&  손 질 하 고  있 다 .");
ds_map_add(global.text_data_en, "obj_tembattle_508", "* 태 미 는  무 심 코&  이 름 을  잘 못  썼 다 .");
