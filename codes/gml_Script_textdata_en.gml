ds_map_add(global.text_data_en, "obj_adate_1312", "\E3내  말 은 .../");
ds_map_add(global.text_data_en, "obj_adate_1313", "언 다 인 ..^1.&난 .../%%");
ds_map_add(global.text_data_en, "obj_adate_1326", "\F4이 때 까 지  네 게&거 짓 말 을  했 어 !/%%");
ds_map_add(global.text_data_en, "obj_adate_1336", "\F3뭐 ??^1?&뭘  말 이 야 ???/%%");
ds_map_add(global.text_data_en, "obj_adate_1349", "그 러 니 까 ... 뭐 냐 면 .../");
ds_map_add(global.text_data_en, "obj_adate_1350", "\E2전 부 !/%%");
ds_map_add(global.text_data_en, "obj_adate_1366", "\E7너 한 테  해 초 들 이 ...&막  과 학 적 으 로&중 요 하 다 고  했 잖 아 ...%");
ds_map_add(global.text_data_en, "obj_adate_1367", "\E5사 실 은 , 그 건 ...&그 냥  아 이 스 크 림&만 드 는  데  쓰 던  거 야 ^1!%%");
ds_map_add(global.text_data_en, "obj_adate_1383", "그 리 고&내 가  읽 던&인 간  역 사 책 들 ...%");
ds_map_add(global.text_data_en, "obj_adate_1384", "\F7그 냥  전 부&이 상 한  만 화 책 일&뿐 이 었 어 ^1!%%");
ds_map_add(global.text_data_en, "obj_adate_1400", "그 리 고  역 사  영 화 들 ..^1.&그 건 ..^2.%");
ds_map_add(global.text_data_en, "obj_adate_1401", "\F2그 냥 ^1, 어 ^1,&애 니 야 ^2!&실 화 가  아 니 라 고 ^2!%%");
ds_map_add(global.text_data_en, "obj_adate_1417", "그 리 고  그 때&폰  고 친 다 고  바 쁘 다 고&했 을  때 ..^1. 난 ...%");
ds_map_add(global.text_data_en, "obj_adate_1418", "\F9그 냥  잠 옷  입 고&얼 린  요 구 르 트 나&먹 고  있 었 다 고 !%");
ds_map_add(global.text_data_en, "obj_adate_1419", "\E3그 리 고  그 때 ...%%");
ds_map_add(global.text_data_en, "obj_adate_1433", "알 피 스 ./%%");
ds_map_add(global.text_data_en, "obj_adate_1444", "\E5나 는 ..^1. 난  그 저&너 에 게  좀  어 필 하 고&싶 었 던  것 뿐 이 야 !/");
ds_map_add(global.text_data_en, "obj_adate_1445", "네 가  날 ...&덕 후 같 은  패 배 자 가&아 니 라 .../");
ds_map_add(global.text_data_en, "obj_adate_1446", "멋 지 고  똑 똑 하 다 ^1,&생 각 해 주 길&바 랐 을  뿐 이 야 ./%%");
ds_map_add(global.text_data_en, "obj_adate_1459", "알 피 스 ./%%");
ds_map_add(global.text_data_en, "obj_adate_1470", "\E5언 다 인 ^1, 난 ..^1.&난  네 가  정 말&멋 지 다  생 각 해 ^1, 그 래 .../%%");
ds_map_add(global.text_data_en, "obj_adate_1481", "알 피 스 ./");
ds_map_add(global.text_data_en, "obj_adate_1482", "쉬 이 이 잇 ./");
ds_map_add(global.text_data_en, "obj_adate_1483", "쉬 이 이 이 이 잇 ./%%");
ds_map_add(global.text_data_en, "obj_adate_1522", "\F0알 피 스 !/");
ds_map_add(global.text_data_en, "obj_adate_1523", "난 ..^1. 너 도  멋 지 다 고&생 각 해 ^1, 그 래 ./");
ds_map_add(global.text_data_en, "obj_adate_1524", "\F1하 지 만  이 것 만 은&알 아 둬 .../");
ds_map_add(global.text_data_en, "obj_adate_1525", "\F2네 가  말 한&대 부 분 은  내 겐&아 무  상 관 도  없 어 ./");
ds_map_add(global.text_data_en, "obj_adate_1526", "네 가  애 들  만 화 를&보 든  역 사 책 을  읽 든&아 무  신 경  안  써 ./");
ds_map_add(global.text_data_en, "obj_adate_1527", "\F3나 한 테 는 ^1, 그 런  건&전 부  다  덕 질 로 밖 에&안  보 이 니 깐 !/");
ds_map_add(global.text_data_en, "obj_adate_1528", "내 가  너 를  좋 아 하 는&건  네 가  열 정 적 이 고 ^1!&분 석 적 이 기  때 문 이 야 !/");
ds_map_add(global.text_data_en, "obj_adate_1529", "그 게  뭐 든  난&아 무  신 경  안  써 ^1!&그 런  건  너 나&신 경  써 !/");
ds_map_add(global.text_data_en, "obj_adate_1530", "\F4100-퍼 센 트 !^1!&최 고  출 력 으 로 !!!/");
ds_map_add(global.text_data_en, "obj_adate_1531", "\F5...그 러 니 까 ^1, 나 한 테&거 짓 말 할  필 요  없 어 ./");
ds_map_add(global.text_data_en, "obj_adate_1532", "\F0네 가  더  이 상&누 구 에 게 도  거 짓 말 을&안  했 으 면  좋 겠 어 ./");
ds_map_add(global.text_data_en, "obj_adate_1533", "\F6알 피 스 ..^1. 네 가&너  자 신 에 게  만 족 하 고&행 복 해 하 면  좋 겠 어 !/");
ds_map_add(global.text_data_en, "obj_adate_1534", "\F5마 침  내 가  그 런&너 에 게  딱  맞 는&훈 련 을  알 고  있 지 !/%%");
ds_map_add(global.text_data_en, "obj_adate_1566", "언 다 인 ..^1.&너 .../");
ds_map_add(global.text_data_en, "obj_adate_1567", "\E4나 -날  훈 련 시 켜&줄  거 야 ...?/%%");
ds_map_add(global.text_data_en, "obj_adate_1574", "\F2뭐 ^1?&내 가 ?/%%");
ds_map_add(global.text_data_en, "obj_adate_1594", "\F6아 니 ^1, 파 피 루 스&시 킬  거 야 ./%%");
ds_map_add(global.text_data_en, "obj_adate_1612", "뼈다구를 흔들어라!/");
ds_map_add(global.text_data_en, "obj_adate_1613", "우리는 짱이라고 외치며&조깅 100바퀴를&도는 거야!!/%%");
ds_map_add(global.text_data_en, "obj_adate_1622", "준 비 됐 어 ^1?&타 이 머  켤 게 !/%%");
ds_map_add(global.text_data_en, "obj_adate_1636", "\E5 & &   어 -언 다 인 .../");
ds_map_add(global.text_data_en, "obj_adate_1637", "\E1 & &   최 선 을  다  할 게 ..!/%%");
ds_map_add(global.text_data_en, "obj_adate_1659", "\F3세 상 에 !!!/");
ds_map_add(global.text_data_en, "obj_adate_1660", "\F5그 냥  농 담 이 었 겠 지 ^1,&그 렇 지 !?/");
ds_map_add(global.text_data_en, "obj_adate_1661", "그  애 니 들 ..^1.&그  만 화 책 들 .../");
ds_map_add(global.text_data_en, "obj_adate_1662", "\F7그 래 도  실 화 인  건&맞 지 ^1, 맞 지 ?/");
ds_map_add(global.text_data_en, "obj_adate_1663", "\F8애 니 는  실 화 지 ^1,&그 렇 지 ?!?!/%%");
ds_map_add(global.text_data_en, "obj_adate_1688", "   애 니 는           애 니 는 &   실 화 야           실 화 가  &                   아 니 야 ");
ds_map_add(global.text_data_en, "obj_adate_1708", "하 하 하 !!!/");
ds_map_add(global.text_data_en, "obj_adate_1709", "알 고  있 었 어 !!!/");
ds_map_add(global.text_data_en, "obj_adate_1710", "거 대 한  검 !!^1!&마 법  공 주 님 들 ^1!&내 가  간 다 !!!/%%");
ds_map_add(global.text_data_en, "obj_adate_1714", "\F3아 냐 ..^1. 아 냐 !!!!/");
ds_map_add(global.text_data_en, "obj_adate_1715", "내  마 음 이&찢 어 지 는  것&같 아 !!!/%%");
ds_map_add(global.text_data_en, "obj_adate_1736", "\F6.../");
ds_map_add(global.text_data_en, "obj_adate_1737", "어 ^1, 알 피 스 를  잘&돌 봐  줘 서  고 마 워 ./");
ds_map_add(global.text_data_en, "obj_adate_1738", "\F9내 가  하 려 던  말 을&똑 바 로  못  한  것&같 은 데 ^1, 그 래 도 .../");
ds_map_add(global.text_data_en, "obj_adate_1739", "\F0걔  속 사 정 은  이 제 야&좀  풀 린  것  같 네 ./");
ds_map_add(global.text_data_en, "obj_adate_1740", "\F6그 래 ^1, 난  빨 리  쟤 들&따 라 잡 으 러&가 야 겠 다 !/");
ds_map_add(global.text_data_en, "obj_adate_1741", "나 중 에  봐 !/%%");
ds_map_add(global.text_data_en, "obj_adate_1745", "\F3.../");
ds_map_add(global.text_data_en, "obj_adate_1746", "\F5...아 니 ^1, 버 틸  수&있 어 .../");
ds_map_add(global.text_data_en, "obj_adate_1747", "\F3알 피 스 를  위 해 ./");
ds_map_add(global.text_data_en, "obj_adate_1748", "\F9굳 건 히  버 텨 야  해 ./");
ds_map_add(global.text_data_en, "obj_adate_1749", "\F0사 실 을  말 해  줘 서 ^1,&고 마 워 ^1, 인 간 ./");
ds_map_add(global.text_data_en, "obj_adate_1750", "\F9최 대 한  노 력 하 면 서&살 아 갈 게 .../");
