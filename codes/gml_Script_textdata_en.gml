ds_map_add(global.text_data_en, "obj_storybattle_gen_295", "옛 날  옛 적 에 ,&한  인 간 이  폐 허 로&떨 어 졌 습 니 다 ./*");
ds_map_add(global.text_data_en, "obj_storybattle_gen_307", "떨 어 져  다 친  인 간 은&도 와 달 라 고&소 리 쳤 어 요 ./%%");
ds_map_add(global.text_data_en, "obj_storybattle_gen_333", "왕 의  아 들 ,&아 스 리 엘 이 ,&인 간 의  외 침 을&들 었 답 니 다 ./*");
ds_map_add(global.text_data_en, "obj_storybattle_gen_345", "아 스 리 엘 은&인 간 을  성 으 로&데 려 갔 지 요 ./%%");
ds_map_add(global.text_data_en, "obj_storybattle_gen_370", "시 간 이  지 나 ^1,&아 스 리 엘 과&인 간 은  가 족 처 럼&지 내 게  되 었 어 요 ./*");
ds_map_add(global.text_data_en, "obj_storybattle_gen_383", "왕 과  여 왕 은&인 간 의  아 이 를&자 기  아 이 처 럼&대 했 답 니 다 ./*");
ds_map_add(global.text_data_en, "obj_storybattle_gen_395", "지 하  세 계 는&희 망 으 로&가 득  차 게&되 었 었 지 요 ./%%");
ds_map_add(global.text_data_en, "obj_storybattle_gen_421", "그 러 던 ..^1.&어 느  날 .../*");
ds_map_add(global.text_data_en, "obj_storybattle_gen_433", "인 간 은  큰  병 에&걸 렸 습 니 다 ./%%");
ds_map_add(global.text_data_en, "obj_storybattle_gen_459", "아 픈  인 간 에 겐&한  가 지  소 원 이&있 었 답 니 다 ./*");
ds_map_add(global.text_data_en, "obj_storybattle_gen_472", "자 기  마 을 의&꽃 들 을  보 는  것 ./*");
ds_map_add(global.text_data_en, "obj_storybattle_gen_484", "하 지 만  할  수&있 는  건  아 무 것 도&없 었 어 요 ./%%");
