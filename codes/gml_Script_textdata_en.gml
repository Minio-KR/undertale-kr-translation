ds_map_add(global.text_data_en, "obj_napstablook_295", "길 을&막 는&중 ...");
ds_map_add(global.text_data_en, "obj_napstablook_296", "느 으 으&그 으 으");
ds_map_add(global.text_data_en, "obj_napstablook_297", "아 , 난&너 무&재 밌 어");
ds_map_add(global.text_data_en, "obj_napstablook_298", "어 서&해&보 라 고");
