ds_map_add(global.text_data_en, "obj_tordogcall_111", "* (당 신 은  전 화  너 머 에 서&  헐 떡 대 는  소 리 를  들 었 다 ...)/");
ds_map_add(global.text_data_en, "obj_tordogcall_112", "* (...)/");
ds_map_add(global.text_data_en, "obj_tordogcall_113", "* 왈 ^1!&* 왈 !/");
ds_map_add(global.text_data_en, "obj_tordogcall_114", "* 왈 ..^1.&* 왈 !/");
ds_map_add(global.text_data_en, "obj_tordogcall_115", "* (멀 리 서  목 소 리 가&  들 린 다 .)\TT/");
ds_map_add(global.text_data_en, "obj_tordogcall_116", "* 멈 춰 ^1, 제 발 !/");
ds_map_add(global.text_data_en, "obj_tordogcall_117", "* 내  휴 대 폰&  가 지 고  돌 아 와 !/");
