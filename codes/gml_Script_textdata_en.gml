ds_map_add(global.text_data_en, "obj_cookshowevent_157", "* 신 사 , 숙 녀  여 러 분 .&  지 하  최 고 의  요 리  쇼 에&  오 신  것 을  환 영 합 니 다 !/%%");
ds_map_add(global.text_data_en, "obj_cookshowevent_174", "* 오 븐 을  예 열 하 세 요 ^1, 오 늘 은&  아 주  특 별 한  레 시 피 가&  준 비 되 어  있 거 든 요 !/");
ds_map_add(global.text_data_en, "obj_cookshowevent_175", "* 오 늘  저 희 가&  만 들 어  볼  것 은 .../");
ds_map_add(global.text_data_en, "obj_cookshowevent_176", "* 케 이 크 입 니 다 !/");
ds_map_add(global.text_data_en, "obj_cookshowevent_177", "* 여 기  제  사 랑 스 러 운  조 수 가&  재 료 를  구 해 다  올  겁 니 다 ./");
ds_map_add(global.text_data_en, "obj_cookshowevent_178", "* 모 두  큰  박 수&  부 탁 드 려 요 !/%%");
ds_map_add(global.text_data_en, "obj_cookshowevent_202", "\W* \Y설 탕\W 과 , \Y우 유\W 와 ,&  \Y달 걀\W 이  필 요 합 니 다 ./");
ds_map_add(global.text_data_en, "obj_cookshowevent_203", "* 당 장  가 요 ^1, 달 링 !/%%");
ds_map_add(global.text_data_en, "obj_cookshowevent_253", "\W* \Y인 간 의  영 혼 \W!!!!/%%");
