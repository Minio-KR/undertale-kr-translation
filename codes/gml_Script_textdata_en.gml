ds_map_add(global.text_data_en, "obj_ripoff_undyne_650", "* 영 혼 은  당 신 의  투 기 를&  느 끼 며 ...무 언 가&  낯 익 다 고  생 각 했 다 ./^");
ds_map_add(global.text_data_en, "obj_ripoff_undyne_653", "* 영 혼 은  곧  당 신 의  투 기 를&  기 억 해 냈 고 ... 갑 자 기 ^1,&  기 억 이  되 돌 아 온 다 !/%%");
