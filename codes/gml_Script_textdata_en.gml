ds_map_add(global.text_data_en, "obj_toriel_friendc_70", "* 안 녕 ^1, 프 리 스 크 ^1.&* 알 피 스 가  내  폰 을&  업 그 레 이 드  해 줬 단 다 ./");
ds_map_add(global.text_data_en, "obj_toriel_friendc_71", '* 이 제  "문 자 " 같 은  걸&  할  수  있 어 서&  정 말 이 지  즐 거 워 ./');
ds_map_add(global.text_data_en, "obj_toriel_friendc_72", '* 샌 즈 , 이  "문 잡 -아 "&  봐 요 ./');
ds_map_add(global.text_data_en, "obj_toriel_friendc_74", "* 아 , 이 런 ^1, 토 리 .../");
ds_map_add(global.text_data_en, "obj_toriel_friendc_75", "\E1* 끔 찍 하 네 요 ./");
ds_map_add(global.text_data_en, "obj_toriel_friendc_77", "여왕님이&돌아오시다니&믿기지 않아.../");
ds_map_add(global.text_data_en, "obj_toriel_friendc_78", "\E4거기에 엄청 멍청이&같다는 것도!!!/");
ds_map_add(global.text_data_en, "obj_toriel_friendc_79", "둘이 별로&떨어져 있지도&않으면서!!!/");
ds_map_add(global.text_data_en, "obj_toriel_friendc_80", "왜 서로&문자하는 거야!!!/");
ds_map_add(global.text_data_en, "obj_toriel_friendc_82", "* 걱 정  마 요 ^1, 파 피 루 스 .&* 그 럴  만 한  이 유 가&  있 어 서  그 래 요 ./");
ds_map_add(global.text_data_en, "obj_toriel_friendc_84", "그게 뭔데요./");
ds_map_add(global.text_data_en, "obj_toriel_friendc_86", "* 뭐 ./");
ds_map_add(global.text_data_en, "obj_toriel_friendc_87", "\E2* 우 린  둘  다  엄 청&  멍 청 하 니 까 ./");
ds_map_add(global.text_data_en, "obj_toriel_friendc_89", "* 샌 즈 ^1, 그 런  말  마 요 ./");
ds_map_add(global.text_data_en, "obj_toriel_friendc_90", "* 당 신 은  멍 청 이 가&  아 니 에 요 ./");
ds_map_add(global.text_data_en, "obj_toriel_friendc_91", '\E0* "골 " 이  빈  거 죠 !/');
ds_map_add(global.text_data_en, "obj_toriel_friendc_93", "하하하^1, 우와!/");
ds_map_add(global.text_data_en, "obj_toriel_friendc_94", "\E0여왕님이 저러시니까&더 안 웃겨!/");
ds_map_add(global.text_data_en, "obj_toriel_friendc_96", "* 그 럼  왜  웃 고  있 는 데 ?/");
ds_map_add(global.text_data_en, "obj_toriel_friendc_98", "동정의 웃음이야!!!/%%");
ds_map_add(global.text_data_en, "obj_toriel_friendc_103", "* 프 리 스 크 ^1, 외 로 워 하 지 는&  말 렴 ./");
ds_map_add(global.text_data_en, "obj_toriel_friendc_104", "* 네 게 도  문 자 를  했 단 다 !/");
ds_map_add(global.text_data_en, "obj_toriel_friendc_105", "\W* 아 직  \Y내  전 화 번 호 \W를&  갖 고  있 잖 니 .../");
ds_map_add(global.text_data_en, "obj_toriel_friendc_106", "* 그 렇 지  않 아 ?/%%");
ds_map_add(global.text_data_en, "obj_toriel_friendc_111", "* 프 리 스 크 ^1, 떠 나 기  전 에&  한 번  돌 아 보 고&  오 는  게  어 떠 니 ?/");
ds_map_add(global.text_data_en, "obj_toriel_friendc_112", "* 여 기  네 가  사 귄&  많 은  친 구 들 을&  보 니 .../");
ds_map_add(global.text_data_en, "obj_toriel_friendc_113", "* 분 명  사 귄  친 구 들 이&  더  있 을  것  같 구 나 ./%%");
ds_map_add(global.text_data_en, "obj_torielboss_366", " .....");
ds_map_add(global.text_data_en, "obj_torielboss_367", " .....& .....");
ds_map_add(global.text_data_en, "obj_torielboss_368", " .....& .....& .....");
ds_map_add(global.text_data_en, "obj_torielboss_369", " ...?");
ds_map_add(global.text_data_en, "obj_torielboss_370", " 뭐& 하 는& 거 니 ?");
ds_map_add(global.text_data_en, "obj_torielboss_371", " 싸 우 거 나& 도 망 치 란& 말 이 야 !");
ds_map_add(global.text_data_en, "obj_torielboss_372", " 뭐  때 문 에& 이 러 는& 거 니 ?");
ds_map_add(global.text_data_en, "obj_torielboss_373", " 나 랑& 싸 우 거 나& 가  버 려 !");
ds_map_add(global.text_data_en, "obj_torielboss_374", " 그 만 해 .");
ds_map_add(global.text_data_en, "obj_torielboss_376", " 그 런& 눈 으 로& 보 지& 마 .");
ds_map_add(global.text_data_en, "obj_torielboss_377", " 저 리  가 !");
ds_map_add(global.text_data_en, "obj_torielboss_378", " ...");
ds_map_add(global.text_data_en, "obj_torielboss_380", " ...& ...");
ds_map_add(global.text_data_en, "obj_torielboss_388", "집 에  돌 아 가 고&싶 은  마 음 은&잘  알 겠 지 만 ...");
ds_map_add(global.text_data_en, "obj_torielboss_390", "제 발 ... 위 로&올 라 가 주 렴 .");
ds_map_add(global.text_data_en, "obj_torielboss_391", "여 기 서  잘&보 살 펴  주 겠 다 고&약 속 할 게 .");
ds_map_add(global.text_data_en, "obj_torielboss_392", "가 진  건&많 이  없 지 만 ...");
ds_map_add(global.text_data_en, "obj_torielboss_393", "행 복 한  생 활 을&할  수  있 어 .");
ds_map_add(global.text_data_en, "obj_torielboss_395", "어 째 서&힘 든  길 을&택 하 는  거 니 ?");
ds_map_add(global.text_data_en, "obj_torielboss_397", "부 탁 이 니 ^1, 위 로&올 라 가 주 렴 .");
ds_map_add(global.text_data_en, "obj_torielboss_399", "....");
ds_map_add(global.text_data_en, "obj_torielboss_401", "하  하 ...");
ds_map_add(global.text_data_en, "obj_torielboss_402", "한 심 하 네 ^1, 그 치 ^2?&고 작  한  아 이 도 &구 하 지  못 하 다 니 .");
ds_map_add(global.text_data_en, "obj_torielboss_403", "...");
ds_map_add(global.text_data_en, "obj_torielboss_416", "아 니 야 ^1, 이 해 해 ./");
ds_map_add(global.text_data_en, "obj_torielboss_417", "이 곳 에 &갇 혀  있 으 면&불 행 하 겠 지 ./");
ds_map_add(global.text_data_en, "obj_torielboss_418", "여 기  폐 허 는&적 응 된 다 면&무 척  좁 아 진 단 다 ./");
ds_map_add(global.text_data_en, "obj_torielboss_419", "이 런  장 소 에 서&자 라 기 에 도&좋 지  않 을  테 고 ./");
ds_map_add(global.text_data_en, "obj_torielboss_420", "나 의  기 대 ...&나 의  고 독 ...&나 의  염 려 .../");
ds_map_add(global.text_data_en, "obj_torielboss_421", "아 가 야 ^1, 너 를  위 해 서 ...&잠 시  접 어  두 마 ./%%");
ds_map_add(global.text_data_en, "obj_torielboss_445", "\E0으 윽 .../");
ds_map_add(global.text_data_en, "obj_torielboss_446", "\E0내  생 각 보 다&강 하 구 나 .../");
ds_map_add(global.text_data_en, "obj_torielboss_447", "잘  들 으 렴 ^1, 아 가 야 .../");
ds_map_add(global.text_data_en, "obj_torielboss_448", "이  문 으 로  나 가 면 ,/");
ds_map_add(global.text_data_en, "obj_torielboss_449", "최 대 한  멀 리&걸 어  나 가 렴 ./");
ds_map_add(global.text_data_en, "obj_torielboss_450", "그 럼  출 구 를  찾 을  수&있 을  거 야 ./");
ds_map_add(global.text_data_en, "obj_torielboss_451", "\E1..^1.&..../");
ds_map_add(global.text_data_en, "obj_torielboss_452", "\R아 스 고 어 \X..^1.&\R아 스 고 어 \X에 게&영 혼 을  빼 앗 기 지&말 렴 ./");
ds_map_add(global.text_data_en, "obj_torielboss_453", "그  자 의  계 획 이&성 공 해 선  안  돼 ./");
ds_map_add(global.text_data_en, "obj_torielboss_454", "\E2....../");
ds_map_add(global.text_data_en, "obj_torielboss_455", "착 하 게  살 아 야&한 다 ^1,&알 겠 지 ?/");
ds_map_add(global.text_data_en, "obj_torielboss_456", "\E3내  아 가 야 . %%");
ds_map_add(global.text_data_en, "obj_torielboss_460", "너 ...너 ...&그 렇 게 나  날&싫 어 했 니 ?/");
ds_map_add(global.text_data_en, "obj_torielboss_461", "널  데 리 고  있 으 면 서&뭘  지 키 려  했 던 건 지&이 제 야  알 겠 구 나 ./");
ds_map_add(global.text_data_en, "obj_torielboss_462", "네 가  아 니 라 .../");
ds_map_add(global.text_data_en, "obj_torielboss_463", "\E5저 들 을  지 키 고&있 었 던  거 야 !/");
ds_map_add(global.text_data_en, "obj_torielboss_464", "\E3하 ... 하 ... %%");
ds_map_add(global.text_data_en, "obj_torielboss_469", "\E4너 .../");
ds_map_add(global.text_data_en, "obj_torielboss_470", "...내 가  가 장&방 심 한&순 간 에 .../");
ds_map_add(global.text_data_en, "obj_torielboss_471", "네 게  밖 은&위 험 하 다 고&걱 정 해 줬 건 만 .../");
ds_map_add(global.text_data_en, "obj_torielboss_472", "\E5에 헤 헤 헤 !!!&너 도  저 들 과  별 반&다 르 지  않 구 나 !/");
ds_map_add(global.text_data_en, "obj_torielboss_473", "\E3하 ... 하 ... %%");
ds_map_add(global.text_data_en, "obj_torielboss_803", "* 토 리 엘 은  마 법  공 격 을&  준 비 하 고  있 다 .");
ds_map_add(global.text_data_en, "obj_torielboss_804", "* 토 리 엘 은  당 신 을  바 라 보 았 다 .");
ds_map_add(global.text_data_en, "obj_torielboss_805", "* 토 리 엘 은  당 신 과  거 리 를  둔 다 .");
