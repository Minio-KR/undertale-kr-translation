ds_map_add(global.text_data_en, "obj_readable_room1_558", "* 만 약 .../");
ds_map_add(global.text_data_en, "obj_readable_room1_559", "* 영 혼 이  없 는  존 재 가&  살 고 자  하 는  의 지 를&  얻 는 다 면  어 떻 게  될 까 ?/%%");
ds_map_add(global.text_data_en, "obj_readable_room1_565", "* (작 동 하 는  버 튼 이  없 다 ^1.)&* (전 기 가  나 간  것  같 다 .)/%%");
ds_map_add(global.text_data_en, "obj_readable_room1_570", "* (문 은  덩 쿨 로  막 혀  있 다 .)/%%");
ds_map_add(global.text_data_en, "obj_readable_room1_575", "* (다 른  엘 리 베 이 터 는&  동 력 이  끊 긴  것  같 다 .)/%%");
ds_map_add(global.text_data_en, "obj_readable_room1_580", "* (주 크 박 스 는  고 장 났 다 .)/%%");
ds_map_add(global.text_data_en, "obj_readable_room1_585", "* (잠 겨 있 다 .)/%%");
ds_map_add(global.text_data_en, "obj_readable_room1_590", "* (해 진  매 트 리 스 다 ^1.)&* (시 트 는  이 상 한  공  모 양 으 로&  뭉 쳐 져  있 다 .)/%%");
ds_map_add(global.text_data_en, "obj_readable_room1_595", "* (서 랍  안 에 는&  사 진  앨 범 이  있 다 .)/");
ds_map_add(global.text_data_en, "obj_readable_room1_596", "* (당 신 이  모 르 는  사 람 들 과&  찍 은  샌 즈 의  사 진 이  있 다 .)/");
ds_map_add(global.text_data_en, "obj_readable_room1_597", "* (샌 즈 는  행 복 해  보 인 다 .)/%%");
ds_map_add(global.text_data_en, "obj_readable_room1_602", "* (서 랍  안 에 는&  사 진  앨 범 이  있 다 .)/");
ds_map_add(global.text_data_en, "obj_readable_room1_603", "* (당 신 이  모 르 는  사 람 들 과&  찍 은  샌 즈 의  사 진 이  있 다 .)/");
ds_map_add(global.text_data_en, "obj_readable_room1_604", "* (...그 리 고 , 당 신 과&  당 신  친 구 들 과  함 께&  찍 은  사 진 도  한  장  있 다 .)/");
ds_map_add(global.text_data_en, "obj_readable_room1_605", "* (샌 즈 는  행 복 해  보 인 다 .)/%%");
ds_map_add(global.text_data_en, "obj_readable_room1_610", "* (서 랍  안 에 는&  사 진  앨 범 이  있 다 .)/");
ds_map_add(global.text_data_en, "obj_readable_room1_611", "* (당 신 이 ... 음 ?)/");
ds_map_add(global.text_data_en, "obj_readable_room1_612", "* (앨 범  뒷 표 지 에 서&  카 드  한  장 이&  삐 져 나 와  있 다 .)/");
ds_map_add(global.text_data_en, "obj_readable_room1_613", "* (세  사 람 이  웃 고  있 는&  서 툴 게  그 려 진  그 림 이 다 .)&* (위 에  글 이  쓰 여  있 다 ...)/");
ds_map_add(global.text_data_en, "obj_readable_room1_614", '* "잊 지  마 ."/%%');
ds_map_add(global.text_data_en, "obj_readable_room1_621", "* (메 타 톤 의  최 근  무 대&  퍼 포 먼 스  포 스 터 다 .)/");
ds_map_add(global.text_data_en, "obj_readable_room1_622", "* (두  스 타 의  비 극 적  이 야 기&  엇 갈 린  사 랑 ^1, 둘 을  떼 어 놓 는&  운 명 의  파 도 ...)/");
ds_map_add(global.text_data_en, "obj_readable_room1_623", "* (곧  공 연  시 간 이&  되 는  것  같 다 .)/%%");
ds_map_add(global.text_data_en, "obj_readable_room1_628", "* (안 쪽 에 서  잠 겨  있 다 .)/%%");
ds_map_add(global.text_data_en, "obj_readable_room1_633", "* (분 수 에  글 씨 가  적 혀  있 다 .)/");
ds_map_add(global.text_data_en, "obj_readable_room1_634", "* 왕 실  기 념  분 수&* 201X년  건 립&* (메 타 톤  형 상 은  저 번  주 에  추 가 )/%%");
ds_map_add(global.text_data_en, "obj_readable_room1_639", "* (방 문 한  유 명  인 사 들 의&  한 마 디 와  사 진 으 로  가 득 한&  명 예 의  전 당  벽 이 다 .)/");
ds_map_add(global.text_data_en, "obj_readable_room1_640", '* 이  음 식  정 말  갖 고  싶 다 ^1!&* "멋 진  스 타 일 과  향 기 까 지 ^1!"&* "아 름 다 운  맛 의  내  얼 굴 !"/');
ds_map_add(global.text_data_en, "obj_readable_room1_641", "* (... 전 부  메 타 톤 이 다 .)/%%");
ds_map_add(global.text_data_en, "obj_readable_room1_646", "* (전 등 이 다 .^1)&* (스 위 치 는  없 다 .)/");
ds_map_add(global.text_data_en, "obj_readable_room1_647", "* (별 들 이  스 스 로  빛 을&  낸 다 고  적 혀  있 다 ...)/%%");
ds_map_add(global.text_data_en, "obj_readable_room1_652", "* (탬 의  유 구 한  역 사 .)/%%");
ds_map_add(global.text_data_en, "obj_readable_room2_60", "%%");
ds_map_add(global.text_data_en, "obj_readable_room2_63", "* (빈  사 진 틀 이 다 .)&* (완 전  먼 지 투 성 이 다 ...)/%%");
ds_map_add(global.text_data_en, "obj_readable_room2_67", "* (빈  사 진 틀 이 다 .)&* (누 군 가 가  먼 지 를  털 어 냈 다 .)/%%");
ds_map_add(global.text_data_en, "obj_readable_room2_72", "* (가 족  사 진 이 다 ^1.)&* (모 두 가  웃 고  있 다 .)/%%");
ds_map_add(global.text_data_en, "obj_readable_room2_75", "\R* .../%%");
ds_map_add(global.text_data_en, "obj_readable_room2_80", "* 역 사 책 이 다 ^1.&* 아 무  페 이 지 나  펴  보 았 다 .../");
ds_map_add(global.text_data_en, "obj_readable_room2_81", "* 인 간 들 에 게  공 격 받 고&  결 계 에  갇 힌  우 리 는 ^1,&  도 망 쳤 다 ./");
ds_map_add(global.text_data_en, "obj_readable_room2_82", "* 깊 은  땅 속 으 로  걸 어  들 어 간&  우 리 는  마 침 내  동 굴 의  끝 에&  다 다 랐 다 ./");
ds_map_add(global.text_data_en, "obj_readable_room2_83", "* 이 곳 이  우 리 의  새  집 이 었 다 ^1.&  우 리 는  이 곳 을 .../");
ds_map_add(global.text_data_en, "obj_readable_room2_84", "* '집 '이 라  이 름  붙 였 다 ./");
ds_map_add(global.text_data_en, "obj_readable_room2_85", "* 우 리  왕 은  위 대 하 였 으 나 ^1,&  이 름  짓 는  것 은  형 편 없 었 다 ./%%");
ds_map_add(global.text_data_en, "obj_readable_room2_90", "* 서 랍 이 다 ./");
ds_map_add(global.text_data_en, "obj_readable_room2_91", "* 안 에  산 타  의 상 이&  있 다 ./%%");
ds_map_add(global.text_data_en, "obj_readable_room2_94", "\R* 쓸 만 한  건  없 네 ./%%");
ds_map_add(global.text_data_en, "obj_readable_room2_100", "* (사 진  앨 범 이  있 다 ..^1.)&* (스 크 랩 북 ..^1.)&* (차  끓 이 는  법 이  쓰 인  책 ...)/%%");
ds_map_add(global.text_data_en, "obj_readable_room2_101", "* (전 부  매 우  낡 아 보 인 다 .)/%%");
ds_map_add(global.text_data_en, "obj_readable_room2_105", "\R* 쓸 만 한  건  없 네 ./%%");
ds_map_add(global.text_data_en, "obj_readable_room2_111", "* 황 금 꽃 이 다 ./%%");
ds_map_add(global.text_data_en, "obj_readable_room2_114", "* 안 에 는  201X년 에 서&  시 작 하 는  낡 은  달 력 이&  있 다 ./%%");
ds_map_add(global.text_data_en, "obj_readable_room2_115", "* (황 금 꽃 이 다 .)/%%");
ds_map_add(global.text_data_en, "obj_readable_room2_119", "* (흰  시 트 로  덮 인&  다 른  왕 좌 다 .)/%%");
ds_map_add(global.text_data_en, "obj_readable_room2_124", "* 달 팽 이 가  든&  낡 고  평 범 한  양 동 이 다 ./%%");
ds_map_add(global.text_data_en, "obj_readable_room2_127", "* 지 하  세 계 의  식 물 에  대 한&  백 과 사 전 이 다 . 당 신 은&  책 장 을  넘 겼 다 .../");
ds_map_add(global.text_data_en, "obj_readable_room2_128", "* 부 들  - 갈 색 의  길 쭉 한&  꼬 투 리 가  달 린 ^1,&  습 지 에 서  자 라 는  화 초 ./");
ds_map_add(global.text_data_en, "obj_readable_room2_129", '* "워 터  소 시 지 " 라 는&  이 름 으 로  더  잘&  알 려 져  있 다 ./%%');
ds_map_add(global.text_data_en, "obj_readable_room2_135", "* 당 신 은  이  종 류 의  식 물 을&  본  적 이  있 지 만&  이 름 은  모 른 다 ./%%");
ds_map_add(global.text_data_en, "obj_readable_room2_136", '* 오 ^2!&* 이 게  "워 터  소 시 지 "군 ./%%');
ds_map_add(global.text_data_en, "obj_readable_room2_140", "* 끝 내 주 는  냄 새 다 ...&* 하 지 만  아 직  먹 기 엔&  너 무  뜨 겁 다 ./%%");
ds_map_add(global.text_data_en, "obj_readable_room2_141", "* 파 이 의  크 기 만  봐 도&  먹 기 에 는  너 무  힘 들&  것  같 다 ./%%");
ds_map_add(global.text_data_en, "obj_readable_room2_144", "* (파 이  대 부 분 이  사 라 졌 다 ^1)&* (개 의  흔 적 이  있 다 ...)/%%");
ds_map_add(global.text_data_en, "obj_readable_room2_149", "* 괴 물 은  대 부 분  마 법 으 로&  이 루 어 져  있 는  반 면 ^1,&  인 간 은  대 부 분  물 이 다 ./");
ds_map_add(global.text_data_en, "obj_readable_room2_150", "* 물 질 적 인  형 체 를  지 닌&  인 간 은  우 리 보 다&  훨 씬  강 력 하 다 ./");
ds_map_add(global.text_data_en, "obj_readable_room2_151", "* 하 지 만  마 법 으 로  자 신 을&  표 현 하 는  즐 거 움 은&  절 대 로  모 를  것 이 다 ./");
ds_map_add(global.text_data_en, "obj_readable_room2_152", "* 탄 막  패 턴 으 로&  생 일  카 드 를  받 지 도&  못  할  거 야 .../%%");
ds_map_add(global.text_data_en, "obj_readable_room2_164", "* 문 이 다 ./%%");
ds_map_add(global.text_data_en, "obj_readable_room2_166", "* ...!^1?&* 수 풀  안 에  카 메 라 가&  숨 겨 져  있 다 ./%%");
ds_map_add(global.text_data_en, "obj_readable_room2_178", "\W* \O용 기 ^1. \Y정 의 .\W &* \B고 결 ^1. \G친 절 ^1.\W &*\P 인 내 ^1. \L끈 기 .\W /");
ds_map_add(global.text_data_en, "obj_readable_room2_179", '\W* 이 것 들 로 ^1, 당 신 은&  "\R공  게 임\W "에 서&  이 길  수  있 었 다 ./');
ds_map_add(global.text_data_en, "obj_readable_room2_180", "* (당 신 은  50G를  받 았 다 .)/%%");
ds_map_add(global.text_data_en, "obj_readable_room2_186", "\W* \R빨 강\W  - 최 선 을  다  할 수 록 ^1,&  당 신 은  계 속  당 신 답 게&  있 을  수  있 다 ./");
ds_map_add(global.text_data_en, "obj_readable_room2_187", "* (당 신 은  10G를  받 았 다 .)/%%");
ds_map_add(global.text_data_en, "obj_readable_room2_194", "\W* \O주 황\W  - 당 신 은  장 애 물 에&  부 닥 치 면  주 먹 이  먼 저&  나 가 는  사 람 이 다 ./");
ds_map_add(global.text_data_en, "obj_readable_room2_195", "* (당 신 은  5G를  받 았 다 .)/%%");
ds_map_add(global.text_data_en, "obj_readable_room2_201", '\W* \Y노 랑\W  - 당 신 의  아 주&  정 확 한  조 준 이  "공 "의&  대 혼 란 을  끝 맺 었 다 ./');
ds_map_add(global.text_data_en, "obj_readable_room2_202", "* (당 신 은  3G를  받 았 다 .)/%%");
ds_map_add(global.text_data_en, "obj_readable_room2_208", "\W* \B파 랑\W  - 통 통  튀 고  빙 빙  도 는&  자 신 만 의  스 타 일 로&  난 관 을  이 겨 냈 다 ./");
ds_map_add(global.text_data_en, "obj_readable_room2_209", "* (당 신 은  2G를  받 았 다 .)/%%");
ds_map_add(global.text_data_en, "obj_readable_room2_215", '\W* \G초 록\W  - "공 "에  대 한&  당 신 의  관 심 과  배 려 가&  달 콤 한  승 리 를  가 져 왔 다 ./');
ds_map_add(global.text_data_en, "obj_readable_room2_216", "* (당 신 은  1G를  받 았 다 .)/%%");
ds_map_add(global.text_data_en, "obj_readable_room2_222", '\W* \P보 라\W  - 당 신 은  함 정 에&  빠 진  것  같 아 도 ^1, 주 의 해 서&  "공 " 게 임 을  끝 냈 다 ./');
ds_map_add(global.text_data_en, "obj_readable_room2_223", "* (당 신 은  2G를  받 았 다 .)/%%");
ds_map_add(global.text_data_en, "obj_readable_room2_229", '\W* \L밝 은  파 랑\W  - "공 "은  "작 다 "^1.&* 당 신 은 ^1, 가 만 히 ^1, &  이  순 간 을  위 해  기 다 렸 다 .../');
ds_map_add(global.text_data_en, "obj_readable_room2_230", '* ...그 리 고  "공 "에 게&  날 렵 한  공 격 을  해&  그  자 리 에 서  날 려 버 렸 다 ./');
ds_map_add(global.text_data_en, "obj_readable_room2_231", "* (당 신 은  4G를  받 았 다 .)/%%");
ds_map_add(global.text_data_en, "obj_readable_room2_238", "* (이  깃 발 은  더  이 상&  줄  것 이  없 다 .)/%%");
ds_map_add(global.text_data_en, "obj_readable_room2_245", "\W* 아 ^1! 와 우 ^1! 우 와 ^1!&* 이 건  \R'구 멍 '\W이 야 ./%%");
ds_map_add(global.text_data_en, "obj_readable_room2_247", "* 구 멍 이  있 다 ./%%");
ds_map_add(global.text_data_en, "obj_readable_room2_252", "* (아 내 )/%%");
ds_map_add(global.text_data_en, "obj_readable_room2_259", "이건 내 형의&애완 돌이야./");
ds_map_add(global.text_data_en, "obj_readable_room2_260", "늘 먹이 주는 걸&잊어버리더군./");
ds_map_add(global.text_data_en, "obj_readable_room2_261", "그래서, 이걸&돌보는 건 언제나&내 몫이지./");
ds_map_add(global.text_data_en, "obj_readable_room2_262", "\TS \F0 \T0 %");
ds_map_add(global.text_data_en, "obj_readable_room2_263", "* (돌 멩 이 가  설 탕  가 루 로&  덮 여  있 다 .)/%%");
ds_map_add(global.text_data_en, "obj_readable_room2_266", "* (이  돌 멩 이 는  설 탕  가 루 로&  덮 여  있 다 .)/%%");
ds_map_add(global.text_data_en, "obj_readable_room2_268", "* (이  돌 멩 이 는  설 탕  가 루 로&  덮 여  있 다 .)/%%");
ds_map_add(global.text_data_en, "obj_readable_room2_276", "그 깃발&끝내주지 않아?/");
ds_map_add(global.text_data_en, "obj_readable_room2_277", "언다인이 해변에서&발견한 건데.../");
ds_map_add(global.text_data_en, "obj_readable_room2_278", "\E3이거 인간 세계에서&온 거 아냐?/");
ds_map_add(global.text_data_en, "obj_readable_room2_279", "\E0네가 무슨 생각&하는지 알 것&같아./");
ds_map_add(global.text_data_en, "obj_readable_room2_280", "\E3왜 인간의 깃발에.../");
ds_map_add(global.text_data_en, "obj_readable_room2_281", "멋진 해골이&그려져 있지?/");
ds_map_add(global.text_data_en, "obj_readable_room2_282", "그래서..^1.&가설을 세워 봤는데./");
ds_map_add(global.text_data_en, "obj_readable_room2_283", "\E3내 생각엔 인간은../");
ds_map_add(global.text_data_en, "obj_readable_room2_284", "\E0해골로부터&진화했을 거야!!!/");
ds_map_add(global.text_data_en, "obj_readable_room2_285", "녜 헤 헤!!!/%%");
ds_map_add(global.text_data_en, "obj_readable_room2_287", "* (낡 은  해 골  깃 발 이 다 .)/%%");
ds_map_add(global.text_data_en, "obj_readable_room2_288", "* (낡 은  해 골  깃 발 이 다 .)/%%");
ds_map_add(global.text_data_en, "obj_readable_room2_295", "* 왜  인 간 이  공 격 했 는 가 ^1?&* 두 려 워 할  게  없 었 던  듯&  하 다 ./");
ds_map_add(global.text_data_en, "obj_readable_room2_296", "* 인 류 는  터 무 니 없 이  강 하 다 .&* 거 의  모 든  괴 물 들 의  영 혼 을&  차 지 할  지 경 이 다 ./");
ds_map_add(global.text_data_en, "obj_readable_room2_297", "* ... 그 렇 게  모 인  영 혼 의  힘 이&  간 신 히  인 간  한  명 분 의&  영 혼 과  맞 먹 는 다 ./%%");
ds_map_add(global.text_data_en, "obj_readable_room2_302", "* 이  위 력 에 는  맞 설  방 법 이&  없 었 다 . 실 제 로  인 간 은&  괴 물 의  영 혼 을  취 할  수  없 었 다 ./");
ds_map_add(global.text_data_en, "obj_readable_room2_303", "* 괴 물 이  죽 으 면 ,&  그  영 혼 은  사 라 진 다 ./");
ds_map_add(global.text_data_en, "obj_readable_room2_304", "* 살 아 있 는  괴 물 로 부 터&  영 혼 을  앗 아 가 기  위 해 선&  엄 청 난  힘 이  필 요 하 다 ./%%");
ds_map_add(global.text_data_en, "obj_readable_room2_310", "* 이  마 법 을&  되 돌 릴  방 법 은&  하 나 뿐 이 다 ./");
ds_map_add(global.text_data_en, "obj_readable_room2_311", "* 일 곱  인 간 의  영 혼 과  같 을&  정 도 의  거 대 한  힘 으 로&  결 계 를  공 격 한 다 면 .../");
ds_map_add(global.text_data_en, "obj_readable_room2_312", "* 결 계 는  부 서 질  것 이 다 ./%%");
ds_map_add(global.text_data_en, "obj_readable_room2_318", "* 결 국 엔 , 전 쟁 이 라 고&  부 르 기 도  힘 들&  사 태 가  되 었 다 ./");
ds_map_add(global.text_data_en, "obj_readable_room2_319", "* 힘 을  합 친  인 간 들 은&  너 무 나 도  강 력 했 고 ,&  우 리  괴 물 들 은  약 했 다 ./");
ds_map_add(global.text_data_en, "obj_readable_room2_320", "* 하 나 의  영 혼 도  남 지  못 한&  채 로 , 수 없 이  많 은&  괴 물 이  먼 지 로  변 했 다 ./%%");
ds_map_add(global.text_data_en, "obj_readable_room2_326", "* 나 는  벌 레 를  잡 고  있 어 ^1.&* 근 데  지 하 에 는&  그 렇 게  많 지  않 아 .../");
ds_map_add(global.text_data_en, "obj_readable_room2_327", "* 계 속  같 은  것 만&  잡 고  있 지 ./%%");
ds_map_add(global.text_data_en, "obj_readable_room2_332", "* (컴 퓨 터 다 ^1.)&* (스 노 우 딘 의  어 떤  퍼 즐 에&  작 동 하 는  것  같 다 .)/%%");
ds_map_add(global.text_data_en, "obj_readable_room2_333", "* (너 무  어 두 워 서&  볼  수  없 다 .)/%%");
ds_map_add(global.text_data_en, "obj_readable_room2_343", "* (오 븐 이 다 ^1.)&* (꽤  현 대 적 으 로  보 인 다 .)/%%");
ds_map_add(global.text_data_en, "obj_readable_room2_345", "* (너 무  어 두 워 서&  볼  수  없 다 .)/%%");
ds_map_add(global.text_data_en, "obj_readable_room2_353", "* 오  그 래 요 ^1! MTT 브 랜 드  오 븐 은&  9000도  까 지  올 라 갈  수&  있 어 요 !/");
ds_map_add(global.text_data_en, "obj_readable_room2_354", "* 굽 고 ^1! 지 지 고 ^1! 그 을 리 고 ^1!&* 태 우 고 ^1! 정 말  흥 분 되 지&  않 아 요 , 달 링 ?/%%");
ds_map_add(global.text_data_en, "obj_readable_room2_360", "* (오 븐 이 다 .)&* (누 군 가 가  예 열 하 는  것 을&  잊 은  것  같 다 .)/%%");
ds_map_add(global.text_data_en, "obj_readable_room2_373", "* 내  방 을  보 고  싶 어 ?/");
ds_map_add(global.text_data_en, "obj_readable_room2_374", "\E3* 안 됐 네 ^1!&* 덕 후 는  출 입 금 지 야 !/");
ds_map_add(global.text_data_en, "obj_readable_room2_375", "\E9* ...음 , 몇 몇&  덕 후 는  될 지 도 .../%%");
ds_map_add(global.text_data_en, "obj_readable_room2_377", "* 너 는  좀  끔 찍 하 잖 아 ./%%");
ds_map_add(global.text_data_en, "obj_readable_room2_390", "* (거 미  도 넛 이 다 ^1.)&* (잘  보 니 ..^1.)&* (평 소 보 다  더  질 겨  보 인 다 .)/%%");
ds_map_add(global.text_data_en, "obj_readable_room2_395", "* (북 쪽 ^1, 전 사 의  길 .)&* (서 쪽 ^1, 현 자 의  길 .)&* (어 느  길 이 든  끝 으 로  향 하 리 .)/%%");
ds_map_add(global.text_data_en, "obj_readable_room2_400", "* (동 쪽 을  향 하 여 ^1!)&* (끝 이 다 .)/%%");
ds_map_add(global.text_data_en, "obj_readable_room2_405", "* 실 험  기 록  제 2번 /");
ds_map_add(global.text_data_en, "obj_readable_room2_406", "* 결 계 는  영 혼 의  힘 으 로&  막 혀  있 다 ../");
ds_map_add(global.text_data_en, "obj_readable_room2_407", "* 안 타 깝 게 도 ^1, 이  힘 은&  인 공 적 으 로  재 현 해 낼&  수  없 다 ./");
ds_map_add(global.text_data_en, "obj_readable_room2_408", "* 영 혼 의  힘 은  오 직  한 때&  살 아 있 었 던  존 재 에 서 만&  얻 을  수  있 다 ./");
ds_map_add(global.text_data_en, "obj_readable_room2_409", "* 그 러 니 ^1, 힘 을  더  얻 으 려 면 ^1,&  지 금  가 지 고  있 는  것 을&  사 용 하 는  수 밖 에 .../");
ds_map_add(global.text_data_en, "obj_readable_room2_410", "* 괴 물 의  영 혼 을 ./%%");
ds_map_add(global.text_data_en, "obj_readable_room2_412", "* (꺼 진  것  같 다 .)/%%");
ds_map_add(global.text_data_en, "obj_readable_room2_417", "* 실 험  기 록  제 13번 /");
ds_map_add(global.text_data_en, "obj_readable_room2_418", "* 몸 뚱 아 리  중  하 나 가&  눈 을  떴 다 ./%%");
ds_map_add(global.text_data_en, "obj_readable_room2_419", "* (꺼 진  것  같 다 .)/%%");
ds_map_add(global.text_data_en, "obj_readable_room2_424", "* (고 장 난  시 계 다 .)/%%");
ds_map_add(global.text_data_en, "obj_readable_room2_429", "* 실 험  기 록  제 10번 /");
ds_map_add(global.text_data_en, "obj_readable_room2_430", "* 그 릇 에  관 한  실 험 은&  모 두  실 패 로  돌 아 갔 다 ./");
ds_map_add(global.text_data_en, "obj_readable_room2_431", "* 대 조 군 과  전 혀&  차 이 를  보 이 지  않 는 다 ./");
ds_map_add(global.text_data_en, "obj_readable_room2_432", "* 아 무 래 도  좋 다 ^1.&  성 가 시 기 만  할  뿐 ./");
ds_map_add(global.text_data_en, "obj_readable_room2_433", "* 이  씨 앗 들 은  딱  달 라 붙 어 서&  떨 어 지 질  않 는 다 ./%%");
ds_map_add(global.text_data_en, "obj_readable_room2_434", "* (꺼 진  것  같 다 .)/%%");
ds_map_add(global.text_data_en, "obj_readable_room2_439", "* 실 험  기 록  제 16번 /");
ds_map_add(global.text_data_en, "obj_readable_room2_440", "* 아 니  안 돼  안 돼  안 돼  안 돼/%%");
ds_map_add(global.text_data_en, "obj_readable_room2_441", "* (꺼 진  것  같 다 .)/%%");
ds_map_add(global.text_data_en, "obj_readable_room2_446", "* (한  무 더 기 의  비 디 오 다 ^1.)&* (어 떤  만 화 가  대 부 분 이 다 .)/");
ds_map_add(global.text_data_en, "obj_readable_room2_447", "* (위 치 가  다 른  몇  개  빼 곤&  이 름 순 으 로  정 렬 되 어  있 다 .)&* (...힘 들 었 나 ?)/%%");
ds_map_add(global.text_data_en, "obj_readable_room2_452", "* 실 험  기 록  제 11번 /");
ds_map_add(global.text_data_en, "obj_readable_room2_453", "* 메 타 톤 이  크 게  성 공 한&  이 후 로  더  이 상  말 을&  걸 어 주 지  않 는 다 ./");
ds_map_add(global.text_data_en, "obj_readable_room2_454", "* ...언 제  자 기  몸 체 가&  완 성 되 느 냐  물 어 볼  때 는&  빼 고 ./");
ds_map_add(global.text_data_en, "obj_readable_room2_455", "* 하 지 만  완 성 하 고  나 면&  더  이 상  나 를  필 요 로  하 지&  않 을 까  봐  불 안 하 다 ./");
ds_map_add(global.text_data_en, "obj_readable_room2_456", "* 그 러 면  다 시&  친 구 가  되 는  일 은&  없 겠 지 ./");
ds_map_add(global.text_data_en, "obj_readable_room2_457", "* ...말 할  것 도  없 이  매 번&  작 업 할  때 마 다  온 몸 이&  땀 으 로  흠 뻑  젖 는 다 ./%%");
ds_map_add(global.text_data_en, "obj_readable_room2_462", "* 실 험  기 록  제 20번 /");
ds_map_add(global.text_data_en, "obj_readable_room2_463", "* 오 늘  아 스 고 어 께 서&  다 섯  통 의  메 시 지 를&  남 기 셨 다 ./");
ds_map_add(global.text_data_en, "obj_readable_room2_464", "* 그 중  넷 은  모 두 가  분 노 하 고&  있 다 는  얘 기 고 ./");
ds_map_add(global.text_data_en, "obj_readable_room2_465", "* 하 나 는  나 를  닮 은  귀 여 운&  찻 잔 을  찾 았 다 는  얘 기 다 ./");
ds_map_add(global.text_data_en, "obj_readable_room2_466", "* 고 마 워 요 , 아 스 고 어  님 ./%%");
ds_map_add(global.text_data_en, "obj_readable_room2_467", "* (꺼 진  것  같 다 .)/%%");
ds_map_add(global.text_data_en, "obj_readable_room2_468", "* (너 무  어 두 워 서&  벽 이  보 이 지  않 는 다 .)/%%");
ds_map_add(global.text_data_en, "obj_readable_room2_473", "* (꺼 진  것  같 다 .)/%%");
ds_map_add(global.text_data_en, "obj_readable_room2_476", "* 실 험  기 록  제 18번 /");
ds_map_add(global.text_data_en, "obj_readable_room2_477", "* 꽃 이  사 라 졌 다 ./%%");
ds_map_add(global.text_data_en, "obj_readable_room2_483", "* (안 에 서  잠 겨  있 다 .)/%%");
ds_map_add(global.text_data_en, "obj_readable_room2_488", "미스터리한&판잣집에는&들어가지 마./%%");
ds_map_add(global.text_data_en, "obj_readable_room2_492", "안녕^1,&여긴 내 집이&아냐./");
ds_map_add(global.text_data_en, "obj_readable_room2_493", "내 짱짱 창고일&뿐이지./");
ds_map_add(global.text_data_en, "obj_readable_room2_495", "* 그 래 서  짱 고 라 고&  부 르 지 ?/");
ds_map_add(global.text_data_en, "obj_readable_room2_497", "아냐!!!&그런 생각&해 본 적 없거든!!!/");
ds_map_add(global.text_data_en, "obj_readable_room2_498", "이래서 우리가&친구인 거지^1,&언다인./");
ds_map_add(global.text_data_en, "obj_readable_room2_499", "창고 말장난으로&내 인생을 풍족하게&해 주었으니./");
ds_map_add(global.text_data_en, "obj_readable_room2_501", "* 지 금 까 지  딱  하 나&  만 든  거 야 ^1, 자 식 아 ./%%");
ds_map_add(global.text_data_en, "obj_readable_room2_506", "체벌의 판잣집에서&또 하룻밤 보낼&준비됐어?/%%");
ds_map_add(global.text_data_en, "obj_readable_room2_509", "체벌의 판잣집에서&또 하룻밤 보낼&준비됐어?/");
ds_map_add(global.text_data_en, "obj_readable_room2_511", "* 아 , 세 상 에 ^1.&  알 고  싶 지 도  않 군 ./");
ds_map_add(global.text_data_en, "obj_readable_room2_513", "너무 화내지 마^1,&언다인./");
ds_map_add(global.text_data_en, "obj_readable_room2_514", "내 판잣집은&4성급&대접이니까./");
ds_map_add(global.text_data_en, "obj_readable_room2_516", "* 음 ^1, 맞 춰  볼 까 ./");
ds_map_add(global.text_data_en, "obj_readable_room2_517", "\E6* 가 끔  개 밥 으 로&  핫 도 그 를  잘 라  주 지 ^1.&  응 ?/");
ds_map_add(global.text_data_en, "obj_readable_room2_519", "뭐!?!?/");
ds_map_add(global.text_data_en, "obj_readable_room2_520", "\E0어떻게 알았어?/");
ds_map_add(global.text_data_en, "obj_readable_room2_522", "* 세 상 에 ^1! 아 냐 ^1!&* 농 담 이 었 어 !!^1!&* 제 발  그 러 지  마 !!!/%%");
ds_map_add(global.text_data_en, "obj_readable_room2_528", "사생활을 좀&배우라구./%%");
ds_map_add(global.text_data_en, "obj_readable_room2_534", "* (화 재 용  대 피 구 로&  나 갈  수 는  없 다 .)&* (당 신 은  불 이  아 니 니 까 .)/%%");
ds_map_add(global.text_data_en, "obj_readable_room2_539", "* (커 버 가  벗 겨 진  베 개 다 .)/%%");
ds_map_add(global.text_data_en, "obj_readable_room2_544", "* (당 신 은  서 랍 을  뒤 졌 다 .)&* (몇  가 지  종 류 의&  뱃 지 가  있 다 .)/%%");
ds_map_add(global.text_data_en, "obj_readable_room2_549", "* (공 연  스 케 줄 이 다 ^1.)&* (코 미 디 언 , 춤 꾼 , 샌 즈 ...)&* (지 금 은  쉬 는  시 간  같 다 .)/%%");
ds_map_add(global.text_data_en, "obj_readable_room2_554", "* (커 다 란  향 수  병 이 다 ^1.)&* (오  드  랙 탱 글 .)/");
ds_map_add(global.text_data_en, "obj_readable_room2_555", "* (이  뚜 껑 은  웃 음 도&  안  나 올  정 도 로  크 다 ^1.&  열  수 도  없 다 .)/%%");
ds_map_add(global.text_data_en, "obj_readable_room2_560", "* (누 군 가 가  지 켜 보 는&  느 낌 이 다 .)/%%");
ds_map_add(global.text_data_en, "obj_readable_room2_563", "* (누 군 가 가  꺼 내 주 길&  기 다 리 고  있 다 .)/%%");
ds_map_add(global.text_data_en, "obj_readable_room2_569", "* (남 쪽  벽 의  보 석 들 이&  멋 지 게  빛 나 고  있 다 .)/");
ds_map_add(global.text_data_en, "obj_readable_room2_570", "* (이  각 도 에 서  남 쪽  벽 을&  볼  수  있 다 니 ^1,&  참  멋 진  일 이 다 .)/%%");
ds_map_add(global.text_data_en, "obj_readable_room3_59", "%%");
ds_map_add(global.text_data_en, "obj_readable_room3_60", "* (크 기 가  제 멋 대 로 인&  어 린 이 용  신 발 이&  든  상 자 다 .)/%%");
ds_map_add(global.text_data_en, "obj_readable_room3_63", "* (황 금 꽃 의  그 림 이 다 .)/%%");
ds_map_add(global.text_data_en, "obj_readable_room3_66", "\R* 내  그 림 ./%%");
ds_map_add(global.text_data_en, "obj_readable_room3_71", "* (확 실 히  트 윈  사 이 즈&  침 대 보 다 도  크 다 .)/%%");
ds_map_add(global.text_data_en, "obj_readable_room3_74", "* (아 까 부 터  트 윈  사 이 즈&  침 대 보 다  크 다 고  생 각 했 었 다 .)/");
ds_map_add(global.text_data_en, "obj_readable_room3_75", "* (하 지 만  이 제  더 블  사 이 즈&  보 다 도  한  사 이 즈  더  크 다 는  걸&  깨 달 았 다 .)/%%");
ds_map_add(global.text_data_en, "obj_readable_room3_79", "* 석 탄 은  아 직  따 스 하 다 ./%%");
ds_map_add(global.text_data_en, "obj_readable_room3_81", "* (마 카 로 니 로  만 든  꽃  그 림 이 다 ^1.)&* ('왕  아 빠 를  위 해 !')/%%");
ds_map_add(global.text_data_en, "obj_readable_room3_83", "* 서 랍  안 에 는  꽃 씨 와&  몇  개 의  부 러 진  크 레 용 이&  있 다 ./%%");
ds_map_add(global.text_data_en, "obj_readable_room3_84", "* 배 수 구 가  흰  털 로&  막 혀  있 다 ./%%");
ds_map_add(global.text_data_en, "obj_readable_room3_85", "* (배 수 구 가  흰  털 로&  막 혀  있 다 .)/%%");
ds_map_add(global.text_data_en, "obj_readable_room3_89", "* 괴 물 의  몸 은  마 법 으 로&  이 루 어 졌 기 에 ^1,&  그  영 혼 에  맞 춰 져  있 다 ./");
ds_map_add(global.text_data_en, "obj_readable_room3_90", "* 괴 물 이  싸 움 을&  원 치  않 는 다 면 ^1,&  방 어 도 는  약 해 진 다 ./");
ds_map_add(global.text_data_en, "obj_readable_room3_91", "* 우 리  적 의  포 악 함 이&  더  거 세 질 수 록 ^1, 우 리 에 게&  오 는  공 격 의  상 처 는  크 다 ./");
ds_map_add(global.text_data_en, "obj_readable_room3_92", "* 그 러 므 로 ^1, 강 인 한  영 혼 을&  가 진  존 재 가  살 인 에  대 한&  갈 망 에  부 닥 친 다 면 .../");
ds_map_add(global.text_data_en, "obj_readable_room3_93", "* 음 ^1, 이  장 은&  여 기 에 서  끝 이 다 .../%%");
ds_map_add(global.text_data_en, "obj_readable_room3_104", "* ...!^1?&* 보 초  구 역  뒤 에&  카 메 라 가  숨 겨 져  있 다 ./%%");
ds_map_add(global.text_data_en, "obj_readable_room3_108", '* ...!^1?&* "보 초  구 역 " 뒤 에 ...&  카 메 라 가  숨 겨 져  있 다 ./%%');
ds_map_add(global.text_data_en, "obj_readable_room3_112", "* ...!^1?&* 눈 더 미  안 쪽 에&  카 메 라 가  숨 겨 져  있 다 ./%%");
ds_map_add(global.text_data_en, "obj_readable_room3_116", "* ...!^1?&* 이  나 무  안 쪽 에&  카 메 라 가  숨 겨 져  있 다 ./%%");
ds_map_add(global.text_data_en, "obj_readable_room3_120", "* ...!^1?&* 이  나 무  안 쪽 에&  카 메 라 가  숨 겨 져  있 다 ./%%");
ds_map_add(global.text_data_en, "obj_readable_room3_124", "* ...!^1?&* 보 초  구 역  뒤 에&  카 메 라 가  숨 겨 져  있 다 ./%%");
ds_map_add(global.text_data_en, "obj_readable_room3_128", "* ...!^1?&* 다 리  밑 에&  카 메 라 가  숨 겨 져  있 다 ./%%");
ds_map_add(global.text_data_en, "obj_readable_room3_132", "* ...!^1?&* 여 기  숲  안 쪽 에&  카 메 라 가  숨 겨 져  있 다 ./%%");
ds_map_add(global.text_data_en, "obj_readable_room3_139", "* 다 리 꽃 은  수 면 에 서&  한  줄 을  이 루 면 ^1,&  꽃 이  피 어 납 니 다 ./%%");
ds_map_add(global.text_data_en, "obj_readable_room3_141", "* 실 수 를  한 다 면 , 종 꽃 을&  사 용 하 여  원 상 태 로&  되 돌 릴  수  있 습 니 다 ./%%");
ds_map_add(global.text_data_en, "obj_readable_room3_142", "* 소 원 의  방 /%%");
ds_map_add(global.text_data_en, "obj_readable_room3_147", "* 인 간 에 게 는  약 점 이  있 다 .&* 모 순 적 이 게 도  그 것 은  바 로&  그 들 의  영 혼 의  힘 이 었 다 ./");
ds_map_add(global.text_data_en, "obj_readable_room3_148", "* 그  힘 으 로  영 혼 은 , 인 간 이&  죽 은  뒤 에 도  그  몸 을&  빠 져 나 와  존 재 할  수  있 다 ./%%");
ds_map_add(global.text_data_en, "obj_readable_room3_154", "* 예 외 가  하 나  있 는 데 ./");
ds_map_add(global.text_data_en, "obj_readable_room3_155", "* '보 스  몬 스 터 '라 고  불 리 는&  특 별 한  괴 물 들 의&  영 혼 이 다 ./");
ds_map_add(global.text_data_en, "obj_readable_room3_156", "* 보 스  몬 스 터 의  영 혼 은&  죽 은  뒤 에 도  남 아 있 을  정 도 로&  강 력 했 다 ./");
ds_map_add(global.text_data_en, "obj_readable_room3_157", "* 아 주  잠 시 동 안 이 겠 지 만 ./");
ds_map_add(global.text_data_en, "obj_readable_room3_158", "* 인 간 은  이  영 혼 을&  흡 수 할  수 도  있 었 을  것 이 다 .&* 하 지 만  그 런  일 은  없 었 다 ./");
ds_map_add(global.text_data_en, "obj_readable_room3_159", "* 앞 으 로 도  없 을  것 이 다 ./%%");
ds_map_add(global.text_data_en, "obj_readable_room3_165", "* 하 지 만  이  저 주 받 은  곳 엔&  들 어 올  곳 도 , 나 갈  곳 도&  없 다 ./");
ds_map_add(global.text_data_en, "obj_readable_room3_166", "* 인 간 이  이 곳 에  들 어 올  수&  있 는  방 법 은  없 다 ./");
ds_map_add(global.text_data_en, "obj_readable_room3_167", "* 우 린  이  아 래  영 원 히&  갇 혀  있 을  것 이 다 ./%%");
ds_map_add(global.text_data_en, "obj_readable_room3_175", "고전 명화야./");
ds_map_add(global.text_data_en, "obj_readable_room3_176", "늘 내게 삶에서&무엇이 중요한지를&일깨워 주지./%%");
ds_map_add(global.text_data_en, "obj_readable_room3_180", "* (만 화  속  뼈  그 림 이 다 .)/%%");
ds_map_add(global.text_data_en, "obj_readable_room3_195", "* (소 녀 가  그 물 을  움 직 일&  때 마 다 , 이  벌 레 는&  종 종 거 리 며  따 라 온 다 .)/%%");
ds_map_add(global.text_data_en, "obj_readable_room3_200", "* (뭔 가 에  대 한  쪽 지  같 다 ^1.&  하 지 만  전 부  개 발 새 발 인&  글 씨 다 .)/");
ds_map_add(global.text_data_en, "obj_readable_room3_201", "* (게 임  공 략 법 처 럼&  보 이 는 데 , 아 니 면 ...?)/%%");
ds_map_add(global.text_data_en, "obj_readable_room3_202", "* (너 무  어 두 워 서&  볼  수  없 다 .)/%%");
ds_map_add(global.text_data_en, "obj_readable_room3_207", "* (여 러  만 화 의&  비 디 오 와  DVD이 다 .)/");
ds_map_add(global.text_data_en, "obj_readable_room3_208", '* ("인 간 의  역 사 "라 는&  라 벨 이  붙 어  있 다 .)/%%');
ds_map_add(global.text_data_en, "obj_readable_room3_213", "* (특 히  평 균  사 이 즈 인&  싱 크 대 이 다 .)/%%");
ds_map_add(global.text_data_en, "obj_readable_room3_215", "* (너 무  어 두 워 서&  볼  수  없 다 .)/%%");
ds_map_add(global.text_data_en, "obj_readable_room3_222", "* 이 건  손  씻 는  쇼 가&  아 니 에 요 , 달 링 ./");
ds_map_add(global.text_data_en, "obj_readable_room3_223", "* 그 건  수 요 일 에  한 다 구 요 !/%%");
ds_map_add(global.text_data_en, "obj_readable_room3_228", "* 이 건  손  씻 는  쇼 가&  아 니 에 요 , 달 링 ./");
ds_map_add(global.text_data_en, "obj_readable_room3_229", "* 그 건  수 요 일 에  한 다 구 요 !/%%");
ds_map_add(global.text_data_en, "obj_readable_room3_242", "* 언 제  한  번 ^1, 알 피 스 의 ..^1.&* 어 ^1, 친 구 ??^1?&* 가  왔 었 어 ./ ");
ds_map_add(global.text_data_en, "obj_readable_room3_243", "\E4* 하 는  거 라 곤&  피 아 노  위 에  매 혹 적 으 로&  눕 는  것 밖 엔  없 었 지 .../");
ds_map_add(global.text_data_en, "obj_readable_room3_244", "\E5* 그 리 고  포 도 도&  먹 고 ./");
ds_map_add(global.text_data_en, "obj_readable_room3_245", "\E4* 그  녀 석  진 짜 로&  마 음 에  안  들 어 ./");
ds_map_add(global.text_data_en, "obj_readable_room3_246", "\E3* 그 래 도  그 놈&  생 활  방 식 은&  괜 찮 더 라 ./%%");
ds_map_add(global.text_data_en, "obj_readable_room3_248", "* 뭐 ^1?&* 너 한 테  세 레 나 데 는&  안  불 러 줄  거 야 ./%%");
ds_map_add(global.text_data_en, "obj_readable_room3_254", "* 실 험  기 록  제 3번 /");
ds_map_add(global.text_data_en, "obj_readable_room3_255", "* 하 지 만  살 아 있 는  괴 물 의&  영 혼 을  추 출 하 는  일 엔&  상 당 한  힘 이  필 요 하 다 ./");
ds_map_add(global.text_data_en, "obj_readable_room3_256", "* 터 무 니 없 기 도  하 지 만 ^1,&  무 엇 보 다  추 출 하 는  순 간&  영 혼 의  주 인 이  파 괴 된 다 ./");
ds_map_add(global.text_data_en, "obj_readable_room3_257", "* 그 리 고  인 간 의&  지 속 되 는  영 혼 과 는  달 리 .../");
ds_map_add(global.text_data_en, "obj_readable_room3_258", "* 괴 물 의  영 혼 은  대 부 분&  주 인 이  죽 는  즉 시&  사 라 진 다 ./");
ds_map_add(global.text_data_en, "obj_readable_room3_259", "* 괴 물 의  영 혼 을  지 속 시 킬&  수 만  있 다 면 .../%%");
ds_map_add(global.text_data_en, "obj_readable_room3_261", "* (꺼 진  것  같 다 .)/%%");
ds_map_add(global.text_data_en, "obj_readable_room3_266", "* (한  무 더 기 의  비 디 오 다 ^1.)&* (어 떤  만 화 가  대 부 분 이 다 .)/%%");
ds_map_add(global.text_data_en, "obj_readable_room3_272", "* 실 험  기 록  제 21번 /");
ds_map_add(global.text_data_en, "obj_readable_room3_273", "* 하 루  내 내  쓰 레 기 장 에 서&  보 내 고  있 다 ./");
ds_map_add(global.text_data_en, "obj_readable_room3_274", "* 내 게  어 울 리 는  곳 이 야 ./%%");
ds_map_add(global.text_data_en, "obj_readable_room3_275", "* (꺼 진  것  같 다 .)/%%");
ds_map_add(global.text_data_en, "obj_readable_room3_276", "* (너 무  어 두 워 서&  벽 이  보 이 지  않 는 다 .)/%%");
ds_map_add(global.text_data_en, "obj_readable_room3_286", "* (감 사  편 지 다 ^1.)&* (받 는  이 가  산 타 할 아 버 지 로&  되 어  있 다 .)/%%");
ds_map_add(global.text_data_en, "obj_readable_room3_291", "* (청 사 진 ^1.)&* (기 호 처 럼  쓰 여 진  것 들 을&  읽 을  수 가  없 다 ...)/");
ds_map_add(global.text_data_en, "obj_readable_room3_292", "* (...아 니 면  그 냥  글 씨 를&  못  쓰 는  건 가 .)/");
ds_map_add(global.text_data_en, "obj_readable_room3_293", "* (어 떤  이 상 한  기 계 와&  연 관 돼  있 는  것  같 다 .)/%%");
ds_map_add(global.text_data_en, "obj_readable_room3_303", "* 아 ..^1. 그 건  내  TV야 .../");
ds_map_add(global.text_data_en, "obj_readable_room3_304", "* 가 끔 ... 내 가  좋 아 하 는&  TV 프 로 그 램 을  보 는 데&  써 .../%%");
ds_map_add(global.text_data_en, "obj_readable_room3_308", "* (으 스 스 하 고  낡 은  TV 다 .)&* (버 튼 의  대 부 분 은&  닳 아  있 다 ...)/");
