ds_map_add(global.text_data_en, "obj_adate_1259", "\E1어 ..^1. 언 다 인 ^1!&난 ..^1. 그 냥 .../%%");
ds_map_add(global.text_data_en, "obj_adate_1271", "\F6야 ^1, 워 어 ^1,&잠 깐 만 !/");
ds_map_add(global.text_data_en, "obj_adate_1272", "옷  귀 엽 네 ^1!&누 구 랑  약 속 이 라 도&있 어 ?/");
ds_map_add(global.text_data_en, "obj_adate_1273", "\F0.\E0../");
