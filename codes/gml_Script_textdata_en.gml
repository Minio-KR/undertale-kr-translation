ds_map_add(global.text_data_en, "obj_woshua_536", "* 워 슈 아 는  당 신 의  끈 적 한&  몸 을  보 고  기 겁 했 다 !&* 워 슈 아 는  도 망 간 다 ./^");
ds_map_add(global.text_data_en, "obj_woshua_537", "* 워 슈 아 를  친 근 하 게&  도 닥 여  주 었 다 ./^");
ds_map_add(global.text_data_en, "obj_woshua_546", "* 워 슈 아 에 게  깨 끗 하 게&  해  달 라 고  부 탁 했 다 ^1.&* 워 슈 아 는  기 뻐  뛰 어 다 닌 다 ./^");
ds_map_add(global.text_data_en, "obj_woshua_547", "* 워 슈 아 는  계 속&  청 소 하 고  있 다 ./^");
ds_map_add(global.text_data_en, "obj_woshua_558", "* 당 신 은  진 흙 투 성 이  꽃&  정 원 에 서  놀 던  두  아 이 에&  대 한  농 담 을  했 다 /");
ds_map_add(global.text_data_en, "obj_woshua_559", "* 당 신 은  맨 손 으 로  파 이 를&  먹 은  아 이 에  대 한&  농 담 을  했 다 ./");
ds_map_add(global.text_data_en, "obj_woshua_560", "* 당 신 은  흙 바 닥 에 서  잠 든&  아 이 에  대 한  농 담 을  했 다 ./");
ds_map_add(global.text_data_en, "obj_woshua_561", "* 워 슈 아 의  힘 이  약 해 졌 다 !/^");
ds_map_add(global.text_data_en, "obj_woshuanpc_72", "* 모 든  게  다  더 러 워 ..^1.&* 모 든  걸  다  지 울  수  있 다 면 ^1,&  진 작 에  해  버 렸 을  거 야 ./");
ds_map_add(global.text_data_en, "obj_woshuanpc_73", "* 오 오 오 ^1.&* 오 해 하 진  마 ^1.&* 누 가  죽 는  건  원 치  않 아 ./");
ds_map_add(global.text_data_en, "obj_woshuanpc_74", "* 죽 으 면  먼 지 로  돌 아 가 서^1,&  더  치 우 기  힘 들 거 든 .../%%");
ds_map_add(global.text_data_en, "obj_woshuanpc_77", "* 먼 지 로  변 하 지  마 ./%%");
ds_map_add(global.text_data_en, "obj_woshuanpc_81", "* 지 상 이  날  위 협 하 는 군 ./");
ds_map_add(global.text_data_en, "obj_woshuanpc_82", "* 지 상 의  모 든  땅 은&  흙 으 로  이 루 어 져  있 잖 아 ./%%");
ds_map_add(global.text_data_en, "obj_woshuanpc_88", "* 난  쓰 레 기 를  모 조 리  씻 어 내 고&  대 칭 을  맞 춰  쌓 는 단  말 이 야 ./");
ds_map_add(global.text_data_en, "obj_woshuanpc_89", "* 고 되 지 만 ^1,&  누 군 가 는&  해 야  할  일 이 지 ./%%");
ds_map_add(global.text_data_en, "obj_woshuanpc_93", "* 여 기 로  그  더 러 운  발&  끌 고  오 지  마 ^1.&* 방 금  쓰 레 기 를  치 웠 다 고 !/%%");
ds_map_add(global.text_data_en, "obj_wrongnumbersong_96", "* (따 르 릉 ... 따 르 릉 ...)/");
ds_map_add(global.text_data_en, "obj_wrongnumbersong_97", "* 여 보 세 요 ^1!&* 혹 시  지 금  거 기  ㄱ .../");
ds_map_add(global.text_data_en, "obj_wrongnumbersong_98", "* ...&* 잠 깐 만 ./");
ds_map_add(global.text_data_en, "obj_wrongnumbersong_99", "* 전 화  잘 못  걸 었 나 요 ?/%%");
ds_map_add(global.text_data_en, "obj_wrongnumbersong_107", "* 오 , 잘 못  걸 었 네 ^1!&* 잘 못  건  노 래 !/");
ds_map_add(global.text_data_en, "obj_wrongnumbersong_108", "* 잘 못  걸 어 &  정 말  정 말  미 안 해 !/");
ds_map_add(global.text_data_en, "obj_wrongnumbersong_109", "* 오 , 잘 못  걸 었 네 ^1!&* 잘 못  건  노 래 !/");
ds_map_add(global.text_data_en, "obj_wrongnumbersong_110", "* 잘 못  걸 어 &  정 말  정 말  미 안 해 !/%%");
ds_map_add(global.text_data_en, "obj_wrongnumbersong_118", "* (삑 ...)/%%");
ds_map_add(global.text_data_en, "obj_xmastree_60", "* (정 성 스 럽 게  장 식 된&  트 리 다 .)/");
ds_map_add(global.text_data_en, "obj_xmastree_61", "* (선 물 들 은  산 타 로 부 터&  다 양 한  지 역 들 로&  주 소 가  쓰 여  있 다 .)/%%");
ds_map_add(global.text_data_en, "obj_xmastree_65", "* (당 신  건  없 다 .)/%%");
ds_map_add(global.text_data_en, "scr_battlegroup_116", "* 당 신 은  몰 드 스 멀&  대 열 에  걸 려 들 었 다 .");
ds_map_add(global.text_data_en, "scr_battlegroup_133", "* 프 로 깃  한  쌍 이&  앞 으 로  튀 어 나 왔 다 .");
ds_map_add(global.text_data_en, "scr_battlegroup_148", "* 몰 드 스 멀 과  몰 드 스 멀 이&  길 을  막 아 섰 다 .");
ds_map_add(global.text_data_en, "scr_battlegroup_163", "* 미 고 습 이  가 까 이  기 어 왔 다 !");
ds_map_add(global.text_data_en, "scr_battlegroup_207", "* 베 지 토 이 드 와  룩 스 가&  공 격 해 왔 다 !");
ds_map_add(global.text_data_en, "scr_battlegroup_342", "* 도 고 가  길 을  막 아 섰 다 !");
ds_map_add(global.text_data_en, "scr_battlegroup_445", "* 칠 드 레 이 크 가  어 슬 렁 거 리 며&  나 타 났 다 !");
ds_map_add(global.text_data_en, "scr_battlegroup_450", "* 스 노 우 드 레 이 크 가  날 아 왔 다 !");
ds_map_add(global.text_data_en, "scr_battlegroup_465", "* 칠 드 레 이 크 들 이  날 아 왔 다 !");
ds_map_add(global.text_data_en, "scr_itemdesc_2", "* 네 가  이 걸  읽 고  있 다 면 ,&  어 떻 게 든  난  망 한  거 야 ./%");
ds_map_add(global.text_data_en, "scr_papcall_7", "* 따 르 릉 ..^1. 따 르 릉 .../");
ds_map_add(global.text_data_en, "scr_papcall_8", "* (반 응 이  없 다 ...)/%%");
ds_map_add(global.text_data_en, "scr_papcall_17", "흠..^1.&숲속의 기묘한 문이라./");
ds_map_add(global.text_data_en, "scr_papcall_18", "\E0그러고 보니^1,&우리 형이 거기서&시간을 꽤 보내던데./");
ds_map_add(global.text_data_en, "scr_papcall_19", "\E3뭘 하는 거지...?/");
ds_map_add(global.text_data_en, "scr_papcall_20", "\E1잘 주시해야겠어!/%%");
ds_map_add(global.text_data_en, "scr_papcall_24", "아직도 그 문&근처에 있는 거야?/");
ds_map_add(global.text_data_en, "scr_papcall_25", "\E1안 돼!!^1!&내 형한테 물들었구나!/%%");
ds_map_add(global.text_data_en, "scr_papcall_31", "여기는 내 형이&순찰해야 하는 곳이야.../");
ds_map_add(global.text_data_en, "scr_papcall_32", "\E3하지만^1,&내가 올 때마다^1,&게으름을 피우고 있지./");
ds_map_add(global.text_data_en, "scr_papcall_33", "\E0널 내가 먼저 봐서&정말 다행이야!/");
ds_map_add(global.text_data_en, "scr_papcall_34", "\E3형이었더라면&분명 이상한 첫인상을&남겼을 거야./%%");
ds_map_add(global.text_data_en, "scr_papcall_39", "혹시 주변에 없다면^1,&다시 돌아오진 않을 거야.../");
ds_map_add(global.text_data_en, "scr_papcall_40", "\E3그게 형의&방식이니까./%%");
ds_map_add(global.text_data_en, "scr_papcall_46", "뭐??^1?&길을 잃었다고???/");
ds_map_add(global.text_data_en, "scr_papcall_47", "\E0흠..^1. 누군가에게 전화해서&도움을 요청해봐!/%%");
ds_map_add(global.text_data_en, "scr_papcall_52", "엥??^1?&왜 전화했어??/%%");
ds_map_add(global.text_data_en, "scr_papcall_58", "강에서 헤엄치기엔&너무 춥지./");
ds_map_add(global.text_data_en, "scr_papcall_59", "네가 방수 스웨터를&입고 있다면 모를까!/%%");
ds_map_add(global.text_data_en, "scr_papcall_65", "그건 그냥 강이야./%%");
ds_map_add(global.text_data_en, "scr_papcall_71", "녜 헤 헤!^1!&정말 멋지지!?!/");
ds_map_add(global.text_data_en, "scr_papcall_72", "난 퍼즐에만&능한 게 아냐.../");
ds_map_add(global.text_data_en, "scr_papcall_73", "존경받는&건축가라구!!!/%%");
ds_map_add(global.text_data_en, "scr_papcall_79", "내 형이 상자 찾는 걸&도와줬어!/%%");
ds_map_add(global.text_data_en, "scr_papcall_85", "도고의 초소야./");
ds_map_add(global.text_data_en, "scr_papcall_86", "도고는 움직이는 걸&보는 데에 엄청난&능력이 있어./");
ds_map_add(global.text_data_en, "scr_papcall_87", "\E3그래^1, 아무래도&별로 엄청난 능력은&아닌 것 같다./%%");
ds_map_add(global.text_data_en, "scr_papcall_93", "도고는 집에 없어./%%");
ds_map_add(global.text_data_en, "scr_papcall_100", "조심해!^1!&얼음 위는 미끄러워./");
ds_map_add(global.text_data_en, "scr_papcall_101", "\E0하지만 얼음 위를&미끄러질 땐^1, 아무도&공격하지 않을 거야./");
ds_map_add(global.text_data_en, "scr_papcall_102", "\E3멋진 기술을 쓰다&엉덩방아를 찧긴&싫을 테니까./%%");
ds_map_add(global.text_data_en, "scr_papcall_108", "추워서 할 말이&생각이 안 나네./%%");
ds_map_add(global.text_data_en, "scr_papcall_114", "눈사람으로 사는 건&힘들 것 같아./");
ds_map_add(global.text_data_en, "scr_papcall_115", "\E2이상한 걸로 된&사람들한테 잘 해줘./%%");
ds_map_add(global.text_data_en, "scr_papcall_121", "그 눈사람&아직도 거기 있어?/%%");
ds_map_add(global.text_data_en, "scr_papcall_127", "오 호^1!&전기 미로^1!&그것 참 재밌었지!/");
ds_map_add(global.text_data_en, "scr_papcall_128", "\E3내가 감전되기&전까진 말이야./%%");
ds_map_add(global.text_data_en, "scr_papcall_133", "오 호^1!&전기 미로^1!&멋진 퍼즐이지!!/");
ds_map_add(global.text_data_en, "scr_papcall_134", "\E3우리가 하지도&않았던 것만&빼면 말이야./");
ds_map_add(global.text_data_en, "scr_papcall_135", "\E0그 사소한 점만 빼면^1,&10점 만점에 10점이지!/%%");
ds_map_add(global.text_data_en, "scr_papcall_141", "좀 실망했겠지만^1, 내가&전기를 꺼 버렸어./%%");
ds_map_add(global.text_data_en, "scr_papcall_149", "그 유명한&스노우딘 스노우볼&게임이지./");
ds_map_add(global.text_data_en, "scr_papcall_150", "빠르게 끝낼수록&다른 보상을 줘./");
ds_map_add(global.text_data_en, "scr_papcall_151", "\E3돈은 어디에서&나는 거냐고?/");
ds_map_add(global.text_data_en, "scr_papcall_152", "\E0당연히, 눈 뭉치^1,&세금에서 나오지!!/%%");
ds_map_add(global.text_data_en, "scr_papcall_157", "뭐?^1?&눈 뭉치 세금이란 거&들어본 적 없다고?/");
ds_map_add(global.text_data_en, "scr_papcall_158", "\E2지상은 분명&천국인가봐.../%%");
ds_map_add(global.text_data_en, "scr_papcall_166", "결혼한 개들의&초소.../");
ds_map_add(global.text_data_en, "scr_papcall_167", "\E3흠^1. 한번이라도&생각해본 적 있어?/");
ds_map_add(global.text_data_en, "scr_papcall_168", "\E0개랑 결혼하는 것 말야./%%");
ds_map_add(global.text_data_en, "scr_papcall_173", "에..^1.&그거 이상하지 않아./");
ds_map_add(global.text_data_en, "scr_papcall_174", "\E0결혼하기에&더 나은 동물들이&많은데 말이야./");
ds_map_add(global.text_data_en, "scr_papcall_175", "해골이라든가!!!/%%");
ds_map_add(global.text_data_en, "scr_papcall_182", "흠... 십자말풀이^1.&그것 참 적절한&이름인 것 같아./");
ds_map_add(global.text_data_en, "scr_papcall_183", "\E4날 십자가에&못박아 버리는 것&같거든!!!/%%");
ds_map_add(global.text_data_en, "scr_papcall_188", "설마 아직도&단어찾기 퍼즐&보고 있는 거야?/%%");
ds_map_add(global.text_data_en, "scr_papcall_195", "아^1, 스파게티&함정 방.../");
ds_map_add(global.text_data_en, "scr_papcall_196", "오류????/%%");
ds_map_add(global.text_data_en, "scr_papcall_199", "\E3시간내서 가 봐야&하는데.../");
ds_map_add(global.text_data_en, "scr_papcall_200", "\E2네가 나한테&남겨준 스파게티&아직도 있으니까!!!/%%");
ds_map_add(global.text_data_en, "scr_papcall_204", "\E3음^1, 이젠 딱히&함정은 아니지./");
ds_map_add(global.text_data_en, "scr_papcall_205", "\E0네가 전부&먹어버렸으니까^1,&그렇지!?/%%");
ds_map_add(global.text_data_en, "scr_papcall_211", "뜨끈한 스파게티&만한 게 없지.../%% ");
ds_map_add(global.text_data_en, "scr_papcall_218", "이 방은&원래 저 가시들로&막혀 있어./");
ds_map_add(global.text_data_en, "scr_papcall_219", "\E3하지만 없애&버려야 하나 생각중이야.../");
ds_map_add(global.text_data_en, "scr_papcall_220", "\E0왕이 최근에&퍼즐에 대한&지시를 내렸거든./");
ds_map_add(global.text_data_en, "scr_papcall_221", "\E3가시가 비효율적이고&아이들에게 위험하다나./");
ds_map_add(global.text_data_en, "scr_papcall_222", "\E4하지만 난 그게&틀렸다고 봐!!!/");
ds_map_add(global.text_data_en, "scr_papcall_223", "\E0아이들은 위험한 가시를&좋아한다고!!!/%%");
ds_map_add(global.text_data_en, "scr_papcall_228", "아는 아이들 있으면^1,&한번 물어봐!!!/%%");
ds_map_add(global.text_data_en, "scr_papcall_234", "으음..^1.&그래서 해결책&말이지...?/");
ds_map_add(global.text_data_en, "scr_papcall_235", "\E5난 그냥&가시들을&뛰어넘었는데./");
ds_map_add(global.text_data_en, "scr_papcall_236", "\E0그러니까 해결책은&아주 크고 멋져야&한다는 거지./%%");
ds_map_add(global.text_data_en, "scr_papcall_241", "지금 말하면서도&난 이걸 풀고 있거든.../%%");
ds_map_add(global.text_data_en, "scr_papcall_248", "오-호!!^1!&그 퍼즐^1!/");
ds_map_add(global.text_data_en, "scr_papcall_249", "너 그거 아주&쉽게 풀었었지!!/");
ds_map_add(global.text_data_en, "scr_papcall_250", "\E2너 정말 엄청&파피루스스러웠어./%%");
ds_map_add(global.text_data_en, "scr_papcall_255", "전화 통화를 하다니..^1.&정말 파피루스스러워./%%");
ds_map_add(global.text_data_en, "scr_papcall_262", "오-호!!^1! 알피스 박사가&만든 퍼즐!/");
ds_map_add(global.text_data_en, "scr_papcall_263", "박사에게 만들어달라고&언다인에게&부탁해야 했지./");
ds_map_add(global.text_data_en, "scr_papcall_264", "\E3박사와는 온라인&친추밖에 안 되어&있거든.../");
ds_map_add(global.text_data_en, "scr_papcall_265", "\E3걔랑은 진짜로&친구는 아니야.../");
ds_map_add(global.text_data_en, "scr_papcall_266", "\E0아직까진 말이지!!!!!/%%");
ds_map_add(global.text_data_en, "scr_papcall_271", "언젠가 내 우람한&이두박근으로 멋진&인상을 남겨줄 거야.../");
ds_map_add(global.text_data_en, "scr_papcall_272", "\E0친구를 사귀는&훌륭한 방법이지!!!/%%");
ds_map_add(global.text_data_en, "scr_papcall_278", "레서 도그의 초소야./");
ds_map_add(global.text_data_en, "scr_papcall_279", "이 멍멍이는&누가 어루만져주는 걸&아주 좋아해./");
ds_map_add(global.text_data_en, "scr_papcall_280", "녀석들의 특징이 다 그래./");
ds_map_add(global.text_data_en, "scr_papcall_281", "\E3잠깐^1, 왜 쟤들은&왕실 근위병이고&나는 아닌 거야!?/");
ds_map_add(global.text_data_en, "scr_papcall_282", "\E0나도 쓰다듬 좋아해!!!/%%");
ds_map_add(global.text_data_en, "scr_papcall_287", "하아..^1.&이건 인기 대회일 뿐이야./%%");
ds_map_add(global.text_data_en, "scr_papcall_293", "그때 너를 기다리는 게&지겨워져서.../");
ds_map_add(global.text_data_en, "scr_papcall_294", "\E0나는 눈-파피루스를&만들었지!/");
ds_map_add(global.text_data_en, "scr_papcall_295", "\E3그리고 샌즈 형도...&뭔가 하긴 했어./%%");
ds_map_add(global.text_data_en, "scr_papcall_300", "사실^1, 그게 형치곤&그나마 제일&잘 만든 거야./%%");
ds_map_add(global.text_data_en, "scr_papcall_306", "나는 늘 퍼즐을&풀기보단 그냥&뛰어넘어 버렸지./");
ds_map_add(global.text_data_en, "scr_papcall_307", "샌즈 형도 절대 퍼즐을&풀지 않아./");
ds_map_add(global.text_data_en, "scr_papcall_308", "\E3형은 항상 그냥..^1.&어.../");
ds_map_add(global.text_data_en, "scr_papcall_309", "지나가./%%");
ds_map_add(global.text_data_en, "scr_papcall_314", "내 생각엔 형한테는&지름길이나 그런 게&있는 것 같아./%%");
ds_map_add(global.text_data_en, "scr_papcall_321", "기프트롯은 이 근처에 살아^1.&걔는 선물을 좋아해./");
ds_map_add(global.text_data_en, "scr_papcall_322", "\E3근사한 선물을&줄 수 없더라도&걱정하지 마./");
ds_map_add(global.text_data_en, "scr_papcall_323", "\E3중요한 건&마음이니까./");
ds_map_add(global.text_data_en, "scr_papcall_324", "그러니 네가 많은 돈을&가지고 있다고&상상해 봐.../%%");
ds_map_add(global.text_data_en, "scr_papcall_329", "기프트롯은 만나 봤어?/%%");
ds_map_add(global.text_data_en, "scr_papcall_336", "신호가 점점&약해지고 있어./");
ds_map_add(global.text_data_en, "scr_papcall_337", "\E3거기선 휴대폰이&잘 안 터지나 봐./");
ds_map_add(global.text_data_en, "scr_papcall_338", "\E0그러니 더 멀리 갈&이유가 없잖아?/%%");
ds_map_add(global.text_data_en, "scr_papcall_343", "안녕./%%");
ds_map_add(global.text_data_en, "scr_papcall_349", "그레이터 도그의&초소야./");
ds_map_add(global.text_data_en, "scr_papcall_350", "\E3그 개 어째&내가 안 좋아하는&개랑 닮았단 말야./");
ds_map_add(global.text_data_en, "scr_papcall_351", "\E0그치만 그레이터 도그는&아무것도 훔치지 않아./");
ds_map_add(global.text_data_en, "scr_papcall_352", "\E2그 개는 그냥&애정 절도광일&뿐이라고!/%%");
ds_map_add(global.text_data_en, "scr_papcall_357", "더 많은 포옹과&쓰다듬을 훔쳐가고&싶어할 뿐이야./%%");
ds_map_add(global.text_data_en, "scr_papcall_363", "그 다리는 위험해&보여도^1, 아주&안정적이야./");
ds_map_add(global.text_data_en, "scr_papcall_364", "사실^1, 그거 내가&바위 위에다&칠해 놓은 거야./");
ds_map_add(global.text_data_en, "scr_papcall_365", "저 길이 더&극적으로 보이도록&말이야./%%");
ds_map_add(global.text_data_en, "scr_papcall_370", "밧줄도 달아 뒀다고^1, 흠./%%");
ds_map_add(global.text_data_en, "scr_papcall_376", "스노우딘..^1.&파피루스의 고향!/");
ds_map_add(global.text_data_en, "scr_papcall_377", "\E3그게 슬로건이어야지^1,&그치???/%%");
ds_map_add(global.text_data_en, "scr_papcall_382", "슬로건을 바꾸자고&항의하고 있어./%%");
ds_map_add(global.text_data_en, "scr_papcall_389", "저 털복숭이는&하루 종일 얼음을&던지고 있어./");
ds_map_add(global.text_data_en, "scr_papcall_390", "이게 어디로 가는지&아무도 모르지./%%");
ds_map_add(global.text_data_en, "scr_papcall_394", "저 털복숭이는&하루 종일 얼음을&던지고 있어./");
ds_map_add(global.text_data_en, "scr_papcall_395", "이게 어디로 가는지&아무도 모르지./");
ds_map_add(global.text_data_en, "scr_papcall_397", "* 야 ^1, 나  알 아 ^1!&* 알 피 스 가  말 해 줬 는 데 .../");
ds_map_add(global.text_data_en, "scr_papcall_398", "* 이 게  핫 랜 드 로&  가 서  코 어 를&  식 혀  준 대 !/");
ds_map_add(global.text_data_en, "scr_papcall_400", "와우^1, 언다인!^1!&네가 그런 덕스러운 걸&좋아하는 줄 몰랐어!/");
ds_map_add(global.text_data_en, "scr_papcall_401", "\E3그저 힘과 싸움이&전부인 줄 알았는데.../");
ds_map_add(global.text_data_en, "scr_papcall_403", "\E0* 지 금  장 난 해 !?&* 내 가  왜 ???/");
ds_map_add(global.text_data_en, "scr_papcall_404", "\E6* 뇌 가  모 든  근 육  중&  가 장  크 거 든 !!!/%%");
ds_map_add(global.text_data_en, "scr_papcall_410", "매혹적이지^1, 안 그래???/%%");
ds_map_add(global.text_data_en, "scr_papcall_416", "여관은 정말&머물기 좋은 곳이지./");
ds_map_add(global.text_data_en, "scr_papcall_417", "여관을 운영하는 분이&굉장히 좋은 사람이야./");
ds_map_add(global.text_data_en, "scr_papcall_418", "\E2늘 내게 막대사탕을&주고 머리를&쓰다듬어 주거든./%%");
ds_map_add(global.text_data_en, "scr_papcall_423", "왜 전화한 거야?/");
ds_map_add(global.text_data_en, "scr_papcall_424", "\E0예약이라도&하려는 거야???/%%");
ds_map_add(global.text_data_en, "scr_papcall_430", "* 야 ^1, 내 가  스 노 우 딘 에&  갈  때 면  늘  그 곳 에&  가 서  잔 다 고 !/");
ds_map_add(global.text_data_en, "scr_papcall_431", "\E4* 파 피 루 스 네 가  더&  익 숙 하 긴  하 지 만 ^1,&  그 래 도 .../");
ds_map_add(global.text_data_en, "scr_papcall_432", "\E1* 걔 네  소 파 는  뭐 랄 까 ^1,&  울 퉁 불 퉁 하 고&  삐 걱 거 리 잖 아 ?/");
ds_map_add(global.text_data_en, "scr_papcall_433", "\E5* 그 리 고  걔 네  형 은&  야 식 을  수 백 개 는&  쌓 아  댔 다 니 깐 ./%%");
ds_map_add(global.text_data_en, "scr_papcall_434", "\E2* 파 피 루 스 는&  안  그 런  줄  알 아 ??^1?&* 걔 가  잠 을  어 떻 게  잘 까 ?/%%");
ds_map_add(global.text_data_en, "scr_papcall_439", "* 그 래 ^1, 그 냥  거 기 서 &  자 는  게  나 아 ./%%");
ds_map_add(global.text_data_en, "scr_papcall_448", "그릴비네라...&기름기로 가득 찬&어두운 곳이지./");
ds_map_add(global.text_data_en, "scr_papcall_449", "감자튀김의 연옥이자..^1.&햄버거의 심연.../");
ds_map_add(global.text_data_en, "scr_papcall_450", "어쨌든^1, 내 형이 거의&거기서 살다시피&하니까./%%");
ds_map_add(global.text_data_en, "scr_papcall_455", "그릴비네로&가지는 않을 거야./%%");
ds_map_add(global.text_data_en, "scr_papcall_461", "그릴비네라고^1?&기름범벅 구덩이엔&고상한 우린 안 가./");
ds_map_add(global.text_data_en, "scr_papcall_463", "* 이 야 ^1, 거 기  간 다 면 ^1,&  치 즈  감 자 튀 김 은&  꼭  먹 어 봐 야  해 ./");
ds_map_add(global.text_data_en, "scr_papcall_464", "\E6* 네  몸 에  엄 청 나 게&  안  좋 거 든 !!/");
ds_map_add(global.text_data_en, "scr_papcall_465", "\E9* 아 ^1, 미 안 해 ^1, 파 피 루 스 ^1,&  무 슨  말  하 려 고&  했 지 ?/");
ds_map_add(global.text_data_en, "scr_papcall_467", "기름기를 향한&내 사랑을 되뇌인&것 뿐이야!!!/%%");
ds_map_add(global.text_data_en, "scr_papcall_472", "기름기를 향한&우리의 감정은&강물처럼 깊게 흐르지./");
ds_map_add(global.text_data_en, "scr_papcall_474", "* 기 름 기 야 ^1... 나 .../");
ds_map_add(global.text_data_en, "scr_papcall_475", "\E8* 난 ..^1.&* .../");
ds_map_add(global.text_data_en, "scr_papcall_476", "\E6* 내  음 식  전 부 에&  네 가  있 어  줬 으 면&  좋 겠 어 !!/%%");
ds_map_add(global.text_data_en, "scr_papcall_487", "난 도서관 좋아해^1.&책들이 색깔에 따라&나뉘어 있잖아./");
ds_map_add(global.text_data_en, "scr_papcall_488", "\E4이 질서란!!^1!&힘이 솟아나는&것 같아!/%%");
ds_map_add(global.text_data_en, "scr_papcall_493", "도서관 카드가 뭐야?/%%");
ds_map_add(global.text_data_en, "scr_papcall_499", "* 어 렸 을  적 엔&  책 을  충 분 히  &  접 하 지  못 했 어 ./");
ds_map_add(global.text_data_en, "scr_papcall_500", "\E9* 그 냥  전 부&  찢 어 버 렸 거 든 !/");
ds_map_add(global.text_data_en, "scr_papcall_501", "\E1* 엄 청  뜯 어 버 렸 다 니 깐 !/");
ds_map_add(global.text_data_en, "scr_papcall_502", "\E6* 조 각 조 각&  작 살 을  냈 지 !/%%");
ds_map_add(global.text_data_en, "scr_papcall_507", "* 지 금 은  읽 는 다 는  건&  멋 있 는  것  같 아 ./%%");
ds_map_add(global.text_data_en, "scr_papcall_516", "와우^1! 나한테 전화&거는 데 4초밖에&안 걸렸어!/");
ds_map_add(global.text_data_en, "scr_papcall_517", "분명 내 도움이&절실했나 보구나!!!/");
ds_map_add(global.text_data_en, "scr_papcall_518", "자^1! 무서워하지 마^1!&파피루스의 훈훈한&상담 서비스니까!/");
ds_map_add(global.text_data_en, "scr_papcall_519", "그냥&네 위치를 확인하고^1,&그 다음엔...!/");
ds_map_add(global.text_data_en, "scr_papcall_520", "몇 가지 팁을&알려줄게!/");
ds_map_add(global.text_data_en, "scr_papcall_521", "\E0그래서^1, 지금&어디야?/");
ds_map_add(global.text_data_en, "scr_papcall_522", "\E3.../");
ds_map_add(global.text_data_en, "scr_papcall_523", "\E5... 아직도&내 방에 있어?/");
ds_map_add(global.text_data_en, "scr_papcall_524", "\E3.../");
ds_map_add(global.text_data_en, "scr_papcall_525", "\E3혹시 문..^1. 이라고&부르는 걸&들어본 적 있어?/");
ds_map_add(global.text_data_en, "scr_papcall_526", "\E0잠깐^1! 걱정하지 마^1!&내가 널 위해서&그림을 그려 줄게!/%%");
ds_map_add(global.text_data_en, "scr_papcall_531", "기다려^1!&아직 그리는&중이라고!/%%");
ds_map_add(global.text_data_en, "scr_papcall_537", "엥^1? 지금쯤이면&방에서 나갈 줄&알았는데./");
ds_map_add(global.text_data_en, "scr_papcall_538", "\E1원점에서&다시 시작해야&할 것 같군!/");
ds_map_add(global.text_data_en, "scr_papcall_539", "\E0첫 번째: 당신은&파피루스가 누군지&알고 있습니까!?/%%");
ds_map_add(global.text_data_en, "scr_papcall_544", "내가 파피루스가&누군지 알던가!?/%%");
ds_map_add(global.text_data_en, "scr_papcall_554", "내 집에 있구나^1.&좋은 선택이야!/");
ds_map_add(global.text_data_en, "scr_papcall_555", "\E3따지고 보면&샌즈 형의 집이기도&하지만 말이야./");
ds_map_add(global.text_data_en, "scr_papcall_556", "\E1그래도 샌즈 형의&공간을 얘기하고&싶지는 않아./");
ds_map_add(global.text_data_en, "scr_papcall_557", "\E3샌즈 형의 방은..^1.&마치 다른 세상&같다고!/");
ds_map_add(global.text_data_en, "scr_papcall_558", "\E2청소라는 걸&할 줄 모르는&세상이지./%%");
ds_map_add(global.text_data_en, "scr_papcall_563", "그 이상한 곳에서&멀찍이 떨어지는 게&너한테 좋을 거야./%%");
ds_map_add(global.text_data_en, "scr_papcall_572", "여긴 내가 널&잡으려고 했던&곳이네!/");
ds_map_add(global.text_data_en, "scr_papcall_573", "참 안 좋은&기억이지!/%%");
ds_map_add(global.text_data_en, "scr_papcall_578", ".../%%");
ds_map_add(global.text_data_en, "scr_papcall_584", "* 예 아 !^1! 여 기 는&  스 노 우 -레 슬 링  하 기&  최 고 의  장 소 야 !!/");
ds_map_add(global.text_data_en, "scr_papcall_586", "스노우-레슬링은&언다인이 네 뒤에&숨은 다음에.../");
ds_map_add(global.text_data_en, "scr_papcall_587", "너에게 태클을 걸고&'스노우-레슬링!' 이라고&외치는 게임이야./");
ds_map_add(global.text_data_en, "scr_papcall_588", "\E5별로..^1.&재밌는 게임은&아니야./");
ds_map_add(global.text_data_en, "scr_papcall_590", "\E9* 글 쎄 ^1, 내  생 각 은&  어 떤 지  알 아 ?/");
ds_map_add(global.text_data_en, "scr_papcall_592", "어떤데?/");
ds_map_add(global.text_data_en, "scr_papcall_594", "* 스 노 우 -레 슬 링 !!/");
ds_map_add(global.text_data_en, "scr_papcall_596", "안돼에에에에!!/%%");
ds_map_add(global.text_data_en, "scr_papcall_601", "* 우 리 도  언 젠 간&  해 야  할  거 야 !/%%");
ds_map_add(global.text_data_en, "scr_papcall_610", "워터폴..^1.&그곳에 대해선&아는 게 거의 없어./");
ds_map_add(global.text_data_en, "scr_papcall_611", "\E0하지만&최선을 다해서&알려 줄게!!!/%%");
ds_map_add(global.text_data_en, "scr_papcall_616", "어^1, 이 방에&대해서는&아는 게 없어./%%");
ds_map_add(global.text_data_en, "scr_papcall_622", "* 스 노 우 딘 에  가 는&  거 라 면 ^1, 알 려 줄  건&  많 이  없 겠 네 ./");
ds_map_add(global.text_data_en, "scr_papcall_624", "그럼 내가 알려주지!!/");
ds_map_add(global.text_data_en, "scr_papcall_626", "* 그 러 니 까 ^1,&  문 제 가  있 는  거 지 , 응 ?/");
ds_map_add(global.text_data_en, "scr_papcall_628", "뭣!^1?&문제가 생겼다고^1?&어디!?!?/");
ds_map_add(global.text_data_en, "scr_papcall_630", "* 당 연 히 ^1,&  스 노 우 딘 에 서 지 !!!/%%");
ds_map_add(global.text_data_en, "scr_papcall_635", "그 문제를 반드시&찾아내고 말겠어./");
ds_map_add(global.text_data_en, "scr_papcall_637", "* 야 ^1, 나  뭔 가&  찾 은  것  같 아 !/");
ds_map_add(global.text_data_en, "scr_papcall_639", "아^1, 어디?/");
ds_map_add(global.text_data_en, "scr_papcall_640", "\E5그나저나 왜 그렇게&아프게 쥐어박는 거야?/");
ds_map_add(global.text_data_en, "scr_papcall_642", "* 이 게&  문 젯 거 리 였 지 롱 !!!/%%");
ds_map_add(global.text_data_en, "scr_papcall_660", "우리 형 초소가&여기 있어./");
ds_map_add(global.text_data_en, "scr_papcall_661", "\E3그래^1, 형은 초소를&동시에 두 개&운영하지./");
ds_map_add(global.text_data_en, "scr_papcall_662", "\E0엄청나지^1, 안 그래?/");
ds_map_add(global.text_data_en, "scr_papcall_663", "평소보다 두 배로&게으름을 피운다고!!/%%");
ds_map_add(global.text_data_en, "scr_papcall_668", "그런 게으름뱅이가&되는 건 평범한&사람들에겐 꿈일 뿐../%%");
ds_map_add(global.text_data_en, "scr_papcall_674", "* 파 피 루 스 의  형 네&  초 소 야 ./");
ds_map_add(global.text_data_en, "scr_papcall_675", "\E4* 항 상  게 으 름&  피 우 거 나 ^1, 자 고  있 지 .../");
ds_map_add(global.text_data_en, "scr_papcall_676", "\E2* 하 지 만  딱  해 고&  안  해 도  될 만 큼&  좋 은  결 과 를  낸 다 고 ./");
ds_map_add(global.text_data_en, "scr_papcall_677", "\E4* 흠 ^1, 오 늘 은  아 니 고 ./");
ds_map_add(global.text_data_en, "scr_papcall_678", "\E2* 샌 즈 는  너 에  대 해 선&  아 무 것 도  말&  안  해 줬 으 니 ./%%");
ds_map_add(global.text_data_en, "scr_papcall_683", "\E4* 그 냥  틈 만  나 면&  뭘  야 금 야 금&  먹 고  있 었 다 니 깐 .../");
ds_map_add(global.text_data_en, "scr_papcall_684", "\E9* 그 거  나 름 대 로&  대 단 한 걸 지 도 ...?/%%");
ds_map_add(global.text_data_en, "scr_papcall_693", "돌덩이들?/");
ds_map_add(global.text_data_en, "scr_papcall_694", "\E0언다인의 무식한&퍼즐이겠네./");
ds_map_add(global.text_data_en, "scr_papcall_695", "\E0조심하는 게&좋을 걸!/%%");
ds_map_add(global.text_data_en, "scr_papcall_700", "돌을 경계해야 해./%%");
ds_map_add(global.text_data_en, "scr_papcall_706", "* 으 어 ^1, 내 가  이  방 에&  퍼 즐 을  설 치 해 야&  했 지 만 .../");
ds_map_add(global.text_data_en, "scr_papcall_707", "\E2* 난  퍼 즐 이&  엄 청  싫 어 ./");
ds_map_add(global.text_data_en, "scr_papcall_708", "\E6* 그 래 서  그 냥  상 류 에&  커 다 란  돌 무 더 기 를&  만 들 어  뒀 지 ./%%");
ds_map_add(global.text_data_en, "scr_papcall_714", "* 뭐 ??^1?&* 뭐 라 고  하 지  마 !!!/");
ds_map_add(global.text_data_en, "scr_papcall_715", "\E6* 내 가  창 의 성 이&  부 족 해 서  네  인 생 이&  편 해 지 는  거 라 고 !/%%");
ds_map_add(global.text_data_en, "scr_papcall_722", "* 따 르 릉 ..^1. 따 르 릉 .../");
ds_map_add(global.text_data_en, "scr_papcall_723", "* (반 응 이  없 다 ...)/%%");
ds_map_add(global.text_data_en, "scr_papcall_731", "어디로 간 거야!?&너 안 보여!!!/");
ds_map_add(global.text_data_en, "scr_papcall_732", "\E0아 맞다^1, 전화기&너머에 있으니까&그렇구나./%%");
ds_map_add(global.text_data_en, "scr_papcall_737", "아직도 전화기&너머에 있니?/%%");
ds_map_add(global.text_data_en, "scr_papcall_743", "* 그 래 ,&  폭 포  뒤 에  있 는&  방 을  찾 았 군 .../");
ds_map_add(global.text_data_en, "scr_papcall_744", "\E0* 휴 식 이  필 요 할  때 면 ^1,&  거 기 서  쉬 곤  하 지 ./");
ds_map_add(global.text_data_en, "scr_papcall_745", "\E1* 절 대  안  간 단  말 이 야 !^1!&* 난  쉬 는  게  싫 어 !!/%%");
ds_map_add(global.text_data_en, "scr_papcall_750", "* 난  화 나 고&  스 트 레 스  받 은&  상 태 가  좋 다 고 !!!/");
ds_map_add(global.text_data_en, "scr_papcall_751", "\E0* 아 ^1, 농 담 이 야 ./%%");
ds_map_add(global.text_data_en, "scr_papcall_757", "* 따 르 릉 ..^1. 따 르 릉 .../");
ds_map_add(global.text_data_en, "scr_papcall_758", "* (반 응 이  없 다 ...)/%%");
ds_map_add(global.text_data_en, "scr_papcall_766", "세에상에^1, 나 거기&있었을 때 되게&쫄았다고./");
ds_map_add(global.text_data_en, "scr_papcall_767", "\E0그때 네가 없어서&다행이야!!/%%");
ds_map_add(global.text_data_en, "scr_papcall_772", "넌 날 정말로&못 봤지!/");
ds_map_add(global.text_data_en, "scr_papcall_773", "난 그 사실을&좋아하고^1, 반복해서&말하는 게 좋아!/%%");
ds_map_add(global.text_data_en, "scr_papcall_779", "* 내 가  널  처 음&  발 견 했 던  방 이 야 ./");
ds_map_add(global.text_data_en, "scr_papcall_780", "\E2* 내 가  창 을  얼 마 나&  많 이  던 지 고 팠 는 지&  모 를  걸 !!!/");
ds_map_add(global.text_data_en, "scr_papcall_781", "\E9* 하 지 만 ^1, 그  해 초 들 은 -&  과 학 적 인  연 유 로&  보 호 되 고  있 거 든 ./%%");
ds_map_add(global.text_data_en, "scr_papcall_786", "* 뭐 !!!!^1!&* 진 짜 라 고 !/%%");
ds_map_add(global.text_data_en, "scr_papcall_792", "* 따 르 릉 ..^1. 따 르 릉 .../");
ds_map_add(global.text_data_en, "scr_papcall_793", "* (반 응 이  없 다 ...)/%%");
ds_map_add(global.text_data_en, "scr_papcall_801", "다리꽃 씨앗&네 개를 일렬로 놓으면&다리가 자라나./");
ds_map_add(global.text_data_en, "scr_papcall_802", "\E3하지만&그 실용성에는&한계가 있지./");
ds_map_add(global.text_data_en, "scr_papcall_803", "\E2왜 비행기 꽃은&없냔 말이야???/%%");
ds_map_add(global.text_data_en, "scr_papcall_808", "아니면^1, 제트기로&변하는 핸드폰은???/%%");
ds_map_add(global.text_data_en, "scr_papcall_814", "* 잠 깐 ^1, 너  정 말 로&  퍼 즐 을  푼  거 야 !?/");
ds_map_add(global.text_data_en, "scr_papcall_815", "\E2* 그 냥  뛰 어 넘 어&  갈  수  없 어 !?/");
ds_map_add(global.text_data_en, "scr_papcall_816", "\E6* 폴 짝 팔 짝&  뛰 는  것 도  못  해 !?/%%");
ds_map_add(global.text_data_en, "scr_papcall_821", "* 풀 쩍 펄 쩍&  점 프  못  해 !?/%%");
ds_map_add(global.text_data_en, "scr_papcall_830", "흠..^1. 이 퍼즐.../");
ds_map_add(global.text_data_en, "scr_papcall_831", "\E0알겠다!!!/");
ds_map_add(global.text_data_en, "scr_papcall_832", "다리꽃 씨앗으로&다리를 만들어 봐!!/%%");
ds_map_add(global.text_data_en, "scr_papcall_837", "나 참 도움되지 않니./%%");
ds_map_add(global.text_data_en, "scr_papcall_843", "* 알 피 스 가  이  퍼 즐&  진 흙 타 일  설 계 에&  도 움 을  줬 어 ./");
ds_map_add(global.text_data_en, "scr_papcall_844", "* 일 은  꽤  힘 들 었 지 만 ^1,&  다  하 고  나 서&  모 래 성 을  지 었 어 ./");
ds_map_add(global.text_data_en, "scr_papcall_845", "\E9* 우 린  멋 진  팀 이 었 지 ^1.&* 알 피 스 는&  모 래 성 을  잘  짓 고 .../");
ds_map_add(global.text_data_en, "scr_papcall_846", "\E6* 그 리 고  난  그 걸&  엄 청  잘  부 쉈 으 니 !!!/%%");
ds_map_add(global.text_data_en, "scr_papcall_851", "* 지 금 쯤 이 면  흔 적 조 차&  남 아 있 지  않 겠 지 .../%%");
ds_map_add(global.text_data_en, "scr_papcall_861", "벤치 하나를 가득&채울 만큼의 키슈보다&좋은 게 뭐게?/%%");
ds_map_add(global.text_data_en, "scr_papcall_866", "* 벤 치  하 나 를  가 득&  채 울  만 큼 의  키 슈 보 다&  좋 은  게  뭐 게 ?/%%");
ds_map_add(global.text_data_en, "scr_papcall_876", "\E3소원 비는 방이야^1.&소원 있어...?/");
ds_map_add(global.text_data_en, "scr_papcall_877", "\E0녜 헤 헤!^1!&난 있지!!!/");
ds_map_add(global.text_data_en, "scr_papcall_878", "\E2내가 멋진 친구랑&얘기하고 있었으면&좋겠어!!!/");
ds_map_add(global.text_data_en, "scr_papcall_879", "\E0봐 봐!!^1!&이뤄졌지!/%%");
ds_map_add(global.text_data_en, "scr_papcall_885", "넌 뭘 빌 거야?/%%");
ds_map_add(global.text_data_en, "scr_papcall_891", "* 매 일 매 일 ^1, 사 람 들 은&  여 기 에  와 서  별 에&  소 원 을  빌 어 .../");
ds_map_add(global.text_data_en, "scr_papcall_892", "\E1* 그 들 을  실 망 시 키 지&  않 겠 어 !!!/");
ds_map_add(global.text_data_en, "scr_papcall_893", "* 모 두 의  소 원 이&  이 뤄 지 게  할  거 야 !!/");
ds_map_add(global.text_data_en, "scr_papcall_895", "난 다리가&여덟개였으면&좋겠어.../");
ds_map_add(global.text_data_en, "scr_papcall_896", "\E0그럼 핫팬츠를 네 개&입을 수 있겠지./");
ds_map_add(global.text_data_en, "scr_papcall_898", "* '거 의 '&  모 두 의  소 원 이&  이 뤄 지 게  할  거 야 !!!/%%");
ds_map_add(global.text_data_en, "scr_papcall_903", "* 뭐 ^1, 너 도&  소 원 이  있 다 고 ?/");
ds_map_add(global.text_data_en, "scr_papcall_904", "\E3* 너 도  얹 어  봐 ^1,&  친 구 ./%%");
ds_map_add(global.text_data_en, "scr_papcall_915", "이곳엔 오래된&명판들이 많아./");
ds_map_add(global.text_data_en, "scr_papcall_916", "워터폴은 사실&역사박물관이야./");
ds_map_add(global.text_data_en, "scr_papcall_917", "\E3차력사 해마들만&빼고./%%");
ds_map_add(global.text_data_en, "scr_papcall_922", "안녕?/%%");
ds_map_add(global.text_data_en, "scr_papcall_928", "* 그  벽 을  따 라&  우 리 의  끔 찍 한&  역 사 가  적 혀 있 지 .../");
ds_map_add(global.text_data_en, "scr_papcall_929", "\E1* 끔 찍 하 게  지 루 하 지 !/");
ds_map_add(global.text_data_en, "scr_papcall_930", "\E2* 우 리  역 사 는  왜&  인 간 의  것 처 럼  멋 진&  애 니 가  아 니 지 !?/");
ds_map_add(global.text_data_en, "scr_papcall_931", "\E6* 칼 부 림 과  키 스  장 면 이&  있 는  명 판 을&  그 렸 었 더 라 면 !!/%%");
ds_map_add(global.text_data_en, "scr_papcall_936", "* 이 봐 ^1, 너 희  역 사 가&  멋 있 지  않 다 는  듯 이&  그 러 지  마 !/%%");
ds_map_add(global.text_data_en, "scr_papcall_942", "* 따 르 릉 ..^1. 따 르 릉 .../");
ds_map_add(global.text_data_en, "scr_papcall_943", "* (반 응 이  없 다 ...)/%%");
ds_map_add(global.text_data_en, "scr_papcall_950", "또 다른 무해하고&안전한 복도.../");
ds_map_add(global.text_data_en, "scr_papcall_951", "\E0다 내 덕이지!!^1!&녜 헤 헤!!/%%");
ds_map_add(global.text_data_en, "scr_papcall_956", "헤!!!!!!/%%");
ds_map_add(global.text_data_en, "scr_papcall_962", "* 내 가  너 한 테&  창 을  던 졌 던  곳 이 야 .../");
ds_map_add(global.text_data_en, "scr_papcall_963", "\E6* 재 미 있 었 어 !!^1!&* 나 중 에  또  하 자 고 !!/%%");
ds_map_add(global.text_data_en, "scr_papcall_968", "* 자 , 자 ^1!&* 창 을  겁 내 지  말 라 고 !/%%");
ds_map_add(global.text_data_en, "scr_papcall_974", "* 따 르 릉 ..^1. 따 르 릉 .../");
ds_map_add(global.text_data_en, "scr_papcall_975", "* (반 응 이  없 다 ...)/%%");
ds_map_add(global.text_data_en, "scr_papcall_982", "발 조심해!/");
ds_map_add(global.text_data_en, "scr_papcall_983", "\E3어째선지&언다인이 이 풀을&소중히 여긴다고./%%");
ds_map_add(global.text_data_en, "scr_papcall_988", "보고 있는 거야?/%%");
ds_map_add(global.text_data_en, "scr_papcall_994", "* 저  풀 만  아 니 었 어 도 ^1,&  내 가  네 놈 의 .../");
ds_map_add(global.text_data_en, "scr_papcall_995", "\E9* 하 아 ^1, 저  길 쭉 이 만&  아 니 었 어 도 ^1, 네 놈 의&  엉 덩 이 를  걷 어 찼 겠 지 ./%%");
ds_map_add(global.text_data_en, "scr_papcall_1000", "* 나 한 테  길 쭉 이 가&  뭔 지  물 어 보 지  마 !!/%%");
ds_map_add(global.text_data_en, "scr_papcall_1006", "* 따 르 릉 ..^1. 따 르 릉 .../");
ds_map_add(global.text_data_en, "scr_papcall_1007", "* (반 응 이  없 다 ...)/%%");
ds_map_add(global.text_data_en, "scr_papcall_1014", "여긴 왜 이렇게&테이블이 많은 거야?/%%");
ds_map_add(global.text_data_en, "scr_papcall_1019", "* 이  탁 자 들 은&  전 부  다  어 디 서&  오 는  거 지 ?/%%");
ds_map_add(global.text_data_en, "scr_papcall_1029", "뭐^1? 샌즈 형이&자기 망원경으로&놀고 있지 않다고?/");
ds_map_add(global.text_data_en, "scr_papcall_1030", "\E0세에상에!!^1!&형이 아마 일을&하는 건가 봐!/");
ds_map_add(global.text_data_en, "scr_papcall_1031", "\E2우와!!^1! 나 지금&자랑스러워해야&하는 거 맞지?/%%");
ds_map_add(global.text_data_en, "scr_papcall_1036", "응^1? 우리 형^1?&당연히 망원경을&가지고 있지./");
ds_map_add(global.text_data_en, "scr_papcall_1037", "\E0샌즈 형은 우주같이&공상과학스러운걸&좋아해./");
ds_map_add(global.text_data_en, "scr_papcall_1038", "\E3흠^1?&형이 그런 거&말 안 해줬다고??/");
ds_map_add(global.text_data_en, "scr_papcall_1039", "\E0맞아^1, 샌즈형은&아무에게도 아무것도&말 안 해!/%%");
ds_map_add(global.text_data_en, "scr_papcall_1046", "전화해줘서 고마워./%%");
ds_map_add(global.text_data_en, "scr_papcall_1052", "* 야 ^1, 내 가  멋 진&  파 티  트 릭&  가 르 쳐  줄 게 ./");
ds_map_add(global.text_data_en, "scr_papcall_1053", "\E0* 남 쪽  벽 을  보 고&  대 화 해  봐 !/");
ds_map_add(global.text_data_en, "scr_papcall_1054", "\E4* 아 , 그  전 에&  파 티 를  먼 저&  열 어 야 겠 지 만 .../");
ds_map_add(global.text_data_en, "scr_papcall_1055", "\E0* 야 ^1, 파 티 를  연 다 면&  코 스 튬  파 티 로  열 어  봐 !/");
ds_map_add(global.text_data_en, "scr_papcall_1056", "\E6* 파 피 루 스 가  있 어 도&  괜 찮 을  만 한&  파 티 가  될  거 야!!/%%");
ds_map_add(global.text_data_en, "scr_papcall_1062", "* 오 ^1!&* 그 럼  알 피 스 도 ^1,&  초 대 해 야 지 !/%%");
ds_map_add(global.text_data_en, "scr_papcall_1071", "아이스크림^1?&고마워^1, 하지만 난&스노우딘에 산다구!/");
ds_map_add(global.text_data_en, "scr_papcall_1072", "\E0여긴 아이스크림이&사방에 깔렸어!/");
ds_map_add(global.text_data_en, "scr_papcall_1074", "* 그 건  눈 이 야 ./");
ds_map_add(global.text_data_en, "scr_papcall_1076", "샌즈 형!!^1! 형 의견은&묻지도 않았거든!!/%%");
ds_map_add(global.text_data_en, "scr_papcall_1081", "내게  아이스크림을&주고 싶다니&정말 기쁘구만./");
ds_map_add(global.text_data_en, "scr_papcall_1083", "* 나 도 야 ./");
ds_map_add(global.text_data_en, "scr_papcall_1085", "형은 아니거든!!/%%");
ds_map_add(global.text_data_en, "scr_papcall_1097", "\E1* 으 으 ^1, 아 이 스 크 림 !^1?&* 달 달 하 고 ... 차 갑 고 ^1.&* 완 전  구 역 질 나 ./");
ds_map_add(global.text_data_en, "scr_papcall_1098", "\E3* 반 면  알 피 스 가&  만 들 어 주 는  차 가 운&  분 홍 색  물 질  말 인 데 .../");
ds_map_add(global.text_data_en, "scr_papcall_1099", "\E6* 그 건  짱 이 야 !!!/%%");
ds_map_add(global.text_data_en, "scr_papcall_1104", "* 그 게  데 워 지 면&  마 시 기 도  한 다 고 ./%%");
ds_map_add(global.text_data_en, "scr_papcall_1113", "가끔은^1, 풀 아래에&보상이 있기도 하지./");
ds_map_add(global.text_data_en, "scr_papcall_1114", "진흙이나 흙먼지 같은^1,&보물 말이야./%%");
ds_map_add(global.text_data_en, "scr_papcall_1120", "보물은 찾았니?/%%");
ds_map_add(global.text_data_en, "scr_papcall_1126", "* 그  바 다 잔 디  사 이 에 는&  낡 은  신 발 이  있 었 어 ./");
ds_map_add(global.text_data_en, "scr_papcall_1127", "\E4* 이 상 하 지 ^1, 지 느 러 미 나&  발 톱 이  없 는  자 가&  신 는  거 였 어 ./");
ds_map_add(global.text_data_en, "scr_papcall_1128", "\E7* 대 체  어 떤  괴 물 이&  그 런  신 발 을  신 어 ...?/");
ds_map_add(global.text_data_en, "scr_papcall_1129", "\E2* 오 ^1, 맞 아 !^1?&* 슬 라 임  괴 물 이 라 면&  어 떨 까 !?/");
ds_map_add(global.text_data_en, "scr_papcall_1130", "\E6* 아 참 ^1, 걔 네 들 은&  신 발  신 을  발 조 차&  없 잖 아 !/%%");
ds_map_add(global.text_data_en, "scr_papcall_1136", "* 음 ^1, 그  신 발 이&  맞 는 다 면 ^1, 네 가&  가 져 도  괜 찮 을  거 야 ./");
ds_map_add(global.text_data_en, "scr_papcall_1137", "\E6* 누 구 든  그 걸  신 으 면&  돌 이 킬  수  없 어 !/%%");
ds_map_add(global.text_data_en, "scr_papcall_1146", "\E3새 괴물?^1?&걔한테 말 걸어 봐!!!/");
ds_map_add(global.text_data_en, "scr_papcall_1147", "\E0아니면 네가 나한테&전화 바꿔 줘 봐!/");
ds_map_add(global.text_data_en, "scr_papcall_1148", "\E2나 새 소리&꽤 잘 내거든!/");
ds_map_add(global.text_data_en, "scr_papcall_1149", "\E0(끔찍한 새 흉내)/%%");
ds_map_add(global.text_data_en, "scr_papcall_1155", "그 새가 내&짹짹이 좋아했어???/%%");
ds_map_add(global.text_data_en, "scr_papcall_1161", "* 그  새 는  누 구 든&  건 너 편 으 로  옮 겨  줘 ^1.&* 절 대  거 절 하 지  않 아 ./");
ds_map_add(global.text_data_en, "scr_papcall_1162", "\E7* 내 가  어 렸 을  적 ^1,&  그  새 가  날  옮 겨  줬 는 데 ^1.&* 거 의  한  시 간 이  걸 렸 어 .../");
ds_map_add(global.text_data_en, "scr_papcall_1163", "\E2* 하 지 만  그  새 는&  절 대  포 기 할&  생 각 조 차  안  했 지 !!!/");
ds_map_add(global.text_data_en, "scr_papcall_1164", "\E7* 그  새 를  소 중 히  여 겨  줘 ./%%");
ds_map_add(global.text_data_en, "scr_papcall_1170", "* 음 ??^1?&* 그 래 서  그  새 , 소 중 히&  여 기 는  중 이 겠 지 ???/");
ds_map_add(global.text_data_en, "scr_papcall_1171", "\E1* 더  소 중 히  여 기 라 고 !!!/%%");
ds_map_add(global.text_data_en, "scr_papcall_1180", "양파?/%%");
ds_map_add(global.text_data_en, "scr_papcall_1186", "흠 흠 흠.../%%");
ds_map_add(global.text_data_en, "scr_papcall_1192", "* 양 파 ...?/%%");
ds_map_add(global.text_data_en, "scr_papcall_1198", "* ...?/%%");
ds_map_add(global.text_data_en, "scr_papcall_1206", "그 쯤에 사는&부끄럼쟁이 괴물에&대해 들었었어./");
ds_map_add(global.text_data_en, "scr_papcall_1207", "\E3음^1, 네가 만약&마음을 터놓을&누군가가 필요하다면./");
ds_map_add(global.text_data_en, "scr_papcall_1208", "\E0전투 상황으로&만나야 할 거야!!!/%%");
ds_map_add(global.text_data_en, "scr_papcall_1214", "흠 흠 흠.../%%");
ds_map_add(global.text_data_en, "scr_papcall_1220", "* 아  맞 다 ^1, 샤 이 렌 이&  이  근 처 에  살 고  있 어 ./");
ds_map_add(global.text_data_en, "scr_papcall_1221", "* 그 녀 에 게  피 아 노&  레 슨 을  해  주 곤  했 지 ./");
ds_map_add(global.text_data_en, "scr_papcall_1222", "\E4* 정 말  천 부 적 이 었 어 ..^1.&  \E9손 가 락 이&  없 는  것  치 곤 ./");
ds_map_add(global.text_data_en, "scr_papcall_1223", "\E4* 언 젠 가 부 터 ^1, 샤 이 렌 이&  레 슨 에  안  나 오 더 군 ^1,&  그 런 데 .../%%");
ds_map_add(global.text_data_en, "scr_papcall_1229", "\E7* 어 떻 게  다 시&  노 래 를  부 르 게&  된  거 지 ...?/%%");
ds_map_add(global.text_data_en, "scr_papcall_1239", "엉!^1?&내게 세레나데를&불러주겠다고!?/");
ds_map_add(global.text_data_en, "scr_papcall_1240", "\E2그러지 마!!^1!&부끄럽단&말이야!!!/%%");
ds_map_add(global.text_data_en, "scr_papcall_1246", "우리들의 모험에 관한&뮤지컬을 만들자!!!/%%");
ds_map_add(global.text_data_en, "scr_papcall_1252", "\E6* 맞 아 !^1! 맞 아 !!^1!&* 내 가  그  퍼 즐 을  만 들 었 어 ./");
ds_map_add(global.text_data_en, "scr_papcall_1253", "\E0* 사 실 은 ^1, 그 냥  거 기&  피 아 노 를  두 고  싶 어&  퍼 즐 이 랍 시 고  둔  거 야 ./");
ds_map_add(global.text_data_en, "scr_papcall_1254", "\E2* 난  건 반 이 랑  싸 우 는  게&  너 무  좋 아 !!!/%%");
ds_map_add(global.text_data_en, "scr_papcall_1259", "\E9* 다 음 에  내 가  너 한 테&  한  곡  쳐  줄 게 !/%%");
ds_map_add(global.text_data_en, "scr_papcall_1269", "\E3흐으음.../");
ds_map_add(global.text_data_en, "scr_papcall_1270", "이 방엔 뭔가&꺼림칙한 게 있어./%%");
ds_map_add(global.text_data_en, "scr_papcall_1276", "하지만 뭔지는 콕 집어&말할 수 없단 말이야.../");
ds_map_add(global.text_data_en, "scr_papcall_1277", "그걸 손으로&콱 집어서.../");
ds_map_add(global.text_data_en, "scr_papcall_1278", "애정을 담아&마구 쓰다듬고&싶은데 말이야.../%%");
ds_map_add(global.text_data_en, "scr_papcall_1291", "\E1* 헛 !^1?&* 그  퍼 즐 을&  풀 었 다 고 !?/");
ds_map_add(global.text_data_en, "scr_papcall_1292", "\E6* 여 태 껏  아 무 도 ..^1.&* 난  지 금 까 지  그 걸  해  줄&  사 람 을  기 다 리 고  있 었 .../");
ds_map_add(global.text_data_en, "scr_papcall_1293", "\E2* 내  말 은 ^1, 어 어 ^1,&  맡 길  사 람 을  말 이 야 ^1!&* 뭐  어 쨌 건 !/%%");
ds_map_add(global.text_data_en, "scr_papcall_1298", "* 새  유 물 을&  찾 으 러  가 야 겠 네 ./%%");
ds_map_add(global.text_data_en, "scr_papcall_1308", "\E3신비로운 석상이네.../%%");
ds_map_add(global.text_data_en, "scr_papcall_1313", "\E3이 음악은 뭐지?/");
ds_map_add(global.text_data_en, "scr_papcall_1314", "내가 헛것을 들었나?/%%");
ds_map_add(global.text_data_en, "scr_papcall_1320", "\E0* 그  석 상 은  거 기&  계 속  있 었 어 ./");
ds_map_add(global.text_data_en, "scr_papcall_1321", "* 어 디 서  그  석 상 이  왔 는 지&  아 무 도  모 르 지 ./%%");
ds_map_add(global.text_data_en, "scr_papcall_1326", "* 오 ^1, 너  그 거  어 떻 게&  노 래  나 오 게  하 는 지&  알 아 냈 구 나 ...?/");
ds_map_add(global.text_data_en, "scr_papcall_1327", "\E9* 멋 지 지 ^1, 않 아 ?/%%");
ds_map_add(global.text_data_en, "scr_papcall_1336", "비를 대비해서&언제나 우산을&들고 다녀!/");
ds_map_add(global.text_data_en, "scr_papcall_1337", "응^1.&그냥 우산 몇 개&주머니에 넣고 다녀!/%%");
ds_map_add(global.text_data_en, "scr_papcall_1342", "우산을 가득 담은&양동이만큼&멋진 건 없지.../%%");
ds_map_add(global.text_data_en, "scr_papcall_1348", "* 그  우 산 들 은&  아 스 고 어 의  생 각 이 었 어 ./");
ds_map_add(global.text_data_en, "scr_papcall_1349", "\E9* 그 는  누 구 도&  감 기 에  걸 리 는  걸&  원 하 지  않 으 셨 지 ./");
ds_map_add(global.text_data_en, "scr_papcall_1350", "\E0* 워 터 폴 의&  물  속  주 민 들 은&  별 로 ^1, 신 경  안  썼 지 만 ./%%");
ds_map_add(global.text_data_en, "scr_papcall_1355", "* 우 산 은  구 했 어 ?/%%");
ds_map_add(global.text_data_en, "scr_papcall_1365", "너는 물웅덩이에&비친 네 모습을&볼 수 있지^1, 그치만../");
ds_map_add(global.text_data_en, "scr_papcall_1366", "\E1물웅덩이가&네 가치를&규정하게 하지 마!!!/%%");
ds_map_add(global.text_data_en, "scr_papcall_1372", "음^1? 친구랑 같이&놀러 가고 있어?&/");
ds_map_add(global.text_data_en, "scr_papcall_1373", "그럼 나에게&말을 걸지 말았어야지.../");
ds_map_add(global.text_data_en, "scr_papcall_1374", "\E0걔가 널&질투할 거라고!/%%");
ds_map_add(global.text_data_en, "scr_papcall_1380", "다시 전화했어...?/%%");
ds_map_add(global.text_data_en, "scr_papcall_1386", "* 뭐 !^1?&* 내 가  제 일  좋 아 하 는&  자 리 에  있 어 !?!?/");
ds_map_add(global.text_data_en, "scr_papcall_1387", "\E2* 나  대 신 에&  그  웅 덩 이  위 에 서&  1000번 은  뛰 어 주 라 !/%%");
ds_map_add(global.text_data_en, "scr_papcall_1392", "* 아 직 도&  100의  자 리 까 지&  못  간  거 야 !?/%%");
ds_map_add(global.text_data_en, "scr_papcall_1402", "너 어디 있는 거야^1?&물소리가 들리는데./");
ds_map_add(global.text_data_en, "scr_papcall_1403", "화장실에 있어?&/%%");
ds_map_add(global.text_data_en, "scr_papcall_1409", "근데^1, 화장실이 뭐야?&/%%");
ds_map_add(global.text_data_en, "scr_papcall_1415", "* 이  지 역  전 체 가&  하 나 의  살 아 있 는&  자 연 의  흔 적  같 아 ./");
ds_map_add(global.text_data_en, "scr_papcall_1416", "* 이 렇 게  문 명 과  동 떨 어 진&  곳 에  비 가  오 다 니&  정 말  좋 아 .../");
ds_map_add(global.text_data_en, "scr_papcall_1417", "\E7* 하 지 만 ^1, 도 시 도  점 점&  자 리 가  부 족 해 가 는 데 ^1,&  여 긴  언 제 까 지  있 으 려 나 ./%%");
ds_map_add(global.text_data_en, "scr_papcall_1422", "* 뭐 ?^1!&* 너 도  자 연 이  좋 은 거 야 !?&/%%");
ds_map_add(global.text_data_en, "scr_papcall_1431", "그게 왕의 성이야...&/%%");
ds_map_add(global.text_data_en, "scr_papcall_1436", "드디어&너한테 끝이&보이는 것 같네./%%");
ds_map_add(global.text_data_en, "scr_papcall_1442", "* 아 스 고 어 의  성 .../");
ds_map_add(global.text_data_en, "scr_papcall_1443", "\E7* 아 무 도  너 를  막 는&  사 람 이  없 나  보 군 ^1,&  그 렇 지 ?/%%");
ds_map_add(global.text_data_en, "scr_papcall_1448", "* .../%%");
ds_map_add(global.text_data_en, "scr_papcall_1458", "전화 신호가&점점 약해지는&것 같은데...&/%%");
ds_map_add(global.text_data_en, "scr_papcall_1463", "거긴 넘어가지&않는 게 좋을 거야./%%");
ds_map_add(global.text_data_en, "scr_papcall_1469", "* 길 은  여 기 서  끝 이 야 ^1,&  점 프 라 도  할  수&  있 으 면  모 르 겠 지 만 ./");
ds_map_add(global.text_data_en, "scr_papcall_1470", "\E4* 솔 직 히 ^1, 난  네 가&  여 기 까 지  올 거 라&예 상 했 단  게  안  믿 겨 ./");
ds_map_add(global.text_data_en, "scr_papcall_1471", "\E6* 내 가  왜  그 런&  생 각 을  했 지 ???/");
ds_map_add(global.text_data_en, "scr_papcall_1472", "\E1* ...그 리 고  내 가&  어 떻 게  맞 힌  거 지 ???/%%");
ds_map_add(global.text_data_en, "scr_papcall_1477", "* 설 명 하 지  마 !!/%%");
ds_map_add(global.text_data_en, "scr_papcall_1488", "꽃...?/");
ds_map_add(global.text_data_en, "scr_papcall_1489", "\E0꽃이 말을 했다고!^1?&나 대신에 안부 좀&전해주라!!!/%%");
ds_map_add(global.text_data_en, "scr_papcall_1494", "꽃은 우리들의&둘도 없는 친구지!!/%%");
ds_map_add(global.text_data_en, "scr_papcall_1500", "* 그  꽃 들 .../");
ds_map_add(global.text_data_en, "scr_papcall_1501", "* 어 느 날 부 터 인 가 ^1,&  거 기 서  갑 자 기&  자 라 기  시 작 했 어 ./");
ds_map_add(global.text_data_en, "scr_papcall_1502", "* 분 명 히 ^1, 그 것 들 은&  자 각 을  가 지 고&  있 는  것  같 아 ./%%");
ds_map_add(global.text_data_en, "scr_papcall_1507", "* 완 전  말 도  안  되 는&  일 이 지 만 !&/%%");
ds_map_add(global.text_data_en, "scr_papcall_1513", "* 따 르 릉 ..^1. 따 르 릉 .../");
ds_map_add(global.text_data_en, "scr_papcall_1514", "* (반 응 이  없 다 ...)/%%");
ds_map_add(global.text_data_en, "scr_papcall_1522", "쓰레긔^1, 말이지^1?&이봐^1, 난 확실히&쓰레긔를 알고 있지!!/");
ds_map_add(global.text_data_en, "scr_papcall_1523", "\E4알다시피^1, 난 이미&게으른 쓰레기랑&같이 살고 있잖아!/");
ds_map_add(global.text_data_en, "scr_papcall_1524", "\E0걔 이름은 트래쉬야^1.&쓰레기통 안에 살지./%%");
ds_map_add(global.text_data_en, "scr_papcall_1529", "너^1, 설마 내가 쓰레기한테&이름을 짓지&않았을 거라 생각한 거야?/%%");
ds_map_add(global.text_data_en, "scr_papcall_1535", "\E1* 거 기 가  나 와&  알 피 스 가  처 음&  만 난  곳 이 야 !!/");
ds_map_add(global.text_data_en, "scr_papcall_1536", "\E0* 나 는  멋 진  칼 을&  찾 고  있 었 는 데 ^1, 내 가&  걜  발 견 했 을  땐 .../");
ds_map_add(global.text_data_en, "scr_papcall_1537", "\E1* 어 ^1, 걘  저 쪽 에  서 서 ^1,&  심 연 을  들 여 다 보 고&  있 었 어 ./");
ds_map_add(global.text_data_en, "scr_papcall_1538", "\E4* 아 마 도 ..^1.&* 음 ..^1.&* ...명 상  중 이 었 나  봐 ./");
ds_map_add(global.text_data_en, "scr_papcall_1539", "\E9* 그 래 서  알 피 스 에 게&  그  심 연 이  어 디 로&  이 어 지 는 지  물 었 지 !/");
ds_map_add(global.text_data_en, "scr_papcall_1540", "\E2* 그 러 니 까  나 를&  쳐 다 보 곤 ^1, 놀 라 더 니 ^1,&  얼 굴 이  빨 개 지 더 군 ./");
ds_map_add(global.text_data_en, "scr_papcall_1541", "\E6* 하 지 만  난  무 서 웠 어 ^1,&  그 런  일 들 은&  낯 설 지 가  않 았 거 든 !/");
ds_map_add(global.text_data_en, "scr_papcall_1542", "\E1* 그 리 고  걘  계 속&  다 른  별 의 별&  이 론 들 을  늘 어 놓 았 어 ./");
ds_map_add(global.text_data_en, "scr_papcall_1543", "\E9* 한 참 이 나  설 명 했 어 ^1!&* 난  거 기 에  완 전&  반 한  거 야 !/");
ds_map_add(global.text_data_en, "scr_papcall_1544", "\E1* 그  후 엔 ^1, 난  여 기 서&  걔 랑  계 속&  만 나 고  있 어 ./");
ds_map_add(global.text_data_en, "scr_papcall_1545", "\E6* 그 리 고  우 린&  지 금  친 구 지 ^1!&* 이 야 아 아 호 우 !!!/%%");
ds_map_add(global.text_data_en, "scr_papcall_1550", "* 오  이 런 ^1!&* 이  이 야 기  다 신&  말 하 게  하 지  마 !!!/%%");
ds_map_add(global.text_data_en, "scr_papcall_1557", "* 따 르 릉 ..^1. 따 르 릉 .../");
ds_map_add(global.text_data_en, "scr_papcall_1558", "* (반 응 이  없 다 ...)/%%");
ds_map_add(global.text_data_en, "scr_papcall_1566", "왜 내게 전화했는지&알아./");
ds_map_add(global.text_data_en, "scr_papcall_1567", "\E0나는 항상 사람들을&기분 좋게 만들어주지.../");
ds_map_add(global.text_data_en, "scr_papcall_1568", "\E2특히 사람들이&쓰레기장에 쳐박혀&있을때 말이야!!!/");
ds_map_add(global.text_data_en, "scr_papcall_1569", "\E0.../");
ds_map_add(global.text_data_en, "scr_papcall_1570", "\E3오늘 내가 형과&너무 오랜 시간을&보내서 그래./%%");
ds_map_add(global.text_data_en, "scr_papcall_1575", "내가 말한 건&잊어버려./%%");
ds_map_add(global.text_data_en, "scr_papcall_1581", "* 쓰 레 기 장 !^1!&* 많 은  것 들 이&  거 기 서  왔 지 !!/");
ds_map_add(global.text_data_en, "scr_papcall_1582", "\E0* 우 리 가  현 대  기 술 을&  가 지 고  있 는  건 ../");
ds_map_add(global.text_data_en, "scr_papcall_1583", "* 인 간 의  쓰 레 기 가&  지 상 으 로 부 터&  흘 러 들 어 와 서 야 !/");
ds_map_add(global.text_data_en, "scr_papcall_1584", "\E9* 게 다 가 ^1, 여 자 를&  만 나 기 에 도&  좋 은  장 소 지 ./%%");
ds_map_add(global.text_data_en, "scr_papcall_1590", "* 잠 깐 ^1!&* 저  말 에  딴 지  걸&  생 각  말 라 고 !!!/%%");
ds_map_add(global.text_data_en, "scr_papcall_1596", "* 따 르 릉 ..^1. 따 르 릉 .../");
ds_map_add(global.text_data_en, "scr_papcall_1597", "* (반 응 이  없 다 ...)/%%");
ds_map_add(global.text_data_en, "scr_papcall_1604", "이봐^1!&너 언다인&집 근처에 있잖아!/");
ds_map_add(global.text_data_en, "scr_papcall_1605", "왼쪽 위로 가면 돼^1.&'윈쪽'이랄까./");
ds_map_add(global.text_data_en, "scr_papcall_1606", "\E3다른 방향은 전부&다른 집으로&가는 방향이야./");
ds_map_add(global.text_data_en, "scr_papcall_1607", "\E0북쪽: 유령의 집./");
ds_map_add(global.text_data_en, "scr_papcall_1608", "동쪽: 거북의 집./");
ds_map_add(global.text_data_en, "scr_papcall_1609", "남쪽: 쓰레기의 집./%%");
ds_map_add(global.text_data_en, "scr_papcall_1614", "서쪽: 새의 집./%%");
ds_map_add(global.text_data_en, "scr_papcall_1620", "언다인의 집&근처에 있나 본데./");
ds_map_add(global.text_data_en, "scr_papcall_1621", "이봐^1! 우리&언제 언다인네에&놀러 가자!/");
ds_map_add(global.text_data_en, "scr_papcall_1623", "* 나  여 기  있 는 데 !/");
ds_map_add(global.text_data_en, "scr_papcall_1625", "난 작전이 풀릴 때&기분이 정말 좋아^1!&녜 헤 헤!!!/%%");
ds_map_add(global.text_data_en, "scr_papcall_1632", "* 뭐 ^1, 아 마  다 음 엔&  파 피 루 스 와  같 이&  놀 러 가 야 겠 네 ./");
ds_map_add(global.text_data_en, "scr_papcall_1634", "정말??^1?&우리가???/%%");
ds_map_add(global.text_data_en, "scr_papcall_1641", "저건 언다인의&집이야./");
ds_map_add(global.text_data_en, "scr_papcall_1642", "언제 한번&저기 가서&같이 놀자!!!/%%");
ds_map_add(global.text_data_en, "scr_papcall_1647", "집 앞에서&아직도 기다리고&있어...?/");
ds_map_add(global.text_data_en, "scr_papcall_1648", "\E0뭐^1, 나도&가끔^1, 그러거든!/%%");
ds_map_add(global.text_data_en, "scr_papcall_1653", "저건 언다인의&집이야./");
ds_map_add(global.text_data_en, "scr_papcall_1654", "너도 알다시피^1,&해골이 앞에 서 있는&집 말야./%%");
ds_map_add(global.text_data_en, "scr_papcall_1662", "저건 언다인의&집이야./");
ds_map_add(global.text_data_en, "scr_papcall_1663", "거긴&정말 괜찮은.../");
ds_map_add(global.text_data_en, "scr_papcall_1664", "\E5어어?/");
ds_map_add(global.text_data_en, "scr_papcall_1666", "* 헉 ..^1. 헉 ...!/");
ds_map_add(global.text_data_en, "scr_papcall_1667", "\E6* 그 래 !!^1!&* 그 게  내  집 이 다 !!!/");
ds_map_add(global.text_data_en, "scr_papcall_1669", "안녕 언다인^1!&어떻게 이렇게&빨리 왔어?/");
ds_map_add(global.text_data_en, "scr_papcall_1671", "\E9* 뛰 어 왔 지 ./");
ds_map_add(global.text_data_en, "scr_papcall_1673", "세에상에!!^1!&언다인!!!/");
ds_map_add(global.text_data_en, "scr_papcall_1674", "언젠가 나도 너만큼&강해지고 땀투성이가&될 수 있었음 좋겠다./%%");
ds_map_add(global.text_data_en, "scr_papcall_1680", "그럼 너 그냥&전화 받으려고&여기까지 뛰어왔어??/");
ds_map_add(global.text_data_en, "scr_papcall_1682", "* 그 럼 !/");
ds_map_add(global.text_data_en, "scr_papcall_1684", "너 그럼 분명.../");
ds_map_add(global.text_data_en, "scr_papcall_1685", "뭔가 네 집에 관해&엄청나게 멋진 말을&하려고 온 거구나!!!/");
ds_map_add(global.text_data_en, "scr_papcall_1687", "* 전 혀 !!!/%%");
ds_map_add(global.text_data_en, "scr_papcall_1694", "* 그 건  내  집 이 야 ./");
ds_map_add(global.text_data_en, "scr_papcall_1695", "\E1* 아 니 ^1, 내  집 이 었 지 ^1,&  우 리 가  불 을  지 르 기&  전 까 진  말 이 야 ./");
ds_map_add(global.text_data_en, "scr_papcall_1696", "\E6* 근 데  있 잖 아 ^1,&  이 번 이  처 음 이 라 곤&  말  못 하 겠 는 걸 !!/%%");
ds_map_add(global.text_data_en, "scr_papcall_1701", "* 이 봐 ^1, 너  나 중 에&  폐 허 에 서  멋 진  칼 을&  발 견 하 면  말 이 야 ./");
ds_map_add(global.text_data_en, "scr_papcall_1702", "* 나 를  어 디 서&  찾 아 야  할 지&  알 겠 지 ./%%");
ds_map_add(global.text_data_en, "scr_papcall_1714", "오^1, 그건...&어..^1.&언다인 이웃의 집이야./");
ds_map_add(global.text_data_en, "scr_papcall_1715", "\E3이름이&뭐였더라?/");
ds_map_add(global.text_data_en, "scr_papcall_1716", "\E0스푸키 블루 블루?/%%");
ds_map_add(global.text_data_en, "scr_papcall_1721", "내퍼 혹...?/%%");
ds_map_add(global.text_data_en, "scr_papcall_1727", "* 거 긴&  냅 스 타 블 룩 의  집 이 야 ./");
ds_map_add(global.text_data_en, "scr_papcall_1728", "\E9* 방  안 에 만  갇 혀  사 는&  녀 석 인 데 ^1, 그 래 도 ...&* 착 한  유 령 이 야 ./");
ds_map_add(global.text_data_en, "scr_papcall_1729", "\E4* 녀 석 과  친 한  이 웃 이&  되 려 고  노 력 했 는 데 ^1,&  나 한 테  겁 먹 었 나  봐 ./");
ds_map_add(global.text_data_en, "scr_papcall_1730", "\E2* 아 니 ^1, 도 대 체  왜&  우 정 의  레 슬 링 을&  무 서 워 하 는  거 야 !!?/%%");
ds_map_add(global.text_data_en, "scr_papcall_1736", "* 걔 네 는  심 지 어&  형 체 도  없 잖 아 !!!/%%");
ds_map_add(global.text_data_en, "scr_papcall_1745", "그럼 너는 유령과&친구였던 거지.../");
ds_map_add(global.text_data_en, "scr_papcall_1746", "\E5오싹한 일 아니야?/");
ds_map_add(global.text_data_en, "scr_papcall_1747", "\E3넌 따뜻하고 껴안고&싶은 친구를 좋아할&거라고 생각했는데.../");
ds_map_add(global.text_data_en, "scr_papcall_1748", "\E0해골들처럼!!!/%%");
ds_map_add(global.text_data_en, "scr_papcall_1754", "아주 부드럽고^1,&칼슘으로 가득 차 있지./%%");
ds_map_add(global.text_data_en, "scr_papcall_1760", "* 뭐 ^1, 냅 스 타 블 룩 과&  같 이  놀 았 다 고 !^1?&* 그 거  대 단 한 데 !!!/");
ds_map_add(global.text_data_en, "scr_papcall_1761", "\E9* 난  걔 가  누 구 랑  노 는  걸&  한  번 도  본  적  없 는 데 .../");
ds_map_add(global.text_data_en, "scr_papcall_1762", "\E4* 그 ^1, 걔  사 촌&  빼 고 는  말 이 야 ./");
ds_map_add(global.text_data_en, "scr_papcall_1763", "\E9* 그  둘 은  하 루 종 일  TV를&  보 고  있 곤  했 었 지 .../");
ds_map_add(global.text_data_en, "scr_papcall_1764", "\E0* 그 러 더 니  둘 이 서&  이 상 한  퍼 포 먼 스 를&  연 습 하 더 라 고 ./");
ds_map_add(global.text_data_en, "scr_papcall_1765", "\E4* 녀 석 들  대 체&  어 디 로  간  걸 까 ...?/%%");
ds_map_add(global.text_data_en, "scr_papcall_1771", "* 걔  사 촌 만 큼&  잘  해  주 려 고&  노 력 하 진  마 !/");
ds_map_add(global.text_data_en, "scr_papcall_1772", "\E6* 그 냥  사 랑 스 럽 고&  오 래 된  고 물 처 럼&  있 으 라 고 !/%%");
ds_map_add(global.text_data_en, "scr_papcall_1781", "이 집은 한때&귀신이 들렸었지./");
ds_map_add(global.text_data_en, "scr_papcall_1782", "왜냐하면 유령이&거기서 살았거든./");
ds_map_add(global.text_data_en, "scr_papcall_1783", "근데 그 유령은&이사 갔어./");
ds_map_add(global.text_data_en, "scr_papcall_1784", "이제 귀신 안 들린&집이야./%%");
ds_map_add(global.text_data_en, "scr_papcall_1791", "어쨌거나^1,&무단주거침입은.../");
ds_map_add(global.text_data_en, "scr_papcall_1792", "\E3불법이지^1,&안 그래???/");
ds_map_add(global.text_data_en, "scr_papcall_1793", "\E5제발 유령 범죄를&저지르지 마./%%");
ds_map_add(global.text_data_en, "scr_papcall_1799", "* 뭐 라 고 ?/");
ds_map_add(global.text_data_en, "scr_papcall_1800", "* 네 가  냅 스 타 블 룩&  사 촌  집 에&  숨 어 들 어 갔 다 고 !?/");
ds_map_add(global.text_data_en, "scr_papcall_1801", "\E2* 그 건 ..^1.&* 그 건 ...!/");
ds_map_add(global.text_data_en, "scr_papcall_1802", "\E9* 이 봐 ^1,&  어 쨌 거 나 ^1,&  그  녀 석  이 름 이  뭐 였 어 ?/");
ds_map_add(global.text_data_en, "scr_papcall_1804", "햅스타블룩^1,&해피한 유령./");
ds_map_add(global.text_data_en, "scr_papcall_1806", "* 응 ^1, 그 건&  확 실 히  틀 렸 어 ./");
ds_map_add(global.text_data_en, "scr_papcall_1808", "틀린 게 아니야^1.&나만의 공식 설정이야.&/%%");
ds_map_add(global.text_data_en, "scr_papcall_1815", "* 진 지 하 게 ^1, 그 래 도 ^1,&  유 령  범 죄 를&  저 지 르 는  건  그 만  둬 ./%%");
ds_map_add(global.text_data_en, "scr_papcall_1825", "이 달팽이들은&내 형이랑 완전 똑같아./");
ds_map_add(global.text_data_en, "scr_papcall_1826", "동글동글하고^1, 느리고.../");
ds_map_add(global.text_data_en, "scr_papcall_1827", "\E3그리고 계속&오물을 내뿜어???/%%");
ds_map_add(global.text_data_en, "scr_papcall_1832", "오물을 내뿜기..^1.&바로 내 형이 하는 짓이네./%%");
ds_map_add(global.text_data_en, "scr_papcall_1838", "* 냅 스 타 블 룩 의  가 족 이&  이  농 장 을  운 영 하 곤&  했 지 만 ^1, 그 게 ../");
ds_map_add(global.text_data_en, "scr_papcall_1839", "\E7* 그 들 은 ..^1.&* 모 두  돌 아 가 셨 어 .../");
ds_map_add(global.text_data_en, "scr_papcall_1840", "\E9* ...다 른  직 장 으 로  말 야 ^1.&  여 긴  일 이  별 로&  없 다  보 니 ./");
ds_map_add(global.text_data_en, "scr_papcall_1841", "\E0* 냅 스 타 블 룩 이 랑&  사 촌 이  가 족 농 장 을&  운 영 해 왔 어 ./");
ds_map_add(global.text_data_en, "scr_papcall_1842", "\E4* 하 지 만  사 촌 은&  오 래 전 에  사 라 져 버 렸 지 ./");
ds_map_add(global.text_data_en, "scr_papcall_1843", "\E7* 이 제  냅 스 타 블 룩 은&  혼 자 야 .../");
ds_map_add(global.text_data_en, "scr_papcall_1844", "\E1* 그 러 니 까  잘  해  줘 ^1,&  알 았 지 !?/%%");
ds_map_add(global.text_data_en, "scr_papcall_1850", "* 그  유 령 을&  잘  보 살 펴  줘 !!!/%%");
ds_map_add(global.text_data_en, "scr_papcall_1859", "가게 하나가 보이면^1,&일단 멈춰서.../");
ds_map_add(global.text_data_en, "scr_papcall_1860", "쓰러진 다음에^1,&굴러가는 거야.../");
ds_map_add(global.text_data_en, "scr_papcall_1861", "굉장한 거래를&하러 말이지!!/");
ds_map_add(global.text_data_en, "scr_papcall_1862", "왜냐하면 불꽃 할인&행사를 하거든!!/");
ds_map_add(global.text_data_en, "scr_papcall_1863", "내 상상 속 불을 파는&가게에서 말이야./%%");
ds_map_add(global.text_data_en, "scr_papcall_1868", "아직 내 꿈일&뿐이지만./%%");
ds_map_add(global.text_data_en, "scr_papcall_1874", "\E1* 이 야 !/");
ds_map_add(global.text_data_en, "scr_papcall_1875", "* 거 긴  정 의 의  망 치 ^1,&  거 슨  할 아 버 지 네 잖 아 !/");
ds_map_add(global.text_data_en, "scr_papcall_1876", "\E9* 역 대  살 아 온  괴 물  중&  제 일  터 프 한  괴 물 이 셔 ...!/");
ds_map_add(global.text_data_en, "scr_papcall_1877", "\E4* 인 간 과  괴 물 간 의&  전 쟁 에 서  싸 우 셨 고 .../");
ds_map_add(global.text_data_en, "scr_papcall_1878", "\E6* 거 기 서  살 아 남 으 셨 다 고 ^1!&* 진 짜  영 웅 이 라 니 까 !/%%");
ds_map_add(global.text_data_en, "scr_papcall_1883", "* 뭐  좀  사 줄  건 가 ?/%%");
ds_map_add(global.text_data_en, "scr_papcall_1892", "오늘은 뱃사공&거기 있어?/%%");
ds_map_add(global.text_data_en, "scr_papcall_1897", "있다고?/%%");
ds_map_add(global.text_data_en, "scr_papcall_1903", "* 저  강 은  스 노 우 딘 과&  핫 랜 드 를  이 어  줘 ./");
ds_map_add(global.text_data_en, "scr_papcall_1904", "* 만 약  다 른  곳 으 로&  가 야  한 다 면 ^1,&  뛰 어  들 어 !/");
ds_map_add(global.text_data_en, "scr_papcall_1905", "\E2* 봐 , 이 게  우 리 가&  타 는  대 중 교 통 이 야 ^1,&  알 겠 어 !?/%%");
ds_map_add(global.text_data_en, "scr_papcall_1910", "* 그 래 서  뭐 ?/%%");
ds_map_add(global.text_data_en, "scr_papcall_1919", "이 이상한&속삭임은 뭐지?/");
ds_map_add(global.text_data_en, "scr_papcall_1920", "\E5나 전화 좀 끊을게./%%");
ds_map_add(global.text_data_en, "scr_papcall_1925", "파피루스는 지금&집에 없어요!!/%%");
ds_map_add(global.text_data_en, "scr_papcall_1931", "* 메 아 리 꽃  들 판 .../");
ds_map_add(global.text_data_en, "scr_papcall_1932", "\E4* 서 로 의  말 을&  계 속  반 복 하 지 .../");
ds_map_add(global.text_data_en, "scr_papcall_1933", "* ...아 무  의 미 없 는&  소 음 이  될  때 까 지&  말 이 야 ./");
ds_map_add(global.text_data_en, "scr_papcall_1934", "\E5* 섬 뜩 하 지 ^1, 응 ?/%%");
ds_map_add(global.text_data_en, "scr_papcall_1939", "* 나 한 테  그  섬 뜩 한&  데 에 서  전 화  좀&  그 만  걸 어 !/%%");
ds_map_add(global.text_data_en, "scr_papcall_1948", "뭐^1?&버섯^1?&먹을 수 있어?/");
ds_map_add(global.text_data_en, "scr_papcall_1949", "\E3못 먹는 게 확실해???/%%");
ds_map_add(global.text_data_en, "scr_papcall_1954", "나라면 먹어볼 거야./%%");
ds_map_add(global.text_data_en, "scr_papcall_1960", "* 일 단  이  방 에&  익 숙 해 지 면 .../");
ds_map_add(global.text_data_en, "scr_papcall_1961", "\E9* 버 섯 의  불 을  켤&  필 요 조 차  없 게&  될  거 야 ./");
ds_map_add(global.text_data_en, "scr_papcall_1962", "\E0* 그 런 데 ^1, 테 미  마 을 로&  가 는  길 은  절 대  불 이&  밝 혀 지 지  않 아 ./");
ds_map_add(global.text_data_en, "scr_papcall_1963", "\E6* 근 데  거 길  왜&  가 고  싶 어 하 겠 어 !?/%%");
ds_map_add(global.text_data_en, "scr_papcall_1968", "* 남 쪽  아 래 에  있 으 니&  피 해 가 고  싶 으 면&  피 해 서  가 ./%%");
ds_map_add(global.text_data_en, "scr_papcall_1977", "등불^1?&어^1, 좋아.../");
ds_map_add(global.text_data_en, "scr_papcall_1978", "\E0너 그거 먹을 수&있어???/");
ds_map_add(global.text_data_en, "scr_papcall_1979", "\E3나 진짜로&거기에 대해선&딱히 할 말이 없다./%%");
ds_map_add(global.text_data_en, "scr_papcall_1984", "나라면 먹어볼 거야./%%");
ds_map_add(global.text_data_en, "scr_papcall_1990", "* 일 단  이  방 에&  익 숙 해 지 면 .../");
ds_map_add(global.text_data_en, "scr_papcall_1991", "\E9* 등 불 을  켤  필 요 도&  없 다 니 까 !/");
ds_map_add(global.text_data_en, "scr_papcall_1992", "\E0* ...그 런  거 지 ./%%");
ds_map_add(global.text_data_en, "scr_papcall_1997", "* 그 렇 다 고 ./%%");
ds_map_add(global.text_data_en, "scr_papcall_2007", "흐음..^1.&물로 가득찬 복도../");
ds_map_add(global.text_data_en, "scr_papcall_2008", "\E0추측만 할 뿐이야./%%");
ds_map_add(global.text_data_en, "scr_papcall_2013", "할 말이 없어./%%");
ds_map_add(global.text_data_en, "scr_papcall_2019", "* 내 가  너 에 게  처 음 으 로&  말  걸 었 던  곳 이 잖 아 !/");
ds_map_add(global.text_data_en, "scr_papcall_2020", "\E3* 정 말 로  무 서 웠 지&  않 았 어 ?/");
ds_map_add(global.text_data_en, "scr_papcall_2021", "\E2* 나 는  그  대 사 를&  항 상  거 울  앞 에 서&  연 습 해 !/");
ds_map_add(global.text_data_en, "scr_papcall_2023", "언다인???/");
ds_map_add(global.text_data_en, "scr_papcall_2025", "* 내  말 은 !!^1!&* 어 !!^1!&* 절 대  안  한 다 고 !!!/");
ds_map_add(global.text_data_en, "scr_papcall_2027", "그래^1.&그냥 물어 보려고&했던 거였는데./");
ds_map_add(global.text_data_en, "scr_papcall_2028", "\E0나랑 같이&대사 연습할래...?!!/");
ds_map_add(global.text_data_en, "scr_papcall_2030", "* 으 !!^1!&* 아 니 !!^1!&* 안  한 다 고 !!!!/%%");
ds_map_add(global.text_data_en, "scr_papcall_2035", "모두들 집중^1!&난 냉장고를 열러 간다!/");
ds_map_add(global.text_data_en, "scr_papcall_2037", "* 너  뭘  하 든 간 에&  혼 잣 말 하 는  거 야 ?/%%");
ds_map_add(global.text_data_en, "scr_papcall_2051", "메아리꽃들.../");
ds_map_add(global.text_data_en, "scr_papcall_2052", "\E0그중에 나한테&말을 거는 꽃이&딱 하나 있어!!/%%");
ds_map_add(global.text_data_en, "scr_papcall_2058", "* 꽃 의  벌 판 ^1,&  모 두 의  꿈 과&  희 망 을  속 삭 이 지 .../");
ds_map_add(global.text_data_en, "scr_papcall_2059", "\E1* 느 아 아 아 !!^1!&* 힘 이  솟 아 난 다 !!!/%%");
ds_map_add(global.text_data_en, "scr_papcall_2064", "* 느 아 아 아 !!/%%");
ds_map_add(global.text_data_en, "scr_papcall_2078", "각 지역엔 위태로운&다리가 있거든/");
ds_map_add(global.text_data_en, "scr_papcall_2079", "왕정에서 관리하고 있어./");
ds_map_add(global.text_data_en, "scr_papcall_2080", "물론^1, 털복숭이 왕은&안전하게 바꾸고&싶어하지만./");
ds_map_add(global.text_data_en, "scr_papcall_2081", "\E1왜!!^1? 그분은&애들을 생각하지&않는 거야!?/%%");
ds_map_add(global.text_data_en, "scr_papcall_2088", "가시^1.&위험한 다리^1.&젊음의 상징인데./%%");
ds_map_add(global.text_data_en, "scr_papcall_2094", "* 이  방 은 ...!/");
ds_map_add(global.text_data_en, "scr_papcall_2095", "* 에 러 ?/%%");
ds_map_add(global.text_data_en, "scr_papcall_2098", "\E7* 확 실 히  긴 박 한&  상 황 이 었 어 ./");
ds_map_add(global.text_data_en, "scr_papcall_2099", "\E4* 그  가 엾 은  애 를&  구 하 고  싶 었 어 ^1,&  근 데 .../");
ds_map_add(global.text_data_en, "scr_papcall_2100", "\E1* 내 가  그 랬 다 간 ^1, 네 가  날&  공 격 할  것  같 았 어 !/");
ds_map_add(global.text_data_en, "scr_papcall_2101", "\E9* 다 행 히 도 , 넌&  그  아 이 를  구 해 냈 지 ./%%");
ds_map_add(global.text_data_en, "scr_papcall_2105", "\E7* 사 실 ..^1.&* 여 기 서  어 떤  일 이&  있 었 는 지  기 억  안  나/");
ds_map_add(global.text_data_en, "scr_papcall_2106", "\E4* 넌  그 냥  그  가 엾 은&  꼬 마 를  바 닥 에&  떨 어 지 게  뒀 어 ./");
ds_map_add(global.text_data_en, "scr_papcall_2107", "* 아 마  그 때  좀&  두 려 웠 을 지 도&  모 르 지 ./");
ds_map_add(global.text_data_en, "scr_papcall_2108", "\E7* 근 데  내 가  근 처 에&  없 었 다 면 ^1, 그 때 는 ...?/%%");
ds_map_add(global.text_data_en, "scr_papcall_2112", "\E2* 네  친 구 가&  도 움 을  요 청 했 는 데&  넌  도 망 만  갔 어 !!!/");
ds_map_add(global.text_data_en, "scr_papcall_2113", "\E9* 그 렇 지 만 ^1, 죽 기  싫 어&  도 망 친 건 데  누 가&  널  비 난 하 겠 어 ...?/");
ds_map_add(global.text_data_en, "scr_papcall_2114", "\E6* 나 야 !!^1!&* 난  아 직 도  정 말 로&  실 망 해  있 어 !/");
ds_map_add(global.text_data_en, "scr_papcall_2115", "\E1* 네 가  한  최 고 로&  겁 쟁 이 같 은&  짓 이 었 지 !/");
ds_map_add(global.text_data_en, "scr_papcall_2116", "* 네  가 엾 은  친 구 에 게&  사 과 하 라 고 ^1, 응 ^1,&  임 마 !?/%%");
ds_map_add(global.text_data_en, "scr_papcall_2122", "* .../%%");
ds_map_add(global.text_data_en, "scr_papcall_2136", "이곳은 퍼즐왕이&늘 서 있는 곳이군./");
ds_map_add(global.text_data_en, "scr_papcall_2137", "벽돌밀기^1.&열쇠 모으기^1.&짜증나는 고통./");
ds_map_add(global.text_data_en, "scr_papcall_2138", "우리의 근본을&존중하는 게 중요해!/%%");
ds_map_add(global.text_data_en, "scr_papcall_2144", "이곳은 퍼즐왕이&늘 서 있는 곳이군./");
ds_map_add(global.text_data_en, "scr_papcall_2145", "우리의 퍼즐&근본을 존중하는 게&중요해!/");
ds_map_add(global.text_data_en, "scr_papcall_2147", "* 그 래 ^1, 누 군 가 가 &  신 경 써 주 겠 지 . 그 러 니&  내 가  안  해 도  돼 !/");
ds_map_add(global.text_data_en, "scr_papcall_2149", "하지만 언다인^1, 너&전통을 좋아하던 거&아니었어?/");
ds_map_add(global.text_data_en, "scr_papcall_2151", "* 난  한  달  동 안&  벽 돌  미 는  작 업 소 에 서&  일 했 다 고 !/");
ds_map_add(global.text_data_en, "scr_papcall_2152", "\E9* 벽 돌  퍼 즐 에  대 한&  내  존 중 은  그  일  하 면 서&  끝 장 났 어 ./");
ds_map_add(global.text_data_en, "scr_papcall_2154", "뭐!^1? 내가&꿈꾸는 생활을&걷어찼다니!!!/");
ds_map_add(global.text_data_en, "scr_papcall_2155", "\E2단순한&직장인의 삶을.../");
ds_map_add(global.text_data_en, "scr_papcall_2156", "매일 가시로 가득한&기차로 통근하는.../");
ds_map_add(global.text_data_en, "scr_papcall_2158", "* (그 런  삶 이  아 니 라 는&  사 실 은  말 하 지  않 겠 어 ...)/%%");
ds_map_add(global.text_data_en, "scr_papcall_2163", "언다인^1, 정말&사무직이 된 거야?/");
ds_map_add(global.text_data_en, "scr_papcall_2165", "* 글 쎄 ^1, 이 건&  어 ^1, 음 ^1, &  공 공 서 비 스 랄 까 ./");
ds_map_add(global.text_data_en, "scr_papcall_2167", "역시 언다인이야!^1!&언제나 사회에 봉사하지!/");
ds_map_add(global.text_data_en, "scr_papcall_2169", "* 어 ^1, 그 래 ^1!&* 확 실 히  내&  자 유 의 지 라 고 !/%%");
ds_map_add(global.text_data_en, "scr_papcall_2185", "저게 언다인의&멋진 암벽이야./");
ds_map_add(global.text_data_en, "scr_papcall_2186", "\E0걘 언제나&꼭대기에 올라가 있어./");
ds_map_add(global.text_data_en, "scr_papcall_2187", "\E3혼자 뭔가를&중얼거리면서.../%%");
ds_map_add(global.text_data_en, "scr_papcall_2191", "내가 보기엔&뭔가 기억해야&할 게 있나 봐./%%");
ds_map_add(global.text_data_en, "scr_papcall_2198", "* 오 , 신 이 시 여 !!^1!&* 이 곳 이  완 전&  최 고  아 니 냐 !?/");
ds_map_add(global.text_data_en, "scr_papcall_2199", "\E3* 그 때  그  지 겨 운&  독 백 을  하 지  않 기 로&  마 음 먹 었 었 지 .../");
ds_map_add(global.text_data_en, "scr_papcall_2200", "\E6* 근 데  완 전 히&  즉 흥 적 으 로  했 거 든 !?/");
ds_map_add(global.text_data_en, "scr_papcall_2201", "\E2* 내 가  창 으 로  널&  죽 일  뻔 한  때 나 ???/");
ds_map_add(global.text_data_en, "scr_papcall_2202", "\E3* 내 가  더  많 은  창 으 로&  너 를  죽 일  뻔 한  때 나 ??/");
ds_map_add(global.text_data_en, "scr_papcall_2203", "\E9* 아  이 런 ^1.&* 그 때  사 진  좀&  찍 어 뒀 어 야  했 는 데 ./");
ds_map_add(global.text_data_en, "scr_papcall_2204", "\E8* 작 은  스 크 랩 북 이&  얼 마 나  귀 여 울  지&  생 각 해  봐 .../");
ds_map_add(global.text_data_en, "scr_papcall_2206", "나도 이제 내&싸움의 스크랩북을&가지고 싶어!!!/");
ds_map_add(global.text_data_en, "scr_papcall_2208", "* 보 스  전 투 를  위 한&  사 진 전 을  열 자 !/");
ds_map_add(global.text_data_en, "scr_papcall_2210", "일주일 뒤에^1,&우편함에 잡지&샘플이 오겠지./");
ds_map_add(global.text_data_en, "scr_papcall_2212", "* 기 억 을  되 살 려  보 자 .../%%");
ds_map_add(global.text_data_en, "scr_papcall_2217", "* 즉 흥 적 으 로  하 면 서 ..^1.&* 그 러 니 까 ...&* 어 ./");
ds_map_add(global.text_data_en, "scr_papcall_2218", "\E9* 나  완 전 히&  내  독 백  대 사 를 ^1,&  잊 어 버 렸 어 .../%%");
ds_map_add(global.text_data_en, "scr_papcall_2234", "이봐..^1. 여기 내가&전화했던 곳 아니야?/");
ds_map_add(global.text_data_en, "scr_papcall_2235", "\E2나 그때 네가&전화한 거 또렷이&기억하고 있어./");
ds_map_add(global.text_data_en, "scr_papcall_2236", "\E3.../");
ds_map_add(global.text_data_en, "scr_papcall_2237", "\E5이봐^1, 언제 우리&언다인과 함께 놀러&가지 않을래?/%%");
ds_map_add(global.text_data_en, "scr_papcall_2241", "\E0이봐^1, 언제 우리&언다인과 함께 놀러&가지 않을래?/%%");
ds_map_add(global.text_data_en, "scr_papcall_2248", "* 여 기  내 가  널&  따 라 잡 던  곳 이 네 .../");
ds_map_add(global.text_data_en, "scr_papcall_2249", "\E1* 근 데  네 가  전 화 를&  받 길 래 ^1, 기 다 려 야&  했 어 ./");
ds_map_add(global.text_data_en, "scr_papcall_2251", "아^1!&그거 나였어!/");
ds_map_add(global.text_data_en, "scr_papcall_2253", "* 뭐 !^1?&* 왜  전 화 했 던  건 데 ?/");
ds_map_add(global.text_data_en, "scr_papcall_2255", "그냥 같이&놀러 가자고./");
ds_map_add(global.text_data_en, "scr_papcall_2257", "* 내 가  걔 를&  죽 이 려 고  할  때 !?/");
ds_map_add(global.text_data_en, "scr_papcall_2259", "그래!^1!&아무도 절친으로&시작하지는 않아!/%%");
ds_map_add(global.text_data_en, "scr_papcall_2265", "* 아 무 도  절 친 으 로&  시 작 하 진  않 는 다 는&  거 지 ^1, 응 ?/");
ds_map_add(global.text_data_en, "scr_papcall_2267", "그게 법칙이지./");
ds_map_add(global.text_data_en, "scr_papcall_2269", "* 뭐 ^1, 너 희 들 은&  결 국  내  절 친 이&  될  테 지 만 !/");
ds_map_add(global.text_data_en, "scr_papcall_2271", "아... 안 돼!!^1!&작업의 수플렉스는&걸지 마!!!/%%");
ds_map_add(global.text_data_en, "scr_papcall_2285", "와!!!&너 정말 지금&핫랜드에 있구나!!!/");
ds_map_add(global.text_data_en, "scr_papcall_2286", "\E4...저기 샌즈 형^1,&근데 형 거기 있어야&하는 거 아니었어?/");
ds_map_add(global.text_data_en, "scr_papcall_2288", "* 걱 정  마 ^1.&* 거 기  있 으 니 까 ./");
ds_map_add(global.text_data_en, "scr_papcall_2290", "휴!/%%");
ds_map_add(global.text_data_en, "scr_papcall_2295", "드디어^1,&샌즈 형이 일을 하네./%%");
ds_map_add(global.text_data_en, "scr_papcall_2302", "\E1* 그 때  파 피 루 스 의&  형 이  자 고  있 었 다 니&  믿 을  수 가  없 어 !!/");
ds_map_add(global.text_data_en, "scr_papcall_2303", "\E2* 걔 가  널  막 을  줄&  알 았 다 고 !^1!&* 으 으 으 으 그 으 으 !!!/");
ds_map_add(global.text_data_en, "scr_papcall_2305", "형은 정말 건강이 별로야^1.&쉽게 지친다고./");
ds_map_add(global.text_data_en, "scr_papcall_2306", "최근엔 형은&밤중에 7시간이나&낮잠을 잤어./");
ds_map_add(global.text_data_en, "scr_papcall_2307", "\E1낮잠 자는 걸로&요절해버릴거란 말이야!!/");
ds_map_add(global.text_data_en, "scr_papcall_2309", "* 확 실 히 !^1!&* 너 네  형 은&  좀 ...!/");
ds_map_add(global.text_data_en, "scr_papcall_2310", "\E9* ...잠 깐 ^1, 그 거&  그 냥  잔 다 고  해 야&  하 는  거  아 니 야 ?/");
ds_map_add(global.text_data_en, "scr_papcall_2312", "언다인!^1! 안 돼!!^1!&너만은 안 돼!!!/%%");
ds_map_add(global.text_data_en, "scr_papcall_2319", "* 잠 깐 ^1. 파 피 루 스 ..^1.&* 너  언 제  자 냐 ?/");
ds_map_add(global.text_data_en, "scr_papcall_2321", "\E3난 보통&자기엔 너무 바쁜데^1.&왜???/");
ds_map_add(global.text_data_en, "scr_papcall_2323", "* 글 쎄 ^1, 그 냥&  생 각 해 봤 는 데 .../");
ds_map_add(global.text_data_en, "scr_papcall_2324", "\E6* 그  멋 진  자 동 차  침 대&  안  쓸  거 면 ^1,&  그 냥  나  주 면  안  돼 !?/%%");
ds_map_add(global.text_data_en, "scr_papcall_2339", "정수기...^1?&핫랜드에???&거 참 이상한데./");
ds_map_add(global.text_data_en, "scr_papcall_2340", "\E0거기선 불이&나와야 하는 게&맞지 않아?/%%");
ds_map_add(global.text_data_en, "scr_papcall_2345", "\E3근데, 정수기가&뭘^1, 하는 거지?/");
ds_map_add(global.text_data_en, "scr_papcall_2346", "\E3물을..^1.&냉각하나?/");
ds_map_add(global.text_data_en, "scr_papcall_2347", "\E0그러니까 그게 물을&뾰족하게 만들어서&반짝이게 한다는 거지?/%%");
ds_map_add(global.text_data_en, "scr_papcall_2354", "* 저  물  냉 각 기 가  있 어&  정 말  다 행 이 지  뭐 야 ^1,&  안 그 래 ?/");
ds_map_add(global.text_data_en, "scr_papcall_2355", "\E4* 사 실 ^1, 알 피 스 한 테&  고 마 워 해 야  돼 .../");
ds_map_add(global.text_data_en, "scr_papcall_2356", "\E9* 걔 가  날  위 해 서&  저 기  둔  거 야 ./");
ds_map_add(global.text_data_en, "scr_papcall_2357", "\E0* 이 제  걔  연 구 실 에&  가 는  중 에  물 을&  마 실 수  있 게  됐 어 . /");
ds_map_add(global.text_data_en, "scr_papcall_2358", "\E1* 그 래 도 ^1, 보 통 은&  100 파 운 드 짜 리&  갑 옷 을  입 지 는  않 아 ...!/%%");
ds_map_add(global.text_data_en, "scr_papcall_2363", "* 그 때  물 을  줘 서 ^1,&  고 마 웠 어 ./%%");
ds_map_add(global.text_data_en, "scr_papcall_2377", "연구소??^1?&내 형이 좋아하겠어!/");
ds_map_add(global.text_data_en, "scr_papcall_2378", "형은 공상과학을&정말 좋아해!!!/");
ds_map_add(global.text_data_en, "scr_papcall_2379", "특히 그게 진짜일 때&그래./%%");
ds_map_add(global.text_data_en, "scr_papcall_2384", "잠깐^1, 그 개 사료 봉지&낯이 익은데.../");
ds_map_add(global.text_data_en, "scr_papcall_2385", "샌즈 형 방에서..^1.&본 것 같거든?/");
ds_map_add(global.text_data_en, "scr_papcall_2386", "\E1그래^1! 왜 그런 걸&갖고 있는지 물어봤었지!/");
ds_map_add(global.text_data_en, "scr_papcall_2387", "\E0그랬더니 건강식을&먹으려 했다고&하더라고./%%");
ds_map_add(global.text_data_en, "scr_papcall_2393", "* 알 피 스  연 구 소 에  있 어 ^1?&* 걔  거 기  있 어 ...? /");
ds_map_add(global.text_data_en, "scr_papcall_2394", "\E1* 이 봐 ^1, 안 부  좀&  전 해 줘 ^1, 알 겠 어 !?/");
ds_map_add(global.text_data_en, "scr_papcall_2395", "\E2* 그 리 고 ^1, 지 금  상 태 가&  어 떤 지  좀  알 려 줘 !/");
ds_map_add(global.text_data_en, "scr_papcall_2396", "\E9* 그 리 고  지 금&  뭐  필 요 한 지 도 ^1,&  그 리 고 .../");
ds_map_add(global.text_data_en, "scr_papcall_2397", "\E1* 잠 깐 ^1! 아 니 야 ^1!&* 그 런  거  물 어 보 지  마 !!!/%%");
ds_map_add(global.text_data_en, "scr_papcall_2402", "* 근 데  걔  지 금  괜 찮 지 ^1,&  그 렇 지 !?/%%");
ds_map_add(global.text_data_en, "scr_papcall_2408", "* (뭔 가  이 상 한  방 해 전 파 가&  있 는  것  같 다 ...)/%%");
ds_map_add(global.text_data_en, "scr_papcall_2416", "\E2걔 방에 있다고^1,&초대도 안 받고^1?&세에상에.../");
ds_map_add(global.text_data_en, "scr_papcall_2417", "\E3그것 참 오싹한데./%%");
ds_map_add(global.text_data_en, "scr_papcall_2422", "아마 가지 않는 게&좋을 거야./%%");
ds_map_add(global.text_data_en, "scr_papcall_2428", "* 뭐 !^1?&* 걔  방 에  있 다 고 !?/");
ds_map_add(global.text_data_en, "scr_papcall_2429", "\E2* 거 기 서  당 장  나 와 !/");
ds_map_add(global.text_data_en, "scr_papcall_2430", "\E9* 그 러 니 까 ^1, 어 ^1, 네 가&  초 대 받 은  게  아 니 라 면 .../");
ds_map_add(global.text_data_en, "scr_papcall_2431", "\E2* 안  돼 !!^1!&* 그 럴  리 가  없 어 !/%%");
ds_map_add(global.text_data_en, "scr_papcall_2436", "* 거 기  가 만  있 어 !/%%");
ds_map_add(global.text_data_en, "scr_papcall_2445", "핫랜드^1, 허.../");
ds_map_add(global.text_data_en, "scr_papcall_2446", "\E2거긴 마치&내 손등 같아.../");
ds_map_add(global.text_data_en, "scr_papcall_2447", "\E3그러니까^1, 난&언제나 장갑을&끼고 있으니.../");
ds_map_add(global.text_data_en, "scr_papcall_2448", "\E0거기 관한 건 아무것도&모른다는 거지!!!/%%");
ds_map_add(global.text_data_en, "scr_papcall_2453", "내 지식 용량은&정체되어 있어./%%");
ds_map_add(global.text_data_en, "scr_papcall_2459", "우리 둘 다&핫랜드에 대해서는&잘 몰라./");
ds_map_add(global.text_data_en, "scr_papcall_2461", "* 그 러 니  우 리 는&  우 리 의  힘 을&  합 칠  거 야 !!!/");
ds_map_add(global.text_data_en, "scr_papcall_2463", "0 더하기 0은 0이야./");
ds_map_add(global.text_data_en, "scr_papcall_2465", "* 그 래 ^1, 하 지 만&  거 대 한  0이 지 !/%%");
ds_map_add(global.text_data_en, "scr_papcall_2470", "* 제 일  큰  0!/%%");
ds_map_add(global.text_data_en, "scr_papcall_2479", "어이^1, 너 스노우딘에&와서 우리 집에&놀러 와!/");
ds_map_add(global.text_data_en, "scr_papcall_2480", "\E2나 뭔가 몇 가지&하고 있으니깐./");
ds_map_add(global.text_data_en, "scr_papcall_2481", "\E0계속 서 있는 걸&반복하는 거야./%%");
ds_map_add(global.text_data_en, "scr_papcall_2486", "계속 서 있는 걸&반복하는 거야./%%");
ds_map_add(global.text_data_en, "scr_papcall_2492", "어이^1, 너 스노우딘에&와서 우리 집에&놀러 와!/");
ds_map_add(global.text_data_en, "scr_papcall_2494", "* 아 니 야 !!^1!&* 스 노 우 딘 에  놀 러 오 면&  나 를  만 나 라 고 !/");
ds_map_add(global.text_data_en, "scr_papcall_2496", "뭐??^1?&우리 똑같은&장소에 있잖아!!/");
ds_map_add(global.text_data_en, "scr_papcall_2498", "* 아 니 거 든 ^1!&  내 가  너 보 다  살 짝&  오 른 쪽 에  있 어 !!/%%");
ds_map_add(global.text_data_en, "scr_papcall_2503", "* 어 서 !!^1!&* 정 하 란  말 야 !!!/%%");
ds_map_add(global.text_data_en, "scr_papcall_2512", "컨베이어 벨트가&온 천지에 있다고?^1?&진짜로?/");
ds_map_add(global.text_data_en, "scr_papcall_2513", "\E3그걸 타고&학교나 직장에 가는&상상을 해 봐./");
ds_map_add(global.text_data_en, "scr_papcall_2514", "말도 안 되지./");
ds_map_add(global.text_data_en, "scr_papcall_2515", "\E0한편 얼음과 가시밭은^1,&정말로 편해!!!/%%");
ds_map_add(global.text_data_en, "scr_papcall_2520", "내가 핫랜드에서&살지 않아서&다행이야./%%");
ds_map_add(global.text_data_en, "scr_papcall_2526", "* 한  번  컨 베 이 어  벨 트 에&  탄  적 이  있 어 ./");
ds_map_add(global.text_data_en, "scr_papcall_2527", "\E1* 내 가  그 걸  싫 어 한 다 는  걸&  깨 닫 는  데 에 는&  오 래  걸 리 지  않 았 지 ./");
ds_map_add(global.text_data_en, "scr_papcall_2529", "토했니??/");
ds_map_add(global.text_data_en, "scr_papcall_2531", "* 응 ^1, 한  9000번&  정 도 는  토 했 지 !^1!&* 굉 장 했 어 !!/%%");
ds_map_add(global.text_data_en, "scr_papcall_2536", "그만 전화하고&역겨운 말 좀 &안 하게 해./%%");
ds_map_add(global.text_data_en, "scr_papcall_2546", "증기 배기구^1?&와..^1. 끔찍해/");
ds_map_add(global.text_data_en, "scr_papcall_2547", "\E1네가 옷을 입고&있으면 어떡해?/%%");
ds_map_add(global.text_data_en, "scr_papcall_2552", "내가 핫랜드에서&살지 않아서&다행이야!!/%%");
ds_map_add(global.text_data_en, "scr_papcall_2558", "* 증 기  배 기 구 ^1?&* 알 피 스 가  얘 기 한  적&  있 는  것  같 은 데 ./");
ds_map_add(global.text_data_en, "scr_papcall_2559", "* 그 걸  통 해  증 기 를&  배 출 하 면 서  코 어 가&  냉 각 된 다 고 .../");
ds_map_add(global.text_data_en, "scr_papcall_2560", "\E9* 그 리 고  동 시 에 ^1,&  운 송 수 단 도  될  수&  있 다 고 !/");
ds_map_add(global.text_data_en, "scr_papcall_2561", "\E6* 네 가 ^1, 옷 을  입 고&  있 다 면  몰 라 도 ,&  정 말  멋 지 지  않 냐 !/%%");
ds_map_add(global.text_data_en, "scr_papcall_2566", "* 뭐 !^1?&* 옷 을  입 고&  있 다 고 ?/%%");
ds_map_add(global.text_data_en, "scr_papcall_2576", "주황색과 파란색&레이저^1, 응?/");
ds_map_add(global.text_data_en, "scr_papcall_2577", "\E3색깔이 뭘 의미하는지만&명심해 둬./");
ds_map_add(global.text_data_en, "scr_papcall_2578", "\E0파란색은 점프를&의미하고.../");
ds_map_add(global.text_data_en, "scr_papcall_2579", "\E3그리고 주황색은..^1.&오렌지향이&나게 하는 거야./");
ds_map_add(global.text_data_en, "scr_papcall_2580", "\E0내 기억으론 이래./%%");
ds_map_add(global.text_data_en, "scr_papcall_2585", "재밌게 놀아!!/%%");
ds_map_add(global.text_data_en, "scr_papcall_2591", "* 뭐 !? 내 가  왜&  알 피 스 한 테  날 씨 를&  물 어 봤 냐 고 ?/");
ds_map_add(global.text_data_en, "scr_papcall_2592", "\E3* 알  게  뭐 야 !?!^1?&* 기 상 학 을  좋 아 하 는  게&  뭐  어 때 서 !?/");
ds_map_add(global.text_data_en, "scr_papcall_2594", "띠용!!!/");
ds_map_add(global.text_data_en, "scr_papcall_2595", "\E3알피스하고 얘기하려는&핑계인 줄 알았는데./");
ds_map_add(global.text_data_en, "scr_papcall_2596", "지하 세계에&날씨가 있는 줄은&몰랐네!!!/");
ds_map_add(global.text_data_en, "scr_papcall_2598", "\E1* 그 래 !?!^1!&* 당 연 하 지 !!?!/");
ds_map_add(global.text_data_en, "scr_papcall_2599", "\E2* 이 제  난  앞 으 로&  다 가 올  '닥 쳐 '를&  예 보 할  거 야 !!!/");
ds_map_add(global.text_data_en, "scr_papcall_2601", "세에상에!!^1!&우산이 필요할까?/%%");
ds_map_add(global.text_data_en, "scr_papcall_2607", "* 뭐 야 !^1?&* 이  방 은  뭐 야 !?/%%");
ds_map_add(global.text_data_en, "scr_papcall_2614", "* 오 ^1, 파 피 루 스 ^1.&* 너 에 게  화 를&  내 다 니  미 안 해 ./");
ds_map_add(global.text_data_en, "scr_papcall_2616", "괜찮아^1,&너를 용서하지!/");
ds_map_add(global.text_data_en, "scr_papcall_2617", "\E3(저기^1, 쟤가 언제&나한테 화를 낸 거였어?)/%%");
ds_map_add(global.text_data_en, "scr_papcall_2637", "학교에 있는 건&중요한 거야./");
ds_map_add(global.text_data_en, "scr_papcall_2638", "\E3진정한 선생이라면.../");
ds_map_add(global.text_data_en, "scr_papcall_2639", "\E0절대로 치명적인&레이저를 변명으로&받아주진 않아!!/%%");
ds_map_add(global.text_data_en, "scr_papcall_2645", "좋네!&난 핫랜드에&살지 않거든!!/%%");
ds_map_add(global.text_data_en, "scr_papcall_2651", "* 응 ^1?&* 저  애 들 이  학 교 를&  계 속  빠 진 다 고 ?/");
ds_map_add(global.text_data_en, "scr_papcall_2652", "* .../");
ds_map_add(global.text_data_en, "scr_papcall_2653", "\E6* ... 뭐 ^1,&  어 쩔  수  없 지 ^1,&  학 교 는  구 려 !/");
ds_map_add(global.text_data_en, "scr_papcall_2654", "\E4* 더  멋 지 게  만 들&  방 법 을  찾 아 야  해 .../");
ds_map_add(global.text_data_en, "scr_papcall_2655", "\E2* 야 ^1, 내 가  학 교 를&  방 문 하 면  어 떨 까 !?/");
ds_map_add(global.text_data_en, "scr_papcall_2656", "\E6* 그 리 고  내 가  선 생 들 을&  전 부  때 려 눕 히 는  거 야 !/%%");
ds_map_add(global.text_data_en, "scr_papcall_2661", "* 그 래 ^1, 아 마  선 생 을&  때 려 눕 히 진  않 을  거 야 .../%%");
ds_map_add(global.text_data_en, "scr_papcall_2671", "오, 안 돼^1!&퍼즐이 다시&작동하는 바람에.../");
ds_map_add(global.text_data_en, "scr_papcall_2672", "\E3사람들이&출근을 못하고&있다고!?/");
ds_map_add(global.text_data_en, "scr_papcall_2674", "* 그 럼 ./");
ds_map_add(global.text_data_en, "scr_papcall_2675", "\E1* 그 래 서  나 도  일 하 러&  못  가 고  있 는  거 지 ^1.&  음 ./");
ds_map_add(global.text_data_en, "scr_papcall_2677", "이럴 수가!!^1!&형^1, 당장&일(들)하러 가!!!/%%");
ds_map_add(global.text_data_en, "scr_papcall_2682", "다행이야^1!&난 핫랜드에&살지 않으니./%%");
ds_map_add(global.text_data_en, "scr_papcall_2684", "* 나 도 야 ./");
ds_map_add(global.text_data_en, "scr_papcall_2686", "그러면서 왜 형은&일을 빼먹는 거야!?!/%%");
ds_map_add(global.text_data_en, "scr_papcall_2697", "메타톤을 만나러&간다고 들었어!/");
ds_map_add(global.text_data_en, "scr_papcall_2698", "\E0정말이야^1?&사인 좀 받아와줄&수 있어!?/");
ds_map_add(global.text_data_en, "scr_papcall_2699", "\E2내가 제일 좋아하는&섹시한 직사각형이야!!/%%");
ds_map_add(global.text_data_en, "scr_papcall_2704", "핫랜드에 살았으면&좋겠다!!!/%%");
ds_map_add(global.text_data_en, "scr_papcall_2710", "메타톤을 만나러&간다고 들었어!/");
ds_map_add(global.text_data_en, "scr_papcall_2712", "* 진 심 이 야 ^1? 조 심 해 ^1,&  그  녀 석  어 째  뒤 가&  구 린  것  같 아 ./");
ds_map_add(global.text_data_en, "scr_papcall_2714", "뭐-뭐^1?&하지만 메타톤은&인기가 많은데.../");
ds_map_add(global.text_data_en, "scr_papcall_2716", "* 나 는  인 기 가  많 다 고  해 서&  누 구 를  좋 아 하 진  않 아 ./");
ds_map_add(global.text_data_en, "scr_papcall_2718", "응^1, 넌 유명하니까&그런 말 할 수&있는 거지./");
ds_map_add(global.text_data_en, "scr_papcall_2720", "* 풋 ^1, 뭐 !^1?&* 누 구 한 테  유 명 해 ?/");
ds_map_add(global.text_data_en, "scr_papcall_2722", "넌 나한테 유명해!!!/");
ds_map_add(global.text_data_en, "scr_papcall_2724", "* 어 우 우 ..^1.&* 파 피 루 스 ^1, 너 도&  나 한 테  유 명 해 ./");
ds_map_add(global.text_data_en, "scr_papcall_2726", "어우우^1, 세에상에!^1!&엥, 잠깐만.../");
ds_map_add(global.text_data_en, "scr_papcall_2727", "\E3그거 나를&안 좋아한다는&뜻 아냐...?/%%");
ds_map_add(global.text_data_en, "scr_papcall_2732", "* 더  이 상  말 을  말 자 ./%%");
ds_map_add(global.text_data_en, "scr_papcall_2742", "뭐^1? 내 형이 정말&초소에 있다고?/");
ds_map_add(global.text_data_en, "scr_papcall_2743", "\E1근데 ^1, 대신에&핫도그를 팔고 있다고?/");
ds_map_add(global.text_data_en, "scr_papcall_2744", "\E3일을 함으로써&땡땡이를 친다는 건가.../");
ds_map_add(global.text_data_en, "scr_papcall_2745", "확실히 형은&게으름의 달인이야./%%");
ds_map_add(global.text_data_en, "scr_papcall_2750", "더 말할 것도 없지./%%");
ds_map_add(global.text_data_en, "scr_papcall_2756", "뭐^1? 내 형이 정말&초소에 있다고?/");
ds_map_add(global.text_data_en, "scr_papcall_2758", "* 뭐 ^1?&* 난  놈 이  세  곳 에 서 만&  근 무 하 는  줄  알 았 어 ./");
ds_map_add(global.text_data_en, "scr_papcall_2760", "아니^1, 형은..^1.&적어도 네 군데&정도에서 근무할걸?/");
ds_map_add(global.text_data_en, "scr_papcall_2762", "* 대 체  누 가  저 런  놈 을&  자 꾸  고 용 하 는  거 야 ?/%%");
ds_map_add(global.text_data_en, "scr_papcall_2767", "* 진 짜 로 !!/%%");
ds_map_add(global.text_data_en, "scr_papcall_2774", "내 형이 거기&있지도 않다고???/");
ds_map_add(global.text_data_en, "scr_papcall_2775", "\E1형 거기서 핫도그 팔면서&땡땡이 치고 있지 않았어?/");
ds_map_add(global.text_data_en, "scr_papcall_2776", "\E3땡땡이를&땡땡이 친다는 건가.../");
ds_map_add(global.text_data_en, "scr_papcall_2777", "확실히 형은&게으름의 달인이야./%%");
ds_map_add(global.text_data_en, "scr_papcall_2782", "더 말할 것도 없지./%%");
ds_map_add(global.text_data_en, "scr_papcall_2796", "뭐^1? 컨베이어 위의&퍼즐을 풀어야 한다고?/");
ds_map_add(global.text_data_en, "scr_papcall_2797", "\E3그건 퍼즐 설계법&제 101 조항에 위배돼.../");
ds_map_add(global.text_data_en, "scr_papcall_2798", "\E4컨베이어는 끔찍하고&다시는 사용되어선&안 돼!!!/%%");
ds_map_add(global.text_data_en, "scr_papcall_2803", "내가 컨베이어 행성에&살지 않아서 다행이야!!!/%%");
ds_map_add(global.text_data_en, "scr_papcall_2809", "뭐^1? 컨베이어 위의&퍼즐을 풀어야 한다고?/");
ds_map_add(global.text_data_en, "scr_papcall_2811", "* 얌 마 ^1, 내  컨 베 이 어&퍼 즐  아 이 디 어&  말 한  적  있 었 나 ?/");
ds_map_add(global.text_data_en, "scr_papcall_2813", "그게... 뭔데?/");
ds_map_add(global.text_data_en, "scr_papcall_2815", "* 컨 베 이 어  옆 에  놓 인&  4개 의  농 구 대 를&  상 상 해  봐 ./");
ds_map_add(global.text_data_en, "scr_papcall_2816", "\E2* 컨 베 이 어  벨 트 는&  네 가  멀 미 할  때 까 지 ^1,&  계 속   빨 라 지 고 .../");
ds_map_add(global.text_data_en, "scr_papcall_2817", "\E6* 너 는  4개 의  농 구 대 에 다&  한  번 에  토 해 야&  하 는  거 야 !!!/");
ds_map_add(global.text_data_en, "scr_papcall_2819", "진짜 싫다./");
ds_map_add(global.text_data_en, "scr_papcall_2821", "* 타 이 밍 에  맞 춰 서&  토 해 야  돼 !!!/%%");
ds_map_add(global.text_data_en, "scr_papcall_2826", "* 얌 마 !!^1!&* 내  멋 진  아 이 디 어&  더  들 어 볼 래 !?/");
ds_map_add(global.text_data_en, "scr_papcall_2828", "이만 끊어야겠어!!!/%%");
ds_map_add(global.text_data_en, "scr_papcall_2836", "그러니까 네가 뭘 하면&화살표 방향이 뒤집힌다고?/");
ds_map_add(global.text_data_en, "scr_papcall_2837", "어떻게 생겼는지&상상이 안 돼./");
ds_map_add(global.text_data_en, "scr_papcall_2838", "\E0그림을 좀 그려서.../");
ds_map_add(global.text_data_en, "scr_papcall_2839", "\E3전화기에&갖다 대 볼래???/%%");
ds_map_add(global.text_data_en, "scr_papcall_2844", "아직 다 안 그렸어?/%%");
ds_map_add(global.text_data_en, "scr_papcall_2850", "뭐^1? 그 퍼즐을&어떻게 푸냐고^1?&으으음..../");
ds_map_add(global.text_data_en, "scr_papcall_2851", "\E0이런^1, 아무래도 언다인이&풀어 줄 차례인 것 같군!!!/");
ds_map_add(global.text_data_en, "scr_papcall_2853", "\E1* 뭐 !^1?&* 안  돼 ^1, 난  퍼 즐  싫 어 ^1!&* 파 피 루 스 ^1, 네 가  해 !/");
ds_map_add(global.text_data_en, "scr_papcall_2855", "음^1, 알피스가&이 퍼즐을 만들었지^1,&아마?/");
ds_map_add(global.text_data_en, "scr_papcall_2856", "\E0그냥 네가&걔한테 전화해서.../");
ds_map_add(global.text_data_en, "scr_papcall_2857", "\E2섹시한 목소리로&말하는 거야.../");
ds_map_add(global.text_data_en, "scr_papcall_2858", "알피스..^1.&나 자기 도움이 필요한데.../");
ds_map_add(global.text_data_en, "scr_papcall_2859", "(소리나는 윙크)/");
ds_map_add(global.text_data_en, "scr_papcall_2860", "\E2퍼즐 말이야.../");
ds_map_add(global.text_data_en, "scr_papcall_2862", "* 이 런  제 기 랄 ^1!&* 안  돼 ^1!&* 닥 쳐 !!!/");
ds_map_add(global.text_data_en, "scr_papcall_2864", "좋아!!^1!&알피스 번호를 알려 줘!!!/");
ds_map_add(global.text_data_en, "scr_papcall_2865", "\E0내가 직접&하도록 하지!!!/");
ds_map_add(global.text_data_en, "scr_papcall_2867", "* 안  돼 !!!^1!&* 그 건  더  싫 어 !!!/%%");
ds_map_add(global.text_data_en, "scr_papcall_2872", "(소리나는 윙크).../");
ds_map_add(global.text_data_en, "scr_papcall_2873", "\E3잠깐^1,&이거 누구 번호야???/%%");
ds_map_add(global.text_data_en, "scr_papcall_2883", "왕실 근위병이&그 구역을 순찰하고 있어./");
ds_map_add(global.text_data_en, "scr_papcall_2884", "맞아^1, 스노우딘처럼^1,&핫랜드에도&왕실 근위병이 있어./");
ds_map_add(global.text_data_en, "scr_papcall_2885", "워터폴 지역은&언다인이 있으니&그런 건 필요 없지!!!/%%");
ds_map_add(global.text_data_en, "scr_papcall_2890", "그 사람들 봤니?/%%");
ds_map_add(global.text_data_en, "scr_papcall_2896", "* 조 심 해 ^1, 왕 실  근 위 병 이 &  그  구 역 을  순 찰 하 고&  있 어 ./");
ds_map_add(global.text_data_en, "scr_papcall_2897", "\E4* 오 늘 은  RG01하 고&  RG02가  당 번 이 었 던&  것  같 은 데.../");
ds_map_add(global.text_data_en, "scr_papcall_2898", "\E0* 참 ^1, 토 끼  녀 석 이 &  용  녀 석 하 고  같 이&  하 겠 다 고  부 탁 하 더 군 ./");
ds_map_add(global.text_data_en, "scr_papcall_2899", "* 그 렇 게  잘  맞 는&  친 구 가  있 다 는  건&  참  좋 은  거 지 !/%%");
ds_map_add(global.text_data_en, "scr_papcall_2904", "* 그 렇 게  잘  맞 는&  친 구 가  있 다 는  건&  참  좋 은  거 지 !/%%");
ds_map_add(global.text_data_en, "scr_papcall_2912", "난 뉴스가 정말 좋아^1!&정말 유익하잖아.../");
ds_map_add(global.text_data_en, "scr_papcall_2913", "그리고 치열하고^1,&격정적인 액션까지!!!/%%");
ds_map_add(global.text_data_en, "scr_papcall_2918", "세에상 엄청나지!/%%");
ds_map_add(global.text_data_en, "scr_papcall_2924", "* 그 래 ^1! 뉴 스 에 서  그 놈&  엉 덩 이 를  제 대 로&  걷 어 차 줬 잖 아 !!!/");
ds_map_add(global.text_data_en, "scr_papcall_2925", "\E9* 그 리 고  알 피 스 가&  널  도 와 준  것  같 던 데 ^1,&  그 렇 지  않 아 ?/");
ds_map_add(global.text_data_en, "scr_papcall_2926", "\E6* 오 , 신 이 시 여 !!^1!&* 너 희 들  정 말 로&  친 구 들 이  됐 잖 아 .../");
ds_map_add(global.text_data_en, "scr_papcall_2927", "\E8* 정 말  귀 여 워 .../");
ds_map_add(global.text_data_en, "scr_papcall_2928", "\E1* ...아 니  내  말 은 ^1,&  그 러 니 까 .../");
ds_map_add(global.text_data_en, "scr_papcall_2929", "\E2* 난  강 해 !!^1!&* 돌  씹 어 먹 는  게  좋 지 !!/%%");
ds_map_add(global.text_data_en, "scr_papcall_2934", "* 뭐 !?!?/%%");
ds_map_add(global.text_data_en, "scr_papcall_2940", "* (뭔 가  이 상 한  방 해 전 파 가&  있 는  것  같 다 ...)/%%");
ds_map_add(global.text_data_en, "scr_papcall_2948", "코어..^1.&가까워지고 있군^1,&안 그래...?/");
ds_map_add(global.text_data_en, "scr_papcall_2949", "\E6.../%%");
ds_map_add(global.text_data_en, "scr_papcall_2954", ".../%%");
ds_map_add(global.text_data_en, "scr_papcall_2960", "코어..^1.&가까워지고 있군^1,&안 그래...?/");
ds_map_add(global.text_data_en, "scr_papcall_2962", "* 뭐 !^1?&* 아 니 ^1, 우 린  이 제  막&  친 구 가  됐 을  뿐 이 야 !!/");
ds_map_add(global.text_data_en, "scr_papcall_2963", "\E4* 벌 써 부 터  그 렇 게&  가 까 워 질  순  없 어 .../%%");
ds_map_add(global.text_data_en, "scr_papcall_2968", "* 뭐 ?/%%");
ds_map_add(global.text_data_en, "scr_papcall_2980", "저 거미들이&기부를 받는다니&이상한걸./");
ds_map_add(global.text_data_en, "scr_papcall_2981", "\E0잠깐 생각해보면^1,&쟤들 다리가&8개나 있잖아./");
ds_map_add(global.text_data_en, "scr_papcall_2982", "\E3그럼 신발 4켤레지./");
ds_map_add(global.text_data_en, "scr_papcall_2983", "\E04켤레의&분홍색 신발을&신고 있는 거미라./");
ds_map_add(global.text_data_en, "scr_papcall_2984", "그 모습을&떠올려 봐./%%");
ds_map_add(global.text_data_en, "scr_papcall_2989", "음.../%%");
ds_map_add(global.text_data_en, "scr_papcall_2997", "방 전체가 증기 배기구&같은 걸로 가득&차 있다고?/");
ds_map_add(global.text_data_en, "scr_papcall_2998", "\E1아, 이런^1,&그냥 버스 타고&가면 안 돼?/");
ds_map_add(global.text_data_en, "scr_papcall_2999", "\E3핫랜드는 별로야.../%%");
ds_map_add(global.text_data_en, "scr_papcall_3004", "이 구린 곳에 대해선&그만 이야기하자./%%");
ds_map_add(global.text_data_en, "scr_papcall_3010", "방이 증기 배기구로&뒤덮혀 있다고^1?&아, 안 돼.../");
ds_map_add(global.text_data_en, "scr_papcall_3012", "* 야 ^1, 내 가  퍼 즐&  아 이 디 어  너 한 테&  이 야 기  했 던 가 ?/");
ds_map_add(global.text_data_en, "scr_papcall_3013", "* 증 기  배 기 구 로&  가 득 찬  미 로 .../");
ds_map_add(global.text_data_en, "scr_papcall_3014", "\E2* 하 지 만  그  증 기&  배 기 구 들 은&  컨 베 이 어  위 에  있 고 .../");
ds_map_add(global.text_data_en, "scr_papcall_3016", "으악 안 돼!!^1!&정말 싫거든!?!?/%%");
ds_map_add(global.text_data_en, "scr_papcall_3021", "쟤 좀 그만&부추기는 게 좋겠어./%%");
ds_map_add(global.text_data_en, "scr_papcall_3030", "컨베이어 위에 레이저^1?&사양하지!/");
ds_map_add(global.text_data_en, "scr_papcall_3031", "내가 가장 싫어하는&악몽 같아 보이는군./%%");
ds_map_add(global.text_data_en, "scr_papcall_3036", "이 구린 곳에 대해선&그만 이야기하자./%%");
ds_map_add(global.text_data_en, "scr_papcall_3042", "컨베이어 위에 레이저^1?&진심이야???/");
ds_map_add(global.text_data_en, "scr_papcall_3044", "* 야 ^1, 퍼 즐  아 이 디 어 가&  하 나  떠 오 르 는 데&  말 이 야 ./");
ds_map_add(global.text_data_en, "scr_papcall_3046", "오, 이럴 수가??^1?&안 돼??^1?&왜????/");
ds_map_add(global.text_data_en, "scr_papcall_3047", "너 퍼즐 만드는 거&싫어하는 줄 알았는데!!/");
ds_map_add(global.text_data_en, "scr_papcall_3049", "* 그 렇 지 ^1, 근 데&  널  미 치 게  만 드 는  건&  정 말  좋 거 든 !/%%");
ds_map_add(global.text_data_en, "scr_papcall_3054", "제발 쟤 좀&그만 부추겨 줘./%%");
ds_map_add(global.text_data_en, "scr_papcall_3063", "도대체 저 탁자는&어디서 난 거지?/");
ds_map_add(global.text_data_en, "scr_papcall_3064", "\E0혹시 쥐 건가??/%%");
ds_map_add(global.text_data_en, "scr_papcall_3069", "에???/%%");
ds_map_add(global.text_data_en, "scr_papcall_3075", "* 저  탁 자 는  죄 다&  어 디 서  나 는  거 야 ?/");
ds_map_add(global.text_data_en, "scr_papcall_3077", "아마 쥐 건가 보지./");
ds_map_add(global.text_data_en, "scr_papcall_3079", "* 왜  쥐 한 테  탁 자 가&  필 요 한 데 ?/");
ds_map_add(global.text_data_en, "scr_papcall_3081", "치즈를 올려놓기&위함이지./");
ds_map_add(global.text_data_en, "scr_papcall_3083", "* 그 럼  치 즈 는&  어 디 서  나 는  거 야 ?/");
ds_map_add(global.text_data_en, "scr_papcall_3085", "* 치 즈 는  우 유 로&  만 들 지  않 나 ?/");
ds_map_add(global.text_data_en, "scr_papcall_3087", "아 진짜!!^1!&여기서 나가!!!/%%");
ds_map_add(global.text_data_en, "scr_papcall_3092", "잠깐^1, 치즈를&우유로 만든다고??/%%");
ds_map_add(global.text_data_en, "scr_papcall_3102", "와!!^1!&저 연출 좀 봐!/");
ds_map_add(global.text_data_en, "scr_papcall_3103", "\E2내가 이런 사람이랑&친구라니.../");
ds_map_add(global.text_data_en, "scr_papcall_3104", "\E0'뼛속까지' 진짜배기&오페라 스타와&친구라니!!!/%%");
ds_map_add(global.text_data_en, "scr_papcall_3109", "세에상에!/%%");
ds_map_add(global.text_data_en, "scr_papcall_3115", "네가 메타톤과&춤을 췄다니&믿을 수가 없어!/");
ds_map_add(global.text_data_en, "scr_papcall_3117", "* 무 슨  대 수 라 고 .../");
ds_map_add(global.text_data_en, "scr_papcall_3118", "\E2* 예 전 에 ^1, 나 랑  인 간 은&  죽 음 의  춤 을&  춘  적 이  있 었 다 고 !!!/");
ds_map_add(global.text_data_en, "scr_papcall_3120", "와우!!!/");
ds_map_add(global.text_data_en, "scr_papcall_3121", "죽음이란 건 멋진 거야?/");
ds_map_add(global.text_data_en, "scr_papcall_3123", "* 응 ^1, 엄 청  섹 시 해 ./%%");
ds_map_add(global.text_data_en, "scr_papcall_3128", "죽음을 만나보고 싶어.../%%");
ds_map_add(global.text_data_en, "scr_papcall_3135", "* (뭔 가  이 상 한  방 해 전 파 가&  있 는  것  같 다 ...)/%%");
ds_map_add(global.text_data_en, "scr_papcall_3144", "뭐? 나^1?&소리 질러 보라고?/");
ds_map_add(global.text_data_en, "scr_papcall_3145", "\E0그래^1!&해 볼게./");
ds_map_add(global.text_data_en, "scr_papcall_3146", "아^1. 아^1. 아^1. 아^1. 아./");
ds_map_add(global.text_data_en, "scr_papcall_3147", "나 지금 엄청 느리게&소리지르고 있어./%%");
ds_map_add(global.text_data_en, "scr_papcall_3152", "아./%%");
ds_map_add(global.text_data_en, "scr_papcall_3160", "* 뭐 !^1?&* RG01랑  RG02가&  땡 땡 이 치 고  있 다 고 ?!/");
ds_map_add(global.text_data_en, "scr_papcall_3161", "\E2* 이 런 ^1!&* 지 금 쯤  너 를&  죽 였 어 야  할  텐 데 !/");
ds_map_add(global.text_data_en, "scr_papcall_3162", "\E9* 그 야 ^1, 내 가  그 걸&  바 란  건  아 니 지 만 ./");
ds_map_add(global.text_data_en, "scr_papcall_3163", "\E6* 하 지 만  시 도  정 도 는&  해 볼  수  있 었 잖 아 ^1,&  그 치 !?/%%");
ds_map_add(global.text_data_en, "scr_papcall_3169", "* 오  그 래 ^1, 떠 올 랐 어 ./");
ds_map_add(global.text_data_en, "scr_papcall_3170", "* 내 가  그 때  RG01하 고&  RG02더 러  너 를&  붙 잡 는  데  성 공 하 면 ./");
ds_map_add(global.text_data_en, "scr_papcall_3171", "\E9* 둘 에 게  아 이 스 크 림 을&  사  주 겠 다 고  했 거 든 ./");
ds_map_add(global.text_data_en, "scr_papcall_3172", "\E0* 걔 네 들 을  무 사 히&  피 해 갔 길  바 라 ./");
ds_map_add(global.text_data_en, "scr_papcall_3173", "\E6* 왜 냐 하 면&  난  아 이 스 크 림 이&  싫 거 든 !!/%%");
ds_map_add(global.text_data_en, "scr_papcall_3179", "내가 그때 널&거의 다 잡았었는데.../");
ds_map_add(global.text_data_en, "scr_papcall_3180", "내 아이스크림은&어디 있는 거야./%%");
ds_map_add(global.text_data_en, "scr_papcall_3187", "HOT-L.../");
ds_map_add(global.text_data_en, "scr_papcall_3188", "\E0그게 핫랜드&줄임말이지^1, 맞지?/%%");
ds_map_add(global.text_data_en, "scr_papcall_3194", "세에상에!/%%");
ds_map_add(global.text_data_en, "scr_papcall_3200", "* 호 텔 ?^1? 멋 진 데 !^1!&* 괜 찮 은  호 텔 엔&  가  본  적 이  없 거 든 !/");
ds_map_add(global.text_data_en, "scr_papcall_3202", "정말?^1?&나도 그래./");
ds_map_add(global.text_data_en, "scr_papcall_3204", "* 파 피 루 스 ^1, 언 젠 가 는&  호 텔 로  휴 가 를  가 자 !/");
ds_map_add(global.text_data_en, "scr_papcall_3206", "그래!^1!&호텔로 휴가를 가자!!!/%%");
ds_map_add(global.text_data_en, "scr_papcall_3211", "* 음 ^1, 호 텔  말 고  다 른  곳 도&  가  봐 야 겠 구 만 ^1, 그 래 ./");
ds_map_add(global.text_data_en, "scr_papcall_3213", "아^1, 방금 건&빈정거린 거야./");
ds_map_add(global.text_data_en, "scr_papcall_3214", "\E0나는 어떤 이유로든&절대 휴가를&가지 않는다고./%%");
ds_map_add(global.text_data_en, "scr_papcall_3224", "멋지고 근사한&식당이라고!?!?/");
ds_map_add(global.text_data_en, "scr_papcall_3225", "\E2내 요리를 맛본 이상^1,&그런 곳은 초라해&보이잖아, 그렇지?/%%");
ds_map_add(global.text_data_en, "scr_papcall_3231", "거긴 스파게티도&못 만들걸!/%%");
ds_map_add(global.text_data_en, "scr_papcall_3237", "* 워 우 !^1!&* 괜 찮 은  식 당 이 라 고 !?/");
ds_map_add(global.text_data_en, "scr_papcall_3238", "\E6* 한 턱  쏘 는  거 야 ^1?&* 거 기  스 테 이 크 도  있 나 ?/");
ds_map_add(global.text_data_en, "scr_papcall_3240", "쓰으으으읍./");
ds_map_add(global.text_data_en, "scr_papcall_3241", "\E0그런 건 필요 없어!&네 친구들은 훌륭한&요리사라고!/");
ds_map_add(global.text_data_en, "scr_papcall_3243", "* 음 ^1, 아 마  우 리&  요 리  실 력 이  완 벽 하 지&  않 은  걸 지 도 ./");
ds_map_add(global.text_data_en, "scr_papcall_3244", "\E6* 아 니 !!^1!&* 완 벽  그  자 체 지 !^1!&* 먹 어 라 ^1, 임 마 !!/");
ds_map_add(global.text_data_en, "scr_papcall_3245", "\TS \F0 \T0 %");
ds_map_add(global.text_data_en, "scr_papcall_3246", "* (수 화 기  너 머&  스 파 게 티 가  찰 싹  하 는&  소 리 가  들 렸 다 .)/%%");
ds_map_add(global.text_data_en, "scr_papcall_3251", "우정이란 맛있지 않니?/%%");
ds_map_add(global.text_data_en, "scr_papcall_3261", "조심해^1, 최근 들어 많은&호텔이 감염되었어./");
ds_map_add(global.text_data_en, "scr_papcall_3262", "놈들은 닫힌 문 아래&1인치 높이 구멍으로&미끄러져 들어와./");
ds_map_add(global.text_data_en, "scr_papcall_3263", "뭔 소리냐고^1?&보면 알게 될 거야./");
ds_map_add(global.text_data_en, "scr_papcall_3264", "\TS \F0 \T0 %");
ds_map_add(global.text_data_en, "scr_papcall_3265", "* (당 신 은  한 쪽  문 의&  뒤 편 에 서  개  짖 는&  소 리 를  들 었 다 .)/%%");
ds_map_add(global.text_data_en, "scr_papcall_3270", "방금 뭐였어???/%%");
ds_map_add(global.text_data_en, "scr_papcall_3276", "조심해^1.&호텔에 개 문제가&있는 것 같아./");
ds_map_add(global.text_data_en, "scr_papcall_3278", "* 응 ^1?&* 애 완 동 물  금 지 ^1,&  말 하 는  거 지 ?/");
ds_map_add(global.text_data_en, "scr_papcall_3280", "애완동물에 대한&얘기가 아냐./");
ds_map_add(global.text_data_en, "scr_papcall_3282", "* 그 럼  무 슨  문 제 야 ?/");
ds_map_add(global.text_data_en, "scr_papcall_3284", "문제는..^1.&개야./");
ds_map_add(global.text_data_en, "scr_papcall_3286", "* 개 들 이  뭐  어 쨌 다 고 !?/");
ds_map_add(global.text_data_en, "scr_papcall_3288", "모든 개가 아니라^1.&그 딱 한 마리./");
ds_map_add(global.text_data_en, "scr_papcall_3290", "* 그 래 서  뭐 가  문 젠 데 !?/");
ds_map_add(global.text_data_en, "scr_papcall_3292", "전부 다./%%");
ds_map_add(global.text_data_en, "scr_papcall_3297", "* 그 래 서  그  개 는  싫 은 데 ^1,&  말 하 는  괴 상 한  꽃 은&  좋 다 고 ?/");
ds_map_add(global.text_data_en, "scr_papcall_3299", "그 꽃은 내 친구라고!/");
ds_map_add(global.text_data_en, "scr_papcall_3301", "* 그 래 ^1, 네 가&  상 상 친 구 랑&  행 복 하 다 면 야 .../");
ds_map_add(global.text_data_en, "scr_papcall_3303", "아 진짜!^1!&걘 상상이 아냐^1!&이름도 있단 말야!/");
ds_map_add(global.text_data_en, "scr_papcall_3305", "* 이 름 이  뭔 데 ./");
ds_map_add(global.text_data_en, "scr_papcall_3307", "플.../");
ds_map_add(global.text_data_en, "scr_papcall_3308", "\E3플라워리?/");
ds_map_add(global.text_data_en, "scr_papcall_3310", "* 세 상 에 !!^1!&* 너  방 금  그  이 름&  지 어 낸  거 지 !!/");
ds_map_add(global.text_data_en, "scr_papcall_3312", "그래^1, 그렇긴 한데!^1!&하지만 걘 진짜라고!!/%%");
ds_map_add(global.text_data_en, "scr_papcall_3320", "네 이름으로 된&호텔방이 생겼다고!?/");
ds_map_add(global.text_data_en, "scr_papcall_3321", "\E3... 어째서?/");
ds_map_add(global.text_data_en, "scr_papcall_3322", "\E0내 차고는 항상&너에게 열려 있다고!!/%%");
ds_map_add(global.text_data_en, "scr_papcall_3327", "가격도 적당해!!/%%");
ds_map_add(global.text_data_en, "scr_papcall_3333", "네 이름으로 된&호텔방이 생겼다고!?/");
ds_map_add(global.text_data_en, "scr_papcall_3335", "* 좋 아 !^1!&* 집 들 이 를  하 자 !/");
ds_map_add(global.text_data_en, "scr_papcall_3336", "\E9* 피 자 도  시 키 고&  밤 새  게 임 도  하 자 고 !/");
ds_map_add(global.text_data_en, "scr_papcall_3338", '집들이 "게임"^1?&삼인사각 달리기 같은?/');
ds_map_add(global.text_data_en, "scr_papcall_3340", '* 아 니 ^1,&  "해 골  베 개 싸 움 " 이 지 !/');
ds_map_add(global.text_data_en, "scr_papcall_3342", "자-잠깐!!^1!&소파의 베개는 안 돼!/");
ds_map_add(global.text_data_en, "scr_papcall_3344", "* 우 우 ^1, 알 았 어 ./");
ds_map_add(global.text_data_en, "scr_papcall_3346", "잠깐!!^1!&소파째로 하면 안 돼!!/");
ds_map_add(global.text_data_en, "scr_papcall_3348", "* 이 미  늦 었 다 !!!/%%");
ds_map_add(global.text_data_en, "scr_papcall_3353", "뭐야^1, 소파로 날&때리지 않았네./");
ds_map_add(global.text_data_en, "scr_papcall_3355", "* 에 엥 ^1, 내 가  왜&  그 러 겠 어 ?/");
ds_map_add(global.text_data_en, "scr_papcall_3356", "\E6* 집 들 이  때  쓰 려 고&  남 기 는  거 라 고 !!/%%");
ds_map_add(global.text_data_en, "scr_papcall_3364", "엘리베이터에&L1이라고 적혀 있군./");
ds_map_add(global.text_data_en, "scr_papcall_3365", "\E3L이 뭘 의미하는 거지^1?&링귀니?/");
ds_map_add(global.text_data_en, "scr_papcall_3366", "\E0링귀니^1.&납작한 파스타 말한 거야./");
ds_map_add(global.text_data_en, "scr_papcall_3367", "선물 포장할 때도&쓸 수 있어./%%");
ds_map_add(global.text_data_en, "scr_papcall_3372", "납작한 모양 덕에&좋은 리본으로 쓸 수 있지./%%");
ds_map_add(global.text_data_en, "scr_papcall_3378", "\E0엘리베이터에&L1이라고 적혀 있군./");
ds_map_add(global.text_data_en, "scr_papcall_3379", "\E3근데 L이&뭘 뜻하는 거지?/");
ds_map_add(global.text_data_en, "scr_papcall_3381", "\E0* 야 ^1, 파 피 루 스 ^1.&* 생 각  좀  해  봐 ./");
ds_map_add(global.text_data_en, "scr_papcall_3383", "\E3흐으음.../");
ds_map_add(global.text_data_en, "scr_papcall_3385", "\E6* L-리 베 이 터 란  뜻 이 야 ^1,&  바 보 야 !!!/%%");
ds_map_add(global.text_data_en, "scr_papcall_3390", "엘리베이터 철자가&진짜로 그거야?/");
ds_map_add(global.text_data_en, "scr_papcall_3392", "* 아 마 도 ?/%%");
ds_map_add(global.text_data_en, "scr_papcall_3401", "엘리베이터에&R1이라고 적혀 있군./");
ds_map_add(global.text_data_en, "scr_papcall_3402", "\E3R이 뭘 의미하는 거지^1?&라비올리?/");
ds_map_add(global.text_data_en, "scr_papcall_3403", "\E0라비올리..^1.&만두 비슷하게 생긴&파스타지./");
ds_map_add(global.text_data_en, "scr_papcall_3404", "음식 세계의&보물 상자라고나 할까./%%");
ds_map_add(global.text_data_en, "scr_papcall_3409", "안에 보석이나 황금을&넣을 수도 있지./%%");
ds_map_add(global.text_data_en, "scr_papcall_3415", "\E0엘리베이터에&R1이라고 적혀 있군./");
ds_map_add(global.text_data_en, "scr_papcall_3416", "\E3R이 뭘 의미하는 거지?/");
ds_map_add(global.text_data_en, "scr_papcall_3418", "\E0* 야 ^1, 파 피 루 스 ^1.&* 생 각  좀  해  봐 ./");
ds_map_add(global.text_data_en, "scr_papcall_3420", "\E3흐으음.../");
ds_map_add(global.text_data_en, "scr_papcall_3422", "\E6* 빨 강  같 은 데 ^1,&  왜 냐 하 면  불 빛 이&  빨 간 색 이 니 까 !/%%");
ds_map_add(global.text_data_en, "scr_papcall_3427", "그거 말 되네!/%%");
ds_map_add(global.text_data_en, "scr_papcall_3434", "* (휴 대 전 화 가  켜 지 지  않 는 다 .)/%%");
ds_map_add(global.text_data_en, "scr_papcall_3441", "\E0엘리베이터에&R2라고 적혀 있군./");
ds_map_add(global.text_data_en, "scr_papcall_3442", "\E3R이 뭘 의미하는 거지^1?&리가토니?/");
ds_map_add(global.text_data_en, "scr_papcall_3443", "\E0튜브 모양&파스타 말이야./");
ds_map_add(global.text_data_en, "scr_papcall_3444", "급할 때는^1,&빨대처럼 쓸 수도 있지./%%");
ds_map_add(global.text_data_en, "scr_papcall_3449", "만약 소스를&마셔야 한다면 말야./%%");
ds_map_add(global.text_data_en, "scr_papcall_3455", "\E3잠깐^1, 언다인^1.&만약 R이 빨강을&뜻하는 거라면.../");
ds_map_add(global.text_data_en, "scr_papcall_3456", "\E5L은 무슨 색을&의미하는 걸까?/");
ds_map_add(global.text_data_en, "scr_papcall_3458", "* 어 .../");
ds_map_add(global.text_data_en, "scr_papcall_3459", "\E9* 라 이 트  그 린 ./");
ds_map_add(global.text_data_en, "scr_papcall_3461", "아^1! 맞는 것 같아!/");
ds_map_add(global.text_data_en, "scr_papcall_3462", "잠깐^1,&그거 두 단어 아니야?/");
ds_map_add(global.text_data_en, "scr_papcall_3464", "* 라 이 트  씨  그 린 ./");
ds_map_add(global.text_data_en, "scr_papcall_3466", "세 단어로 바꾼다고&될 리가 없잖아!/%%");
ds_map_add(global.text_data_en, "scr_papcall_3471", "* 라 이 트  씨&  폼  그 린 ./");
ds_map_add(global.text_data_en, "scr_papcall_3473", "다음 방에 가지 그래!?/%%");
ds_map_add(global.text_data_en, "scr_papcall_3482", "엘리베이터에&L2라고 적혀 있군./");
ds_map_add(global.text_data_en, "scr_papcall_3483", "\E3L이 뭘 의미하는 거지^1?&라자냐?/");
ds_map_add(global.text_data_en, "scr_papcall_3484", "\E3아니었음 좋겠네^1.&난 더 이상 라자냐를&안 만들 거든./");
ds_map_add(global.text_data_en, "scr_papcall_3485", "\E1그 먹보 강아지가&항상 먼저 먹어버린다구!/");
ds_map_add(global.text_data_en, "scr_papcall_3486", "\E3처음엔&내 뼈를 먹더니..^1.&그리고 지금은.../%%");
ds_map_add(global.text_data_en, "scr_papcall_3491", "조그만 파란 상자로&도망쳐 들어가서는,/");
ds_map_add(global.text_data_en, "scr_papcall_3492", "혼자 담요를 덮고&잠들었어.../%%");
ds_map_add(global.text_data_en, "scr_papcall_3499", "\E2* 좋 아 ^1, 좋 아 ^1.&* 알 았 다 ./");
ds_map_add(global.text_data_en, "scr_papcall_3500", '\E9* L은  "라 임 " 색 깔 을&  의 미 하 는  거 야 ./');
ds_map_add(global.text_data_en, "scr_papcall_3502", "\E0정말!?/");
ds_map_add(global.text_data_en, "scr_papcall_3503", "\E3난 라임 싫어./");
ds_map_add(global.text_data_en, "scr_papcall_3505", "\E1* 뭐 !^1?&  라 임 은  최 고 라 구 !^1!&* 난  항 상  라 임 을  먹 는 데 !!/");
ds_map_add(global.text_data_en, "scr_papcall_3507", "\E3사실^1, 예전에 혼자&스파를 해 본 적이&있는데 말야./");
ds_map_add(global.text_data_en, "scr_papcall_3508", "\E0TV에서 보고^1,&라임을 썰어서&내 눈에 놔 봤는데./");
ds_map_add(global.text_data_en, "scr_papcall_3509", "\E1완전 따갑더라고!^1!&그런 걸 어떻게 해!?/");
ds_map_add(global.text_data_en, "scr_papcall_3511", "\E6* 세 상 에 ^1!&* 그 건  라 임  아 냐 ^1!&* 오 이 라 고  오 이 !/%%");
ds_map_add(global.text_data_en, "scr_papcall_3516", "\E3난 그렇게 하면&젊어질 줄 알았지./");
ds_map_add(global.text_data_en, "scr_papcall_3517", "\E1근데 별로&효과가 없더라!/");
ds_map_add(global.text_data_en, "scr_papcall_3518", "\E5그래서 더 많은&라임을 눈에다&쑤셔넣었지./");
ds_map_add(global.text_data_en, "scr_papcall_3520", "\E1* 우 엑 !^1!&* 어 떻 게  그 런  짓 을  해 !?/");
ds_map_add(global.text_data_en, "scr_papcall_3522", "\E2난 그저 잘 생긴^1,&미소년 같은 눈을&가졌으면 했어./");
ds_map_add(global.text_data_en, "scr_papcall_3523", "메타톤처럼..^1.&후.../");
ds_map_add(global.text_data_en, "scr_papcall_3525", "* (얜  눈 도  없 잖 아 !!!)/%%");
ds_map_add(global.text_data_en, "scr_papcall_3533", "* (휴 대 전 화 가  켜 지 지  않 는 다 .)/%%");
ds_map_add(global.text_data_en, "scr_papcall_3540", "엘리베이터에&L3라고 적혀 있군./");
ds_map_add(global.text_data_en, "scr_papcall_3541", "\E3L이 뭘 의미하는 거지^1?&루마코니?/");
ds_map_add(global.text_data_en, "scr_papcall_3542", "\E0그건 달팽이 모양&파스타야!/");
ds_map_add(global.text_data_en, "scr_papcall_3543", "\E3샌즈 형이 최근에&사다 뒀는데 말이야./");
ds_map_add(global.text_data_en, "scr_papcall_3544", "\E2형은 아마 거기다&핫도그랑 슬라임을&채워 넣을 걸./%%");
ds_map_add(global.text_data_en, "scr_papcall_3549", "맞다!^1!&언젠가 너한테도&나눠줄 거야!/%%");
ds_map_add(global.text_data_en, "scr_papcall_3555", "\E0좀 더 추상적으로&생각해봐야겠어./");
ds_map_add(global.text_data_en, "scr_papcall_3556", "\E3아마 내 생각에&L의 의미는.../");
ds_map_add(global.text_data_en, "scr_papcall_3557", "\E2사랑./");
ds_map_add(global.text_data_en, "scr_papcall_3559", "\E2* 근 데  사 랑 하 면&  불 타 는  듯 한&  빨 간 색  아 닌 가 !?/");
ds_map_add(global.text_data_en, "scr_papcall_3560", "\E9* 모 양 은  만 화 풍 의&  인 간  심 장 같 은  거&  아 냐 ?/");
ds_map_add(global.text_data_en, "scr_papcall_3562", "\E3하지만 언다인^1,&넌 사람의 심장을&녹색으로 만들잖아?/");
ds_map_add(global.text_data_en, "scr_papcall_3564", "\E9* 꼭  내 가  사 람 들 을&  멀 미 나 게  한 다 는&  말 처 럼  들 리 는 데 ./");
ds_map_add(global.text_data_en, "scr_papcall_3566", "\E0음^1, 아마 애정어린&멀미일 거야./");
ds_map_add(global.text_data_en, "scr_papcall_3568", "\E6* 좋 아 ^1, 그 래 ^1!&  그 게  나 야 !/%%");
ds_map_add(global.text_data_en, "scr_papcall_3573", "정해졌어!^1!&L이 의미하는 거!!/");
ds_map_add(global.text_data_en, "scr_papcall_3574", "\E3언다인이&구역질나게 만든 마음?/%%");
ds_map_add(global.text_data_en, "scr_papcall_3582", "* (휴 대 전 화 가  켜 지 지  않 는 다 .)/%%");
ds_map_add(global.text_data_en, "scr_papcall_3589", "엘리베이터에&R3라고 적혀 있군./");
ds_map_add(global.text_data_en, "scr_papcall_3590", "\E3R이 뭘 의미하는 거지?&로티니?/");
ds_map_add(global.text_data_en, "scr_papcall_3591", "나사 모양을 한&파스타인데./");
ds_map_add(global.text_data_en, "scr_papcall_3592", "내 감시 초소를 조립할 때&사용하곤 했어./%%");
ds_map_add(global.text_data_en, "scr_papcall_3597", "내 초소는 '골'판지로&만들어졌거든!/%%");
ds_map_add(global.text_data_en, "scr_papcall_3603", "\E3잠깐만^1.&만약 R하고 L이./");
ds_map_add(global.text_data_en, "scr_papcall_3604", "\E0오른쪽하고 왼쪽을&의미하는 거라면???/");
ds_map_add(global.text_data_en, "scr_papcall_3606", "\E9* 그 럴  리 가 !&* 완 전  말 도  안  돼 ./");
ds_map_add(global.text_data_en, "scr_papcall_3607", "\E6* 반 대 쪽 에 서  보 면 ^1,&  완 전 히  다 르 게  되 잖 아 !/%%");
ds_map_add(global.text_data_en, "scr_papcall_3612", "하지만 만약&네가 그 반대편을&본다면.../");
ds_map_add(global.text_data_en, "scr_papcall_3613", "어떻게 그게&틀렸다고 자신할 수&있는 거야?/");
ds_map_add(global.text_data_en, "scr_papcall_3615", "* 알 파 벳 에  대 해&  너 무  철 학 적 으 로&  생 각 하 진  말 자 구 ./%%");
ds_map_add(global.text_data_en, "scr_papcall_3625", "\E9파피루스^1?&그게 누군가?/");
ds_map_add(global.text_data_en, "scr_papcall_3626", "이 몸은..^1.&COOLSKELETON95다./");
ds_map_add(global.text_data_en, "scr_papcall_3627", "미안^1. 얘기할 시간 없네^1.&나는 온라인 유명인사라&바쁜 몸이거든./");
ds_map_add(global.text_data_en, "scr_papcall_3628", "\E0녜 헤 헤^1!&농담이야^1!&속았지!/");
ds_map_add(global.text_data_en, "scr_papcall_3629", "난 그저 평범한&신사 놀이를 하던&파피루스였다고!/%%");
ds_map_add(global.text_data_en, "scr_papcall_3634", "찡끗!/");
ds_map_add(global.text_data_en, "scr_papcall_3635", "너 내가 윙크하는 거&보이는 거지^1,&그렇지./%%");
ds_map_add(global.text_data_en, "scr_papcall_3641", "\E9* 파 피 루 스 ..^1.&* 왜  그 런  표 정 을&  짓 는  거 야 ?/");
ds_map_add(global.text_data_en, "scr_papcall_3643", "\E9파피루스?/");
ds_map_add(global.text_data_en, "scr_papcall_3644", "해골 잘못 보셨어^1?&난 매우 멋진&온라인 사나이,/");
ds_map_add(global.text_data_en, "scr_papcall_3645", "COOLSKELETON95라고./");
ds_map_add(global.text_data_en, "scr_papcall_3647", "* 뭐 ^1?&* 아 니 야 ^1!&* 넌  파 피 루 스 잖 아 !/");
ds_map_add(global.text_data_en, "scr_papcall_3649", "(언다인!!!^1)&(조용히 해!!!)/");
ds_map_add(global.text_data_en, "scr_papcall_3650", "(내 온라인상의&비밀 인격을&들춰내고 있잖아!)/%%");
ds_map_add(global.text_data_en, "scr_papcall_3655", "* 좋 아  그 렇 다 면 ^1!&* 나 는  언 다 인 이  아 니 야 !/");
ds_map_add(global.text_data_en, "scr_papcall_3656", "\E2* 내  이 름 은 ..&* StrongFish91!/");
ds_map_add(global.text_data_en, "scr_papcall_3658", "뭐라고^1?&정말!^1?&오 이런!!!/");
ds_map_add(global.text_data_en, "scr_papcall_3659", "STRONGFISH!^1!&제발 내 친구&언다인을 돌려줘!/");
ds_map_add(global.text_data_en, "scr_papcall_3661", "* 어 ^1, 좋 아 ./%%");
ds_map_add(global.text_data_en, "scr_papcall_3671", "핫랜드에 앞치마가&놓여 있다고^1?&그거 말 되네./");
ds_map_add(global.text_data_en, "scr_papcall_3672", "요리는 절대적으로&불이 필요한 법이지./%%");
ds_map_add(global.text_data_en, "scr_papcall_3677", "아이스크림을&요리하는 게 아니라면./%%");
ds_map_add(global.text_data_en, "scr_papcall_3683", "핫랜드에 앞치마가&놓여 있다고^1?&그거 말 되네./");
ds_map_add(global.text_data_en, "scr_papcall_3685", "\E3* 맞 아 ^1, 요 리 는&  확 실 히  불 이  필 요 해 !/");
ds_map_add(global.text_data_en, "scr_papcall_3687", "\E3아이스크림을&요리하는 게 아니라면./");
ds_map_add(global.text_data_en, "scr_papcall_3689", "\E9* 넌  아 이 스 크 림 을&  '요 리 한 다 '고  해 ...?/");
ds_map_add(global.text_data_en, "scr_papcall_3691", "\E5그게 네가 저번에&아이스크림 만들 때&그랬^1, 어.../");
ds_map_add(global.text_data_en, "scr_papcall_3693", "* 아 , 이 런 ^1, 거 의&  잊 고  있 었 어 ^1!&* 완 전  개 판 이 야 !/%%");
ds_map_add(global.text_data_en, "scr_papcall_3700", "* 다  털 어 내 는  데&  평 생 은  걸 리 겠 군 ./%%");
ds_map_add(global.text_data_en, "scr_papcall_3710", "\E0와우^1! 나 봤다고^1!&색깔 타일 퍼즐 말이야!/");
ds_map_add(global.text_data_en, "scr_papcall_3713", "\E2네가 해냈어!^1!&내 조언 덕분에&해냈어!!/");
ds_map_add(global.text_data_en, "scr_papcall_3714", "난 설명을&참 잘하나 봐!/");
ds_map_add(global.text_data_en, "scr_papcall_3715", "녜 헤 헤!/%%");
ds_map_add(global.text_data_en, "scr_papcall_3719", "\E3해내지 못한&모양이네./");
ds_map_add(global.text_data_en, "scr_papcall_3720", "\E0다음 번엔 확실히&대비해야 할 거야!/");
ds_map_add(global.text_data_en, "scr_papcall_3721", "내가 모두 다&다시 설명해 주지!/");
ds_map_add(global.text_data_en, "scr_papcall_3722", "그러니까^1, 붉은 타일은&지나갈 수 없어./");
ds_map_add(global.text_data_en, "scr_papcall_3723", "분홍 타일은&아무것도 아니야./");
ds_map_add(global.text_data_en, "scr_papcall_3724", "녹색 타일은&어.../%%");
ds_map_add(global.text_data_en, "scr_papcall_3730", "격자무늬 타일은&어.../%%");
ds_map_add(global.text_data_en, "scr_papcall_3731", "녜 헤 헤!/%%");
ds_map_add(global.text_data_en, "scr_papcall_3738", "\E3코어 안으로&간다고...^1?&흠./");
ds_map_add(global.text_data_en, "scr_papcall_3739", "거길 지나가면&전화를 할 수&없을 거야./");
ds_map_add(global.text_data_en, "scr_papcall_3740", "\E1나도 알아^1!&완전 끔찍하지 않니!/");
ds_map_add(global.text_data_en, "scr_papcall_3741", "\E3나 없이 어떻게 가려고?/");
ds_map_add(global.text_data_en, "scr_papcall_3742", "\E0뭐^1, 너라면&길을 찾을 수&있을 거야!/");
ds_map_add(global.text_data_en, "scr_papcall_3743", "연락할 테니까^1,&걱정하지 마!/");
ds_map_add(global.text_data_en, "scr_papcall_3744", "행운을 빌어!/%%");
ds_map_add(global.text_data_en, "scr_papcall_3749", "됐어^1! 잘 가란 인사&안 해도 돼!/%%");
ds_map_add(global.text_data_en, "scr_papcall_3755", "\E3코어 안으로&간다고...^1?&흠./");
ds_map_add(global.text_data_en, "scr_papcall_3757", "\E4* 코 어 는&  전 기  에 너 지 로  가 득 한&  거 대 한  탑 이 야 ./");
ds_map_add(global.text_data_en, "scr_papcall_3758", "* 거 기 선  네  휴 대 전 화 가&  작 동 하 지  않 을 지 도&  몰 라 .../");
ds_map_add(global.text_data_en, "scr_papcall_3760", "\E1아, 이런!/");
ds_map_add(global.text_data_en, "scr_papcall_3761", "\E3우리 없이&뭘 하려고...?/");
ds_map_add(global.text_data_en, "scr_papcall_3763", "* 뭔 가  해 야  할&  일 이  있 는  거 지 ^1,&  그 렇 지 ...?/");
ds_map_add(global.text_data_en, "scr_papcall_3764", "* 음 .../");
ds_map_add(global.text_data_en, "scr_papcall_3765", "\E9* 통 화 할  수  없 더 라 도 ^1,&  마 음 만 은  너 와&  함 께 야 ^1, 알 겠 지 !?/");
ds_map_add(global.text_data_en, "scr_papcall_3767", "\E0그래^1! 넌 우릴&지울 수 없어!/");
ds_map_add(global.text_data_en, "scr_papcall_3769", "\E9* 우 리 가  널  믿 고&  있 으 니 까 ^1, 잘  할  수&  있 을  거 야 !/%%");
ds_map_add(global.text_data_en, "scr_papcall_3775", "* 아 직  안 녕 이 란  말 은&  하 지  않 을 게 !/%%");
ds_map_add(global.text_data_en, "scr_papcall_3785", "\E0메타톤 공연&포스터라고?/");
ds_map_add(global.text_data_en, "scr_papcall_3786", "근사한데^1.&나도 퍼즐을 알리는&포스터가 있었으면!/");
ds_map_add(global.text_data_en, "scr_papcall_3787", "\E3초대 가수도&조금 부르고 말이야./%%");
ds_map_add(global.text_data_en, "scr_papcall_3792", "내 주제가도&연주하겠지!/");
ds_map_add(global.text_data_en, "scr_papcall_3793", "\E3주제가만&구하면 되겠는데./%%");
ds_map_add(global.text_data_en, "scr_papcall_3799", "\E0메타톤 공연&포스터라고?/");
ds_map_add(global.text_data_en, "scr_papcall_3800", "근사한데^1.&나도 퍼즐을 알리는&포스터가 있었으면!/");
ds_map_add(global.text_data_en, "scr_papcall_3802", "\E1* 아 ^1! 그 리 고  나 도  내&  싸 움 을  알 릴&  포 스 터 가  필 요 해 !/");
ds_map_add(global.text_data_en, "scr_papcall_3804", "본격적이군^1!&라이브 밴드도 부르자!/");
ds_map_add(global.text_data_en, "scr_papcall_3806", "* 그 리 고  바 베 큐 !/");
ds_map_add(global.text_data_en, "scr_papcall_3808", "그리고 불꽃놀이!/");
ds_map_add(global.text_data_en, "scr_papcall_3810", "* 그 리 고  다 시  바 베 큐 !/");
ds_map_add(global.text_data_en, "scr_papcall_3812", "그냥 싸우는 대신&바베큐나 먹는 게&어때?/");
ds_map_add(global.text_data_en, "scr_papcall_3814", "\E6* 그 러 자 !/%%");
ds_map_add(global.text_data_en, "scr_papcall_3820", "\E2* 이  창 을&  케 밥  꼬 챙 이 로&  쓰 면  되 겠 네 !/");
ds_map_add(global.text_data_en, "scr_papcall_3822", "그리고 뼈를&뼈밥 꼬챙이로&쓰자!/");
ds_map_add(global.text_data_en, "scr_papcall_3824", "* 뼈 밥 이  뭐 야 ?/");
ds_map_add(global.text_data_en, "scr_papcall_3826", "케밥 비슷한 건데&뼈밖에 없는 거야./%%");
ds_map_add(global.text_data_en, "scr_papcall_3836", "\E0거미도&갈퀴발이 있을까?/");
ds_map_add(global.text_data_en, "scr_papcall_3837", "\E3잠깐^1.&거미는 발이 없잖아./");
ds_map_add(global.text_data_en, "scr_papcall_3838", "\E0거미도&갈퀴손이 있을까?/%%");
ds_map_add(global.text_data_en, "scr_papcall_3844", "궁금하구먼./%%");
ds_map_add(global.text_data_en, "scr_papcall_3850", "\E0저기^1, 언다인^1.&거미도 갈퀴발이 있어?/");
ds_map_add(global.text_data_en, "scr_papcall_3852", "\E9* 아 니 ^1, 오 리 한 테&  갈 퀴 가  달 려  있 지 ./");
ds_map_add(global.text_data_en, "scr_papcall_3854", "오리가 거미줄을&뿜을 수 있어!?/");
ds_map_add(global.text_data_en, "scr_papcall_3856", "* 당 연 하 지 ^1, 오 리 가&  빵 을  거 미 줄 로&  감 싸 는  거  못  봤 냐 ?/");
ds_map_add(global.text_data_en, "scr_papcall_3857", "\E3* 그 리 고  송 곳 니 로&  그  내 장 을  전 부&  빨 아 먹 는 데 ?/");
ds_map_add(global.text_data_en, "scr_papcall_3859", "빵한테 내장이 있어?/");
ds_map_add(global.text_data_en, "scr_papcall_3861", "* 당 연 하 지 ^1. 팔 기  전 에&  다  제 거 한  다 음&  파 는  거 야 ./");
ds_map_add(global.text_data_en, "scr_papcall_3863", "\E0우와!^1!&너 정말 똑똑하구나^1,&언다인!/");
ds_map_add(global.text_data_en, "scr_papcall_3865", "* (난  당 연 히&  농 담 이 란  거  알  줄&  알 았 는 데 ...)/%%");
ds_map_add(global.text_data_en, "scr_papcall_3872", "\E9* 저 기 ^1, 파 피 루 스 ^1, 내 가&  너 한 테  농 담 했 던  거 ^1,&  알 지 ...?/");
ds_map_add(global.text_data_en, "scr_papcall_3874", "당연하지!/");
ds_map_add(global.text_data_en, "scr_papcall_3875", "\E2거미한테&갈퀴발이 있단 건&모두가 알아./%%");
ds_map_add(global.text_data_en, "scr_papcall_3880", "* (신 호 가  거 미 줄 에  막 힌 다 .)/%%");
ds_map_add(global.text_data_en, "scr_papcall_3887", "거미에도 두 종류가&있다나 봐./");
ds_map_add(global.text_data_en, "scr_papcall_3888", "핫랜드에 사는 거미와^1,&폐허에 사는 거미./");
ds_map_add(global.text_data_en, "scr_papcall_3889", "\E3하지만 거미는&스노우딘의 추위를&못 견디니 말야./");
ds_map_add(global.text_data_en, "scr_papcall_3890", "뭔가 이동수단이&필요하겠지./");
ds_map_add(global.text_data_en, "scr_papcall_3891", "\E0바퀴가 여덟 개인&2인용 오토바이 라든지./%%");
ds_map_add(global.text_data_en, "scr_papcall_3897", "혹은 바퀴가 여덟 개인&외발자전거라든지!/%%");
ds_map_add(global.text_data_en, "scr_papcall_3903", "내 온라인 팬들 중에도&거미가 있을까?/");
ds_map_add(global.text_data_en, "scr_papcall_3905", "* 근 데  거 미 들 도&  인 터 넷 을  쓰 나 ?/");
ds_map_add(global.text_data_en, "scr_papcall_3907", "* 장 난 해 ^1?&* 거 미 도  인 터 넷  '그 물 망 '&  쓰 는  거  좋 아 한 다 고 ./");
ds_map_add(global.text_data_en, "scr_papcall_3909", "샌즈 형!/");
ds_map_add(global.text_data_en, "scr_papcall_3910", "\E0형이 맞을 때도 있네./%%");
ds_map_add(global.text_data_en, "scr_papcall_3918", "\E3내 웹사이트에&들러줘서 코마워./");
ds_map_add(global.text_data_en, "scr_papcall_3919", "\E0거미들이 포스팅하기&좋아하는 거야./%%");
ds_map_add(global.text_data_en, "scr_papcall_3924", "* (신 호 가  거 미 줄 에  막 힌 다 .)/%%");
ds_map_add(global.text_data_en, "scr_papcall_3931", "흠..^1.&미스터리한&과학의 집이네./");
ds_map_add(global.text_data_en, "scr_papcall_3933", '* 표 지 판 에&  "lab"이 라 고&  쓰 여  있 어 ./');
ds_map_add(global.text_data_en, "scr_papcall_3935", "랩?/");
ds_map_add(global.text_data_en, "scr_papcall_3937", "* 그 러 니 까 ..^1.&  실 험 실 말 이 야 ./");
ds_map_add(global.text_data_en, "scr_papcall_3939", "시럽실..^1. ?/");
ds_map_add(global.text_data_en, "scr_papcall_3940", "안에 시럽이&있다는 거야?/");
ds_map_add(global.text_data_en, "scr_papcall_3942", "* 그 러 니 까 ./");
ds_map_add(global.text_data_en, "scr_papcall_3943", "\E2* 그 냥  틀 렸 다 곤&  안  할 게 ./%%");
ds_map_add(global.text_data_en, "scr_papcall_3948", "이상한 과자 집이라.../%%");
ds_map_add(global.text_data_en, "scr_papcall_3956", "* 그 건  알 피 스 의  집 이 야 ./");
ds_map_add(global.text_data_en, "scr_papcall_3957", "\E9* 이 봐 ^1, 다 같 이  가 서&  애 니 나  보 는  게  어 때 ?/");
ds_map_add(global.text_data_en, "scr_papcall_3959", "애니?/");
ds_map_add(global.text_data_en, "scr_papcall_3960", "그거 꼬마들 보는&만화 같은 거 아니야?/");
ds_map_add(global.text_data_en, "scr_papcall_3962", "* 세 상 에 !!/");
ds_map_add(global.text_data_en, "scr_papcall_3963", "\E6* 애 니 는  애 들 용 이  아 냐 ^1!&  심 오 하 고 ^1!&* 감 동 적 이 라 고 !!!/");
ds_map_add(global.text_data_en, "scr_papcall_3965", "이게&(아기가 내는 소리)&감동적이야?/");
ds_map_add(global.text_data_en, "scr_papcall_3967", "* 당 연 ㅎㅏ 지 ㅇㅣ&  흐 르 는 눈 물 ㅇㅣ&  그 증 ㄱㅓ ㄹㅏ 고 !!!/%%");
ds_map_add(global.text_data_en, "scr_papcall_3972", "잠깐만.../");
ds_map_add(global.text_data_en, "scr_papcall_3973", "\E5언다인^1,&너 애니 좋아해?/");
ds_map_add(global.text_data_en, "scr_papcall_3975", "* .../");
ds_map_add(global.text_data_en, "scr_papcall_3977", "어이구!!!/");
ds_map_add(global.text_data_en, "scr_papcall_3978", "\E3사실^1, 난 애니를&본 적이 한 번도&없는데./");
ds_map_add(global.text_data_en, "scr_papcall_3979", "\E0아마 난 애니를&정말 좋아할 거야!/");
ds_map_add(global.text_data_en, "scr_papcall_3981", "* 그 러 지  마 ^1, 파 피 루 스 ./");
ds_map_add(global.text_data_en, "scr_papcall_3983", "난 애들 보는 만화나&좋아하는 애기니까!/");
ds_map_add(global.text_data_en, "scr_papcall_3985", "* 그 런  식 으 로&  말 하 지  말 랬 지 ^1,&  파 피 루 스 !!/%%");
ds_map_add(global.text_data_en, "scr_papcall_3993", "* 뭣 !^1?&* 왕 실  근 위 병 이&  길 을  막 고  있 다 고 !?/");
ds_map_add(global.text_data_en, "scr_papcall_3994", "\E2* 그 럼  내 가  얘 기 를 ...!/");
ds_map_add(global.text_data_en, "scr_papcall_3995", "\E4* 잠 깐 ^1, &  아 니 다 ^1,/");
ds_map_add(global.text_data_en, "scr_papcall_3996", "\E2* 널  찾 아 서  없 애 라 고&  이 미  말 해  둔  상 태 니 깐 !/");
ds_map_add(global.text_data_en, "scr_papcall_3997", "\E1* 그 냥  맘 이  바 뀌 었 다 고&  말 할  순  없 어 ./");
ds_map_add(global.text_data_en, "scr_papcall_3998", "\E2* 알 피 스 가 ^1, 애 니 들 을&  보 여 줬 었 거 든 .& 뭐 에  대 한  거 냐 면 ..../");
ds_map_add(global.text_data_en, "scr_papcall_3999", "\E1* 어 ^1, 인 간 들 에  대 한  거 ?&* 그 러 니 까  내 가  인 간 의&  약 점 을  잘  알  수  있 도 록 ?/");
ds_map_add(global.text_data_en, "scr_papcall_4000", "\E2* 하 나 는  인 간 이&  말 이 야 ^1,&  어 .../");
ds_map_add(global.text_data_en, "scr_papcall_4001", "\E6* 뭐 ^1, 이 러 면  충 분 하 겠 지 ^1,&  그 들 은  사 람 의  마 음 을&  조 종 할  수  있 어 !/");
ds_map_add(global.text_data_en, "scr_papcall_4002", "\E3* 놀 랐 나 ^1?&* 난  네  종 족 의  숨 겨 진&  힘 을  알 고  있 지 !/");
ds_map_add(global.text_data_en, "scr_papcall_4003", "\E1* 어 쨌 든 ^1, 난  우 리&  근 위 병 들 에 게  내 가&  인 간 을  지 키 려  한 다 면 ../");
ds_map_add(global.text_data_en, "scr_papcall_4004", "\E2* 이 상 한  최 면 같 은  게&  걸 려 있 는  거 라 고&  미 리  말 해  뒀 지 !/");
ds_map_add(global.text_data_en, "scr_papcall_4005", "\E6* 내 가  뭐 라 고  말 해 도&  무 시 하 라 고  말 이 야 !/");
ds_map_add(global.text_data_en, "scr_papcall_4006", "\E7* 정 말 ^1, 미 안 해 ..^1.&* 이 미  내 가  손  쓸  수&  없 는  상 황 이 야 ./");
ds_map_add(global.text_data_en, "scr_papcall_4007", "\E9* 어 쨌 건 ^1, 그  만 화 는&  진 짜  끝 내 준 다 고 !/%%");
ds_map_add(global.text_data_en, "scr_papcall_4013", "\E6* 널  지 나 가 게  해  달 란&  명 령 은  안  내 릴 거 야 !/%%");
ds_map_add(global.text_data_en, "scr_papcall_4019", "* (응 답 이  없 다 .)/%%");
ds_map_add(global.text_data_en, "scr_papcall_4026", "* 따 르 릉 ..^1. 따 르 릉 .../");
ds_map_add(global.text_data_en, "scr_papcall_4033", "* 따 르 릉 ..^1. 따 르 릉 .../");
ds_map_add(global.text_data_en, "scr_papcall_4034", "* (반 응 이  없 다 ...)/%%");
ds_map_add(global.text_data_en, "scr_papcall_4040", "더 이상 할 말이 없구만./%%");
ds_map_add(global.text_data_en, "scr_torcall_7", "* (토 리 엘 에 게 서  문 자 를  받 았 다 .)/");
ds_map_add(global.text_data_en, "scr_torcall_8", "* 프 리 스 크 에 게 ,/");
ds_map_add(global.text_data_en, "scr_torcall_9", "* 샌 즈 와  알 피 스 가  문 자  쓰 는&  방 법 을  알 려 줬 단 다 ^1.&* 참  많 이  배 우 고  있 어 ./");
ds_map_add(global.text_data_en, "scr_torcall_10", "* 예 를  들 어 서 ...&* 웃 는  얼 굴 이  뭔 지  아 니 ?/");
ds_map_add(global.text_data_en, "scr_torcall_11", "* 이 것  좀  보 렴 ./");
ds_map_add(global.text_data_en, "scr_torcall_12", "  ]: )/");
ds_map_add(global.text_data_en, "scr_torcall_13", "* 이 제  고 개 를  왼 쪽 으 로&  기 울 여  보 렴 ./");
ds_map_add(global.text_data_en, "scr_torcall_14", "* 널  보 고  웃 고  있 는  내  얼 굴 이 야 ^1!&* 알 아 보 겠 니 ?/");
ds_map_add(global.text_data_en, "scr_torcall_15", "* ㅋ ㅋ ㅋ ^1!&* ('크 크 크 '하 고  웃 는&  소 리 를  줄 인  거 란 다 .)/");
ds_map_add(global.text_data_en, "scr_torcall_16", "* 토 리 엘 로 부 터 ^1 /");
ds_map_add(global.text_data_en, "scr_torcall_17", "* (지 금 은  이 게  전 부 란 다 .^1)&* (다 음  방 으 로  가 면 ^1,&  더  받 을  거 야 .)/%%");
ds_map_add(global.text_data_en, "scr_torcall_22", "* (토 리 엘 이  문 자 를  보 냈 다 .)&* 프 리 스 크 에 게 ,/");
ds_map_add(global.text_data_en, "scr_torcall_23", "* 지 금  어 떠 니 ^1? 꽤  오 랫 동 안&  돌 아 다 녔 잖 니 ./");
ds_map_add(global.text_data_en, "scr_torcall_24", "* 말 썽 에  휘 말 리 지&  않 았 으 면  좋 겠 구 나 ./");
ds_map_add(global.text_data_en, "scr_torcall_25", "* 농 담 이 란 다 ^1.&* ㅋ ㅋ ㅋ !/");
ds_map_add(global.text_data_en, "scr_torcall_26", "* 토 리 엘 로 ㅂ 터 ^1 /");
ds_map_add(global.text_data_en, "scr_torcall_27", "* 추 신 : 말 썽  일 으 키 지  말 렴 ./%%");
ds_map_add(global.text_data_en, "scr_torcall_32", "* (토 리 엘 이  문 자 를  보 냈 다 .)&* 저 기 ,/");
ds_map_add(global.text_data_en, "scr_torcall_33", "* '로 ㅂ 터 '라 고  쓴  게  아 니 야 .&  '로 부 터 '라 고  쓰 려 고  했 어 ./");
ds_map_add(global.text_data_en, "scr_torcall_34", "* 큰  손 으 로  쓰 려 니  힘 들 구 나 ./");
ds_map_add(global.text_data_en, "scr_torcall_35", "* 샌 즈 에 게  대 신&  부 탁 해 야  할 지 도&  모 르 겠 어 ./%%");
ds_map_add(global.text_data_en, "scr_torcall_40", "* (토 리 엘 이  문 자 를  보 냈 다 .^1)&* 이 제 부 터  샌 즈 가&  대 신  써 줄  거 란 다 ./%%");
ds_map_add(global.text_data_en, "scr_torcall_45", "* (토 리 엘 이  문 자 를  보 냈 다 .)/");
ds_map_add(global.text_data_en, "scr_torcall_46", "* 야  프 리 스 크 ^1.&* 나  토 리 이 이 엘 이 야 ./");
ds_map_add(global.text_data_en, "scr_torcall_47", "* 방 금  파 이  100000개  구 웠 어 .&* 좀  먹 을 래 ?/");
ds_map_add(global.text_data_en, "scr_torcall_48", "* 길 을  건 너 기  전 엔&  이 를  닦 도 록  하 렴 ^1, 프 리 스 크 ./%%");
ds_map_add(global.text_data_en, "scr_torcall_53", "* (토 리 엘 이  문 자 를  보 냈 다 .)/");
ds_map_add(global.text_data_en, "scr_torcall_54", "* 난  저 런  말  한  적  없 단 다 ./%%");
ds_map_add(global.text_data_en, "scr_torcall_59", "* (토 리 엘 이  문 자 를  보 냈 다 .)/");
ds_map_add(global.text_data_en, "scr_torcall_60", "* 안 녕 ^1.&* 나 는  샌 즈 야 ^1.&* 내  남 동 생 을  사 랑 해 ./");
ds_map_add(global.text_data_en, "scr_torcall_61", "* 도 와 주 ㅓ&  저 건  함 정 이 야 /%%");
ds_map_add(global.text_data_en, "scr_torcall_66", "* (토 리 엘 이  문 자 를  보 냈 다 .)/");
ds_map_add(global.text_data_en, "scr_torcall_67", '* 난  샌 즈 야 ^1.&* 프 리 스 크 ^1, 내 가  "털 리 는  걸 "&  좋 아 한 다 는  걸  아 니 ?/');
ds_map_add(global.text_data_en, "scr_torcall_68", "* 그 리 고  토 리 엘 은&  참  착 하 고 ㅁ ㄴ ㄷ/");
ds_map_add(global.text_data_en, "scr_torcall_69", "* 미 안 /");
ds_map_add(global.text_data_en, "scr_torcall_70", "* ./%%");
ds_map_add(global.text_data_en, "scr_torcall_75", '* (토 리 엘 이  "고 양 이  동 영 상 "&  이 라 는  제 목 의  문 자 를  보 냈 다 .)/');
ds_map_add(global.text_data_en, "scr_torcall_76", "* (열 어 보 니 ^1, 토 리 엘 이  본&  하 얀  동 물  영 상 에  대 한 ^1,&  세 심 한  묘 사 가  적 혀  있 다 .)/");
ds_map_add(global.text_data_en, "scr_torcall_77", "* (동 영 상  링 크 나  첨 부 파 일 은&  보 이 지  않 는 다 .)/%%");
ds_map_add(global.text_data_en, "scr_torcall_82", "* (토 리 엘 이  문 자 를  보 냈 다 .)/");
ds_map_add(global.text_data_en, "scr_torcall_83", "* 저 주  : 이 글 을 복 사 해 서&  좋 아 하 는 사 람 에 게 보 내 라&  안 그 러 면 해 골 이 나 타 남/%%");
ds_map_add(global.text_data_en, "scr_torcall_88", "* (토 리 엘 이  문 자 를  보 냈 다 .)&* 프 리 스 크 에 게 ,/");
ds_map_add(global.text_data_en, "scr_torcall_89", "* 좋 아 할  것  같 아 서&  보 냈 단 다 ^1.&* ]: )/");
ds_map_add(global.text_data_en, "scr_torcall_90", "* (달 팽 이  모 양&  아 스 키  그 림 이 다 .)/%%");
ds_map_add(global.text_data_en, "scr_torcall_95", "* (토 리 엘 이  문 자 를  보 냈 다 .)&* 프 리 스 크 에 게 ,/");
ds_map_add(global.text_data_en, "scr_torcall_96", "* 언 다 인 과  파 피 루 스 가&  나 와  요 리 를  하 고  싶 어 해 ./");
ds_map_add(global.text_data_en, "scr_torcall_97", "* 샌 즈 가  그  둘 은&  훌 륭 한  요 리 사 라 고&  하 는 구 나 ./");
ds_map_add(global.text_data_en, "scr_torcall_98", "* 정 말  기 대 된 단 다 . ]: )&* 네 가  운 이  좋 다 면 ^1,&  좀  먹 을  수 도  있 겠 어 !/%%");
ds_map_add(global.text_data_en, "scr_torcall_103", "* (토 리 엘 이  문 자 를  보 냈 다 .)&* 프 리 스 크 에 게 ,/");
ds_map_add(global.text_data_en, "scr_torcall_104", "* 샌 즈 와  내 가  밴 드 를&  결 성 한 다 면 ^1, 무 슨&  이 름 일 지  아 니 ?/");
ds_map_add(global.text_data_en, "scr_torcall_105", '* "드 리 무 어 "와  "골 반 뼈 "란 다 .^1"&* ㅋ ㅋ ㅋ !/');
ds_map_add(global.text_data_en, "scr_torcall_106", "* 추 신  - 그 냥  농 담 이 야 ^1.&* 날  드 리 무 어 라 고&  부 르 진  말 렴 ./%%");
ds_map_add(global.text_data_en, "scr_torcall_111", "* (토 리 엘 이  문 자 를  보 냈 다 .)&* 프 리 스 크 에 게 ,/");
ds_map_add(global.text_data_en, "scr_torcall_112", "* 언 다 인 은  무 척&  힘 이  세 단 다 ./");
ds_map_add(global.text_data_en, "scr_torcall_113", "* 파 피 루 스 는  언 다 인 이&  여 기  모 두 를  들 어 올 릴  수&  없 을  거 라 고  했 어 ./");
ds_map_add(global.text_data_en, "scr_torcall_114", "* 그 런 데  진 짜&  들 어 올 리 더 구 나 ./");
ds_map_add(global.text_data_en, "scr_torcall_115", "* 다 만  문 제 는&  언 다 인 이  내 려 놓 는  법 은&  몰 랐 다 는  거 야 ./%%");
ds_map_add(global.text_data_en, "scr_torcall_120", "* (토 리 엘 이  문 자 를  보 냈 다 .)&* 프 리 스 크 에 게 ,/");
ds_map_add(global.text_data_en, "scr_torcall_121", "* 알 피 스 가  인 간  세 상 에  대 한&  재 미 있 는  얘 길  많 이  해 줬 단 다 ./");
ds_map_add(global.text_data_en, "scr_torcall_122", "* 틀 린  것 도  있 긴 ^1, 했 어 ./");
ds_map_add(global.text_data_en, "scr_torcall_123", "* 프 리 스 크 ^1, 알 피 스 에 게&  장 난 친  건  아 니 지 ^1?&* ]: )/%%");
ds_map_add(global.text_data_en, "scr_torcall_128", "* (토 리 엘 이  문 자 를  보 냈 다 .)&* 프 리 스 크 에 게 ,/");
ds_map_add(global.text_data_en, "scr_torcall_129", "* 컴 퓨 터 를  너 무  오 래  하 면&  안  좋 다 는  얘 기 를  들 었 어 ./");
ds_map_add(global.text_data_en, "scr_torcall_130", "* 하 지 만 ^1, 난  네 가&  컴 퓨 터 하 는  모 습 을&  본  적 이  없 구 나 ./");
ds_map_add(global.text_data_en, "scr_torcall_129_console", "* 비 디 오  게 임 을  너 무  오 래  하 면&  안  좋 다 는  얘 기 를  들 었 어 ./");
ds_map_add(global.text_data_en, "scr_torcall_130_console", "* 하 지 만 ^1, 난  네 가&  게 임 하 는  모 습 을&  본  적 이  없 구 나 ./");
ds_map_add(global.text_data_en, "scr_torcall_131", "* 넌  아 주  건 강 하 겠 는 걸 ^1!&* 아 주  좋 아 ./%%");
ds_map_add(global.text_data_en, "scr_torcall_136", "* (토 리 엘 이  문 자 를  보 냈 다 .)&* 프 리 스 크 에 게 ,/");
ds_map_add(global.text_data_en, "scr_torcall_137", "* 이 제  핸 드 폰 을  꺼 야  할  것  같 아 ./");
ds_map_add(global.text_data_en, "scr_torcall_138", "* 네  친 구 들 은&  다 들  참  친 절 하 단 다 !/");
ds_map_add(global.text_data_en, "scr_torcall_139", "* 이  시 간  동 안 은&  네  친 구 들 과  알 아 가 야 겠 어 ./");
ds_map_add(global.text_data_en, "scr_torcall_140", "* 착 한  아 이 가&  되 어 야  한 다 ^1, 알 겠 지 ?/");
ds_map_add(global.text_data_en, "scr_torcall_141", "* 토 리 엘 로 부 터 ^1 /%%");
ds_map_add(global.text_data_en, "scr_torcall_144", "* (토 리 엘 은  더  이 상&  문 자 를  보 내 지  않 았 다 .)/%%");
ds_map_add(global.text_data_en, "scr_torcall_146", "* (토 리 엘 은  더  이 상&  문 자 를  보 내 지  않 았 다 .)/%%");
