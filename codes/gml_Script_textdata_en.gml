ds_map_add(global.text_data_en, "SCR_TEXT_3630", "* 이 봐  친 구 ^1, 잘  지 내 ^1?&* 핫 도 그  하 나  살 래 ?/");
ds_map_add(global.text_data_en, "SCR_TEXT_3631", "* 30G밖 에  안  해 .& &  산 다         안  사 \C");
ds_map_add(global.text_data_en, "SCR_TEXT_3632", " ");
ds_map_add(global.text_data_en, "SCR_TEXT_3638", "* 여 기 ^1.&* 맛 있 게  먹 어 ./%%");
ds_map_add(global.text_data_en, "SCR_TEXT_3641", "* 여 기  핫 도 그  한  개&  더  받 아 ./");
ds_map_add(global.text_data_en, "SCR_TEXT_3642", "* 에 이 ^1, 넣 어 둬 ^1.&* 아 니 지 ^1.&* 올 려 둬 ./%%");
ds_map_add(global.text_data_en, "SCR_TEXT_3653", "* 미 안 ^1, 머 리 -도 그 는&  30개 가  한 계 야 ./%%");
ds_map_add(global.text_data_en, "SCR_TEXT_3656", "\TS*^1\Ts 진 짜  '장 난  아 니 게 '&  말 하 는  건 데  말 이 야 ./");
ds_map_add(global.text_data_en, "SCR_TEXT_3657", "* 네  머 리  위 로  핫 도 그 를&  더  올 리 고  싶 어 도 .../");
ds_map_add(global.text_data_en, "SCR_TEXT_3658", "* 30이  딱  한 계 야 ./");
ds_map_add(global.text_data_en, "SCR_TEXT_3659", "* 29개 까 지 는&  괜 찮 은 데 ^1, 30개 가  되 면 .../");
ds_map_add(global.text_data_en, "SCR_TEXT_3660", "* 내  팔 이  거 기 까 지&  닿 을  것  같 아 ?/%%");
ds_map_add(global.text_data_en, "SCR_TEXT_3687", "* 고 마 워 , 친 구 ^1.&* 여 기  핫 도 그 야 ./%%");
ds_map_add(global.text_data_en, "SCR_TEXT_3690", "* 고 마 워 , 친 구 ^1.&* 여 기  '도 그 야 ./");
ds_map_add(global.text_data_en, "SCR_TEXT_3691", "* 그 래 ^1. '도 그 ^1.&* 어 포 스 트 로 피  도 그 ^1.&* 핫 도 그 를  줄 여  부 른  거 야 ./%%");
ds_map_add(global.text_data_en, "SCR_TEXT_3695", "* 핫 도 그  더  달 라 고 ^1?&* 여 기  있 어 .../");
ds_map_add(global.text_data_en, "SCR_TEXT_3696", "* 이 런 ^1, 핫 도 그 가&  다  떨 어 졌 군 ./");
ds_map_add(global.text_data_en, "SCR_TEXT_3697", "* 여 기 ^1, 대 신&  핫 캣 이 라 도  가 져 가 ./%%");
ds_map_add(global.text_data_en, "SCR_TEXT_3701", "* 개  한  마 리 ^1, 더&  갑 니 다 .../");
ds_map_add(global.text_data_en, "SCR_TEXT_3702", "* ...너  정 말  핫 한&  동 물 을  좋 아 하 는 구 나 ^1,&  응 ?/");
ds_map_add(global.text_data_en, "SCR_TEXT_3703", "* 아 ^1, 뭐 라  하 는  건&  아 니 고 ./");
ds_map_add(global.text_data_en, "SCR_TEXT_3704", "* 너 같 은  애 들  없 이 는&  내  밥 줄 도  없 을  테 니 ./%%");
ds_map_add(global.text_data_en, "SCR_TEXT_3708", "* 좋 아 ^1.&* 여 기  ''도 그 야 ./");
ds_map_add(global.text_data_en, "SCR_TEXT_3709", "* 어 포 스 트 로 피 -&  어 포 스 트 로 피&  도 그 ./");
ds_map_add(global.text_data_en, "SCR_TEXT_3710", "* 이 건  어 포 스 트 로 피 -도 그 의&  줄 임 말 이 야 ./");
ds_map_add(global.text_data_en, "SCR_TEXT_3711", "* 그 러 니 까 ^1, 이 건 ^1,&  뭐 의  줄 임 말 이 냐 면 .../%%");
ds_map_add(global.text_data_en, "SCR_TEXT_3715", "* 다 른  거 ^1?&* 좋 아 ./");
ds_map_add(global.text_data_en, "SCR_TEXT_3716", "* 조 심 해 ^1.&* 핫 도 그 를  너 무&  많 이  먹 는 다 면 .../");
ds_map_add(global.text_data_en, "SCR_TEXT_3717", "* 너 도  나 처 럼&  한  가 득  불 어 날 걸 ./");
ds_map_add(global.text_data_en, "SCR_TEXT_3718", "* 내  말 은 ^1, 나 처 럼  팬 이&  한  가 득  불 어 나 서&  몰 고  다 니 게  될  거 라 고 ./");
ds_map_add(global.text_data_en, "SCR_TEXT_3719", "* 난  사 실 상&  핫 도 그  업 계 의&  거 물 이 거 든 ./%%");
