ds_map_add(global.text_data_en, "obj_mettboss_event_268", "* 게 다 가 .../");
ds_map_add(global.text_data_en, "obj_mettboss_event_269", "* 제 가  지 키 고  싶 은 ..^1.&* 이 들 이  있 어 요 ./%%");
