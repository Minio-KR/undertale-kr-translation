ds_map_add(global.text_data_en, "obj_gyftrot_507", "* 기 프 트 롯 은  손 이  없 어&  애 통 해 하 고  있 다 .");
ds_map_add(global.text_data_en, "obj_gyftrot_508", "* 기 프 트 롯 은  당 신 을&  의 심 의  눈 초 리 로&  바 라 보 고  있 다 .");
ds_map_add(global.text_data_en, "obj_gyftrot_509", "* 기 프 트 롯 은  당 신 의&  유 치 한  짓 을&  믿 지  못 하 고  있 다 .");
ds_map_add(global.text_data_en, "obj_gyftrot_510", "* 아 , 상 쾌 한  솔 잎 의&  냄 새 가  난 다 .");
ds_map_add(global.text_data_en, "obj_gyftrot_511", "* 기 프 트 롯 은  장 식 을  없 애 려 는&  헛 된  노 력 을  한 다 .");
ds_map_add(global.text_data_en, "obj_gyftrot_512", "* 기 프 트 롯 은  당 신 의  선 물 을&  거 절 하 는  척  했 다 .");
ds_map_add(global.text_data_en, "obj_gyftrot_513", "* 기 프 트 롯 은  정 중 하 게&  당 신 의  선 물 을&  거 절 했 다 .");
ds_map_add(global.text_data_en, "obj_gyftrot_514", "* 기 프 트 롯 은  앞 이&  안  보 여 서  비 틀 거 리 고&  있 다 .");
ds_map_add(global.text_data_en, "obj_gyftrot_515", "* 기 프 트 롯 은  살 짝  덜&  짜 증 내 고  있 다 .");
ds_map_add(global.text_data_en, "obj_gyftrot_516", "* 기 프 트 롯 의  고 민 이&  해 결 되 었 다 .");
ds_map_add(global.text_data_en, "obj_gyftrot_517", "* 기 프 트 롯 은  실 망 한  것  같 다 .");
ds_map_add(global.text_data_en, "obj_gyftrot_519", "* 기 프 트 롯 의  뿔 이&  떨 리 고  있 다 .");
