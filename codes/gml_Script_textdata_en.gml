ds_map_add(global.text_data_en, "obj_adate_747", "\E9하 \M4지 만  내 가  어 떻 게&언 다 인 에 게  지 ..진 실 을&말 해 ?/");
ds_map_add(global.text_data_en, "obj_adate_748", "\E8자 신 감 이  없 어 .../");
ds_map_add(global.text_data_en, "obj_adate_749", "\E9다  망 쳐 버 릴  거 야 ^1!&어 떻 게  연 습 하 지 !?/%%");
ds_map_add(global.text_data_en, "obj_adate_755", "그 래 ..^1. 그 래 ^1, 네 가&맞 아 !/");
ds_map_add(global.text_data_en, "obj_adate_756", "\E6여 \M0기 까 지  온  이 상 ^1,&언 다 인 에 게  말 할  순&없 겠 지 ./");
ds_map_add(global.text_data_en, "obj_adate_757", "\E7사 -사 실 을  알 게  되 면&정 말  상 처 받 을&거 야 ^1, 그 치 ?/");
ds_map_add(global.text_data_en, "obj_adate_758", "\E5그 -그 러 니 까&그 ^1, 어 ^1,&작 은  비 밀 로  하 자 고 !/");
ds_map_add(global.text_data_en, "obj_adate_759", "\M1사 실 을  모 르 면&상 처 받 는  일 도&없 겠 지 !!/");
ds_map_add(global.text_data_en, "obj_adate_760", "\M0너 처 럼  솔 직 한&친 구 가  있 어 서  정 말&다 행 이 야 !!/");
ds_map_add(global.text_data_en, "obj_adate_761", ".../");
ds_map_add(global.text_data_en, "obj_adate_762", "\E3.../");
ds_map_add(global.text_data_en, "obj_adate_763", "\M1하 ..^1. 하 지 만  만 약&언 다 인 이  알 게  되 면&어 쩌 지 ?/");
ds_map_add(global.text_data_en, "obj_adate_764", "\E7혹 \M0시  내 가 &망 쳐 버 리 기 라 도&해 서 .../");
ds_map_add(global.text_data_en, "obj_adate_765", "\M4지 -진 실 을&알 게  되 고 ^1, 그 러 면 .../");
ds_map_add(global.text_data_en, "obj_adate_766", "\E8내 -내 가  직 접&말 해 주 는  것 보 다&훨 씬  상 처 받 겠 지 ./");
ds_map_add(global.text_data_en, "obj_adate_767", "\E6그 \M0-그 리 고 ^1, 여 태 껏&거 짓 말 을  해 왔 지 만 ..^1.&저 ..^1.정 .../");
ds_map_add(global.text_data_en, "obj_adate_768", "\E8정 말  괴 롭 고 &무 서 웠 거 든 ./");
ds_map_add(global.text_data_en, "obj_adate_769", "\E3.../");
ds_map_add(global.text_data_en, "obj_adate_770", "\E4아 무 래 도  언 다 인 에 게&진 실 을  말 해 야 겠 어 ./");
ds_map_add(global.text_data_en, "obj_adate_771", "\E9그 -그 치 만  어 떻 게 !?/");
ds_map_add(global.text_data_en, "obj_adate_772", "\E8난 ..^1. 난&자 신  없 는 데 .../");
ds_map_add(global.text_data_en, "obj_adate_773", "\E7이 런  일 을  도 대 체&어 떻 게  하 란 말 야 !?/%%");
ds_map_add(global.text_data_en, "obj_adate_794", "   역 할 극 으 로       역 할 극 을  &   재 현 해           해        &   보 자             보 자      ");
ds_map_add(global.text_data_en, "obj_adate_827", "\E4여 ..^1. 역 할 극 ?/");
ds_map_add(global.text_data_en, "obj_adate_828", "\E3.../");
ds_map_add(global.text_data_en, "obj_adate_829", "\E5.\M1..그 거  정 말&재 밌 겠 다 !/");
ds_map_add(global.text_data_en, "obj_adate_830", "\M0좋 아 ^1, 어 느  쪽 이&언 다 인 을  할 래 ?/*");
ds_map_add(global.text_data_en, "obj_adate_844", "                              &   내 가             네 가      &   언 다 인           언 다 인    ");
ds_map_add(global.text_data_en, "obj_adate_868", "아 ^1. 알 겠 어 ^1.&당 연 한  걸 ^1.&에 헤 헤 ./");
