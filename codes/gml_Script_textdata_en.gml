ds_map_add(global.text_data_en, "obj_undynedate_outside_278", "\M9* .../");
ds_map_add(global.text_data_en, "obj_undynedate_outside_280", "\M0.../");
ds_map_add(global.text_data_en, "obj_undynedate_outside_282", "\E1* 일 단 ^1.&* 들 어 ^1, 오 지 ^1.&* 그 래 ?/%%");
ds_map_add(global.text_data_en, "obj_undynedate_outside_364", "* (집  안 에 서  뭔 가&  웅 얼 대 는  소 리 가&  들 려  온 다 .)/");
ds_map_add(global.text_data_en, "obj_undynedate_outside_366", "안 돼! 우정에서&벗어날 수는 없어!/%%");
ds_map_add(global.text_data_en, "obj_undyneencounter2_329", "* 요 ..^1. 방 금  봤 어 !?/");
ds_map_add(global.text_data_en, "obj_undyneencounter2_330", "* 언 다 인 이 .../");
ds_map_add(global.text_data_en, "obj_undyneencounter2_331", "* ...날  만 졌 어 !/");
ds_map_add(global.text_data_en, "obj_undyneencounter2_332", "* 다 시 는  얼 굴 을&  씻 지  않 을 래 ...!/");
ds_map_add(global.text_data_en, "obj_undyneencounter2_333", "* 이 야 ^1, 넌  운 이  나 빴 네 ./");
ds_map_add(global.text_data_en, "obj_undyneencounter2_334", "* 네 가  조 금 만  더&  왼 쪽 에  서  있 었 다 면 ...!/");
ds_map_add(global.text_data_en, "obj_undyneencounter2_335", "* 요 ^1, 걱 정 하 지  마 ^1!&* 다 시  언 다 인 을&  만 날  수  있 을  거 야 ...!/%%");
ds_map_add(global.text_data_en, "obj_undyneencounter2_338", "* ...이 봐 ^1, 눈 치  챘 어 ^1?&* 언 다 인 이  굉 장 히&  화 가  난  것  같 아 !/");
ds_map_add(global.text_data_en, "obj_undyneencounter2_339", "* 날  조 각 조 각&  찢 어 버 릴  것  같 았 어 !/");
ds_map_add(global.text_data_en, "obj_undyneencounter2_340", "* 하 지 만 ..^1. 휴 ..^1.&* 날  내 려 놓 기 로  했 나  봐 .../");
ds_map_add(global.text_data_en, "obj_undyneencounter2_341", "* 이 봐 !&* 다 음 번 도  있 으 니 까 ^1,&  그 치 ^1? 가 자 !/%%");
ds_map_add(global.text_data_en, "obj_undyneencounter4_255", "여 기 서&들 린  것  같 은 데 .../");
ds_map_add(global.text_data_en, "obj_undyneencounter4_256", "오 ^1! 너  떨 어 졌 구 나 ^1,&그 런  거 지 .../");
ds_map_add(global.text_data_en, "obj_undyneencounter4_257", "괜 찮 아 ?/");
ds_map_add(global.text_data_en, "obj_undyneencounter4_258", "자 ^1, 일 어 나 .../");
ds_map_add(global.text_data_en, "obj_undyneencounter4_259", ".../");
ds_map_add(global.text_data_en, "obj_undyneencounter4_260", "\[차]^1\[라]라 고 ?/");
ds_map_add(global.text_data_en, "obj_undyneencounter4_261", "좋 은  이 름 이 네 ./%%");
ds_map_add(global.text_data_en, "obj_undyneencounter4_275", " 내  이 름 은     %%");
ds_map_add(global.text_data_en, "obj_undynefall_99", "* (누 군 가 가  꼼 꼼 하 게 도&  이  달 팽 이 의  진 액 을&  모 두  닦 아  두 었 다 .)/%%");
ds_map_add(global.text_data_en, "obj_undynetrash_69", "* (쓰 레 기 통 에  부 러 진  창 이&  가 득  들 어  있 다 .)/%%");
ds_map_add(global.text_data_en, "obj_undynetrash_72", "* (쓰 레 기 통 은  비 어  있 다 .)/%%");
ds_map_add(global.text_data_en, "obj_undynetrash_76", "* (쓰 레 기 통 을  찾 았 다 .)/");
ds_map_add(global.text_data_en, "obj_undynetrash_77", "* (쓰 레 기 통  안 에 는&  열 쇠 가  들 어  있 다 ^1, &  잘  보 이 지 는  않 는 다 ...)/");
ds_map_add(global.text_data_en, "obj_undynetrash_78", "* (집 어 들 었 다 .)/%%");
ds_map_add(global.text_data_en, "obj_undynetrash_87", "* (쓰 레 기 통 이 다 .^1)&* (하 지 만  꽤  귀 엽 다 .)/%%");
ds_map_add(global.text_data_en, "obj_undynetrash_88", "* (너 무  어 두 워 서&  볼  수  없 다 .)/%%");
ds_map_add(global.text_data_en, "obj_undynetrash_91", "* (쓰 레 기 통  안 에&  구 겨 진  쪽 지 가  있 다 .)/");
ds_map_add(global.text_data_en, "obj_undynetrash_92", "* (이 상 한  형 태 의&  필 기 다 .)/");
ds_map_add(global.text_data_en, "obj_undynetrash_93", "* (거 기  쓰 여  있 길 ...)/");
ds_map_add(global.text_data_en, "obj_undynetrash_94", "* (네 가  한  짓 을  알 아 .)/%%");
ds_map_add(global.text_data_en, "obj_undynetrigger_boss_157", "* 일 곱 ./");
ds_map_add(global.text_data_en, "obj_undynetrigger_boss_158", "\W* 일 곱  개 의  인 간  영 혼 이 면 ,&  \R아 스 고 어  대 왕\W 은&  신 이  될  거 야 ./");
ds_map_add(global.text_data_en, "obj_undynetrigger_boss_159", "* 여 섯 ./");
ds_map_add(global.text_data_en, "obj_undynetrigger_boss_160", "* 그 게  우 리 가  지 금 까 지&  모 은  영 혼 의  숫 자 지 ./");
ds_map_add(global.text_data_en, "obj_undynetrigger_boss_161", "* 알 아 들 었 어 ?/");
ds_map_add(global.text_data_en, "obj_undynetrigger_boss_162", "* 너 의  일 곱  번 째 이 자&  마 지 막  영 혼 이 면 ^1,&  이  세 상 은  바 뀔  거 야 ./");
ds_map_add(global.text_data_en, "obj_undynetrigger_boss_163", "* 하 지 만 ^1, 먼 저 ^1,&  여 기 까 지  온&  사 람 들 에 겐 .../");
ds_map_add(global.text_data_en, "obj_undynetrigger_boss_164", "* 우 리 들 의  비 극 적 인&  이 야 기 를  들 려 주 는  게&  관 례 지 ./");
ds_map_add(global.text_data_en, "obj_undynetrigger_boss_165", "* 모 든  건 , 오 래 전 에&  시 작 됐 어 .../%%");
ds_map_add(global.text_data_en, "obj_undynetrigger_boss_190", "* .../");
ds_map_add(global.text_data_en, "obj_undynetrigger_boss_191", "* 아 니 야 ^1, 그 거  알 아 ?/%%");
ds_map_add(global.text_data_en, "obj_undynetrigger_boss_199", "* 집 어 치 워 ^3! %%");
ds_map_add(global.text_data_en, "obj_undynetrigger_boss_206", "* 내 가  왜  그  이 야 기 를&  들 려 줘 야  하 는 데 !?^1! %%");
ds_map_add(global.text_data_en, "obj_undynetrigger_boss_213", "* 어 차 피  죽 을  놈 인 데 !?^1! %%");
ds_map_add(global.text_data_en, "obj_undynetrigger_boss_220", "* 느 아 아 아 아 아 아 아 아 아 아 아 ^1! %%");
ds_map_add(global.text_data_en, "obj_undynetrigger_boss_325", "* 너 !/");
ds_map_add(global.text_data_en, "obj_undynetrigger_boss_326", "* 너 는  모 두 의&  꿈 과  희 망  앞 을&  가 로 막 고  있 다 !/");
ds_map_add(global.text_data_en, "obj_undynetrigger_boss_327", "\E4* 알 피 스 의  역 사 책 들 을&  보 고  인 간 들 은&  멋 지 다  생 각 했 었 지 .../");
ds_map_add(global.text_data_en, "obj_undynetrigger_boss_328", "\E0* ... 그  거 대 한  로 봇 들 과&  화 려 한  여 전 사 들 .../");
ds_map_add(global.text_data_en, "obj_undynetrigger_boss_329", "\E1* 근 데  넌 ?/");
ds_map_add(global.text_data_en, "obj_undynetrigger_boss_330", "\E3* 넌  겁 쟁 이 일  뿐 이 야 !/");
ds_map_add(global.text_data_en, "obj_undynetrigger_boss_331", "\E3* 나 한 테 서  다 시&  도 망 치 려 고  꼬 맹 이&  뒤 에  숨 은  겁 쟁 이 !/");
ds_map_add(global.text_data_en, "obj_undynetrigger_boss_332", "* 넌  그 저  도 망 치 려 고&  친 구 를  버 렸 어 !/");
ds_map_add(global.text_data_en, "obj_undynetrigger_boss_335", "\E2* 그 러 니  그  변 덕 스 런&  성 인 군 자  놀 이 는&  집 어  치 우 시 지 !/");
ds_map_add(global.text_data_en, "obj_undynetrigger_boss_336", "\E6* 오 오 우 ^1! 전  만 나 는  사 람 은&  아 무 나  껴 안 아 서&  변 화 를  일 으 킬  거 예 여 !/");
ds_map_add(global.text_data_en, "obj_undynetrigger_boss_337", "*\E3 그 보 다  모 두 에 게&  더  가 치 있 는  게&  뭔 지  아 냐 ?/");
ds_map_add(global.text_data_en, "obj_undynetrigger_boss_338", "*\E1 바 로  네 가  죽 는  거 다 !/");
ds_map_add(global.text_data_en, "obj_undynetrigger_boss_339", "\E0* 그 래  맞 아 ^1, 인 간 !&  네  존 재  자 체 가&  범 죄 다 !/");
ds_map_add(global.text_data_en, "obj_undynetrigger_boss_340", "* 네  삶 이  우 리  모 두 의&  앞 에  펼 쳐 진  자 유 를&  가 로 막 고  있 어 !/");
ds_map_add(global.text_data_en, "obj_undynetrigger_boss_341", "* 바 로  지 금 ^1, 모 두 의&  가 슴 이  함 께  뛰 는  게&  느 껴 지 고  있 다 고 !/");
ds_map_add(global.text_data_en, "obj_undynetrigger_boss_342", "\E0* 모 두 가  평 생 토 록&  이  순 간 만 을&  기 다 려  온  거 야 !/");
ds_map_add(global.text_data_en, "obj_undynetrigger_boss_343", "\E0* 하 지 만  전 혀&  두 렵 지  않 아 ./");
ds_map_add(global.text_data_en, "obj_undynetrigger_boss_344", "\E1* 모 두 의  마 음 이&  함 께 하 는  한 ^1, 절 대&  질  수  없 으 니 까 !/");
ds_map_add(global.text_data_en, "obj_undynetrigger_boss_345", "\E5* 자 ^1, 인 간 ^1!&* 바 로  지 금 ^1, 여 기 서&  끝 장 을  보 자 ./");
ds_map_add(global.text_data_en, "obj_undynetrigger_boss_346", "\E0* 괴 물 의  결 의 가&  어 느  정 도 인 지&  보 여  주 마 !/");
ds_map_add(global.text_data_en, "obj_undynetrigger_boss_347", "\E0* 준 비 되 면&  다 가 오 도 록 ^1!&* 푸 후 후 !/%%");
ds_map_add(global.text_data_en, "obj_undynetrigger_boss_351", "\E1* 그 리 고 ^1! 그 리 고 !/");
ds_map_add(global.text_data_en, "obj_undynetrigger_boss_352", "\E7* ...그 리 고  뭔 가&  신 경  쓰 이 는  것 도&  있 어 ./");
ds_map_add(global.text_data_en, "obj_undynetrigger_boss_353", "\E4* 널  쫓 아 다 니 는&  동 안  내 내 .../");
ds_map_add(global.text_data_en, "obj_undynetrigger_boss_354", "\E7* 뭔 가 ..^1. 이 상 한&  감 정 을  느 꼈 어 ./");
ds_map_add(global.text_data_en, "obj_undynetrigger_boss_355", "* 뭔 가  따 스 하 고 ^1,&  그 러 한  감 정 .../");
ds_map_add(global.text_data_en, "obj_undynetrigger_boss_356", "\E9* 마 치  '너 와  친 구 가&  되 고  싶 어 '지 는&  무 언 가 가 ./");
ds_map_add(global.text_data_en, "obj_undynetrigger_boss_357", "\E2* 하 지 만  그 건&  말 도  안  돼 !/");
ds_map_add(global.text_data_en, "obj_undynetrigger_boss_358", "\E6* 내 가  너  같 은&  겁 쟁 이 랑  친 구 를&  먹 을  일 은  없 지 !/");
ds_map_add(global.text_data_en, "obj_undynetrigger_boss_359", "\E1* 너 ^1!&* 분 명  날  세 뇌 시 킨  거 겠 지 !/");
ds_map_add(global.text_data_en, "obj_undynetrigger_boss_360", "\E6* 사 람 들 이  널  좋 아 하 게&  조 종 하 다 니 ...&  A급 으 로  끔 찍 해 !/");
ds_map_add(global.text_data_en, "obj_undynetrigger_boss_361", "\E1* 그  쯤 이 면  됐 어 ^1!&* 모 두 의  꿈 을  위 해 ^1!&* 모 두 의  희 망 을  위 해 !/");
ds_map_add(global.text_data_en, "obj_undynetrigger_boss_362", "\E2* 나 의  빌 어 먹 을&  존 엄 을  위 해 서 !/");
ds_map_add(global.text_data_en, "obj_undynetrigger_boss_363", "\E3* 나 ^1, 언 다 인 이 ^1,&  널  쓰 러 뜨 리 겠 다 !/%%");
ds_map_add(global.text_data_en, "obj_undynetrigger_boss_369", "* 너 !/");
ds_map_add(global.text_data_en, "obj_undynetrigger_boss_370", "* 너 는  모 두 의&  꿈 과  희 망  앞 을&  가 로 막 고  있 다 !/");
ds_map_add(global.text_data_en, "obj_undynetrigger_boss_371", "\E4* 알 피 스 의  역 사 책 을  보 고&  인 간 들 은  자 애 롭 다 고&  생 각 했 다 만 .../");
ds_map_add(global.text_data_en, "obj_undynetrigger_boss_372", "\E1* 근 데  넌 ?/");
ds_map_add(global.text_data_en, "obj_undynetrigger_boss_373", "\E5* 넌  양 심  없 는&  범 죄 자 일  뿐 이 야 !/");
ds_map_add(global.text_data_en, "obj_undynetrigger_boss_374", "* 동 굴 을  돌 아 다 니 며 ^1,&  마 주 치 는  녀 석 들 을&  공 격 했 지 ./");
ds_map_add(global.text_data_en, "obj_undynetrigger_boss_375", "\E4* 자 기  방 어 ^1?&* 참 나 .../");
ds_map_add(global.text_data_en, "obj_undynetrigger_boss_376", "* 꼭  죽 여 야 만  해 서&  죽 인  게  아 니 잖 아 ./");
ds_map_add(global.text_data_en, "obj_undynetrigger_boss_377", "\E5* 그 게  쉽 다 고&  생 각 했 으 니  죽 인  것&  뿐 이 면 서 ./");
ds_map_add(global.text_data_en, "obj_undynetrigger_boss_378", "* 그 게  너 한 테&  재 밌 었 으 니 까 ./");
ds_map_add(global.text_data_en, "obj_undynetrigger_boss_379", "\E4* 내 가  그  사 실 을&  깨 달 았 다 는  게&  재 미 있 나 ...?/");
ds_map_add(global.text_data_en, "obj_undynetrigger_boss_381", "* 그  가 족 들 이  절 대&  집 에  가 지  못 하 게&  될  거 란  걸 .../");
ds_map_add(global.text_data_en, "obj_undynetrigger_boss_382", "* ...그 걸  아 는  게&  재 미 있 나 ^1?&* 그 게  재 미 있 어 ?/");
ds_map_add(global.text_data_en, "obj_undynetrigger_boss_386", "* 샤 이 렌 ^1, 막  노 래 를&  배 우 기  시 작 한&  친 구 가 .../");
ds_map_add(global.text_data_en, "obj_undynetrigger_boss_387", "* ...고 작  한  인 간 의&  변 덕  때 문 에 ^1,&  죽 었 다 고 ?/");
ds_map_add(global.text_data_en, "obj_undynetrigger_boss_392", "* 양 아 치 들 이 랑&  어 울 렸 던  십 대&  코 미 디 언 .../");
ds_map_add(global.text_data_en, "obj_undynetrigger_boss_393", "* ...고 작  한  인 간 의&  변 덕  때 문 에 ^1,&  죽 었 다 고 ?/");
ds_map_add(global.text_data_en, "obj_undynetrigger_boss_399", "* 도 고 ^1, 늘  나 를&  웃 게  해  줬 었 는 데 .../");
ds_map_add(global.text_data_en, "obj_undynetrigger_boss_400", "* ...고 작  한  인 간 의&  변 덕  때 문 에 ^1,&  죽 었 다 고 ?/");
ds_map_add(global.text_data_en, "obj_undynetrigger_boss_405", "* 두  마 리  귀 여 운  강 아 지 ^1,&  서 로 를  늘  잘  돌 봐&  주 었 던  녀 석 들 이 .../");
ds_map_add(global.text_data_en, "obj_undynetrigger_boss_406", "* ...고 작  한  인 간 의&  변 덕  때 문 에 ^1,&  죽 었 다 고 ?/");
ds_map_add(global.text_data_en, "obj_undynetrigger_boss_412", "* 그  커 다 란  개 ^1,&  놀 기 만 을  좋 아 하 던&  녀 석 도 .../");
ds_map_add(global.text_data_en, "obj_undynetrigger_boss_413", "* ...고 작  한  인 간 의&  변 덕  때 문 에 ^1,&  죽 었 다 고 ?/");
ds_map_add(global.text_data_en, "obj_undynetrigger_boss_419", "* 레 서  도 그 ^1, 관 심&  받 기 만 을  원 하 던&  녀 석 도 .../");
ds_map_add(global.text_data_en, "obj_undynetrigger_boss_420", "* ...고 작  한  인 간 의&  변 덕  때 문 에 ^1,&  죽 었 다 고 ?/");
