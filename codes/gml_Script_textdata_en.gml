ds_map_add(global.text_data_en, "obj_readable_room1_442", '* 아 스 고 어 는  도 시  밖 의&  괴 물 들 에 게  "쓰 러 진 "&  괴 물 들 을  달 라 고  부 탁 했 다 ./');
ds_map_add(global.text_data_en, "obj_readable_room1_443", "* 오 늘  그  몸 들 이  도 착 했 다 ./");
ds_map_add(global.text_data_en, "obj_readable_room1_444", "* 아 직  혼 수 상 태 다 ..^1.&* 그 리 고  곧 ^1, 그 들 은&  먼 지 가  될  것 이 다 ./");
ds_map_add(global.text_data_en, "obj_readable_room1_445", '* 하 지 만  내 가  "결 의 "를&  투 여 하 면  어 떻 게  될 까 ?/');
ds_map_add(global.text_data_en, "obj_readable_room1_446", "* 목 숨 을  다 한  뒤 에 도&  영 혼 이  남 아 있 는 다 면 .../");
ds_map_add(global.text_data_en, "obj_readable_room1_447", "* 자 유 는  우 리  생 각 보 다&  가 까 이  있 을 지 도  모 른 다 ./%%");
