ds_map_add(global.text_data_en, "obj_blookdiary_102", "* 다 시  보 고  싶 어 ./%%");
ds_map_add(global.text_data_en, "obj_blookdiary_107", "* 일 기 장 ... 내  사 랑 .&* 일 기 장  수 집 은  멋 지 게&  진 행 되 고  있 어 ./");
ds_map_add(global.text_data_en, "obj_blookdiary_108", "* 이 제  다 섯  개  정 도  있 어 ./%%");
ds_map_add(global.text_data_en, "obj_blookdiary_115", "* 소 중 한  일 기 장 에 게 .&* 그  사 람 이  오 늘  날&  놀 라 게  했 어 ./");
ds_map_add(global.text_data_en, "obj_blookdiary_116", "* 나 를  위 해&  만 들 어 주 고  싶 다 는&  육 체 의  스 케 치 로 .../");
ds_map_add(global.text_data_en, "obj_blookdiary_117", "* 내  터 무 니 없 는&  환 상 을  넘 어 선  자 태 ./");
ds_map_add(global.text_data_en, "obj_blookdiary_118", '* 그 런  형 태 에 서 라 면 ^1,&  나 는  드 디 어 ...&  "내  자 신 "이  될  수  있 어 ./');
ds_map_add(global.text_data_en, "obj_blookdiary_119", "* 어 쨌 거 나 ^1, 지 금 의&  모 습 으 로 는  스 타 가&  될  수  없 으 니 까 ./");
ds_map_add(global.text_data_en, "obj_blookdiary_120", "* 미 안 해 ^1, 블 루 키 ^1.&* 내  꿈 은  누 구 도&  붙 잡 아 둘  수  없 어 .../%%");
