ds_map_add(global.text_data_en, "obj_undynebattle2_582", "\E6마 지 막  재 결 투 다 ^1!&모 든  것 을  다  걸 고&말 이 야 !!!/");
ds_map_add(global.text_data_en, "obj_undynebattle2_583", "내  자 존 심 을&회 복 하 기  위 해 선&이  방 법 밖 에&없 어 !!!/");
ds_map_add(global.text_data_en, "obj_undynebattle2_584", "자  빨 리 ^1!&힘 을  총 동 원 해 서&날  쳐 보 라 고 !&느 아 아 아 아 !!!/%%");
ds_map_add(global.text_data_en, "obj_undynebattle2_599", "* 언 다 인 은  당 신 에 게&  선 제 공 격 을  허 락 했 다 .");
ds_map_add(global.text_data_en, "obj_undynebattle2_645", "뭐 야 ./");
ds_map_add(global.text_data_en, "obj_undynebattle2_646", "\E2이 게  최 선 이 야 ?/");
ds_map_add(global.text_data_en, "obj_undynebattle2_647", "\E3모 든  힘 을  다 해 서&공 격 을  하 는 데 도 .../");
ds_map_add(global.text_data_en, "obj_undynebattle2_648", "나 를  해 치 고 픈&마 음 은  전 혀&없 었 다 는  거 야 ^1, 응 ?/");
ds_map_add(global.text_data_en, "obj_undynebattle2_649", "\E4.../");
ds_map_add(global.text_data_en, "obj_undynebattle2_650", "\E7헤 ^1, 있 잖 아 ?/%%");
ds_map_add(global.text_data_en, "obj_undynebattle2_670", "나 도  사 실  너 를&다 치 게  하 고&싶 지  않 아 ./");
ds_map_add(global.text_data_en, "obj_undynebattle2_671", "처 음 엔 ^1, 네  바 보  같 은&감 성 팔 이 가  싫 었 어 ^1.&하 지 만 .../");
ds_map_add(global.text_data_en, "obj_undynebattle2_672", "\E3네 가  지 금  날&친  거  말 야 ^1,&그 걸  보 니 .../");
ds_map_add(global.text_data_en, "obj_undynebattle2_673", "\E4예 전 에  나 랑&훈 련 하 던  녀 석 이&떠 오 르 네 ./");
ds_map_add(global.text_data_en, "obj_undynebattle2_674", "\E7네 가  그 냥  겁 쟁 이&패 배 자 는  아 니 란  걸&알 겠 어 ./");
ds_map_add(global.text_data_en, "obj_undynebattle2_678", "\E9넌  너 그 러 운  마 음 을&가 진  겁 쟁 이&패 배 자 야 !/");
ds_map_add(global.text_data_en, "obj_undynebattle2_679", "\E4그  녀 석 처 럼&말 이 지 .../");
ds_map_add(global.text_data_en, "obj_undynebattle2_680", "\E7.../");
ds_map_add(global.text_data_en, "obj_undynebattle2_681", "\E3들 어  봐 ^1, 인 간 ./");
ds_map_add(global.text_data_en, "obj_undynebattle2_682", "\E2넌  아 마  아 스 고 어 와&싸 우 게  될  운 명 인&것  같 아 ./");
ds_map_add(global.text_data_en, "obj_undynebattle2_683", "\E3하 지 만  그  사 람&성 격 상 .../");
ds_map_add(global.text_data_en, "obj_undynebattle2_684", "\E4딱 히 &싸 우 고  싶 진&않 아 할  거 야 ./");
ds_map_add(global.text_data_en, "obj_undynebattle2_685", "\E2대 화 를  해  봐 ./");
ds_map_add(global.text_data_en, "obj_undynebattle2_686", "\E1분 명  설 득 하 고  집 에&갈  수  있 을  거 야 ./");
ds_map_add(global.text_data_en, "obj_undynebattle2_687", "\E3언 젠 간 ^1, 못 된  인 간 이&이 곳 에  또&떨 어 지 겠 지 .../");
ds_map_add(global.text_data_en, "obj_undynebattle2_688", "\E3그  영 혼 을  대 신&가 져 가 면  돼 ./");
ds_map_add(global.text_data_en, "obj_undynebattle2_689", "\E1그 럼  되 지 ^1,&안  그 래 ^1?&푸 후 후 ./");
ds_map_add(global.text_data_en, "obj_undynebattle2_690", "\E2아 , 그 리 고  만 약&네 가  아 스 고 어 를&해 친 다 면 .../");
ds_map_add(global.text_data_en, "obj_undynebattle2_691", "\E7내 가  인 간 들 의&영 혼 을  가 지 고 ...&결 계 를  넘 어 가 서 .../");
ds_map_add(global.text_data_en, "obj_undynebattle2_692", "\E6네 놈 을&박 살  내 버 릴  거 야 !/");
ds_map_add(global.text_data_en, "obj_undynebattle2_693", "\E9친 구 란  그 런  거 지 ^1,&안  그 래 ?/");
ds_map_add(global.text_data_en, "obj_undynebattle2_694", "\E9푸 후 후 !/");
ds_map_add(global.text_data_en, "obj_undynebattle2_695", "\E9이 제  이  불 타 는&집 에 서  나 가 자 고 !/%%");
ds_map_add(global.text_data_en, "obj_undyneboss_401", "느 아 아&아 아 !");
ds_map_add(global.text_data_en, "obj_undyneboss_402", "해&보 자 !");
ds_map_add(global.text_data_en, "obj_undyneboss_403", "와 라 !");
ds_map_add(global.text_data_en, "obj_undyneboss_404", "푸 후 후 !");
ds_map_add(global.text_data_en, "obj_undyneboss_405", "느 아 아 !");
ds_map_add(global.text_data_en, "obj_undyneboss_406", "우 라 아 아 !");
ds_map_add(global.text_data_en, "obj_undyneboss_410", "\E1  강 하 군 ...&  그 래 도  그&  정 도 론  안  돼 !");
ds_map_add(global.text_data_en, "obj_undyneboss_411", "\E4  참  골 칫 거 리 인&  녀 석 이 군 , 응 ?");
ds_map_add(global.text_data_en, "obj_undyneboss_412", "\E5  좀  죽 어 라 , 이&  망 할  꼬 맹 아 !");
ds_map_add(global.text_data_en, "obj_undyneboss_416", "%%%");
ds_map_add(global.text_data_en, "obj_undyneboss_427", "  \X네 가  \G초 록 색 \X인&  이 상 \R 도 망 칠  순&  없 다 \X!/");
ds_map_add(global.text_data_en, "obj_undyneboss_428", "\X \R 위 험 에  맞 서 지 \X &  않 는  이 상 .../");
ds_map_add(global.text_data_en, "obj_undyneboss_429", "  나 에 게 서  잠 시 도&  버 틸  수  없 을 걸 !/%%");
ds_map_add(global.text_data_en, "obj_undyneboss_437", "  네 가 ^1? 자 비 를&  베 풀 어 준 다 고 ^1?&  푸 후 후 후 !/");
ds_map_add(global.text_data_en, "obj_undyneboss_438", "  모 욕 적 이 군 ^1!&  너 같 은  놈 한 테&  항 복 할  것  같 냐 !/%%");
ds_map_add(global.text_data_en, "obj_undyneboss_439", "  나 쁘 진  않 아 ^1!&  그 럼  이 건&  어 때 !?/%%");
ds_map_add(global.text_data_en, "obj_undyneboss_442", "\E0  나 는  정 정 당 당 한&  승 부 를  원 했 다 ./");
ds_map_add(global.text_data_en, "obj_undyneboss_443", "\E1  내 가  널&  쓰 러 뜨 려 버 리 고 .../");
ds_map_add(global.text_data_en, "obj_undyneboss_444", "  괴 물 들 도  강 해 질  수&  있 다 는  걸&  보 여 주 려  했 어 ./");
ds_map_add(global.text_data_en, "obj_undyneboss_445", "\E4  하 지 만  지 금 은 ???/");
ds_map_add(global.text_data_en, "obj_undyneboss_446", "\E5  상 관 없 어 !/");
ds_map_add(global.text_data_en, "obj_undyneboss_447", "  난  망 할&  유 치 원  선 생 님 이&  아 니 라 고 !/");
ds_map_add(global.text_data_en, "obj_undyneboss_448", "\E1  네  유 치 원&  선 생 님 이 .../");
ds_map_add(global.text_data_en, "obj_undyneboss_449", "\E5  이 런  걸&  하 지  않 는  이 상 !/%%");
ds_map_add(global.text_data_en, "obj_undyneboss_459", "\E5  뭐  하 는  거 야 ?/");
ds_map_add(global.text_data_en, "obj_undyneboss_460", " 그 냥  맞 서 라 고 !!!/");
ds_map_add(global.text_data_en, "obj_undyneboss_461", " 어 려 운  거&  아 니 거 든 !/");
ds_map_add(global.text_data_en, "obj_undyneboss_462", "\E0 %%");
ds_map_add(global.text_data_en, "obj_undyneboss_470", "\E4  봐 ./");
ds_map_add(global.text_data_en, "obj_undyneboss_471", "\E4  너 한 테  탄 막 을&  막 으 라 고  창 을&  줬 잖 아 ./");
ds_map_add(global.text_data_en, "obj_undyneboss_472", "\E4  더  확 실 하 게&  설 명 해 줘 야&  하 나 ?/");
ds_map_add(global.text_data_en, "obj_undyneboss_473", "\E0 %%");
ds_map_add(global.text_data_en, "obj_undyneboss_481", "\E4 \X \R위 험\X 에  맞 서 라 고&  한  말 은 .../");
ds_map_add(global.text_data_en, "obj_undyneboss_482", "\E4  탄 에  맞 서 라 는&  뜻 이 었 다 고 !/");
ds_map_add(global.text_data_en, "obj_undyneboss_483", "\E0 %%");
ds_map_add(global.text_data_en, "obj_undyneboss_496", "  오 랜  시 간 , 우 리 는&  해 피  엔 딩 을&  꿈  꿔  왔 지 ...");
ds_map_add(global.text_data_en, "obj_undyneboss_501", "  이 제 , 햇 빛 을&  볼  날 이  코 앞 이 야 !");
ds_map_add(global.text_data_en, "obj_undyneboss_506", "  네 놈 이  꿈 을&  앗 아 가 진&  못 하 게  할  테 다 !");
ds_map_add(global.text_data_en, "obj_undyneboss_510", "\E1  느 아 아 아 !&  몸 풀 기 는  이 만&  끝 이 다 !/%%");
ds_map_add(global.text_data_en, "obj_undyneboss_515", "  헤 ...&  강 하 군 !");
ds_map_add(global.text_data_en, "obj_undyneboss_519", "  자 비 라 고 ^1!&  하 !/");
ds_map_add(global.text_data_en, "obj_undyneboss_520", "  네 '가  '날 '&  봐  준 다 니&  믿 을  수 가  없 군 !/%%");
ds_map_add(global.text_data_en, "obj_undyneboss_528", "  하 지 만  네 가&  날  이 겨 도 ...");
ds_map_add(global.text_data_en, "obj_undyneboss_530", "  내 '가  '널 '&  봐  줘 도 ...");
ds_map_add(global.text_data_en, "obj_undyneboss_538", "\X \R 아 스 고 어\X 를  통 과 한&  인 간 은  여 지 껏&  없 었 어 !");
ds_map_add(global.text_data_en, "obj_undyneboss_546", "  그 러 니 , 널  지 금&  죽 이 는  게&  자 비 로 운  거 지 ...!");
ds_map_add(global.text_data_en, "obj_undyneboss_554", "  ...");
ds_map_add(global.text_data_en, "obj_undyneboss_563", "  그 러 니 , 널&  도 와 주 는  거 나&  마 찬 가 지 라 고 ...");
ds_map_add(global.text_data_en, "obj_undyneboss_570", "\X \R 아 스 고 어\X 를  통 과 한&  인 간 은  여 지 껏&  없 었 어 !");
ds_map_add(global.text_data_en, "obj_undyneboss_577", "\E1  널  지 금  죽 이 는  게&  자 비 를  베 푸 는&  거 라 고 !");
ds_map_add(global.text_data_en, "obj_undyneboss_582", "\E4  그 러 니 까  이 젠&  그 만  포 기 해 !/%%");
ds_map_add(global.text_data_en, "obj_undyneboss_587", "  인 간 은  대 체&  뭘 로  만 들 어 진&  거 야 !?");
ds_map_add(global.text_data_en, "obj_undyneboss_593", "  다 른  괴 물 들 이 면&  지 금 쯤  죽 었 을&  텐 데 !");
ds_map_add(global.text_data_en, "obj_undyneboss_599", "  알 피 스 는  인 간 들 은&  결 의 가  있 다 고&  했 지 ...");
ds_map_add(global.text_data_en, "obj_undyneboss_605", "  이 제  그 게&  무 슨  뜻 이 었 는 지&  알 겠 군 !");
ds_map_add(global.text_data_en, "obj_undyneboss_611", "  하 지 만  나 도&  결 의 가  있 다 고 !");
ds_map_add(global.text_data_en, "obj_undyneboss_616", "  지 금  당 장&  이  일 을  끝 내 버 릴&  결 의 가 !");
ds_map_add(global.text_data_en, "obj_undyneboss_622", "  ... 지 금  당 장 !");
ds_map_add(global.text_data_en, "obj_undyneboss_628", "  ... 지 금 ...&  ...&  ...당 장 !!");
ds_map_add(global.text_data_en, "obj_undyneboss_634", "  하 ...&  하 ...");
ds_map_add(global.text_data_en, "obj_undyneboss_639", "\E5  느 아 아 아 !&  빨 리  죽 으 라 고 ,&  이  망 할  꼬 맹 아 !/%%");
ds_map_add(global.text_data_en, "obj_undyneboss_656", "  내  앞 길 을&  가 로 막 다 니 !");
ds_map_add(global.text_data_en, "obj_undyneboss_658", "  너 같 은  놈 에 게&  자 비  따 윈&  바 라 지  않 겠 다 !");
ds_map_add(global.text_data_en, "obj_undyneboss_664", "  절 대  지 지&  않 겠 어 !");
ds_map_add(global.text_data_en, "obj_undyneboss_666", "  내 게 서 ! 절 대 !&  항 복 은 ! 못 !&  받 아 낸 다 !");
ds_map_add(global.text_data_en, "obj_undyneboss_672", "\X  내  손 에 선  절 대&  \R탈 출 \X할  수  없 어 !!!");
ds_map_add(global.text_data_en, "obj_undyneboss_682", "  참 나 ^1, 겨 우&  이  정 도 였 냐 !?/%%");
ds_map_add(global.text_data_en, "obj_undyneboss_686", "  ...가 련 하 군 ./");
ds_map_add(global.text_data_en, "obj_undyneboss_687", "  그 것 보 단  힘  좀&  더  써 야  할  거 다 !/%%");
ds_map_add(global.text_data_en, "obj_undyneboss_691", "  우 리  자 신 을  믿 을  때&  우 리 가  얼 마 나&  강 해 지 는 지  알 겠 나 ?/%%");
ds_map_add(global.text_data_en, "obj_undyneboss_695", "  헤 ...헤 .../");
ds_map_add(global.text_data_en, "obj_undyneboss_696", "  이 게  다 야 ?/%%");
ds_map_add(global.text_data_en, "obj_undyneboss_700", "\E7  .../");
ds_map_add(global.text_data_en, "obj_undyneboss_701", "  ... 난 ..^1.&  ... 포 기 하 지 ..^1.&  ... 않 을  거 야 .../%%");
ds_map_add(global.text_data_en, "obj_undyneboss_705", "\E7.../%%");
ds_map_add(global.text_data_en, "obj_undyneboss_1085", "* 바 람 이  울 부 짖 고  있 다 ...");
ds_map_add(global.text_data_en, "obj_undyneboss_1086", "* 언 다 인 은  성 급 하 게&  창 을  던 졌 다 .");
ds_map_add(global.text_data_en, "obj_undyneboss_1087", "* 꽃 가 루 가  당 신  앞 으 로&  날 리 고  있 다 .");
ds_map_add(global.text_data_en, "obj_undyneboss_1088", "* 당 신  주 변 에 서&  물 이  소 용 돌 이 친 다 .");
ds_map_add(global.text_data_en, "obj_undyneboss_1089", "* 창 이  잠 깐  멈 추 었 다 .");
ds_map_add(global.text_data_en, "obj_undyneboss_1094", "* 언 다 인 은  하 늘 을&  용 맹 스 럽 게  가 리 켰 다 .");
ds_map_add(global.text_data_en, "obj_undyneboss_1095", "* 언 다 인 은  성 급 하 게&  창 을  던 졌 다 .");
ds_map_add(global.text_data_en, "obj_undyneboss_1096", "* 언 다 인 은  커 다 란  바 위 를&  들 어 넘 겼 다 ^1,&  그 냥  할  수  있 으 니 까 .");
ds_map_add(global.text_data_en, "obj_undyneboss_1097", "* 언 다 인 은  성 급 하 게  뛰 었 다 .");
ds_map_add(global.text_data_en, "obj_undyneboss_1098", "* 언 다 인 은  위 협 적 인&  웃 음 을  지 었 다 .");
ds_map_add(global.text_data_en, "obj_undyneboss_1099", "* 언 다 인 은  자 신 의  손 으 로&  목 을  긋 는  시 늉 을  했 다 .");
ds_map_add(global.text_data_en, "obj_undyneboss_1100", "* 언 다 인 은  눈 앞 에 서&  주 먹 을  쥔  뒤&  머 리 를  흔 들 었 다 .");
ds_map_add(global.text_data_en, "obj_undyneboss_1101", "* 언 다 인 은  무 섭 게&  버 티 고  서  있 다 .");
ds_map_add(global.text_data_en, "obj_undyneboss_1102", "* 언 다 인 은  자 신 의&  친 구 들 을  떠 올 리 며&  주 먹 을  땅 에  찍 었 다 .");
ds_map_add(global.text_data_en, "obj_undyneboss_1103", "* 초 밥  냄 새 가  난 다 .");
ds_map_add(global.text_data_en, "obj_undyneboss_1107", "* 언 다 인 의  눈 이&  무 의 식 적 으 로  떨 리 고  있 다 .");
ds_map_add(global.text_data_en, "obj_undyneboss_1108", "* 언 다 인 이  창 을  땅 에&  내 리 쳤 다 .");
ds_map_add(global.text_data_en, "obj_undyneboss_1109", "* 언 다 인 은  몰 래 카 메 라 가&  있 는  건  아 닌 지&  확 인 하 고  있 다 .");
ds_map_add(global.text_data_en, "obj_undyneboss_1110", "* 언 다 인 은  씩 씩 거 리 고  있 다 .");
ds_map_add(global.text_data_en, "obj_undyneboss_1111", "* 화 난  생 선  냄 새 가  난 다 .");
ds_map_add(global.text_data_en, "obj_undyneboss_1118", "* 언 다 인 은  아 무 렇 지 도&  않 은  듯  웃 고  있 다 .");
ds_map_add(global.text_data_en, "obj_undyneboss_1119", "* 언 다 인 의  몸 이  불 안 정 하 게&  흔 들 리 고  있 다 .");
ds_map_add(global.text_data_en, "obj_undyneboss_1120", "* 언 다 인 의  몸 이  점 점&  형 체 를  잃 어 간 다 .");
