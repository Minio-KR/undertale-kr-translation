ds_map_add(global.text_data_en, "obj_mettboss_event_251", "* 당 신 은  알 피 스 를  다 시  보 고 ,&  알 피 스 는  당 신  보 고  떠 나 지&  말 라 고 도  할  수  있 는  거 죠 ./");
