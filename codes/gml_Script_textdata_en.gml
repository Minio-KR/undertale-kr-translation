ds_map_add(global.text_data_en, "obj_torieltrigger12_337", "\E6* ...잠 깐 ./");
ds_map_add(global.text_data_en, "obj_torieltrigger12_338", "* 왜  그 런  눈 으 로&  보 고  있 는  거 니 ?/");
