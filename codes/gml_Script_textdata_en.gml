ds_map_add(global.text_data_en, "obj_phonecall_room_247", "* 저 -저 기 ^1, 엘 리 베 이 터 는&  쓰 지  않 을  거 야 ?/");
ds_map_add(global.text_data_en, "obj_phonecall_room_248", "\E6* 이 쪽 으 로  갈  수&  있 을  것  같 은 데 !/");
ds_map_add(global.text_data_en, "obj_phonecall_room_249", "\E3* .../");
ds_map_add(global.text_data_en, "obj_phonecall_room_250", "* 가 다 가  큰  함 정&  같 은  게  있 지 만&  않 는 다 면 ...?/");
ds_map_add(global.text_data_en, "obj_phonecall_room_251", "\TS \F0 \T0 %");
ds_map_add(global.text_data_en, "obj_phonecall_room_252", "* 삑 .../%%");
ds_map_add(global.text_data_en, "obj_phonecall_room_259", "* 따 르 릉 .../");
ds_map_add(global.text_data_en, "obj_phonecall_room_260", "\TS \E3 \F6 \TA %");
ds_map_add(global.text_data_en, "obj_phonecall_room_261", "* 저 ..^1. 저  함 정 은&  어 디 서  나 온  거 야 ?/");
ds_map_add(global.text_data_en, "obj_phonecall_room_262", "\E8* 여 기 를  지 나 서&  갈  수  있 어 .../");
ds_map_add(global.text_data_en, "obj_phonecall_room_263", "\TS \F0 \T0 %");
ds_map_add(global.text_data_en, "obj_phonecall_room_264", "* 삑 .../%%");
ds_map_add(global.text_data_en, "obj_phonecall_room_275", "* 따 르 릉 .../");
ds_map_add(global.text_data_en, "obj_phonecall_room_276", "\TS \E6 \F6 \TA %");
ds_map_add(global.text_data_en, "obj_phonecall_room_277", "* 준 비 됐 어 ^1?&* 바 로  이 거 야 !/");
ds_map_add(global.text_data_en, "obj_phonecall_room_278", "* 엘 리 베 이 터 를  타 고&  코 어 의  꼭 대 기 로&  올 라 가 !/");
ds_map_add(global.text_data_en, "obj_phonecall_room_279", "\TS \F0 \T0 %");
ds_map_add(global.text_data_en, "obj_phonecall_room_280", "* 삑 .../%%");
ds_map_add(global.text_data_en, "obj_phonecall_room_290", "* 따 르 릉 .../%%");
ds_map_add(global.text_data_en, "obj_phonecall_room_302", "* 따 르 릉 .../");
ds_map_add(global.text_data_en, "obj_phonecall_room_303", "\TS \E3 \F6 \TA %");
ds_map_add(global.text_data_en, "obj_phonecall_room_304", "* 안 녕 ^1, 알 피 스 야 !/");
ds_map_add(global.text_data_en, "obj_phonecall_room_305", "* 이  방 은  전 에&  우 리 가  봤 던  방 과&  비 슷 해 ./");
ds_map_add(global.text_data_en, "obj_phonecall_room_306", "* 북 쪽 과  남 쪽 에&  두  개 의  퍼 즐 이&  있 고 .../");
ds_map_add(global.text_data_en, "obj_phonecall_room_307", "* 두  개 를  풀 면&  앞 으 로  나 아 갈  수&  있 어 !/");
ds_map_add(global.text_data_en, "obj_phonecall_room_308", "\E2* .../");
ds_map_add(global.text_data_en, "obj_phonecall_room_309", "\E0* 또 -또 ... 말 하 고 픈  게&  있 어 !/");
ds_map_add(global.text_data_en, "obj_phonecall_room_310", "\E3* 퍼 즐  해 답 을 ...&* 거 저  주 고  싶 지 는&  않 지 만 ./");
ds_map_add(global.text_data_en, "obj_phonecall_room_311", "\E6* 하 지 만  도 움 이  필 요 하 면 ^1,&  전 화 해 ^1. 알 겠 지 ?/");
ds_map_add(global.text_data_en, "obj_phonecall_room_312", "\E3* 그 래 ^1, 잠 깐 만 ^1.&  좋 은  생 각 이  있 어 !/");
ds_map_add(global.text_data_en, "obj_phonecall_room_313", "\E0* 언 더 넷  친 구 가&  되 는  거 야 !/");
ds_map_add(global.text_data_en, "obj_phonecall_room_314", "\E7* 그 러 면  도 움 이  필 요 할  때&  내 게  문 자 만  하 면  돼 !/");
ds_map_add(global.text_data_en, "obj_phonecall_room_315", "\E0* .../");
ds_map_add(global.text_data_en, "obj_phonecall_room_316", "\E4* 잠 깐 ^1, 우 리  이 미&  친 구 잖 아 ^1. 그 렇 지 ?/");
ds_map_add(global.text_data_en, "obj_phonecall_room_317", "\E5* 내 가  가 입 시 켜  줬 지 ^1,&  응 ?/");
ds_map_add(global.text_data_en, "obj_phonecall_room_318", "\E5* 너  쭉  내  포 스 팅 을&  읽 고  있 었 잖 아 .../");
ds_map_add(global.text_data_en, "obj_phonecall_room_319", "\E6* 아 무 튼 ^1! 네 가  나 의 ^1!&  냥 냥  2에  대 한  의 견 에 ^1!&* 동 의 해 주 리 라  믿 어 !/");
ds_map_add(global.text_data_en, "obj_phonecall_room_320", "\TS \F0 \T0 %");
ds_map_add(global.text_data_en, "obj_phonecall_room_321", "* 삑 .../%%");
ds_map_add(global.text_data_en, "obj_phonecall_room_353", "* 따 르 릉 .../");
ds_map_add(global.text_data_en, "obj_phonecall_room_354", "\TS \E3 \F6 \TA %");
ds_map_add(global.text_data_en, "obj_phonecall_room_355", "* 어 ^1, 이 -이 봐 !/");
ds_map_add(global.text_data_en, "obj_phonecall_room_356", "\E0* 화 장 실 에  좀  가 야 겠 어 ^1,&  잠 깐  잠 수  상 태 로&  있 을  거 야 ./");
ds_map_add(global.text_data_en, "obj_phonecall_room_357", "* 분 명 ..^1. 분 명  네  스 스 로&  이  퍼 즐 을  풀  수&  있 을  거 야 !/");
ds_map_add(global.text_data_en, "obj_phonecall_room_358", "\TS \F0 \T0 %");
ds_map_add(global.text_data_en, "obj_phonecall_room_359", "* 삑 .../%%");
ds_map_add(global.text_data_en, "obj_phonecall_room_372", "* 따 르 릉 .../");
ds_map_add(global.text_data_en, "obj_phonecall_room_373", "\TS \E3 \F6 \TA %");
ds_map_add(global.text_data_en, "obj_phonecall_room_374", "* 머 -멀 리&  저  건 물 이  보 여 ?/");
ds_map_add(global.text_data_en, "obj_phonecall_room_375", "\E0* 저 게  바 로  코 어 야 ^1.&* 모 든  지 하 의  동 력 원 이 지 ./");
ds_map_add(global.text_data_en, "obj_phonecall_room_376", "\E6* 지 열  에 너 지 를&  마 법 의  전 기 로&  바 꿔  주 는 데 .../");
ds_map_add(global.text_data_en, "obj_phonecall_room_377", "\E3* 어 ^1, 어 쨌 건 ^1.&  가 야  할  곳 이  있 잖 아 ./");
ds_map_add(global.text_data_en, "obj_phonecall_room_378", "\E0* 코 어 엔  아 스 고 어 의&  성 으 로  바 로  가 는&  엘 리 베 이 터 가  있 어 ./");
ds_map_add(global.text_data_en, "obj_phonecall_room_379", "\E0* 거 기 로  간 다 면 ..^1.&* 집 으 로  갈  수  있 을  거 야 ./");
ds_map_add(global.text_data_en, "obj_phonecall_room_380", "\TS \F0 \T0 %");
ds_map_add(global.text_data_en, "obj_phonecall_room_381", "* 삑 .../%%");
ds_map_add(global.text_data_en, "obj_phonecall_room_397", "* 따 르 릉 .../");
ds_map_add(global.text_data_en, "obj_phonecall_room_398", "\TS \E3 \F6 \TA %");
ds_map_add(global.text_data_en, "obj_phonecall_room_399", "* 어 어 ^1, 내  생 각 엔 ...&* 음 .../");
ds_map_add(global.text_data_en, "obj_phonecall_room_400", "\E6* 아 ^1!&* 왼 쪽 과  오 른 쪽 에  있 는&  퍼 즐  말 이 야 ...!/");
ds_map_add(global.text_data_en, "obj_phonecall_room_401", "\E6* 조 금  설 명 하 기 엔&  힘 들 지 만 .../");
ds_map_add(global.text_data_en, "obj_phonecall_room_402", "\E4* ...어 ^1, 벌 써&  푸 -풀 었 어 ?/");
ds_map_add(global.text_data_en, "obj_phonecall_room_403", "\E5* 대 단 해 !/");
ds_map_add(global.text_data_en, "obj_phonecall_room_404", "\TS \F0 \T0 %");
ds_map_add(global.text_data_en, "obj_phonecall_room_405", "* 삑 .../%%");
ds_map_add(global.text_data_en, "obj_phonecall_room_411", "* 따 르 릉 .../");
ds_map_add(global.text_data_en, "obj_phonecall_room_412", "\TS \E3 \F6 \TA %");
ds_map_add(global.text_data_en, "obj_phonecall_room_413", "* 알 피 스 야 !/");
ds_map_add(global.text_data_en, "obj_phonecall_room_414", "\E6* 저 -저  파 랑  레 이 저 는&  아 예  지 나 갈  수&  없 을  것  같 네 !/");
ds_map_add(global.text_data_en, "obj_phonecall_room_415", "\E3* 하 -하 -하 지 만 !/");
ds_map_add(global.text_data_en, "obj_phonecall_room_416", "\E6* 왕 실  과 학 자 인  내 게 ^1,&  좋 은  계 획 이  있 어 !/");
ds_map_add(global.text_data_en, "obj_phonecall_room_417", "* 내 -내 가  핫 랜 드&  레 이 저  데 이 터 베 이 스 를&  해 킹 해 서  꺼  버 릴 게 !/");
ds_map_add(global.text_data_en, "obj_phonecall_room_418", "\TS \F0 \T0 %");
ds_map_add(global.text_data_en, "obj_phonecall_room_419", "* 삑 .../%%");
ds_map_add(global.text_data_en, "obj_phonecall_room_423", "* 따 르 릉 .../");
ds_map_add(global.text_data_en, "obj_phonecall_room_424", "\TS \E3 \F6 \TA %");
ds_map_add(global.text_data_en, "obj_phonecall_room_425", "* 또 -또  레 이 저 라 고 ?/");
ds_map_add(global.text_data_en, "obj_phonecall_room_426", "\E8* 미 안 해 ^1, 이 번 에 는&  해 주 지  못 할  것  같 아 /");
ds_map_add(global.text_data_en, "obj_phonecall_room_427", "\E6* 잠 깐 만  기 다 려 !/");
ds_map_add(global.text_data_en, "obj_phonecall_room_428", "\TS \F0 \T0 %");
ds_map_add(global.text_data_en, "obj_phonecall_room_429", "* 삑 .../%%");
ds_map_add(global.text_data_en, "obj_phonecall_room_464", "* 따 르 릉 .../");
ds_map_add(global.text_data_en, "obj_phonecall_room_465", "\TS \E6 \F6 \TA %");
ds_map_add(global.text_data_en, "obj_phonecall_room_466", "\E6* 아 -아 -알 피 스&  바 꿨 습 니 다 !!/");
ds_map_add(global.text_data_en, "obj_phonecall_room_467", "\E3* 그 ..^1. 그  북 쪽  문 은&  잠 겨  있 을  거 야 .../");
ds_map_add(global.text_data_en, "obj_phonecall_room_468", "* 오 -오 른 쪽 과  왼 쪽 의&  퍼 즐 을  풀 어 야  열 려 !/");
ds_map_add(global.text_data_en, "obj_phonecall_room_469", "\E0* 내 ..^1. 내  새 -생 각 엔&  오 른 쪽 을  먼 저  가 는  게&  조 -좋 을  것  같 아 !/");
ds_map_add(global.text_data_en, "obj_phonecall_room_470", "\TS \F0 \T0 %");
ds_map_add(global.text_data_en, "obj_phonecall_room_471", "* 삑 .../%%");
ds_map_add(global.text_data_en, "obj_phonecall_room_498", "* 따 르 릉 .../");
ds_map_add(global.text_data_en, "obj_phonecall_room_499", "\TS \E3 \F6 \TA %");
ds_map_add(global.text_data_en, "obj_phonecall_room_500", "* 어 ^1!&* 아 -안 녕 ^1, 그 래 ^1.&  파 란  레 이 저 는 .../");
ds_map_add(global.text_data_en, "obj_phonecall_room_501", "\E4* 어 ^1! 내  말 은 ^1,&  알 피 스  바 꿨 습 니 다 ^1!&* 안 녕 !/");
ds_map_add(global.text_data_en, "obj_phonecall_room_502", "\W*\E6 \L파 란  레 이 저\W 는&  움 직 이 지  않 을  때 엔&  맞 지  않 아 !/");
ds_map_add(global.text_data_en, "obj_phonecall_room_503", "\W*\E3 \O주 -주 황 색\W 은 ^1, 음 ..^1.&* 우 -움 직 여 야  하 고 ^1, 그 럼 ../");
ds_map_add(global.text_data_en, "obj_phonecall_room_504", "\E4* 음 ^1, 그 러 면&  안  맞 는 데 ^1, 음 .../");
ds_map_add(global.text_data_en, "obj_phonecall_room_505", "\E6* 저 걸  지 나 가 !/");
ds_map_add(global.text_data_en, "obj_phonecall_room_506", "\E1* .../");
ds_map_add(global.text_data_en, "obj_phonecall_room_507", "\E5* 어 어 ^1, 끊 어 !/");
ds_map_add(global.text_data_en, "obj_phonecall_room_508", "\TS \F0 \T0 %");
ds_map_add(global.text_data_en, "obj_phonecall_room_509", "* 삑 .../%%");
ds_map_add(global.text_data_en, "obj_phonecall_room_521", "* 따 르 릉 ..^1. 따 르 릉 .../");
ds_map_add(global.text_data_en, "obj_phonecall_room_522", "* 삑 ...?/");
ds_map_add(global.text_data_en, "obj_phonecall_room_523", "* (대 답 하 기 도  전 에&  전 화 한  쪽 이  끊 은  것  같 다 .)/%%");
ds_map_add(global.text_data_en, "obj_phonecall_room_569", "* 따 르 릉 .../");
ds_map_add(global.text_data_en, "obj_phonecall_room_571", "반가워!/");
ds_map_add(global.text_data_en, "obj_phonecall_room_572", "친한 친구가 아니라면&누가 나를 믿겠는가!/");
ds_map_add(global.text_data_en, "obj_phonecall_room_573", "파피루스야^1,&네 친한 친구!/");
ds_map_add(global.text_data_en, "obj_phonecall_room_574", "\E3알피스랑&오늘 트레이닝은&일찍 마쳤어./");
ds_map_add(global.text_data_en, "obj_phonecall_room_575", "\E5아주 일찍./");
ds_map_add(global.text_data_en, "obj_phonecall_room_576", "\E3그래서 집에 보냈어./");
ds_map_add(global.text_data_en, "obj_phonecall_room_577", "\E5아주 집에./");
ds_map_add(global.text_data_en, "obj_phonecall_room_578", "\E3어... 이제./");
ds_map_add(global.text_data_en, "obj_phonecall_room_579", "\E0강렬하면서도&별 이유는 없는데./");
ds_map_add(global.text_data_en, "obj_phonecall_room_580", "\E3네가 거기 가 봐야..^1.&할 것 같아./");
ds_map_add(global.text_data_en, "obj_phonecall_room_581", "\E0거기^1,&알피스의 실험실...집에./");
ds_map_add(global.text_data_en, "obj_phonecall_room_582", "그냥 예감이&좋아서 그래./");
ds_map_add(global.text_data_en, "obj_phonecall_room_583", "\E5안녕./");
ds_map_add(global.text_data_en, "obj_phonecall_room_584", "\TS \F0 \T0 %");
ds_map_add(global.text_data_en, "obj_phonecall_room_585", "* 삑 .../%%");
ds_map_add(global.text_data_en, "obj_phonecall_room_593", "* 따 르 릉 .../");
ds_map_add(global.text_data_en, "obj_phonecall_room_594", "\TS \E4 \F6 \TA %");
ds_map_add(global.text_data_en, "obj_phonecall_room_595", "\E3* 아 ..^1. 안 녕 ...^1!&* 알 피 스  박 사 야 ./");
ds_map_add(global.text_data_en, "obj_phonecall_room_596", "\E0* 이  퍼 -퍼 즐 은  글 쎄 ..^1.&  음 ..^1. 타 이 밍 을&  맞 춰 야  하 는  거 네 ./");
ds_map_add(global.text_data_en, "obj_phonecall_room_597", "\E3* 저 -저  스 위 치 들 이&  보 여 ?/");
ds_map_add(global.text_data_en, "obj_phonecall_room_598", "\E0* 저 -저  세  개 를&  3초  안 에  다  눌 러 야  해 ./");
ds_map_add(global.text_data_en, "obj_phonecall_room_599", "\E6* 박 자 를  잘  맞 추 도 록&  도 와  줄 게 !/");
ds_map_add(global.text_data_en, "obj_phonecall_room_600", "\TS \F0 \T0 %");
ds_map_add(global.text_data_en, "obj_phonecall_room_601", "* 삑 .../%%");
ds_map_add(global.text_data_en, "obj_piano_68", "* 좀 ! 뭐  하 는  거 야 !/%%");
ds_map_add(global.text_data_en, "obj_playmovement_206", "* 어 라 ^1?&* 저  인 간 은 .../%%");
ds_map_add(global.text_data_en, "obj_playmovement_348", "* 이 럴  수 가 ...?/%%");
ds_map_add(global.text_data_en, "obj_playmovement_375", "* ...정 말 로  제&  운 명 의  사 랑 인 가 요 ?/%%");
ds_map_add(global.text_data_en, "obj_playmovement_791", "* 정 말  슬 퍼 요 ./");
ds_map_add(global.text_data_en, "obj_playmovement_792", "* 당 신 이  지 하  감 옥 에&  들 어 가 게  된 다 니&  정 말  슬 퍼 요 ./%%");
ds_map_add(global.text_data_en, "obj_playmovement_795", "* 오 우 우 !&* 이  비 극 은  정 말&  견 딜  수 가  없 군 요 ./");
ds_map_add(global.text_data_en, "obj_playmovement_796", "* 왕 께 서  당 신 에 게&  성 의  지 하 실 에 서  썩 으 라 는&  명 을  내 리 셨 거 든 요 ./");
ds_map_add(global.text_data_en, "obj_playmovement_797", "* 그 래 서  짬 을  내 어&  그 에  대 한  달 콤 한&  노 래 를  불 러 줬 답 니 다 ./");
ds_map_add(global.text_data_en, "obj_playmovement_798", "* 나 의  사 랑 ^1!&* 무 슨  일 이  닥 칠 지  알 고  나 니&  차 마  볼  수 가  없 군 요 ./%%");
ds_map_add(global.text_data_en, "obj_playmovement_821", "* 그 럼 ^1, 안 녕 히 !/%%");
ds_map_add(global.text_data_en, "obj_potheat_73", "* \*D 버튼으로 불을 올려라!");
ds_map_add(global.text_data_en, "obj_potheat_108", "* 왼 쪽 이 라 고 ^1?&  멍 청 하 기 는 ^2!%");
ds_map_add(global.text_data_en, "obj_potheat_109", "\E6* 이  버 너 는&  한 쪽 으 로 만&  돌 아 간 다 고 !!^2!%%");
ds_map_add(global.text_data_en, "obj_potheat_132", "* 뜨 겁 게 !^2!%%");
ds_map_add(global.text_data_en, "obj_potheat_155", "* 더  뜨 겁 게 ^1, 젠 장 !^2!%%");
ds_map_add(global.text_data_en, "obj_potheat_179", "* 화 끈 하 게 !!!!!!!^2!%%");
ds_map_add(global.text_data_en, "obj_potheat_196", "* 잠 깐 ^1, 그 건  너 무 ^1- %%");
