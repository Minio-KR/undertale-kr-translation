ds_map_add(global.text_data_en, "obj_labelevator_b_123", "* (당 신 이  처 음&  들 어 보 는  목 소 리 다 .)/%%");
ds_map_add(global.text_data_en, "obj_labelevator_b_131", "* \[차]..^1.&* 듣 고  있 어 ?/");
