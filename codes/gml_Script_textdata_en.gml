ds_map_add(global.text_data_en, "mett_operacomment_1", "(흐 음 ? 창 의 적 으 로 ?)");
ds_map_add(global.text_data_en, "mett_operacomment_2", "(나 와  춤 을  춰 요 , 달 링 )");
ds_map_add(global.text_data_en, "mett_operacomment_3", "(오 ! 관 중 들 이#당 신 의  열 정 을#느 낄  수  있 어 요 !)");
ds_map_add(global.text_data_en, "mett_operacomment_3_unfrantic", "(관 중 들 에 게#당 신 의  열 정 을#보 여  줘 요 !)");
ds_map_add(global.text_data_en, "mett_operacomment_3_touch", "(정 말  가 깝 게 ... 열 정 적 이 야 ...)");
ds_map_add(global.text_data_en, "mett_operacomment_3_frantic1", "(...좀  도 와 줘 요 ?)");
ds_map_add(global.text_data_en, "mett_operacomment_3_frantic2", "(...뭐  하 는  거 예 요 ?)");
ds_map_add(global.text_data_en, "mett_operacomment_4", "(멈 추 지  말 아 요 !)");
ds_map_add(global.text_data_en, "mett_operacomment_4_unfrantic", "(당 신 을  봐 요 , 무 대 를#날 뛰 면 서 ...)");
ds_map_add(global.text_data_en, "mett_operacomment_4_touch", "(손 을  가 만 히  못  두 는  거 죠 , 허 ?)");
ds_map_add(global.text_data_en, "mett_operacomment_4_frantic1", "(이 게  인 간 들 의  춤 인 가 요 ?)");
ds_map_add(global.text_data_en, "mett_operacomment_4_frantic2", "(인 간 은  생 각 보 다#더  이 상 하 군 요 )");
ds_map_add(global.text_data_en, "mett_operacomment_5", "(오 ! 정 말#빠 져 들 고  있 어 요 )");
ds_map_add(global.text_data_en, "mett_operacomment_5_unfrantic", "(격 렬 하 게  움 직 이 며 ...)");
ds_map_add(global.text_data_en, "mett_operacomment_5_touch", "(누 가  뭐 라 고  할  수  있 겠 어 요 ?)");
ds_map_add(global.text_data_en, "mett_operacomment_5_frantic1", "(흐 음 , 이 건  익 숙 해 져 야 겠 군 요 ...)");
ds_map_add(global.text_data_en, "mett_operacomment_5_frantic2", "(생 각 했 던  것 보 다#훨 씬  더  대 단 해 ...)");
ds_map_add(global.text_data_en, "mett_operacomment_6", "(그 래 서#그 런  것 이 군 요 )");
ds_map_add(global.text_data_en, "mett_operacomment_7", "(인 간 과 ... 춤 춘 다 는  건 )");
ds_map_add(global.text_data_en, "mett_operacomment_8", "(수 치 스 러 워 라 ...)");
