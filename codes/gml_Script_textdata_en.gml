ds_map_add(global.text_data_en, "obj_muffetnpc2_75", "* 거 기  있 었 네 ^1, 자 기 ^1.&* 자 기 는  언 제 나&  내  응 접 실 에  와 도  돼 !/");
ds_map_add(global.text_data_en, "obj_muffetnpc2_76", "* 그 저  얌 전 히  있 기 만&  하 면  말 이 야 ^1~&* 우 이 히 히 히 ~/%%");
ds_map_add(global.text_data_en, "obj_muffetnpc2_81", "* 봉 주 르 , 자 기 ^1~&* 방 금  우 리 한 테  온&  기 부 금 을  다  셌 어 !/");
ds_map_add(global.text_data_en, "obj_muffetnpc2_82", "* 마 침 내 ^1, 폐 허 의  거 미 들 을&  구 출 할  수  있 을  만 큼&  돈 이  모 였 더 라 구 ./");
ds_map_add(global.text_data_en, "obj_muffetnpc2_83", "* 그 리 고&  또  우 린 ...!/");
ds_map_add(global.text_data_en, "obj_muffetnpc2_84", "* 아 무 것 도  못  사 ^1,&  도 넛  한  개 만  팔 았 거 든 ./");
ds_map_add(global.text_data_en, "obj_muffetnpc2_85", "* 뭐 가  문 제 인 거 야 ? 다 들^1?&* 거 미  좋 아 하 는  줄&  알 았 는 데 ~/%%");
ds_map_add(global.text_data_en, "obj_muffetnpc2_87", "* 모 든  거 미 들 을  위 한&  4쌍 의  멋 진  선 글 라 스 를&  마 련 할  수  있 게  됐 어 !/%%");
ds_map_add(global.text_data_en, "obj_muffetnpc2_89", "* 모 든  거 미 들 을  위 한&  4쌍 의  방 수  부 츠 를&  마 련 할  수  있 게  됐 어 !/%%");
ds_map_add(global.text_data_en, "obj_muffetnpc2_91", "* 모 든  거 미 들 을  위 한&  4쌍 의  멋 진  힐 을&  마 련 할  수  있 게  됐 어 !/%%");
ds_map_add(global.text_data_en, "obj_muffetnpc2_93", "* 거 미  야 구 장 을  마 련 할  수&  있 게  됐 어 ^1!&* 야 구 공  도 넛 도  준 비 했 지 ~/%%");
ds_map_add(global.text_data_en, "obj_muffetnpc2_95", "* 거 미  축 구 장 을  마 련 할  수&  있 게  됐 어 ^1!&* 한  경 기 에  공  4개 를  쓸  거 야 !/%%");
ds_map_add(global.text_data_en, "obj_muffetnpc2_99", "* 새 로 운  빵 집 을^1,&  차 릴  수  있 게  됐 어 ^1!&* 정 말  고 마 워 , 자 기 !/");
ds_map_add(global.text_data_en, "obj_muffetnpc2_100", "* 전 부  자 기^2 &* (의  돈 ) 덕 분 이 야 ./%%");
ds_map_add(global.text_data_en, "obj_muffetnpc2_105", "* 전  세 계  어 디 에 서 나&  휴 가 를  즐 길  수&  있 게  됐 어 !/");
ds_map_add(global.text_data_en, "obj_muffetnpc2_106", "* 열 대 지 방 으 로  가 야  할 까 ^1?&* 아 니 면  으 스 스 한  폐 가 ^1?&* 못  정 하 겠 어 ~/%%");
ds_map_add(global.text_data_en, "obj_multitileevent_121", "* 아 , 안  돼 !&* 어 떡 해 야  하 죠 ?/");
ds_map_add(global.text_data_en, "obj_multitileevent_122", "* 제  사 랑 이&  지 하  감 옥 으 로&  던 져 졌 어 요 ./");
ds_map_add(global.text_data_en, "obj_multitileevent_123", "* 악 랄 한  퍼 즐 의  감 옥 이 라 니 ,&  내  사 랑 은  분 명&  죽 어 버 릴  거 예 요 !/%%");
ds_map_add(global.text_data_en, "obj_multitileevent_144", "* 이 런 , 제 발  자 비 를 !&* 끔 찍 한  색  타 일  미 로 잖 아 !/");
ds_map_add(global.text_data_en, "obj_multitileevent_145", "* 각 각 의  색  타 일 에 는&  끔 찍 한  기 능 들 이  있 답 니 다 ./");
ds_map_add(global.text_data_en, "obj_multitileevent_146", "* 예 를  들 면 , 초 록 색  타 일 은&  소 리 를  내 기  때 문 에&  괴 물 과  싸 워 야  해 요 ./");
ds_map_add(global.text_data_en, "obj_multitileevent_147", "* 빨 간  타 일 은 ...&* 저 기 , 잠 깐 만 요 ./");
ds_map_add(global.text_data_en, "obj_multitileevent_148", "* 꽤  오 래 전 에  이  퍼 즐&  본  적  있 지  않 아 요 ?/");
ds_map_add(global.text_data_en, "obj_multitileevent_149", "* 맞 아 요 .&* 무 슨  규 칙 이 었 는 지&  다  기 억 하 고  있 겠 죠 ?/");
ds_map_add(global.text_data_en, "obj_multitileevent_150", "* 좋 아 요 ...&* 다 시  말 해 주 는  건&  시 간  낭 비 니  안  할 게 요 !!/%%");
ds_map_add(global.text_data_en, "obj_multitileevent_163", "* 아 , 서 두 르 는  게&  좋 을  겁 니 다 ./");
ds_map_add(global.text_data_en, "obj_multitileevent_164", "\W* 왜 냐 하 면  \Y30초\W  안 에&  가 지  않 는 다 면 .../%%");
ds_map_add(global.text_data_en, "obj_multitileevent_192", "* 저  거 센  불 길 에  타&  죽 어 버 릴  테 니 까 요 !!/");
ds_map_add(global.text_data_en, "obj_multitileevent_193", "* 아 하 하 하 하 !&* 아 하 하 ... 하 ... 하 !/");
ds_map_add(global.text_data_en, "obj_multitileevent_194", "* 가 련 한  내  사 랑 !&* 정 말  슬 픔 에  겨 워 서 ,&  웃 음 을  멈 출  수 가  없 군 요 !/");
