ds_map_add(global.text_data_en, "obj_undynedate_inside_121", "내 친구가&너한테 줄 선물을&직접 챙겨 왔어!/%%");
ds_map_add(global.text_data_en, "obj_undynedate_inside_143", "* 어 ..^1. 고 마 워 ./%%");
ds_map_add(global.text_data_en, "obj_undynedate_inside_177", "* 이 건 ^1, 음 ^1, 그 냥&  다 른  것 들 이 랑&  둬 야 겠 다 ./%%");
ds_map_add(global.text_data_en, "obj_undynedate_inside_236", "* 자  그 럼 ,&  시 작 해  볼 까 ?/%%");
ds_map_add(global.text_data_en, "obj_undynedate_inside_250", "어머나, 맙소사^1!&갑자기 기억났는데!/");
ds_map_add(global.text_data_en, "obj_undynedate_inside_251", "나!&화장실! 가야 돼!!!/");
ds_map_add(global.text_data_en, "obj_undynedate_inside_252", "\E0둘이서 신나게&놀고 있어!!!/%%");
ds_map_add(global.text_data_en, "obj_undynedate_inside_335", "이런^1! 안타깝군.../");
ds_map_add(global.text_data_en, "obj_undynedate_inside_336", "\E2언다인이라면 너와&친구가 될 수 있으리라&생각했는데./");
ds_map_add(global.text_data_en, "obj_undynedate_inside_337", "\E3그런데.../");
ds_map_add(global.text_data_en, "obj_undynedate_inside_338", "\E3내가 언다인을 너무&과대평가했나봐./");
