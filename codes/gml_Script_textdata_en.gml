ds_map_add(global.text_data_en, "obj_readable_room1_425", "* 실 험  기 록  제 1번 /");
ds_map_add(global.text_data_en, "obj_readable_room1_426", "* 드 디 어 ..^1.&* 왕 이  부 탁 하 신  걸&  할  때 가  왔 다 ./");
ds_map_add(global.text_data_en, "obj_readable_room1_427", "* 우 리 를  자 유 롭 게  해  줄&  힘 을  발 명 할  것 이 다 ./");
ds_map_add(global.text_data_en, "obj_readable_room1_428", "* 나 는  영 혼 의  힘 을&  해 방 시 킬  것 이 다 ./%%");
ds_map_add(global.text_data_en, "obj_readable_room1_430", "* (꺼 진  것  같 다 .)/%%");
ds_map_add(global.text_data_en, "obj_readable_room1_435", "* 동 력 실 /%%");
