ds_map_add(global.text_data_en, "obj_torieltrigger12_354", "* 널  이 해 시 키 는  데&  얼 마 나  걸 려 야&  하 는  거 니 ?/%%");
ds_map_add(global.text_data_en, "obj_torieltrigger5_185", "* 여 기 까 지  어 떻 게&  온  거 니 ^1, 아 가 ^1?&* 다 쳤 니 ?/");
ds_map_add(global.text_data_en, "obj_torieltrigger5_186", "* 안  다 쳤 구 나 ..^1.&*\E0 대 단 한 걸 ^1!&*\E1 그 래 도 .../");
