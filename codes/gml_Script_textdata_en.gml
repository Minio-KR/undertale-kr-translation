ds_map_add(global.text_data_en, "obj_npc_room_389", "* (토 리 엘 이  봤 을 까  하 는&  궁 금 증 이  생 긴 다 .)/%%");
ds_map_add(global.text_data_en, "obj_npc_room_406", "* 노 는  중 이 었 는 데  갑 자 기 ^1,&  난 데 없 이  엄 청 나 게  많 은&  퍼 즐 이  다 시  작 동 했 어 ./");
ds_map_add(global.text_data_en, "obj_npc_room_407", "* 정 말  큰  문 제 야 ..^1.&* 진 짜  장 난  아 냐 ^1! 이 걸 로&  학 교 도  쉬 어 야 겠 다 니 까 !/%%");
ds_map_add(global.text_data_en, "obj_npc_room_409", "* 잠 깐 만 ..^1.&* 아 아 아 ^1,&  여 름 방 학 이 었 잖 아 !/%%");
ds_map_add(global.text_data_en, "obj_npc_room_417", "* 이 봐 ^1, 들 었 어 ^1?&* 결 계 가  열 렸 대 !/");
ds_map_add(global.text_data_en, "obj_npc_room_418", "* 이 제  휴 교 해 야  되 는  거 ^1,&  맞 지 !?/%%");
ds_map_add(global.text_data_en, "obj_npc_room_423", "* 그 나 저 나 ^1, 왜  짜 증 나 는&  학 교 에  가 야  하 는&  걸 까 ...?/");
ds_map_add(global.text_data_en, "obj_npc_room_424", "* 이  세 계 는  미 래 가  없 어 ./%%");
ds_map_add(global.text_data_en, "obj_npc_room_430", "* 드 디 어 !&* 레 이 저 가  꺼 졌 군 !/");
ds_map_add(global.text_data_en, "obj_npc_room_431", "* 이 제  자 유 로 워 졌 으 니 ..^1.&* 음 ^1, 어 ^1, 우 린  그 냥&  여 기  계 속  서  있 을 래 ./%%");
ds_map_add(global.text_data_en, "obj_npc_room_434", "* 응 ^1? 시 도 는  좋 았 는 데 ^1.&* 너 는  어 슬 렁 거 리 기 는&  더  연 습 이  필 요 해 ./%%");
ds_map_add(global.text_data_en, "obj_npc_room_436", "* 아 마  지 상 에 는  더&  어 슬 렁 거 릴  수  있 는&  장 소 가  있 겠 지 ./%%");
ds_map_add(global.text_data_en, "obj_npc_room_440", "* 서 성 거 리 는  건 ...&* 뭐 가  목 적 인 데 ?/%%");
ds_map_add(global.text_data_en, "obj_npc_room_451", "* 일 하 러  가 는  길 이  막 혀 서 ^1,&  핸 드 폰 으 로  메 타 톤  방 송 을&  볼  시 간 이  생 겼 어 .../");
ds_map_add(global.text_data_en, "obj_npc_room_452", "* 오 늘  특 수 효 과  정 말&  놀 라 웠 어 ^1! 그  인 간  거 의&  '진 짜 '처 럼  보 였 다 고 !/%%");
ds_map_add(global.text_data_en, "obj_npc_room_454", "* 물 론 ^1, 나 같 이  대 단 한&  시 청 자 는  딱  보 면&  특 수 효 과 인  줄  안 다 니 까 .../%%");
ds_map_add(global.text_data_en, "obj_npc_room_458", "* 결 계 가  열 렸 으 니 ^1,&  오 늘 은  일 하 러&  가 지  않 아 도  돼 ./");
ds_map_add(global.text_data_en, "obj_npc_room_459", "* 물 론 ^1, 우 리 가  자 유 로 워 지 긴&  했 지 만 ^1, 그 래 도  그 게&  중 요 한  건  아 니 잖 아 , 응 ?/%%");
ds_map_add(global.text_data_en, "obj_npc_room_464", "* 마 지 막  에 피 소 드 는&  너 무  감 동 적 이 었 어 .../");
ds_map_add(global.text_data_en, "obj_npc_room_465", "* 메 타 톤 은  괜 찮 을  거 야 ^1.&* 모 두 가  그  장 면 이&  특 수  효 과 였 던  걸  아 니 까 !/%%");
ds_map_add(global.text_data_en, "obj_npc_room_470", "* 메 타 톤 ^1? 그 래 ^1, 그  로 봇 은&  이  지 하  세 계 에 서&  가 장  유 명 한  스 타 지 !/");
ds_map_add(global.text_data_en, "obj_npc_room_471", "* 팬 클 럽 에  가 입 한&  회 원  수 도  아 마  최 소&  2.^1. 아 니 ^1, 36명 은  될  걸 !/%%");
ds_map_add(global.text_data_en, "obj_npc_room_474", "* 심 지 어  날  포 함 하 지 도&  않 은  숫 자 야 !/%%");
ds_map_add(global.text_data_en, "obj_npc_room_478", "* 오 늘 ^1, 우 리 는  동 업 자 로&  다  같 이  시 작 했 지 .../");
ds_map_add(global.text_data_en, "obj_npc_room_479", "* 내 일 은  어 떤  관 계 일 지&  어 떻 게  알 겠 어 ?/%%");
ds_map_add(global.text_data_en, "obj_npc_room_484", "* 감 동 적 인  장 면 이 었 어 ./");
ds_map_add(global.text_data_en, "obj_npc_room_485", "* 그  장 면  때 문 에&  팬 클 럽  회 원 수 가&  두  배 로  뛰 었 을  거 야 !/%%");
ds_map_add(global.text_data_en, "obj_npc_room_508", "* (이  전 산 화 된  레 이 저&  보 안 금 고  안 에&  치 즈  한  조 각 이  놓 여 있 다 .)/");
ds_map_add(global.text_data_en, "obj_npc_room_509", "* (레 이 저 가  치 즈 의&  가 장 자 리 를  녹 였 다 ..^1.)&* (테 이 블 에  눌 러 붙 었 다 .)/%%");
ds_map_add(global.text_data_en, "obj_npc_room_513", "* (쥐 가  금 고 를  해 킹 해&  치 즈 를  꺼 내  간  모 양 이 다 .)/%%");
ds_map_add(global.text_data_en, "obj_npc_room_523", "* 네 가  여 기  오 게  돼 서&  정 말  기 뻐 !/");
ds_map_add(global.text_data_en, "obj_npc_room_524", "* 탁 자 에  앉 지  그 래 ?/%%");
ds_map_add(global.text_data_en, "obj_npc_room_527", "* 망 할  탁 자 에&  빨 리  앉 으 라 구 ^1,&  이  꼬 맹 아 ./%%");
ds_map_add(global.text_data_en, "obj_npc_room_534", "* 나 ..^1. 나 ..^1.&  나  결 국  도 넛 을&  사  버 렸 어 .../");
ds_map_add(global.text_data_en, "obj_npc_room_535", "* 나 .^1. 사 고  싶 지  않 았 지 만 ^1,&  저  여 자 애 가 ... &  안  산 다 고  했 는 데 도 ^1, 쟤 가 .../");
ds_map_add(global.text_data_en, "obj_npc_room_536", "* ...입 술 을  핥 으 면 서&  소 름 끼 치 게  날  계 속&  쳐 다 봤 어 ./");
ds_map_add(global.text_data_en, "obj_npc_room_537", "* 이 ..^1. 이 제  빈 털 털 이 야 ./%%");
ds_map_add(global.text_data_en, "obj_npc_room_540", "* 어 쩌 면  이 걸  온 라 인 으 로&  팔 아 서  잃 은  돈 의  두  배 를&  벌  수  있 을 지 도  몰 라 .../%%");
ds_map_add(global.text_data_en, "obj_npc_room_545", "* 지 상 에 서 는 , 다 시 는&  거 미 로 부 터  도 넛 을&  사 지  않 을  거 야 ./");
