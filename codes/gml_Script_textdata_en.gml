ds_map_add(global.text_data_en, "obj_labtv_event_474", "* \[차]^1!&* 결 의 를  가 져 야  한 다 !/");
ds_map_add(global.text_data_en, "obj_labtv_event_475", "* 여 기 서  포 기 하 면  안  돼 ..^1.&* 너 는  인 간 과  괴 물 들 의&  미 래 야 ...\TR/");
