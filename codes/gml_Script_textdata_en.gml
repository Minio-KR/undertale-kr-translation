ds_map_add(global.text_data_en, "SCR_TEXT_1313", "* 여 긴  아 무 것 도  없 다 !!!/%%");
ds_map_add(global.text_data_en, "SCR_TEXT_1329", "* (얼 룩 진  앞 치 마 를  얻 었 다 .)/%%");
ds_map_add(global.text_data_en, "SCR_TEXT_1332", "* (너 무  많 이  들 고  있 다 .)/%%");
ds_map_add(global.text_data_en, "SCR_TEXT_1336", " %%");
ds_map_add(global.text_data_en, "SCR_TEXT_1343", "* (쓰 레 기 통  안 에&  글 램 버 거 가  있 다 .)/");
