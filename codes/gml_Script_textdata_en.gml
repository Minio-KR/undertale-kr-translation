ds_map_add(global.text_data_en, "obj_alphysfollow_event_262", "* 나 .../");
ds_map_add(global.text_data_en, "obj_alphysfollow_event_263", "\E5* 네 게  거 짓 말 을  했 어 ./");
ds_map_add(global.text_data_en, "obj_alphysfollow_event_264", "\E7* 인 간 의  영 혼 만 으 로 는&  결 계 를  지 나 갈  정 도 로&  강 력 하 지  않 아 ./");
ds_map_add(global.text_data_en, "obj_alphysfollow_event_265", "\E6* 적 어 도  인 간 의  영 혼&  하 나 와 .../");
ds_map_add(global.text_data_en, "obj_alphysfollow_event_266", "\E5* 괴 물 의  영 혼  하 나 가&  필 요 해 ./");
ds_map_add(global.text_data_en, "obj_alphysfollow_event_267", "\E5* .../%%");
ds_map_add(global.text_data_en, "obj_alphysfollow_event_295", "* 집 에  가 고  싶 다 면 .../");
ds_map_add(global.text_data_en, "obj_alphysfollow_event_296", "\E5* 그 분 의  영 혼 을&  취 해 야  할  거 야 ./");
ds_map_add(global.text_data_en, "obj_alphysfollow_event_297", "\E7* 아 스 고 어  님 을&  죽 여 야  할  거 야 ./%%");
ds_map_add(global.text_data_en, "obj_alphysfollow_event_345", "* 미 안 해 ./%%");
ds_map_add(global.text_data_en, "obj_alphystrigger1_166", "* 오 ^1.&* 세 상 에 ./%%");
ds_map_add(global.text_data_en, "obj_alphystrigger1_175", "* 이 렇 게 나  빨 리&  나 타 날  줄 이 야 !/");
ds_map_add(global.text_data_en, "obj_alphystrigger1_176", "* 샤 워 도  안  했 고 ^1,&  옷 도  개 판 이 고 ^1,&  난 장 판 인 데 , 또 .../%%");
ds_map_add(global.text_data_en, "obj_alphystrigger1_224", "* 음 .../");
ds_map_add(global.text_data_en, "obj_alphystrigger1_225", "* 아 -안 녕 !/");
ds_map_add(global.text_data_en, "obj_alphystrigger1_226", "* 난  알 피 스  박 사 야 ^1.&* 아 스 고 어  님 을  받 드 는&  왕 실  과 학 자 !/");
ds_map_add(global.text_data_en, "obj_alphystrigger1_227", "\E3* 하 -하 지 만 ^1, 어 ..^1.&  난  그 런  '나 쁜  녀 석 '은&  아 니 야 !/");
ds_map_add(global.text_data_en, "obj_alphystrigger1_228", "\E0* 사 실 ^1, 네 가  폐 허 에&  들 어 왔 을  때 부 터&  난 ..^1. 음 .../");
ds_map_add(global.text_data_en, "obj_alphystrigger1_229", "\E7* ...내  콘 솔 로&  네  여 행 을&  '지 켜 보 고 ' 있 었 어 ./");
ds_map_add(global.text_data_en, "obj_alphystrigger1_230", "\E3* 네  싸 움 ..^1.&* 네  우 정 ..^1.&* 전 부  다 !/");
ds_map_add(global.text_data_en, "obj_alphystrigger1_231", "\E0* 처 음 엔  널  막 을&  생 각 이 었 지 만 .../");
ds_map_add(global.text_data_en, "obj_alphystrigger1_236", "\E7* 스 크 린 에  뜨 는  널&  보 면 서  정 말 로&  응 원 하 게  됐 어 ./");
ds_map_add(global.text_data_en, "obj_alphystrigger1_237", "\E7* 그 게  마 치 ..^1.&  오 랜  친 구 를&  보 는  것  같 았 거 든 ./");
ds_map_add(global.text_data_en, "obj_alphystrigger1_238", "\E0* 그 -그 러 니 ^1,&  아 ^1. 이 제  널&  도 와 주 고  싶 어 !/");
ds_map_add(global.text_data_en, "obj_alphystrigger1_239", "\E6* 내  지 식 을  활 용 해&  네 가  핫 랜 드 를  쉽 게&  지 나 가 도 록  해  줄 게 !/");
ds_map_add(global.text_data_en, "obj_alphystrigger1_240", "\E0* 아 스 고 어 의  성 으 로&  바 로  가 는  길 을  알 아 ^1,&  문 제  없 지 !/");
ds_map_add(global.text_data_en, "obj_alphystrigger1_241", "\E2* .../");
ds_map_add(global.text_data_en, "obj_alphystrigger1_242", "\E7* 뭐 ^1, 사 실 ^1. 음 ^1,&  아 주  작 은  문 제 가&  하 나  있 긴  해 ./");
ds_map_add(global.text_data_en, "obj_alphystrigger1_243", "\E0* 아 주  오 래 전 에 ^1,&  메 타 톤 이 라 는  이 름 의&  로 봇 을  만 들 었 었 어 ./");
ds_map_add(global.text_data_en, "obj_alphystrigger1_244", "* 원 래 는 ^1,&  오 락 용  로 봇 으 로&  만 들 었 었 지 ./");
ds_map_add(global.text_data_en, "obj_alphystrigger1_245", "\E7* 아 ^1, 뭐 랄 까 ^1.&* 로 봇  TV 스 타 나&  그 런  것  말 이 야 ./");
ds_map_add(global.text_data_en, "obj_alphystrigger1_246", "\E0* 최 근 에  그  로 봇 을&  좀  더  쓸 만 하 게&  만 들 려  했 었 거 든 ./");
ds_map_add(global.text_data_en, "obj_alphystrigger1_247", "\E7* 그 러 니 까 ^1,&  약 간  실 용 적 으 로&  고 쳤 단  말 이 야 ./");
ds_map_add(global.text_data_en, "obj_alphystrigger1_248", "\E0* 예 를  들 면 ^1, 음 .../");
ds_map_add(global.text_data_en, "obj_alphystrigger1_249", "\E4* 대 ..^1. 대 -인 간  전 투&  능 력 이 라 던 가 ?/");
ds_map_add(global.text_data_en, "obj_alphystrigger1_250", "\E6* 무 -물 론 ^1, 네 가  오 는  걸&  보 자 마 자 .../");
ds_map_add(global.text_data_en, "obj_alphystrigger1_251", "\E3* 그  능 력 을&  없 애 버 려 야 겠 다 고&  생 각 했 지 !/");
ds_map_add(global.text_data_en, "obj_alphystrigger1_252", "\E4* 불 행 히 도 ^1, 그 러 다 가&  아 주  작 은  실 수 를&  했 는 데 ./");
ds_map_add(global.text_data_en, "obj_alphystrigger1_253", "* 그 리 고 ^1, 음 .../");
ds_map_add(global.text_data_en, "obj_alphystrigger1_254", "\E5* 걷 잡 을  수  없 이&  인 간 의  피 를  갈 구 하 는&  살 인  기 계 가  되 었 달 까 ?/");
ds_map_add(global.text_data_en, "obj_alphystrigger1_255", "* 에 헤 헤 .../");
ds_map_add(global.text_data_en, "obj_alphystrigger1_256", "\E8* 헤 ./");
ds_map_add(global.text_data_en, "obj_alphystrigger1_257", "\E0* 하 지 만 ^1, 음 ^1.&  잘 하 면  아 마&  만 나 진  않 을  거 야 !/%%");
ds_map_add(global.text_data_en, "obj_alphystrigger1_288", "* ...?/%%");
ds_map_add(global.text_data_en, "obj_alphystrigger1_312", "* 무 슨  소 리&  안  들 려 ?/%%");
ds_map_add(global.text_data_en, "obj_alphystrigger1_344", "* 아 , 안  돼 ./%%");
ds_map_add(global.text_data_en, "obj_alphystrigger1_393", "* 오 오 오 , 좋 아 요 !/");
ds_map_add(global.text_data_en, "obj_alphystrigger1_394", "* 환 영 합 니 다 ^1, 여 러 분 .../%%");
ds_map_add(global.text_data_en, "obj_alphystrigger1_441", "\M1* ... 오 늘 의  퀴 즈  쇼 입 니 다 !/%%");
ds_map_add(global.text_data_en, "obj_alphystrigger1_468", "\M0* 맙 소 사 ^1!&* 정 말  대 단 한  쇼 가&  될  것  같 군 요 !/");
ds_map_add(global.text_data_en, "obj_alphystrigger1_469", "\M2* 다 들  멋 진  참 가 자 에 게&  큰  박 수  부 탁 드 립 니 다 !/%%");
ds_map_add(global.text_data_en, "obj_alphystrigger1_493", "\M0* 전 에  해  본  적  없 죠 ^1,&  멋 쟁 이  씨 ?/");
ds_map_add(global.text_data_en, "obj_alphystrigger1_494", "\M2* 문 제  없 습 니 다 ^1!&* 간 단 해 요 !/");
ds_map_add(global.text_data_en, "obj_alphystrigger1_495", "\M4* 규 칙 은  하 나 뿐 입 니 다 ./");
ds_map_add(global.text_data_en, "obj_alphystrigger1_496", "* 올 바 른  답 을  말 하 거 나 .../%%");
ds_map_add(global.text_data_en, "obj_alphystrigger1_514", "* 아 님  죽 거 나 !!!/%%");
ds_map_add(global.text_data_en, "obj_alphystrigger1_566", "* .../");
ds_map_add(global.text_data_en, "obj_alphystrigger1_567", "\E0* 와 , 정 말&  장 난  아 니 었 어 ./%%");
ds_map_add(global.text_data_en, "obj_alphystrigger2_87", "* 잠 깐 ^1, 잠 깐 !/%%");
ds_map_add(global.text_data_en, "obj_alphystrigger2_146", "\E0* 내  저 -전 화 번 호 를&  줄 게 !/");
ds_map_add(global.text_data_en, "obj_alphystrigger2_147", "\E7* 그 럼 ..^1. 아 -아 마 ..^1.&* 네 가  도 움 이&  필 요 하 면  내 가 .../%%");
ds_map_add(global.text_data_en, "obj_alphystrigger2_169", "\E3* 이 ..^1. 이 런  전 화 는&  어 디 서  구 했 어 !?&* 완 전  유 물 이 잖 아 !/");
ds_map_add(global.text_data_en, "obj_alphystrigger2_170", "\E1* 이 건  문 자 도&  안  되 는 군 ./");
ds_map_add(global.text_data_en, "obj_alphystrigger2_171", "\E3* 자 -잠 깐 만&  기 다 려  줘 !/%%");
ds_map_add(global.text_data_en, "obj_alphystrigger2_221", "\E0* 자 ^1, 네  걸&  업 그 레 이 드 해 줬 어 !/");
ds_map_add(global.text_data_en, "obj_alphystrigger2_222", "* 이 제  문 자 도 ^1,&  물 건  보 관 도  되 고&  열 쇠  고 리 에 다 가 .../");
ds_map_add(global.text_data_en, "obj_alphystrigger2_223", "* 지 하 의  No.1 SNS에&  가 입 도  시 켜  줬 지 !/");
ds_map_add(global.text_data_en, "obj_alphystrigger2_224", "\E7* 우 린  공 식 적 으 로&  친 구 인  거 야 ^1!&* 에 헤 헤 !/");
ds_map_add(global.text_data_en, "obj_alphystrigger2_225", "\E0* 헤 헤 .../");
ds_map_add(global.text_data_en, "obj_alphystrigger2_226", "\E0* 헤 .../");
ds_map_add(global.text_data_en, "obj_alphystrigger2_227", "\E0* .../");
ds_map_add(global.text_data_en, "obj_alphystrigger2_228", "\E1* .../");
ds_map_add(global.text_data_en, "obj_alphystrigger2_229", "\E2* .../");
ds_map_add(global.text_data_en, "obj_alphystrigger2_230", "\E1* .../");
ds_map_add(global.text_data_en, "obj_alphystrigger2_231", "\E2* .../");
ds_map_add(global.text_data_en, "obj_alphystrigger2_232", "\E4* 화 장 실 에  가 야 겠 다 ./%%");
ds_map_add(global.text_data_en, "obj_amalgam_fridge_99", "* (냉 장 고 다 ^1.)&* (비 어  있 다 .)/%%");
ds_map_add(global.text_data_en, "obj_amalgam_fridge_103", "* (뭔 가  차 갑 고 ^1,&  사 각 형 인  물 체 다 .)/%%");
ds_map_add(global.text_data_en, "obj_amalgam_fridge_107", "* (당 신 은  바 닥 의&  파 란  열 쇠 를  찾 았 다 .^1)&* (열 쇠 고 리 에  걸 었 다 .)/%%");
ds_map_add(global.text_data_en, "obj_artclass_sign_208", "* (예 술  클 럽 : 이 곳 에 서  만 남 !&* 다 음  모 임 :&* 10월  10일  8PM)/%%");
ds_map_add(global.text_data_en, "obj_artclass_sign_213", "* (예 술  클 럽 은&  취 소 되 었 습 니 다 !)/%%");
ds_map_add(global.text_data_en, "obj_artclass_sign_218", "* (예 술 은  죽 었 다 .)/%%");
ds_map_add(global.text_data_en, "obj_artclass_sign_224", "* 나 중 에  다 시  만 나 요 !/%%");
ds_map_add(global.text_data_en, "obj_artclass_sign_231", "* 예 술  클 럽 에 선&  또  무 슨  일 이  우 리 를&  기 다 리 고  있 을 까 요 ?/%%");
ds_map_add(global.text_data_en, "obj_artclass_sign_281", "* 아 아 아 !!^1!&* 늦 었 어 !!^1!&* 늦 어 버 렸 어 !!!/");
ds_map_add(global.text_data_en, "obj_artclass_sign_282", "* 미 안 해 요 !!!/%%");
ds_map_add(global.text_data_en, "obj_asgore_finalintro_178", "    * (이 상 한  빛 이&      방 을  가 득  채 운 다 .^4) %");
ds_map_add(global.text_data_en, "obj_asgore_finalintro_179", "    * (결 계  너 머 에 서&      황 혼 이  비 쳐  들 어 온 다 .^3) %");
ds_map_add(global.text_data_en, "obj_asgore_finalintro_180", "    * (당 신 의  여 정 의  끝 이&      보 이 는  듯 하 다 .^4) %");
ds_map_add(global.text_data_en, "obj_asgore_finalintro_181", "      * (당 신 은  결 의 로&         충 만 해 졌 다 .^5) %%");
ds_map_add(global.text_data_en, "obj_asgore_finalintro_213", "인 간 이 여&.../");
ds_map_add(global.text_data_en, "obj_asgore_finalintro_214", "\E1만 나 서&즐 거 웠 네 ./");
ds_map_add(global.text_data_en, "obj_asgore_finalintro_215", "\E0작 별 이 네 ./%%");
ds_map_add(global.text_data_en, "obj_asgore_finalintro_220", "\E1자 , &자 ./");
ds_map_add(global.text_data_en, "obj_asgore_finalintro_221", "싸 울&필 요 는&없 다 네 ./");
ds_map_add(global.text_data_en, "obj_asgore_finalintro_222", "차 라 도&한  잔&하 며 .../");
ds_map_add(global.text_data_en, "obj_asgore_finalintro_223", "천 천 히 &이 야 기&해 보 는  건&어 떤 가 ?/%%");
ds_map_add(global.text_data_en, "obj_asgore_finalintro_496", "* 아 스 고 어 가  공 격 해 왔 다 !");
ds_map_add(global.text_data_en, "obj_asgore_friendc_76", "\E0* 반 갑 구 나 ^1, 프 리 스 크 ./");
ds_map_add(global.text_data_en, "obj_asgore_friendc_77", "\E3* 네  영 혼 을  거 의&  빼 앗 으 려  했 던  건&  미 안 하 구 나 ./");
ds_map_add(global.text_data_en, "obj_asgore_friendc_78", "\E5* 정 말  유 감 스 럽 게&  생 각 하 고  있 단 다 ./");
ds_map_add(global.text_data_en, "obj_asgore_friendc_79", "\E0* 우 리 가  아 직  친 구 가&  될  수  있 다 면  좋 겠 구 나 ./");
ds_map_add(global.text_data_en, "obj_asgore_friendc_81", "\E0* 에 이 ^1, 너 무  걱 정  마 ^1.&  아 스 고 어 ./");
ds_map_add(global.text_data_en, "obj_asgore_friendc_82", "\E2* 우 리  다  적 어 도  한  번 은&  프 리 스 크 를  죽 이 려 고&  했 던  것  같 은 데 ./");
ds_map_add(global.text_data_en, "obj_asgore_friendc_84", "\E2* 오 ..^1. 알 겠 다 !/");
ds_map_add(global.text_data_en, "obj_asgore_friendc_85", "\E0* 그 렇 다 면 ^1,&  미 안 하 진  않 구 나 ^1.&  프 리 스 크 ./");
ds_map_add(global.text_data_en, "obj_asgore_friendc_87", "\E6* 아 스 고 어 ^1!&* 그 런  뜻 이  아 니 야 !/%%");
ds_map_add(global.text_data_en, "obj_asgore_friendc_97", "\E3* 오 ^1, 프 리 스 크 ^1.&  바 쁘 지  않 다 면 .../");
ds_map_add(global.text_data_en, "obj_asgore_friendc_98", "\E0* 이 런  날 엔 ^1, 산 책 이 라 도&  하 며  좋 은  시 간 을&  보 내 도  좋 겠 구 나 ./");
ds_map_add(global.text_data_en, "obj_asgore_friendc_99", "\E0* 그 게  중 요 한  거 야 ./%%");
ds_map_add(global.text_data_en, "obj_asgore_lastcutscene_243", "아 .../");
ds_map_add(global.text_data_en, "obj_asgore_lastcutscene_244", ".../");
ds_map_add(global.text_data_en, "obj_asgore_lastcutscene_245", "결 국&이 렇 게&되 는 군 ./");
ds_map_add(global.text_data_en, "obj_asgore_lastcutscene_246", ".../%%");
ds_map_add(global.text_data_en, "obj_asgore_lastcutscene_251", "\E3자 네 ..^1.&어 째 서&.../%%");
ds_map_add(global.text_data_en, "obj_asgore_lastcutscene_275", "아 들 이  죽 은&다 음 날 이  기 억 나 는 군 ./");
ds_map_add(global.text_data_en, "obj_asgore_lastcutscene_276", "지 하  세 계 의  모 두 가&희 망 을  잃 었 었 지 ./");
ds_map_add(global.text_data_en, "obj_asgore_lastcutscene_277", "우 리  미 래 는  또  한  번&인 간 들 에 게&빼 앗 긴  거 야 ./");
ds_map_add(global.text_data_en, "obj_asgore_lastcutscene_278", "나 는  분 노 하 여 ,&전 쟁 을  선 포 했 다 ./");
ds_map_add(global.text_data_en, "obj_asgore_lastcutscene_279", "여 기 에  오 는  인 간 을&모 두  죽 이 고 ./");
ds_map_add(global.text_data_en, "obj_asgore_lastcutscene_280", "그 들 의  영 혼 을&이 용 해  신 과  같 은&존 재 가  되 어 서 .../");
ds_map_add(global.text_data_en, "obj_asgore_lastcutscene_281", "...우 리 를  이  끔 찍 한&감 옥 에 서  해 방 시 키 고 ./");
ds_map_add(global.text_data_en, "obj_asgore_lastcutscene_282", "그  후 엔 , 인 간  세 계 를&파 괴 해 서 .../");
ds_map_add(global.text_data_en, "obj_asgore_lastcutscene_283", "괴 물 들 이  지 상 을&평 화 롭 게  다 스 리 게&하 겠 노 라 고  말 했 지 ./");
ds_map_add(global.text_data_en, "obj_asgore_lastcutscene_284", "오 래 지  않 아&사 람 들 의  희 망 은&돌 아 왔 다 ./");
ds_map_add(global.text_data_en, "obj_asgore_lastcutscene_285", "하 지 만  내  아 내 는&나 의  행 동 들 을&역 겨 워 했 지 ./");
ds_map_add(global.text_data_en, "obj_asgore_lastcutscene_286", "그 이 는  이 곳 을&떠 났 고 , 다 신&볼  수  없 었 다 ./%%");
ds_map_add(global.text_data_en, "obj_asgore_lastcutscene_294", "사 실 .../");
ds_map_add(global.text_data_en, "obj_asgore_lastcutscene_295", "나 는  힘  같 은  건&원 하 지  않 아 ./");
ds_map_add(global.text_data_en, "obj_asgore_lastcutscene_296", "나 는  누 구 도&해 치 고  싶 지  않 아 ./");
ds_map_add(global.text_data_en, "obj_asgore_lastcutscene_297", "나 는  그 저  모 두 가&희 망 을  가 지 기 를&바 랄  뿐 이 라 네 .../");
ds_map_add(global.text_data_en, "obj_asgore_lastcutscene_298", "하 지 만 .../");
ds_map_add(global.text_data_en, "obj_asgore_lastcutscene_299", "더  이 상 은&못  견 디 겠 어 ./");
ds_map_add(global.text_data_en, "obj_asgore_lastcutscene_300", "아 내 가  정 말&보 고  싶 구 나 ./");
ds_map_add(global.text_data_en, "obj_asgore_lastcutscene_301", "아 들 이  정 말&보 고  싶 어 ./");
ds_map_add(global.text_data_en, "obj_asgore_lastcutscene_302", "부 탁 하 네 ..^1.&젊 은 이 여 .../");
ds_map_add(global.text_data_en, "obj_asgore_lastcutscene_303", "이  전 쟁 은&충 분 히  길 었 네 ./");
ds_map_add(global.text_data_en, "obj_asgore_lastcutscene_304", "자 네 는  그 만 한  힘 을&가 지 고  있 어 .../");
ds_map_add(global.text_data_en, "obj_asgore_lastcutscene_305", "내  영 혼 을  받 게 .&그 리 고  이  저 주 받 은&장 소 를  떠 나 게 ./%%");
ds_map_add(global.text_data_en, "obj_asgore_lastcutscene_340", ".../");
ds_map_add(global.text_data_en, "obj_asgore_lastcutscene_341", "\E0자 네 를  이 렇 게 나&해 치 려 고  했 는 데 도 .../");
ds_map_add(global.text_data_en, "obj_asgore_lastcutscene_342", "\E7자 네 는  지 상 에  나 가&행 복 하 게  살 지&않 고 .../");
ds_map_add(global.text_data_en, "obj_asgore_lastcutscene_343", "\E9여 기 에&남 아 있 겠 다 고 ?/");
ds_map_add(global.text_data_en, "obj_asgore_lastcutscene_344", "\E6.../%%");
ds_map_add(global.text_data_en, "obj_asgore_lastcutscene_352", "\E1인 간 이 여 .../");
ds_map_add(global.text_data_en, "obj_asgore_lastcutscene_353", "\E7내  약 속 하 마 .../");
ds_map_add(global.text_data_en, "obj_asgore_lastcutscene_354", "\E7자 네 가  여 기&있 는  동 안 은 .../");
ds_map_add(global.text_data_en, "obj_asgore_lastcutscene_355", "\E1나 와  내  아 내 가&최 선 을  다 해&돌 봐 주 겠 네 ./");
ds_map_add(global.text_data_en, "obj_asgore_lastcutscene_356", "\E2거 실 에&함 께  있 으 면 서 ^1,&이 야 기 도  하 고 .../");
ds_map_add(global.text_data_en, "obj_asgore_lastcutscene_357", "\E1버 터 스 카 치  파 이 를&먹 으 면 서 .../");
ds_map_add(global.text_data_en, "obj_asgore_lastcutscene_358", "\E2우 리 는&그 러 니 까 .../");
ds_map_add(global.text_data_en, "obj_asgore_lastcutscene_359", "\E8가 족 처 럼&될  수  있 을 걸 세 .../%%");
ds_map_add(global.text_data_en, "obj_asgore_lastcutscene_623", "이&멍 청 이 ./");
ds_map_add(global.text_data_en, "obj_asgore_lastcutscene_627", "\[차]./");
ds_map_add(global.text_data_en, "obj_asgore_lastcutscene_628", "아 무&것 도&배 운 게&없 구 나 ?/%%");
ds_map_add(global.text_data_en, "obj_asgore_lastcutscene_632", "히  히&히 ./");
ds_map_add(global.text_data_en, "obj_asgore_lastcutscene_633", "드 디 어&알 겠 나&보 네 ./%%");
ds_map_add(global.text_data_en, "obj_asgore_lastcutscene_639", "\[차]./");
ds_map_add(global.text_data_en, "obj_asgore_lastcutscene_640", "드 디 어&기 억 이&났 나  봐 ./%%");
ds_map_add(global.text_data_en, "obj_asgore_lastcutscene_651", "이&세 상 에 선&말 이 지&.../%%");
ds_map_add(global.text_data_en, "obj_asgore_lastcutscene_692", "죽 거 나  죽 이 거 나 야 ^4.%%");
ds_map_add(global.text_data_en, "obj_asgore_lastcutscene_769", "히  히  히 ^1.&걱 정 하 진  마 ./");
ds_map_add(global.text_data_en, "obj_asgore_lastcutscene_770", "너 하 고 는&싸 워 봤 자 라 는  건&알 아 ./");
ds_map_add(global.text_data_en, "obj_asgore_lastcutscene_771", "인 간 의&영 혼 들 이  또&반 항 하 겠 지 ./");
ds_map_add(global.text_data_en, "obj_asgore_lastcutscene_772", "그 러 니 ...!/%%");
ds_map_add(global.text_data_en, "obj_asgore_lastcutscene_778", "히  히  히 ^1./");
ds_map_add(global.text_data_en, "obj_asgore_lastcutscene_779", "정 말  날&죽 인 다 고  뭐 가&달 라 질  것&같 아 ?/");
ds_map_add(global.text_data_en, "obj_asgore_lastcutscene_780", "아 니 ./");
ds_map_add(global.text_data_en, "obj_asgore_lastcutscene_781", "세 이 브  파 일 을&불 러 올  때 마 다 ^1,&난  다 시  돌 아 올  거 야 ./");
ds_map_add(global.text_data_en, "obj_asgore_lastcutscene_782", "그 리 고  네 가&해 피  엔 딩 을  보 려&할  때 마 다 .../");
ds_map_add(global.text_data_en, "obj_asgore_lastcutscene_783", "내 가  나 타 나 서&다  찢 어 버 릴  거 야 !/");
ds_map_add(global.text_data_en, "obj_asgore_lastcutscene_784", "하  하  하  !!!/%%");
ds_map_add(global.text_data_en, "obj_asgore_lastcutscene_792", "음 ^1, 그 냥&끝 내 자 고 ./%%");
ds_map_add(global.text_data_en, "obj_asgore_lastcutscene_796", ".../%%");
ds_map_add(global.text_data_en, "obj_asgore_lastcutscene_831", "\E2.../");
ds_map_add(global.text_data_en, "obj_asgore_lastcutscene_832", "\E0아 냐 ^1.&그 건  환 상 일&뿐 이 야 ^1, 그 렇 지 ?/");
ds_map_add(global.text_data_en, "obj_asgore_lastcutscene_833", "\E1젊 은 이 여 ^1, 자 네 를&보 면 .../");
ds_map_add(global.text_data_en, "obj_asgore_lastcutscene_834", "\E2오 래 전  이 곳 에&떨 어 졌 던  인 간 이&생 각 나 는 구 만 .../");
ds_map_add(global.text_data_en, "obj_asgore_lastcutscene_835", "\E8자 네 의  눈 에 서&똑 같 은  희 망 이&보 이 네 ./");
ds_map_add(global.text_data_en, "obj_asgore_lastcutscene_836", "\E7우 리 들  사 이 에&전 해 지 는  고 대 의&예 언 이  있 다 네 .../");
ds_map_add(global.text_data_en, "obj_asgore_lastcutscene_837", "어 느  날 ^1, 하 늘 에 서&구 원 자 가&올  것 이 라 고 ./");
ds_map_add(global.text_data_en, "obj_asgore_lastcutscene_838", "\E1...난  예 언 이&말 하 는  사 람 이&자 네 라 고  믿 네 ./");
ds_map_add(global.text_data_en, "obj_asgore_lastcutscene_839", "바 깥  세 상&어 딘 가 에 .../");
ds_map_add(global.text_data_en, "obj_asgore_lastcutscene_840", "우 리 를&이  감 옥 에 서  꺼 낼&방 법 이  있 을  걸 세 ./");
ds_map_add(global.text_data_en, "obj_asgore_lastcutscene_841", "\E0자 네 에 게  이 런  책 임 을&지 우 는  것 이&고 통 스 럽 지 만 ^1, 하 지 만 .../");
ds_map_add(global.text_data_en, "obj_asgore_lastcutscene_842", "\E0부 탁 하 네 ^1.&내  영 혼 을  받 게 나 ..^1.&그 리 고  진 실 을  찾 게 나 ./%%");
ds_map_add(global.text_data_en, "obj_asgore_lastcutscene_898", "\E0하 ... 하 .../");
ds_map_add(global.text_data_en, "obj_asgore_lastcutscene_899", "\E6유 감 이 군 .../");
ds_map_add(global.text_data_en, "obj_asgore_lastcutscene_900", "자 네 에 게  단 순 한&해 피  엔 딩 도 ^1,&주 지  못 했 구 만 .../");
ds_map_add(global.text_data_en, "obj_asgore_lastcutscene_901", "하 지 만  나 는&자 네 의  자 유 를&믿 는 다 네 .../");
ds_map_add(global.text_data_en, "obj_asgore_lastcutscene_902", "...내  아 들 이 .../");
ds_map_add(global.text_data_en, "obj_asgore_lastcutscene_903", "\E8...아 스 리 엘 이&가 지 고  싶 어 했 던&자 유 를 ./%%");
ds_map_add(global.text_data_en, "obj_asgore_lastcutscene_979", "봤 지 ^1?&절 대 로  널&배 신 한  게  아 니 야 ^2! %");
ds_map_add(global.text_data_en, "obj_asgore_lastcutscene_980", "전 부  속 임 수 였 다 고 ,&알 겠 지 ?^2? %");
ds_map_add(global.text_data_en, "obj_asgore_lastcutscene_981", "널  위 해  이 놈 을&죽 이 려 고  기 다 리 고&있 었 던  거 야 ^2! %");
ds_map_add(global.text_data_en, "obj_asgore_lastcutscene_982", "\E1어 떻 게  됐 던  우 린&둘 도  없 는  친 구 잖 아 ^2! %");
ds_map_add(global.text_data_en, "obj_asgore_lastcutscene_983", "\E2내 가  도 와 줄  수  있 어 , &쓸  데 가  많 을  거 라 고 ^1 %");
ds_map_add(global.text_data_en, "obj_asgore_lastcutscene_984", "\E1절 대 로  방 해 하 지&않 겠 다 고  약 속 할 게 ^1 %%");
ds_map_add(global.text_data_en, "obj_asgore_lastcutscene_995", "\E2내 가  도 와 줄  수&있 어 ..^1. 내 가 ..^1.&내 가 ..^2. %%");
ds_map_add(global.text_data_en, "obj_asgore_lastcutscene_1006", "\E3제 발  날  죽 이 지&말 아  줘 ./%%");
ds_map_add(global.text_data_en, "obj_asgore_prebarrier_event_78", "* 긴 장 되 는 군 .../");
ds_map_add(global.text_data_en, "obj_asgore_prebarrier_event_79", "\E2* 그 냥 .../");
ds_map_add(global.text_data_en, "obj_asgore_prebarrier_event_80", "\E0* 치 과  의 사 를&  보 러  가 는  거 라 고&  생 각 하 게 ./%%");
ds_map_add(global.text_data_en, "obj_asgore_prebarrier_event_112", "* 준 비 됐 나 ?/");
ds_map_add(global.text_data_en, "obj_asgore_prebarrier_event_113", "\E3* 준 비 되 지  않 았 다 고&  해 도 ^1, 이 해 한 다 네 ./");
ds_map_add(global.text_data_en, "obj_asgore_prebarrier_event_114", "\E2* 나 도  준 비 가&  안  됐 거 든 ./%%");
