ds_map_add(global.text_data_en, "obj_shop5_343", "\E0* 안 뇽 ^1!&* 테 미  샵 에  온  걸 ..^1.&* 화 녕 행 !!!!/*");
ds_map_add(global.text_data_en, "obj_shop5_344", "\E0* 안 뇽 ^1!&* 테 미  샵 에  온  걸 ..^1.&* 화 녕 행 !!!!/*");
ds_map_add(global.text_data_en, "obj_shop5_405", "\E0안 뇽 ^1!&여 기 는 ..^1.&테 미&샵 이 얗 !/*");
