ds_map_add(global.text_data_en, "obj_storybattle_gen_805", "인 간 을  꽉  붙 든  채 로&.../*");
ds_map_add(global.text_data_en, "obj_storybattle_gen_816", "아 스 리 엘 은&웃 어  보 이 고 ^1,&거 길  떠 났 지 요 ./%%");
ds_map_add(global.text_data_en, "obj_storybattle_gen_832", "상 처  입 은&아 스 리 엘 은 ^1,&집 에  비 틀 거 리 며&돌 아 왔 어 요 ./*");
ds_map_add(global.text_data_en, "obj_storybattle_gen_845", "성 으 로  돌 아 와 선&그  자 리 에 서&쓰 러 져 버 렸 고 ,/*");
ds_map_add(global.text_data_en, "obj_storybattle_gen_857", "곧  먼 지 가  되 어&정 원  전 체 에&흩 뿌 려 졌 어 요 ./%%");
ds_map_add(global.text_data_en, "obj_storybattle_gen_872", "왕 국 은  절 망 의&구 렁 텅 이 로&떨 어 졌 습 니 다 ./*");
ds_map_add(global.text_data_en, "obj_storybattle_gen_885", "왕 과  여 왕 은&하 룻 밤  사 이 에&두  아 이 를&모 두  잃 었 어 요 ./*");
ds_map_add(global.text_data_en, "obj_storybattle_gen_897", "인 간 들 은  다 시 금&우 리 의  모 든  걸&빼 앗 아  간  겁 니 다 ./%%");
ds_map_add(global.text_data_en, "obj_storybattle_gen_911", "왕 은  이  고 통 을&끝 내 기 로  했 어 요 ./*");
ds_map_add(global.text_data_en, "obj_storybattle_gen_924", "지 하 로  떨 어 진&모 든  인 간 은&죽 어 야 만  해 요 ./*");
ds_map_add(global.text_data_en, "obj_storybattle_gen_936", "충 분 한  영 혼 만&있 으 면 ^1, 결 계 를&영 원 히  부 숴 버 릴&수  있 어 요 ./%%");
ds_map_add(global.text_data_en, "obj_storybattle_gen_951", "이 제  때 가  얼 마&남 지  않 았 습 니 다 ./%%");
ds_map_add(global.text_data_en, "obj_storybattle_gen_965", "아 스 고 어  대 왕 님 이&우 리 를  보 내 주 실&겁 니 다 ./*");
ds_map_add(global.text_data_en, "obj_storybattle_gen_971", "아 스 고 어  대 왕 님 이&우 리 에 게  희 망 을&주 실  겁 니 다 ./*");
ds_map_add(global.text_data_en, "obj_storybattle_gen_976", "아 스 고 어  대 왕 님 이&우 리  모 두 를&구 해 주 실  겁 니 다 ./%%");
ds_map_add(global.text_data_en, "obj_storybattle_gen_1004", "당 신 도  웃 어 야 지 요 ^1./*");
ds_map_add(global.text_data_en, "obj_storybattle_gen_1014", "기 대 되 지&않 나 요 ?/*");
ds_map_add(global.text_data_en, "obj_storybattle_gen_1023", "기 쁘 지&않 나 요 ?/%%");
ds_map_add(global.text_data_en, "obj_storybattle_gen_1047", "당 신 도  자 유 의&몸 이  될  겁 니 다 ./%%");
ds_map_add(global.text_data_en, "obj_storybattle_gen_1073", "\E0반 가 워 ^1, \[차]!/");
ds_map_add(global.text_data_en, "obj_storybattle_gen_1074", "드 디 어  집 까 지&왔 구 나 ./");
ds_map_add(global.text_data_en, "obj_storybattle_gen_1075", "\E0여 기 서  같 이&놀 던  거  기 억  나 ?/");
ds_map_add(global.text_data_en, "obj_storybattle_gen_1076", "\E0히  히  힛 .../");
ds_map_add(global.text_data_en, "obj_storybattle_gen_1077", "신 난 다 !/");
ds_map_add(global.text_data_en, "obj_storybattle_gen_1078", "\E9오 늘 은  그 때 처 럼&재 밌 을  거 야 ./%%");
ds_map_add(global.text_data_en, "obj_storybattle_gen_1093", "\E1난  내 가  정 원 에 서&깨 어 났 던  순 간 을 ^1,&기 억 하 고  있 어 ./");
ds_map_add(global.text_data_en, "obj_storybattle_gen_1094", "진 짜  무 서 웠 지 ./");
ds_map_add(global.text_data_en, "obj_storybattle_gen_1095", "\E2내  팔 이 나  다 리 를&느 낄  수  없 었 어 .../");
ds_map_add(global.text_data_en, "obj_storybattle_gen_1096", "\E1내  몸 뚱 이&전 부 가  꽃 으 로&변 했 던  거 야 !/");
ds_map_add(global.text_data_en, "obj_storybattle_gen_1097", '\E5"엄 마 ^1! 아 빠 ^1!&좀  도 와 주 세 요 ^1!"&그 렇 게 나  소 리 쳤 는 데 도 ./');
ds_map_add(global.text_data_en, "obj_storybattle_gen_1098", "\E9하 지 만&아 무 도  오 지&않 았 어 ./%%");
ds_map_add(global.text_data_en, "obj_storybattle_gen_1107", "\E1그 러 다 ^1, 정 원 에 서&울 고  있 는  나 를 ^1,&왕 이  발 견 했 어 ./");
ds_map_add(global.text_data_en, "obj_storybattle_gen_1108", "나 는  놈 에 게  무 슨  일 이&일 어 났 는 지  설 명 했 지 ./");
ds_map_add(global.text_data_en, "obj_storybattle_gen_1109", "그 러 자  놈 은&나 를  잡 았 어 ^1,&\[차]./");
ds_map_add(global.text_data_en, "obj_storybattle_gen_1110", "날  잡 은  상 태 로 ^1,&눈 가 를  적 시 며&말 했 지 .../");
ds_map_add(global.text_data_en, "obj_storybattle_gen_1111", "자 ^1, 자 ^1.&다  괜 찮 아 질  거 란 다 ./");
ds_map_add(global.text_data_en, "obj_storybattle_gen_1112", "놈 은  엄 청 ..^1.&감 정 적 이 었 어 ./");
ds_map_add(global.text_data_en, "obj_storybattle_gen_1113", "\E1하 지 만 ..^1.&무 슨  이 유 에 선 지 .../");
ds_map_add(global.text_data_en, "obj_storybattle_gen_1114", "\E1난  아 무 것 도&느 낄  수 가  없 었 어 ./%%");
ds_map_add(global.text_data_en, "obj_storybattle_gen_1123", "\E1곧  내 가  어 떤  사 람 을&생 각 하 더 라 도  아 무 것 도&느 낄  수  없 다 는  걸&알 게  됐 지 ./");
ds_map_add(global.text_data_en, "obj_storybattle_gen_1124", "내  동 정 심 이&사 라 진  거 야 !/");
ds_map_add(global.text_data_en, "obj_storybattle_gen_1125", "\E7그 리 고&믿 기  힘 들 겠 지 만 ^1,&되 찾 으 려 고  노 력 하 지&않 은  것 도  아 냐 ./");
ds_map_add(global.text_data_en, "obj_storybattle_gen_1126", "\E3뭔 가  느 낄  수  있 길&바 라 며  그  멍 청 한  왕 과 ^1,&몇  주 를  헛 되 이&보 냈 지 ./");
ds_map_add(global.text_data_en, "obj_storybattle_gen_1127", "\E1하 지 만  그 건  내 겐&너 무 나  벅 찬  일 이&돼  버 렸 어 ./");
ds_map_add(global.text_data_en, "obj_storybattle_gen_1128", "난  집 에 서  도 망 쳤 어 ./");
ds_map_add(global.text_data_en, "obj_storybattle_gen_1129", "그 러 다 가 ^1, 폐 허 에&도 착 했 지 ./");
ds_map_add(global.text_data_en, "obj_storybattle_gen_1130", "\E0안 에 서  그  여 자 를&찾 았 어 ^1, \[차]./");
ds_map_add(global.text_data_en, "obj_storybattle_gen_1131", "누 구 보 다 도&그  여 자 라 면 ^1,&내  감 정 을  다 시  느 끼 게&해  줄  것  같 았 거 든 ./");
ds_map_add(global.text_data_en, "obj_storybattle_gen_1132", "\E1.../");
ds_map_add(global.text_data_en, "obj_storybattle_gen_1133", "\E7그 리 고  실 패 했 어 ./");
ds_map_add(global.text_data_en, "obj_storybattle_gen_1134", "\E6하  하 .../%%");
ds_map_add(global.text_data_en, "obj_storybattle_gen_1144", "\E1그  둘 은  쓸 모 가&없 다 는  걸  깨 달 았 지 ./");
ds_map_add(global.text_data_en, "obj_storybattle_gen_1145", "난  낙 담 했 어 ./");
ds_map_add(global.text_data_en, "obj_storybattle_gen_1146", "그 저  누 군 가 를&사 랑 하 고  싶 었 는 데 ./");
ds_map_add(global.text_data_en, "obj_storybattle_gen_1147", "그 저  누 군 가 를&신 경 써 주 고  싶 었 다 고 ./");
ds_map_add(global.text_data_en, "obj_storybattle_gen_1148", "\[차]^1, 아 마  믿 기 지&않 겠 지 만 ..../");
ds_map_add(global.text_data_en, "obj_storybattle_gen_1149", "\E2난  결 심 했 었 어 ..^1.&더  이 상  난  살  가 치 가&없 다 고 ./");
ds_map_add(global.text_data_en, "obj_storybattle_gen_1150", "\E7사 랑 이  없 는  세 계 에 선 ./");
ds_map_add(global.text_data_en, "obj_storybattle_gen_1151", "\E6네 가  없 는  세 계 에 선 ./");
ds_map_add(global.text_data_en, "obj_storybattle_gen_1152", "\E1그 래 서 .../");
ds_map_add(global.text_data_en, "obj_storybattle_gen_1153", "\E0난  네  뒤 를&따 라 가 기 로  했 었 어 ./");
ds_map_add(global.text_data_en, "obj_storybattle_gen_1154", "\E1내  존 재 를  지 우 려  했 지 ./");
ds_map_add(global.text_data_en, "obj_storybattle_gen_1155", "\E1그 리 고  그 거  알 아 ?/");
ds_map_add(global.text_data_en, "obj_storybattle_gen_1156", "\E0성 공 했 었 어 ./%%");
ds_map_add(global.text_data_en, "obj_storybattle_gen_1165", "\E1하 지 만  내 가  이  육 신 을&떠 나  보 니 까 .../");
ds_map_add(global.text_data_en, "obj_storybattle_gen_1166", "걱 정 이  되 기  시 작 했 어 ./");
ds_map_add(global.text_data_en, "obj_storybattle_gen_1167", '\E9만 약  "영 혼 "이&없 어 진 다 면 ^1,&무 슨  일 이 ...?/');
ds_map_add(global.text_data_en, "obj_storybattle_gen_1168", "\E1내  안 의  어 떤  본 능 이&안 에 서 부 터  타 오 르 기&시 작 했 어 ./");
ds_map_add(global.text_data_en, "obj_storybattle_gen_1169", '"아 냐 ^1," 난  생 각 했 지 ^1.&"난  죽 고  싶 지  않 아 !"/');
ds_map_add(global.text_data_en, "obj_storybattle_gen_1170", ".../");
ds_map_add(global.text_data_en, "obj_storybattle_gen_1171", "그 리 고  깨 어 났 어 ./");
ds_map_add(global.text_data_en, "obj_storybattle_gen_1172", "마 치  모 든  게&나 쁜  꿈 이 었 던  것&같 았 지 ./");
ds_map_add(global.text_data_en, "obj_storybattle_gen_1173", "나 는  정 원 으 로&돌 아 왔 어 ./");
ds_map_add(global.text_data_en, "obj_storybattle_gen_1174", '\E0나 의&"세 이 브  포 인 트 "로&돌 아 왔 지 ./%%');
ds_map_add(global.text_data_en, "obj_storybattle_gen_1183", "흥 미 로 워 서 ^1, 실 험 을&하 나  해  보 기 로&했 어 ./");
ds_map_add(global.text_data_en, "obj_storybattle_gen_1184", "계 속 , 계 속 해 서 ^1, 나 는&내  자 신 을  죽 음 의&문 턱 까 지  몰 아 붙 였 어 ./");
ds_map_add(global.text_data_en, "obj_storybattle_gen_1185", "언 제 라 도 , 이  세 계 에 서&나  자 신 을  지 워 버 릴  수&있 었 겠 지 ./");
ds_map_add(global.text_data_en, "obj_storybattle_gen_1186", "하 지 만  내 게  살 고 자&하 는  결 의 가  있 는&한 .../");
ds_map_add(global.text_data_en, "obj_storybattle_gen_1187", "\E0난  돌 아 올  수  있 었 어 ./");
ds_map_add(global.text_data_en, "obj_storybattle_gen_1188", "\E6놀 랍 지 ^1, 안  그 래 ^1,&\[차]?/");
ds_map_add(global.text_data_en, "obj_storybattle_gen_1189", "\E0나  역 시 도 ^1 놀 랐 어 ./%%");
ds_map_add(global.text_data_en, "obj_storybattle_gen_1197", "\E1처 음 엔 ^1, 내  힘 을  선 한&일 에  사 용 했 지 ./");
ds_map_add(global.text_data_en, "obj_storybattle_gen_1198", '\E0나 는  모 두 와  "친 구 "가&되 었 어 ./');
ds_map_add(global.text_data_en, "obj_storybattle_gen_1199", "친 구 들 의  모 든  문 제 를&완 벽 히  해 결 해 줬 지 ./");
ds_map_add(global.text_data_en, "obj_storybattle_gen_1200", "함 께  동 료 로  지 내 는  건&즐 거 웠 어 .../");
ds_map_add(global.text_data_en, "obj_storybattle_gen_1201", "\E1잠 깐  동 안 이 긴  했 지 만 ./");
ds_map_add(global.text_data_en, "obj_storybattle_gen_1202", "\E1계 속  반 복 되 자 ^1,&사 람 들 이  뻔 하 고&지 루 해 져  버 리 더 군 ./");
ds_map_add(global.text_data_en, "obj_storybattle_gen_1203", "그 놈 들 에 게&이 걸  주 면&뭐 라 고  할 까 ?/");
ds_map_add(global.text_data_en, "obj_storybattle_gen_1204", "그 놈 들 에 게&이 런  말 을  하 면&무 슨  행 동 을  할 까 ?/");
ds_map_add(global.text_data_en, "obj_storybattle_gen_1205", "답 을  알 게  된 다 면 ^1,&그 걸 로  된  거 야 ./");
ds_map_add(global.text_data_en, "obj_storybattle_gen_1206", "그 게  전 부 였 어 ./%%");
ds_map_add(global.text_data_en, "obj_storybattle_gen_1217", "\E1모 든  것 은&내  호 기 심 으 로 부 터&시 작 됐 어 ./");
ds_map_add(global.text_data_en, "obj_storybattle_gen_1218", "\E0내 가  그 들 을  죽 이 면&어 떤  일 이  일 어 날 지&궁 금 했 지 ./");
ds_map_add(global.text_data_en, "obj_storybattle_gen_1219", '\E2내  스 스 로 에 게^1, 이 렇 게&말 했 어 . "이 러 고  싶 진&않 지 만 ,"/');
ds_map_add(global.text_data_en, "obj_storybattle_gen_1220", "\E1무 슨  일 이  일 어 나 는 지&알 아 야  하 니 까  하 는  것&뿐 이 야 . 라 고 ./");
ds_map_add(global.text_data_en, "obj_storybattle_gen_1221", "\E8하  하  하 ..^1.&웃 기 지 도  않 는&변 명 이 지 !/");
ds_map_add(global.text_data_en, "obj_storybattle_gen_1222", "\E9세 상  모 든  사 람 들 이&이 런  생 각 이  얼 마 나&나 쁜  생 각 인 지&알 아 야  해 ./");
ds_map_add(global.text_data_en, "obj_storybattle_gen_1223", "\E8적 어 도  우 리 는&구 석 에  서 서  그 걸&지 켜 만  보 는  변 태 들&보 단  낫 지 만 .../");
ds_map_add(global.text_data_en, "obj_storybattle_gen_1224", "\E9그 런  한 심 한  놈 들 은&보 고  싶 어 하 긴  해 도 ^1,&겁 쟁 이 라 서  직 접&해  보 지 도  못 하 잖 아 ./");
ds_map_add(global.text_data_en, "obj_storybattle_gen_1225", "\E0아 마  그 놈 들 은&지 금 도  우 리 를  보 고&있 겠 지 ^1, 안  그 래 ...?/%%");
ds_map_add(global.text_data_en, "obj_storybattle_gen_1235", "\E1이 젠 ^1, 그 런  것 마 저&재 미 없 어 ./");
ds_map_add(global.text_data_en, "obj_storybattle_gen_1236", "\E7너 라 면  이 해 할  거 야 ^1,&\[차]./");
ds_map_add(global.text_data_en, "obj_storybattle_gen_1237", "\E6난  이  세 상 에 서&할  수  있 는  일 들 은&싸 그 리  해  봤 어 ./");
ds_map_add(global.text_data_en, "obj_storybattle_gen_1238", "\E1모 든  책 을  읽 고 ^1.&모 든  책 을&불 태 워  봤 어 ./");
ds_map_add(global.text_data_en, "obj_storybattle_gen_1239", "모 든  게 임 에 서  이 기 고 ^1.&모 든  게 임 에 서  져  봤 어 ./");
ds_map_add(global.text_data_en, "obj_storybattle_gen_1240", "모 든  사 람 들 을&도 와  주 고 ^1. 모 든&사 람 들 을  죽 여  봤 어 ./");
ds_map_add(global.text_data_en, "obj_storybattle_gen_1241", "정 해 진  수 ..^1.&대 사  한  줄 ..^1.&전 부  다  본  거 야 /");
ds_map_add(global.text_data_en, "obj_storybattle_gen_1242", "\E1하 지 만  너 ..^1.&넌  달 라 ./");
ds_map_add(global.text_data_en, "obj_storybattle_gen_1243", "\E0너 에  대 해 선&예 측 할  수 가  없 어 ^1,&\[차]./%%");
ds_map_add(global.text_data_en, "obj_storybattle_gen_1252", "\E1폐 허 에 서  널  봤 을  때 ^1,&널  못  알 아 봤 어 ./");
ds_map_add(global.text_data_en, "obj_storybattle_gen_1253", "\E8널  겁 준  다 음 ^1,&영 혼 을  빼 앗 을&생 각 이 었 는 데 ./");
ds_map_add(global.text_data_en, "obj_storybattle_gen_1254", "\E1실 패 했 지 ./");
ds_map_add(global.text_data_en, "obj_storybattle_gen_1255", "\E0그 리 고&내  세 이 브  파 일 을&불 러 오 려  했 는 데 .../");
ds_map_add(global.text_data_en, "obj_storybattle_gen_1256", "\E1아 무  일 도  일 어 나 지&않 았 어 ./");
ds_map_add(global.text_data_en, "obj_storybattle_gen_1257", "\E9\[차]..^1.&네  결 의  때 문 에 !/");
ds_map_add(global.text_data_en, "obj_storybattle_gen_1258", "\E8왜  그 런 진  모 르 겠 지 만 ^1,&나 보 다  훨 씬  강 력 해 !/%%");
ds_map_add(global.text_data_en, "obj_storybattle_gen_1267", "\E1너 에 게  한  가 지&질 문 이  있 어 ^1,&\[차]./");
ds_map_add(global.text_data_en, "obj_storybattle_gen_1268", "여 기 에 서  폐 허 로&어 떻 게  돌 아 갔 던&거 야 ...?/");
ds_map_add(global.text_data_en, "obj_storybattle_gen_1269", "\E0...잠 깐 ^1, 알 겠 다 ./");
ds_map_add(global.text_data_en, "obj_storybattle_gen_1270", "그  여 자 가  떠 날  때&너 를  데 려 갔 었 구 나 ./");
ds_map_add(global.text_data_en, "obj_storybattle_gen_1271", "\E1너 에 게  장 례 식 을&치 러 주 리 라 ^1,&결 심 했 었 나  보 지 ./");
ds_map_add(global.text_data_en, "obj_storybattle_gen_1272", "\E0...영 원 히  지 하 에 서&시 간 을  보 내 는&것 보 단  낫 잖 아 ./");
ds_map_add(global.text_data_en, "obj_storybattle_gen_1273", "\E1...하 지 만 ^1, 그 러 면&왜 ...?/");
ds_map_add(global.text_data_en, "obj_storybattle_gen_1274", "무 엇 이  너 를  깨 웠 지 ?/");
ds_map_add(global.text_data_en, "obj_storybattle_gen_1275", "\E6내 가  널  부 르 는&소 리 를  들 었 어 ...?/%%");
ds_map_add(global.text_data_en, "obj_storybattle_gen_1286", "\E1이 젠  아 무&상 관 없 지 만 ./");
ds_map_add(global.text_data_en, "obj_storybattle_gen_1287", "\E1난  이 제  질 렸 어 ^1,&\[차]./");
ds_map_add(global.text_data_en, "obj_storybattle_gen_1288", "이  모 든  이 들 에 게&질 렸 어 ./");
ds_map_add(global.text_data_en, "obj_storybattle_gen_1289", "이  모 든  장 소 에 도&질 렸 어 ./");
ds_map_add(global.text_data_en, "obj_storybattle_gen_1290", "꽃 으 로  지 내 는  데 에 도&질 렸 어 ./");
ds_map_add(global.text_data_en, "obj_storybattle_gen_1291", "\[차]./");
ds_map_add(global.text_data_en, "obj_storybattle_gen_1292", "\E0내 가  하 고  싶 은  일 이&딱  하 나  남 았 어 ./");
ds_map_add(global.text_data_en, "obj_storybattle_gen_1293", "우 리 가  시 작 한  걸&끝 내 자 ./");
ds_map_add(global.text_data_en, "obj_storybattle_gen_1294", "모 두 를  자 유 롭 게  하 자 ./");
ds_map_add(global.text_data_en, "obj_storybattle_gen_1295", "\E8그 리 고 ..^1. 진 정 한&인 간 다 움 이  뭔 지&보 여 주 는  거 야 !/");
ds_map_add(global.text_data_en, "obj_storybattle_gen_1296", "\E6그  모 든  일 에 도&불 구 하 고 ..../");
ds_map_add(global.text_data_en, "obj_storybattle_gen_1297", '\E9이  세 계 는  여 전 히&"죽 이 거 나  죽 거 나 "&잖 아 !!/%%');
ds_map_add(global.text_data_en, "obj_storybattle_gen_1307", "\E1그 러 고  나 선 ...?/");
ds_map_add(global.text_data_en, "obj_storybattle_gen_1308", "\E7뭐 ^1, 사 실 은  말 야 .../");
ds_map_add(global.text_data_en, "obj_storybattle_gen_1309", "\E9이  힘 을  다 방 면 으 로&굴 려 봤 지 ./");
ds_map_add(global.text_data_en, "obj_storybattle_gen_1310", "\E8히  히  힛 .../");
ds_map_add(global.text_data_en, "obj_storybattle_gen_1311", "\E1.../");
ds_map_add(global.text_data_en, "obj_storybattle_gen_1312", "\E1하 지 만  널  보 니&마 음 이  변 했 어 ./");
ds_map_add(global.text_data_en, "obj_storybattle_gen_1313", "\E6\[차]..^1.&너 와  함 께 라 면 .../");
ds_map_add(global.text_data_en, "obj_storybattle_gen_1314", "\E7지 상 에 서  사 는  것 도&나 쁘 진  않 아  보 여 ./%%");
ds_map_add(global.text_data_en, "obj_storybattle_gen_1324", "\E0이 번 엔  밖 으 로  나 가 서&잡 아 올  필 요 가  없 어 ./");
ds_map_add(global.text_data_en, "obj_storybattle_gen_1325", "왕 이  벌 써  6개 를&어 딘 가 에&감 춰  놓 았 거 든 ./");
ds_map_add(global.text_data_en, "obj_storybattle_gen_1326", "\E1내 가  수 백 번 은&시 도 해 서  보 여 주 게 끔&해  봤 는 데 ./");
ds_map_add(global.text_data_en, "obj_storybattle_gen_1327", "\E3그 래 도  안  보 여 주 더 라 ./");
ds_map_add(global.text_data_en, "obj_storybattle_gen_1328", "\E1\[차].../");
ds_map_add(global.text_data_en, "obj_storybattle_gen_1329", "\E0아 마  네 게 는  보 여 줄&걸 ./%%");
ds_map_add(global.text_data_en, "obj_storybattle_gen_1339", "\E0왜  내 가  이 런 걸&너 한 테  말 하 냐 고 ?/");
ds_map_add(global.text_data_en, "obj_storybattle_gen_1340", "\E6\[차]^1, 내 가  전 에 도&말 했 겠 지 만 ./");
ds_map_add(global.text_data_en, "obj_storybattle_gen_1341", "\E1어 느 때 나  내 내 .../");
ds_map_add(global.text_data_en, "obj_storybattle_gen_1342", "\E0넌  여 전 히  날&이 해 할  수  있 는&유 일 한  친 구 야 ./");
ds_map_add(global.text_data_en, "obj_storybattle_gen_1343", "\E8나 한 테  쓸 모 없 는&동 정 따 윈  주 지 도&않 잖 아 !/%%");
ds_map_add(global.text_data_en, "obj_storybattle_gen_1353", "\E9우 리  같 은  피 조 물 은 .../");
ds_map_add(global.text_data_en, "obj_storybattle_gen_1354", "\E0서 로 의  길 을&막 아 섰 을  때&주 저 하 지  않 고&서 로 를  죽 이 지 ./");
ds_map_add(global.text_data_en, "obj_storybattle_gen_1355", "\E0그 러 니 까  그 건 .../");
ds_map_add(global.text_data_en, "obj_storybattle_gen_1356", "\E1그 건 ..^1.&바 로 .../%%");
ds_map_add(global.text_data_en, "obj_storybattle_gen_1383", "\E2.../");
ds_map_add(global.text_data_en, "obj_storybattle_gen_1384", "\E2...하 ..^1.&하 .../");
ds_map_add(global.text_data_en, "obj_storybattle_gen_1385", "\E6...이 건  뭐 지 ..^1.&... 이  느 낌 은 ?/");
ds_map_add(global.text_data_en, "obj_storybattle_gen_1386", "내 가  왜 ..^1.&떨 고  있 지 ?/");
ds_map_add(global.text_data_en, "obj_storybattle_gen_1387", ".../");
ds_map_add(global.text_data_en, "obj_storybattle_gen_1388", "저 기 ..^1. \[차]..^1.&예 전  일 에  관 해 선&서 로  악 감 정&없 는  거 지 , 그 치 ?/");
ds_map_add(global.text_data_en, "obj_storybattle_gen_1389", ".../");
ds_map_add(global.text_data_en, "obj_storybattle_gen_1390", "\E4너 -너 ^1, 뭘&하 는  거 야 !?/");
ds_map_add(global.text_data_en, "obj_storybattle_gen_1391", "무 ..^1.물 러 서 !!/%%");
ds_map_add(global.text_data_en, "obj_storybattle_gen_1412", "새 ..^1.생 각 이&바 뀌 었 어 ./");
ds_map_add(global.text_data_en, "obj_storybattle_gen_1413", "더  이 상  좋 은  생 각 이&아 닌  것  같 아 ./");
ds_map_add(global.text_data_en, "obj_storybattle_gen_1414", "도 -돌 아 가 는  게&좋 을  거 야 ^1,&\[차]./");
ds_map_add(global.text_data_en, "obj_storybattle_gen_1415", "\E0지 금  여 기 라 면&충 분 히  돌 아 갈  수&있 다 고 !/");
ds_map_add(global.text_data_en, "obj_storybattle_gen_1416", ".../");
ds_map_add(global.text_data_en, "obj_storybattle_gen_1417", "\E4그 -그 -그 런  무 서 운&표 정  짓 지  마 !/");
ds_map_add(global.text_data_en, "obj_storybattle_gen_1418", "하 나 도  재 미  없 다 고 !/");
ds_map_add(global.text_data_en, "obj_storybattle_gen_1419", "유 머  감 각  진 짜&이 상 하 네 !/%%");
