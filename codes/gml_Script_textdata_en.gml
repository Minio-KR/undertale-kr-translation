ds_map_add(global.text_data_en, "obj_endogeny_360", "* 융 합 체 는  당 신 을  골 똘 히&  바 라 보 고  있 다 .");
ds_map_add(global.text_data_en, "obj_endogeny_361", "* 융 합 체 는  당 신 의  명 령 을&  기 다 리 고  있 다 .");
ds_map_add(global.text_data_en, "obj_endogeny_362", "* 여 러  마 리 의  개&  냄 새 가  난 다 .");
ds_map_add(global.text_data_en, "obj_endogeny_363", "* 융 합 체 는  둥 둥  떠 서&  가 까 이  다 가 와 ^1, 구 애 를  한 다 .");
ds_map_add(global.text_data_en, "obj_endogeny_366", "* 융 합 체 는  벽 을&  발 톱 으 로  내 려 친 다 .");
ds_map_add(global.text_data_en, "obj_endogeny_367", "* 융 합 체 는  몸 을  떨 며  구 애 한 다 .");
ds_map_add(global.text_data_en, "obj_endogeny_368", "* 융 합 체 는  더  강 렬 하 게&  떨 고  있 다 .");
ds_map_add(global.text_data_en, "obj_endogeny_369", "* 엔 도 제 니 는  만 족 했 다 .");
ds_map_add(global.text_data_en, "obj_endogeny_370", "* 괴 물 은  낮 은  HP를&  가 지 고  있 다 .");
ds_map_add(global.text_data_en, "obj_endogeny_371", "* 엔 도 제 니 는  만 족 했 다 .");
ds_map_add(global.text_data_en, "obj_endogeny_403", "* 융 합 체  - 이 걸  몇  마 리 의&  개 로  쳐  줘 야  할 지&  모 르 겠 다 ./^");
ds_map_add(global.text_data_en, "obj_endogeny_404", "* 엔 도 제 니  - 이 걸  몇  마 리 의&  개 로  쳐  줘 야  할 지&  모 르 겠 다 ./^");
ds_map_add(global.text_data_en, "obj_endogeny_416", "* 융 합 체 의  더 듬 이 가&  빠 르 게  회 전 한 다 ^1.&* 아 무  일 도  일 어 나 지  않 았 다 ./^");
ds_map_add(global.text_data_en, "obj_endogeny_420", "* 당 신 은  융 합 체 를  부 른 다 ./");
ds_map_add(global.text_data_en, "obj_endogeny_421", "* 융 합 체 는  당 신 에 게  뛰 어 와 선 ^1,&  구 멍 으 로  이 상 한  액 체 를&  흘 린 다 ./^");
ds_map_add(global.text_data_en, "obj_endogeny_435", "* 당 신 은  시 선 을  돌 리 려&  하 지 만 , 어 디 를  보 든&  괴 물 이  나 타 난 다 ./^");
ds_map_add(global.text_data_en, "obj_endogeny_446", "* 당 신 은  융 합 체 를  쓰 다 듬 는 다 ./^");
ds_map_add(global.text_data_en, "obj_endogeny_449", "* 배 를  쓰 다 듬 어 주 지 만 ^1,&  배 가  어 디 부 터  어 디 까 지 인 지&  분 명 하 지  않 다 ./^");
ds_map_add(global.text_data_en, "obj_endogeny_455", "* 당 신 은  단 호 히  쓰 다 듬 는 다 .&* 융 합 체 는  이 것 으 로&  완 전 히  만 족 한  듯 하 다 ./^");
ds_map_add(global.text_data_en, "obj_endogeny_466", "* 당 신 은  융 합 체 를  쓰 다 듬 는 다 ^1.&* 융 합 체 는  1단 계  행 복  거 품 을&  뿜 어 내 기  시 작 한 다 ./^");
ds_map_add(global.text_data_en, "obj_endogeny_475", "* 당 신 은  융 합 체 를  쓰 다 듬 으 려&  하 지 만  당 신 의  손 이&  통 과 해 버 렸 다 ./");
ds_map_add(global.text_data_en, "obj_endogeny_476", "* 아 직 은  쓰 다 듬 기 를&  원 하 지  않 는  것  같 다 ./^");
ds_map_add(global.text_data_en, "obj_endogeny_480", "* 당 신 은  융 합 체 를  쓰 다 듬 는 다 ^1.&* 융 합 체 는  빠 르 게  경 련 하 다 가 ...&  이 내  진 정 했 다 ./");
ds_map_add(global.text_data_en, "obj_endogeny_481", "* 융 합 체 는  잠 시  당 신 의&  무 릎 에  안 긴 채 로  조 용 히  쉰 다 ./");
ds_map_add(global.text_data_en, "obj_endogeny_482", "* Zzzzz.../");
ds_map_add(global.text_data_en, "obj_endogeny_483", "* 갑 자 기 ^1, 융 합 체 는  튀 어 나 가&  벽 을  사 납 게  기 어 다 닌 다 !/^");
ds_map_add(global.text_data_en, "obj_endogeny_491", "* 융 합 체 는  쓰 다 듬 기 엔&  너 무  멀 리  있 다 ^1.&* 당 신 은  허 공 을  쓰 다 듬 었 다 ./^");
ds_map_add(global.text_data_en, "obj_endogeny_500", "* 당 신 은  융 합 체 와  놀 아 준 다 ./^");
ds_map_add(global.text_data_en, "obj_endogeny_503", "* 융 합 체 는  놀 기 엔  지 쳐 있 다 ./^");
ds_map_add(global.text_data_en, "obj_endogeny_507", "* 당 신 은  무 기 를  방 의&  구 석 으 로  던 진 다 ./");
ds_map_add(global.text_data_en, "obj_endogeny_508", "* 융 합 체 가  그 걸  물 어&  가 져 다 준 다 ..^1.&  자 랑 스 레 ?/");
ds_map_add(global.text_data_en, "obj_endogeny_509", "* 당 신 은  이  과 정 을&  몇  번  반 복 한 다 ./");
ds_map_add(global.text_data_en, "obj_endogeny_510", "* 융 합 체 는  매 우  지 쳤 다 ..^1.&  흐 르 는  무 정 형 의  몸 체 가&  당 신 에 게  기 댄 다 ./^");
ds_map_add(global.text_data_en, "obj_endogeny_518", "* 아 직  놀 기 엔  충 분 히&  흥 분 하 지  않 은  듯 하 다 ...?/^");
ds_map_add(global.text_data_en, "obj_essaystuff_159", "묵 묵 부 답 이 시 네 요 ...?&누 가  당 신 을&탓 하 겠 습 니 까 ?/%%");
ds_map_add(global.text_data_en, "obj_essaystuff_160", "음 ... 간 결 하 군 요 ./%%");
ds_map_add(global.text_data_en, "obj_essaystuff_161", "아 름 답 군 요 . 가 끔 은&가 장  짧 은  말 이  가 장&명 문 이 기 도  하 죠 ./%%");
ds_map_add(global.text_data_en, "obj_essaystuff_162", "좋 아 요 . 금 상 을&드 리 도 록  하 죠 ./%%");
ds_map_add(global.text_data_en, "obj_essaystuff_163", "세 상 에 ... 정 말&멋 진  답 이 네 요 ./%%");
ds_map_add(global.text_data_en, "obj_essaystuff_164", "오 오 오 오 , 저 에  대 해&그 렇 게 나  많 이&말 해 주 시 다 니 .../");
ds_map_add(global.text_data_en, "obj_essaystuff_165", "당 신 의  열 정 에&반 했 습 니 다 ./");
ds_map_add(global.text_data_en, "obj_essaystuff_166", "...뭐 라 고&말 씀 하 신  건 지 는&이 해 를  못 했 지 만 .../%%");
ds_map_add(global.text_data_en, "obj_essaystuff_168", "아 름 답 네 요 .&책  한  권  쓰 시 는  건&어 떠 신 가 요 ?/%%");
ds_map_add(global.text_data_en, "obj_essaystuff_219", "멋 들 어 지 게&상 세 하 군 요 ... &맞 아 요 , 제 가&좀  멋 들 어 지 죠 /%%");
ds_map_add(global.text_data_en, "obj_essaystuff_220", "원 더 풀 !&끝 내 주 는 군 요 ! A+를 드 리 죠 ...&정 말  기 막 히 군 요 ./%%");
ds_map_add(global.text_data_en, "obj_essaystuff_221", "아 , 부 끄 럽 네 요 ... &당 신 이  옳 습 니 다 , &전  언 제 나&아 름 답 죠 ./%%");
ds_map_add(global.text_data_en, "obj_essaystuff_222", "세 상 에 ... 말 이&필 요  없 네 요 ... &제  아 름 다 움 을  완 벽 히&담 아 내 셨 습 니 다 ./%%");
ds_map_add(global.text_data_en, "obj_essaystuff_224", "정 확 합 니 다 .&다 리 가&정 답 이 죠 !/%%");
ds_map_add(global.text_data_en, "obj_essaystuff_225", "얼 마 나  창 의 적 인 가 .&팔 이 라 ... 대 부 분  제  다 리 에&대 해  생 각 하 는 데&말 이 죠 ./%%");
ds_map_add(global.text_data_en, "obj_essaystuff_226", "제  머 리 카 락 ... 네 ,&전  금 속  헤 어 젤 을&씁 니 다 ./%%");
ds_map_add(global.text_data_en, "obj_essaystuff_233", "네 ^1, 제  성 격&꽤  매 력 적 이 지 ^1,&않 나 요 ?/%%");
ds_map_add(global.text_data_en, "obj_essaystuff_234", "제 가  세 이 렌 의&목 소 리 를  가 졌 다 고 들&하 더 군 요 ..^1./");
ds_map_add(global.text_data_en, "obj_essaystuff_235", "... 아 우 우 우 와 !/%%");
ds_map_add(global.text_data_en, "obj_essaystuff_236", "춤 이 라 고 요 ...^1?&고 마 워 요 ^1,&전  독 학 했 어 요 ./%%");
ds_map_add(global.text_data_en, "obj_essaystuff_255", "어 라 ? 이  에 세 이 는&당 신 이  아 니 라 ,&나 를  설 명 하 는&거 라 구 요 .../%%");
ds_map_add(global.text_data_en, "obj_essaystuff_264", "감 동 적 인  고 백 이 군 요 !&팬 레 터  보 관 함 에&보 관 해  두 죠 ./%%");
ds_map_add(global.text_data_en, "obj_essaystuff_271", "토 비 ? 도 대 체&그 게  뭐 지 ?&꽤 ... 섹 시 하 게 &들 리 긴  하 네 요 ./%%");
