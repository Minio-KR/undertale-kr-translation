ds_map_add(global.text_data_en, "SCR_TEXT_5870", " ");
ds_map_add(global.text_data_en, "SCR_TEXT_5877", ".../");
ds_map_add(global.text_data_en, "SCR_TEXT_5878", "자 ^1, 그 럼  됐 네 ./%%");
ds_map_add(global.text_data_en, "SCR_TEXT_5882", "그 러 면  영 원 히&여 기 서  지 내 라 고 ./");
