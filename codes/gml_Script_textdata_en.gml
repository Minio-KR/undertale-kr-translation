ds_map_add(global.text_data_en, "obj_readable_room1_385", "* (이  퍼 즐 을  풀 면&  끝 은  열 릴  것 이 다 .)/%%");
ds_map_add(global.text_data_en, "obj_readable_room1_390", "* (이  북 쪽  방 을  지 나 면 ^1,&  끝 은  열 릴  것 이 다 .)/%%");
ds_map_add(global.text_data_en, "obj_readable_room1_395", "* (싸 울  수  없 다 .)&* (생 각 할  수 도  없 다 .)/");
ds_map_add(global.text_data_en, "obj_readable_room1_396", "* (하 지 만 ^1, 인 내 하 여  내  길 을&  나 아 갈  것 이 다 .)/%%");
ds_map_add(global.text_data_en, "obj_readable_room1_401", "* (길 을  잃 고 ...)&* (그 렇 게  안 주 한 다 .)/%%");
ds_map_add(global.text_data_en, "obj_readable_room1_406", "* (좀  쉬 면 서  간 식 이 라 도&  먹 는  건  어 때 ?)/%%");
ds_map_add(global.text_data_en, "obj_readable_room1_416", "* (완 전 히  망 가 져  버 렸 다 .)&* (고 칠  방 법 은  없 어  보 인 다 .)/%%");
