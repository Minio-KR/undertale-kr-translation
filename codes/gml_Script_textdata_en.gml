ds_map_add(global.text_data_en, "obj_friendscene_945", "이 런  맙 소 사 !/");
ds_map_add(global.text_data_en, "obj_friendscene_946", "\X그 냥  둘 이  빨 리&\R뽀 뽀\X 나  하 죠 !?/");
ds_map_add(global.text_data_en, "obj_friendscene_947", "관 객 들 이  로 맨 틱 한  걸&보 고  싶 어  죽 겠 대 요 !!/%%");
ds_map_add(global.text_data_en, "obj_friendscene_962", "야 ^1, 닥 쳐 !!!/");
ds_map_add(global.text_data_en, "obj_friendscene_963", "참  간 도 ^1, 부 었 지 !/");
ds_map_add(global.text_data_en, "obj_friendscene_964", "그 렇 지 ^1, 알 피 스 !?/");
ds_map_add(global.text_data_en, "obj_friendscene_965", ".../");
ds_map_add(global.text_data_en, "obj_friendscene_966", "어 ^1, 알 피 스 ?/%%");
ds_map_add(global.text_data_en, "obj_friendscene_982", ".../");
ds_map_add(global.text_data_en, "obj_friendscene_983", "아 니 ./");
ds_map_add(global.text_data_en, "obj_friendscene_984", "쟤 가&맞 아 ./");
