ds_map_add(global.text_data_en, "obj_friendscene_1004", "뭐 ??^1? 어 ??^1?&그 래 ??^1?&네 가  원 한 다 면 ??^1?&그 러 면 ????/");
ds_map_add(global.text_data_en, "obj_friendscene_1005", "망 설 일  것  없 지 !!!/%%");
ds_map_add(global.text_data_en, "obj_friendscene_1047", "잠 깐 !/");
ds_map_add(global.text_data_en, "obj_friendscene_1048", "인 간&앞 에 선&안&돼 요 !/%%");
ds_map_add(global.text_data_en, "obj_friendscene_1066", "아 아 ^1, 맞 다 ^1!&미 -미 안 해 요 ^1,&살 짝  정 도 가&지 나 쳤 네 ./%%");
ds_map_add(global.text_data_en, "obj_friendscene_1082", "히  히  히 ./");
ds_map_add(global.text_data_en, "obj_friendscene_1083", "아 가 야 ^1, 이 곳 에&꽤  오 래  있 었 던&것  같 구 나 ./");
ds_map_add(global.text_data_en, "obj_friendscene_1084", "\E6근 데  네 가  사 귄&멋 진  친 구 들 을&보 니 .../");
ds_map_add(global.text_data_en, "obj_friendscene_1085", "\E0네 가 .../");
ds_map_add(global.text_data_en, "obj_friendscene_1086", "\E7네 가  여 기 서&계 속  있 어 도&행 복 할  것  같 아 ./%%");
ds_map_add(global.text_data_en, "obj_friendscene_1108", "으 -음 ^1, 그 러 고&보 니 까 ./");
ds_map_add(global.text_data_en, "obj_friendscene_1109", "파 피 루 스 ..^1.&네 가  여 기&모 두 에 게 ^1,&연 락 한  거 지 ?/");
ds_map_add(global.text_data_en, "obj_friendscene_1110", "그 ^1, 토 리 엘  님 은 ^1,&음 ^1, 빼 고  말 이 야 ./");
ds_map_add(global.text_data_en, "obj_friendscene_1111", "음 ^1, 아 무 튼 ..^1.&내 가  너 보 다  먼 저&여 기  왔 는 데 .../");
ds_map_add(global.text_data_en, "obj_friendscene_1112", "어 떻 게&모 두 한 테&연 락 한  거 야 ?/%%");
ds_map_add(global.text_data_en, "obj_friendscene_1122", "그냥&이&모든 걸&.../%%");
ds_map_add(global.text_data_en, "obj_friendscene_1132", "작은 꽃이&도왔다고&해 두지./%%");
ds_map_add(global.text_data_en, "obj_friendscene_1146", "작 은 ..^1.&꽃 이 라 고 ?/%%");
ds_map_add(global.text_data_en, "obj_friendscene_1194", "\E0멍 청 한  놈 들 ./");
ds_map_add(global.text_data_en, "obj_friendscene_1195", "\E2너 희 들 이  재 미  좀&보 는  동 안 .../");
ds_map_add(global.text_data_en, "obj_friendscene_1196", "\E6난  인 간 의  영 혼 들 을&손 에  넣 었 지 !/");
ds_map_add(global.text_data_en, "obj_friendscene_1197", "\E5그 리 고 ^1, 그  영 혼 뿐 만&아 니 라 .../");
ds_map_add(global.text_data_en, "obj_friendscene_1198", "\E6네  친 구 들 의&영 혼 도 ^1, 내  손 에&있 다 고 !/");
ds_map_add(global.text_data_en, "obj_friendscene_1199", "\E0히  히  히 ./");
ds_map_add(global.text_data_en, "obj_friendscene_1200", "\E1제 일  멋 진  사 실 이&뭔 지  알 아 ?/");
ds_map_add(global.text_data_en, "obj_friendscene_1201", "\E5이 게  전 부  네&잘 못 이 라 는  거 야 ./");
ds_map_add(global.text_data_en, "obj_friendscene_1202", "\E6이 들 이  널&사 랑 하 도 록&만 들 었 기  때 문 에 ./");
ds_map_add(global.text_data_en, "obj_friendscene_1203", "\E7네 가  저 들 과&보 냈 던  시 간 들 .../");
ds_map_add(global.text_data_en, "obj_friendscene_1204", "\E2용 기 를  주 고 ..^1.&애 써 줬 던  시 간 들 .../");
ds_map_add(global.text_data_en, "obj_friendscene_1205", "\E0그 것 만  없 었 으 면 ^1,&저 들 은  이 곳 에&오 지  않 았 겠 지 ./");
ds_map_add(global.text_data_en, "obj_friendscene_1206", "\E7이 제 ^1, 놈 들 의&영 혼 과  인 간 의&영 혼 이 면 .../");
ds_map_add(global.text_data_en, "obj_friendscene_1207", '\E5내  "진 짜  모 습 "으 로&돌 아 갈  수  있 어 ./');
ds_map_add(global.text_data_en, "obj_friendscene_1208", "\E0히  히 .../");
ds_map_add(global.text_data_en, "obj_friendscene_1209", "\E3뭐 ?/");
ds_map_add(global.text_data_en, "obj_friendscene_1210", "\E1왜  아 직 도&내 가  이 런  짓 을&하 냐 고 ?/");
ds_map_add(global.text_data_en, "obj_friendscene_1211", "\E7모 르 겠 어 ?/");
ds_map_add(global.text_data_en, "obj_friendscene_1212", '\E0이 건  "게 임 "이 니 까 ./');
ds_map_add(global.text_data_en, "obj_friendscene_1213", '\E3네 가  만 족 한  채 로&지 하  세 계 를  떠 난 다 면 ^1,&넌  게 임 에 서  "이 기 게 " &되 는  거 야 ./');
ds_map_add(global.text_data_en, "obj_friendscene_1214", '\E4네 가  "이 겨 버 리 면 "^1,&더  이 상  나 랑&"놀 아 주 지 " 않 을  테 니 ./');
ds_map_add(global.text_data_en, "obj_friendscene_1215", "\E0그 렇 게  되 면&나  혼 자&뭘  해 야  할 까 ?/");
ds_map_add(global.text_data_en, "obj_friendscene_1216", "\E6하 지 만  우 리  사 이 의&게 임 은  절 대 로&끝 나 지  않 을  거 야 ./");
ds_map_add(global.text_data_en, "obj_friendscene_1217", "\E5난  네 놈  앞 에 서&승 리 를  쥐 고  있 을  거 야 ^1,&닿 을 락  말 락 하 게 .../");
ds_map_add(global.text_data_en, "obj_friendscene_1218", "\E6그 리 고  네 가  잡 기&직 전 에  갈 기 갈 기&찢 어 버 릴  거 야 !!/");
ds_map_add(global.text_data_en, "obj_friendscene_1219", "\E8계 속 ^1, 또 ^1, 계 속 .../");
ds_map_add(global.text_data_en, "obj_friendscene_1220", "\E5히  히  힛 ./");
ds_map_add(global.text_data_en, "obj_friendscene_1221", "\E1이 봐 ./");
ds_map_add(global.text_data_en, "obj_friendscene_1222", '\E0만 약  네 가  날&쓰 러 뜨 린 다 면 ^1,&"해 피  엔 딩 "을&보 여  줄 게 ./');
ds_map_add(global.text_data_en, "obj_friendscene_1223", "\E7친 구 들 을&전 부  돌 려  주 고 ./");
ds_map_add(global.text_data_en, "obj_friendscene_1224", "결 계 도  부 숴  줄 게 ./");
ds_map_add(global.text_data_en, "obj_friendscene_1225", "\E0모 두 가  마 침 내&행 복 해 지 겠 지 ./");
ds_map_add(global.text_data_en, "obj_friendscene_1226", "\E6하 지 만&그 런  일 은  절 대 로&안  일 어 날  거 야 ./");
ds_map_add(global.text_data_en, "obj_friendscene_1227", "\E8너 ...!/");
ds_map_add(global.text_data_en, "obj_friendscene_1228", "\E0너 만 큼 은  내 가&어 떻 게 든  여 기&붙 잡 아 둘  거 야 !/%%");
ds_map_add(global.text_data_en, "obj_friendscene_1266", "\E0널  백 만  번 은&죽 여 야 만  한 다 고&해 도  말 이 야 !!!/%%");
ds_map_add(global.text_data_en, "obj_friendscene_1357", "뭐 야 ?/%%");
ds_map_add(global.text_data_en, "obj_friendscene_1375", "두 려 워 하 지  말 렴 ^1,&아 가 야 .../");
ds_map_add(global.text_data_en, "obj_friendscene_1376", "무 슨  일 이&일 어 나 든 .../");
ds_map_add(global.text_data_en, "obj_friendscene_1377", "우 리 가  언 제 나&네  곁 에 서&지 켜 줄  테 니 !/%%");
ds_map_add(global.text_data_en, "obj_friendscene_1434", "맞아^1,&인간^1!&넌 이길 수&있어!/");
ds_map_add(global.text_data_en, "obj_friendscene_1435", "이 몸이&할 법한^1,&일을 하면&돼.../");
ds_map_add(global.text_data_en, "obj_friendscene_1436", "자신을&믿어!!/%%");
ds_map_add(global.text_data_en, "obj_friendscene_1449", "야 ^1! 인 간 ^1!&날  이 겼 다 는  건 ^1,&뭐 든  할  수&있 다 는  뜻 이 야 !/");
ds_map_add(global.text_data_en, "obj_friendscene_1450", "그 러 니  걱 정  마 ^1!&우 린  항 상&네  편 이 니 까 !/%%");
ds_map_add(global.text_data_en, "obj_friendscene_1463", "뭐 야 ^1?&아 직 도  이 걸&못  이 긴  거 야 ?/");
ds_map_add(global.text_data_en, "obj_friendscene_1464", "잘  좀  해  봐 ^1,&이 런  괴 짜 는&너 한 테  쨉 도&안  된 다 고 ./%%");
ds_map_add(global.text_data_en, "obj_friendscene_1514", "이 론 적 으 론 ^1,&네 가  이 기 는  게&불 가 능 하 지 만 .../");
ds_map_add(global.text_data_en, "obj_friendscene_1515", "하 -하 지 만 ..^1.&왠 지  모 르 게 ^1,&넌  해 낼  수&있 을  것  같 아 !/%%");
ds_map_add(global.text_data_en, "obj_friendscene_1532", "인 간 이 여 ^1, 인 간 과&괴 물 들 의  미 래 를&위 하 여 ...!/");
ds_map_add(global.text_data_en, "obj_friendscene_1533", "결 의 를&가 져 야  한 다 ...!/%%");
ds_map_add(global.text_data_en, "obj_friendscene_1589", "으 으 으 으 ..^1.&아 니 야 !/");
ds_map_add(global.text_data_en, "obj_friendscene_1590", "말 도  안  돼 !!/");
ds_map_add(global.text_data_en, "obj_friendscene_1591", "이 럴  순&없 어 ...!/");
ds_map_add(global.text_data_en, "obj_friendscene_1592", "너 ..^1.&너 어 어 ...!/%%");
ds_map_add(global.text_data_en, "obj_friendscene_1635", "너 희 들 이  이 렇 게 나&멍 청 할  줄 이 야 ./%%");
ds_map_add(global.text_data_en, "obj_friendscene_1665", "너 희  영 혼 은&전 부  내  것 이 다 !!!/%%");
ds_map_add(global.text_data_en, "obj_froggit_30", "개 굴&개 굴 .");
ds_map_add(global.text_data_en, "obj_froggit_31", "개 골&개 골 .");
ds_map_add(global.text_data_en, "obj_froggit_32", "깡 충&깡 충 .");
ds_map_add(global.text_data_en, "obj_froggit_33", "야 옹 .");
ds_map_add(global.text_data_en, "obj_froggit_36", "(얼 굴 을&붉 히 며 )&개 굴 ...");
ds_map_add(global.text_data_en, "obj_froggit_39", "부 들&부 들 .");
ds_map_add(global.text_data_en, "obj_froggit_42", "%%%");
ds_map_add(global.text_data_en, "obj_froggit_184", "* 프 로 깃 은  왜  여 기  있 는 지&  모 르 는  것  같 다 .");
ds_map_add(global.text_data_en, "obj_froggit_185", "* 프 로 깃 은  앞 뒤 로&  폴 짝 였 다 .");
ds_map_add(global.text_data_en, "obj_froggit_186", "* 전 장 은  겨 자 씨  냄 새 로&  가 득 하 다 .");
ds_map_add(global.text_data_en, "obj_froggit_187", "* 당 신 은  프 로 깃 의&  강 력 한  힘 에  압 도 당 했 다 ^4.&* 물 론  농 담 이 다 .");
ds_map_add(global.text_data_en, "obj_froggit_188", "* 프 로 깃 은  당 신 과  싸 우 길&  주 저 하 는  것  같 다 .");
ds_map_add(global.text_data_en, "obj_froggit_189", "* 프 로 깃 은  도 망 치 려 고  한 다 .");
ds_map_add(global.text_data_en, "obj_froggit_205", "* 프 로 깃  - ATK 4 DEF 5&* 이  적 에 게  삶 은  고 단 하 다 ./^");
ds_map_add(global.text_data_en, "obj_froggit_214", "* 프 로 깃 은  당 신 이  말 한  것 을&  이 해 하 진  못 했 지 만 ^1,&  겁 을  먹 었 다 ./^");
ds_map_add(global.text_data_en, "obj_froggit_225", "* 프 로 깃 은  당 신 이  말 한  것 을&  이 해 하 진  못 했 지 만 ^1,&  기 분 이  좋 아  보 인 다 ./^");
