ds_map_add(global.text_data_en, "obj_tordogcall_84", "* 따 르 릉 ..\E1.\TT /");
ds_map_add(global.text_data_en, "obj_tordogcall_85", "\F1 %");
ds_map_add(global.text_data_en, "obj_tordogcall_86", "* 여 보 세 요 ..^1.&* 토 리 엘 이 란 다 ./");
ds_map_add(global.text_data_en, "obj_tordogcall_87", "\E1* 내 가  찾 고  있 던  걸&  찾 아 냈 단 다 ./");
ds_map_add(global.text_data_en, "obj_tordogcall_88", "* 하 지 만  가 져 가 기&  바 로  직 전 에 .../");
ds_map_add(global.text_data_en, "obj_tordogcall_89", "* 작 고 ^1, 하 얀  강 아 지 가&  그 걸  낚 아 채 곤&  사 라 져 버 렸 단 다 ./");
ds_map_add(global.text_data_en, "obj_tordogcall_90", "\E0* 이 상 하 지 ./");
ds_map_add(global.text_data_en, "obj_tordogcall_91", "\E1* 개 들 이  밀 가 루 를&  좋 아 하 던 가 ?/");
ds_map_add(global.text_data_en, "obj_tordogcall_92", "\E8* 어 , 아 무  상 관 없 는&  질 문 이 야 ^1, 물 론 ./");
ds_map_add(global.text_data_en, "obj_tordogcall_93", "\E1* 조 금  더  오 래&  걸 릴  것  같 아 .&  부 디  이 해 해  주 렴 ./");
ds_map_add(global.text_data_en, "obj_tordogcall_94", "\TS \F0 \T0 %");
