ds_map_add(global.text_data_en, "obj_alphysfollow_event_228", "* 그 러 니 까 ^1,&  음 ..^1. 나 .../");
ds_map_add(global.text_data_en, "obj_alphysfollow_event_229", "\E1* 내 가  막 ..^1.&* 음 .../");
ds_map_add(global.text_data_en, "obj_alphysfollow_event_230", "\E2* 작 별  인 사 랑 ^1,&  또 .../");
