ds_map_add(global.text_data_en, "scr_battlegroup_1580", "* 믿 겨 져 ?");
ds_map_add(global.text_data_en, "scr_battlegroup_1595", "* 파 이 널  프 로 깃 이&  뛰 어 들 어 왔 어 ...?");
ds_map_add(global.text_data_en, "scr_battlegroup_1609", "* 윔 슬 롯 과  파 스 닉 이&  나 타 났 다 .");
ds_map_add(global.text_data_en, "scr_battlegroup_1624", "* 미 고 스 펠 이  몰 데 사 를 ^1,&  데 리 고  날 아 왔 다 .");
ds_map_add(global.text_data_en, "scr_battlegroup_1639", "* 미 고 스 펠 이  파 스 닉 을 ^1,&  데 리 고  날 아 왔 다 .");
ds_map_add(global.text_data_en, "scr_battlegroup_1654", "* 파 스 닉 들 이  쉭 쉭 거 리 며&  땅 에 서  나 왔 다 !");
ds_map_add(global.text_data_en, "scr_battlegroup_1669", "* 감 자 만  눈 을&  가 진  게  아 니 군 .");
ds_map_add(global.text_data_en, "scr_battlegroup_1684", "* 눈 이  어 둠  속 에 서&  나 타 났 다 .");
ds_map_add(global.text_data_en, "scr_battlegroup_1699", "* 진 짜  파 티  같 다 .");
ds_map_add(global.text_data_en, "scr_battlegroup_1716", "* 지 옥 의  파 티 .");
ds_map_add(global.text_data_en, "scr_battlegroup_1733", "* 글 라 이 드 가  날 아 왔 다 !");
ds_map_add(global.text_data_en, "scr_battlegroup_1747", "* 당 신 은  정 중 하 게&  길 을  가 로 막 혔 다 !");
ds_map_add(global.text_data_en, "scr_battlegroup_1762", "* 마 지 막 이 다 .");
ds_map_add(global.text_data_en, "scr_battlegroup_1787", "* 아 스 리 엘 이  앞 을  막 아 섰 다 .");
ds_map_add(global.text_data_en, "scr_battlegroup_1789", "* 친 구 들 의  힘 으 로&  아 스 리 엘 의  영 혼 이&  깨 어 났 다 !");
ds_map_add(global.text_data_en, "scr_battlegroup_1791", "* 작 별  인 사 를  할  시 간 이 다 .");
ds_map_add(global.text_data_en, "obj_basicmonster_act", "* Monster does an action.");
ds_map_add(global.text_data_en, "obj_basicmonster_info", "* Smells like a monster.");
ds_map_add(global.text_data_en, "obj_basicmonster_mercy", "* 괴 물 은  만 족 한  것  같 다 .");
ds_map_add(global.text_data_en, "obj_basicmonster_lowhp", "* 괴 물 은  낮 은  HP를&  가 지 고  있 다 .");
ds_map_add(global.text_data_en, "obj_basicmonster_check", "* MONSTER - ATK \[1] DEF \[2]&* Mistakenly believes its lava&  is a monster./^");
ds_map_add(global.text_data_en, "obj_basicmonster_playeract", "* 당 신 은  약 간 의  행 동 을  취 했 다 ./^");
ds_map_add(global.text_data_en, "obj_napstablook_189", "* 이 겼 다 !&* 경 험 치 를  1 잃 었 다 ./%");
ds_map_add(global.text_data_en, "obj_torielboss_240", "* 이 겼 다 !&* 경 험 치 를  1 잃 었 다 ./%");
ds_map_add(global.text_data_en, "SCR_TEXT_2510", "* 너 ..^1.&* 너 는  다 른  곳 에 서  왔 지 ^1,&  그 렇 지 ?/");
ds_map_add(global.text_data_en, "SCR_TEXT_2511", "* 너 같 은  사 람 은&  보 기  드 물 지 .../");
ds_map_add(global.text_data_en, "SCR_TEXT_2512", "* 제 발 ^1! * 이 방 인 !/");
ds_map_add(global.text_data_en, "SCR_TEXT_2513", "* 바 깥 에  대 해  말 해 줄 래 ?& &         응           아 니 \C");
ds_map_add(global.text_data_en, "SCR_TEXT_2514", " ");
ds_map_add(global.text_data_en, "SCR_TEXT_2535", '* 응 ^1?&* "지 상 "^1?&* 무 슨  말 이 야 ?/');
ds_map_add(global.text_data_en, "SCR_TEXT_2536", "* 나 는  이  방  바 깥 을&  말 한  거 야 ./");
ds_map_add(global.text_data_en, "SCR_TEXT_2537", "* 알 아 채 지  못 했 나 본 데 ^1,&  내  곰 팡 이  때 문 에&  발 이  묶 여 버 렸 거 든 ./");
ds_map_add(global.text_data_en, "SCR_TEXT_2538", "* 제 발 ^1!&* 이 방 인 !/");
ds_map_add(global.text_data_en, "SCR_TEXT_2539", "* 본 론 만  말 할 게 ./");
ds_map_add(global.text_data_en, "SCR_TEXT_2540", "* 나 는  평 생  같 은  장 소 ^1,&  같 은  방 에 서  살 았 어 ./");
ds_map_add(global.text_data_en, "SCR_TEXT_2541", "* 하 지 만  항 상  오 른 쪽 방 에&  뭐 가  있 는 지  궁 금 했 어 ./");
ds_map_add(global.text_data_en, "SCR_TEXT_2542", "* 늘  상 상 했 지 . 저 기  들 어 가 고 ..^1.&  내  눈 앞 의  풍 경 이  변 하 는 .../");
ds_map_add(global.text_data_en, "SCR_TEXT_2543", "* 아 니 ..^1.&* 내  생 이  변 하 는  상 상 을 !/");
ds_map_add(global.text_data_en, "SCR_TEXT_2544", "* 제 발 ^1.&* 가 서  안 에  뭐 가&  있 는 지  말 해 줘 ./%%");
ds_map_add(global.text_data_en, "SCR_TEXT_2553", "* 바 깥 의  사 람 들 이&  모 두  너 같 다 고 ^1?&* 끔 찍 해 ./%%");
ds_map_add(global.text_data_en, "SCR_TEXT_2518", "* 그 럼 ^1, 뭘  꾸 물 대 고&  있 는  거 야 ?/%%");
ds_map_add(global.text_data_en, "SCR_TEXT_2522", "* 아 ^1!&* 돌 아 왔 구 나 !/");
ds_map_add(global.text_data_en, "SCR_TEXT_2523", "* 방 은  어 때 ?& &         달 라         똑 같 아 \C");
ds_map_add(global.text_data_en, "SCR_TEXT_2524", " ");
ds_map_add(global.text_data_en, "SCR_TEXT_2561", "* 오 ^1, 정 말  다 행 이 다 ^1!/");
ds_map_add(global.text_data_en, "SCR_TEXT_2562", "* 그  정 도 면  생 각 하 기&  충 분 할  것  같 군 ^1.&* 고 맙 다 ^1, 이 방 인 ./%%");
ds_map_add(global.text_data_en, "SCR_TEXT_2506", "* 머 리 가  정 말  복 잡 해 ^1!&* 이 런  기 분  정 말&  오 랜 만 이 야 .../%%");
ds_map_add(global.text_data_en, "SCR_TEXT_2567", "* 거 기 도  똑 같 다  이 거 지 ./");
ds_map_add(global.text_data_en, "SCR_TEXT_2568", "* 똑 같 구 나 .../");
ds_map_add(global.text_data_en, "SCR_TEXT_2569", "* 똑 같 아 .../");
ds_map_add(global.text_data_en, "SCR_TEXT_2570", "* .../");
ds_map_add(global.text_data_en, "SCR_TEXT_2571", "* 좋 아 ./%%");
ds_map_add(global.text_data_en, "SCR_TEXT_2507", "* 제 발  떠 나  줘 ./%%");
ds_map_add(global.text_data_en, "SCR_TEXT_2780", "* (말 을  위 한  마 구 간 이 다 .)/");
ds_map_add(global.text_data_en, "SCR_TEXT_2781", "* (안 으 로  들 어 가 겠 습 니 까 ?)& &         네           아 니 요 \C");
ds_map_add(global.text_data_en, "SCR_TEXT_2782", " ");
ds_map_add(global.text_data_en, "SCR_TEXT_2788", "* (당 신 은  문 을  밀 쳐 보 았 다 .)&* (잠 겨  있 다 .)/");
ds_map_add(global.text_data_en, "SCR_TEXT_2789", "* (갑 자 기 ^1, [검 열 삭 제 ] 안 에 서 ,&  당 신 이  들 은  것은 &/%%");
ds_map_add(global.text_data_en, "SCR_TEXT_3358", "* ('괴 물 사  제 6권 '이 라 는&  제 목 의  책 이 다 .)&         읽 는 다       안  읽 는 다 \C");
ds_map_add(global.text_data_en, "SCR_TEXT_3359", " ");
ds_map_add(global.text_data_en, "SCR_TEXT_3363", "* 공 교 롭 게 도 ^1, 괴 물 은&  질 병 에  걸 리 는  일 이  없 다 ./");
ds_map_add(global.text_data_en, "SCR_TEXT_3364", "* 그 러 나 ^1, 괴 물 은  수 명 이&  다  될  즈 음 이 면 ^1,&  쓰 러 져 서 ^1, 움 직 이 지  않 는 다 ./");
ds_map_add(global.text_data_en, "SCR_TEXT_3365", '* 우 리 는  이  상 태 를&  "쓰 러 졌 다 "라 고  부 른 다 ./');
ds_map_add(global.text_data_en, "SCR_TEXT_3366", "* '쓰 러 진 ' 이 는  곧&  소 멸 하 고  만 다 ./");
ds_map_add(global.text_data_en, "SCR_TEXT_3367", "* 어 떤 면 에 서 는 ^1, 당 황 스 런 &  이  상 황 은  우 리 에 게&  너 무 나  친 숙 하 다 ./%%");
ds_map_add(global.text_data_en, "SCR_TEXT_3370", "* (당 신 은  읽 지  않 기 로  했 다 .)/%%");
ds_map_add(global.text_data_en, "SCR_TEXT_4551", "* \YMETTATON님 이&  철 천 지 원 수  요 청&  메 시 지 를  보 냈 습 니 다 .\W /");
ds_map_add(global.text_data_en, "SCR_TEXT_4552", "* 요 청 을  받 아 들 입 니 까 ?& &         예           아 니 요 \C");
ds_map_add(global.text_data_en, "SCR_TEXT_4553", " ");
ds_map_add(global.text_data_en, "SCR_TEXT_4559", "* 축 하 합 니 다 ^1!&* 당 신 은  이 제  메 타 톤 과&  철 천 지 원 수 가  되 셨 습 니 다 ./");
ds_map_add(global.text_data_en, "SCR_TEXT_4560", "* \YCOOLSKELETON95\W님 이  소 식 에&  댓 글 을  달 았 습 니 다 ./");
ds_map_add(global.text_data_en, "SCR_TEXT_4561", "* 둘 다 ^1, 축 하 해 ^1! 부 디  오 랫 동 안&  끔 찍 한  라 이 벌  관 계 로&  지 내 길  바 라 ./%%");
ds_map_add(global.text_data_en, "SCR_TEXT_4565", "* 당 신 은  요 청 을  거 절 했 다 ./%%");
ds_map_add(global.text_data_en, "SCR_TEXT_4571", '* \YMETTATON이  "죽 음 "으 로 의&  초 대 장 을  보 냈 습 니 다 . \W /');
ds_map_add(global.text_data_en, "SCR_TEXT_4572", "* 응 답 합 니 까 ?& &         응 답         무 시\C");
ds_map_add(global.text_data_en, "SCR_TEXT_4573", " ");
ds_map_add(global.text_data_en, "SCR_TEXT_4579", "* 거 시 기  골 짜 기  그 래 놀 라  바/%%");
ds_map_add(global.text_data_en, "SCR_TEXT_4583", "* 거 시 기  골 짜 기  그 래 놀 라  바/%%");
