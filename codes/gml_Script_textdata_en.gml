ds_map_add(global.text_data_en, "obj_gyftrot_544", '* 당 신 은  "난  걸 을  때&  이  지 팡 이 를  써 "라  쓰 여 있 는&  줄 무 늬  지 팡 이 를  치 워 줬 다 ./^');
ds_map_add(global.text_data_en, "obj_gyftrot_545", "* 당 신 은  개 랑 은  무 관 한&  건 포 도  상 자 를  떼 어  줬 다 ./^");
ds_map_add(global.text_data_en, "obj_gyftrot_546", "* 당 신 은  윙 크 하 는  소 년 이&  그 려 진  렌 즈  모 양&  책 갈 피 를  떼 어  줬 다 ./^");
ds_map_add(global.text_data_en, "obj_gyftrot_547", "* 당 신 은  담 배  파 이 프&  청 소  도 구 로  만 든&  가 시 철 사 를  떼 어  줬 다 ./^");
ds_map_add(global.text_data_en, "obj_gyftrot_548", "* 당 신 은  스 노 우 드 레 이 크 가&  어 릴  적 에  부 모 님 과&  찍 은  사 진 을  떼 어  줬 다 ./^");
