ds_map_add(global.text_data_en, "SCR_TEXT_4165", " %%");
ds_map_add(global.text_data_en, "SCR_TEXT_4170", "\M5* 이  개 ..^1.&* 아 직 도  있 네 요 !/");
ds_map_add(global.text_data_en, "SCR_TEXT_4171", "* 이  소 재 ..^1.&* 점 점  쓸 만 해 지 고  있 군 요 !/");
ds_map_add(global.text_data_en, "SCR_TEXT_4172", "\M2* (이 것 을  보 고 합 니 까 ?)& &         보 고 한 다     아 직 \C");
ds_map_add(global.text_data_en, "SCR_TEXT_4173", " ");
ds_map_add(global.text_data_en, "SCR_TEXT_4179", " %%");
ds_map_add(global.text_data_en, "SCR_TEXT_4185", " %%");
ds_map_add(global.text_data_en, "SCR_TEXT_4191", "\M5* 아 , 이 런 !!!/");
ds_map_add(global.text_data_en, "SCR_TEXT_4192", "\M2* ...정 말  별  볼  일&  없 는  물 컵 이 군 요 ./");
ds_map_add(global.text_data_en, "SCR_TEXT_4193", "\M4* 하 지 만  잘  포 장 한 다 면&  좋 은  기 삿 거 리 가&  될  수  있 습 니 다 !/");
ds_map_add(global.text_data_en, "SCR_TEXT_4194", "\M2* (이 것 을  보 고 합 니 까 ?)& &         보 고 한 다     아 직 \C");
ds_map_add(global.text_data_en, "SCR_TEXT_4195", " ");
