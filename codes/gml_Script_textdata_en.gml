ds_map_add(global.text_data_en, "obj_adate_1149", "\E3그 ..그 치 만 ^1,&좀  잘 하 는 걸 .../");
ds_map_add(global.text_data_en, "obj_adate_1150", "\E3그 -그 -그 -네 가  그 -&데 이 트  하 는  비 디 오&게 임 에 서  배 워 서 .../");
ds_map_add(global.text_data_en, "obj_adate_1151", "난 ..^1.&난 ... 너 ..너 ..너 한 테&키 스 를  하 지&아 ..않 을  수  없 는 걸 .../%%");
ds_map_add(global.text_data_en, "obj_adate_1167", "알 피 스 ^1! 나 는  널&절 대  사 랑 하 지&않 을  거 야 !/");
ds_map_add(global.text_data_en, "obj_adate_1168", "너 는  절 대  나 의&진 심 어 린  포 옹 을&느 끼 지  못 할  거 야 !!!/");
ds_map_add(global.text_data_en, "obj_adate_1169", "나 ^1, 언 다 인 은 ^1, 절 대&내  아 름 다 운  입 술 로&네 게  키 스 하 지  않 아 !!/");
ds_map_add(global.text_data_en, "obj_adate_1176", "느 아 아 아 아 !!^1!&느 아 아 아 !!/");
ds_map_add(global.text_data_en, "obj_adate_1177", "난  언 다 인 이 고  키 스 에&파 묻 혀  살 고&있 으 니 까 !!!/%%");
