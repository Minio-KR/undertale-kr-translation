ds_map_add(global.text_data_en, "obj_pyrope_270", "타 올 라 라&꼬 맹 아&타 올 라 라 !");
ds_map_add(global.text_data_en, "obj_pyrope_271", "뜨 거 워 ?&만 족 하 나 ?");
ds_map_add(global.text_data_en, "obj_pyrope_272", "열 기 를&느 껴 봐");
ds_map_add(global.text_data_en, "obj_pyrope_273", "여 기&좀&춥 지&않 아 ?");
ds_map_add(global.text_data_en, "obj_pyrope_280", "뜨 겁 게 !!&뜨 겁 게 !!&더  뜨 겁 게 !&더  더  더 !!");
ds_map_add(global.text_data_en, "obj_pyrope_285", "부 르 르 !&무 슨&일 이 야 !?");
ds_map_add(global.text_data_en, "obj_pyrope_289", "미 안 !!&나&완 전&바 빠 !!");
