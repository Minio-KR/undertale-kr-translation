ds_map_add(global.text_data_en, "obj_judgeshroom_214", "* 움 직 이 려 는  노 력 ^1.&* 빠 져 나 가 려 는  노 력 ^1.&* 하 지 만  아 아 ^1, 할  수  없 네 ./%%");
