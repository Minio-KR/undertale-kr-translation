ds_map_add(global.text_data_en, "obj_torboss_2ndtime_264", "저 기 !/");
ds_map_add(global.text_data_en, "obj_torboss_2ndtime_265", "지 금 쯤&죽 거 나  뭐&그 래 야&하 지  않 아 요 ?/%%");
ds_map_add(global.text_data_en, "obj_torboss_2ndtime_280", "뭐 ^1.&지 금  그 게&무 슨  상 관 이  있 겠 어 ?/%%");
ds_map_add(global.text_data_en, "obj_torboss_2ndtime_293", "그 래 서  대 신&뭐  할  거 예 요 ...?/%%");
ds_map_add(global.text_data_en, "obj_torboss_2ndtime_308", "흐 음 ^1.&파 이 라 도  하 나  더&구 워 야  할  것  같 네 ./");
ds_map_add(global.text_data_en, "obj_torboss_2ndtime_309", "저 번  건  살 짝&탔 었 거 든 ./%%");
ds_map_add(global.text_data_en, "obj_torboss_2ndtime_324", "\E2맛 은&괜 찮 았 는 데 요 ./");
ds_map_add(global.text_data_en, "obj_torboss_2ndtime_325", "\E1이 론 적 으 로 는 ./");
ds_map_add(global.text_data_en, "obj_torboss_2ndtime_326", "\E4여 러 분 이  싸 울  때&다  먹 어 버 렸 다 던 가&그 런  건  아 니 에 요 ./%%");
ds_map_add(global.text_data_en, "obj_torboss_2ndtime_360", "저 기 ^1! 저 기 ^1!&파 이  좀&먹 을  수&있 을 까 요 !/%%");
ds_map_add(global.text_data_en, "obj_torboss_2ndtime_377", "혼 자  다  먹 어 치 워&버 릴  거 잖 아 .../%%");
ds_map_add(global.text_data_en, "obj_torboss_2ndtime_400", "도 와 줄  수&있 어 어 어 요 !!/%%");
ds_map_add(global.text_data_en, "obj_torboss_2ndtime_415", "바 닥 에 서&코  고 는  건&도 움 이  안  돼 ./%%");
ds_map_add(global.text_data_en, "obj_torboss_2ndtime_429", "코  고 는  거  아 니 야 ^1,&꿈 속 에 서  응 원 해&주 는  거 라 고 요 !!/");
ds_map_add(global.text_data_en, "obj_torboss_2ndtime_430", ".../");
ds_map_add(global.text_data_en, "obj_torboss_2ndtime_431", "어 ^1, 아 직 도&거 기  있 어 요 ?/");
ds_map_add(global.text_data_en, "obj_torboss_2ndtime_432", "달 리  할  일 은&없 으 신 가 요 ?/%%");
ds_map_add(global.text_data_en, "obj_torboss_2ndtime_512", "\E0야 ./");
ds_map_add(global.text_data_en, "obj_torboss_2ndtime_513", "\E3뭘  그 렇 게&기 다 리 고&있 는  거 야 !?/");
ds_map_add(global.text_data_en, "obj_torboss_2ndtime_514", "\E9그 년  지 금 쯤&죽 어  있 어 야&하 는  거  아 니 야 !?/");
ds_map_add(global.text_data_en, "obj_torboss_2ndtime_515", "\E1내 가  저  방 에 서&얼 마 나&기 다 렸 는 .../");
ds_map_add(global.text_data_en, "obj_torboss_2ndtime_516", "\E6.../");
ds_map_add(global.text_data_en, "obj_torboss_2ndtime_517", "\E7...하 드  모 드 ...?/");
ds_map_add(global.text_data_en, "obj_torboss_2ndtime_518", "\E0이 런 ^1,&사 진 이 라 도&한  장  찍 어 둬 ./");
ds_map_add(global.text_data_en, "obj_torboss_2ndtime_519", '사 람 들 은  널&"진 짜 " 멋 있 는&사 람 이 라 고&생 각 하 겠 지 ./');
ds_map_add(global.text_data_en, "obj_torboss_2ndtime_520", "\E9...아 니 지 만 !/");
ds_map_add(global.text_data_en, "obj_torboss_2ndtime_521", "\E8이 런 ^1 노 력&하 고 는 ./");
ds_map_add(global.text_data_en, "obj_torboss_2ndtime_522", "한 ^1. 심 ^1. 해 ./%%");
ds_map_add(global.text_data_en, "obj_torboss_2ndtime_544", "\E0어 ^1, 그 래 서 ^1,&계 속 할  거 야 ^1,&아 님 ...?/%%");
ds_map_add(global.text_data_en, "obj_torboss_2ndtime_558", "다  끝 났 어 ./%%");
ds_map_add(global.text_data_en, "obj_torboss_2ndtime_578", "\E8하 하 하 ^1!&알 고  있 었 어 !/");
ds_map_add(global.text_data_en, "obj_torboss_2ndtime_579", "왜  다 들&잘 난  체&하 는  거 야 !?/");
ds_map_add(global.text_data_en, "obj_torboss_2ndtime_580", "\E1.../");
ds_map_add(global.text_data_en, "obj_torboss_2ndtime_581", "\E8그 래 서  이 제&뭐  할  거 야 ^1?&여 기  죽 치 고&앉 아  있 는  거 ...?/");
ds_map_add(global.text_data_en, "obj_torboss_2ndtime_582", "\E0너  달 리&할  일 은  없 %%");
ds_map_add(global.text_data_en, "obj_torboss_2ndtime_595", "그 거&이 미  말 했 어 ./%%");
ds_map_add(global.text_data_en, "obj_tordogcall_64", "* 따 르 릉 ..\E0.\TT /");
ds_map_add(global.text_data_en, "obj_tordogcall_65", "\F1 %");
ds_map_add(global.text_data_en, "obj_tordogcall_66", "* 여 보 세 요 ^1!&* 토 리 엘 이 란 다 ./");
ds_map_add(global.text_data_en, "obj_tordogcall_67", "\E1* 할  일 이  생 각 보 다&  더  오 래  걸 리 겠 구 나 ./");
ds_map_add(global.text_data_en, "obj_tordogcall_68", "\E1* 5분  정 도  더&  기 다 려 주 렴 ./");
ds_map_add(global.text_data_en, "obj_tordogcall_69", "\E0* 얌 전 하 게  기 다 려 줘 서&  고 맙 구 나 ./");
ds_map_add(global.text_data_en, "obj_tordogcall_70", "\TS \F0 \T0 %");
