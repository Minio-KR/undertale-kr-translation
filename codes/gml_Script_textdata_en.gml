ds_map_add(global.text_data_en, "obj_parsnik_431", "* 파 스 닉 은  쉭 쉭 댔 다 .");
ds_map_add(global.text_data_en, "obj_parsnik_432", "* 파 스 닉 의  뱀 들 이  움 직 이 며&  헤 어 스 타 일 을  바 꿨 다 ^1.&* 모 히 칸 ^1. 포 니 테 일 ^1. 언 더 컷 .");
ds_map_add(global.text_data_en, "obj_parsnik_433", "* 파 스 닉 은  입 을&  완 전 히  닫 았 다 ^1.&* 짧 고  괴 상 해  보 인 다 .");
ds_map_add(global.text_data_en, "obj_parsnik_434", "* 뱀 들 이  비 치 볼 을&  가 지 고  놀 고  있 다 .");
ds_map_add(global.text_data_en, "obj_parsnik_435", "* 맛 있 는  뱀  냄 새 가  난 다 .");
ds_map_add(global.text_data_en, "obj_parsnik_436", "* 파 스 닉 은  만 족 한  듯&  보 인 다 .");
ds_map_add(global.text_data_en, "obj_parsnik_437", "* 뱀 들 이  시 들 어 가 고  있 다 .");
ds_map_add(global.text_data_en, "obj_parsnik_478", "* 파 스 닉  - ATK 30 DEF 28&* 이  코 브 라 화  된  당 근 은&  맛 있 는  뱀 을  잔 뜩  달 고  있 다 ./^");
ds_map_add(global.text_data_en, "obj_parsnik_495", "* 당 신 은  파 스 닉 을  먹 으 려&  했 지 만 ^1, 아 직  충 분 히&  약 해 지 지  않 았 다 ./^");
ds_map_add(global.text_data_en, "obj_parsnik_498", "* 당 신 은  뱀 들 을&  스 파 게 티 마 냥  먹 었 다 .&* 5 HP를  회 복 했 다 !/^");
