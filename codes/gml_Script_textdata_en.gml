ds_map_add(global.text_data_en, "obj_mettaton_neo_546", "\E3알 피 스 도 , 인 간 들 도&살 아 남 으 리 라 는&사 실 을  알 고&있 으 니 까 ...!/%%");
ds_map_add(global.text_data_en, "obj_mettaton_neo_550", "\E6제 .../");
ds_map_add(global.text_data_en, "obj_mettaton_neo_551", "\E5제  팬 클 럽 에&들 어 오 고  싶 지&않 으 신 가  보 군 요 ...?/%%");
ds_map_add(global.text_data_en, "obj_mettaton_npc_63", "* Capital wenisberry./%%");
ds_map_add(global.text_data_en, "obj_mettaton_npc_69", "\W* \Y우 유 ^1, 설 탕 ^1,\W 그 리 고  \Y달 걀\W !&* 뒤 쪽  카 운 터 에 서&  찾 을  수  있 을  거 예 요 !/%%");
ds_map_add(global.text_data_en, "obj_mettaton_npc_77", "* 잘 했 어 요 ^1!&* 이 쪽  카 운 터  가 운 데 에&  놓 아  주 세 요 !/%%");
ds_map_add(global.text_data_en, "obj_mettaton_npc_82", "* 무 슨  일 이 죠 ?&* 캔  통 조 림 은  싫 은 가 요 ?&* 정 말  유 감 이 군 요 !/");
ds_map_add(global.text_data_en, "obj_mettaton_npc_83", "* MTT 브 랜 드 는  최 고 로&  신 선 한  인 공  재 료 와&  화 학  제 품 만 을  쓴 답 니 다 !/%%");
ds_map_add(global.text_data_en, "obj_mettatonb_quiz_255", "쉬 운  것 부 터&시 작 하 도 록  하 죠 !!/%%");
ds_map_add(global.text_data_en, "obj_mettatonb_quiz_258", "당 신 을  위 한&멋 진  상 입 니 다 !/%%");
ds_map_add(global.text_data_en, "obj_mettatonb_quiz_262", "당 신 에  대 한  건&충 분 하 니 , 저 에  대 해 서&얘 기 하 도 록  하 죠 !/%%");
ds_map_add(global.text_data_en, "obj_mettatonb_quiz_266", "또  쉬 운  문 제 가&있 습 니 다 !/%%");
ds_map_add(global.text_data_en, "obj_mettatonb_quiz_270", "우 승 할  거 라&확 신 하 진  마 세 요 .../%%");
ds_map_add(global.text_data_en, "obj_mettatonb_quiz_274", "기 억 력  게 임 을&시 작 하 죠 ./%%");
ds_map_add(global.text_data_en, "obj_mettatonb_quiz_278", "하 지 만  이 건  할  수&있 을 까 요 ???/%%");
ds_map_add(global.text_data_en, "obj_mettatonb_quiz_282", "간 단 한  문 제 입 니 다 ./%%");
ds_map_add(global.text_data_en, "obj_mettatonb_quiz_286", "대 박  문 제  하 나&나 갑 니 다 !!/%%");
ds_map_add(global.text_data_en, "obj_mettatonb_quiz_294", "%%%");
ds_map_add(global.text_data_en, "obj_mettatonb_quiz_490", "* 메 타 톤 . ");
ds_map_add(global.text_data_en, "obj_mettatonb_quiz_514", "* 메 타 톤  - ATK 30 DEF 255&* 금 속  몸 체 는  공 격 을  받 아 도&  피 해 를  받 지  않 게  해  준 다 ./^");
ds_map_add(global.text_data_en, "obj_mettatonb_quiz_524", "* 울 부 짖 는  건  규 칙  위 반 이 다 ./^");
ds_map_add(global.text_data_en, "obj_mettatonb_second_256", "여 기 까 집 니 다 ,&달 링 ! 안 녕 히 !/%%");
ds_map_add(global.text_data_en, "obj_mettatonb_second_265", "하 !&그  버 튼 은  당 신 을&지 켜 주 지  못 해 요 , 달 링 !/%%");
ds_map_add(global.text_data_en, "obj_mettatonb_second_268", "당 신 은  감 히&[행 동 ] 하 거 나  버 튼 을&누 르 진  못 할  거 예 요 !/%%");
ds_map_add(global.text_data_en, "obj_mettatonb_second_271", "맞 아 요 ! 누 르 지&마 세 요 ! 내 가  당 신 을&부 숴 버 릴  테 니 !/%%");
ds_map_add(global.text_data_en, "obj_mettatonb_second_274", "그  버 튼 이  없 다 면 ,&당 신 의  죽 음 이  점 점  더&가 까 워 질  뿐 이 죠 !/%%");
ds_map_add(global.text_data_en, "obj_mettatonb_second_277", "이 제  곧 !/%%");
ds_map_add(global.text_data_en, "obj_mettatonb_second_280", "언 제 ... 라 ..&도 !/%%");
ds_map_add(global.text_data_en, "obj_mettatonb_second_284", ".............&............/%%");
ds_map_add(global.text_data_en, "obj_mettatonb_second_290", "...(콜 록 )/%%");
ds_map_add(global.text_data_en, "obj_mettatonb_second_299", "아 !!!&저  노 란 색  불 빛 ...!/%%");
ds_map_add(global.text_data_en, "obj_mettatonb_second_300", "오 래 도&걸 리 셨 네 요 !/%%");
ds_map_add(global.text_data_en, "obj_mettatonb_second_542", "* 메 타 톤 . ");
ds_map_add(global.text_data_en, "obj_mettatonb_second_564", "* 메 타 톤  - ATK 30 DEF 255&* 금 속  몸 체 는  지 금 도  여 전 히&  피 해 를  받 지  않 게  해  준 다 ./^");
ds_map_add(global.text_data_en, "obj_mettatonb_second_574", "* 당 신 은  소 리 질 렀 다 ...&* 아 무  일 도  없 었 다 ./^");
ds_map_add(global.text_data_en, "obj_mettatonb_second_579", "* 노 란 색  버 튼 을  눌 렀 다 ^1.&* 휴 대 전 화 가  메 타 톤 에&  반 응 하 고  있 다 ...!/^");
ds_map_add(global.text_data_en, "obj_mettatonb_second_640", "당 신  전 화 인 가 요 ?&받 지  그 래 요 !/%%");
ds_map_add(global.text_data_en, "obj_mettatonb_second_652", "저 -저 기 !!&상 황 은  안  좋 지 만 ,&걱 정 은  마 !!/");
ds_map_add(global.text_data_en, "obj_mettatonb_second_653", "내 -내 가  네  휴 대 폰 에&설 치 한  마 지 막&기 능 이  있 어 ...!/");
ds_map_add(global.text_data_en, "obj_mettatonb_second_654", "\W그  \Y노 란  버 튼\W  보 여 ..?/");
ds_map_add(global.text_data_en, "obj_mettatonb_second_655", "그  핸 드 폰 의&[[행 동 ]] 메 뉴 로&들 어 가 서  그 걸&눌 러 !!!/%%");
ds_map_add(global.text_data_en, "obj_mettatonb_second_662", "* 핸 드 폰 의  [[행 동 ]] 메 뉴 가&  빛 나 고  있 다 .");
ds_map_add(global.text_data_en, "obj_mettatonb_second_703", "이 제  \*Z를  눌 러 !!!");
ds_map_add(global.text_data_en, "obj_mettatonb_second_746", "오 !/");
ds_map_add(global.text_data_en, "obj_mettatonb_second_747", "오 오 오 오 오 오 !/");
ds_map_add(global.text_data_en, "obj_mettatonb_second_748", "저 를  물 리 치 셨 군 요 !/");
ds_map_add(global.text_data_en, "obj_mettatonb_second_749", "어 떻 게  이 럴  수 가 ,&당 신 은  제  생 각 보 다&더  강 하 셨 네 요 , 어 쩌 구 ./%%");
ds_map_add(global.text_data_en, "obj_mettatonb_second_757", "알  게  뭐 예 요 .");
ds_map_add(global.text_data_en, "obj_mettatonb_third_214", "여 기 까 집 니 다 ,&달 링 ! 안 녕 히 !/%%");
ds_map_add(global.text_data_en, "obj_mettatonb_third_224", "그 래 요 , 코 어 를&재 설 계 한  게&바 로  저 예 요 !/");
ds_map_add(global.text_data_en, "obj_mettatonb_third_225", "모 두 를  시 켜 서  당 신 을&죽 이 려 고  한  것 도&저 예 요 !/");
ds_map_add(global.text_data_en, "obj_mettatonb_third_226", "하 지 만  그  계 획 은 ,&멀 리  보 지  못 했 던&나 의  실 수 였 어 요 ./");
ds_map_add(global.text_data_en, "obj_mettatonb_third_227", "당 신 , 이 보 다  수 백  배 는&좋 은  계 획 이  있 는 데&혹 시  알 고  있 나 요 ?/");
ds_map_add(global.text_data_en, "obj_mettatonb_third_228", "제 가  당 신 을&죽 이 는  거 죠 !!/%%");
ds_map_add(global.text_data_en, "obj_mettatonb_third_233", "달 링 , 들 어  봐 요 .&이 때 까 지  당 신 의&싸 움 을  지 켜 봤 어 요 ./");
ds_map_add(global.text_data_en, "obj_mettatonb_third_234", "당 신 은  나 약 해 요 ./");
ds_map_add(global.text_data_en, "obj_mettatonb_third_235", "계 속  나 아 간 다 면 ,&아 스 고 어 에 게  영 혼 을&빼 앗 기 고  말  거 예 요 ./");
ds_map_add(global.text_data_en, "obj_mettatonb_third_236", "그 리 고  아 스 고 어 는&당 신 의  영 혼 으 로&인 류 를  파 괴 하 겠 죠 ./%%");
ds_map_add(global.text_data_en, "obj_mettatonb_third_241", "제 가  영 혼 을  가 진 다 면 ,&아 스 고 어 의  계 획 을&막 을  수  있 어 요 !/");
ds_map_add(global.text_data_en, "obj_mettatonb_third_242", "인 류 를  파 멸 로 부 터&구 하 는  거 라 구 요 !/%%");
ds_map_add(global.text_data_en, "obj_mettatonb_third_247", "그 리 고  저 는&당 신 의  영 혼 을  이 용 해&결 계 를  뚫 고  나 가 .../");
ds_map_add(global.text_data_en, "obj_mettatonb_third_248", "언 제 나  꿈 꿔 왔 던&스 타 가  되 는  겁 니 다 !/");
ds_map_add(global.text_data_en, "obj_mettatonb_third_249", "수 백  명 의 ,&수 천  명 의 .../");
ds_map_add(global.text_data_en, "obj_mettatonb_third_250", "아 니 !&수 백 만  명 의  인 간 이&나 를  바 라 보 겠 죠 !/%%");
ds_map_add(global.text_data_en, "obj_mettatonb_third_255", "미 ! 화 려 함 !&드 디 어  제 가  다&갖 게  되 는  거 라 구 요 !/");
ds_map_add(global.text_data_en, "obj_mettatonb_third_256", "그 래  뭐 , 인 간  몇  명&좀  죽 으 면  어 때 요 ?/");
ds_map_add(global.text_data_en, "obj_mettatonb_third_257", "그 런  게  바 로 &연 예 계 란  곳 이 라 구 요 ,&베 이 비 !/%%");
ds_map_add(global.text_data_en, "obj_mettatonb_third_523", "* 메 타 톤 . ");
ds_map_add(global.text_data_en, "obj_mettatonb_third_545", "* 메 타 톤  - ATK 30 DEF 255&* 진 심 으 로 ^1, 저  금 속  몸 체 는&  뚫 을  수 가  없 다 !/^");
ds_map_add(global.text_data_en, "obj_mettatonb_third_555", "* 상 황 이  계 속  이 렇 게  진 행 된 다 면 ,&  아 마  그 렇 게  될  것 이 다 ./^");
ds_map_add(global.text_data_en, "obj_mettatonb_third_560", "* 당 신 은  메 타 톤 에 게&  뒤 에  거 울 이  있 다 고  말 했 다 ./%%");
ds_map_add(global.text_data_en, "obj_mettatonb_third_644", "어 ..어 ... 무 슨  일 이&일 어 나 는 지&보 이 질  않 네 , 하 지 만 .../");
ds_map_add(global.text_data_en, "obj_mettatonb_third_645", "포 -포 -포 기 하 지  마 ,&알 았 지 !?/");
ds_map_add(global.text_data_en, "obj_mettatonb_third_646", "그 ... 메 타 톤 을  물 리 칠&마 -마 -마 지 막  방 법 이&하 -하 나  있 어 .../");
ds_map_add(global.text_data_en, "obj_mettatonb_third_647", "그 건 ... 음 ... 그 건 .../");
ds_map_add(global.text_data_en, "obj_mettatonb_third_648", "지 금  개 발  중 인  건 데 , &그 래 서  판 단 하 긴  좀&곤 란 하 지 만 .../");
ds_map_add(global.text_data_en, "obj_mettatonb_third_649", "근 데 , 왜  메 타 톤 이&항 상  아 -아 -앞 을 &보 고  있 는 지  알 아 ?/");
ds_map_add(global.text_data_en, "obj_mettatonb_third_650", "왜 냐 하 면  놈 의  등 에&스 위 치 가  있 기&때 문 이 야 ./");
ds_map_add(global.text_data_en, "obj_mettatonb_third_651", "그 -그 러 니 까  만 약&네 -네 가  놈 을  돌 릴&리 -릴  수  있 다 면 ...&어 .../");
ds_map_add(global.text_data_en, "obj_mettatonb_third_652", "그 럼 , 음 ...&그 -그 -그&그  스 위 치 를  눌 러 .../");
ds_map_add(global.text_data_en, "obj_mettatonb_third_653", "그 러 면&놈 은 ... 어 ...&놈 은 .../");
ds_map_add(global.text_data_en, "obj_mettatonb_third_654", "약 해 질  거 야 ./");
ds_map_add(global.text_data_en, "obj_mettatonb_third_655", "좋 아 , 가 -가 -가&보 자 구 !/%%");
ds_map_add(global.text_data_en, "obj_mettatonb_third_688", "* 메 타 톤 이  뒤 돌 아 보 게  하 기&  좋 은  타 이 밍 인  것  같 다 .");
ds_map_add(global.text_data_en, "obj_mettatonb_third_820", "오 ???&거 울 이 요 ???/");
ds_map_add(global.text_data_en, "obj_mettatonb_third_821", "그 렇 죠 , 우 리  대 망 의&최 종 장 을  위 해 선&완 벽 하 게  보 여 야 겠 죠 !/%%");
ds_map_add(global.text_data_en, "obj_mettatonb_third_831", "흠 ... &안  보 이 네 ... &어 딨 죠 ...?/%%");
ds_map_add(global.text_data_en, "obj_mettatonb_third_848", "방 금 ./");
ds_map_add(global.text_data_en, "obj_mettatonb_third_849", "제  스 위 치 를 ./");
ds_map_add(global.text_data_en, "obj_mettatonb_third_850", "누 르 신  건 가 요 ?/%%");
ds_map_add(global.text_data_en, "obj_mettatonb_third_943", "그 런  나 약 한&콩 알 탄 으 로 는  씨 알 도&안  먹 혀 요 , 달 링 .^3 %");
ds_map_add(global.text_data_en, "obj_mettatonb_third_944", "연 기 란  게  어 떤  건 지&아 직 도  이 해 를&못  한  건 가 요 !?^3 %%");
ds_map_add(global.text_data_en, "obj_mettatonb_third_952", "* 메 타 톤 . ");
ds_map_add(global.text_data_en, "obj_mettatonex_167", ".../%%");
ds_map_add(global.text_data_en, "obj_mettatonex_190", "조 명 !&카 메 라 !&액 션 !/%%");
ds_map_add(global.text_data_en, "obj_mettatonex_196", "드 라 마 !&로 맨 스 !&피 바 다 !/%%");
ds_map_add(global.text_data_en, "obj_mettatonex_202", "전&모 두 가&원 하 는&아 이 돌&입 니 다 !/%%");
ds_map_add(global.text_data_en, "obj_mettatonex_208", "카 메 라&보 고&웃 어&주 세 요 !/%%");
ds_map_add(global.text_data_en, "obj_mettatonex_214", "아 , 깜 짝  퀴 즈&시 간 이 네 요 !/");
ds_map_add(global.text_data_en, "obj_mettatonex_215", "키 보 드 를  가 져 오 셨 길&바 라 요 .../");
ds_map_add(global.text_data_en, "obj_mettatonex_215_console", "저  화 상  키 보 드 를 &잘  이 용 해 주 세 요 .../");
ds_map_add(global.text_data_en, "obj_mettatonex_216", "이 건  주 관 식&문 제 니 까 요 !/%%");
ds_map_add(global.text_data_en, "obj_mettatonex_222", "그  문 장 이  당 신 의&마 음 을  정 말&잘  보 여 줬 네 요 ./");
ds_map_add(global.text_data_en, "obj_mettatonex_223", "제  것 도  보 시 는  건&어 떻 습 니 까 ?/%%");
ds_map_add(global.text_data_en, "obj_mettatonex_231", "오 우&이 건&그 냥&몸 풀 기&였 어 요 !/%%");
ds_map_add(global.text_data_en, "obj_mettatonex_237", "하 지 만  무 대  위 에 선&어 떨 까 요 ?/%%");
ds_map_add(global.text_data_en, "obj_mettatonex_244", "따 라&오 실  수&있 나 요 !?/%%");
ds_map_add(global.text_data_en, "obj_mettatonex_253", "조 명 !&카 메 라&폭 탄 !/%%");
ds_map_add(global.text_data_en, "obj_mettatonex_259", "터 지 기&시 작&합 니 다 !/%%");
ds_map_add(global.text_data_en, "obj_mettatonex_267", "다 시  만 난  걸&축 하 할  시 간 이 군 요 !/%%");
ds_map_add(global.text_data_en, "obj_mettatonex_274", "저 흰  서 로  꽤&서 먹 했 죠 , 달 링 .../");
ds_map_add(global.text_data_en, "obj_mettatonex_275", "서 로  마 음 을  터  놓 고&얘 기 해 볼 까 요 ?/%%");
ds_map_add(global.text_data_en, "obj_mettatonex_285", "파 ...팔 이 요 ?&머 ... 멋 진  다 리 가&있 는 데  왜  그 런  게&필 요 하 겠 어 요 ?/");
ds_map_add(global.text_data_en, "obj_mettatonex_286", "그 래 도  제 가&이 길  겁 니 다 !/%%");
ds_map_add(global.text_data_en, "obj_mettatonex_297", "자  자&...!/%%");
ds_map_add(global.text_data_en, "obj_mettatonex_307", "쇼 는&...&계 속&됩 니 다 !/%%");
ds_map_add(global.text_data_en, "obj_mettatonex_317", "드 ...&드 라 마 !&애 ...&액 션 !/%%");
ds_map_add(global.text_data_en, "obj_mettatonex_329", "\E5조 ... 조 명&카 ...카 메 라 .../");
ds_map_add(global.text_data_en, "obj_mettatonex_330", "그 만 둬 요 ! 정 말 로&인 류 가  멸 망 하 는  걸&원 하 시 는  겁 니 까 !?/");
ds_map_add(global.text_data_en, "obj_mettatonex_331", "\E7...아 님  자 기  자 신 을&그  정 도 로  믿 고&있 는  건 가 요 ?/%%");
ds_map_add(global.text_data_en, "obj_mettatonex_353", "하 하 , 멋 지 네 요 !/");
ds_map_add(global.text_data_en, "obj_mettatonex_354", "자 , 달 링 !&승 자 는  당 신  아 니 면&저 예 요 !/");
ds_map_add(global.text_data_en, "obj_mettatonex_355", "\E4하 지 만  누 가  이 길 지 는&결 판 이  난  것  같 군 요 ./");
ds_map_add(global.text_data_en, "obj_mettatonex_356", "\E8인 류 의  스 타 의&진 정 한  힘 을&보 시 죠 !/%%");
ds_map_add(global.text_data_en, "obj_mettatonex_368", "...그 럼 .../");
ds_map_add(global.text_data_en, "obj_mettatonex_369", "\E8당 신 이  스 타 란&말 인 가 요 ?/");
ds_map_add(global.text_data_en, "obj_mettatonex_370", "정 말 로  인 류 를&지 킬  수  있 다 는&겁 니 까 !?/%%");
