ds_map_add(global.text_data_en, "obj_adate_918", "\E4어 어 ^1, 그 래 서  음 ^1,&얘 기 하 고  싶 은  게&있 는 데 ./%%");
ds_map_add(global.text_data_en, "obj_adate_941", "                              &   뭐 야 ,           그 으 으 리 고   &   알 피 스 .         키 1스 한 다 ");
ds_map_add(global.text_data_en, "obj_adate_963", "\E3으 음 , 있 잖 아 ..^1.&난 ..^1. 난 .../");
ds_map_add(global.text_data_en, "obj_adate_964", "\M3난 ..^1. 난  지 금 까 지&네 게  소 -솔 직 하 지&못 했 어 .../");
ds_map_add(global.text_data_en, "obj_adate_965", "\E4이 \M4... 있 지 ^1,&난 ..^1. 난 .../");
ds_map_add(global.text_data_en, "obj_adate_966", "\E9아 ^1, 집 어 쳐 !/");
ds_map_add(global.text_data_en, "obj_adate_967", "\M0언 다 인 !!!/");
ds_map_add(global.text_data_en, "obj_adate_968", "너 ..^1. 너 에  대 한&내  마 음 을&말 해 줄  거 야 !/");
ds_map_add(global.text_data_en, "obj_adate_969", "\M4너 -넌  정 말  용 감 하 고 ^1,&또  강 하 고 ..^1.&그 리 고  친 절 해 .../");
ds_map_add(global.text_data_en, "obj_adate_970", "더 -덕 후 같 은  얘 기 를&할  때 도  항 상&내  말 을  들 어 주 고 .../");
ds_map_add(global.text_data_en, "obj_adate_971", "\E0내 - 내 가  소 중 한 &존 재 임 을  항 상&일 깨 워 주 고 .../");
ds_map_add(global.text_data_en, "obj_adate_972", "\E3내  앞 길 을  막 는&놈 은  두 들 겨  패 주 겠 단&말 을  할  때 에 도 .../%%");
ds_map_add(global.text_data_en, "obj_adate_976", "\E9무 -뭐 !?/");
ds_map_add(global.text_data_en, "obj_adate_977", "\M1언 다 인 은  절 대 ^1, 어 .../");
ds_map_add(global.text_data_en, "obj_adate_978", "\E3.../");
ds_map_add(global.text_data_en, "obj_adate_979", "\M0.../");
ds_map_add(global.text_data_en, "obj_adate_980", "\E4나 도  언 다 인 에 게&키 스 를  한 다 ..^1.&사 ..^1. 살 짝 .../");
ds_map_add(global.text_data_en, "obj_adate_981", "\M4나 는 ..^1. 언 다 인 의  눈 을&지 그 시  바 라 본 다 .../%%");
ds_map_add(global.text_data_en, "obj_adate_997", "언 다 인 !!/");
ds_map_add(global.text_data_en, "obj_adate_998", "더  이 상&못  참 겠 어 !!!/");
ds_map_add(global.text_data_en, "obj_adate_999", "널  미 치 도 록  사 랑 해 !!!/");
ds_map_add(global.text_data_en, "obj_adate_1000", "날  안 아 줘 ^1, 언 다 인 !^1!&안 아 줘 !!/%%");
ds_map_add(global.text_data_en, "obj_adate_1006", "그 리 고  외 친 다 !!/");
ds_map_add(global.text_data_en, "obj_adate_1007", "언 다 인 !!^1!&널  사 랑 해 !!!/");
ds_map_add(global.text_data_en, "obj_adate_1008", "언 다 인 !!^1!&다 시  키 스 해 줘 ^1,&언 다 인 !!!/%%");
ds_map_add(global.text_data_en, "obj_adate_1023", "\E9내 \M0-내 -내 가 ^1?&언 다 인 을 ???/");
ds_map_add(global.text_data_en, "obj_adate_1024", "\E7어 ^1, 어 ^1, 어 ^1, 어 ^1,&좋 아 !/");
ds_map_add(global.text_data_en, "obj_adate_1025", "\E6내 가  언 다 인 이&할  만 한  말 을  할 게 ^1,&너 는 ... 으 으 음 .../");
ds_map_add(global.text_data_en, "obj_adate_1026", "\E5너 는  내 가  할  만 한&행 동 을  해  봐 !/");
ds_map_add(global.text_data_en, "obj_adate_1027", "\E2*\M1어 흠 */");
ds_map_add(global.text_data_en, "obj_adate_1028", "\E0느 \M2아 아 아 !!^1!&어 이 ^1, 알 피 스 !&오 늘  귀 엽 구 나 !/");
ds_map_add(global.text_data_en, "obj_adate_1029", "\E5자 주  하 는  말 이 지 ^1!&하 지 만  플 라 토 닉 하 게 !&왜 냐 하 면  난  널  절 대&안  좋 아 하 거 든 /*");
ds_map_add(global.text_data_en, "obj_adate_1043", "   안 녕  언 다 인 !    너  오 늘 &   얘 기  좀          정 말    &   할 래 ?           섹 시 한 데");
ds_map_add(global.text_data_en, "obj_adate_1069", "너 랑 ^1, 얘 기 ^1?&흐 음 ..^1.&그 럴 까 ./");
ds_map_add(global.text_data_en, "obj_adate_1070", "난  어 째 선 지  가 끔 씩&너 의  얘 기 를  듣 길&좋 아 하 니 까 ./");
ds_map_add(global.text_data_en, "obj_adate_1071", "\E4얘 기 하 는  동 안&식 은 땀 이  나 도 록&눈 을  마 주 쳐  주 지 ./");
ds_map_add(global.text_data_en, "obj_adate_1072", "\E0그 래 ^1, 뭐 지 ?/%%");
ds_map_add(global.text_data_en, "obj_adate_1078", "뭐 라 고 !^1?&아 ...알 피 스 !?/");
ds_map_add(global.text_data_en, "obj_adate_1079", "대 체  무 슨&생 각 인 거 야 !?/");
ds_map_add(global.text_data_en, "obj_adate_1080", "\E9섹 \M2시 하 다 고 !^1?&너  어 떻 게  감 히&나 를  그 렇 게 !?/");
ds_map_add(global.text_data_en, "obj_adate_1081", "\E5일 단 ^1, 나 는&아 기  기 사 야 !/");
ds_map_add(global.text_data_en, "obj_adate_1082", "아 기 들 의&장 군 이 라 고 !!!/");
ds_map_add(global.text_data_en, "obj_adate_1083", "내  직 책 을  존 중 해 주 지&않 으 면 , 널&패 버 리 겠 어 !/");
ds_map_add(global.text_data_en, "obj_adate_1084", "\M3어 ^1, 그 러 고 선  내 가&갑 자 기  바 위  하 나 를&수 플 렉 스 로&넘 겨 버 렸 다 고  하 자 ./");
ds_map_add(global.text_data_en, "obj_adate_1085", "\E9흠 \M0흠 ^1! 어 쨌 든 ^1!&무 슨  말  하 고&싶 은  거 야 ^1, 알 피 스 !?/%%");
ds_map_add(global.text_data_en, "obj_adate_1108", "   언 다 인 에 게       키 스 를 &   진 실 을           해      &   말 한 다           준 다 .  ");
ds_map_add(global.text_data_en, "obj_adate_1132", "뭐 라 고 !?/");
ds_map_add(global.text_data_en, "obj_adate_1133", "그 동 안  날&속 여 왔 다 는  말 인 가 .../");
ds_map_add(global.text_data_en, "obj_adate_1134", "\E7알 피 스 !!^1!&믿 을  수  없 군 !/");
ds_map_add(global.text_data_en, "obj_adate_1135", "\E8쓰 -쓸 데 없 는&물 컹 이  같 으 니 !/");
ds_map_add(global.text_data_en, "obj_adate_1136", "\E9어 떻 게  우 리  우 정 을&배 신 할  수 가  있 지 !!/");
ds_map_add(global.text_data_en, "obj_adate_1137", "\E8널  얼 마 나&믿 었 는 데 !!!/%%");
ds_map_add(global.text_data_en, "obj_adate_1143", "뭐 ..뭐 !^1?&나 는  절 대  그 러 지 .../");
ds_map_add(global.text_data_en, "obj_adate_1144", "\M0알 피 스 ^1!&너  뭐 ..뭐  하 고&있 는  거 야 !/");
ds_map_add(global.text_data_en, "obj_adate_1145", "그 -그 리 고 ^1, 알 피 스 를&밀 쳐 낸 다 .../");
ds_map_add(global.text_data_en, "obj_adate_1146", "\E3나 한 테  키 ..키 스 하 면&안  되 는  거 잖 아 ...!!/");
ds_map_add(global.text_data_en, "obj_adate_1147", "\E3.../");
