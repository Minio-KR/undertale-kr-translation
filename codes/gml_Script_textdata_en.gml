ds_map_add(global.text_data_en, "obj_shop2_236", "* 와 하 하 ^1!&* 해 낼  수  있 을  줄&  알 고  있 었 네 !/*");
ds_map_add(global.text_data_en, "obj_shop2_237", "* 와 하 하 ..^1.&* 결 국  여 기 까 지&  온  건 가 ^1.&* 차 암  멋 지 구 만 !/*");
ds_map_add(global.text_data_en, "obj_shop2_287", "뭘&찾 고&있 나 ?/*");
ds_map_add(global.text_data_en, "obj_shop2_288", "고 맙 구 만 !&와  하  하 ./*");
