ds_map_add(global.text_data_en, "obj_greatdog_566", "* 눈 은  땅 바 닥 에&  철 퍽  하 고  부 서 졌 다 ./");
ds_map_add(global.text_data_en, "obj_greatdog_567", "* 그 레 이 터  도 그 는  근 처 의&  모 든  눈 을  뭉 쳐 서&  당 신 에 게  가 져 왔 다 ./");
ds_map_add(global.text_data_en, "obj_greatdog_568", "* 개 는  아 주  지 쳤 다 ..^1.&* 개 가  당 신 에 게&  머 리 를  기 댔 다 .../^");
ds_map_add(global.text_data_en, "obj_greatdog_573", "* 그 레 이 터  도 그 는  놀 기 에 는&  아 직  충 분 히  흥 분 하 지&  않 았 다 ./^");
ds_map_add(global.text_data_en, "obj_grillbynpc_doggo_74", "* 내  개 성 에  걸 맞 는&  스 파 이 크  목 걸 이 를&  할 까  생 각  중 이 야 ./");
ds_map_add(global.text_data_en, "obj_grillbynpc_doggo_75", '* 어 떤  의 미 냐 면 ..^1.&* "목 줄 을  달 고  산 책 을&  시 켜 주 세 요 "란  의 미 야 ./%%');
ds_map_add(global.text_data_en, "obj_grillbynpc_doggo_79", "* 그 렇 게  안  보 이 겠 지 만 ^1,&  저  커 다 란  녀 석 이  글 씨 를&  가 장  고 급 스 럽 게  써 ./");
ds_map_add(global.text_data_en, "obj_grillbynpc_doggo_80", "* 자 ^1, 이 걸  봐 !/");
ds_map_add(global.text_data_en, "obj_grillbynpc_doggo_81", '* (장 식 적 인  필 기 체 로&  "멍 "이 라 고  쓰 여  있 다 .)/%%');
ds_map_add(global.text_data_en, "obj_grillbynpc_doggo_86", "* 파 피 루 스 ^1?&* 너 야 ^1?&  제 발  좀 .../%%");
ds_map_add(global.text_data_en, "obj_grillbynpc_doggo_91", "* 언 다 인 !^1?&* 너  이  먼  곳 까 지&  온  거 야 ...?/%%");
ds_map_add(global.text_data_en, "obj_grillbynpc_doggo_96", "* 허 ^1?&* 너  언 제  샌 즈 랑&  친 구  먹 은  거 야 ?/");
ds_map_add(global.text_data_en, "obj_grillbynpc_doggo_97", "* 난  그  녀 석  별 로 야 ..^1.&* 걘  움 직 이 지 도  않 고&  나 타 나 는  걸  좋 아 한 다 고 ./%%");
ds_map_add(global.text_data_en, "obj_grillbynpc_doggo_101", "* 다 른  두  녀 석 은  어 딨 지 ^1?&* 이  큰  녀 석 이 랑 은&  나  혼 자 선  놀  수  없 는 데 .../");
ds_map_add(global.text_data_en, "obj_grillbynpc_doggo_102", "* 쟤 가  그 냥&  이 겨 버 릴  거 라 고 !!!/%%");
ds_map_add(global.text_data_en, "obj_grillbynpc_doggo_104", "* 가 끔  녀 석 들 이  장 난 을  쳐 ^1.&  가 만 히  앉 아 선 , 내 가&  볼  수  없 게  말 이 지 ./");
ds_map_add(global.text_data_en, "obj_grillbynpc_doggo_105", "* 분 명  지 금 도  녀 석 들 이&  여 기  있 을  거 야 ^1,&  나 한 테  장 난 치 려 고 ./");
ds_map_add(global.text_data_en, "obj_grillbynpc_doggo_106", "* 녀 석 들  중  한  놈 이&  포 기 할  때 까 지&  계 속  기 다 릴  거 야 .../%%");
ds_map_add(global.text_data_en, "obj_grillbynpc_doggo_110", "* 뚜 렷 한  형 체  없 이 ^1,&  부 들 거 리 는  가 족 은&  좋 은  것  같 아 ./");
ds_map_add(global.text_data_en, "obj_grillbynpc_doggo_111", "* 언 제 나  움 직 이 고  있 어 서 ^1,&  100퍼 센 트  언 제 나  제 대 로&  볼  수  있 으 니 까 !/%%");
ds_map_add(global.text_data_en, "obj_grillbynpc_foodmonster_73", "* 흠 ..^1.&* 인 간  음 식 과  괴 물  음 식 은&  서 로  다 르 지 ?/");
ds_map_add(global.text_data_en, "obj_grillbynpc_foodmonster_74", '* 그 건  "썩 는 다 "고  하 던 데 ./');
ds_map_add(global.text_data_en, "obj_grillbynpc_foodmonster_75", "* 그 걸  먹 으 면 ^1,&  네  몸  구 석 구 석 을&  다  지 나 간 다 며 ./");
ds_map_add(global.text_data_en, "obj_grillbynpc_foodmonster_76", "* 역 겹 네 ./");
ds_map_add(global.text_data_en, "obj_grillbynpc_foodmonster_77", "* 언 젠 간  먹 어 보 고  싶 어 ./%%");
ds_map_add(global.text_data_en, "obj_grillbynpc_foodmonster_80", "* 인 간 들 이  화 장 실 이 란  걸&  가 지 고  있 다 고  들 었 어 ./%%");
ds_map_add(global.text_data_en, "obj_grillbynpc_foodmonster_84", "* 인 간 에 겐 ^1, 괴 물  음 식 은&  굉 장 히  흥 미 로 울  거 야 ./");
ds_map_add(global.text_data_en, "obj_grillbynpc_foodmonster_85", "* 괴 물  음 식 은  먹 자 마 자 ^1,&  에 너 지 로  완 벽 하 게&  전 환 되 거 든 ./");
ds_map_add(global.text_data_en, "obj_grillbynpc_foodmonster_86", "* ...그 러 고  보 니 ^1,&  그 럼  인 간 들 은&  어 떻 게  하 는  거 지 ?/");
ds_map_add(global.text_data_en, "obj_grillbynpc_foodmonster_87", "* 전 투  도 중 에&  음 식 을  먹 는  건 가 ...?/%%");
ds_map_add(global.text_data_en, "obj_grillbynpc_foodmonster_90", "* 한  손 엔  아 이 스 크 림 을 ^1,&  다 른  손 엔  검 을&  들 고  말 야 ./");
ds_map_add(global.text_data_en, "obj_grillbynpc_foodmonster_91", "* 그 건  괴 물  전 사 들 의&  방 식 인 데 .../%%");
ds_map_add(global.text_data_en, "obj_grillbynpc_foodmonster_97", "* 흠 ^1, 보 통  지 금&  이  시 간 대 에&  샌 즈 가  여 기 로  와 ./");
ds_map_add(global.text_data_en, "obj_grillbynpc_foodmonster_98", "* 그 리 고 ^1, 아 주  조 금  뒤 에 ^1,&  그  형 제 가  여 기 로  와 ^1.&  짜 증 내 면 서 ./");
ds_map_add(global.text_data_en, "obj_grillbynpc_foodmonster_99", "* 그 래 ^1, 그  동 생 ^1.&* 파 피 루 스  말 이 야 ./");
ds_map_add(global.text_data_en, "obj_grillbynpc_foodmonster_100", "* 좀  재 미 있 는  친 구 지 ./");
ds_map_add(global.text_data_en, "obj_grillbynpc_foodmonster_101", "* 걘  언 제 나  우 유  한  컵 을&  주 문 한 단  말 이 야 .../");
ds_map_add(global.text_data_en, "obj_grillbynpc_foodmonster_102", '* 그 게  "강 한  뼈 들 로&  가 득  차  있 다 "라 면 서 ./%%');
ds_map_add(global.text_data_en, "obj_grillbynpc_foodmonster_104", "* 오 늘 도  와  줬 으 면  좋 겠 군 ./%%");
ds_map_add(global.text_data_en, "obj_grillbynpc_foodmonster_109", "* 조 만 간 ^1, 인 간  음 식 을&  먹 어 볼  수  있 겠 지 ./");
ds_map_add(global.text_data_en, "obj_grillbynpc_foodmonster_110", "* 그 리 고  인 간  화 장 실 도&  이 용 해 볼  거 야 ./%%");
ds_map_add(global.text_data_en, "obj_grillbynpc_foodmonster_115", "* 샌 즈 는  흥 미 로 워 ^1.&  여 러  종 류 의  신 기 한&  음 식 들 에  대 해  알 려 줬 거 든 ./");
ds_map_add(global.text_data_en, "obj_grillbynpc_foodmonster_116", "* 그 런 데 ^1, 그 리  잘  알 면 서 도 ^1,&  녀 석 은  늘  메 뉴  중 에 서  최 악 인&  버 거 만  주 문 한 단  말 이 지 ./%%");
ds_map_add(global.text_data_en, "obj_grillbynpc_grillby_73", "* ..^1.&* ..^1.&* ..^1./");
ds_map_add(global.text_data_en, "obj_grillbynpc_grillby_74", "* 그 릴 비 가  물  한  잔 이 라 도&  네 게  건 네 주 고  싶 지 만 ^1,&  자 기 는  그 런  건  안  건 드 린 대 ./%%");
ds_map_add(global.text_data_en, "obj_grillbynpc_grillby_78", "* .............^1.&* ..............^1.&* ... 잘  하 셨 습 니 다 ./%%");
ds_map_add(global.text_data_en, "obj_grillbynpc_grillby_83", "* ..^1.&* ..^1.&* ..^1./");
ds_map_add(global.text_data_en, "obj_grillbynpc_grillby_84", "* 그 릴 비 가&  네  음 식 은  지 금 쯤&  식 었 을  거 래 ./%%");
ds_map_add(global.text_data_en, "obj_grillbynpc_hot2_73", "* 저  개 들 은  왕 실  근 위 대 의&  일 원 이 야 ^1. 언 다 인 이  이 끄 는&  정 예 군 이 지 ./");
ds_map_add(global.text_data_en, "obj_grillbynpc_hot2_74", "* 무 례 하 고 ^1, 시 끄 럽 고 ^1,&  길 을  막 는  것 이 라 면&  누 구 라 도  때 려 눕 히 는 데 .../");
ds_map_add(global.text_data_en, "obj_grillbynpc_hot2_75", "* 그 러 니  아 이 들 이  전 부&  크 면  언 다 인 처 럼&  되 고  싶 어 하 지 !/%%");
ds_map_add(global.text_data_en, "obj_grillbynpc_hot2_77", "* 나 도  크 면&  언 다 인 처 럼  되 고  싶 어 ^1!&* 후  후  후 !/%%");
ds_map_add(global.text_data_en, "obj_grillbynpc_hot2_81", "* 샌 즈 는  보 초 야 ^1.&* 하 지 만  그 렇 다 고  뭔 가&  하 리 라 는  생 각 은  접 어 ./");
ds_map_add(global.text_data_en, "obj_grillbynpc_hot2_82", "\W* 다 들  샌 즈 가  숲 속 에  앉 아&  \Y자 동 차  잡 지 \W나  보 고  있 단  걸&  알 아 ./%%");
ds_map_add(global.text_data_en, "obj_grillbynpc_hot2_87", "* 에 에 에 에 에 에 엥 ..^1.&* 내 가  다 른  걸  할  수&  있 었 으 면  좋 겠 어 ./%%");
ds_map_add(global.text_data_en, "obj_grillbynpc_hot2_92", "* 저  개 들 은&  왕 실  근 위 대 의  일 원 .../");
ds_map_add(global.text_data_en, "obj_grillbynpc_hot2_93", "* 어 ^1?&* 어 디  갔 지 ?/");
ds_map_add(global.text_data_en, "obj_grillbynpc_hot2_94", "* 뭔 가  느 낌 이  안  좋 아 ./%%");
ds_map_add(global.text_data_en, "obj_grillbynpc_hot2_101", "* 와 우 ^1, 새 로 운  세 상 이 라 .../");
ds_map_add(global.text_data_en, "obj_grillbynpc_hot2_102", "* 이 제  그 릴 비 의  통 역 을&  안  해  줘 도  되 겠 네 .../");
ds_map_add(global.text_data_en, "obj_grillbynpc_hot2_103", "* ...다 행 인  게 ^1, 사 실  지 금 껏&  쟤 가  말 한  건  그 냥  내 가&  지 어 낸  말 이 거 든 ./%%");
ds_map_add(global.text_data_en, "obj_grillbynpc_hot2_109", "* 그 릴 비 는  지 금&  걱 정 스 러 워 하 고  있 어 ./");
ds_map_add(global.text_data_en, "obj_grillbynpc_hot2_110", "* 샌 즈 가  단 골  손 님 인 데 ^1,&  오 늘  하 루  종 일&  나 타 나 지  않 았 거 든 .../%%");
ds_map_add(global.text_data_en, "obj_grillbynpc_hot2_115", "* 뭔 가  느 낌 이  안  좋 아 ^1.&* 우 리  삶 이  여 기  영 원 히&  갇 혀 버 린  느 낌 이 야 ^1, 그 렇 지 ...?/");
ds_map_add(global.text_data_en, "obj_grillbynpc_hot2_116", "* 내  생 각 엔  에 스 프 레 소 를&  다 시  주 문 해 야  할  것  같 아 .../%%");
ds_map_add(global.text_data_en, "obj_grillbynpc_hotandbothered_73", "* 어 딜  가 든 ^1,&  같 은  메 뉴 에 ^1,&  같 은  사 람 들 이  있 어 .../");
ds_map_add(global.text_data_en, "obj_grillbynpc_hotandbothered_74", "* 도 와 줘 ^1!&* 난  새  음 료 와  하 ^1-하 ^1-핫 한&  남 자 들 을  원 한 다 고 !!!!/%%");
ds_map_add(global.text_data_en, "obj_grillbynpc_hotandbothered_75", "* 내  생 각 에  저  바 텐 더 는&  좀  하 ^1-하 ^1-핫 한  것  같 아 .../%%");
ds_map_add(global.text_data_en, "obj_grillbynpc_hotandbothered_79", "* 모 두 들 !!^1!&* 우 ^1-우 ^1-우 리  파 티  하 자 !!!/");
ds_map_add(global.text_data_en, "obj_grillbynpc_hotandbothered_80", "* ...아 무 도  안 해 ?/%%");
ds_map_add(global.text_data_en, "obj_grillbynpc_hotandbothered_84", "* 샌 지 이 이 ..^1.&* 돌 아 와 서  나 랑  앉 아  줘 .../");
ds_map_add(global.text_data_en, "obj_grillbynpc_hotandbothered_85", "* 네 가  있 으 면  모 든  게&  너 무  즐 거 워 !!!/%%");
ds_map_add(global.text_data_en, "obj_grillbynpc_hotandbothered_90", "* 여 긴  너 -너 -너 무  조 용 해 ./");
ds_map_add(global.text_data_en, "obj_grillbynpc_hotandbothered_91", "* 모 두 들  기-기 운  내 ^1!&* 이 -이 래 서  난&  여 기 가  싫 어 ./%%");
ds_map_add(global.text_data_en, "obj_grillbynpc_hotandbothered_98", "* 지 -지 상 에 는  하 -핫 한&  남 자 들 이  있 을 까 .../");
ds_map_add(global.text_data_en, "obj_grillbynpc_hotandbothered_99", "* 그 -그 리 고  멋 진&  으 -음 료 들 도 .../");
ds_map_add(global.text_data_en, "obj_grillbynpc_hotandbothered_100", "* 오 오 오 오 오 오 ^1,&  난  준 비 됐 어 !/%%");
ds_map_add(global.text_data_en, "obj_grillbynpc_hotandbothered_105", "* 이 때 쯤 에  원 래  샌 지 가&  여 기  와 야  하 는  거&  아 냐 ???/");
ds_map_add(global.text_data_en, "obj_grillbynpc_hotandbothered_106", "* 빨 리  와  샌 지 ^1!&* 이  파 티 에 선  네 가&  생 명 인 데 .../%%");
ds_map_add(global.text_data_en, "obj_grillbynpc_lesserdog_71", "* (자 기  자 신 을  상 대 로&  포 커 를  하 고  있 다 .)/");
ds_map_add(global.text_data_en, "obj_grillbynpc_lesserdog_72", "* (지 고  있 는  것  같 다 .)/%%");
ds_map_add(global.text_data_en, "obj_grillbynpc_lesserdog_76", "* (하 던  게 임 을  훌 라 로&  바 꾼  것  같 다 .)/%%");
ds_map_add(global.text_data_en, "obj_grillbynpc_lesserdog_81", "* (마 침 내  자 기  자 신 을&  상 대 로  하 던  포 커 에 서&  이 긴  듯 하 다 ..?)/%%");
ds_map_add(global.text_data_en, "obj_grillbynpc_mandog_75", "* 네 가  앉 을  자 리 를&  미 리  봐  두 는  게&  좋 을  거 다 ^1, 꼬 마 야 ./");
ds_map_add(global.text_data_en, "obj_grillbynpc_mandog_76", "* 왜 냐 하 면  저 기  덩 치 가&  네  자 리 로  뛰 어 와 서  많 은&  사 랑 과  관 심 을  줄  테 니 까 ./%%");
ds_map_add(global.text_data_en, "obj_grillbynpc_mandog_80", "* 샌 즈 는  어 딨 지 ..^1.&* 내  머 리 를  쓰 다 듬 어 줘 야&  하 는 데 .../%%");
ds_map_add(global.text_data_en, "obj_grillbynpc_mandog_85", "* 우 리  편 지 에  답 장 을&  주 지  않 고  있 어 .../");
ds_map_add(global.text_data_en, "obj_grillbynpc_mandog_86", "* 어 쩌 면  도 고 한 테&  쓰 라 고  시 켜 서  그 런  건 가 ./%%");
ds_map_add(global.text_data_en, "obj_grillbynpc_mandog_91", "* 샌 즈 가  들 어 오 면&  내  머 리 를  쓰 다 듬 어 주 길&  바 라 고  있 었 는 데 ./");
ds_map_add(global.text_data_en, "obj_grillbynpc_mandog_92", "* 침 입 자 ...!/%%");
ds_map_add(global.text_data_en, "obj_grillbynpc_mandog_96", "* 그  덩 치 는  어 디  있 지 ^1?&* 걔  없 이 는  시 작 할  수&  없 는 데 ./%%");
ds_map_add(global.text_data_en, "obj_grillbynpc_mandog_98", "* 뭔 가 ..^1. 조 용 한  냄 새 가  나 ./%%");
