ds_map_add(global.text_data_en, "obj_readable_room1_492", "* (꺼 진  것  같 다 .)/%%");
ds_map_add(global.text_data_en, "obj_readable_room1_497", "* 실 험  기 록  제 15번 /");
ds_map_add(global.text_data_en, "obj_readable_room1_498", "* 이  연 구 는  이 제&  막 다 른  길 에  온  것  같 다 .../");
ds_map_add(global.text_data_en, "obj_readable_room1_499", "* 하 지 만  적 어 도  해 피  엔 딩 은&  끌 어 낸  모 양 이 다 ...?/");
ds_map_add(global.text_data_en, "obj_readable_room1_500", "* 영 혼 들 을  아 스 고 어 에 게&  도 로  보 내 고  그 릇 은&  정 원 에  돌 려 놓 았 다 ./");
ds_map_add(global.text_data_en, "obj_readable_room1_501", "* 그 리 고  유 족 들 에 게&  전 화 해 서  모 두 가&  살 아 있 다 고  전 했 다 ./");
ds_map_add(global.text_data_en, "obj_readable_room1_502", "* 내 일  모 두 를  집 에&  돌 려 보 낼  것 이 다 . :)/%%");
ds_map_add(global.text_data_en, "obj_readable_room1_503", "* (꺼 진  것  같 다 .)/%%");
