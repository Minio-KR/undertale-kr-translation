ds_map_add(global.text_data_en, "obj_townnpc_reddemon_72", "* 아 무 것 도  할  수  없 으 니 까 ^1,&  그 런 데  왜  침 울 해&  있 어 야 겠 어 ?/%%");
ds_map_add(global.text_data_en, "obj_townnpc_reddemon_73", "* 싱 긋  싱 긋 ./%%");
ds_map_add(global.text_data_en, "obj_townnpc_reddemon_83", "* 어 쩌 면  한  번 쯤 은&  찡 그 린  표 정 을&  시 도 해 볼 지 도 ./");
ds_map_add(global.text_data_en, "obj_townnpc_reddemon_84", "* ...아 냐 ^1.&* 역 시  못 하 겠 어 ./%%");
ds_map_add(global.text_data_en, "obj_townnpc_reddemon_89", "* 오 ^1?&* 우 리  이 제  자 유 야 ?/");
