ds_map_add(global.text_data_en, "obj_townnpc_monsterkid1_130", "* 우 리  부 모 님 이&  이 리 로  오 라 고  하 신  건&  아 니 지 ^1, 응 ?/%%");
ds_map_add(global.text_data_en, "obj_townnpc_monsterkid1_132", "* 너  네 가  어 디  가 는 지&  알 고  있 는  거 ^1,&  맞 지 ...?/");
ds_map_add(global.text_data_en, "obj_townnpc_monsterkid1_133", "* 난  그 냥  널  따 라 가 고&  있 는  거 라 고 ..^1.&* 하  하 ./%%");
ds_map_add(global.text_data_en, "obj_townnpc_monsterkid1_141", "* 요 ^1, 이  절 벽 은&  너 무  가 파 른 데 .../%%");
ds_map_add(global.text_data_en, "obj_townnpc_monsterkid1_147", "* 흐 으 음 .../%%");
ds_map_add(global.text_data_en, "obj_townnpc_monsterkid1_161", "* 요 ^1, 여 긴&  우 산 을  가 지 고 선&  못  올 라 갈  거 야 ./%%");
ds_map_add(global.text_data_en, "obj_townnpc_reddemon_70", "* 다 들  이 미  지 하 에  문 제 가&  있 다 는  걸  알 지 만 ^1,&  그 래 도  우 린  웃 어 ./");
