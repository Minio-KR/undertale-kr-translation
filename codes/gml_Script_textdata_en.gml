ds_map_add(global.text_data_en, "SCR_TEXT_4254", "\M5* 휴 우 !!^1! 아 깝 네 요 !^1!&* 공 짜 로  광 고 할  수&  있 었 는 데 ./%%");
ds_map_add(global.text_data_en, "SCR_TEXT_4255", "\M2 %%");
ds_map_add(global.text_data_en, "SCR_TEXT_4260", "\M3* 아 ^1!&* 돌 아 왔 군 요 !/");
ds_map_add(global.text_data_en, "SCR_TEXT_4261", "\M6* 좋 아 요 ^1, 여 러 분 ^1!&* 제  영 화 의  매 력 에 는&  버 틸  수  없 나  보 군 요 !/");
ds_map_add(global.text_data_en, "SCR_TEXT_4262", "\M2* (이 것 을  보 고 합 니 까 ?)& &         보 고 한 다     아 직 \C");
