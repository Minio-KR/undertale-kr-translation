ds_map_add(global.text_data_en, "SCR_TEXT_2886", '* (이  CD는  "오 싹 웨 이 브 "라 고&  표 시 되 어  있 다 .)/');
ds_map_add(global.text_data_en, "SCR_TEXT_2887", "* (이  CD는  재 생  중 이 다 .)&* (끌 까 요 ?)&         끈 다         아 니 요 \C");
ds_map_add(global.text_data_en, "SCR_TEXT_2888", " ");
ds_map_add(global.text_data_en, "SCR_TEXT_2897", "* (당 신 은  CD를  재 생 했 다 .)/%%");
ds_map_add(global.text_data_en, "SCR_TEXT_2903", "* %%");
ds_map_add(global.text_data_en, "SCR_TEXT_2911", "* (CD는  움 직 임 을  멈 췄 다 .)/%%");
ds_map_add(global.text_data_en, "SCR_TEXT_2917", "* %%");
ds_map_add(global.text_data_en, "SCR_TEXT_2924", '* (이  CD는  "엽 기 데 이  뮤 직 "이 라 고&  표 시 되 어  있 다 .)/');
ds_map_add(global.text_data_en, "SCR_TEXT_2925", "* (재 생 할 까 요 ?)& &         재 생         아 니 요 \C");
ds_map_add(global.text_data_en, "SCR_TEXT_2926", " ");
ds_map_add(global.text_data_en, "SCR_TEXT_2929", '* (이  CD는  "엽 기 데 이  뮤 직 "이 라 고&  표 시 되 어  있 다 .)/');
ds_map_add(global.text_data_en, "SCR_TEXT_2930", "* (이  CD는  재 생  중 이 다 .)&* (끌 까 요 ?)&         끈 다         아 니 요 \C");
ds_map_add(global.text_data_en, "SCR_TEXT_2931", " ");
ds_map_add(global.text_data_en, "SCR_TEXT_2940", "* (당 신 은  CD를  재 생 했 다 .)/%%");
ds_map_add(global.text_data_en, "SCR_TEXT_2946", "* %%");
ds_map_add(global.text_data_en, "SCR_TEXT_2954", "* (CD는  움 직 임 을  멈 췄 다 .)/%%");
ds_map_add(global.text_data_en, "SCR_TEXT_2960", "* %%");
ds_map_add(global.text_data_en, "SCR_TEXT_2968", "* (냉 장 고 를  열 어 보 겠 습 니 까 ?)& &         연 다         아 니 요 \C");
ds_map_add(global.text_data_en, "SCR_TEXT_2969", " ");
ds_map_add(global.text_data_en, "SCR_TEXT_2977", "* (샌 드 위 치  한  개 가&  외 롭 게  놓 여  있 다 .)/%%");
ds_map_add(global.text_data_en, "SCR_TEXT_2983", "* (비 어  있 다 .)/%%");
ds_map_add(global.text_data_en, "SCR_TEXT_2988", "%%");
ds_map_add(global.text_data_en, "SCR_TEXT_2993", "* 이 건  유 령  샌 드 위 치 야 .../");
ds_map_add(global.text_data_en, "SCR_TEXT_2994", "* 한 번  먹 어  볼 래 ...& &         그 래         아 니 \C");
ds_map_add(global.text_data_en, "SCR_TEXT_2995", " ");
ds_map_add(global.text_data_en, "SCR_TEXT_3001", "* (당 신 은  유 령  샌 드 위 치 를&  한  입  먹 으 려  했 다 .)/");
ds_map_add(global.text_data_en, "SCR_TEXT_3002", "* (당 신 을  그 대 로&  통 과 해 버 렸 다 ...)/");
ds_map_add(global.text_data_en, "SCR_TEXT_3003", "* 오 .../");
ds_map_add(global.text_data_en, "SCR_TEXT_3004", "* 괜 찮 아 .../%%");
ds_map_add(global.text_data_en, "SCR_TEXT_3008", "* 오 .....................&  ....................&  ................./%%");
ds_map_add(global.text_data_en, "SCR_TEXT_3014", "* 멋 진  식 사  뒤 엔  바 닥 에  누 워&  쓰 레 기 같 은  기 분 을&  느 끼 는  걸  좋 아 해 .../");
ds_map_add(global.text_data_en, "SCR_TEXT_3015", "* 우 리  집 안  전 통 이 야 .../");
ds_map_add(global.text_data_en, "SCR_TEXT_3016", "* 너 도 ..^1.&* ... 같 이  할 래 ...&         그 래         아 니 \C");
ds_map_add(global.text_data_en, "SCR_TEXT_3017", " ");
ds_map_add(global.text_data_en, "SCR_TEXT_3023", "* 그 래 ..^1.&* 날  따 라 해 .../%%");
ds_map_add(global.text_data_en, "SCR_TEXT_3028", "* 오 .....................&  ....................&  ................./%%");
ds_map_add(global.text_data_en, "SCR_TEXT_3034", "* 게 임  하 나  할 래 ^1?&* 천 둥  달 팽 이 라 는  게 임 이 야 ./");
ds_map_add(global.text_data_en, "SCR_TEXT_3035", "* 달 팽 이 들 이  경 주 해 서 ^1,&  만 약  노 란 색  달 팽 이 가  이 기 면 ^1,&  네 가  이 기 는  거 야 ./");
ds_map_add(global.text_data_en, "SCR_TEXT_3036", "* 한 판 에  10G야 .& &         하 기         안  해 \C");
ds_map_add(global.text_data_en, "SCR_TEXT_3037", " ");
ds_map_add(global.text_data_en, "SCR_TEXT_3045", "* 음 ..^1.&* 돈 이  하 나 도  없 어 ?/");
ds_map_add(global.text_data_en, "SCR_TEXT_3046", "* 아 -아 냐 ^1,&그 래 도  할  수  있 어 ^1,&  걱 정 하 지  마 .../");
ds_map_add(global.text_data_en, "SCR_TEXT_3047", "* 좋 아 ..^1.&* \*Z를  연 타 하 면  달 팽 이 를&  응 원 할  수  있 어 ./");
ds_map_add(global.text_data_en, "SCR_TEXT_3048", "* 준 비 됐 어 ?/%%");
ds_map_add(global.text_data_en, "SCR_TEXT_3052", "* 어 ..^1. 10G가  안  되 네 ./");
ds_map_add(global.text_data_en, "SCR_TEXT_3053", "* 하 지 만  너 는  나 의&  유 일 한  고 객 이 니 까 ^1,&  그 냥  그 것 만  가 져 갈 게 .../");
ds_map_add(global.text_data_en, "SCR_TEXT_3054", "* 좋 아 ..^1.&* \*Z를  연 타 하 면  달 팽 이 를&  응 원 할  수  있 어 ./");
ds_map_add(global.text_data_en, "SCR_TEXT_3055", "* 준 비 됐 어 ?/%%");
ds_map_add(global.text_data_en, "SCR_TEXT_3061", "* 좋 아 ..^1.&* \*Z를  연 타 하 면  달 팽 이 를&  응 원 할  수  있 어 ./");
ds_map_add(global.text_data_en, "SCR_TEXT_3062", "* 준 비 됐 어 ?/%%");
ds_map_add(global.text_data_en, "SCR_TEXT_3068", "* 오 ........./%%");
ds_map_add(global.text_data_en, "SCR_TEXT_3073", "* .../");
ds_map_add(global.text_data_en, "SCR_TEXT_3074", "* 일 곱 ./");
ds_map_add(global.text_data_en, "SCR_TEXT_3075", "* 일 곱  인 간 의  영 혼 ./");
ds_map_add(global.text_data_en, "SCR_TEXT_3076", "* 일 곱  인 간 의&  영 혼 의  힘 으 로 ^1, 우 리 의  왕 .../");
ds_map_add(global.text_data_en, "SCR_TEXT_3077", "\W* \R아 스 고 어  \Y드 리 무 어  대 왕 \W은 .../");
ds_map_add(global.text_data_en, "SCR_TEXT_3078", "* ...신 이  될  거 야 ./");
ds_map_add(global.text_data_en, "SCR_TEXT_3079", "\W* 그  힘 으 로 ^1, \R아 스 고 어 \W는&  결 계 를  산 산 조 각  낼  거 야 ./");
ds_map_add(global.text_data_en, "SCR_TEXT_3080", "* 그 리 고  마 침 내  인 류 로 부 터&  지 상 을  되 찾 고 ..../");
ds_map_add(global.text_data_en, "SCR_TEXT_3081", "* 우 리 가  지 금 까 지  참 아 왔 던&  고 통 과  시 련 을  그 들 에 게&  되 돌 려 주 겠 지 ./");
ds_map_add(global.text_data_en, "SCR_TEXT_3082", "* .../");
ds_map_add(global.text_data_en, "SCR_TEXT_3083", "* 이 해 했 나 ^1, 인 간 ?/");
ds_map_add(global.text_data_en, "SCR_TEXT_3084", "* 이 게  네 가  구 원 받 을&  유 일 한  기 회 다 ./");
ds_map_add(global.text_data_en, "SCR_TEXT_3085", "* 네  영 혼 을  내 놓 아 라 .../");
ds_map_add(global.text_data_en, "SCR_TEXT_3086", "* 그 렇 지  않 으 면&  내 가  그  몸 에 서&  빼 앗 아  가 도 록  하 지 ./%%");
ds_map_add(global.text_data_en, "SCR_TEXT_3104", "* 요 ^1, 내 가  여 기  있 으 면&  안  되 는  건  알 지 만 ^1, 음 .../");
ds_map_add(global.text_data_en, "SCR_TEXT_3105", "* 물 어 보 고  싶 은  게  있 어 ./");
ds_map_add(global.text_data_en, "SCR_TEXT_3106", "* .../");
ds_map_add(global.text_data_en, "SCR_TEXT_3107", "* 저 기 ^1, 이 런  거  아 무 한 테 도&  물 어 볼  일 이  없 었 는 데 .../");
ds_map_add(global.text_data_en, "SCR_TEXT_3108", "* 음 .../");
ds_map_add(global.text_data_en, "SCR_TEXT_3109", "* 요 ..^1. 너  인 간 이 지 ^1, 응 ?&* 하 하 ./");
ds_map_add(global.text_data_en, "SCR_TEXT_3110", "* 역 시 ^1! 알 아 봤 다 니 깐 !/");
ds_map_add(global.text_data_en, "SCR_TEXT_3111", "* ...음 ^1, 사 실 ^1,&  지 금 에 야  알 았 어 .../");
ds_map_add(global.text_data_en, "SCR_TEXT_3112", '* 언 다 인 이  말 하 더 라 고 ^1, 음 ^1,&  "그  인 간 에 게 서  떨 어 져 ."&  라 고 ./');
ds_map_add(global.text_data_en, "SCR_TEXT_3113", "* 그 래 서 ^1, 그 러 니 까 ^1, 으 음 .../");
ds_map_add(global.text_data_en, "SCR_TEXT_3114", "* 내  생 각 엔  그 것  때 문 에&  우 리 는  적 이 거 나&  뭐  그 런  것  같 아 ./");
ds_map_add(global.text_data_en, "SCR_TEXT_3115", "* 근 데  나 는  그 런  건&  별 로 인  것  같 아 서 ^1,&  하 하 ./");
ds_map_add(global.text_data_en, "SCR_TEXT_3116", "* 요 ^1, 그 러 니  네 가  미 워 질  정 도 로&  심 한  말 을  해 줄 래 ?/");
ds_map_add(global.text_data_en, "SCR_TEXT_3117", "* 나 한 테  말 이 야 .& &         그 래         싫 어 \C");
ds_map_add(global.text_data_en, "SCR_TEXT_3118", " ");
ds_map_add(global.text_data_en, "SCR_TEXT_3124", "* 허 ...?/");
ds_map_add(global.text_data_en, "SCR_TEXT_3125", "* 요 ^1, 그 게  네 가  생 각 해  낸&  나 쁜  말 이 야 ?/");
ds_map_add(global.text_data_en, "SCR_TEXT_3126", "* 우 리  언 니 가  나 한 테  항 상&  그 런  식 으 로  말 하 는 데 !/");
ds_map_add(global.text_data_en, "SCR_TEXT_3127", "* 내 가  해 야 겠 구 나 ^1. 하 하 ./");
ds_map_add(global.text_data_en, "SCR_TEXT_3128", "* 요 ^1, 나 ..^1. 나 는  네 가 &  꼴 도  보 기  싫 어 ./");
ds_map_add(global.text_data_en, "SCR_TEXT_3129", "* .../");
ds_map_add(global.text_data_en, "SCR_TEXT_3130", "* 이 런 ^1, 나 ..^1.&  나  진 짜  나 쁜  놈 이 다 ./");
ds_map_add(global.text_data_en, "SCR_TEXT_3131", "* 나 ..^1. 난  이 제&  집 에  가 야 겠 어 ./%%");
ds_map_add(global.text_data_en, "SCR_TEXT_3135", "* 요 ^1, 뭐 라 고 ^1?&* 그 래 서  내 가  하 라 고 ?/");
ds_map_add(global.text_data_en, "SCR_TEXT_3136", "* 갈  데 까 지  가  보 자 고 .../");
ds_map_add(global.text_data_en, "SCR_TEXT_3137", "* 요 ^1, 나 ..^1. 나 는  네 가 &  꼴 도  보 기  싫 어 ./");
ds_map_add(global.text_data_en, "SCR_TEXT_3138", "* .../");
ds_map_add(global.text_data_en, "SCR_TEXT_3139", "* 이 런 ^1, 나 ..^1.&  나  진 짜  나 쁜  놈 이 다 ./");
ds_map_add(global.text_data_en, "SCR_TEXT_3140", "* 나 ..^1. 난  이 제&  집 에  가 야 겠 어 ./%%");
ds_map_add(global.text_data_en, "SCR_TEXT_3148", "* (정 수 기 가  있 다 .)&* (물  한  잔 을  받 겠 습 니 까 ?)&         예           아 니 요 \C");
ds_map_add(global.text_data_en, "SCR_TEXT_3149", " ");
ds_map_add(global.text_data_en, "SCR_TEXT_3153", "* (정 수 기 엔  더 는  물 이&  남 아 있 지  않 다 .)/%%");
ds_map_add(global.text_data_en, "SCR_TEXT_3155", "* (잔 인 하 게 도 ^1, 당 신 은&  언 다 인 이  보 는  앞 에 서&  물 을  쏟 아  버 렸 다 .)/%%");
ds_map_add(global.text_data_en, "SCR_TEXT_3163", "* (당 신 은  물 을  한  컵  받 았 다 .)/%%");
ds_map_add(global.text_data_en, "SCR_TEXT_3171", " %%");
ds_map_add(global.text_data_en, "SCR_TEXT_3177", "* (물 을  버 리 시 겠 습 니 까 ?)& &         예           아 니 요 \C");
ds_map_add(global.text_data_en, "SCR_TEXT_3178", " ");
ds_map_add(global.text_data_en, "SCR_TEXT_3184", "* (당 신 은  정 수 기  옆&  땅 바 닥 에  물 을  부 었 다 .)/%%");
ds_map_add(global.text_data_en, "SCR_TEXT_3196", " %%");
ds_map_add(global.text_data_en, "SCR_TEXT_3201", "* 손 이  미 끄 러 졌 을 뿐 ./%%");
ds_map_add(global.text_data_en, "SCR_TEXT_3205", "* (언 다 인 에 게  물 을  줍 니 까 ?)& &         예           아 니 요 \C");
ds_map_add(global.text_data_en, "SCR_TEXT_3206", " ");
ds_map_add(global.text_data_en, "SCR_TEXT_3210", "* (말 라 버 린  것  같 다 ...)/%%");
ds_map_add(global.text_data_en, "SCR_TEXT_3215", " %%");
ds_map_add(global.text_data_en, "SCR_TEXT_3238", "* 따 르 릉 ..\E0./");
ds_map_add(global.text_data_en, "SCR_TEXT_3240", "안녕^1!&파피루스야!!!/");
ds_map_add(global.text_data_en, "SCR_TEXT_3241", "내가 옷에 관해&물어본 거 기억나?/");
ds_map_add(global.text_data_en, "SCR_TEXT_3242", "\E3그^1, 물어봐달라던&친구 있잖아.../");
ds_map_add(global.text_data_en, "SCR_TEXT_3243", "\E0너를 보는&걔 시선이 무지.../");
ds_map_add(global.text_data_en, "SCR_TEXT_3244", "\E3살인적이더라./");
ds_map_add(global.text_data_en, "SCR_TEXT_3245", "\E0오류!!^1!&나중에 봐!/%%");
ds_map_add(global.text_data_en, "SCR_TEXT_3250", "\E0근데 너도 진작&눈치챘겠지!/");
ds_map_add(global.text_data_en, "SCR_TEXT_3251", "\E3네가 진작&눈치챘기 때문에.../");
ds_map_add(global.text_data_en, "SCR_TEXT_3252", "\E0네가 입은 옷을 네가 말한&그대로 걔한테 말해뒀어!/");
ds_map_add(global.text_data_en, "SCR_TEXT_3253", "\[1] 말이야!/");
ds_map_add(global.text_data_en, "SCR_TEXT_3254", "왜냐하면 나도 눈치챘거든^1,&너라면 분명.../");
ds_map_add(global.text_data_en, "SCR_TEXT_3255", "\E3그런 의심스러운 질문을&받고서는 당연히.../");
ds_map_add(global.text_data_en, "SCR_TEXT_3256", "\E0그 옷을&갈아입을 거라는 사실을!/");
ds_map_add(global.text_data_en, "SCR_TEXT_3257", "넌 정말&똑똑한 놈이야!/");
ds_map_add(global.text_data_en, "SCR_TEXT_3258", "이게 너도 안전하고&나도 거짓말을 안 하는&방법이지!!!/");
ds_map_add(global.text_data_en, "SCR_TEXT_3259", "배신같은 건&일어나지 않는 거라고!!!/");
ds_map_add(global.text_data_en, "SCR_TEXT_3260", "모두와 친구가&되는 거 쉽다!!!/");
ds_map_add(global.text_data_en, "SCR_TEXT_3261", "\TS \F0 \T0 %");
ds_map_add(global.text_data_en, "SCR_TEXT_3262", "* 삑 .../%%");
ds_map_add(global.text_data_en, "SCR_TEXT_3268", "\E0음^1, 걱정하지 말라&인간이여!/");
ds_map_add(global.text_data_en, "SCR_TEXT_3269", "파피루스 님은 절대&널 배신하지 않는다!/");
ds_map_add(global.text_data_en, "SCR_TEXT_3270", "\E3나는 잔인한 놈이&아니다./");
ds_map_add(global.text_data_en, "SCR_TEXT_3271", "\E0나는 편안하고 기분 좋은&친구가 되기 위해&노력한다고./");
ds_map_add(global.text_data_en, "SCR_TEXT_3272", "파피루스!&그는 달과 같은&냄새가 나지./");
ds_map_add(global.text_data_en, "SCR_TEXT_3273", "그래서, 내 착한&성격 때문에.../");
ds_map_add(global.text_data_en, "SCR_TEXT_3274", "네가 그걸 입고 있지&않다고 말해줬어!/");
ds_map_add(global.text_data_en, "SCR_TEXT_3275", "\E3너는 입고 있다고&말했지만 말이지!/");
ds_map_add(global.text_data_en, "SCR_TEXT_3276", "대신에^1, 조금은&지어냈어!/");
ds_map_add(global.text_data_en, "SCR_TEXT_3277", "네가 입고 있는 걸&좀 바꿔 말했지.../");
ds_map_add(global.text_data_en, "SCR_TEXT_3278", "\E0\[2]\[마]라고./");
ds_map_add(global.text_data_en, "SCR_TEXT_3279", "\E3내가 그런 뻔뻔한&거짓말을 했다는 게&슬퍼./");
ds_map_add(global.text_data_en, "SCR_TEXT_3280", "너라면 절대 그런 건&안 입을 거란 걸&알거든./");
ds_map_add(global.text_data_en, "SCR_TEXT_3281", "\E0그치만 네 안전이&패션보다 훨씬 더&중요하지./");
ds_map_add(global.text_data_en, "SCR_TEXT_3282", "\E3젠장!/");
ds_map_add(global.text_data_en, "SCR_TEXT_3283", "모두랑 친구가&되고 싶을 뿐인데.../");
ds_map_add(global.text_data_en, "SCR_TEXT_3284", "\TS \F0 \T0 %");
ds_map_add(global.text_data_en, "SCR_TEXT_3285", "* 삑 .../%%");
ds_map_add(global.text_data_en, "SCR_TEXT_3291", "\E0음^1, 걱정하지 말라&인간이여!/");
ds_map_add(global.text_data_en, "SCR_TEXT_3292", "\E3나 파피루스는 절대&너를 배신하지 않는다!/");
ds_map_add(global.text_data_en, "SCR_TEXT_3293", "\W네\E0가 입고 있는 게\Y &\[1] 아니라던데&\W./");
ds_map_add(global.text_data_en, "SCR_TEXT_3294", "\E3그래서 당연히&사실대로 전해 줬지.../");
ds_map_add(global.text_data_en, "SCR_TEXT_3295", "\E0네가 입고 있던 게&\[2]\[마]라고!/");
ds_map_add(global.text_data_en, "SCR_TEXT_3296", "\E3내가 그런 뻔뻔한&거짓말을 했다는 게&슬퍼./");
ds_map_add(global.text_data_en, "SCR_TEXT_3297", "너라면 절대 그런 건&안 입을 거란 걸&알거든./");
ds_map_add(global.text_data_en, "SCR_TEXT_3298", "\E0분명 언다인은&널 공격하지&않을 거야!/");
ds_map_add(global.text_data_en, "SCR_TEXT_3299", "이제 넌&무사 오케이란 거지./");
ds_map_add(global.text_data_en, "SCR_TEXT_3300", "\E2세에상에..^1.&이거 참 힘드네./");
ds_map_add(global.text_data_en, "SCR_TEXT_3301", "나는 단지 모두와&친구가 되고 싶을&뿐이야!/");
ds_map_add(global.text_data_en, "SCR_TEXT_3302", "\TS \F0 \T0 %");
ds_map_add(global.text_data_en, "SCR_TEXT_3303", "* 삑 .../%%");
ds_map_add(global.text_data_en, "SCR_TEXT_3309", "\E0근데 넌 이미&알고 있을 거야!/");
ds_map_add(global.text_data_en, "SCR_TEXT_3310", "\E3왜냐하면, 너도&알 테지만.../");
ds_map_add(global.text_data_en, "SCR_TEXT_3311", "\E0네가 말한 그 말.../");
ds_map_add(global.text_data_en, "SCR_TEXT_3312", '\E3"나 지금 \[1]&안 입고 있어."/');
ds_map_add(global.text_data_en, "SCR_TEXT_3313", "\E0가 실은 비밀 암호란 걸&알고 있었지!!/");
ds_map_add(global.text_data_en, "SCR_TEXT_3314", "\E3네가 정말&말하고 싶었던 건.../");
ds_map_add(global.text_data_en, "SCR_TEXT_3315", '\E0"나 지금 완전&\[1] 입고 있어!" 였지!/');
ds_map_add(global.text_data_en, "SCR_TEXT_3316", "자신을 지키기&위해서였겠지.../");
ds_map_add(global.text_data_en, "SCR_TEXT_3317", "내가 거짓말을&하지 않도록&도와주면서 말이야!/");
ds_map_add(global.text_data_en, "SCR_TEXT_3318", "그래서 나는&네 계획을 알아채고&맞장구 쳐 줬지./");
ds_map_add(global.text_data_en, "SCR_TEXT_3319", "네가 그걸 입고 있지&않다고 말해줬어!/");
ds_map_add(global.text_data_en, "SCR_TEXT_3320", "게다가 내가&한 발짝 더&앞서나갔다고!/");
ds_map_add(global.text_data_en, "SCR_TEXT_3321", "\E3네가 입고 있는 옷을&다르게 말했거든.../");
ds_map_add(global.text_data_en, "SCR_TEXT_3322", "\E0\[2]\[마]라고!/");
ds_map_add(global.text_data_en, "SCR_TEXT_3323", "\E3물론, 너는 절대&그걸 입고 있지&않았지./");
ds_map_add(global.text_data_en, "SCR_TEXT_3324", "\E0그치만 그게&핵심이야!/");
ds_map_add(global.text_data_en, "SCR_TEXT_3325", "걔는 이제&너를 알아보지&못 할 거야!/");
ds_map_add(global.text_data_en, "SCR_TEXT_3326", "그리고 나는&너희 둘을&배신할 필요가 없었지!/");
ds_map_add(global.text_data_en, "SCR_TEXT_3327", "그냥 너에게&들은 말을&전달했던 거니까!/");
ds_map_add(global.text_data_en, "SCR_TEXT_3328", "세에상에^1!&너 정말&똑똑한 녀석이구나!/");
ds_map_add(global.text_data_en, "SCR_TEXT_3329", "나 정말&모두와 친구가&될 수 있구나!/");
ds_map_add(global.text_data_en, "SCR_TEXT_3330", "\TS \F0 \T0 %");
ds_map_add(global.text_data_en, "SCR_TEXT_3331", "* 삑 .../%%");
ds_map_add(global.text_data_en, "SCR_TEXT_3337", "* 따 르 릉 ..\E0./");
ds_map_add(global.text_data_en, "SCR_TEXT_3339", "어이^1!&잘 지내!?/");
ds_map_add(global.text_data_en, "SCR_TEXT_3340", "그냥 좀&생각해 본 건데.../");
ds_map_add(global.text_data_en, "SCR_TEXT_3341", "너랑^1, 나랑^1, 그리고&언다인이랑 언제&한번 놀자!/");
ds_map_add(global.text_data_en, "SCR_TEXT_3342", "너희 둘이&엄청 친해질 수&있을 것 같아!/");
ds_map_add(global.text_data_en, "SCR_TEXT_3343", "나중에&걔 집에서&같이 만나자!/");
ds_map_add(global.text_data_en, "SCR_TEXT_3344", "\TS \F0 \T0 %");
ds_map_add(global.text_data_en, "SCR_TEXT_3345", "* 삑 .../%%");
ds_map_add(global.text_data_en, "SCR_TEXT_3348", "나랑 같이&논 다음에.../");
ds_map_add(global.text_data_en, "SCR_TEXT_3349", "걔 집에서&같이 만나자!/");
ds_map_add(global.text_data_en, "SCR_TEXT_3350", "너희 둘이&엄청 친해질 수&있을 것 같아!/");
ds_map_add(global.text_data_en, "SCR_TEXT_3351", "\TS \F0 \T0 %");
ds_map_add(global.text_data_en, "SCR_TEXT_3352", "* 삑 .../%%");
ds_map_add(global.text_data_en, "SCR_TEXT_3393", "* ('괴 물 사  제 7권 ' 이 라 는&  제 목 의  책 이 다 .)&         읽 는 다       안  읽 는 다 \C");
ds_map_add(global.text_data_en, "SCR_TEXT_3394", " ");
ds_map_add(global.text_data_en, "SCR_TEXT_3398", "* 인 간 이  죽 게  되 면 ^1, 영 혼 은&  육 체 의  바 깥 에 서  안 정 한  상 태 로&  남 아 있 게  된 다 ./");
ds_map_add(global.text_data_en, "SCR_TEXT_3399", "* 반 면 ^1, 괴 물 의  영 혼 은&  죽 은  직 후  바 로&  사 라 져  버 린 다 ./");
ds_map_add(global.text_data_en, "SCR_TEXT_3400", "* 따 라 서  괴 물 들 은&  인 간 의  영 혼 을&  흡 수 할  수  있 다 ./");
ds_map_add(global.text_data_en, "SCR_TEXT_3401", "* 한 편  인 간 이  괴 물 의  영 혼 을&  흡 수 하 는  것 은&  극 도 로  어 려 우 므 로 ./");
ds_map_add(global.text_data_en, "SCR_TEXT_3402", "* 인 간 은  우 리 를  두 려 워 한 다 ./");
ds_map_add(global.text_data_en, "SCR_TEXT_3403", "* 괴 물 들 의  힘 은  약 하 지 만 ^1,&  충 분 한  인 간 의  영 혼 만  있 다 면 .../");
ds_map_add(global.text_data_en, "SCR_TEXT_3404", "* 인 류 를  손 쉽 게&  파 괴 할  수  있 다 ./%%");
ds_map_add(global.text_data_en, "SCR_TEXT_3407", "* (당 신 은  읽 지  않 기 로  했 다 .)/%%");
ds_map_add(global.text_data_en, "SCR_TEXT_3413", "('괴 물 사  제 8권 ' 이 라 는&  제 목 의  책 이 다 .)&         읽 는 다       안  읽 는 다 \C");
ds_map_add(global.text_data_en, "SCR_TEXT_3414", " ");
ds_map_add(global.text_data_en, "SCR_TEXT_3418", "* 앞 에 서  언 급 된  규 칙  중&  한  가 지  예 외 가  있 다 ./");
ds_map_add(global.text_data_en, "SCR_TEXT_3419", '* 특 정  유 형 의  괴 물 ^1,&  예 컨 대 "보 스 " 몬 스 터 의 경 우 ./');
ds_map_add(global.text_data_en, "SCR_TEXT_3420", "* 그  생 활  특 성 상 ^1, 그 들 은&  괴 물 치 고 는  매 우  강 한&  영 혼 을  가 진 다 ./");
ds_map_add(global.text_data_en, "SCR_TEXT_3421", "* 잠 깐 이 지 만 ^1, 그  영 혼 은&  죽 은  이 후 에 도&  남 아 있 을  수  있 다 ./%%");
ds_map_add(global.text_data_en, "SCR_TEXT_3424", "* (당 신 은  읽 지  않 기 로  했 다 .)/%%");
ds_map_add(global.text_data_en, "SCR_TEXT_3429", '* (여 기  있 는  책 들 은  모 두&  "인 간 사 " 라 는  제 목 의  책 이 다 .)&         읽 는 다       안  읽 는 다 \C');
ds_map_add(global.text_data_en, "SCR_TEXT_3430", " ");
ds_map_add(global.text_data_en, "SCR_TEXT_3434", "* (당 신 은  책 을  펼 쳐 보 았 다 .)/");
ds_map_add(global.text_data_en, "SCR_TEXT_3435", "* (거 대 한  로 봇 이  아 름 다 운&  외 계 인  공 주 와  싸 우 는&  내 용 의  만 화 책 이 다 .)/");
ds_map_add(global.text_data_en, "SCR_TEXT_3436", "* (썩  제 대 로  와 닿 지 는  않 는 다 ...)/%%");
ds_map_add(global.text_data_en, "SCR_TEXT_3441", "* (읽 지  않 기 로  했 다 .)/%%");
ds_map_add(global.text_data_en, "SCR_TEXT_3446", '* (여 기  있 는  책 들 은  모 두&  "인 간 사 " 라 는  제 목 의  책 이 다 .)&         읽 는 다       안  읽 는 다 \C');
ds_map_add(global.text_data_en, "SCR_TEXT_3447", " ");
ds_map_add(global.text_data_en, "SCR_TEXT_3451", "* (당 신 은  책 을  펼 쳐 보 았 다 .)&* (만 화 책 이 다 .)/");
ds_map_add(global.text_data_en, "SCR_TEXT_3452", "* (두  명 의  헐 벗 은  셰 프 가&  에 너 지  팬 케 이 크 를&  서 로 에 게  집 어 던 지 고  있 다 .)/");
ds_map_add(global.text_data_en, "SCR_TEXT_3453", "* (썩  제 대 로  와 닿 지 는  않 는 다 ...)/%%");
ds_map_add(global.text_data_en, "SCR_TEXT_3458", "* (읽 지  않 기 로  했 다 .)/%%");
ds_map_add(global.text_data_en, "SCR_TEXT_3463", '* (여 기  있 는  책 들 은  모 두&  "인 간 사 " 라 는  제 목 의  책 이 다 .)&         읽 는 다       안  읽 는 다 \C');
ds_map_add(global.text_data_en, "SCR_TEXT_3464", " ");
ds_map_add(global.text_data_en, "SCR_TEXT_3469", "* (당 신 은  책 을  펼 쳐 보 았 다 .)&* (만 화 책 이 다 .)/");
ds_map_add(global.text_data_en, "SCR_TEXT_3470", "* (괴 상 한  안 드 로 이 드 가&  입 에  토 스 트 를  물 고&  학 교 로  달 려 가 고  있 다 .)/");
ds_map_add(global.text_data_en, "SCR_TEXT_3471", "* (아 마  지 각 한  것  같 다 .)/");
ds_map_add(global.text_data_en, "SCR_TEXT_3472", "* (썩  제 대 로  와 닿 지 는  않 는 다 ...)/%%");
ds_map_add(global.text_data_en, "SCR_TEXT_3477", "* (읽 지  않 기 로  했 다 .)/%%");
ds_map_add(global.text_data_en, "SCR_TEXT_3482", "* (피 아 노 가  있 다 ^1.)&* (연 주 하 겠 습 니 까 ?)&         예           아 니 요\C");
ds_map_add(global.text_data_en, "SCR_TEXT_3483", " ");
ds_map_add(global.text_data_en, "SCR_TEXT_3487", " %%");
ds_map_add(global.text_data_en, "SCR_TEXT_3488", " ");
ds_map_add(global.text_data_en, "SCR_TEXT_3495", "하 트  모 양 이  보 이 지 ^1?&저 게  네  영 혼 이 야 ^1.&네  존 재 의  정 수 지 !/");
ds_map_add(global.text_data_en, "SCR_TEXT_3496", "네  영 혼 은  약 하 지 만 ^1,&LV를  많 이  올 리 면&강 해 질  수  있 어 ./");
ds_map_add(global.text_data_en, "SCR_TEXT_3497", "LV가  뭐 냐 고 ^1?&바 로 ^1, LOVE지 ^1, 물 론 !/");
ds_map_add(global.text_data_en, "SCR_TEXT_3498", "LOVE가  좀  필 요 한  것&같 은 데 , 그 렇 지 ?/");
ds_map_add(global.text_data_en, "SCR_TEXT_3499", "걱 정 하 지  마 ,&내 가  좀  나 눠 줄 게 !/%");
ds_map_add(global.text_data_en, "SCR_TEXT_3503", "여 기  지 하  세 계 에 선 ^1,&LOVE를 ..^1./");
ds_map_add(global.text_data_en, "SCR_TEXT_3504", '작 고  하 얀 ..^2. \E1 &"친 절  알 갱 이 "로&서 로  나 누 지 ./');
ds_map_add(global.text_data_en, "SCR_TEXT_3505", "\E2준 비 됐 어 \E0?/%");
ds_map_add(global.text_data_en, "SCR_TEXT_3509", "움 직 여 ^1!&친 절 을  최 대 한&많 이  받 는  거 야 ^2!%%%");
ds_map_add(global.text_data_en, "SCR_TEXT_3510", "%%%");
ds_map_add(global.text_data_en, "SCR_TEXT_3514", "멍 청 하 긴 ./");
ds_map_add(global.text_data_en, "SCR_TEXT_3515", "이  세 상 은 ^1, 죽 거 나&죽 이 거 나 라 고 ./");
ds_map_add(global.text_data_en, "SCR_TEXT_3516", "누 가  이 런  기 회 를&내 다  버 리 겠 어 !?/%");
ds_map_add(global.text_data_en, "SCR_TEXT_3520", "죽  어 ./%");
ds_map_add(global.text_data_en, "SCR_TEXT_3524", "이 봐  친 구 ^1,&놓 쳐 버 렸 잖 아 ./");
ds_map_add(global.text_data_en, "SCR_TEXT_3525", "다 시  해  보 자 고 ^1,&알 았 지 ?/%");
ds_map_add(global.text_data_en, "SCR_TEXT_3528", "장 난 치 는  거 야 ^2?&너  무 뇌 아 니 ^2?&달 려 ^2. 가 라 고 ^2. 저 ^2.&총 알 로 !!!");
ds_map_add(global.text_data_en, "SCR_TEXT_3531", "눈 치 채 고  있 었 던&거 지 ^1, 응 ?/");
ds_map_add(global.text_data_en, "SCR_TEXT_3532", "그 저  날  괴 롭 히 고&싶 었 을  뿐 이 었 어 ./%");
ds_map_add(global.text_data_en, "SCR_TEXT_3535", "\E1저 런  나 쁜  것&같 으 니 ^1, 순 수 하 고&가 여 운  아 이 를 ^1,&괴 롭 히 다 니 .../");
ds_map_add(global.text_data_en, "SCR_TEXT_3536", "\E2아 , 무 서 워 하 지&말 렴 ^1. 아 가 야 ./");
ds_map_add(global.text_data_en, "SCR_TEXT_3537", "\X내  이 름 은  \B토 리 엘\X ,&\R폐 허 \X의  관 리 자 란 다 ./");
ds_map_add(global.text_data_en, "SCR_TEXT_3538", "떨 어 진  아 이 는  없 나&매 일  이 곳 을&둘 러 보 고  있 지 ./");
ds_map_add(global.text_data_en, "SCR_TEXT_3539", "너 같 은  인 간 이&떨 어 진  건  무 척&오 랜 만 이 로 구 나 ./");
ds_map_add(global.text_data_en, "SCR_TEXT_3540", "네 가  여 기  있 는&동 안 에 는  최 선 을&다 해  지 켜 주 마 ./%%");
ds_map_add(global.text_data_en, "SCR_TEXT_3541", "\E2이 리  오 렴 ^2!&유 적 을  지 나 가 도 록&도 와 줄 게 ./%%");
ds_map_add(global.text_data_en, "SCR_TEXT_3542", "%%%");
ds_map_add(global.text_data_en, "SCR_TEXT_3548", "* 골 드  세  닢 에  태 워  줄 게 .& &         예           아 니 요\C");
ds_map_add(global.text_data_en, "SCR_TEXT_3549", " ");
