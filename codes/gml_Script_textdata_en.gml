ds_map_add(global.text_data_en, "obj_cookshowevent_309", "\E4* 채 식 주 의 자 라 면 ?/");
ds_map_add(global.text_data_en, "obj_cookshowevent_310", "\TS \E3 \F0 \TM %");
ds_map_add(global.text_data_en, "obj_cookshowevent_311", "* ...채 식 주 의 자 라 고 요 ./");
ds_map_add(global.text_data_en, "obj_cookshowevent_312", "\TS \E5 \F6 \TA %");
ds_map_add(global.text_data_en, "obj_cookshowevent_313", "* 어 , 그 러 니 까&  내  말 은%%");
ds_map_add(global.text_data_en, "obj_cookshowevent_326", "* 좋 은  생 각 이 에 요 ,&  알 피 스 !/");
ds_map_add(global.text_data_en, "obj_cookshowevent_327", "* 사 실 , 다 른  선 택 지 가&  바 로  여 기  있 었 어 요 !!/");
ds_map_add(global.text_data_en, "obj_cookshowevent_328", "* MTT 브 랜 드 , 항 시  편 리 한&  인 간  영 혼  맛  대 체  음 식 !/");
ds_map_add(global.text_data_en, "obj_cookshowevent_329", "* 그 러 니 까  그  캔 이 ...&  바 로  저  카 운 터 에  있 군 요 !!!/%%");
ds_map_add(global.text_data_en, "obj_cookshowevent_376", "* 어 , 달 링 ?&* 가 져 다  주 지  않 겠 어 요 ?/%%");
ds_map_add(global.text_data_en, "obj_cookshowevent_434", "* 그 나 저 나 ^1, 저 희  쇼 는&  스 케 줄 이  좀  빠 듯 해 서 요 ./");
ds_map_add(global.text_data_en, "obj_cookshowevent_435", "\W* \Y1분\W  내 로  저  캔 을&  가 져 오 시 지  못  한 다 면 ../");
ds_map_add(global.text_data_en, "obj_cookshowevent_436", "\W* 그 냥  \R원 래  계 획 \W대 로&  진 행 해 야 겠 습 니 다 !!!/");
ds_map_add(global.text_data_en, "obj_cookshowevent_437", "* 그 러 니 ...&* 당 장  올 라 가 는  게&  좋 을  거 예 요 , 예 쁜 이 !!!/%%");
ds_map_add(global.text_data_en, "obj_cookshowevent_472", "* 따 르 릉 .../");
