ds_map_add(global.text_data_en, "obj_undynedate_inside_351", "* 도 전 !^1?&* 뭐 라 고 !?/");
ds_map_add(global.text_data_en, "obj_undynedate_inside_352", "\E0* 기 다 려 ^1!&* 파 피 루 스 ...!/%%");
