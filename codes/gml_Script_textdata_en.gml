ds_map_add(global.text_data_en, "obj_undynedate_inside_370", "* 너 같 은  놈  따 윈&  단 숨 에  친 구 로&  만 들  수  있 다 !/");
ds_map_add(global.text_data_en, "obj_undynedate_inside_371", "\E2* 보 여 주 지 !/");
ds_map_add(global.text_data_en, "obj_undynedate_inside_372", "\E3* 잘  들 어 라 ^1, 인 간 ./");
ds_map_add(global.text_data_en, "obj_undynedate_inside_373", "\E2* 우 린  그 냥  평 범 한&  친 구 가  되 는  게&  아 냐 ./");
ds_map_add(global.text_data_en, "obj_undynedate_inside_374", "\E3* 우 리 는  현  시 간 부 로 .../");
ds_map_add(global.text_data_en, "obj_undynedate_inside_375", "\M1* 베 프 가  된 다 ./");
ds_map_add(global.text_data_en, "obj_undynedate_inside_376", "* 넌  이 제  내 게&  푹  빠 져 서 .../");
