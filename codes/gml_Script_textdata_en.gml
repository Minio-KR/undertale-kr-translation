ds_map_add(global.text_data_en, "obj_adate_870", "\E0아 -안 녕 \M3 언 다 인 ..^1.&자 -잘  지 내 고&있 어 ?/*");
ds_map_add(global.text_data_en, "obj_adate_884", "                              &   그 럼 .           오 늘  &                   귀 엽 네");
ds_map_add(global.text_data_en, "obj_adate_907", "\E5하 ^1! 하 ^1!&다 행 이 네!!/");
ds_map_add(global.text_data_en, "obj_adate_908", "\E3.../");
ds_map_add(global.text_data_en, "obj_adate_909", "\E4어 어 ^1, 그 래 서  음 ^1,&얘 기 하 고  싶 은  게&있 는 데 ./%%");
ds_map_add(global.text_data_en, "obj_adate_913", "\E5고 ..^1. 고 마 워 !/");
ds_map_add(global.text_data_en, "obj_adate_914", "\E6넌  늘  그 렇 게  말 해&주 지 만 ^1, 어 떻 게&대 답 해 야  할 지&몰 랐 거 든 !!/");
ds_map_add(global.text_data_en, "obj_adate_915", "\E6하 지 만 ^1, 그 ^1,&정 신 적 인  사 랑 이 겠 지 ^1,&우 린  그 저  친 구 니 까 !/");
ds_map_add(global.text_data_en, "obj_adate_916", "\M1으 헤 헤 !!!/");
