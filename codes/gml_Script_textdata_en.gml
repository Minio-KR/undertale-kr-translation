ds_map_add(global.text_data_en, "SCR_TEXT_1520", "* 여 기 ^1.&* (당 신 은  나 이 스 크 림 을  얻 었 다 .)/%%");
ds_map_add(global.text_data_en, "SCR_TEXT_1522", "* 돈 을  충 분 히&  갖 고  있 지  않 구 나 .../%%");
ds_map_add(global.text_data_en, "SCR_TEXT_1525", "* 짐 을  덜 어 봐 ./%%");
ds_map_add(global.text_data_en, "SCR_TEXT_1528", "* 그 렇 다 면  말 이 지 ..^1.&* 네  친 구 들 에 게  전 해 .../");
ds_map_add(global.text_data_en, "SCR_TEXT_1529", "* 삶 은 ..^1. 고 통 이 야 ./%%");
ds_map_add(global.text_data_en, "SCR_TEXT_1535", "* (황 금 꽃 이 다 .^1)&* (떨 어 질  때&  당 신 을  받 쳐  준  모 양 이 다 .)/%%");
ds_map_add(global.text_data_en, "SCR_TEXT_1536", "%%%");
ds_map_add(global.text_data_en, "SCR_TEXT_1540", '* "\*Z를  눌 러  팻 말 을  읽 으 세 요 !"/%%');
ds_map_add(global.text_data_en, "SCR_TEXT_1544", "* 평 범 한  낡 은  기 둥 이 다 ./%%");
ds_map_add(global.text_data_en, "SCR_TEXT_1548", "* 낙 엽 을  밟 지  마 시 오 ./%%");
ds_map_add(global.text_data_en, "SCR_TEXT_1552", "* 아 래 층 의  표 지 판 을&  읽 지  않 았 습 니 까 ?/%%");
ds_map_add(global.text_data_en, "SCR_TEXT_1562", "* 어 허 ^1, 이 보 쇼 ^2!&* 누 가  밀 어 도&  좋 다 고  했 지 ?/");
ds_map_add(global.text_data_en, "SCR_TEXT_1563", "* 음 ^2?&* 그 러 니 까  저 쪽 으 로&  움 직 여  달 라 고 ?/");
ds_map_add(global.text_data_en, "SCR_TEXT_1564", "* 좋 아 ^1, 특 별 히  해  주 지 ^1,&  귀 염 둥 이 ./%%");
ds_map_add(global.text_data_en, "SCR_TEXT_1569", "* 음 ^2?&* 조 금  더  움 직 여  달 라 고 ?/");
ds_map_add(global.text_data_en, "SCR_TEXT_1570", "* 좋 았 어 ^1, 이 건  어 때 ?/%%");
ds_map_add(global.text_data_en, "SCR_TEXT_1575", "* 음 ^2?&* 이  방 향 이  아 니 었 나 ?/");
ds_map_add(global.text_data_en, "SCR_TEXT_1576", "* 좋 아 ^1, 이 제  알 겠 다 ./%%");
ds_map_add(global.text_data_en, "SCR_TEXT_1579", "* 도 움 이  됐 나 ?/%%");
ds_map_add(global.text_data_en, "SCR_TEXT_1583", "* 음 ^2?&* 저  자 리 에  그 대 로  있 으 라 고 ?/");
ds_map_add(global.text_data_en, "SCR_TEXT_1584", "* 아 주  제 대 로&  굴 리 는 군  그 래 ./%%");
ds_map_add(global.text_data_en, "SCR_TEXT_1589", "* 그 냥  부 탁 하 면&  어 디  덧 나 나 ?/%%");
ds_map_add(global.text_data_en, "SCR_TEXT_1592", "* 출 구 가  열 렸 다 고 ^1?&* 새 빠 지 게  굴 러 야 겠 는 데 .../");
ds_map_add(global.text_data_en, "SCR_TEXT_1593", "* 어 이 ^1, 좀&  밀 어 주 지  않 겠 나 ^1, 귀 염 둥 이 ?/%%");
ds_map_add(global.text_data_en, "SCR_TEXT_1603", "* '하 나 만  가 져 가 시 오 .'&* 하 나 를  가 져 갑 니 까 ?&         예           아 니 요 \C");
ds_map_add(global.text_data_en, "SCR_TEXT_1604", "* '하 나 만  가 져 가 시 오 .'라  쓰 였 다 .&* 하 나 를  가 져 갑 니 까 ?&         예           아 니 요 \C");
ds_map_add(global.text_data_en, "SCR_TEXT_1606", "* 당 신 이  저 지 른  짓 을  보 라 ./%%");
ds_map_add(global.text_data_en, "SCR_TEXT_1607", " ");
ds_map_add(global.text_data_en, "SCR_TEXT_1624", "* 당 신 은  사 탕  한  개 를  집 었 다 .&* (\*C를  눌 러  메 뉴 를  여 시 오 .)/%%");
ds_map_add(global.text_data_en, "SCR_TEXT_1625", "* 당 신 은  사 탕 을  더  가 져 갔 다 ^1.&* 역 겨 워 라 .../%%");
ds_map_add(global.text_data_en, "SCR_TEXT_1626", "* 당 신 은  한  개 를  더  집 었 다 .&* 인 간 쓰 레 기 가&  된  기 분 이 다 .../%%");
ds_map_add(global.text_data_en, "SCR_TEXT_1628", "* 당 신 은  너 무  급 히  집 어 들 었 다 .&* 사 탕 이  바 닥 에  쏟 아 졌 다 ./%%");
ds_map_add(global.text_data_en, "SCR_TEXT_1631", "* 이  지 옥 같 은  세 상 에 서 는 ^1,&  단  3개 의  사 탕 만 이&  허 락 되 는  법 이 다 .../%%");
ds_map_add(global.text_data_en, "SCR_TEXT_1635", "* 사 탕 을  집 으 려  했 으 나 ^1,&  넣 을  곳 이  없 었 다/%%");
ds_map_add(global.text_data_en, "SCR_TEXT_1639", "* 가 져 가 지  않 기 로  했 다 ./%%");
ds_map_add(global.text_data_en, "SCR_TEXT_1675", "* '다  가 져 가 .' 라 고  쓰 여  있 다 .&* 사 탕 을  가 져 갑 니 까 ?&         예           아 니 요 \C");
ds_map_add(global.text_data_en, "SCR_TEXT_1676", " ");
ds_map_add(global.text_data_en, "SCR_TEXT_1692", "* 조 금  가 져 갔 다 .&* 이 런 ^1, 너 무  무 겁 다 ./%%");
ds_map_add(global.text_data_en, "SCR_TEXT_1694", "* 더 는  가 져 갈  수  없 다 .&* 너 무  무 겁 다 ./%%");
ds_map_add(global.text_data_en, "SCR_TEXT_1695", "* 사 탕 을  집 으 려  했 으 나 ^1,&  넣 을  곳 이  없 었 다/%%");
ds_map_add(global.text_data_en, "SCR_TEXT_1698", "* 가 져 가 지  않 기 로  했 다 ./%%");
ds_map_add(global.text_data_en, "SCR_TEXT_1644", "* zzzzzzzzzzzzzzz..^1.&* zzzzzzzzzzzzzz.../");
ds_map_add(global.text_data_en, "SCR_TEXT_1645", "* zzzzzzzzzz..^1.&* (아 직  안  갔 나 ^1)&* zzzzzzzzzzzzzzz.../");
ds_map_add(global.text_data_en, "SCR_TEXT_1646", "* (유 령 이  큰  소 리 로&  반 복 해 서  'z'라 고  말 하 면 서 ^1,&  자 는  척 을  하 고  있 다 .)/");
ds_map_add(global.text_data_en, "SCR_TEXT_1647", "* 강 제 로  옮 깁 니 까 ?& &         예           아 니 요 \C");
ds_map_add(global.text_data_en, "SCR_TEXT_1648", " ");
ds_map_add(global.text_data_en, "SCR_TEXT_1705", "* 거 미 줄 에  7G를  둡 니 까 ?& &         예           아 니 요 \C");
ds_map_add(global.text_data_en, "SCR_TEXT_1706", " ");
ds_map_add(global.text_data_en, "SCR_TEXT_1723", "* 거 미 들 이  기 어 내 려 와 서&  도 넛 을  건 네 주 었 다 ./%%");
ds_map_add(global.text_data_en, "SCR_TEXT_1724", "* 돈 이  충 분 하 지  않 다 ./%%");
ds_map_add(global.text_data_en, "SCR_TEXT_1726", "* 너 무  많 이  들 고  있 다 ./%%");
ds_map_add(global.text_data_en, "SCR_TEXT_1729", "*%%");
ds_map_add(global.text_data_en, "SCR_TEXT_1736", "* 거 미 줄 에  18G를  둡 니 까 ?& &         예           아 니 요 \C");
ds_map_add(global.text_data_en, "SCR_TEXT_1737", " ");
ds_map_add(global.text_data_en, "SCR_TEXT_1754", "* 거 미 들 이  기 어 내 려 와 서&  병 을  건 네 주 었 다 ./%%");
ds_map_add(global.text_data_en, "SCR_TEXT_1755", "* 돈 이  충 분 하 지  않 다 ./%%");
ds_map_add(global.text_data_en, "SCR_TEXT_1757", "* 너 무  많 이  들 고  있 다 ./%%");
ds_map_add(global.text_data_en, "SCR_TEXT_1760", "*%%");
ds_map_add(global.text_data_en, "SCR_TEXT_1771", "* 빛 바 랜  리 본 을  찾 았 다 ./%%");
ds_map_add(global.text_data_en, "SCR_TEXT_1772", "* 너 무  많 이  들 고  있 다 ./%%");
ds_map_add(global.text_data_en, "SCR_TEXT_1778", "* 스 위 치 가  있 다 .&* 누 르 시 겠 습 니 까 ?&         예           아 니 요 \C");
ds_map_add(global.text_data_en, "SCR_TEXT_1779", " ");
ds_map_add(global.text_data_en, "SCR_TEXT_1788", "* 아 무  일 도  일 어 나 지&  않 았 다 ./%%");
ds_map_add(global.text_data_en, "SCR_TEXT_1789", "%%");
ds_map_add(global.text_data_en, "SCR_TEXT_1790", "* 당 신 은  스 위 치 에&  괜 한  관 심 을  줘&  불 편 하 게  만 들 고  있 다 ./%%");
ds_map_add(global.text_data_en, "SCR_TEXT_1796", "* 스 위 치 가  있 다 .&* 누 르 시 겠 습 니 까 ?&         예           아 니 요 \C");
ds_map_add(global.text_data_en, "SCR_TEXT_1797", " ");
ds_map_add(global.text_data_en, "SCR_TEXT_1806", "* 딸 깍 하 는  소 리 를  들 었 다 ./%%");
ds_map_add(global.text_data_en, "SCR_TEXT_1807", "%%");
ds_map_add(global.text_data_en, "SCR_TEXT_1817", "* 장 난 감  칼 을  발 견 했 다 ./%%");
ds_map_add(global.text_data_en, "SCR_TEXT_1818", "* 너 무  많 이  들 고  있 다 ./%%");
ds_map_add(global.text_data_en, "SCR_TEXT_1824", "* 토 리 엘 의  일 기 장 이 다 .&  동 그 라 미 쳐 진  부 분 을  읽 습 니 까 ?&         예           아 니 요 \C");
ds_map_add(global.text_data_en, "SCR_TEXT_1825", " ");
ds_map_add(global.text_data_en, "SCR_TEXT_1830", "* 당 신 은  일 기 장 을  읽 었 다 .../");
ds_map_add(global.text_data_en, "SCR_TEXT_1831", '* "왜  해 골 에 게&  친 구 가  필 요 할 까 ?"/');
ds_map_add(global.text_data_en, "SCR_TEXT_1832", '* "뼈 에  사 무 치 게  외 로 워 서 ..."/');
ds_map_add(global.text_data_en, "SCR_TEXT_1833", "* 나 머 지  페 이 지 도&  비 슷 한  농 담 들 로&  채 워 져  있 다 ./%%");
ds_map_add(global.text_data_en, "SCR_TEXT_1835", "%%");
ds_map_add(global.text_data_en, "SCR_TEXT_1842", "* 버 터 스 카 치  시 나 몬  파 이&  조 각 을  얻 었 다 ./%%");
ds_map_add(global.text_data_en, "SCR_TEXT_1843", "* 너 무  많 이  들 고  있 다 ./%%");
ds_map_add(global.text_data_en, "SCR_TEXT_1853", "* 달 팽 이  파 이&  조 각 을  얻 었 다 .../%%");
ds_map_add(global.text_data_en, "SCR_TEXT_1854", "* 너 무  많 이  들 고  있 다 ./%%");
ds_map_add(global.text_data_en, "SCR_TEXT_1859", "* 어 서  오 렴 ^1,&  아 가 야 !/");
ds_map_add(global.text_data_en, "SCR_TEXT_1860", "* 파 이 가  아 직&  식 지  않 았 단 다 ./");
ds_map_add(global.text_data_en, "SCR_TEXT_1861", "* 낮 잠 이 라 도  자 고&  오 는  편 이  어 떠 니 .&  네           아 니 요 \C");
ds_map_add(global.text_data_en, "SCR_TEXT_1862", " ");
ds_map_add(global.text_data_en, "SCR_TEXT_1867", "* 좋 은  꿈  꾸 렴 ./%%");
ds_map_add(global.text_data_en, "SCR_TEXT_1870", "\E1* 낮 잠 보 다 는&  나 랑  얘 기 하 고  싶 다 고 ?/");
ds_map_add(global.text_data_en, "SCR_TEXT_1871", "* 벌 써  일 어 났 구 나 ^1, 응 ?/");
ds_map_add(global.text_data_en, "SCR_TEXT_1872", "\E0* 음 ^1, 네 가  여 기 에  있 어 줘 서&  정 말  기 쁘 단 다 ./");
ds_map_add(global.text_data_en, "SCR_TEXT_1873", "* 너 와  같 이  보 고  싶 은   &  아 끼 는  책 들 도&  많 이  있 고 ./");
ds_map_add(global.text_data_en, "SCR_TEXT_1874", "* 내 가  가 장  좋 아 하 는&  벌 레 잡 이  장 소 도&  보 여 주 고  싶 구 나 ./");
ds_map_add(global.text_data_en, "SCR_TEXT_1875", "* 널  위 한  교 육  계 획 도&  짜  놓 았 단 다 ./");
ds_map_add(global.text_data_en, "SCR_TEXT_1876", "* 조 금  놀 랄 지 도&  모 르 겠 지 만 .../");
ds_map_add(global.text_data_en, "SCR_TEXT_1877", "* 난  항 상  선 생 님 이  되 고&  싶 었 단 다 ./");
ds_map_add(global.text_data_en, "SCR_TEXT_1878", "\E1* ...사 실 ^1, 그 렇 게 까 지&  놀 랄 만 한  얘 기 는&  아 니 었 네 ./");
ds_map_add(global.text_data_en, "SCR_TEXT_1879", "\E5* 아 무 튼 ./");
ds_map_add(global.text_data_en, "SCR_TEXT_1880", "\E0* 네 가  이 곳 에 서  살 겠 다 니&  아 주  기 쁘 구 나 ./");
ds_map_add(global.text_data_en, "SCR_TEXT_1881", "\E1* 아 ^1, 하 고  싶 은  말 이&  있 었 지 ?/");
ds_map_add(global.text_data_en, "SCR_TEXT_1882", "* 무 엇 이 니 ?&  아 무 것 도      집 에  가 는&  없 음          방 법 ? \C");
ds_map_add(global.text_data_en, "SCR_TEXT_1883", " ");
ds_map_add(global.text_data_en, "SCR_TEXT_1891", "* 그 래 ^1, 원 하 는  게  있 으 면&  언 제 라 도  말 해 주 렴 ./%%");
ds_map_add(global.text_data_en, "SCR_TEXT_1895", "\E1* 뭐 ^1?&* 여 기 가 ..^1. 이 제  여 기 가&  네  집 이 란 다 ./");
ds_map_add(global.text_data_en, "SCR_TEXT_1896", "* 음 ..^1. 내 가  읽 고  있 는&  책 에  대 해  알 고  싶 니 ?/");
ds_map_add(global.text_data_en, "SCR_TEXT_1897", "\E0* 아 ^1, 안 녕 !/");
ds_map_add(global.text_data_en, "SCR_TEXT_1898", "* 내 가  읽 고  있 는&  책 을  한 번  보 고  싶 니 ?/");
ds_map_add(global.text_data_en, "SCR_TEXT_1899", '\E0* 이 건  "달 팽 이 의&  72가 지  쓰 임 새 "&  라 는  책 이 란 다 ./');
ds_map_add(global.text_data_en, "SCR_TEXT_1900", "* 어 때 ?&              폐 허 에 서 &  좋 다         나 가 는  법 \C");
ds_map_add(global.text_data_en, "SCR_TEXT_1901", " ");
ds_map_add(global.text_data_en, "SCR_TEXT_1907", "* 달 팽 이 에  관 한&  재 미 있 는  사 실 을&  말 해 줄 게 ./");
ds_map_add(global.text_data_en, "SCR_TEXT_1908", "\E1* 음 ^1.^1.^1.&*\E0 달 팽 이 에  관 한&  재 미 있 는  사 실 은  어 때 ?/");
ds_map_add(global.text_data_en, "SCR_TEXT_1909", "\E2* 그 거  알 고  있 니 ?&  달 팽 이 들 은 .../");
ds_map_add(global.text_data_en, "SCR_TEXT_1911", "\E0* 전 기 톱 같 이  생 긴&  치 설 이 라  불 리 는  혀 를&  가 지 고  있 단 다 ./");
ds_map_add(global.text_data_en, "SCR_TEXT_1912", "\E0* 나 이 가  들 면&  가 끔  소 화 기 관 을&  뒤 집 는 단 다 ./");
ds_map_add(global.text_data_en, "SCR_TEXT_1913", "\E0* 구 두 끈 을  끔 찍 하 게&  못  맨 단 다 ./");
ds_map_add(global.text_data_en, "SCR_TEXT_1914", "\E0* 말 을  해 ^2. 정 말 ^2. 느 리 게 ^2!&* 농 담 이 야 ^1, 달 팽 이 들 은&  말 을  하 지  않 아 ./");
ds_map_add(global.text_data_en, "SCR_TEXT_1915", "\E0* 정 말  재 밌 지 .&              폐 허 를 &  네           나 가 는  법 \C");
ds_map_add(global.text_data_en, "SCR_TEXT_1916", " ");
ds_map_add(global.text_data_en, "SCR_TEXT_1921", "* 그 럼 ^1, 또  원 하 는  게&  있 다 면  말 해 주 렴 ./%%");
ds_map_add(global.text_data_en, "SCR_TEXT_1924", "\E1* 잠 깐  해 야  할  일 이&  있 겠 구 나 ^1.&* 여 기  있 으 렴 ./%%");
ds_map_add(global.text_data_en, "SCR_TEXT_1927", "\E0* 할  말 이  있 니 ?&              폐 허 를 &  아 뇨         나 가 는  법 \C");
ds_map_add(global.text_data_en, "SCR_TEXT_1930", " ");
ds_map_add(global.text_data_en, "SCR_TEXT_1934", "* 물 어 볼  것 이  있 다 면 ^1,&  물 어 보 도 록  하 렴 ./%%");
ds_map_add(global.text_data_en, "SCR_TEXT_1935", "\E1* 잠 깐  해 야  할  일 이&  있 단 다 ^1.&* 여 기  있 으 렴 ./%%");
ds_map_add(global.text_data_en, "SCR_TEXT_1936", " ");
ds_map_add(global.text_data_en, "SCR_TEXT_1940", "\E2뇨 호 호.../");
ds_map_add(global.text_data_en, "SCR_TEXT_1941", "나는 너처럼&나약한 녀석도&막을 수 없구나.../");
ds_map_add(global.text_data_en, "SCR_TEXT_1942", "언다인이&나에게&실망할 거야./");
ds_map_add(global.text_data_en, "SCR_TEXT_1943", "나는 절대 왕실 근위대에&들어갈 수 없을 거야..^1.&그리고.../");
ds_map_add(global.text_data_en, "SCR_TEXT_1944", "내 친구 수는&계속 그대로겠지!/");
ds_map_add(global.text_data_en, "SCR_TEXT_1945", "\TS \F0 \T0 %");
ds_map_add(global.text_data_en, "SCR_TEXT_1946", "* (뭐 라 고  말 할 까 ?) &         친 구 가       정 말 &         되 자         한 심 하 군 \C");
ds_map_add(global.text_data_en, "SCR_TEXT_1947", " ");
ds_map_add(global.text_data_en, "SCR_TEXT_1956", "\E0세에상에!^1! 해냈구나!!!/");
ds_map_add(global.text_data_en, "SCR_TEXT_1957", "폭력을 쓰지&않았어!!!/");
ds_map_add(global.text_data_en, "SCR_TEXT_1958", "\E5솔직히 말해서^1,&살짝은 걱정됐거든../");
ds_map_add(global.text_data_en, "SCR_TEXT_1959", "\E0하지만 넌 이미&좋은 사람이&되고 있구나!/");
ds_map_add(global.text_data_en, "SCR_TEXT_1960", "\E7너무 자랑스러워서&울 것만 같아!!!/");
ds_map_add(global.text_data_en, "SCR_TEXT_1961", "\E3...잠깐^1, 내가 너를&잡아야 하는 게&아니었던가...?/");
ds_map_add(global.text_data_en, "SCR_TEXT_1962", "\E0글쎄^1, 알 게 뭐람!/");
ds_map_add(global.text_data_en, "SCR_TEXT_1963", "나는 그저 네가&좋은 사람이&됐으면 좋겠어./");
ds_map_add(global.text_data_en, "SCR_TEXT_1964", "그러니 지난 일은&지난 일로&남겨두자고./");
ds_map_add(global.text_data_en, "SCR_TEXT_1965", "그리고 지하 세계를&벗어나는 방법도&알려주도록 하지!/");
ds_map_add(global.text_data_en, "SCR_TEXT_1966", "동쪽으로 계속 가!/");
ds_map_add(global.text_data_en, "SCR_TEXT_1967", "언젠가는 왕의 성에&도착할 거야./");
ds_map_add(global.text_data_en, "SCR_TEXT_1968", "그럼 여기서&떠날 수 있어!/%%");
ds_map_add(global.text_data_en, "SCR_TEXT_1978", "정말!^1?&네가^1, 나와 친구가&되고 싶다고???/");
ds_map_add(global.text_data_en, "SCR_TEXT_1979", "그래 그렇다면.../");
ds_map_add(global.text_data_en, "SCR_TEXT_1980", "내 생각엔..^1./");
ds_map_add(global.text_data_en, "SCR_TEXT_1981", "네 부탁을 들어줄 수&있을 것 같군!/");
ds_map_add(global.text_data_en, "SCR_TEXT_1982", " %");
ds_map_add(global.text_data_en, "SCR_TEXT_1987", "응^1?&넌 어째서.../");
ds_map_add(global.text_data_en, "SCR_TEXT_1988", "그렇게 큰 소리로&자책하는 거야???/");
ds_map_add(global.text_data_en, "SCR_TEXT_1989", "그게 혹시.../");
ds_map_add(global.text_data_en, "SCR_TEXT_1990", "\E3나와 친구가 되기엔&부족하다고 생각하는 건&아니겠지?/");
ds_map_add(global.text_data_en, "SCR_TEXT_1991", "\E0아니야!!^1!&너는 최고야!!^1!&너의 친구가 되어주지!/");
ds_map_add(global.text_data_en, "SCR_TEXT_1996", "세에상에!^1!&아직 첫 번째 데이트도&하지 않았는데.../");
ds_map_add(global.text_data_en, "SCR_TEXT_1997", "벌써 내가 어장에&들어버리다니!!!/");
ds_map_add(global.text_data_en, "SCR_TEXT_1998", "내가 해야 했던 게&친구 만들기였을&줄이야.../");
ds_map_add(global.text_data_en, "SCR_TEXT_2002", "와우!!!/");
ds_map_add(global.text_data_en, "SCR_TEXT_2003", "나 친구가 생겼어!!!/");
ds_map_add(global.text_data_en, "SCR_TEXT_2004", "누가 알았겠어&친구를 만들기&위해선.../");
ds_map_add(global.text_data_en, "SCR_TEXT_2006", "끔찍한 퍼즐을&풀게 하고&싸워야 했다니 말야??/");
ds_map_add(global.text_data_en, "SCR_TEXT_2007", "너에게서 많은 것을&배웠다^1, 인간./");
ds_map_add(global.text_data_en, "SCR_TEXT_2008", "지나갈 수 있도록&이 몸이 허락해주지!/");
ds_map_add(global.text_data_en, "SCR_TEXT_2009", "그리고 지상으로 가는&방향을 알려주겠다./");
ds_map_add(global.text_data_en, "SCR_TEXT_2010", "동굴의 끝에&다다를 때까지&앞으로 나가./");
ds_map_add(global.text_data_en, "SCR_TEXT_2011", "\W그리고..^1. 수도에 다다르면^1,&\Y결계\W를 건너./");
ds_map_add(global.text_data_en, "SCR_TEXT_2012", "그게 우리 모두를&지하 세계에 묶어두고 있는&마법 봉인이야./");
ds_map_add(global.text_data_en, "SCR_TEXT_2013", "어떤 것이든 통과해서&들어올 수 있지만^1,&나가는 것은 안 돼./");
ds_map_add(global.text_data_en, "SCR_TEXT_2014", "...강한 영혼을&지닌 사람을&제외하곤 말이야./");
ds_map_add(global.text_data_en, "SCR_TEXT_2015", "...바로 너처럼!!!/");
ds_map_add(global.text_data_en, "SCR_TEXT_2016", "그래서 왕은&인간을 원하고&있는 거야./");
ds_map_add(global.text_data_en, "SCR_TEXT_2017", "왕은 영혼의 힘으로&결계를 열고 싶어해./");
ds_map_add(global.text_data_en, "SCR_TEXT_2018", "그렇게만 된다면&괴물들은 지상으로&돌아갈 수 있어!/%%");
ds_map_add(global.text_data_en, "SCR_TEXT_2023", "다시 돌아왔구나?!?!/");
ds_map_add(global.text_data_en, "SCR_TEXT_2024", "그 진짜 이유를&잘 알겠어/");
ds_map_add(global.text_data_en, "SCR_TEXT_2025", "너.../");
ds_map_add(global.text_data_en, "SCR_TEXT_2026", "정말 내 얼굴을&그리워하고 있었구나.../");
ds_map_add(global.text_data_en, "SCR_TEXT_2027", "이런 감정을 느끼는&사람과 싸울 수&있을지 모르겠어./");
ds_map_add(global.text_data_en, "SCR_TEXT_2028", "하지만 이제..^1.&너를 잡는 것도&질려 간다고!/");
ds_map_add(global.text_data_en, "SCR_TEXT_2029", "그래..^1.&대답은?/");
ds_map_add(global.text_data_en, "SCR_TEXT_2030", "\TS \F0 \T0 %");
ds_map_add(global.text_data_en, "SCR_TEXT_2031", "* (파 피 루 스 와  싸 울 까 ?)& &         예           아 니 요 \C");
ds_map_add(global.text_data_en, "SCR_TEXT_2032", " ");
ds_map_add(global.text_data_en, "SCR_TEXT_2036", "\TP %");
ds_map_add(global.text_data_en, "SCR_TEXT_2039", "그래.../");
ds_map_add(global.text_data_en, "SCR_TEXT_2040", "그렇군./");
ds_map_add(global.text_data_en, "SCR_TEXT_2041", "그렇게 나에게&잡히고 싶다면./");
ds_map_add(global.text_data_en, "SCR_TEXT_2042", "다시 해보도록 하지!!!/%%");
ds_map_add(global.text_data_en, "SCR_TEXT_2047", "...그래.../");
ds_map_add(global.text_data_en, "SCR_TEXT_2048", "아무래도 나의 패배를&인정해야 할 것 같군.../%%");
ds_map_add(global.text_data_en, "SCR_TEXT_2058", "* 어 서  오 세 요 !&  스 노 우 딘  최 고 의  여 관 ^1,&  눈  내 린  여 관 입 니 다 !/");
ds_map_add(global.text_data_en, "SCR_TEXT_2059", "* 하 룻 밤 에  80G입 니 다 .& &         머 문 다       떠 난 다 \C");
ds_map_add(global.text_data_en, "SCR_TEXT_2062", "* 다 시  돌 아 왔 군 요 ^1?&* 음 ^1, 원 하 는  만 큼&  머 물 다  가 세 요 ./");
ds_map_add(global.text_data_en, "SCR_TEXT_2063", "* 어 때 요 ?& &         머 문 다       떠 난 다 \C");
ds_map_add(global.text_data_en, "SCR_TEXT_2065", " ");
ds_map_add(global.text_data_en, "SCR_TEXT_2069", "* 응 ^1?&* 안  돼 요 ^1, 키 를&  두  개 씩 은  못  드 려 요 !");
ds_map_add(global.text_data_en, "SCR_TEXT_2074", "* 안 녕 ^1!&* 미 안 ^1, 낮 잠  잘&  시 간 도  없 어 .../");
ds_map_add(global.text_data_en, "SCR_TEXT_2075", "* 눈  내 린  여 관 은  문 을  닫 았 고 ,&  우 리 는  지 상 으 로  돌 아 갈  수&  있 으 니 ./%%");
ds_map_add(global.text_data_en, "SCR_TEXT_2078", "* 오 ^1, 여 기  있 었 구 나 ^1.&* 정 말  걱 정 하 고&  있 었 어 !/");
ds_map_add(global.text_data_en, "SCR_TEXT_2079", "* 다  잘  되 어 가 고  있 어 ^1,&  그 렇 지 ?/");
ds_map_add(global.text_data_en, "SCR_TEXT_2080", "* 우 리  모 두  곧&  지 상 으 로  나 갈  거 야 .../");
ds_map_add(global.text_data_en, "SCR_TEXT_2081", "* 네 가  머 물  수  있 는  곳 이&  생 기 는  거 야 !/%%");
ds_map_add(global.text_data_en, "SCR_TEXT_2089", "Error./%%");
ds_map_add(global.text_data_en, "SCR_TEXT_2092", "* 여 기  방  열 쇠 예 요 ^1.&* 따 뜻 하 게  하 고  자 세 요 !/%%");
ds_map_add(global.text_data_en, "SCR_TEXT_2098", "* ...80G도  없 군 요 ?/");
ds_map_add(global.text_data_en, "SCR_TEXT_2099", "* 오 ^1! 불 쌍 해 라 ^1.&* 당 신 이  어 떻 게  살 아 왔 는 지&  상 상 조 차  안  되 는 군 요 ./");
ds_map_add(global.text_data_en, "SCR_TEXT_2100", "* 위 층 에  있 는  방  중&  하 나 는  비 어  있 어 요 ^1./");
ds_map_add(global.text_data_en, "SCR_TEXT_2101", "* 그 곳 에 서  공 짜 로&  자 도  좋 아 요 ^1. 알 았 죠 ?/%%");
ds_map_add(global.text_data_en, "SCR_TEXT_2109", "* 여 기  방  열 쇠 예 요 ^1.&* 따 뜻 하 게  하 고  자 세 요 !/%%");
ds_map_add(global.text_data_en, "SCR_TEXT_2116", "* 충 분 한  돈 을&  가 지 고  있 지  않 군 요 ./%%");
ds_map_add(global.text_data_en, "SCR_TEXT_2121", "* 그 럼 ^1, 언 제 든&  마 음  내 킬  때  와  주 세 요 ./%%");
ds_map_add(global.text_data_en, "SCR_TEXT_2125", "* (망 원 경 을  들 여 다 봅 니 까 ?)& &         예           아 니 요 \C");
ds_map_add(global.text_data_en, "SCR_TEXT_2126", " ");
ds_map_add(global.text_data_en, "SCR_TEXT_2130", " %%");
ds_map_add(global.text_data_en, "SCR_TEXT_2131", " ");
ds_map_add(global.text_data_en, "SCR_TEXT_2139", "* 망 원 경  사 업 을&  시 작 해 볼 까&  생 각 하 고  있 었 어 ./");
ds_map_add(global.text_data_en, "SCR_TEXT_2140", "* 이  최 고 급  망 원 경 을&  이 용 하 는  데  보 통 은&  50000G를  내 야  하 는 데 .../");
ds_map_add(global.text_data_en, "SCR_TEXT_2141", "* 하 지 만 ..^1.&*\E1 넌  내  지 인 이 니 까 ^1,&  공 짜 로  써 도  돼 ./");
ds_map_add(global.text_data_en, "SCR_TEXT_2142", "\E2* 어 때 ?/");
ds_map_add(global.text_data_en, "SCR_TEXT_2143", "\TS \F0 \T0 %");
ds_map_add(global.text_data_en, "SCR_TEXT_2144", "* (망 원 경 을  이 용 합 니 까 ?)& &         예           아 니 요 \C");
ds_map_add(global.text_data_en, "SCR_TEXT_2148", "* 응 ^1?&* 만 족 스 럽 지  않 았 나 ?/");
ds_map_add(global.text_data_en, "SCR_TEXT_2149", "\E1* 걱 정 하 지  말 라 고 ./");
ds_map_add(global.text_data_en, "SCR_TEXT_2150", "\E2* 전 부  다&  환 불 해 줄 게 ./%%");
ds_map_add(global.text_data_en, "SCR_TEXT_2152", " ");
ds_map_add(global.text_data_en, "SCR_TEXT_2157", " %%");
ds_map_add(global.text_data_en, "SCR_TEXT_2158", " ");
ds_map_add(global.text_data_en, "SCR_TEXT_2169", "* 그 럼 ^1, 언 제 든&  원 할  때  다 시  와 ./%%");
ds_map_add(global.text_data_en, "SCR_TEXT_2180", "* 따 르 릉 ..\E0./");
ds_map_add(global.text_data_en, "SCR_TEXT_2182", "안녕^1!&파피루스야!!!/");
ds_map_add(global.text_data_en, "SCR_TEXT_2183", "\E3네 전화번호를&어떻게 알았냐고...?/");
ds_map_add(global.text_data_en, "SCR_TEXT_2184", "\E0간단하지!!!/");
ds_map_add(global.text_data_en, "SCR_TEXT_2185", "\E0네 번호를 찾을 때까지&모든 번호를 다 눌러봤어!!!/");
ds_map_add(global.text_data_en, "SCR_TEXT_2186", "녜 헤 헤 헤!!/");
ds_map_add(global.text_data_en, "SCR_TEXT_2187", "\E2그런데..^1.&지금 뭐 입고 있어...?/");
ds_map_add(global.text_data_en, "SCR_TEXT_2188", "\E3에..^1.&내 친구가 물어봐달래서./");
ds_map_add(global.text_data_en, "SCR_TEXT_2189", "\E0친구 말로는&네가 입고 있던 게&\[1]\[마]라던데./");
ds_map_add(global.text_data_en, "SCR_TEXT_2190", "\E3진짜야^1?&네가 지금 입고 있는 게&\[1]\[마]야?/");
ds_map_add(global.text_data_en, "SCR_TEXT_2191", "\TS \F0 \T0 %");
ds_map_add(global.text_data_en, "SCR_TEXT_2192", "* (뭐 라 고  대 답 할 까 ?)& &         응           아 니 \C");
ds_map_add(global.text_data_en, "SCR_TEXT_2193", " ");
ds_map_add(global.text_data_en, "SCR_TEXT_2206", "그래 네가 입고 있는 게&\[1]\[마]구나.../");
ds_map_add(global.text_data_en, "SCR_TEXT_2207", "알았어!!^1!&윙크 윙크!!!/");
ds_map_add(global.text_data_en, "SCR_TEXT_2208", "좋은 하루 보내!/");
ds_map_add(global.text_data_en, "SCR_TEXT_2209", "\TS \F0 \T0 %");
ds_map_add(global.text_data_en, "SCR_TEXT_2210", "* 삑 .../%%");
ds_map_add(global.text_data_en, "SCR_TEXT_2215", "그럼 그 \[1]&안 입고 있는 거네.../");
ds_map_add(global.text_data_en, "SCR_TEXT_2216", "알겠어!/");
ds_map_add(global.text_data_en, "SCR_TEXT_2217", "넌 내 친구니까^1,&너를 100퍼센트&믿어 줄게./");
ds_map_add(global.text_data_en, "SCR_TEXT_2218", "좋은 하루 보내!/");
ds_map_add(global.text_data_en, "SCR_TEXT_2219", "\TS \F0 \T0 %");
ds_map_add(global.text_data_en, "SCR_TEXT_2220", "* 삑 .../%%");
ds_map_add(global.text_data_en, "SCR_TEXT_2227", "* (스 토 브  안 에 는  텅  빈&  파 이  틀 이  들 어  있 다 .)/%%");
ds_map_add(global.text_data_en, "SCR_TEXT_2231", "\E0우리 형은 항상&밖에서 식사를 해^1.&하지만.../");
ds_map_add(global.text_data_en, "SCR_TEXT_2232", "\E3최근 들어^1, '제빵'을&시작했어./");
ds_map_add(global.text_data_en, "SCR_TEXT_2233", "보아하니..^1.&키슈 비슷하던데./");
ds_map_add(global.text_data_en, "SCR_TEXT_2234", "하지만 달걀을&넣은 게 아닌^1, 뭔가&달달한 게 들어 있었어./");
ds_map_add(global.text_data_en, "SCR_TEXT_2235", "\E0정말 이상하지!/%%");
ds_map_add(global.text_data_en, "SCR_TEXT_2240", "* (이 것 은  농 담 책 이 다 .)/");
ds_map_add(global.text_data_en, "SCR_TEXT_2241", "* (안 을  봅 니 까 ?)& &         예           아 니 요 \C");
ds_map_add(global.text_data_en, "SCR_TEXT_2242", " ");
ds_map_add(global.text_data_en, "SCR_TEXT_2248", "* (농 담 책  안 에  있 던  것 은&  양 자 물 리 학 책 이 었 다 .)/");
ds_map_add(global.text_data_en, "SCR_TEXT_2249", "* (안 을  들 여 다 봤 다 ...)/");
ds_map_add(global.text_data_en, "SCR_TEXT_2250", "* (양 자 물 리 학 책  안 에 는&  또  다 른  농 담 책 이&  있 었 다 .)/");
ds_map_add(global.text_data_en, "SCR_TEXT_2251", "* (안 을  들 여 다 봤 다 ...)/");
ds_map_add(global.text_data_en, "SCR_TEXT_2252", "* (그  안 에 는  또  다 른&  양 자 물 리 학 책 이 ...)/");
ds_map_add(global.text_data_en, "SCR_TEXT_2253", "* (그 만 두 기 로  했 다 .)/%%");
ds_map_add(global.text_data_en, "SCR_TEXT_2257", " %%");
ds_map_add(global.text_data_en, "SCR_TEXT_2265", "거긴 내 방이야^1!/");
ds_map_add(global.text_data_en, "SCR_TEXT_2266", "둘러보는 건&이쯤 할&생각이라면.../");
ds_map_add(global.text_data_en, "SCR_TEXT_2267", "안으로&들어가서.../");
ds_map_add(global.text_data_en, "SCR_TEXT_2268", '굉장히 쿨한 친구들이&하는 것처럼&"놀자"구?/');
ds_map_add(global.text_data_en, "SCR_TEXT_2269", "\E3아무거나 일반적인 사람들이&데이트 할 때&하는 것들을 하자???/");
ds_map_add(global.text_data_en, "SCR_TEXT_2270", "\TS \F0 \T0 %");
ds_map_add(global.text_data_en, "SCR_TEXT_2271", "* (안 으 로  들 어 갑 니 까 ?)& &         예           아 니 요 \C");
ds_map_add(global.text_data_en, "SCR_TEXT_2272", " %");
ds_map_add(global.text_data_en, "SCR_TEXT_2276", "* (파 피 루 스 의&  방 문 이 다 .)/");
ds_map_add(global.text_data_en, "SCR_TEXT_2277", "* (라 벨 이  덕 지 덕 지&  붙 어 있 다 ...)/");
ds_map_add(global.text_data_en, "SCR_TEXT_2278", "\TP %");
ds_map_add(global.text_data_en, "SCR_TEXT_2279", "* (여 자  출 입 금 지 !)/");
ds_map_add(global.text_data_en, "SCR_TEXT_2280", "* (남 자  출 입 금 지 !)/");
ds_map_add(global.text_data_en, "SCR_TEXT_2281", "* (파 피 루 스  출 입 가 능 .)/%%");
ds_map_add(global.text_data_en, "SCR_TEXT_2286", " %%");
ds_map_add(global.text_data_en, "SCR_TEXT_2297", "내 옷장 안에는&해골 같은 건&없어!!!/");
ds_map_add(global.text_data_en, "SCR_TEXT_2298", "\E3가끔 내가 있긴&하지만./");
ds_map_add(global.text_data_en, "SCR_TEXT_2299", "\TS \F0 \T0 %");
ds_map_add(global.text_data_en, "SCR_TEXT_2300", "* (옷 장  안 을  봅 니 까 ?)& &         예           아 니 요 \C");
ds_map_add(global.text_data_en, "SCR_TEXT_2301", " ");
ds_map_add(global.text_data_en, "SCR_TEXT_2305", "* (옷 장  안 을  봅 니 까 ?)& &         예           아 니 요 \C");
ds_map_add(global.text_data_en, "SCR_TEXT_2306", " ");
ds_map_add(global.text_data_en, "SCR_TEXT_2313", "* (안 에 는  옷 들 이&  가 지 런 히  걸 려  있 다 .)/%%");
ds_map_add(global.text_data_en, "SCR_TEXT_2317", " %%");
ds_map_add(global.text_data_en, "SCR_TEXT_2322", "내 패션 센스에&깜짝 놀라&겁에 질려도 괜찮아./%%");
ds_map_add(global.text_data_en, "SCR_TEXT_2328", "\E3그러면^1, 음.../");
ds_map_add(global.text_data_en, "SCR_TEXT_2329", "\E3모두 다&봤다면 말이지.../");
ds_map_add(global.text_data_en, "SCR_TEXT_2330", "\E2같이 놀아 보도록&할까?/");
ds_map_add(global.text_data_en, "SCR_TEXT_2331", "\TS \F0 \T0 %");
ds_map_add(global.text_data_en, "SCR_TEXT_2332", "* (같 이  놉 니 까 ?)& &         예           아 니 요 \C");
ds_map_add(global.text_data_en, "SCR_TEXT_2333", " ");
ds_map_add(global.text_data_en, "SCR_TEXT_2336", "\E2데이트를&시작해 볼까?/");
ds_map_add(global.text_data_en, "SCR_TEXT_2337", "\TS \F0 \T0 %");
ds_map_add(global.text_data_en, "SCR_TEXT_2338", "* (데 이 트 를  시 작 합 니 까 ?)& &         예           아 니 요 \C");
ds_map_add(global.text_data_en, "SCR_TEXT_2339", " ");
ds_map_add(global.text_data_en, "SCR_TEXT_2348", "\E0좋았어!!^1!&데이트 시작!!!/%%");
ds_map_add(global.text_data_en, "SCR_TEXT_2349", "\E0좋았어!!^1!&놀아보자고!!/%%");
ds_map_add(global.text_data_en, "SCR_TEXT_2354", "\E2천천히 해..^1.&기다려 주도록 하지./%%");
ds_map_add(global.text_data_en, "SCR_TEXT_2359", '* (이  우 편 함 은  "파 피 루 스 " 라 고&  적 혀 있 다 .)/');
ds_map_add(global.text_data_en, "SCR_TEXT_2360", "* (안 을  봅 니 까 ?)& &         예           아 니 요 \C");
ds_map_add(global.text_data_en, "SCR_TEXT_2361", " ");
ds_map_add(global.text_data_en, "SCR_TEXT_2366", "* (비 어  있 다 .)/%%");
ds_map_add(global.text_data_en, "SCR_TEXT_2368", "* (이 것 은  왠 지  불 법 일  수 도&  있 을  것  같 다 .)/%%");
ds_map_add(global.text_data_en, "SCR_TEXT_2372", "* 뭐 ^1?&* 직 업 이  두  개 인&  사 람  본  적  없 어 ?/");
ds_map_add(global.text_data_en, "SCR_TEXT_2373", "\E1* 운  좋 게 도 ^1, 직 업 이&  두  개 라 는  건  쉬 는  시 간 도&  두  배 라 는  뜻 이 지 ./");
ds_map_add(global.text_data_en, "SCR_TEXT_2374", "\E0* 그 릴 비 의  식 당 에  갈  건 데&* 너 도  갈 래 ?&  그 래         바 빠 \C");
ds_map_add(global.text_data_en, "SCR_TEXT_2375", " ");
ds_map_add(global.text_data_en, "SCR_TEXT_2376", "* .../%%");
ds_map_add(global.text_data_en, "SCR_TEXT_2380", "\E2* 이 봐 ^1, 너  정 말&  여 기 저 기  들 쑤 시 고&  다 니 는 군 ./");
ds_map_add(global.text_data_en, "SCR_TEXT_2381", "\E0* 그 릴 비  식 당 에  갈 래 ?&  내 가  살 게 ./");
ds_map_add(global.text_data_en, "SCR_TEXT_2382", "\E1* ...내  말 은 ^1, 네 가&  겁 을  줘 서  달 아 난  모 두 가&  돌 아 오 면  말 이 야 ./%%");
ds_map_add(global.text_data_en, "SCR_TEXT_2389", "* 음 ^1, 정  그 렇 다 면 ..^1.&* 내  일 은  잠 시&  손  떼 야 겠 네 .../%%");
ds_map_add(global.text_data_en, "SCR_TEXT_2394", "* 그 래 ^1. 좋 은  시 간  보 내 ./%%");
ds_map_add(global.text_data_en, "SCR_TEXT_2399", "\E1* 이 런 ^1, 앉 는  자 리 는&  조 심 해 야 지 ./");
ds_map_add(global.text_data_en, "SCR_TEXT_2400", "* 가 끔  이 상 한  놈 들 이&  자 리 에  방 귀  쿠 션 을&  놔 두 곤  하 거 든 ./");
ds_map_add(global.text_data_en, "SCR_TEXT_2401", "\E0* 어 쨌 든 ^1, 주 문 하 자 ./");
ds_map_add(global.text_data_en, "SCR_TEXT_2402", "* 뭘  먹 을 래 ...?& &  감 자 튀 김     햄 버 거\C");
ds_map_add(global.text_data_en, "SCR_TEXT_2403", " ");
ds_map_add(global.text_data_en, "SCR_TEXT_2407", "* 좋 아 ^1, 바 로  주 문 하 지 /%%");
ds_map_add(global.text_data_en, "SCR_TEXT_2411", "* 헤 ^1, 그 거  좋 은 데 ./");
ds_map_add(global.text_data_en, "SCR_TEXT_2412", "* 그 릴 비 ^1,&  감 자 튀 김  두  개&  주 문 할 게 ./%%");
ds_map_add(global.text_data_en, "SCR_TEXT_2418", "* 헤 ^1, 그 거  좋 은 데 ./");
ds_map_add(global.text_data_en, "SCR_TEXT_2419", "* 그 릴 비 ^1,&  햄 버 거  두  개&  주 문 할 게 ./%%");
ds_map_add(global.text_data_en, "SCR_TEXT_2426", "* 그 래 ^1, 그 래 서&  네  생 각 에 .../");
ds_map_add(global.text_data_en, "SCR_TEXT_2427", "* 내  동 생  어 때 ?& &  멋 져         별 로 \C");
ds_map_add(global.text_data_en, "SCR_TEXT_2428", " ");
ds_map_add(global.text_data_en, "SCR_TEXT_2434", "* 그 래 , 물 론  멋 지 지 ./");
ds_map_add(global.text_data_en, "SCR_TEXT_2435", "\E1* 그  옷 을&  매 일  입 으 면&  너 도  멋 질 걸 ./");
ds_map_add(global.text_data_en, "SCR_TEXT_2436", "\E0* 걔 는  반 드 시&  벗 어 야  할  때 만&  그  옷 을  벗 는 다 니 까 ./");
ds_map_add(global.text_data_en, "SCR_TEXT_2437", "* 아 ^1,&  적 어 도  빨 기 는&  하 지 만 ./");
ds_map_add(global.text_data_en, "SCR_TEXT_2438", "\E1* 그 러 니 까  옷 을&  입 은  채 로&  샤 워 를  한 다 는  거 지 ./%%");
ds_map_add(global.text_data_en, "SCR_TEXT_2442", "* 이 봐 ^1, 친 구 ./");
ds_map_add(global.text_data_en, "SCR_TEXT_2443", "\E1* 비 꼬 는  건  재 미 없 어 ^1,&  알 겠 어 ?/");
ds_map_add(global.text_data_en, "SCR_TEXT_2444", "\E0* 내  동 생 은&  진 짜  스 타 야 ./");
ds_map_add(global.text_data_en, "SCR_TEXT_2445", "* 걔  때 문 에  내 가&  어 쩔  수  없 이  보 초  일 도&  하 고  말 이 지 ./");
ds_map_add(global.text_data_en, "SCR_TEXT_2446", "* 약 간  이 상 할  수 도&  있 겠 지 만 ^1, 그 래 도&  가 끔 은 .../");
ds_map_add(global.text_data_en, "SCR_TEXT_2447", "* ...게 으 르 다 고  핀 잔 주 는&  사 람 이  있 는  건&  좋 은  거 야 ./");
ds_map_add(global.text_data_en, "SCR_TEXT_2448", "\E1* 게 으 른  게  고 쳐 지 진&  않 겠 지 만  말 이 야 ./%%");
ds_map_add(global.text_data_en, "SCR_TEXT_2453", "* 음 식 이  나 왔 네 ./");
ds_map_add(global.text_data_en, "SCR_TEXT_2454", "* 케 첩  좀  뿌 릴 래 ^1?& &  응           아 니 \C");
ds_map_add(global.text_data_en, "SCR_TEXT_2455", " ");
ds_map_add(global.text_data_en, "SCR_TEXT_2461", "\E2* 뼛 속 까 지  식 욕 이&  넘 치 는 구 먼 ./%%");
ds_map_add(global.text_data_en, "SCR_TEXT_2465", "\E2* 그 럼  내 가  더  먹 어 야 지 ./%%");
ds_map_add(global.text_data_en, "SCR_TEXT_2472", "\W* \Y말 하 는  꽃 \W에  대 해&  들 어 본  적  있 어 ?&  응           아 니 \C");
ds_map_add(global.text_data_en, "SCR_TEXT_2473", " ");
ds_map_add(global.text_data_en, "SCR_TEXT_2477", "\E1* 그 래 ^1, 전 부&  알 고  있 구 나 ./");
ds_map_add(global.text_data_en, "SCR_TEXT_2478", "\E1* 그 렇 다 면 ^1, 말 해 줄 게 ./");
ds_map_add(global.text_data_en, "SCR_TEXT_2479", "\W*\E0 \B메 아 리 꽃 \W./");
ds_map_add(global.text_data_en, "SCR_TEXT_2480", "* 습 지  전 체 에&  퍼 져  있 지 ./");
ds_map_add(global.text_data_en, "SCR_TEXT_2481", "* 뭔 가 를  말 해 주 면 ^1,&  그 걸  몇  번 이 고&  계 속  반 복 해 .../");
ds_map_add(global.text_data_en, "SCR_TEXT_2482", "* 그 게  무 슨  상 관 이 냐 고 ?/");
ds_map_add(global.text_data_en, "SCR_TEXT_2483", "* 글 쎄 ^1, 어 느  날&  파 피 루 스 가  재 미 있 는  걸&  말 해 주 더 라 고 ./");
ds_map_add(global.text_data_en, "SCR_TEXT_2484", "* 가 끔 ^1, 주 변 에&  아 무 도  없 을  때 .../");
ds_map_add(global.text_data_en, "SCR_TEXT_2485", "* 꽃  한  송 이 가  나 타 나 서&  속 삭 인 대 ./");
ds_map_add(global.text_data_en, "SCR_TEXT_2486", "* 아 첨 ..^1.&* 조 언 ..^1.&* 응 원 .../");
ds_map_add(global.text_data_en, "SCR_TEXT_2487", "* ...예 언 도 ./");
ds_map_add(global.text_data_en, "SCR_TEXT_2488", "* 이 상 하 지 ^1, 안  그 래 ?/");
ds_map_add(global.text_data_en, "SCR_TEXT_2489", "* 누 가  메 아 리 꽃 으 로&  걔 한 테  장 난 치 나  봐 ./");
ds_map_add(global.text_data_en, "SCR_TEXT_2490", "* 잘  좀  봐 줘 ^1, 알 겠 어 ?/");
ds_map_add(global.text_data_en, "SCR_TEXT_2491", "* 고 마 워 ./%%");
ds_map_add(global.text_data_en, "SCR_TEXT_2495", "\E1* 아 ^1, 그 러 고  보 니 .../");
ds_map_add(global.text_data_en, "SCR_TEXT_2496", "\E0* 나  완 전  빈 털 터 리 인 데 ^1,&  돈  좀  대 신  내  줄 래 ?/");
ds_map_add(global.text_data_en, "SCR_TEXT_2497", "* 10000G면  돼 .& &  응           아 니 \C");
ds_map_add(global.text_data_en, "SCR_TEXT_2498", " ");
ds_map_add(global.text_data_en, "SCR_TEXT_2502", " %%");
ds_map_add(global.text_data_en, "SCR_TEXT_2580", "* (우 산 을  가 져 갑 니 까 ?)& &         가 져 간 다     아 니 요\C");
ds_map_add(global.text_data_en, "SCR_TEXT_2581", " ");
ds_map_add(global.text_data_en, "SCR_TEXT_2585", "* (우 산 을  돌 려 놓 습 니 까 ?)& &         돌 려 둔 다     아 니 요 \C");
ds_map_add(global.text_data_en, "SCR_TEXT_2586", " ");
ds_map_add(global.text_data_en, "SCR_TEXT_2597", "* (당 신 은  우 산 을  집 었 다 .)/%%");
ds_map_add(global.text_data_en, "SCR_TEXT_2608", " %%");
ds_map_add(global.text_data_en, "SCR_TEXT_2615", "* (당 신 은  우 산 을  돌 려 놓 았 다 .)/%%");
ds_map_add(global.text_data_en, "SCR_TEXT_2626", " %%");
ds_map_add(global.text_data_en, "SCR_TEXT_2634", "* (석 상 이  있 다 ^1.)&* (석 상  발  아 래 쪽 은&  물 기 가  마 른  것  같 다 .)/%%");
ds_map_add(global.text_data_en, "SCR_TEXT_2637", "* (석 상 에  우 산 을&  씌 우 시 겠 습 니 까 ?)&         놓 는 다       아 니 요 \C");
ds_map_add(global.text_data_en, "SCR_TEXT_2638", " ");
ds_map_add(global.text_data_en, "SCR_TEXT_2642", "* (음 악 이  계 속 해 서 ^1,&  흘 러 나 오 고  있 다 .)/%%");
ds_map_add(global.text_data_en, "SCR_TEXT_2651", "* (당 신 은  우 산 을&  석 상  위 에  올 려 두 었 다 .)/");
ds_map_add(global.text_data_en, "SCR_TEXT_2652", "* (석 상  안 쪽 에 서 ^1, 오 르 골 이&  연 주 되 기  시 작 한 다 ...)/%%");
ds_map_add(global.text_data_en, "SCR_TEXT_2667", " %%");
ds_map_add(global.text_data_en, "SCR_TEXT_2674", "* (녹 슬 고  오 래 된&  냉 장 고 다 .)/");
ds_map_add(global.text_data_en, "SCR_TEXT_2675", "* (안 을  봅 니 까 ?)& &         예           아 니 요 \C");
ds_map_add(global.text_data_en, "SCR_TEXT_2676", " ");
ds_map_add(global.text_data_en, "SCR_TEXT_2682", "* (냉 장 고 를  열 었 다 .^1)&* (썩 은  냄 새 가  진 동 한 다 .)/");
ds_map_add(global.text_data_en, "SCR_TEXT_2683", "* (안 의  음 식 은  이 미&  다  상 해 버 렸 다 .)/%%");
ds_map_add(global.text_data_en, "SCR_TEXT_2686", " %%");
ds_map_add(global.text_data_en, "SCR_TEXT_2692", "* error/%%");
ds_map_add(global.text_data_en, "SCR_TEXT_2694", "* (냉 동 고 는  비 어  있 다 .)/%%");
ds_map_add(global.text_data_en, "SCR_TEXT_2698", "* (냉 동 고  속  우 주 식 량 을&  가 져 가 겠 습 니 까 ?)&         예           아 니 요 \C");
ds_map_add(global.text_data_en, "SCR_TEXT_2699", " ");
ds_map_add(global.text_data_en, "SCR_TEXT_2704", "* (냉 동 고 다 ^1.&* 상 표 도  없 고 ^1, 사 용 한&  흔 적 도  보 이 지  않 는 다 ...)/");
ds_map_add(global.text_data_en, "SCR_TEXT_2705", "* (안 에 는  냉 동 건 조  우 주 식 량 이&  조 금  남 아  있 다 .)/");
ds_map_add(global.text_data_en, "SCR_TEXT_2706", "* (하 나  가 져 갑 니 까 ?)& &         예           아 니 요 \C");
ds_map_add(global.text_data_en, "SCR_TEXT_2707", " ");
ds_map_add(global.text_data_en, "SCR_TEXT_2726", "* (우 주 식 량 을  얻 었 다 .)/%%");
ds_map_add(global.text_data_en, "SCR_TEXT_2728", "* (너 무  많 이  들 고  있 다 .)/%%");
ds_map_add(global.text_data_en, "SCR_TEXT_2732", "* %%");
ds_map_add(global.text_data_en, "SCR_TEXT_2739", "* (일 반 적 인&  훈 련 용  인 형  같 다 .)/");
ds_map_add(global.text_data_en, "SCR_TEXT_2740", "* (때 려 보 겠 습 니 까 ?)& &         예           아 니 요 \C");
ds_map_add(global.text_data_en, "SCR_TEXT_2741", " ");
ds_map_add(global.text_data_en, "SCR_TEXT_2744", "* (인 형 에  더  볼  일 은  없 다 .)/%%");
ds_map_add(global.text_data_en, "SCR_TEXT_2752", "* (당 신 은  주 먹 으 로&  인 형 을  툭  쳤 다 .)/");
ds_map_add(global.text_data_en, "SCR_TEXT_2753", "* (왠 지  기 분 이  나 쁘 다 .)/%%");
ds_map_add(global.text_data_en, "SCR_TEXT_2757", "* (당 신 은  인 형 을&  가 볍 게  쳤 다 .)/");
ds_map_add(global.text_data_en, "SCR_TEXT_2758", "* (아 무 것 도  얻 은  게&  없 는  기 분 이 다 .)/%%");
ds_map_add(global.text_data_en, "SCR_TEXT_2762", "* (당 신 은  인 형 을  강 타 했 다 .)/");
ds_map_add(global.text_data_en, "SCR_TEXT_2763", "* (누 가  신 경 이 나  쓴 담 ?)/%%");
ds_map_add(global.text_data_en, "SCR_TEXT_2767", "* (당 신 은  인 형 에&  전 력 으 로  펀 치 를  날 렸 다 .)/");
ds_map_add(global.text_data_en, "SCR_TEXT_2768", "* (기 분 이  상 쾌 하 다 .)/%%");
ds_map_add(global.text_data_en, "SCR_TEXT_2774", "* (당 신 은  그  눈 을  잠 시&  들 여 다 보 았 다 ...)/%%");
ds_map_add(global.text_data_en, "SCR_TEXT_2837", '* (이  CD에 는  "오 싹 튠 즈 "라 고&  표 시 되 어  있 다 .)/');
ds_map_add(global.text_data_en, "SCR_TEXT_2838", "* (재 생 할 까 요 ?)& &         재 생         아 니 요 \C");
ds_map_add(global.text_data_en, "SCR_TEXT_2839", " ");
ds_map_add(global.text_data_en, "SCR_TEXT_2842", '* (이  CD에 는  "오 싹 튠 즈 "라 고&  표 시 되 어  있 다 .)/');
ds_map_add(global.text_data_en, "SCR_TEXT_2843", "* (이  CD는  재 생  중 이 다 .)&* (끌 까 요 ?)&         끈 다         아 니 요 \C");
ds_map_add(global.text_data_en, "SCR_TEXT_2844", " ");
ds_map_add(global.text_data_en, "SCR_TEXT_2853", "* (당 신 은  CD를  재 생 했 다 .)/%%");
