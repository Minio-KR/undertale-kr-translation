ds_map_add(global.text_data_en, "obj_readable_room1_477", "* 쓰 러 졌 던  괴 물 들 이 .../");
ds_map_add(global.text_data_en, "obj_readable_room1_478", "* ...눈 을  떴 다 ./");
ds_map_add(global.text_data_en, "obj_readable_room1_479", "* 모 두  아 무  일 도  잘 못 된  게&  없 다 는  듯 이  걸 어 다 니 고&  대 화 를  나 눈 다 ./");
