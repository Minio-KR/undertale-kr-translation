ds_map_add(global.text_data_en, "obj_darkfridge_126", "* 여 긴  뭔 가  있 다 ..^1.&* 뭔 가  숨 쉬 고  있 다 는&  느 낌 이  든 다 ./%%");
ds_map_add(global.text_data_en, "obj_darkfridge_133", "* (냉 장 고 다 ^1.)&* (비 어  있 다 .)/%%");
ds_map_add(global.text_data_en, "obj_darkfridge_136", "* 여 긴  뭔 가  있 다 ..^1.&* 맛 있 는  과 일 이  달 린 ^1,&  나 무  같 다 는  느 낌 이  든 다 ./%%");
ds_map_add(global.text_data_en, "obj_darkfridge_142", "* (냉 장 고 다 ^1.)&* (어 떤  종 의  샘 플  같 은  게&  들 어  있 다 .)/%%");
ds_map_add(global.text_data_en, "obj_darkfridge_145", "* 여 긴  뭔 가  있 다 ..^1.&* 남 자 의  형 체 인  것&  같 다 ./%%");
ds_map_add(global.text_data_en, "obj_darkfridge_151", "* (냉 장 고 다 ^1.)&* (비 어  있 다 .)/%%");
