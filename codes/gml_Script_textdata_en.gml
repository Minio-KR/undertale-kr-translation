ds_map_add(global.text_data_en, "obj_labtv_event_439", "* 아 냐 ^1!&* 절 대  의 심 하 지  않 아 ^1, \[차]..^1.&* 절 대 로 !/");
ds_map_add(global.text_data_en, "obj_labtv_event_440", "* 으 ..^1. 응 ^1!&* 우 린  강 해 질  거 야 ^1!&* 모 두 를  해 방 시 키 는  거 야 ./");
