ds_map_add(global.text_data_en, "obj_gyftrot_271", "Error!!");
ds_map_add(global.text_data_en, "obj_gyftrot_273", "이 게&웃 겨 ?");
ds_map_add(global.text_data_en, "obj_gyftrot_274", "나 한 테&부 담&그 만&줘 !");
ds_map_add(global.text_data_en, "obj_gyftrot_275", "날&혼 자&좀  둬 ..");
ds_map_add(global.text_data_en, "obj_gyftrot_276", "호 호 호 !&그 래&웃 어 라 ...");
ds_map_add(global.text_data_en, "obj_gyftrot_277", "이 것  좀&내 게 서&떼 어 줘 ...");
ds_map_add(global.text_data_en, "obj_gyftrot_279", "고 마 워 .");
ds_map_add(global.text_data_en, "obj_gyftrot_283", "으 ,&그 러 지&마 ...");
ds_map_add(global.text_data_en, "obj_gyftrot_284", "심 지 어&포 장 해&둔 거 야 ..");
ds_map_add(global.text_data_en, "obj_gyftrot_285", "나 한 테&가 까 이&오 지 마 !");
ds_map_add(global.text_data_en, "obj_gyftrot_286", "네&선 물 은&필 요 없 어 !");
ds_map_add(global.text_data_en, "obj_gyftrot_287", "속 임 수 가&아 닌 지&어 떻 게&알 지 ?");
ds_map_add(global.text_data_en, "obj_gyftrot_293", "이 런&망 할&못 된&눈 깔!!!");
ds_map_add(global.text_data_en, "obj_gyftrot_294", "난  진 짜&널  믿 기&시 작 하 고&있 었 다 고 !");
ds_map_add(global.text_data_en, "obj_gyftrot_300", "이 제&좀&낫 네 .");
ds_map_add(global.text_data_en, "obj_gyftrot_301", "으 ...&진 짜&장 난&아 냐 .");
ds_map_add(global.text_data_en, "obj_gyftrot_303", "짐 이&한 결&가 벼 워&졌 다 .");
ds_map_add(global.text_data_en, "obj_gyftrot_304", "참&고 맙 기 도&하 지 !");
