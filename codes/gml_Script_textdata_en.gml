ds_map_add(global.text_data_en, "obj_tordogcall_152", "* (고 로 롱 ..^1.&  고 로 롱 ...)/");
ds_map_add(global.text_data_en, "obj_tordogcall_153", "* (작 고 ^1, 하 얀  개 가&  휴 대 폰  위 에 서&  자 는  소 리 가  들 린 다 .)/");
ds_map_add(global.text_data_en, "obj_tordogcall_154", "* (멀 리 서  목 소 리 가&  들 린 다 .)\TT/");
ds_map_add(global.text_data_en, "obj_tordogcall_155", "* 저 기 이 이 ^1?&* 작 은  멍 멍 아 ...?/");
ds_map_add(global.text_data_en, "obj_tordogcall_156", "* 어 디  있 니 ...?/");
ds_map_add(global.text_data_en, "obj_tordogcall_157", "* 머 리 를  잘&  쓰 다 듬 어  줄 게 !\T0/");
ds_map_add(global.text_data_en, "obj_tordogcall_158", "* (코 골 이 가  멈 췄 다 .)\TT/");
ds_map_add(global.text_data_en, "obj_tordogcall_159", "* ...내  휴 대 폰 을&  돌 려  주 면 .\T0/");
ds_map_add(global.text_data_en, "obj_tordogcall_160", "* (다 시  코 를  곤 다 .)/");
ds_map_add(global.text_data_en, "obj_tordogcall_161", "\TS \F0 \T0 %");
ds_map_add(global.text_data_en, "obj_tordogcall_162", "* 삑 .../%%");
ds_map_add(global.text_data_en, "obj_tordogcall_176", "* 따 르 릉 .../");
ds_map_add(global.text_data_en, "obj_tordogcall_177", "* (...)/");
ds_map_add(global.text_data_en, "obj_tordogcall_178", "* (고 로 롱 ..^1.&  고 로 롱 ...)/");
ds_map_add(global.text_data_en, "obj_tordogcall_179", "* (에 취 !)/");
ds_map_add(global.text_data_en, "obj_tordogcall_180", "* (작 고 ^1, 하 얀  개 가&  자 다 가  재 채 기 하 는&  소 리 가  들 린 다 .)/");
ds_map_add(global.text_data_en, "obj_tordogcall_181", "* (멀 리 서  목 소 리 가&  들 린 다 .)\TT/");
ds_map_add(global.text_data_en, "obj_tordogcall_182", "* 저 기 ^1,&  멍 -멍 -멍 멍 아 !/");
ds_map_add(global.text_data_en, "obj_tordogcall_183", "* 아 , 이 런 ^1, 계 속&  기 다 리 게  할  수 는&  없 는 데 ./");
ds_map_add(global.text_data_en, "obj_tordogcall_184", "* ... 아 , 안  돼 ^1, 걔 랑&  통 화 한  지  얼 마 나&  지 난  거 지 ...?/");
ds_map_add(global.text_data_en, "obj_tordogcall_185", "* 아 이 가  벌 써&  전 화 했 을 지 도 ^1,&  그 리 고 ...?/");
ds_map_add(global.text_data_en, "obj_tordogcall_186", "* ...자 ^1, 멍 멍 아 !/");
ds_map_add(global.text_data_en, "obj_tordogcall_187", "\TS \F0 \T0 %");
