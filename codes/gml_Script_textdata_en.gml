ds_map_add(global.text_data_en, "obj_alphysfollow_event_150", "\E5* 저 ..^1. 정 말&  기 대 되 겠 구 나 ^1, 응 ?/%%");
ds_map_add(global.text_data_en, "obj_alphysfollow_event_175", "* 너  마 -마 침 내 .../");
ds_map_add(global.text_data_en, "obj_alphysfollow_event_176", "\E7* 마 침 내  집 에&  가 는  거 야 !/%%");
