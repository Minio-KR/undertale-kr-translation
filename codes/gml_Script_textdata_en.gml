ds_map_add(global.text_data_en, "SCR_TEXT_3808", "네 열정에&정말 감동받았어!/");
ds_map_add(global.text_data_en, "SCR_TEXT_3809", "넌 할 수 있어^1,&인간!!!/%%");
ds_map_add(global.text_data_en, "SCR_TEXT_3814", "내가 그 퍼즐을&풀었어!!!/");
