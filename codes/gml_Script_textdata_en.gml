ds_map_add(global.text_data_en, "obj_aaron_243", "들 어 와 ,&물  좋 아&; )");
ds_map_add(global.text_data_en, "obj_aaron_244", "수 영 복 은&필 요&없 지  ; )");
ds_map_add(global.text_data_en, "obj_aaron_245", "교 ...육 ?&취 미 ?&재 능 ?");
ds_map_add(global.text_data_en, "obj_aaron_246", "휴 , 땀&난 다  ; )");
ds_map_add(global.text_data_en, "obj_aaron_249", "가 까 이&오 지&마  ; )");
ds_map_add(global.text_data_en, "obj_aaron_250", "딱 히&소 름 돋 진&않 아  ; )");
ds_map_add(global.text_data_en, "obj_aaron_251", "물 론&난  내&근 육 을&사 랑 해  ;)");
ds_map_add(global.text_data_en, "obj_aaron_252", "휴 , 땀&난 다  ; )");
ds_map_add(global.text_data_en, "obj_aaron_257", "명 백 한&실 수  ;)");
ds_map_add(global.text_data_en, "obj_aaron_258", "근 육 ?&좋 아 ,&힘&내 지  ;)");
ds_map_add(global.text_data_en, "obj_aaron_259", "좋 아 !!&하 지 만&난&안  져  ;)");
ds_map_add(global.text_data_en, "obj_aaron_264", "귀 여 운 데 ,&응 ? ;)");
ds_map_add(global.text_data_en, "obj_aaron_265", "와 !&씩 씩 해 !&맘 에&들 어  ;)");
ds_map_add(global.text_data_en, "obj_aaron_267", "생 각 을&바 꾸 게&될  거 야& ;)");
ds_map_add(global.text_data_en, "obj_aaron_272", "원 하 는&만 큼&확 인&해 봐  ;)");
ds_map_add(global.text_data_en, "obj_aaron_273", "... ;)");
ds_map_add(global.text_data_en, "obj_aaron_276", "좋 은 데 .&내  취 향&유 머 야  ;)");
ds_map_add(global.text_data_en, "obj_aaron_278", "딱  우 리&둘 이 서 만&알 지 ? ;)");
ds_map_add(global.text_data_en, "obj_aaron_279", "안 녕 ? ;)");
ds_map_add(global.text_data_en, "obj_aaron_282", "%%%");
ds_map_add(global.text_data_en, "obj_aaron_478", "* 아 론 은  즐 겁 게  당 신 에 게&  물 을  튀 긴 다 .");
ds_map_add(global.text_data_en, "obj_aaron_479", "* 아 론 은  무 언 가 에  겁 먹 은  듯 ^1,&  주 변 을  돌 아 본 다 .");
ds_map_add(global.text_data_en, "obj_aaron_480", "* 아 론 은  총 알 을&  땀 처 럼  흘 리 고  있 다 ^3.&* 말  그 대 로 .");
ds_map_add(global.text_data_en, "obj_aaron_481", "* 아 론 은  자 신 의  근 육 에&  감 탄 하 고  있 다 .");
ds_map_add(global.text_data_en, "obj_aaron_482", "* 수 중  목 장  냄 새 가  난 다 .");
ds_map_add(global.text_data_en, "obj_aaron_483", "* 홍 합  양 식 장  냄 새 가  난 다 .");
ds_map_add(global.text_data_en, "obj_aaron_484", "* 아 론 은  당 신 이  또&  몸 풀 기 를  기 다 린 다 .");
