ds_map_add(global.text_data_en, "obj_shop2_290", "돈 이&좀  모 자 란  것&같 군 ./*");
ds_map_add(global.text_data_en, "obj_shop2_291", "너 무&많 이  들 고&있 잖 나 !/*");
ds_map_add(global.text_data_en, "obj_shop2_295", "할 인 은&기 대 도&말 게 ./*");
