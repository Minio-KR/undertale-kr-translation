ds_map_add(global.text_data_en, "SCR_TEXT_4477", "* 개 굴 ^1, 개 굴 .&* (네 가  꽤  자 비 롭 다 고&  들 었 어 ^1, 인 간 치 고 는 ...)/");
ds_map_add(global.text_data_en, "SCR_TEXT_4478", "\W* (괴 물 들 을  \Y살 려 줄 \W 수&  있 을  때 , \Y노 란 색  이 름 \W이&  보 인 다 는  걸  알  거 야 .)/");
