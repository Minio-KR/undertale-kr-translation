ds_map_add(global.text_data_en, "obj_endflowey_189", "왜  날  놓 아 준 거 지 ?/");
ds_map_add(global.text_data_en, "obj_endflowey_190", "\E7네  스 스 로  착 한  사 람 이&된 다 는  건  결 국 .../");
ds_map_add(global.text_data_en, "obj_endflowey_191", "\E1네  스 스 로&상 처 받 는  일 이 란  걸&깨 닫 지  못  한  거 야 ?/");
ds_map_add(global.text_data_en, "obj_endflowey_192", "\E0너  좀  봐 봐 ./");
ds_map_add(global.text_data_en, "obj_endflowey_193", "\E9좋 은  친 구 들 을&사 귀 었 지 .../");
ds_map_add(global.text_data_en, "obj_endflowey_194", "\E0하 지 만  이 젠 ^1,&다 시 는  그 들 을&보 지  못 하 게  됐 잖 아 ./");
ds_map_add(global.text_data_en, "obj_endflowey_195", "\E9얼 마 나  많 은  녀 석 들 이&네 게 서  등 을  돌 렸 는 지 는&말  안  해 도  알 겠 지 ./");
ds_map_add(global.text_data_en, "obj_endflowey_196", "\E6속 상 하 지 ^1, 안  그 래 ?/");
ds_map_add(global.text_data_en, "obj_endflowey_197", "\E7네 가  그 냥&아 무 도  신 경  쓰 지  않 으 며&진 행 했 더 라 면 .../");
ds_map_add(global.text_data_en, "obj_endflowey_198", "\E6지 금  기 분 이  나 쁘 지&않 아 도  됐 을  텐 데 ./");
ds_map_add(global.text_data_en, "obj_endflowey_199", "\E0그 래 서  이 해 를&못 하 겠 다 는  거 야 ./");
ds_map_add(global.text_data_en, "obj_endflowey_200", "\E7네 가  정 말 로&옳 은  일 만  해  왔 다 면 ../");
ds_map_add(global.text_data_en, "obj_endflowey_201", "\E0왜  모 든  게  이 렇 게&끝 나 버 리 는  거 지 ?/");
ds_map_add(global.text_data_en, "obj_endflowey_202", "\E6왜 ...?/");
ds_map_add(global.text_data_en, "obj_endflowey_203", "\E5삶 이  정 말  이 렇 게 나&불 공 평 한 가 ?/");
