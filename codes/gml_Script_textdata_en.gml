ds_map_add(global.text_data_en, "SCR_TEXT_6185", "   * 살 펴 보 기       * 몸 자 랑 &   * 대 화 하 기       * 테 미 플 레 이 크");
ds_map_add(global.text_data_en, "SCR_TEXT_6196", "   * 살 펴 보 기       * 작 업 걸 기 &   * 모 욕 하 기 ");
