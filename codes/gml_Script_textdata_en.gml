ds_map_add(global.text_data_en, "SCR_TEXT_99", "* 당 신 은  \[아]에 게&  조 용 하 게  작 별 을  고 했 다 .");
ds_map_add(global.text_data_en, "SCR_TEXT_100", "* 당 신 은  \[아]\[을]&  바 닥 에  내 려 놓 고&  살 짝  토 닥 였 다 .");
ds_map_add(global.text_data_en, "SCR_TEXT_102", "* 당 신 은  \[아]\[을]&  쓰 레 기 처 럼  땅 바 닥 에  던 졌 다 .");
ds_map_add(global.text_data_en, "SCR_TEXT_103", "* 당 신 은  \[아]\[을]&  버 렸 다 .");
ds_map_add(global.text_data_en, "SCR_TEXT_104", "* \[아]\[은]&  버 려 졌 다 .");
ds_map_add(global.text_data_en, "SCR_TEXT_111", "   * 빠 져 나 가 야 겠 다 .");
ds_map_add(global.text_data_en, "SCR_TEXT_112", "   * 달 리  할  일 이  있 다 .");
ds_map_add(global.text_data_en, "SCR_TEXT_113", "   * 탈 출 했 다 ...");
ds_map_add(global.text_data_en, "SCR_TEXT_114", "   * 가 는  길 을  막 지  마 라 .");
ds_map_add(global.text_data_en, "SCR_TEXT_121", "   * 도 망 쳤 다 .&     \[1] XP를  얻 었 다 .&     \[2] 골 드 를  얻 었 다 .");
ds_map_add(global.text_data_en, "SCR_TEXT_127", "* (폐 허 의  그 림 자 가  어 렴 풋 이&  솟 아 오 르 니 ^1, 당 신 의  결 의 도&  솟 아 오 른 다 .)/");
ds_map_add(global.text_data_en, "SCR_TEXT_128", "* (체 력 이  모 두  회 복 되 었 다 .)/%%");
ds_map_add(global.text_data_en, "SCR_TEXT_129", "* (낙 엽 을  밟 을  때 의&  바 스 락 거 리 는  즐 거 운  소 리 에&  당 신 의  결 의 가  충 만 해 진 다 .)/");
ds_map_add(global.text_data_en, "SCR_TEXT_130", "* (체 력 이  모 두  회 복 되 었 다 .)/%%");
ds_map_add(global.text_data_en, "SCR_TEXT_131", "* (언 젠 간  쥐 가  구 멍 을&  빠 져 나 와  치 즈 를&  가 져 갈  것 을  알 기 에 ...)/");
ds_map_add(global.text_data_en, "SCR_TEXT_132", "* (당 신 의  결 의 가  충 만 해 진 다 .)/%%");
ds_map_add(global.text_data_en, "SCR_TEXT_133", "* (폐 허  속  작 고 ^1, 귀 여 운  집 을  보 자&  당 신 의  결 의 가  충 만 해 진 다 .)/%%");
ds_map_add(global.text_data_en, "SCR_TEXT_134", "* 결 의 ./%%");
ds_map_add(global.text_data_en, "SCR_TEXT_135", "* (낯 선  땅 의  차 가 운  공 기 가 ...&  당 신 의  결 의 를  채 워 준 다 .)/%%");
ds_map_add(global.text_data_en, "SCR_TEXT_136", "* (전 등 의  알 맞 음 이  지 금 도&  당 신 의  결 의 를  채 워 준 다 .)/%%");
ds_map_add(global.text_data_en, "SCR_TEXT_137", "* (쥐 가  언 젠 가 는  스 파 게 티 를&  데 울  방 법 을  찾 으 리 라 는&  걸  알 고  있 기 에 ...)/");
ds_map_add(global.text_data_en, "SCR_TEXT_138", "* (당 신 의  결 의 가  충 만 해 진 다 .)/%%");
ds_map_add(global.text_data_en, "SCR_TEXT_140", "* (개 가  눈 으 로  완 벽 한  눈 강 아 지 를&  만 들  때 까 지  절 대  포 기 하 지&  않 을  것 을  알 기 에 ...)/");
ds_map_add(global.text_data_en, "SCR_TEXT_141", "* (당 신 의  결 의 가  충 만 해 진 다 .)/%%");
ds_map_add(global.text_data_en, "SCR_TEXT_142", "* (눈 은  언 제 나  부 서 지 고&  더  유 용 한  무 언 가 로&  새 로  만 들 어 질  수  있 다 .)/");
ds_map_add(global.text_data_en, "SCR_TEXT_143", "* (이  간 단 한  사 실 이&  당 신 의  결 의 를  채 워 준 다 .)/%%");
ds_map_add(global.text_data_en, "SCR_TEXT_144", "* (정 겨 운  마 을 의  풍 경 이&  당 신 에 게  결 의 를  채 워 준 다 .)/%%");
ds_map_add(global.text_data_en, "SCR_TEXT_145", "* (흐 르 는  물  소 리 가&  당 신 의  결 의 를  채 워 준 다 .)/%%");
ds_map_add(global.text_data_en, "SCR_TEXT_146", "* (두 려 운  느 낌 이  당 신 을&  사 로 잡 으 려  했 지 만 ...^1)&* (당 신 은  결 의 를  다 졌 다 .)/%%");
ds_map_add(global.text_data_en, "SCR_TEXT_147", "* (언 젠 간  쥐 가&  신 비 한  크 리 스 털 에 서&  치 즈 를  꺼 내 갈  것 을  알 기 에 ...)/");
ds_map_add(global.text_data_en, "SCR_TEXT_148", "* (당 신 의  결 의 가  충 만 해 진 다 .)/%%");
ds_map_add(global.text_data_en, "SCR_TEXT_150", "* (동 굴 의  꼭 대 기 에 서&  소 리 죽 인  빗 소 리 가&  들 려 온 다 ...)/");
ds_map_add(global.text_data_en, "SCR_TEXT_151", "* (저  멀 리  오 르 골 의&  고 요 한  소 리 ...)/");
ds_map_add(global.text_data_en, "SCR_TEXT_152", "* (당 신 의  결 의 가  충 만 해 진 다 .)/%%");
ds_map_add(global.text_data_en, "SCR_TEXT_153", "* (한  발 짝 씩  내 딛 을  때 마 다  나 는&  양 말 의  질 척 거 리 는  소 리 에&  당 신 의  결 의 가  충 만 해 진 다 .)/%%");
ds_map_add(global.text_data_en, "SCR_TEXT_156", "* (이  폭 포 는  동 굴 의&  천 장 에 서  흘 러 들 어&  오 는  것  같 다 ...)/");
ds_map_add(global.text_data_en, "SCR_TEXT_157", "* (이 따 금 ^1, 쓰 레 기  조 각 들 이&  흘 러 들 어 온 다 .)/");
ds_map_add(global.text_data_en, "SCR_TEXT_158", "* (...그 리 고  끝 없 는&  심 연  속 으 로  떨 어 진 다 .)/");
ds_map_add(global.text_data_en, "SCR_TEXT_159", "* (무 가 치 한  쓰 레 기 의&  끝 없 는  순 환 을  보 며 ...)/");
ds_map_add(global.text_data_en, "SCR_TEXT_160", "* (당 신 의  결 의 가  충 만 해 진 다 .)/%%");
ds_map_add(global.text_data_en, "SCR_TEXT_161", "* (무 가 치 한  쓰 레 기  속 에 서&  먹 을  것 을  챙 기 는  행 동 이&  당 신 의  결 의 를  채 워 준 다 .)/%%");
ds_map_add(global.text_data_en, "SCR_TEXT_164", "* (당 신 은  고 요  속 에 서&  평 온 함 을  느 낀 다 ^1.&  당 신 의  결 의 가  가 득  찼 다 ...)/%%");
ds_map_add(global.text_data_en, "SCR_TEXT_165", "* (무 엇 인 가 ..^1. 느 껴 진 다 .)&* (당 신 의  겨 릐 가  가 득  차 따 .)/%%");
ds_map_add(global.text_data_en, "SCR_TEXT_168", "* (바 람 이  울 부 짖 고  있 다 ^1.&* 당 신 의  결 의 가  가 득  찼 다 .)/%%");
ds_map_add(global.text_data_en, "SCR_TEXT_169", "* (휘 몰 아 치 던  바 람 이&  산 들 바 람 으 로  변 했 다 ^1.&  당 신 의  결 의 가  채 워 진 다 ...)/%%");
ds_map_add(global.text_data_en, "SCR_TEXT_170", "* (바 람 이  멎 었 다 ^1.&* 당 신 의  결 의 가  가 득  찼 다 .)/%%");
ds_map_add(global.text_data_en, "SCR_TEXT_174", "* (이 런  장 소 에 서&  이 렇 게  기 묘 한&  실 험 실 을  보 니 ...)/");
ds_map_add(global.text_data_en, "SCR_TEXT_175", "* (당 신 의  결 의 가  가 득  찼 다 .)/%%");
ds_map_add(global.text_data_en, "SCR_TEXT_180", "* (증 기 의  쉭 쉭  소 리 와&  톱 니 바 퀴  돌 아 가 는  소 리 가 ..^1. &  당 신 의  결 의 를  채 운 다 .)/%%");
ds_map_add(global.text_data_en, "SCR_TEXT_184", "* (먼  곳 에  불 길 하 게  생 긴&  구 조 물 이  어 렴 풋 이  보 인 다 ...)/");
ds_map_add(global.text_data_en, "SCR_TEXT_185", "* (당 신 의  결 의 가  가 득  찼 다 .)/%%");
ds_map_add(global.text_data_en, "SCR_TEXT_187", "* (언 젠 간  쥐 가  전 산 화 된  금 고 를&  해 킹 해  치 즈 를  가 져 갈  것 을&  알 기 에 ...)/");
ds_map_add(global.text_data_en, "SCR_TEXT_188", "* (당 신 의  결 의 가  충 만 해 진 다 .)/%%");
ds_map_add(global.text_data_en, "SCR_TEXT_191", "* (거 대 한  구 조 물 이  북 쪽 을  향 해&  솟 아  있 다 ^1.)&  (당 신 의  결 의 가  가 득  찼 다 .)/%%");
ds_map_add(global.text_data_en, "SCR_TEXT_195", "* (이  호 텔 의  느 긋 한  분 위 기 가 ..^1.&  당 신 의  결 의 를  채 운 다 .)/%%");
ds_map_add(global.text_data_en, "SCR_TEXT_199", "* (오 존 의  냄 새 로  가 득 한&  공 기 가 ..^1. 당 신 의  결 의 를&  채 운 다 .)/%%");
ds_map_add(global.text_data_en, "SCR_TEXT_203", "* (이  문  너 머 에  분 명&  왕 의  성 으 로  가 는&  엘 리 베 이 터 가  있 을  것 이 다 .)/");
ds_map_add(global.text_data_en, "SCR_TEXT_204", "* (당 신 의  결 의 가  가 득  찼 다 .)/%%");
ds_map_add(global.text_data_en, "SCR_TEXT_208", "* (거 미 줄 의  냄 새 가&  공 기 를  채 우 고  있 다 ...)/");
ds_map_add(global.text_data_en, "SCR_TEXT_209", "* (당 신 의  결 의 가  가 득  찼 다 .)/%%");
ds_map_add(global.text_data_en, "SCR_TEXT_242", "* 당 신 은  키 슈 를  땅 에  두 고&  곧  돌 아 올  거 라  말 했 다 ./%%");
ds_map_add(global.text_data_en, "SCR_TEXT_246", "* 상 자 를  사 용 할 까 ? & &         네           아 니 요 \C");
ds_map_add(global.text_data_en, "SCR_TEXT_247", " ");
ds_map_add(global.text_data_en, "SCR_TEXT_248", " ");
ds_map_add(global.text_data_en, "SCR_TEXT_270", "  %%");
ds_map_add(global.text_data_en, "SCR_TEXT_275", "* 가 지 고  있 는  아 이 템 이  없 다 ^1.&* 약 간 의  시 간 을  상 자 에  넣 었 다 ./%%");
ds_map_add(global.text_data_en, "SCR_TEXT_276", "* 가 지 고  있 는  아 이 템 이  없 다 ^1.&* 약 간 의  노 력 을  상 자 에  넣 었 다 ./%%");
ds_map_add(global.text_data_en, "SCR_TEXT_277", "* 가 지 고  있 는  아 이 템 이  없 다 ^1.&* 약 간 의  감 정 을  상 자 에  넣 었 다 ./%%");
ds_map_add(global.text_data_en, "SCR_TEXT_282", "  %%");
ds_map_add(global.text_data_en, "SCR_TEXT_291", "\W* 반 가 워 ^2!&* 내  이 름 은  \Y플 라 위 \W.^2 &*\Y 작 은  꽃  플 라 위 \W야 !!/");
ds_map_add(global.text_data_en, "SCR_TEXT_292", "* 흐 음 .../");
ds_map_add(global.text_data_en, "SCR_TEXT_293", "* 너  이  지 하  세 계 는&  처 음 인 가  보 구 나 ^2,&  그 렇 지 ?/");
ds_map_add(global.text_data_en, "SCR_TEXT_294", "* 이 런 ^1, 정 말&  정 신 없 겠 네 ./");
ds_map_add(global.text_data_en, "SCR_TEXT_295", "* 이 곳 이  어 떤  곳 인 지&  누 군 가 가  알 려 줘 야 겠 는 데 !/");
ds_map_add(global.text_data_en, "SCR_TEXT_296", "* 작 고  힘 없 는  나 라 도&  알 려 줘 야 겠 네 ./");
ds_map_add(global.text_data_en, "SCR_TEXT_297", "* 준 비 됐 어 ^2?&* 간 다 !/%%");
ds_map_add(global.text_data_en, "SCR_TEXT_301", "\E2* 이 쪽 이 란 다 ./%%");
ds_map_add(global.text_data_en, "SCR_TEXT_302", "%%%");
ds_map_add(global.text_data_en, "SCR_TEXT_306", "\E2* 새 로 운  집 에  온  걸&  환 영 한 단 다 ^1, 착 한  아 가 야 ./");
ds_map_add(global.text_data_en, "SCR_TEXT_307", "* 폐 허 에 서  지 내 는  법 에&  대 해  가 르 쳐  줄 게 ./%%");
ds_map_add(global.text_data_en, "SCR_TEXT_311", "\E2* 폐 허 는  퍼 즐 로&  가 득 하 단 다 ./");
ds_map_add(global.text_data_en, "SCR_TEXT_312", "* 고 대 의  오 락 임 과  동 시 에&  열 쇠 이 기 도  하 지 ./");
ds_map_add(global.text_data_en, "SCR_TEXT_313", "* 방 에 서  방 으 로&  건 너 가 려 면  퍼 즐 을&  풀 어 야  한 단 다 ./");
ds_map_add(global.text_data_en, "SCR_TEXT_314", "* 퍼 즐 에  익 숙 해 지 도 록&  하 렴 ./%");
ds_map_add(global.text_data_en, "SCR_TEXT_318", "\E2* 여 기 를  지 나 가 려 면 ,^1 &  여 러  스 위 치 를&  작 동 시 켜 야  할  거 야 ./");
ds_map_add(global.text_data_en, "SCR_TEXT_319", "* 걱 정 하 지  말 렴 ,^1 &  눌 러 야  하 는  스 위 치 는&  내 가  표 시 해  두 었 단 다 ./%");
ds_map_add(global.text_data_en, "SCR_TEXT_322", "* 걱 정 하 지  말 렴 ,^1 &  눌 러 야  하 는  스 위 치 는&  내 가  표 시 해  두 었 단 다 ./");
ds_map_add(global.text_data_en, "SCR_TEXT_323", "* ...어 라 ^1?&  표 시 들 이  닳 아&  없 어 진  모 양 이 구 나 ./");
ds_map_add(global.text_data_en, "SCR_TEXT_324", "* 어 머 나 ./");
ds_map_add(global.text_data_en, "SCR_TEXT_325", "* 내 가  생 각 했 던  것 보 다&  훨 씬  더  어 려 울  것&  같 구 나 .../%%");
ds_map_add(global.text_data_en, "SCR_TEXT_330", "\E2* 첫  번 째  스 위 치 는&  벽 에  있 단 다 ./%");
ds_map_add(global.text_data_en, "SCR_TEXT_334", "\E1* 도 움 이  필 요 하 니 ...^1?&* 벽 의  스 위 치 를  누 르 렴 ./");
ds_map_add(global.text_data_en, "SCR_TEXT_335", "\E0* 자 , 어 서 , 할  수  있 어 !/%");
ds_map_add(global.text_data_en, "SCR_TEXT_339", "\E2* 어 서 ^1, 왼 쪽 의&  스 위 치 를  누 르 렴 ./%");
ds_map_add(global.text_data_en, "SCR_TEXT_342", "\E2* 내  기 억 엔&  왼 쪽 에  있 는&  스 위 치 였 단 다 ./%");
ds_map_add(global.text_data_en, "SCR_TEXT_347", "\E1* 어 느  쪽 이  왼 쪽 인 지&  알 잖 니 ^1, 그 렇 지 ?/");
ds_map_add(global.text_data_en, "SCR_TEXT_348", "\E0* 내 가  표 시 해  둔&  스 위 치 를  누 르 렴 ./%");
ds_map_add(global.text_data_en, "SCR_TEXT_352", "\E1* 어 느  쪽 이  왼 쪽 인 지&  알 잖 니 ^1, 그 렇 지 ?/%%");
ds_map_add(global.text_data_en, "SCR_TEXT_357", "\E1* 참  호 기 심 이  많 구 나 ^1,&  그 렇 지  않 니 ?/");
ds_map_add(global.text_data_en, "SCR_TEXT_358", "\E1* 부 디  이 해 해 주 렴 .^2 &  \E0너 에 겐  좋 은  것 만&  해  주 고  싶 단 다 ./%");
ds_map_add(global.text_data_en, "SCR_TEXT_362", "\E0* 잘 했 어 요 !^2 &* 정 말  자 랑 스 럽 구 나 ^1, &  아 가 야 ./");
ds_map_add(global.text_data_en, "SCR_TEXT_363", "* 다 음  방 으 로  가 자 꾸 나 ./%");
ds_map_add(global.text_data_en, "SCR_TEXT_367", "\E1* 이  지 하  세 계 에 서&  인 간 으 로  살 아 가 다  보 면 ,^1 &  괴 물 이  공 격 해 올  수  있 어 ./");
ds_map_add(global.text_data_en, "SCR_TEXT_368", "\E2* 그 래 서  그 런  상 황 에&  대 처 할  준 비 가&  필 요 하 단 다 ./");
ds_map_add(global.text_data_en, "SCR_TEXT_369", "\E0* 하 지 만  걱 정  말 렴 !^2 &* 정 말  간 단 하 니 까 ./");
ds_map_add(global.text_data_en, "SCR_TEXT_370", "\E2* 괴 물 을  만 나 게  되 면 ^1,&  전 투 가  시 작 된 단 다 ./");
ds_map_add(global.text_data_en, "SCR_TEXT_371", "* 전 투 를  벌 이 는  도 중 에 ^1,&  친 절 한  말 을  건 네 보 렴 ./");
ds_map_add(global.text_data_en, "SCR_TEXT_372", "\E2* 그 렇 게  시 간 을  끌 면&  내 가  금 방  도 우 러  올 게 ./");
ds_map_add(global.text_data_en, "SCR_TEXT_373", "\E2* 저  연 습 용  인 형 과&  한 번  대 화 해 보 자 꾸 나 ./%");
ds_map_add(global.text_data_en, "SCR_TEXT_379", "\E1* 아 , 인 형 은  싸 우 려 고&  있 는  게  아 니 에 요 !^2 &* 대 화 하 는  용 도 란 다 !/");
ds_map_add(global.text_data_en, "SCR_TEXT_380", "* 다 른  사 람 을  다 치 게  하 고&  싶 지  않 잖 니 , 그 렇 지 ...^2?\E0 &* 이 제  가  보 자 꾸 나 . /%");
ds_map_add(global.text_data_en, "SCR_TEXT_384", "\E0* 아 !^1 정 말  잘 했 어 !^2 &* 정 말  잘 했 구 나 ./%");
ds_map_add(global.text_data_en, "SCR_TEXT_388", "\E1* .../");
ds_map_add(global.text_data_en, "SCR_TEXT_389", "\E1* ... 도 망 쳤 구 나 .../");
ds_map_add(global.text_data_en, "SCR_TEXT_390", "\E0* 솔 직 히  말 하 면 , ^1 &  나 쁘 지  않 은  선 택 이 었 어 ./");
ds_map_add(global.text_data_en, "SCR_TEXT_391", "\E0* 가 능 하 면  싸 움 을  피 하 는 &  편 이  좋 단 다 ./");
ds_map_add(global.text_data_en, "SCR_TEXT_392", "\E1* 그 ...^1 하 지 만 , ^1 &  그 건  그 냥  인 형 이 란 다 ^2.&* 널  해 치 진  않 아 ./");
ds_map_add(global.text_data_en, "SCR_TEXT_393", "\E1* 솜 으 로  되 어  있 거 든 ^1. &* 복 수 라 도  하 려  들 지 는&  않 을  텐 데 .../");
ds_map_add(global.text_data_en, "SCR_TEXT_394", "\E0* 아 무 렴  어 때 ^2. &* 꼭  붙 어  있 으 렴 ,&  내 가  지 켜 줄  테 니 ./%");
ds_map_add(global.text_data_en, "SCR_TEXT_398", "\E3* ^1.^1.^1./");
ds_map_add(global.text_data_en, "SCR_TEXT_399", "\E4* ^1.^1.^1./");
ds_map_add(global.text_data_en, "SCR_TEXT_400", "\E0* 다 음  방 이  기 다 리 고&  있 단 다 . /%");
ds_map_add(global.text_data_en, "SCR_TEXT_405", "\E2* 연 습 용  인 형 과  대 화 를 &  해  보 렴 ./");
ds_map_add(global.text_data_en, "SCR_TEXT_406", "\E1* 아 무  말 이 나  괜 찮 단 다 ...^2.\E2 &* 인 형 은  다  받 아 줄  거 야 ./%");
ds_map_add(global.text_data_en, "SCR_TEXT_411", "\E0* 이 야 깃 거 리 가  필 요 하 니 ?/");
ds_map_add(global.text_data_en, "SCR_TEXT_412", "* 음 ^1, 난  '안 녕 하 세 요 '로&  먼 저  인 사 를  건 넨 단 다 ./");
ds_map_add(global.text_data_en, "SCR_TEXT_413", "* 좋 아 하 는  책 에  대 해&  물 어 봐 도  괜 찮 고 .../");
ds_map_add(global.text_data_en, "SCR_TEXT_414", "* 농 담 도  말 문 을  터 야&  할  때  유 용 하 지 ./");
ds_map_add(global.text_data_en, "SCR_TEXT_415", "* 한 번  들 어 보 렴 .../");
ds_map_add(global.text_data_en, "SCR_TEXT_416", "* 해 골 이  사 는  집 의  벽 은&  뭘 로  만 들 어 졌 게 ?/");
ds_map_add(global.text_data_en, "SCR_TEXT_417", '* ..."골 "판 지 !/');
ds_map_add(global.text_data_en, "SCR_TEXT_418", "\E1* .../");
ds_map_add(global.text_data_en, "SCR_TEXT_419", "\E0* 음 ^1, 재 미 있 는  농 담 일  것&  같 았 는 데 ./%");
ds_map_add(global.text_data_en, "SCR_TEXT_423", "\E2* 연 습 용  인 형 과  대 화 를 &  해  보 렴 ./");
ds_map_add(global.text_data_en, "SCR_TEXT_424", "\E1* 뭐 든 지  말 해 보 렴 ...^2 \E0 &* 인 형 이  짜 증 내 진&  않 을  테 니 ./%");
ds_map_add(global.text_data_en, "SCR_TEXT_428", "\E1* 이  방 에 는  다 른  퍼 즐 도&  있 단 다 .../");
ds_map_add(global.text_data_en, "SCR_TEXT_429", "\E0* 네 가  풀  수  있 을 진&  모 르 겠 구 나 ./%");
ds_map_add(global.text_data_en, "SCR_TEXT_433", "\E1* 이 게  그  퍼 즐 이 야 ^1,&  으 음 .../");
ds_map_add(global.text_data_en, "SCR_TEXT_434", "\E0* 자 ^1, 여 기  내  손 을&  잡 으 렴 ./%");
ds_map_add(global.text_data_en, "SCR_TEXT_438", "\E1* 이  퍼 즐 은  지 금 은  좀&  위 험 해  보 이 는 구 나 ./%");
ds_map_add(global.text_data_en, "SCR_TEXT_442", ".../%");
ds_map_add(global.text_data_en, "SCR_TEXT_446", "\E2* 안 녕 ,^1 아 가 야 ^2.&* 걱 정 하 지  말 렴 ^1,&  널  떠 나 지  않 았 단 다 ./");
ds_map_add(global.text_data_en, "SCR_TEXT_447", "\E0* 그 저  이  기 둥  뒤 에&  서  있 었 을  뿐 이 야 ./");
ds_map_add(global.text_data_en, "SCR_TEXT_448", "* 나 를  믿 어 줘 서  고 맙 구 나 ./");
ds_map_add(global.text_data_en, "SCR_TEXT_449", "\E2* 하 지 만 ^1, 이 런  일 을  한  건&  중 요 한  이 유 가&  있 어 서 란 다 ./");
ds_map_add(global.text_data_en, "SCR_TEXT_450", "* ...너 의  자 립 심 을&  시 험 하 기  위 해 서 였 어 ./");
ds_map_add(global.text_data_en, "SCR_TEXT_451", "\E1* 중 요 한  일 이  있 어 서 ^1,&  널  잠 시 동 안  혼 자&  둬 야  하 거 든 ./");
ds_map_add(global.text_data_en, "SCR_TEXT_452", "\E0* 꼭  여 기 에  있 으 렴 ^2.&*\E1 혼 자  돌 아 다 니 는  건&  위 험 하 단 다 ./");
ds_map_add(global.text_data_en, "SCR_TEXT_453", "\E0* 좋 은  생 각 이  났 다 ^2. &* 이  휴 대 전 화 를  줄 게 ./");
ds_map_add(global.text_data_en, "SCR_TEXT_454", "* 뭐 든 지  도 움 이  필 요 하 면 ^1,&  내 게  전 화 하 렴 ./");
ds_map_add(global.text_data_en, "SCR_TEXT_455", "\E1* 착 하 게  있 어 야  한 다 ^1,&  알 았 지 ?/%");
ds_map_add(global.text_data_en, "SCR_TEXT_459", "\E0* 지 금 까 지  정 말&  잘  해 왔 단 다 ^1, 아 가 야 ./");
ds_map_add(global.text_data_en, "SCR_TEXT_460", "\E2* 하 지 만 ... 네 게  어 려 운&  부 탁 을  하 나  해 야 겠 구 나 ./");
ds_map_add(global.text_data_en, "SCR_TEXT_461", "* .../");
ds_map_add(global.text_data_en, "SCR_TEXT_462", "* 이  방 의  끝 까 지  혼 자 서&  걸 어 가  주 었 으 면  해 ./");
ds_map_add(global.text_data_en, "SCR_TEXT_463", "\E1* 나 를  용 서 해 주 렴 ./%");
ds_map_add(global.text_data_en, "SCR_TEXT_467", "* 따 르 릉 ..\E0.\TT /");
ds_map_add(global.text_data_en, "SCR_TEXT_468", "\F1 %");
ds_map_add(global.text_data_en, "SCR_TEXT_469", "* 여 보 세 요 ?&* 토 리 엘 이 란 다 ./");
ds_map_add(global.text_data_en, "SCR_TEXT_470", "* 딱 히  이 유 가  있 어 서&  전 화 한  건  아 니 고 ...&* 시 나 몬 과  버 터 스 카 치  중 ./");
ds_map_add(global.text_data_en, "SCR_TEXT_471", "* 어 느  쪽 을  더  좋 아 하 니 ?& &  시 나 몬       버 터 스 카 치 \C");
ds_map_add(global.text_data_en, "SCR_TEXT_472", " ");
ds_map_add(global.text_data_en, "SCR_TEXT_490", "* 아 ^1, 그 래 .&* 알 려 줘 서  고 맙 구 나 !/");
ds_map_add(global.text_data_en, "SCR_TEXT_491", "\TS \F0 \T0 %");
ds_map_add(global.text_data_en, "SCR_TEXT_492", "* 삑 .../%%");
ds_map_add(global.text_data_en, "SCR_TEXT_493", "* /");
ds_map_add(global.text_data_en, "SCR_TEXT_497", "* 낚 싯 대 가  바 닥 에&  고 정 되 어  있 다 .../");
ds_map_add(global.text_data_en, "SCR_TEXT_498", "* 줄 을  감 아  올 릴 까 요 ?& &         네           아 니 요 \C");
ds_map_add(global.text_data_en, "SCR_TEXT_499", " ");
ds_map_add(global.text_data_en, "SCR_TEXT_511", "* 낚 싯 줄  끝 에  걸 려 있 던  건&  이 상 하 게  생 긴  괴 물 의&  사 진 뿐 이 었 다 .../");
ds_map_add(global.text_data_en, "SCR_TEXT_512", "* (연 락 해 !&  이 거  내  번 호 야 !)/");
ds_map_add(global.text_data_en, "SCR_TEXT_513", "* 당 신 은  전 화 하 지  않 기 로  했 다 ./%%");
ds_map_add(global.text_data_en, "SCR_TEXT_516", "* 낚 싯 줄  끝 에  걸 려 있 던  건&  쪽 지 뿐 이 었 다 ./");
ds_map_add(global.text_data_en, "SCR_TEXT_517", "* (얘 들 아 ^1, 신 경  쓰 지  마 !)/%%");
ds_map_add(global.text_data_en, "SCR_TEXT_522", "* 당 신 은  신 경  쓰 지  않 기 로  했 다 ./%%");
ds_map_add(global.text_data_en, "SCR_TEXT_529", "* 나  자 신 을  그 렇 게  쉽 게&  주 지  말 았 어 야  했 는 데 .../%%");
ds_map_add(global.text_data_en, "SCR_TEXT_533", "* 지 금  방 금 ...&* 내 가  준  나 의  일 부 분 을&  먹 어 버 린  거 야 ?/");
ds_map_add(global.text_data_en, "SCR_TEXT_534", "* 그 것 도  내  눈 앞 에 서 !?/");
ds_map_add(global.text_data_en, "SCR_TEXT_535", "* 더 는  할  말  없 어 ..^1.&* 꺼 져 !/%%");
ds_map_add(global.text_data_en, "SCR_TEXT_540", "* 나 를  아 껴 줘 서&  정 말  고 마 워 .../%%");
ds_map_add(global.text_data_en, "SCR_TEXT_545", "* 뭐 ^1? 또 ...?/");
ds_map_add(global.text_data_en, "SCR_TEXT_546", "* 미 안 해 ..^1. 더  이 상  주 면 ^1,&  내 가  남 아 나 질&  않 을  거 야 ./");
ds_map_add(global.text_data_en, "SCR_TEXT_547", "* 그 게  사 실 인 걸 ^1.&* 한 계 를  넘 어 서  모 험 한 다 는  건&  공 상 에  불 과 하 다 고 ./");
ds_map_add(global.text_data_en, "SCR_TEXT_548", "* 누 구 에 게 나&  다 를  거  없 어 ./");
ds_map_add(global.text_data_en, "SCR_TEXT_549", "* 모 든  괴 물 류 는&  지 하 에  갇 혀  살&  운 명 인  거 야 ^1. 영 원 히 .../%%");
ds_map_add(global.text_data_en, "SCR_TEXT_554", '* "나 "는  잘  지 내 ^1?&* 너 한 테  줬 던  내  조 각&  말 이 야 .../');
ds_map_add(global.text_data_en, "SCR_TEXT_559", "* 어 ^1? 잃 어 버 렸 어 ...^1?&* ...하 나  더  주 지  뭐 .../");
ds_map_add(global.text_data_en, "SCR_TEXT_563", "* 넣 을  곳 이  없 다 고 ^1?&* 그 래 ..^1. 난  너 한 테  별 로&  중 요 하 지  않 은 가  보 지 ^1, 그 럼 ./%%");
ds_map_add(global.text_data_en, "SCR_TEXT_567", "* 이 번 엔  부 디  조 심 해 서&  가 져 가  줘 ./");
ds_map_add(global.text_data_en, "SCR_TEXT_568", "* (당 신 은  눈 사 람&  조 각 을  얻 었 다 .)/%%");
ds_map_add(global.text_data_en, "SCR_TEXT_576", "* 안 녕 ^1.&* 난  눈 사 람 이 야 ./");
ds_map_add(global.text_data_en, "SCR_TEXT_577", "* 세 상 을  보 고  싶 은 데 ..^1.&* 움 직 일  수 가  없 어 ./");
ds_map_add(global.text_data_en, "SCR_TEXT_578", "* 네 게  부 탁 이  하 나  있 는 데 .../");
ds_map_add(global.text_data_en, "SCR_TEXT_579", "* 내  조 각 을  떼 어 다&  저  멀 리 까 지  가 져 가  줘 .&         가 져 간 다     싫 어 \C");
ds_map_add(global.text_data_en, "SCR_TEXT_580", " ");
ds_map_add(global.text_data_en, "SCR_TEXT_590", "* 더  이 상  담 을  공 간 이&  없 는  것  같 은 걸 ./%%");
ds_map_add(global.text_data_en, "SCR_TEXT_593", "* 고 마 워 ... 행 운 을  빌 어 !/");
ds_map_add(global.text_data_en, "SCR_TEXT_594", "* (당 신 은  눈 사 람&  조 각 을  얻 었 다 .)/%%");
ds_map_add(global.text_data_en, "SCR_TEXT_600", "* 알 겠 어 ^1.&* 그 럼 ^1, 재 밌 는  여 행  되 렴 ./%%");
ds_map_add(global.text_data_en, "SCR_TEXT_605", "샌즈 형!!^1!&아무 소용 없잖아!/");
ds_map_add(global.text_data_en, "SCR_TEXT_606", "샌즈 형!!^1!&아예 쳐다보지도 않잖아!/");
ds_map_add(global.text_data_en, "SCR_TEXT_608", "* 어 이 쿠 ./");
ds_map_add(global.text_data_en, "SCR_TEXT_609", "* 아 무 래 도  오 늘 자&  십 자 말 풀 이 를  대 신&  가 져 올  걸  그 랬 다 ./");
ds_map_add(global.text_data_en, "SCR_TEXT_611", "뭐라고!^1? 십자말풀이!^1?/");
ds_map_add(global.text_data_en, "SCR_TEXT_612", "형이 그런 소릴&할 줄이야!!/");
ds_map_add(global.text_data_en, "SCR_TEXT_613", "이 몸이 보기에는.../");
ds_map_add(global.text_data_en, "SCR_TEXT_614", "\E3어린이용 끝말잇기가&가장 어렵단 말씀이야./");
ds_map_add(global.text_data_en, "SCR_TEXT_616", "* 뭐 ^1? 참 나 ^1, 정 말 로 ^1?&* 그  누 워 서  떡  먹 기 인&  끝 말 잇 기  활 동 지 가 ?/");
ds_map_add(global.text_data_en, "SCR_TEXT_617", "\E1* 그 건  꼬 마  뼈 다 귀 들 이 나&  하 는  거 야 ./");
ds_map_add(global.text_data_en, "SCR_TEXT_619", "말도^1, 안 돼./");
ds_map_add(global.text_data_en, "SCR_TEXT_620", "\E0인간!!^1! &네가 결론을 내 봐!/");
ds_map_add(global.text_data_en, "SCR_TEXT_621", "\TS \F0 \E0 \T0 %");
ds_map_add(global.text_data_en, "SCR_TEXT_622", "* (어 느  쪽 이  더  어 려 울 까 ?)& &         끝 말 잇 기     십 자 말 풀 이 \C");
ds_map_add(global.text_data_en, "SCR_TEXT_623", "   ");
ds_map_add(global.text_data_en, "SCR_TEXT_631", "하^1! 하^1! 그렇지!/");
ds_map_add(global.text_data_en, "SCR_TEXT_632", "인간들은 분명&굉장히 똑똑할 거야!/");
ds_map_add(global.text_data_en, "SCR_TEXT_633", "어린이용 끝말잇기가&매우 어렵다는 걸&알아냈으니 말이지!/");
ds_map_add(global.text_data_en, "SCR_TEXT_634", "녜^1! 헤^1! 헤! 헤!/%%");
ds_map_add(global.text_data_en, "SCR_TEXT_639", "너희 둘은 이상해!/");
ds_map_add(global.text_data_en, "SCR_TEXT_640", "\E3십자말풀이는&너무 쉽다고./");
ds_map_add(global.text_data_en, "SCR_TEXT_641", "매번 똑같은&방식이지./");
ds_map_add(global.text_data_en, "SCR_TEXT_642", '\E0난 그냥 모든&칸 안에&"Z"를 넣어.../');
ds_map_add(global.text_data_en, "SCR_TEXT_643", "왜냐하면&난 십자말풀이를&볼 때마다.../");
ds_map_add(global.text_data_en, "SCR_TEXT_644", "코를 골아 버리거든!!!/");
ds_map_add(global.text_data_en, "SCR_TEXT_645", "녜 헤 헤!!!/%%");
ds_map_add(global.text_data_en, "SCR_TEXT_654", "* 안 녕 ^1!&* 나 이 스 크 림&  먹 고  갈 래 ?/");
ds_map_add(global.text_data_en, "SCR_TEXT_655", "* 마 음 을  따 뜻 하 게  해  주 는&  차 가 운  크 림 이 지 !/");
ds_map_add(global.text_data_en, "SCR_TEXT_656", "* 지 금 은  겨 우  15G야 !& &         예           아 니 요 \C");
ds_map_add(global.text_data_en, "SCR_TEXT_657", " ");
ds_map_add(global.text_data_en, "SCR_TEXT_661", " %");
ds_map_add(global.text_data_en, "SCR_TEXT_662", "* 나 이 스 크 림 ^1!&* 마 음 을  따 뜻 하 게&  해  주 는  차 가 운  크 림 이 야 !/");
ds_map_add(global.text_data_en, "SCR_TEXT_663", "* 지 금 은  겨 우  15G야 !& &         예           아 니 요 \C");
ds_map_add(global.text_data_en, "SCR_TEXT_664", " ");
ds_map_add(global.text_data_en, "SCR_TEXT_682", "* 여 기  있 어 ^1!&* 무 진 장  좋 은  하 루  되 라 고 !&* (나 이 스 크 림 을  얻 었 다 .)/%%");
ds_map_add(global.text_data_en, "SCR_TEXT_684", "* 응 ^1?&* 돈 이  충 분 하 지&  않 구 나 .../");
ds_map_add(global.text_data_en, "SCR_TEXT_685", "* 나 이 스 크 림 을  공 짜 로  만 들  수&  있 으 면  좋 을  텐 데 .../%%");
ds_map_add(global.text_data_en, "SCR_TEXT_688", "* 너 무  많 은  물 건 을&  가 지 고  있 구 나 ^1!&* 어 쩔  수  없 군 !/%%");
ds_map_add(global.text_data_en, "SCR_TEXT_691", "* 그 렇 다 면  말 이 지 ..^1.&* 네  친 구 들 에 게  전 해 .../");
ds_map_add(global.text_data_en, "SCR_TEXT_692", "* 숲  한 가 운 데 에 서 ..^1.&* 누 군 가 가  아 이 스 크 림 을&  팔 고  있 다 고 .../%%");
ds_map_add(global.text_data_en, "SCR_TEXT_704", "* 안 녕 ^1!&* 나 이 스 크 림&  먹 고  갈 래 ?/");
ds_map_add(global.text_data_en, "SCR_TEXT_705", "* 마 음 을  따 뜻 하 게  해  주 는&  차 가 운  크 림 이 지 !/");
ds_map_add(global.text_data_en, "SCR_TEXT_706", "* 지 금 은  겨 우  25G야 !& &         예           아 니 요 \C");
ds_map_add(global.text_data_en, "SCR_TEXT_707", " ");
ds_map_add(global.text_data_en, "SCR_TEXT_711", " %");
ds_map_add(global.text_data_en, "SCR_TEXT_712", "* 나 이 스 크 림 ^1!&* 마 음 을  따 뜻 하 게&  해  주 는  차 가 운  크 림 이 야 !/");
ds_map_add(global.text_data_en, "SCR_TEXT_713", "* 지 금 은  겨 우  25G야 !& &         예           아 니 요 \C");
ds_map_add(global.text_data_en, "SCR_TEXT_714", " ");
ds_map_add(global.text_data_en, "SCR_TEXT_721", "* 어 , 우 산 을  가 지 고  있 구 나 ^1.&  내  카 트 처 럼  말 이 야 .../");
ds_map_add(global.text_data_en, "SCR_TEXT_722", "* 멋 진  인 연 이 야 ^1!&* 서 비 스 를&  해  줘 야 겠 는 걸 !/");
ds_map_add(global.text_data_en, "SCR_TEXT_723", "* 아 이 스 크 림  세 일 ! 15G야 ! & &         예           아 니 요 \C");
ds_map_add(global.text_data_en, "SCR_TEXT_724", " ");
ds_map_add(global.text_data_en, "SCR_TEXT_728", " %");
ds_map_add(global.text_data_en, "SCR_TEXT_729", "* 우 산  동 지 라 니 !^1?&* 서 비 스 를&  해  줘 야 겠 군 .../");
ds_map_add(global.text_data_en, "SCR_TEXT_730", "* 아 이 스 크 림  세 일 ! 15G야 ! & &         예           아 니 요 \C");
ds_map_add(global.text_data_en, "SCR_TEXT_731", " ");
ds_map_add(global.text_data_en, "SCR_TEXT_736", "* 이 봐 ^1!&* 펀 치 카 드  석  장 을&  갖 고  있 구 나 !/");
ds_map_add(global.text_data_en, "SCR_TEXT_737", "* 나 이 스 크 림 과&  바 꾸 지  않 을 래 ?/");
ds_map_add(global.text_data_en, "SCR_TEXT_738", "* 돈 은  필 요  없 단 다 ! & &         예           아 니 요 \C");
ds_map_add(global.text_data_en, "SCR_TEXT_739", " ");
ds_map_add(global.text_data_en, "SCR_TEXT_777", "* 아 주  좋 아 ^1! 여 기  있 어 ^1!&* 카 드 는  박 스 에  넣 어  둘 게 !&* (나 이 스 크 림 을  얻 었 다 .)/%%");
ds_map_add(global.text_data_en, "SCR_TEXT_779", "* 응 ^1? 돈 이  없 니 ^1?&* 미 안 하 지 만 ^1, 공 짜 로&  줄  순  없 어 ./%%");
ds_map_add(global.text_data_en, "SCR_TEXT_781", "* 응 ^1? 할 인 중 인 데 도&  살  돈 이  없 다 고 ^1?&* 난 .../%%");
ds_map_add(global.text_data_en, "SCR_TEXT_784", "* 너 무  많 은  물 건 을&  가 지 고  있 구 나 ^1!&* 어 쩔  수  없 군 !/%%");
ds_map_add(global.text_data_en, "SCR_TEXT_803", "* 여 기 ^1! 공 짜  나 이 스 크 림 이 야 ^1!&* (석  장 의  카 드 를  내 고&  나 이 스 크 림 을  얻 었 다 .)/%%");
ds_map_add(global.text_data_en, "SCR_TEXT_809", "* 그 렇 다 면  말 이 지 ..^1.&* 네  친 구 들 에 게  전 해 .../");
ds_map_add(global.text_data_en, "SCR_TEXT_810", "* 축 축 하 고  깊 은  동 굴  속 에 서 ..^1.&* 누 가  아 이 스 크 림 을&  팔 고  있 다 고 .../%%");
ds_map_add(global.text_data_en, "SCR_TEXT_815", "* 간 식  장 사 도  좀  해  볼 까&  생 각 하 고  있 어 ./");
ds_map_add(global.text_data_en, "SCR_TEXT_816", "* 눈  튀 김  어 때 ^1?&* 겨 우  5G야 .&  산 다         싫 어 \C");
ds_map_add(global.text_data_en, "SCR_TEXT_817", " ");
ds_map_add(global.text_data_en, "SCR_TEXT_823", "* 내 가  5G라 고  했 던 가 ^1?&* 아 니 , 내  말 은  50G야 ^1.&  산 다         싫 어 \C");
ds_map_add(global.text_data_en, "SCR_TEXT_824", "  ");
ds_map_add(global.text_data_en, "SCR_TEXT_828", "* 네  말 이  맞 아 ./");
ds_map_add(global.text_data_en, "SCR_TEXT_829", "* 그 것 보 다 는  훨 씬&  비 싸 게  쳐 줘 야 겠 지 ./%%");
ds_map_add(global.text_data_en, "SCR_TEXT_836", "* 정 말 ^1?&* 그 럼  5000G는  어 때 ?&  산 다         싫 어 \C");
ds_map_add(global.text_data_en, "SCR_TEXT_837", "  ");
ds_map_add(global.text_data_en, "SCR_TEXT_841", "* 네  말 이  맞 아 ./");
ds_map_add(global.text_data_en, "SCR_TEXT_842", "* 그 것 도  너 무  싼  것  같 아 ./%%");
ds_map_add(global.text_data_en, "SCR_TEXT_849", "* 50000G^1.&* 이 게  내  최 종  제 안 이 야 .&  산 다         싫 어\C");
ds_map_add(global.text_data_en, "SCR_TEXT_850", "  ");
ds_map_add(global.text_data_en, "SCR_TEXT_854", "* 어 떻 게 든  본 전 은&  뽑 아 야  하 니 까 ./%%");
ds_map_add(global.text_data_en, "SCR_TEXT_861", "* 뭐 ^1?&* 돈 이  없 다 는&  말 이 야 ?/");
ds_map_add(global.text_data_en, "SCR_TEXT_862", "* 아 ^1, 괜 찮 아 ./");
ds_map_add(global.text_data_en, "SCR_TEXT_863", "\E1* 나 도  눈 이  없 어 ./%%");
ds_map_add(global.text_data_en, "SCR_TEXT_867", "* 와 우 ^1,&  엄 청 난  돈 이 네 ./");
ds_map_add(global.text_data_en, "SCR_TEXT_868", "\E3* 이 런  말  하 긴&  미 안 하 지 만 .../");
ds_map_add(global.text_data_en, "SCR_TEXT_869", "\E3* 눈  튀 김 은&  팔  수  없 어 ./");
ds_map_add(global.text_data_en, "SCR_TEXT_870", "\E2* 이 건  값 을  매 기 기 엔&  너 무  소 중 하 거 든 ./%%");
ds_map_add(global.text_data_en, "SCR_TEXT_875", "* 이 런  제 안 을  듣 고 도&  좋 은  거 래 라 는  감 이&  안  오 나  보 지 ?/%%");
ds_map_add(global.text_data_en, "SCR_TEXT_880", "뭐야!^1?&어떻게 내 함정을&피했지?/");
ds_map_add(global.text_data_en, "SCR_TEXT_881", "\E3아니^1, &그것보다도 말야.../");
ds_map_add(global.text_data_en, "SCR_TEXT_882", "\E0내 것도&남겨놨겠지???/");
ds_map_add(global.text_data_en, "SCR_TEXT_883", "\TS \F0 \E0 \T0 %");
ds_map_add(global.text_data_en, "SCR_TEXT_884", "* (파 피 루 스 에 게  스 파 게 티 에  대 해&  뭐 라 고  말 할 까 ?)&         먹 었 다       남 겼 다 \C");
ds_map_add(global.text_data_en, "SCR_TEXT_885", "   ");
ds_map_add(global.text_data_en, "SCR_TEXT_890", "정말!?/");
ds_map_add(global.text_data_en, "SCR_TEXT_893", "\E2세에상에.../");
ds_map_add(global.text_data_en, "SCR_TEXT_894", "누구도 내 요리를&맛있게 먹어준&적은 없었는데.../");
ds_map_add(global.text_data_en, "SCR_TEXT_895", "\E0그래, 그렇다면!!/");
ds_map_add(global.text_data_en, "SCR_TEXT_900", "\E2세에상에.../");
ds_map_add(global.text_data_en, "SCR_TEXT_901", "직접 만든&파스타의 맛을&참아냈다고.../");
ds_map_add(global.text_data_en, "SCR_TEXT_902", "나와 그 행복을&나누기 위해서?/");
ds_map_add(global.text_data_en, "SCR_TEXT_905", "\E0걱정하지 마라 인간^1!&나^1, 마스터 셰프&파피루스 님이.../");
ds_map_add(global.text_data_en, "SCR_TEXT_906", "네가 원하는&모든 종류의 파스타를&만들어주마!/");
ds_map_add(global.text_data_en, "SCR_TEXT_907", "헤 헤 헤 헤&헤 헤 헤 녜! /%%");
ds_map_add(global.text_data_en, "SCR_TEXT_911", "어이!/");
ds_map_add(global.text_data_en, "SCR_TEXT_912", "인간이다!/");
ds_map_add(global.text_data_en, "SCR_TEXT_913", "\E0이 퍼즐은 정말 맘에&쏙 들 거야!/");
ds_map_add(global.text_data_en, "SCR_TEXT_914", "위대한 알피스 박사의&작품이다!/");
ds_map_add(global.text_data_en, "SCR_TEXT_915", "이 타일들이 보이나!?/");
ds_map_add(global.text_data_en, "SCR_TEXT_916", "내가 이 스위치를&누르면.../");
ds_map_add(global.text_data_en, "SCR_TEXT_917", "색깔이 바뀌기&시작하지!/");
ds_map_add(global.text_data_en, "SCR_TEXT_918", "각 색깔은 다른 기능을&가지고 있다!/");
ds_map_add(global.text_data_en, "SCR_TEXT_919", "빨간 타일은&지나갈 수 없어!/");
ds_map_add(global.text_data_en, "SCR_TEXT_920", "그 위로 걸어갈 수&없다고!/");
ds_map_add(global.text_data_en, "SCR_TEXT_921", "노란 타일은 전기지!/");
ds_map_add(global.text_data_en, "SCR_TEXT_922", "너를 감전시켜&버릴 거다!/");
ds_map_add(global.text_data_en, "SCR_TEXT_923", "초록 타일은&알람 타일!/");
ds_map_add(global.text_data_en, "SCR_TEXT_924", "그걸 밟게 되면.../");
ds_map_add(global.text_data_en, "SCR_TEXT_925", "괴물과 싸워야 할 거다!!/");
ds_map_add(global.text_data_en, "SCR_TEXT_926", "주황 타일은&오렌지향이 나지./");
ds_map_add(global.text_data_en, "SCR_TEXT_927", "너한테서 맛있는 냄새가&나도록 만든다고!/");
ds_map_add(global.text_data_en, "SCR_TEXT_928", "파란 타일은 물 타일./");
ds_map_add(global.text_data_en, "SCR_TEXT_929", "원한다면 헤엄쳐가라고^1,&하지만.../");
ds_map_add(global.text_data_en, "SCR_TEXT_930", "만약 네게 오렌지&냄새가 난다면!/");
ds_map_add(global.text_data_en, "SCR_TEXT_931", "피라냐가&너를 물 거다./");
ds_map_add(global.text_data_en, "SCR_TEXT_932", "또^1, 노란색 타일 옆에&파란색 타일이 있다면,/");
ds_map_add(global.text_data_en, "SCR_TEXT_933", "물도^1, 너를&감전시킬 거야!/");
ds_map_add(global.text_data_en, "SCR_TEXT_934", "보라 타일은 미끄럽지!/");
ds_map_add(global.text_data_en, "SCR_TEXT_935", "앞 타일로&미끄러질 거야!/");
ds_map_add(global.text_data_en, "SCR_TEXT_936", "그런데^1, 그&미끄러운 비누에선.../");
ds_map_add(global.text_data_en, "SCR_TEXT_937", "레몬향이 나지!!!/");
ds_map_add(global.text_data_en, "SCR_TEXT_938", "피라냐가&싫어하는 향이다!/");
ds_map_add(global.text_data_en, "SCR_TEXT_939", "보라 타일 다음에&파랑 타일은 괜찮다!/");
ds_map_add(global.text_data_en, "SCR_TEXT_940", "마지막으로^1,&분홍색 타일./");
ds_map_add(global.text_data_en, "SCR_TEXT_941", "아무런 효과가 없지./");
ds_map_add(global.text_data_en, "SCR_TEXT_942", "마음껏 밟아도 좋다./");
ds_map_add(global.text_data_en, "SCR_TEXT_943", "어때!^1?&이해했나???/");
ds_map_add(global.text_data_en, "SCR_TEXT_944", "\TS \F0 \E0 \T0 %");
ds_map_add(global.text_data_en, "SCR_TEXT_945", "* (설 명 을  이 해 했 습 니 까 ?)& &         물 론         아 니 \C");
ds_map_add(global.text_data_en, "SCR_TEXT_946", "   ");
ds_map_add(global.text_data_en, "SCR_TEXT_953", "대단해!^1!&그럼 마지막으로.../");
ds_map_add(global.text_data_en, "SCR_TEXT_954", "이 퍼즐은.../");
ds_map_add(global.text_data_en, "SCR_TEXT_955", "완전 무작위다&!!!!!!/");
ds_map_add(global.text_data_en, "SCR_TEXT_956", "이 스위치를 누르면^1,&퍼즐이 만들어진다.../");
ds_map_add(global.text_data_en, "SCR_TEXT_957", "전에는 결코 본 적 없는!/");
ds_map_add(global.text_data_en, "SCR_TEXT_958", "나조차도 해답을 모르는&퍼즐이 말이지!/");
ds_map_add(global.text_data_en, "SCR_TEXT_959", "녜 헤 헤^1!&준비...!/%%");
ds_map_add(global.text_data_en, "SCR_TEXT_965", "좋아..^1.&다시 한번&말해줘야겠군.../");
ds_map_add(global.text_data_en, "SCR_TEXT_966", "\E0빨간 타일은&지나갈 수 없다!/");
ds_map_add(global.text_data_en, "SCR_TEXT_967", "노란 타일은&전기이고&위협적이지./");
ds_map_add(global.text_data_en, "SCR_TEXT_968", "파란 타일을 밟으면&괴물과 싸운다./");
ds_map_add(global.text_data_en, "SCR_TEXT_969", "초록 타일은&물 타일이고./");
ds_map_add(global.text_data_en, "SCR_TEXT_970", "주황 타일은&오렌지향이 난다./");
ds_map_add(global.text_data_en, "SCR_TEXT_971", "주황 타일을&밟았으면^1, 초록 타일은&밟지 마./");
ds_map_add(global.text_data_en, "SCR_TEXT_972", "\E3갈색 타일은.../");
ds_map_add(global.text_data_en, "SCR_TEXT_973", "\E1잠깐!!^1!&갈색 타일은 없는데.../");
ds_map_add(global.text_data_en, "SCR_TEXT_974", "\E0보라 타일은&레몬향이 나고.../");
ds_map_add(global.text_data_en, "SCR_TEXT_975", "\E3왜 노란 타일이&레몬향이&나지 않는 거지?/");
ds_map_add(global.text_data_en, "SCR_TEXT_976", "\E3음.../");
ds_map_add(global.text_data_en, "SCR_TEXT_977", "\E1잠깐!^1!&초록색과 파란색을&바꿔 말했나!?/");
ds_map_add(global.text_data_en, "SCR_TEXT_978", "파란 타일은&물이고!/");
ds_map_add(global.text_data_en, "SCR_TEXT_979", "\E3분홍 타일은.../");
ds_map_add(global.text_data_en, "SCR_TEXT_980", "기억이..^1.&안 나다니???/");
ds_map_add(global.text_data_en, "SCR_TEXT_981", "\E1그렇지!!!/");
ds_map_add(global.text_data_en, "SCR_TEXT_982", "\E3그건 아무&효과도 없어./");
ds_map_add(global.text_data_en, "SCR_TEXT_983", "\E0좋아^1!&이제 좀 더&잘 이해했나!?/");
ds_map_add(global.text_data_en, "SCR_TEXT_984", "\TS \F0 \E0 \T0 %");
ds_map_add(global.text_data_en, "SCR_TEXT_985", "* (설 명 을  이 해 했 습 니 까 ?)& &         예           더  모 르 겠 어 \C");
ds_map_add(global.text_data_en, "SCR_TEXT_986", "   ");
ds_map_add(global.text_data_en, "SCR_TEXT_994", "대단해!^1!&그럼 마지막으로.../");
ds_map_add(global.text_data_en, "SCR_TEXT_995", "이 퍼즐은.../");
ds_map_add(global.text_data_en, "SCR_TEXT_996", "완전 무작위다&!!!!!!/");
ds_map_add(global.text_data_en, "SCR_TEXT_997", "이 스위치를 누르면^1,&퍼즐이 만들어진다.../");
ds_map_add(global.text_data_en, "SCR_TEXT_998", "전에는 결코 본 적 없는!/");
ds_map_add(global.text_data_en, "SCR_TEXT_999", "나조차도 해답을 모르는&퍼즐이 말이지!/");
ds_map_add(global.text_data_en, "SCR_TEXT_1000", "녜 헤 헤^1!&준비...!/%%");
ds_map_add(global.text_data_en, "SCR_TEXT_1006", "........../");
ds_map_add(global.text_data_en, "SCR_TEXT_1007", "그래^1, 있잖아&???/");
ds_map_add(global.text_data_en, "SCR_TEXT_1008", "그럼..^1. &이건 어때.../");
ds_map_add(global.text_data_en, "SCR_TEXT_1009", "네가 스스로..^1.&직접 풀어 봐.../");
ds_map_add(global.text_data_en, "SCR_TEXT_1010", "여기 설명서를&남겨두도록 하지.../");
ds_map_add(global.text_data_en, "SCR_TEXT_1011", "읽어 봐./");
ds_map_add(global.text_data_en, "SCR_TEXT_1012", "다 이해하고 나서.../");
ds_map_add(global.text_data_en, "SCR_TEXT_1013", "스위치를 누르면 돼./");
ds_map_add(global.text_data_en, "SCR_TEXT_1014", "너 알아서 잘해봐./");
ds_map_add(global.text_data_en, "SCR_TEXT_1015", "행운을 빈다./");
ds_map_add(global.text_data_en, "SCR_TEXT_1016", "녜..^1.&헤..^1.&헤!/%%");
ds_map_add(global.text_data_en, "SCR_TEXT_1024", "* (키 슈  하 나 가&  벤 치  아 래 에&  놓 여  있 다 .)/");
ds_map_add(global.text_data_en, "SCR_TEXT_1025", "* (가 져 갑 니 까 ?)& &         가 져 간 다     놔 둔 다 \C");
ds_map_add(global.text_data_en, "SCR_TEXT_1026", " ");
ds_map_add(global.text_data_en, "SCR_TEXT_1029", "* 그 냥  벤 치 다 ./%%");
ds_map_add(global.text_data_en, "SCR_TEXT_1045", "* (버 려 진  키 슈 를  얻 었 다 .)/%%");
ds_map_add(global.text_data_en, "SCR_TEXT_1048", "* (너 무  많 이  들 고  있 다 .)/");
ds_map_add(global.text_data_en, "SCR_TEXT_1049", "* (당 신 은  책 임 질&  준 비 가  되 지  않 았 다 .)/%%");
ds_map_add(global.text_data_en, "SCR_TEXT_1053", "* (키 슈 는  혼 자&  외 롭 게  남 았 다 ...)/%%");
ds_map_add(global.text_data_en, "SCR_TEXT_1060", "* (바 닥 에  발 레 복 이&  놓 여  있 다 .)/");
ds_map_add(global.text_data_en, "SCR_TEXT_1061", "* (가 져 갑 니 까 ?)& &         가 져 간 다     놔 둔 다 \C");
ds_map_add(global.text_data_en, "SCR_TEXT_1062", " ");
ds_map_add(global.text_data_en, "SCR_TEXT_1065", "* 여 긴  아 무 것 도  없 다 !!!/%%");
ds_map_add(global.text_data_en, "SCR_TEXT_1081", "* (낡 은  발 레 복 을  얻 었 다 .)/%%");
ds_map_add(global.text_data_en, "SCR_TEXT_1084", "* (너 무  많 이  들 고  있 다 .)/%%");
ds_map_add(global.text_data_en, "SCR_TEXT_1088", " %%");
ds_map_add(global.text_data_en, "SCR_TEXT_1096", "* (상 자  안 에  \[1]장 의&  카 드 가  있 다 .)/");
ds_map_add(global.text_data_en, "SCR_TEXT_1097", "* (상 자  안 에  벌 레  두  마 리 가 &  카 드 \[1]장 으 로&  카 드 놀 이 를  하 고  있 다 .)/");
ds_map_add(global.text_data_en, "SCR_TEXT_1098", "* (\[1]장 의  카 드 로  만 들 어 진&  웃 는  얼 굴 이&  상 자  안 에  들 어  있 다 .)/");
ds_map_add(global.text_data_en, "SCR_TEXT_1099", "* (\[1]장 의  카 드 로  만 들 어 진&  집 이  상 자  안 에&놓 여  있 다 .)/");
ds_map_add(global.text_data_en, "SCR_TEXT_1100", "* (상 자 안 에  카 드 가&  넘 칠  정 도 로  담 겨  있 다 .)/");
ds_map_add(global.text_data_en, "SCR_TEXT_1101", "* (카 드 를  가 져 갑 니 까 ?)& &         가 져 간 다     놔 둔 다 \C");
ds_map_add(global.text_data_en, "SCR_TEXT_1102", " ");
ds_map_add(global.text_data_en, "SCR_TEXT_1105", "* (이 것 은  펀 치 카 드 를&  담 아  두 는  상 자 다 ^1.)&* (지 금 은  비 어  있 다 .)/%%");
ds_map_add(global.text_data_en, "SCR_TEXT_1120", "* (펀 치 카 드 를  얻 었 다 .)/%%");
ds_map_add(global.text_data_en, "SCR_TEXT_1121", "* (모 든  게 임 은  언 젠 가 는&  끝 이  나 야  한 다 ^1.)&* (펀 치 카 드 를  얻 었 다 .)/%%");
ds_map_add(global.text_data_en, "SCR_TEXT_1122", "* (행 복 은  잠 깐 이 다 ^1.)&* (펀 치 카 드 를  얻 었 다 .)/%%");
ds_map_add(global.text_data_en, "SCR_TEXT_1123", "* (집 이  무 너 졌 다 ^1.)&* (펀 치 카 드 를  얻 었 다 .)/%%");
ds_map_add(global.text_data_en, "SCR_TEXT_1124", "* (펀 치 카 드 를  얻 었 다 .)/%%");
ds_map_add(global.text_data_en, "SCR_TEXT_1127", "* (너 무  많 이  들 고  있 다 .)/%%");
ds_map_add(global.text_data_en, "SCR_TEXT_1131", " %%");
