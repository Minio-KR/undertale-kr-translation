ds_map_add(global.text_data_en, "obj_alphysfollow_event_109", "\E5* 계 -계 속  가 -가 !/%%");
ds_map_add(global.text_data_en, "obj_alphysfollow_event_148", "* 그 -그 래 서  이 제&  아 스 고 어  님 을  만 나 러&  가 는  거 지 ^1, 맞 지 ?/");
