ds_map_add(global.text_data_en, "obj_torieltrigger5_189", "* 누 가  그 랬 니 ^2?\E5 &* 혼 쭐 을  내 줘 야 겠 구 나 ./");
ds_map_add(global.text_data_en, "obj_torieltrigger5_190", "\E1* 너 를  이 렇 게  오 래&  내 버 려 두 면  안  됐 는 데 ./");
ds_map_add(global.text_data_en, "obj_torieltrigger5_191", "* 널  이 렇 게  놀 라 게  하 다 니&  내 가  무 책 임 했 었 구 나 ./");
ds_map_add(global.text_data_en, "obj_torieltrigger5_192", "\E8* 어 .../");
