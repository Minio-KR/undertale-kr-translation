ds_map_add(global.text_data_en, "SCR_TEXT_5657", "* 그 럼 ...!?/%%");
ds_map_add(global.text_data_en, "SCR_TEXT_5662", "* (뭔 가  걷 는&  소 리 가  들 린 다 .)/");
ds_map_add(global.text_data_en, "SCR_TEXT_5663", "* (문  아 래 로  뭔 가  넣 을  수&  있 는  것  같 다 .)/");
ds_map_add(global.text_data_en, "SCR_TEXT_5664", " & &         넣 는 다       안 넣 는 다 \C");
