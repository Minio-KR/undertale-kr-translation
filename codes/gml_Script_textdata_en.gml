ds_map_add(global.text_data_en, "obj_readable_room5_139", '* 그 러 나  "영 혼 "의  절 대 적 인&  본 질 이  무 엇 인 지 는&  알 려 지 지  않 았 다 ./');
ds_map_add(global.text_data_en, "obj_readable_room5_140", "* 인 간 은  영 혼 이  존 재 하 기&  위 해  그 런  게  필 요 한  건&  아 니 란  걸  보 였 다 .../%%");
