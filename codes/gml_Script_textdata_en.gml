ds_map_add(global.text_data_en, "obj_movedoge_271", "뭐 야 !!&내 가&쓰 다 듬 어&지 다 니 !!");
ds_map_add(global.text_data_en, "obj_movedoge_272", "대 체&어 디 서&들 이 닥 친&거 냐 !");
ds_map_add(global.text_data_en, "obj_movedoge_273", "끝 이 란&없 다 !");
ds_map_add(global.text_data_en, "obj_movedoge_274", "흠 ,&빈 틈 이&없 군 !");
ds_map_add(global.text_data_en, "obj_movedoge_277", "좋 아 ,&충 분 해 .");
