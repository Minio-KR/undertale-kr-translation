ds_map_add(global.text_data_en, "obj_movedoge_392", "* 도 고 는  아 무 것 도  발 견 하 지&  못 한  것  같 다 .");
ds_map_add(global.text_data_en, "obj_movedoge_393", "* 도 고 는  움 직 이 는  게  있 는 지&  확 인 하 고  있 다 .");
ds_map_add(global.text_data_en, "obj_movedoge_394", "* 도 고 는  던 지 고  물 어 오 기&  놀 이 를  좋 아 한 다 !!!");
ds_map_add(global.text_data_en, "obj_movedoge_395", "* 도 고 를  쓰 다 듬 었 다 .");
ds_map_add(global.text_data_en, "obj_movedoge_502", "* 도 고  - ATK 13 DEF 7&* 움 직 임 에  쉽 게  예 민 해 짐 .&  부 가  취 미 ^1: 다 람 쥐/^");
