ds_map_add(global.text_data_en, "obj_multitileevent_279", "* 오 오 오 , 유 감 입 니 다 !&* 시 간 이  다  된  것&  같 군 요 !!!/%%");
ds_map_add(global.text_data_en, "obj_multitileevent_304", "* 불 길 이  닥 쳐 옵 니 다 , 달 링 !/%%");
