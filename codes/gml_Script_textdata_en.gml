ds_map_add(global.text_data_en, "obj_adate_1287", "\E1어 어 어 ^1, \F4응 !/");
ds_map_add(global.text_data_en, "obj_adate_1288", "\E7 내  말 은 ^1,& \F5어 어 어  아 니 !/");
ds_map_add(global.text_data_en, "obj_adate_1289", "\E3 내  말 은 ^1,& \F7맞 긴  한 데 ^1, 그 ^1게%");
ds_map_add(global.text_data_en, "obj_adate_1290", "\E1 내  말 은 ^1, 로 맨 틱 하 게& 네  역 으 로  역 할 극 을& 하 고  있 었 던  거 야 !/%%");
ds_map_add(global.text_data_en, "obj_adate_1300", "\F3뭐 ???/%%");
