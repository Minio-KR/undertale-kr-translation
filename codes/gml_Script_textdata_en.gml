ds_map_add(global.text_data_en, "obj_cookshowevent_296", "\TS \E3 \F0 \TM %");
ds_map_add(global.text_data_en, "obj_cookshowevent_297", "* 여 보 세 요 ...?&* 지 금  한 창  바 쁩 니 다 만 ./");
ds_map_add(global.text_data_en, "obj_cookshowevent_298", "\TS \E3 \F6 \TA %");
ds_map_add(global.text_data_en, "obj_cookshowevent_299", "* 자 -잠 깐 만 !!/");
ds_map_add(global.text_data_en, "obj_cookshowevent_300", "* 그 게  어 쩌 면 .../");
ds_map_add(global.text_data_en, "obj_cookshowevent_301", "\E6* 그 게  아 마 .../");
ds_map_add(global.text_data_en, "obj_cookshowevent_302", "\E4* 그 게  혹 시  레 시 피 에&  대 체 재 를  쓰 는  건&  어 떨 까 ?!/");
