ds_map_add(global.text_data_en, "obj_mettnewsevent_175", "* 멋 진  저 녁 입 니 다 ^1,&  신 사  숙 녀  여 러 분 !/");
ds_map_add(global.text_data_en, "obj_mettnewsevent_176", "* MTT 뉴 스 에 서&  생 중 계  중 인&  메 타 톤 입 니 다 !/");
ds_map_add(global.text_data_en, "obj_mettnewsevent_177", "\M2* 핫 랜 드  동 쪽 에 서&  뭔 가  흥 미 로 운&  사 태 가  벌 어 졌 군 요 !/");
ds_map_add(global.text_data_en, "obj_mettnewsevent_178", "\M3* 다 행 히 도  저 희&  특 파 원 이  나 가 서&  생 중 계  중 이 랍 니 다 !/");
ds_map_add(global.text_data_en, "obj_mettnewsevent_179", "\M6* 용 감 한  특 파 원^1 !&* 뭔 가  보 도 할  만 한&  뉴 스 거 리 를  찾 아 와 요 !/");
ds_map_add(global.text_data_en, "obj_mettnewsevent_180", "\M4* 우 리  멋 진  10명 의&  시 청 자 들 이  당 신 을&  기 다 리 고  있 답 니 다 !!/%%");
ds_map_add(global.text_data_en, "obj_mettnewsevent_229", "\M3* 주 목 해 주 세 요 , 여 러 분 !&* 저 희  특 파 원 이 ..^1.&  개 를  찾 았 습 니 다 !/");
ds_map_add(global.text_data_en, "obj_mettnewsevent_230", "\M4* (방 청 객  소 리  큐 )/");
ds_map_add(global.text_data_en, "obj_mettnewsevent_231", "\M3* 맞 아 요 ^1, 여 러 분 ^1!&* 올 해  최 고 로  가 슴  따 뜻 한&  이 야 기 군 요 !/");
ds_map_add(global.text_data_en, "obj_mettnewsevent_232", "\M4* 저  작 은  귀 에 ^1,&  자 그 마 한  발 에 ^1,&  복 슬 한  꼬 리  좀  봐 요 .../");
ds_map_add(global.text_data_en, "obj_mettnewsevent_233", "* .../");
ds_map_add(global.text_data_en, "obj_mettnewsevent_234", "* 잠 시 만 요 ./");
ds_map_add(global.text_data_en, "obj_mettnewsevent_235", "\M5* 꼬 리 가  아 니 군 요 !/");
ds_map_add(global.text_data_en, "obj_mettnewsevent_236", "\M3* 저 건 .../");
ds_map_add(global.text_data_en, "obj_mettnewsevent_237", "\M5* 도 화 선 이 에 요 !/%%");
ds_map_add(global.text_data_en, "obj_mettnewsevent_264", "\M4* 그 래 요 ..^1.&* 저  개 는 .../");
ds_map_add(global.text_data_en, "obj_mettnewsevent_265", "\M5* 폭 탄 이 군 요 !/");
ds_map_add(global.text_data_en, "obj_mettnewsevent_266", "\M5* 하 지 만  흥 분 하 지  마 세 요 !/");
ds_map_add(global.text_data_en, "obj_mettnewsevent_267", "\M4* 아 직  방 의  다 른  곳 을&  보 지  않 았 잖 아 요 !/%%");
ds_map_add(global.text_data_en, "obj_mettnewsevent_283", "\M3* 주 목 ^1, 시 청 자  여 러 분 ^1!&* 저 희  특 파 원 이 ..^1. &  물  한  잔 을  찾 았 습 니 다 !/");
ds_map_add(global.text_data_en, "obj_mettnewsevent_284", "\M4* 하 지 만  이  물  한  잔 의&  정 말  놀 라 운  점 은 .../");
ds_map_add(global.text_data_en, "obj_mettnewsevent_285", "\M3* 정 말  평 범 하 단  거 예 요 !/");
ds_map_add(global.text_data_en, "obj_mettnewsevent_286", "\M4* 다 른  물 잔 들 처 럼&  이 것 들 로  이 루 어 졌 지 요 ,&  물 ^1, 유 리 ^1, 니 트 로 글 리 세 린 .../");
ds_map_add(global.text_data_en, "obj_mettnewsevent_287", "* .../");
ds_map_add(global.text_data_en, "obj_mettnewsevent_288", "* 잠 시 만 요 ./");
ds_map_add(global.text_data_en, "obj_mettnewsevent_289", "\M5* 저 건  물  한  잔 이&  아 니 군 요 !!!/");
ds_map_add(global.text_data_en, "obj_mettnewsevent_290", "\M3* 저 건 .../");
ds_map_add(global.text_data_en, "obj_mettnewsevent_291", "\M5* 폭 탄 입 니 다 !!!/%%");
ds_map_add(global.text_data_en, "obj_mettnewsevent_318", "\M5* 아 , 이 런 !!^1!&* 이  뉴 스  보 도 가 .../");
ds_map_add(global.text_data_en, "obj_mettnewsevent_319", "\M5* 재 난  보 도 로&  변 하 고  있 습 니 다 !!!/");
ds_map_add(global.text_data_en, "obj_mettnewsevent_320", "\M3* 하 지 만  흥 분 하 지  마 세 요 !/");
ds_map_add(global.text_data_en, "obj_mettnewsevent_321", "\M4* 아 직  방 의  다 른  곳 을&  보 지  않 았 잖 아 요 !/%%");
ds_map_add(global.text_data_en, "obj_mettnewsevent_337", "\M3* 주 목 ^1, 시 청 자  분 들 ^1!&* 저 희  특 파 원 이 ... &* 영 화  대 본 을  찾 았 습 니 다 !/");
ds_map_add(global.text_data_en, "obj_mettnewsevent_338", "\M5* 오  맙 소 사 !&* 게 다 가  제  최 신  영 화 의&  대 본  같 군 요 !/");
ds_map_add(global.text_data_en, "obj_mettnewsevent_339", "\M3* 가 만  두 지  말 자 구 요 !&  당 장  열 어 봅 시 다 !/%%");
ds_map_add(global.text_data_en, "obj_mettnewsevent_372", "\M4* ...어 라 ?^1?&* 대 본  안 에  있 는&  이 건  뭐 죠 ?/");
ds_map_add(global.text_data_en, "obj_mettnewsevent_373", "\M4* 이  똑 딱 이 는  소 리 ..^1.&* 불  붙 은  도 화 선 .../");
ds_map_add(global.text_data_en, "obj_mettnewsevent_374", "\M5* 아 , 이 런 !!^1!&* 제 가  영 화 를  잘 못  알 고&  있 었 나  봅 니 다 !/");
ds_map_add(global.text_data_en, "obj_mettnewsevent_375", "* 폭 발 적 인  반 응 을  받 을&  박 스  오 피 스 를&  손 에  넣 었 어 요 !/");
ds_map_add(global.text_data_en, "obj_mettnewsevent_376", "* 그 리 고  그  폭 발 로  당 신 이&  산 산 조 각 날  겁 니 다 !/");
ds_map_add(global.text_data_en, "obj_mettnewsevent_377", "\M3* 하 지 만  너 무&  흥 분 하 진  마 세 요 !/");
ds_map_add(global.text_data_en, "obj_mettnewsevent_378", "\M4* 아 직  방 의  다 른  곳 을&  보 지  않 았 잖 아 요 !/%%");
ds_map_add(global.text_data_en, "obj_mettnewsevent_394", "\M3* 주 목 ^1, 시 청 자  분 들 ^1!&* 저 희  특 파 원 이 ... &  농 구 공 을  찾 았 습 니 다 !/");
ds_map_add(global.text_data_en, "obj_mettnewsevent_395", "\M4* 아 ^1.&* 농 구 공 이 라 ./");
ds_map_add(global.text_data_en, "obj_mettnewsevent_396", "\M3* 흥 미 의  공 ^1.&* 즐 거 움 의  구 슬 ^1.&* 기 쁨 의  구 체 ./");
ds_map_add(global.text_data_en, "obj_mettnewsevent_397", "\M4* 하 지 만  갖 고  놀 아 선&  안  됩 니 다 ^1. MTT 브 랜 드 의&  패 션 용  공 이 라 고 요 ./");
ds_map_add(global.text_data_en, "obj_mettnewsevent_398", "\M3* 보 기  좋 게  두 려 면&  잘  관 리 해 야  합 니 다 ./");
ds_map_add(global.text_data_en, "obj_mettnewsevent_399", "\M3* 보 시 다 시 피 , 인 간  체 열 에&  노 출 된  것 만 으 로 도&  페 인 트 가  녹 고  있 잖 아 요 ./");
ds_map_add(global.text_data_en, "obj_mettnewsevent_400", "* .../");
ds_map_add(global.text_data_en, "obj_mettnewsevent_401", "* 잠 시 만 요 ./");
ds_map_add(global.text_data_en, "obj_mettnewsevent_402", "* 농 구 공 이  아 니 군 요 ./%%");
ds_map_add(global.text_data_en, "obj_mettnewsevent_429", "\M5* 폭 탄 입 니 다 !!!/");
ds_map_add(global.text_data_en, "obj_mettnewsevent_430", "* 아 , 이 런 !!^1!&* 이  스 포 츠  리 뷰 가 .../");
ds_map_add(global.text_data_en, "obj_mettnewsevent_431", "* 단 말 마 의  리 뷰 로&  변 하 고  있 습 니 다 !/");
ds_map_add(global.text_data_en, "obj_mettnewsevent_432", "* 하 지 만  곧  끝 날  겁 니 다 ^1.&* 일 단  당 신 이  터 지 면 요 ./");
ds_map_add(global.text_data_en, "obj_mettnewsevent_434", "\M3* 하 지 만  너 무&  흥 분 하 진  마 세 요 !/");
ds_map_add(global.text_data_en, "obj_mettnewsevent_435", "\M4* 아 직  방 의  다 른  곳 을&  보 지  않 았 잖 아 요 !/%%");
ds_map_add(global.text_data_en, "obj_mettnewsevent_449", "\M3* 주 목 ^1, 시 청 자  분 들 ^1!&* 저 희  특 파 원 이 ...&  선 물 을  찾 았 습 니 다 !/");
ds_map_add(global.text_data_en, "obj_mettnewsevent_450", "\M4* 선 물  풀 기  비 디 오 를&  찍 어 야 겠 어 요 !/");
ds_map_add(global.text_data_en, "obj_mettnewsevent_451", "\M5* 뭐 가  들 어  있 나  봅 시 다 !!/%%");
ds_map_add(global.text_data_en, "obj_mettnewsevent_479", "\M2* 저  둥 글 고 ^1, 까 만  모 양 은 ..^1.&* 이 럴  수 가 ?/");
ds_map_add(global.text_data_en, "obj_mettnewsevent_480", "\M4* 올 해 는  크 리 스 마 스 가&  일 찍  왔 나  보 군 요 ./");
ds_map_add(global.text_data_en, "obj_mettnewsevent_481", "\M5* 산 타 가  선 물  대 신&  폭 탄 을  준  거 라 면&  말 이 에 요 !/");
ds_map_add(global.text_data_en, "obj_mettnewsevent_482", "\M2* 하 지 만  참 ^1.&* 폭 탄 이 라 니  사 려  깊 은&  선 물 이 에 요 ./");
ds_map_add(global.text_data_en, "obj_mettnewsevent_483", "\M4* 당 신 을  위 해&  불 을  붙 여 주 기 까 지&  했 잖 아 요 !/");
ds_map_add(global.text_data_en, "obj_mettnewsevent_484", "\M3* 하 지 만  너 무&  흥 분 하 진  마 세 요 !/");
ds_map_add(global.text_data_en, "obj_mettnewsevent_485", "\M4* 아 직  방 의  다 른  곳 을&  보 지  않 았 잖 아 요 !/%%");
ds_map_add(global.text_data_en, "obj_mettnewsevent_499", "\M3* 주 목 ^1, 시 청 자  분 들 ^1!&* 저 희  특 파 원 이 ... &* 비 디 오  게 임 을  찾 았 습 니 다 !/");
ds_map_add(global.text_data_en, "obj_mettnewsevent_500", "\M4* 이  액 션  게 임 이  여 러 분 을&  아 주  뻥  날 려  버 리 리 라&  장 담 합 니 다 !/");
ds_map_add(global.text_data_en, "obj_mettnewsevent_501", "\M3* 기 괴 한  적 들 ^1!&* 기 괴 한  아 군 들 ^1!&* 매 력 적 인  로 봇 들 !/");
ds_map_add(global.text_data_en, "obj_mettnewsevent_502", "\M4* 한  번 에  임 의 의&  여 섯  개 의  대 화 문 을&  고 를  수  있 기 까 지 !/");
ds_map_add(global.text_data_en, "obj_mettnewsevent_503", "\M5* 특 파 원 ^1!&* 케 이 스  안 을  봐 요 !/%%");
ds_map_add(global.text_data_en, "obj_mettnewsevent_531", "\M4* ..^1.&* 불 붙 은  도 화 선 이  있 는&  붉 은  원 통 .../");
ds_map_add(global.text_data_en, "obj_mettnewsevent_532", "\M5* 아 , 안  돼 ^1!&* 이  게 임 은  말  그 대 로&  다 이 너 마 이 트 예 요 !/");
ds_map_add(global.text_data_en, "obj_mettnewsevent_533", "\M5* 그  말 이  다  맞 았 어 요 !/");
ds_map_add(global.text_data_en, "obj_mettnewsevent_534", "\M5* 비 디 오  게 임 은&  폭 력 성 을  유 발 한 다 !/");
ds_map_add(global.text_data_en, "obj_mettnewsevent_535", "\M4* 아 님  적 어 도&  이 건  그 렇 게  되 겠 군 요 ./");
ds_map_add(global.text_data_en, "obj_mettnewsevent_536", "\M3* 하 지 만  너 무&  흥 분 하 진  마 세 요 !/");
ds_map_add(global.text_data_en, "obj_mettnewsevent_537", "\M4* 아 직  방 의  다 른  곳 을&  보 지  않 았 잖 아 요 !/%%");
ds_map_add(global.text_data_en, "obj_mettnewsevent_609", "* 세 상 에 !/");
ds_map_add(global.text_data_en, "obj_mettnewsevent_610", "* 여 기  있 는  모 든  것 들 이&  폭 탄 인 가  보 네 요 !/");
ds_map_add(global.text_data_en, "obj_mettnewsevent_613", "* 저  개 도  폭 탄 이 에 요 !/%%");
ds_map_add(global.text_data_en, "obj_mettnewsevent_618", "* 저  선 물 도  폭 탄 이 에 요 !/%%");
ds_map_add(global.text_data_en, "obj_mettnewsevent_649", "* 저  농 구 공 도  폭 탄 이 에 요 !/%%");
ds_map_add(global.text_data_en, "obj_mettnewsevent_654", "* 저  선 물 도  폭 탄 이 에 요 !/%%");
ds_map_add(global.text_data_en, "obj_mettnewsevent_684", "* 저 의  이  말 들 조 차 도 ...!/%%");
ds_map_add(global.text_data_en, "obj_mettnewsevent_694", "\TS ^7 %");
ds_map_add(global.text_data_en, "obj_mettnewsevent_695", " %%");
ds_map_add(global.text_data_en, "obj_mettnewsevent_708", "\W* 용 감 한  특 파 원  씨 ..^1.&* 당 신 이  저  모 든  폭 탄 을&  해 체 하 지  않 는 다 면 .../%%");
ds_map_add(global.text_data_en, "obj_mettnewsevent_730", "\W*\M9 \Y2분\W  내 로&  커 다 란  폭 탄 이  당 신 을&  산 산 조 각 내 어 버 릴  겁 니 다 !/");
ds_map_add(global.text_data_en, "obj_mettnewsevent_731", "\M8* 그 럼  더  이 상  '생 생 한 '&  보 도 는  못 하 게  될  거 예 요 !/");
ds_map_add(global.text_data_en, "obj_mettnewsevent_732", "* 끔 찍 해 라 ^1!&* 충 격 적 이 군 요 !/");
ds_map_add(global.text_data_en, "obj_mettnewsevent_733", "\M9* 우 리  9명 의&  시 청 자 들 이  정 말&  보 고  싶 어 할  거 예 요 !/");
ds_map_add(global.text_data_en, "obj_mettnewsevent_734", "* 행 운 을  빌 어 요 ^1, 달 링 !/%%");
ds_map_add(global.text_data_en, "obj_mettnewsevent_827", "* 따 르 릉 .../");
ds_map_add(global.text_data_en, "obj_mettnewsevent_828", "\TS \E3 \F6 \TA %");
ds_map_add(global.text_data_en, "obj_mettnewsevent_829", "* 거 -걱 정  마 !/");
ds_map_add(global.text_data_en, "obj_mettnewsevent_830", "\E6* 네  전 화 에  폭 탄&  해 체  프 로 그 램 을&  깔 아  뒀 어 !/");
ds_map_add(global.text_data_en, "obj_mettnewsevent_831", "\W* 폭 탄 이  \G해 체  지 점\W 에&  들 어 오 면  '해 체 '를&  사 용 해 !/");
ds_map_add(global.text_data_en, "obj_mettnewsevent_832", "\E0* 자 -자 ^1, 이 제&  가 서  해 체 하 자 고 !/%%");
ds_map_add(global.text_data_en, "obj_mettnewsevent_925", "* 잘 했 어 요 ^1, 달 링 !/");
ds_map_add(global.text_data_en, "obj_mettnewsevent_926", "* 폭 탄 을  모 두  해 체 했 어 요 !/");
ds_map_add(global.text_data_en, "obj_mettnewsevent_927", "\W* 모 두  해 체 하 지  않 았 다 면 ^1,&  커 다 란  폭 탄 이  \Y2분\W  내 로&  폭 발 했 을  거 예 요 ./");
ds_map_add(global.text_data_en, "obj_mettnewsevent_928", "\W* 이 젠  \Y2분\W  내 로&  폭 발 하 지  않 습 니 다 !/");
ds_map_add(global.text_data_en, "obj_mettnewsevent_929", "\W*\M9 대 신  \Y2초\W  내 로&  폭 발 합 니 다 !/");
ds_map_add(global.text_data_en, "obj_mettnewsevent_930", "* 잘  가 요 ^1, 달 링 !/%%");
ds_map_add(global.text_data_en, "obj_mettnewsevent_934", "* 유 감 이 에 요 ^1, 달 링 !/");
ds_map_add(global.text_data_en, "obj_mettnewsevent_935", "\W* \Y3분\W  내 로  모 든  폭 탄 을&  해 체 하 는  데 에&  실 패 했 어 요 !/");
ds_map_add(global.text_data_en, "obj_mettnewsevent_936", "* 이 제  저  큰  폭 탄 이&  터 져 서  당 신 을&  산 산 조 각 낼 거 예 요 !/");
ds_map_add(global.text_data_en, "obj_mettnewsevent_937", "* 준 비 됐 나 요 ^1, 여 러 분 ^1?&* 여 러 분 이  가 장  고 대 해  온&  순 간 입 니 다 !/");
ds_map_add(global.text_data_en, "obj_mettnewsevent_938", "* 아 하 하 하 !/");
ds_map_add(global.text_data_en, "obj_mettnewsevent_939", "* 잘  가 요 ^1, 달 링 !/%%");
ds_map_add(global.text_data_en, "obj_mettnewsevent_987", "\M8* 아 ./");
ds_map_add(global.text_data_en, "obj_mettnewsevent_988", "* 폭 탄 이  안  터 졌 나  보 군 요 ./");
ds_map_add(global.text_data_en, "obj_mettnewsevent_989", "\S-\Sp\T0* 따 르 릉 ...\S+/");
ds_map_add(global.text_data_en, "obj_mettnewsevent_991", "* 왜 -왜 냐 하 면 !!!/");
ds_map_add(global.text_data_en, "obj_mettnewsevent_992", "* 네 가  혼 잣 말 을  하 는&  도 중 에 ... 내 가 ...!!/");
ds_map_add(global.text_data_en, "obj_mettnewsevent_993", "\E4* 내 가  고 쳤 ..^1.&* 음 ..^1. 바 -바 꿔 서 .../");
ds_map_add(global.text_data_en, "obj_mettnewsevent_994", "\TS \F0 \E0 \TM %");
ds_map_add(global.text_data_en, "obj_mettnewsevent_995", "* 아 , 이 런 ^1.&* 그  해 킹  기 술 로  폭 탄 을&  해 체 한  것 이 로 군 요 ./");
ds_map_add(global.text_data_en, "obj_mettnewsevent_997", "* 그 래 ^1!&* 바 로  내 가  그 랬 어 !/");
ds_map_add(global.text_data_en, "obj_mettnewsevent_998", "\TS \F0 \E0 \TM %");
ds_map_add(global.text_data_en, "obj_mettnewsevent_999", "\M9* 젠 장 ^1!&* 또  일 을  망 쳐 버 렸 군 요 !/");
ds_map_add(global.text_data_en, "obj_mettnewsevent_1000", "* 저 주 합 니 다 ^1, 인 간 ^1!&* 저 주 해 요 ^1, 알 피 스  박 사 ^1!&  그 렇 게 나  도 와  주 다 니 !/");
ds_map_add(global.text_data_en, "obj_mettnewsevent_1001", "\M8* 하 지 만  계 속  봐 주 신&  여 덟  명 의  멋 진  시 청 자&  분 들 은  저 주 하 지  않 아 요 !/");
ds_map_add(global.text_data_en, "obj_mettnewsevent_1002", "* 다 음 에  봐 요 ^1, 달 링 !/%%");
ds_map_add(global.text_data_en, "obj_mettnewsevent_1017", "* 와 -와 우 ..^1.&* 하 -한  방  먹 였 네 ^1,&  그 렇 지 ?/");
ds_map_add(global.text_data_en, "obj_mettnewsevent_1018", "\E2* .../");
ds_map_add(global.text_data_en, "obj_mettnewsevent_1019", "\E4* 저 -저 기 ^1, 처 음 엔  나 도&  좀  어 색 했 었 지 만 .../");
ds_map_add(global.text_data_en, "obj_mettnewsevent_1020", "\E0* 내  생 각 엔  이 제&  점 점  더 .../");
ds_map_add(global.text_data_en, "obj_mettnewsevent_1021", "\E4* 어 ^1, 더 .../");
ds_map_add(global.text_data_en, "obj_mettnewsevent_1022", "\E6* 널  이 끄 는  데&  자 신 감 이  생 긴  것&  같 아 !/");
ds_map_add(global.text_data_en, "obj_mettnewsevent_1023", "\E0* 그 -그 러 니  그 -그&  머 -멍 청 한  로 봇 은&  걱 정 하 지  마 .../");
ds_map_add(global.text_data_en, "obj_mettnewsevent_1024", "\E6* 내 -내 가  널&  지 켜 줄  테 니 까 !/");
ds_map_add(global.text_data_en, "obj_mettnewsevent_1025", "\E3* 그 -그 리 고  지 -진 짜&  큰  일 이  벌 어 지 면 ^1,&  그 -그 냥 .../");
ds_map_add(global.text_data_en, "obj_mettnewsevent_1026", "\E5* 음 ^1, 아 무 것 도  아 냐 ./");
ds_map_add(global.text_data_en, "obj_mettnewsevent_1027", "\E0* 이 따  봐 !/");
ds_map_add(global.text_data_en, "obj_mettnewsevent_1028", "\TS \F0 \E0 \T0 %");
ds_map_add(global.text_data_en, "obj_mettnewsevent_1029", "* (삑 ...)/%%");
ds_map_add(global.text_data_en, "obj_mettnewsevent_1034", "* 저 -정 말 ..^1.&* 아 슬 아 슬 했 지 ^1, 응 ?/");
ds_map_add(global.text_data_en, "obj_mettnewsevent_1035", "\E8* 내  예 상 보 다  조 금  더&  아 슬 아 슬 했 던  것  같 아 ./");
ds_map_add(global.text_data_en, "obj_mettnewsevent_1036", "\E9* 네 게  옳 은  방 향 을&  알 려  줬 어 야  했 는 데 .../");
ds_map_add(global.text_data_en, "obj_mettnewsevent_1037", "\E8* 그 -그 리 고  시 -시 간 이&  벼 -별 로  없 었 으 니 .../");
ds_map_add(global.text_data_en, "obj_mettnewsevent_1038", "\E6* 뭐 -뭐 ^1!&* 메 타 톤  잘 못 이 지 ^1,&  내  잘 못  아 니 니 까 !/");
ds_map_add(global.text_data_en, "obj_mettnewsevent_1039", "\E9* 지 -지 금 은  나 도&  잘  모 르 겠 어 ./");
ds_map_add(global.text_data_en, "obj_mettnewsevent_1040", "\E4* 너 -널  이 끌 어 주 는  데&  자 신 감 이  생 기 기&  시 작 했 어 ./");
ds_map_add(global.text_data_en, "obj_mettnewsevent_1041", "\E6* 무 -무 슨  일 이  있 어 도&  널  그  낡 고  못 된&  로 봇 에 게 서  지 켜 줄 게 !/");
ds_map_add(global.text_data_en, "obj_mettnewsevent_1042", "\E3* 또  굳 이  해 야  한 다 면 ^1,&  내 가 .../");
ds_map_add(global.text_data_en, "obj_mettnewsevent_1043", "\E5* 음 ^1, 아 무 것 도  아 냐 ./");
ds_map_add(global.text_data_en, "obj_mettnewsevent_1044", "\E0* 코 어 에  반 쯤 은  다  왔 어 !/");
