ds_map_add(global.text_data_en, "item_desc_0_0", "* 네 가  이 걸  읽 고  있 다 면 ,&  어 떻 게 든  난  망 한  거 야 ./%");
ds_map_add(global.text_data_en, "item_desc_1_0", '* "괴 물 사 탕 " - HP 10 회 복&* 감 초 맛 은  아 니 지 만 ,^1 &  뚜 렷 한  맛 이  난 다 ./%');
ds_map_add(global.text_data_en, "item_desc_2_0", '* "크 로 켓  롤 " - HP 15 회 복&* 전 통 적 으 로  타 구 망 치 와&  같 이  제 공 되 는  튀 김  도 넛 ./%');
ds_map_add(global.text_data_en, "item_desc_3_0", '* "막 대 기 " - 무 기 , AT 0&* 겉 보 기 와  달 리&  위 협 적 이 지  않 다 ./%');
ds_map_add(global.text_data_en, "item_desc_4_0", '* "반 창 고 " - HP 10 회 복&* 이 미  여 러  번&  붙 였 던  것 이 다 ./%');
ds_map_add(global.text_data_en, "item_desc_5_0", '* "돌 사 탕 " - HP 1 회 복&* 집 에 서 도  따 라  할  수  있 는&  요 리 법 이  적 혀  있 다 ./');
ds_map_add(global.text_data_en, "item_desc_5_1", "* 1. 돌 을  찾 는 다 ./%");
ds_map_add(global.text_data_en, "item_desc_6_0", '* "호 박  링 " - HP 8 회 복&* 양 파 링 처 럼&  조 리 된  작 은  호 박 ./%');
ds_map_add(global.text_data_en, "item_desc_7_0", '* "거 미  도 넛 " - HP 12 회 복&* 거 미  사 이 다 를  반 죽 에&  넣 어  만 든  도 넛 ./%');
ds_map_add(global.text_data_en, "item_desc_8_0", '* "순 한 양 파 " - HP 5 회 복&* 날  것 으 로  먹 더 라 도 ^1,&  눈 물 이  나 지  않 는 다 ./%');
ds_map_add(global.text_data_en, "item_desc_9_0", '* "유 령 과 일 " - HP 16 회 복&* 먹 더 라 도 ^1 몸 을  통 과 해&  나 오 지 는  않 는 다 ./%');
ds_map_add(global.text_data_en, "item_desc_10_0", '* "거 미  사 이 다 " - HP 24 회 복&* 거 미 가  즙 만 이  아 니 라 ,^1 &  통 으 로  들 어 갔 다 ./%');
