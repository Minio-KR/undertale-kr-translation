ds_map_add(global.text_data_en, "obj_darksans1_187", "* 헤 헤 헤 ...&  옛 날 부 터  써  먹 었 던&  방 귀 쿠 션  악 수 .../");
ds_map_add(global.text_data_en, "obj_darksans1_188", "* 언 제 나  재 밌 단  말 야 ./");
ds_map_add(global.text_data_en, "obj_darksans1_189", "* 그 건  그 렇 고 ^1,&  너  인 간 이 지 ?/");
ds_map_add(global.text_data_en, "obj_darksans1_190", "\E1* 정 말 로  웃 기 는 구 만 ./");
ds_map_add(global.text_data_en, "obj_darksans1_193", "* 헤 ^1, 방 귀 쿠 션&  악 수 .../");
ds_map_add(global.text_data_en, "obj_darksans1_194", "\E1* 잠 깐 ..^1.&* 뭐  어 디 서  보 고&  오 기 라 도  한  거 야 ?/");
ds_map_add(global.text_data_en, "obj_darksans1_195", "\E1* 내 가  말 하 기 도  전 에&  뒤 를  돌 아 보 다 니 ..^1.&* ...이 상 하 군 ./");
ds_map_add(global.text_data_en, "obj_darksans1_196", "* ...뭐  어 때 ^1.&* 너 ^1, 인 간  맞 지 ?/");
ds_map_add(global.text_data_en, "obj_darksans1_198", "\E0* 난  샌 즈 야 ^1.&* 뼈 다 귀  샌 즈 ./");
ds_map_add(global.text_data_en, "obj_darksans1_199", "* 원 래  인 간 들 을&  감 시 하 는  일 을&  해 야  하 는 데 ./");
ds_map_add(global.text_data_en, "obj_darksans1_200", "* 근 데 ..^1. 그 냥 .../");
ds_map_add(global.text_data_en, "obj_darksans1_201", "\E1* 누 구  잡 는  일 은&  딱 히  신 경  안  써 서 ./");
ds_map_add(global.text_data_en, "obj_darksans1_202", "\E0* 근 데  내  동 생 인 ^1,&  파 피 루 스 는 .../");
ds_map_add(global.text_data_en, "obj_darksans1_203", "* 걔 는  인 간  사 냥 에&  미 친 놈 이 야 ./");
ds_map_add(global.text_data_en, "obj_darksans1_204", "\E1* 아 ^1, 사 실 ^1, 저 기&  저 쪽 에  있 는  것&  같 은 데 ./");
ds_map_add(global.text_data_en, "obj_darksans1_205", "\E0* 재 밌 는  생 각 이  났 어 ^1.&* 이  대 문 같 이  생 긴  걸&  지 나 가  봐 ./");
ds_map_add(global.text_data_en, "obj_darksans1_206", "* 그 냥  지 나 가 면  돼 ^1.&* 동 생 이  좀  넓 게  만 들 어 서&  그 냥  드 나 들  수  있 어 ./%%");
ds_map_add(global.text_data_en, "obj_darksans1_210", "* 헤 헤 헤 ...&  옛 날 부 터  써  먹 었 던&  방 귀 쿠 션  악 수 .../");
ds_map_add(global.text_data_en, "obj_darksans1_211", "* 언 제 나  재 밌 단  말 야 ./");
ds_map_add(global.text_data_en, "obj_darksans1_212", "* .../");
ds_map_add(global.text_data_en, "obj_darksans1_213", "\E1* 어 ^1, 음 ^1.&* 딱  웃 음  타 이 밍 인 데 ./");
ds_map_add(global.text_data_en, "obj_darksans1_214", "\E2* 아 니 면 ^1, 음 ^1,&  무 슨  반 응 이 라 도&  보 여 주 거 나 ...?/");
ds_map_add(global.text_data_en, "obj_darksans1_215", "\E0* .../");
ds_map_add(global.text_data_en, "obj_darksans1_216", "\E1* (으 ^1, 아 주 머 니 ^1,&  진 짜  이 런  놈 을&  고 르 신  거 예 요 ...?)/");
ds_map_add(global.text_data_en, "obj_darksans1_217", "\E2* 뭐 ^1, 상 관 없 어 ^1.&* 다 들  유 머  감 각 은&  다 르 니 까 ./");
ds_map_add(global.text_data_en, "obj_darksans1_218", "\E0* 난  샌 즈 야 ^1.&* 뼈 다 귀  샌 즈 ./");
ds_map_add(global.text_data_en, "obj_darksans1_219", "* 원 래  인 간 들 을&  감 시 하 는  일 을&  해 야  하 는 데 ./");
ds_map_add(global.text_data_en, "obj_darksans1_220", "* 근 데 ..^1. 그 냥 .../");
ds_map_add(global.text_data_en, "obj_darksans1_221", "\E1* 누 구  잡 는  일 은&  딱 히  신 경  안  써 서 ./");
ds_map_add(global.text_data_en, "obj_darksans1_222", "\E0* 근 데  내  동 생 인 ^1,&  파 피 루 스 는 .../");
ds_map_add(global.text_data_en, "obj_darksans1_223", "* 걔 는  인 간  사 냥 에&  미 친 놈 이 야 ./");
ds_map_add(global.text_data_en, "obj_darksans1_224", "\E1* 아 ^1, 사 실 ^1, 저 기&  저 쪽 에  있 는  것&  같 은 데 ./");
ds_map_add(global.text_data_en, "obj_darksans1_225", "\E0* 재 밌 는  생 각 이  났 어 ^1.&* 이  대 문 같 이  생 긴  걸&  지 나 가  봐 ./");
ds_map_add(global.text_data_en, "obj_darksans1_226", "* 그 냥  지 나 가 면  돼 ^1.&* 동 생 이  좀  넓 게  만 들 어 서&  그 냥  드 나 들  수  있 어 ./%%");
ds_map_add(global.text_data_en, "obj_darksans1_345", "* 인 간 ./");
ds_map_add(global.text_data_en, "obj_darksans1_346", "* 새 로 운  친 구 와&  인 사 하 는  법 을&  모 르 는  건 가 ?/");
ds_map_add(global.text_data_en, "obj_darksans1_347", "* 돌 아 서 서&  나 와  악 수 해 ./%%");
ds_map_add(global.text_data_en, "obj_darksans1_354", "* 인 간 ./");
ds_map_add(global.text_data_en, "obj_darksans1_355", " %");
ds_map_add(global.text_data_en, "obj_darksans1_356", " %%");
ds_map_add(global.text_data_en, "obj_darksans1_399", "* 빨 리 ^1, 저 기  알 맞 게&  생 긴  전 등  뒤 로  숨 어 ./%%");
ds_map_add(global.text_data_en, "obj_darksans1_457", "* 여 어 ^1, 동 생 ./");
ds_map_add(global.text_data_en, "obj_darksans1_459", "여어는&무슨,^1 형!/");
ds_map_add(global.text_data_en, "obj_darksans1_460", "8일이나 되었는데&형은 아직도.../");
ds_map_add(global.text_data_en, "obj_darksans1_461", "형. 퍼즐을^1.&안 손봤잖아^1!/");
ds_map_add(global.text_data_en, "obj_darksans1_462", "초소 밖으로&놀러 다니고나 있고!/");
ds_map_add(global.text_data_en, "obj_darksans1_463", "여기서 뭐 하고&있는 거야?!?/");
ds_map_add(global.text_data_en, "obj_darksans1_465", "* 전 등 을  보 고  있 어 ^1.&* 정 말  멋 지 다 고 ^1.&* 너 도  볼 래 ?/%%");
ds_map_add(global.text_data_en, "obj_darksans1_480", "아니!^1!&그럴 시간 없어!!/");
ds_map_add(global.text_data_en, "obj_darksans1_481", "만약 인간이 여기로&오면 어쩌려고!?!/");
ds_map_add(global.text_data_en, "obj_darksans1_482", "완전히 대비하고&싶단 말이야!!!/");
ds_map_add(global.text_data_en, "obj_darksans1_483", "내가 준비되어 있어야 한다고!&무조건 그래야 해!/");
ds_map_add(global.text_data_en, "obj_darksans1_484", "내가 인간을&잡고 말 거야!/%%");
ds_map_add(global.text_data_en, "obj_darksans1_496", "그리고^1, 나^1,&위대한 파피루스 님은.../");
ds_map_add(global.text_data_en, "obj_darksans1_497", "내가 응당히&받아야 할 것들을&모두 얻을 것이노라!/");
ds_map_add(global.text_data_en, "obj_darksans1_498", "존경..^1.&인정.../");
ds_map_add(global.text_data_en, "obj_darksans1_499", "드디어 왕실 근위병이&될 수 있겠지!/");
ds_map_add(global.text_data_en, "obj_darksans1_500", '사람들은, 나에게^1,&"친구"^1, 해주실래요^1,&라고 물어보겠지?/');
ds_map_add(global.text_data_en, "obj_darksans1_501", "\E2매일 아침 키스 세례로&샤워를 할 거야./%%");
ds_map_add(global.text_data_en, "obj_darksans1_514", "* 흠 .../");
ds_map_add(global.text_data_en, "obj_darksans1_515", "\E1* 아 마  이  전 등 이&  도 움 이  될  것  같 은 데 ./%%");
ds_map_add(global.text_data_en, "obj_darksans1_528", "샌즈 형!^1! 형은 전혀&도움이 안 돼!^1!&이 게으른 뼉다귀야!!/");
ds_map_add(global.text_data_en, "obj_darksans1_529", "형이 하는 일은&앉아서 딴 짓하는&것밖에 없어!/");
ds_map_add(global.text_data_en, "obj_darksans1_530", "형은 매일 더&게을러지고 있다고!!!/");
ds_map_add(global.text_data_en, "obj_darksans1_532", "\W* 야 ^1, 진 정 해 ^1.&* 나 도  오 늘 은  \Y뭐\W &  빠 지 게  일 했 다 고 ./");
ds_map_add(global.text_data_en, "obj_darksans1_533", "\W*\E2 \Y뼈\W  빠 지 게 ./%%");
ds_map_add(global.text_data_en, "obj_darksans1_582", "샌즈 형!!!/");
ds_map_add(global.text_data_en, "obj_darksans1_584", "\E1* 에 이 , 왜  그 래 ^1.&* 너 도  웃 고  있 잖 아 ./");
ds_map_add(global.text_data_en, "obj_darksans1_586", "그렇긴 한데 이러는&내가 나도 싫다고!/");
ds_map_add(global.text_data_en, "obj_darksans1_587", "\E3하아.../");
ds_map_add(global.text_data_en, "obj_darksans1_588", "\E2왜 나같이&위대한 사람이.../");
ds_map_add(global.text_data_en, "obj_darksans1_589", "\E3사람들의 시선을&끌려고 엄청 노력해야&하는 거야.../");
ds_map_add(global.text_data_en, "obj_darksans1_591", "* 와 ^1, 엄 청  노 력 하 는  것&  같 네 .../");
ds_map_add(global.text_data_en, "obj_darksans1_592", "\E2* 뼛 속 까 지  말 이 야 ./%%");
ds_map_add(global.text_data_en, "obj_darksans1_604", "얽!!!/");
ds_map_add(global.text_data_en, "obj_darksans1_605", "난 이제 내 퍼즐을&보러 가겠어.../");
ds_map_add(global.text_data_en, "obj_darksans1_606", "\E3그럼 형은&뭘 해야 하냐고?/");
ds_map_add(global.text_data_en, "obj_darksans1_607", "좀 더,/");
ds_map_add(global.text_data_en, "obj_darksans1_608", "\E4뼈를 깎는 노력을&하도록 해!!!!/");
ds_map_add(global.text_data_en, "obj_darksans1_609", "\E2녜헤헤헤헤헤헤헤&헤헤헤헤헤헤헤!!!/%%");
ds_map_add(global.text_data_en, "obj_darksans1_644", "헤!/%%");
ds_map_add(global.text_data_en, "obj_darksans1_666", "* 좋 아 ^1,&  이 제  나 와 도  돼 ./%%");
ds_map_add(global.text_data_en, "obj_darksans1_720", "* .../");
ds_map_add(global.text_data_en, "obj_darksans1_721", "\E1* 어 ^1, 좋 아 ^1,&  안  그 래 도  될  것  같 아 ./%%");
ds_map_add(global.text_data_en, "obj_darksans1_750", "샌즈 형!!^1!&아직도 인간을&못 찾았어!??!/");
ds_map_add(global.text_data_en, "obj_darksans1_752", "* 찾 았 어 ./");
ds_map_add(global.text_data_en, "obj_darksans1_754", "정말!?!^1?&세에상에!!!/");
ds_map_add(global.text_data_en, "obj_darksans1_755", "잘 됐군!!/%%");
ds_map_add(global.text_data_en, "obj_darksans1_780", "* 잘  넘 어 갔 네 ^1, 그 렇 지 ?/%%");
ds_map_add(global.text_data_en, "obj_darksausagenpc_72", "* 왜  난  이 상 한  검 은&  소 시 지 같 이  보 이 지 ^1?&* 여 기 서 만  보 면  그 렇 지 만 ./%%");
ds_map_add(global.text_data_en, "obj_darksausagenpc_76", "* 어 렸 을  땐 ^1,&  이  으 시 시 한  불 구 덩 이&  근 처 에  숨 곤  했 어 ./");
ds_map_add(global.text_data_en, "obj_darksausagenpc_77", "* 이  코 어 는&  계 속  바 뀌 니 까 ^1,&  보 물 찾 기  같 아 ./");
ds_map_add(global.text_data_en, "obj_darksausagenpc_78", "* 여 긴  내  특 별 한  장 소 야 ^1.&* 여 긴  요 리 같 은  걸&  하 기 에  아 주  좋 거 든 ./%%");
ds_map_add(global.text_data_en, "obj_darksausagenpc_83", "* 메 타 톤 은  널  없 애 기  위 해&  우 리 를  고 용 했 다 ./");
ds_map_add(global.text_data_en, "obj_darksausagenpc_84", "* 그 치 만  우 리 에 게  한  푼 도 ^1,&  보 수 를  주 지  않 아&  그 만 두 기 로  했 어 ./");
ds_map_add(global.text_data_en, "obj_darksausagenpc_85", "* 나 쁜  감 정 은  없 었 다 고 ./%%");
ds_map_add(global.text_data_en, "obj_darksausagenpc_90", "* 드 르 렁 .../");
ds_map_add(global.text_data_en, "obj_darksausagenpc_91", "* (낮 잠 을  자 고  있 다 .)/%%");
ds_map_add(global.text_data_en, "obj_darksausagenpc_96", "* 왜  난  전 사 나  마 법 사 가&  아 니 라  이 상 한  검 은&  소 시 지 로  보 이 는  거 야 ?/");
ds_map_add(global.text_data_en, "obj_darksausagenpc_97", "* 뭐 ..^1.&* 모 두  나 름  얼 짱  각 도 가&  있 는  법 이 긴  하 지 만 ../%%");
ds_map_add(global.text_data_en, "obj_darksausagenpc_102", "* 이  코 어 는  계 속  바 뀌 는&  방 들 로  만 들 어 져  있 어 ./");
ds_map_add(global.text_data_en, "obj_darksausagenpc_103", "* 네 가  오 기  전 에 ^1, 구 조 가&  바 뀌 었 으 니 ^1, 길 을  잃 어&  사 라 져  버 릴 지 도  몰 라 ./");
ds_map_add(global.text_data_en, "obj_darksausagenpc_104", "* 그 래 ^1. 바 로  너  때 문 에 ^1.&* 이 제  좀  특 별 해 진&  기 분 이  드 니 ?/%%");
ds_map_add(global.text_data_en, "obj_darksink_91", "* Error./%%");
ds_map_add(global.text_data_en, "obj_darksink_98", "* (당 신 은  싱 크 대 의  물 을  틀 었 다 .)/%%");
ds_map_add(global.text_data_en, "obj_darksink_100", "* (정 말 로  손 을  씻 고  싶 어 진 다 .)/%%");
ds_map_add(global.text_data_en, "obj_darksink_110", "* (당 신 은  싱 크 대 의  물 을  잠 갔 다 .)/%%");
ds_map_add(global.text_data_en, "obj_darksink_122", "* (당 신 은  싱 크 대 의  물 을  틀 었 다 .)/%%");
ds_map_add(global.text_data_en, "obj_darksink_132", "* (싱 크 대 에  빨 간 색  열 쇠 가&  놓 여  있 다 .)/");
ds_map_add(global.text_data_en, "obj_darksink_133", "* (당 신 은  그 것 을  주 워&  열 쇠 고 리 에  걸 었 다 .)/%%");
ds_map_add(global.text_data_en, "obj_dateheart_158", "\E3알겠다^1. 알겠다./");
ds_map_add(global.text_data_en, "obj_dateheart_159", "\E0떠다니는 하트로&내 이두박근을&어루만지는 게 좋구나./");
ds_map_add(global.text_data_en, "obj_dateheart_160", "\E1하지만 누가 싫어하겠어!?/%%");
ds_map_add(global.text_data_en, "obj_dateheart_161", "\E0다시 해 봐!/%%");
ds_map_add(global.text_data_en, "obj_dateheart_165", "\E0이 셔츠는 원래&'쩌는' 건&아니었지만^1, 내가&발전시켰지./");
ds_map_add(global.text_data_en, "obj_dateheart_166", "전문가 팁^1: 모든&옷들은 이렇게 하면&더 쩔어진다고./%%");
ds_map_add(global.text_data_en, "obj_dateheart_167", "\E1하지만 이건&비밀이 아냐!!!/");
ds_map_add(global.text_data_en, "obj_dateheart_168", "좋은&조언이지!!!/%%");
ds_map_add(global.text_data_en, "obj_dateheart_172", "\E2내 손을&잡으면 내가&답을 알려&줄 거라.../");
ds_map_add(global.text_data_en, "obj_dateheart_173", "\E7아냐!!^1!&버텨야 해!!/%%");
ds_map_add(global.text_data_en, "obj_dateheart_177", "\E0내 다리엔&비밀이 없어./");
ds_map_add(global.text_data_en, "obj_dateheart_178", "노력과 끈기&뿐이지.../%%");
ds_map_add(global.text_data_en, "obj_dateheart_182", "\E3인간의&영혼은 괴물의&영혼보다 강해.../");
ds_map_add(global.text_data_en, "obj_dateheart_183", "\E0그렇지만&우리의 신발&밑창은...!/");
ds_map_add(global.text_data_en, "obj_dateheart_184", "\E3...똑같을&뿐이지./%%");
ds_map_add(global.text_data_en, "obj_dateheart_188", "HAT DIALOGUE./%%");
ds_map_add(global.text_data_en, "obj_dateheart_365", "\E0네가&도망가는 것도&이해해./");
ds_map_add(global.text_data_en, "obj_dateheart_366", "\E2내 쩌는&분위기에&압도당한 거지!/");
ds_map_add(global.text_data_en, "obj_dateheart_367", "\E0하지만 지금&패배를 인정할&순 없어!/%%");
ds_map_add(global.text_data_en, "obj_diamondkid_73", "\W* 메 타 톤  최 고 의  순 간 (TM)^1?&* 상 황 이 \Y 엄 청  안  좋 아 보 일  때 ^1,&  메 타 톤 은  역 동 적 인  포 즈 를  하 지 .\W./");
ds_map_add(global.text_data_en, "obj_diamondkid_74", "* 그  요 리  쇼 에 서  계 란 이&  뜻 대 로  잘  안  될  때 처 럼&  말 이 야 ./%%");
ds_map_add(global.text_data_en, "obj_diamondkid_78", "* 하 지 만 ^1!&* 그 때  이 렇 게  말 하 지 !/");
ds_map_add(global.text_data_en, "obj_diamondkid_79", "\W* 네  요 리  실 력 이  구 려 도 ^1,&  넌  언 제 나\Y  MTT 브 랜 드&  글 램 버 거\W 를  살  수  있 어 !!/");
ds_map_add(global.text_data_en, "obj_diamondkid_80", "\W* 그 러 고  나 서  하 나 를\Y  먹 어 ^1!\W &* 모 두 가  그 걸  좋 아 하 지 !/");
ds_map_add(global.text_data_en, "obj_diamondkid_81", "* ...어 떻 게  입 도  없 이&  음 식 을  먹 냐 고 ?/");
ds_map_add(global.text_data_en, "obj_diamondkid_82", "* 어 ... 글 쎄 ..^1.&* 직 접  쇼 를  보 라 고 !/%%");
ds_map_add(global.text_data_en, "obj_diamondkid_87", "* 그  피 날 레 는  정 말 ..^1.&* 정 말 로  슬 펐 어 !/");
ds_map_add(global.text_data_en, "obj_diamondkid_88", "* 그 리 고  메 타 톤 의&  스 케 줄 은  다 른  쇼&  어 디 에 서 도  안  보 여 .../%%");
ds_map_add(global.text_data_en, "obj_diamondkid_93", "* 쩔 어 주 는  스 케 이 트 보 드 를&  살 까 , 하 고  생 각 하 고&  있 었 어 ./%%");
ds_map_add(global.text_data_en, "obj_diamondkid_98", "\W* 가 장  좋 아 하 는  메 타 톤  순 간&  (TM)은  \Y힐 -턴 을  하 는&  악 당 들\W 을  물 리 칠  때 야 !/");
ds_map_add(global.text_data_en, "obj_diamondkid_99", "* 그 게  원 래  퀴 즈  쇼 여 야&  할 지 라 도  말 이 야 ./%%");
ds_map_add(global.text_data_en, "obj_diamondkid_106", "* 오 ^1! 그 리 고  온 갖&  패 셔 너 블 한  옷 들 을  입 고&  나 올  때 가  좋 아 !/");
ds_map_add(global.text_data_en, "obj_diamondkid_107", "* 그 게  뉴 스  중 계&  시 간 이 어 도  말 야 ./%%");
ds_map_add(global.text_data_en, "obj_diamondkid_112", "* 메 타 톤  은 퇴 한  거 야 ...?/");
ds_map_add(global.text_data_en, "obj_diamondkid_113", "* 은 퇴  안  할  수 는  없 어 ...?/%%");
ds_map_add(global.text_data_en, "obj_diamondkid_119", "* 우 리 가  모 든  종 류 의&  TV 채 널 을  볼  수&  있 는  걸 로  보 이 겠 지 만 .../");
ds_map_add(global.text_data_en, "obj_diamondkid_120", "* 하 지 만 ^1, 그  쇼 들 은&  메 타 톤 에  비 하 면&  없 는  거 나  마 찬 가 지 야 !/%%");
ds_map_add(global.text_data_en, "obj_disembodiedfoxhead_60", "* 여 길  지 나 가 는  문 이&  닫 혀  있 어 ^1?&* 그 래 서  퍼 즐 을  풀 었 다 ?/");
ds_map_add(global.text_data_en, "obj_disembodiedfoxhead_61", "* 근 데  계 속  총 알 이&  다  떨 어 져 서 ^1,&  재 시 작 을  해 야  했 어 ?/");
ds_map_add(global.text_data_en, "obj_disembodiedfoxhead_62", "* 내  동 료 들 은  도 와 주 지 도&  않 아 ^1? 근 데  일 하 러  가 기 도&  싫 어 하 는  것  같 아 ?/%%");
ds_map_add(global.text_data_en, "obj_disembodiedfoxhead_63", "* 한 번  해  보 지  그 래 ^1?&* 저  기 계 를  써 서  말 이 야 ?/%%");
ds_map_add(global.text_data_en, "obj_disembodiedfoxhead_67", "* 와 우 ^1?&* 풀 었 어 ?/");
ds_map_add(global.text_data_en, "obj_disembodiedfoxhead_68", "* 감 동 받 았 어 ^1?&* 완 전  범 생 이 구 만 ?/%%");
ds_map_add(global.text_data_en, "obj_disembodiedfoxhead_73", "* 그 래 서  우 리 는&  자 유 다 ...?/");
ds_map_add(global.text_data_en, "obj_disembodiedfoxhead_74", "* 그  말 은  일 하 러  가 지&  않 아 도  된 단  건 가 ?/%%");
ds_map_add(global.text_data_en, "obj_disembodiedfoxhead_79", "* 나 도  더  이 상  일  하 고&  싶 지  않 은  걸 지 도 ...?/%%");
