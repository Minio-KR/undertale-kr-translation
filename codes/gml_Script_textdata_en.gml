ds_map_add(global.text_data_en, "obj_npc_room_373", "* 내 가  네 게  정 말&  인 형 처 럼  바 보  같 이&  굴 었 던  것  같 군 ./%%");
ds_map_add(global.text_data_en, "obj_npc_room_377", "* 전 에  인 형 처 럼  바 보  같 이&  굴 어 서  미 안 했 어 ./");
ds_map_add(global.text_data_en, "obj_npc_room_378", "* 정 말 로  날  도 와  줬 어 !/%%");
ds_map_add(global.text_data_en, "obj_npc_room_384", "* (달 팽 이 다 .)/");
ds_map_add(global.text_data_en, "obj_npc_room_385", "* (무 슨  이 유 에 선 지 ^1,&  당 신 은  맛 이  궁 금 해 져&  견 딜  수 가  없 다 ...)/%%");
