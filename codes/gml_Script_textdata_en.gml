ds_map_add(global.text_data_en, "obj_tordogcall_205", "* (고 로 롱 ..^1.&  고 로 롱 ...)/");
ds_map_add(global.text_data_en, "obj_tordogcall_206", "* (하 암 ...)/");
ds_map_add(global.text_data_en, "obj_tordogcall_207", "* (껌 벅  껌 벅 .)/");
ds_map_add(global.text_data_en, "obj_tordogcall_208", "* (하 암 ...)/");
ds_map_add(global.text_data_en, "obj_tordogcall_209", "* (고 로 롱 ..^1.&  고 로 롱 ...)/");
ds_map_add(global.text_data_en, "obj_tordogcall_210", "* (피 곤 한  목 소 리 가&  들 린 다 .)\TT/");
ds_map_add(global.text_data_en, "obj_tordogcall_211", "* 멍 멍 아 ..^1.&* 자 ^1, 멍 멍 아 .../");
ds_map_add(global.text_data_en, "obj_tordogcall_212", "* 아 , 이 런 .../");
ds_map_add(global.text_data_en, "obj_tordogcall_213", "* 아 이 는  괜 찮 으 려 나 .../");
ds_map_add(global.text_data_en, "obj_tordogcall_214", "\TS \F0 \T0 %");
