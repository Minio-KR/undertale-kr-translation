ds_map_add(global.text_data_en, "obj_questionasker_130", "하 하 하 , 그 럴  리 가 !&틀 렸 어 요 !");
ds_map_add(global.text_data_en, "obj_questionasker_132", "틀 렸 어 요 ! 알 피 스  님 의&도 움 이  없 어&유 감 이 에 요 !");
ds_map_add(global.text_data_en, "obj_questionasker_134", "아 닙 니 다 ! 알 피 스  님 이 &도 와 줄  수  없 다 니&안 됐 군 요 !");
ds_map_add(global.text_data_en, "obj_questionasker_136", "틀 렸 습 니 다 !!&틀 렸 어 요 !!!&트 으 으 을 렸 어 요 !!");
ds_map_add(global.text_data_en, "obj_questionasker_138", "진 짜  완 전&틀 렸 습 니 다 !!!!!!");
ds_map_add(global.text_data_en, "obj_questionasker_140", "이 봐 요 , 틀 린  게&부 끄 럽 지 도  않 나 요 ,&네 ?");
ds_map_add(global.text_data_en, "obj_questionasker_142", "시 간  다  됐 습 니 다 ! &틀 린  것  같 네 요 ?? ");
ds_map_add(global.text_data_en, "obj_questionasker_144", "아 니  아 니  아 니 ! &글  읽 을  줄&모 르 시 나 요 !?");
ds_map_add(global.text_data_en, "obj_questionasker_151", "맞 습 니 다 !&이 해 하 셨 군 요 !");
ds_map_add(global.text_data_en, "obj_questionasker_153", "정 답 ! 훌 륭 한&답 변 입 니 다 !");
ds_map_add(global.text_data_en, "obj_questionasker_155", "당 신 에 겐&너 무  쉬 웠 나 요 ,&흠 ?????????");
ds_map_add(global.text_data_en, "obj_questionasker_157", "원 더 풀 ! 정 말  놀 랍 군 요 ,&여 러 분 !");
ds_map_add(global.text_data_en, "obj_questionasker_159", "정 답 ! 오 늘  정 말&운 이  좋 으 시 군 요 !!!");
ds_map_add(global.text_data_en, "obj_questionasker_161", "기 억 해 주 시 다 니&황 송 하 군 요 !");
ds_map_add(global.text_data_en, "obj_questionasker_163", "좋 은  대 답 이 에 요 ! &아 주  맘 에  드 네 요 !!!!!!");
ds_map_add(global.text_data_en, "obj_questionasker_165", "물 론  당 신 에 게 는&쉬 운  문 제 였 겠 죠 !");
ds_map_add(global.text_data_en, "obj_questionasker_176", "* 퀴 즈  쇼 가  계 속 된 다 .");
ds_map_add(global.text_data_en, "obj_questionasker_538", "어^1! 어^1! 나&이 거  알 아 !!!&답 은  달 팽 이&아 이 스 크 림 이 야 !!!^1!%");
ds_map_add(global.text_data_en, "obj_questionasker_539", "4화 에 서&모 두 가&해 변 으 로&놀 러  가 는 데 !!!%");
ds_map_add(global.text_data_en, "obj_questionasker_540", "냥 냥 이 가&친 구 들 한 테  줄&아 이 스 크 림 을&사 !!!!%");
ds_map_add(global.text_data_en, "obj_questionasker_541", "하 지 만&달 팽 이  맛 이 고&그 건  냥 냥 이  밖 에&안  좋 아 하 는  거 야 !!!!%");
ds_map_add(global.text_data_en, "obj_questionasker_542", "내 가  게 임 에 서&제 일  좋 아 하 는&부 분 이 기 도  해&왜 냐 하 면 %");
ds_map_add(global.text_data_en, "obj_questionasker_543", "우 정 에&대 해  매 우  강 력 한&메 시 지 ^1를  전 달 하 ^1고&그 리 고 ..^2.%%");
ds_map_add(global.text_data_en, "obj_questionasker_566", "알 피 스 ^1,&알 피 스 ^1,&알 피 스 ./");
ds_map_add(global.text_data_en, "obj_questionasker_567", "설 마  우 리  참 가 자 를&돕 고  있 었 던  건&아 니 겠 죠 ,&그 렇 죠 ?/");
ds_map_add(global.text_data_en, "obj_questionasker_568", "오 오 오 오 오 !!!&진 작  얘 기 하 지&그 랬 어 요 ./");
ds_map_add(global.text_data_en, "obj_questionasker_569", "질 문  하 나 를&내  보 도 록  하 죠 .../");
ds_map_add(global.text_data_en, "obj_questionasker_570", "당 신 이 라 면  답 이  뭔 지&알 겠 죠 !/%%");
ds_map_add(global.text_data_en, "obj_questionasker_598", "알 피 스 ^1, 알 피 스 ^1,&알 피 스 ./");
ds_map_add(global.text_data_en, "obj_questionasker_599", "설 마  우 리  참 가 자 를&돕 고  있 었 던  건&아 니 겠 죠 ,&그 렇 죠 ?/");
ds_map_add(global.text_data_en, "obj_questionasker_600", "오 오 오 오 오 !!!&진 작  얘 기 하 지&그 랬 어 요 ./");
ds_map_add(global.text_data_en, "obj_questionasker_601", "질 문  하 나 를&내  보 도 록  하 죠 .../");
ds_map_add(global.text_data_en, "obj_questionasker_602", "당 신 이 라 면  답 이  뭔 지&알 겠 죠 !/%%");
ds_map_add(global.text_data_en, "obj_questionasker_607", "봤 죠 , 알 피 스 ?&너 무  티 난 다 고&했 잖 아 요 ./");
ds_map_add(global.text_data_en, "obj_questionasker_608", "심 지 어  인 간 도&알 아 냈 잖 아 요 ./");
ds_map_add(global.text_data_en, "obj_questionasker_609", "네 ,&공 책  빈  공 간 에 다&그  이 름 을&휘 갈 기 더 군 요 ./");
ds_map_add(global.text_data_en, "obj_questionasker_610", "프 로 그 램  이 름 도&그  이 름 을  땄 구 요 ./");
ds_map_add(global.text_data_en, "obj_questionasker_613", "심 지 어  둘 이&서 로  한  집 에 서&살 면 서 .../");
ds_map_add(global.text_data_en, "obj_questionasker_614", "전 원 생 활 을  즐 기 는&이 야 기 도  썼 구 요 ./");
ds_map_add(global.text_data_en, "obj_questionasker_615", "사 랑 에  빠 졌 을  확 률 :&101 퍼 센 트 ./");
ds_map_add(global.text_data_en, "obj_questionasker_616", "오 차  범 위 .&1 퍼 센 트 ./%%");
ds_map_add(global.text_data_en, "obj_questionasker_624", "왜  예 능 용  로 봇 이 .../");
ds_map_add(global.text_data_en, "obj_questionasker_625", "전 투  기 능 을&가 지 고  있 겠 어 요 ?/");
ds_map_add(global.text_data_en, "obj_questionasker_626", "간 단 하 죠 ./");
ds_map_add(global.text_data_en, "obj_questionasker_627", "당 연 히&아 스 고 어  드 리 무 어 에 게&잘  보 이 기  위 해 서 죠 !/");
ds_map_add(global.text_data_en, "obj_questionasker_628", "알 피 스 는  그 를&이 렇 게 도  부 르 죠 .../");
ds_map_add(global.text_data_en, "obj_questionasker_629", '"미 스 터  드 리 미 "./');
ds_map_add(global.text_data_en, "obj_questionasker_630", "그  힘  센  팔 .../");
ds_map_add(global.text_data_en, "obj_questionasker_631", "그  무 성 한  수 염 .../");
ds_map_add(global.text_data_en, "obj_questionasker_632", "꼭  모 든  대 장 장 이 들 이&그 러 는  것 처 럼 요 ./");
ds_map_add(global.text_data_en, "obj_questionasker_633", "박 사 님 은  그  건 장 한&남 성 의  상 냥 한  포 옹 을&갈 구 하 시 죠 ./");
ds_map_add(global.text_data_en, "obj_questionasker_634", "정 말 로  그 녀 를&탓 할  수  있 을 까 요 ?/%%");
ds_map_add(global.text_data_en, "obj_questionasker_642", "...진 심 으 로 요 ?/");
ds_map_add(global.text_data_en, "obj_questionasker_643", "세 상 에 ..^1.&어 쩜  그 리  자 만 심 이&강 하 실 까 ...?/");
ds_map_add(global.text_data_en, "obj_questionasker_644", "정 말  마 음 에&드 네 요 !/");
ds_map_add(global.text_data_en, "obj_questionasker_645", "완 전 히  틀 린  대 답 을&하 셨 지 만 ^1,&희 망 을  버 리 진&마 세 요 ./");
ds_map_add(global.text_data_en, "obj_questionasker_646", "박 사 님 이  당 신 을&컴 퓨 터  화 면  너 머 로&지 켜 보 는  걸  봤 어 요 ./");
ds_map_add(global.text_data_en, "obj_questionasker_647", "당 신 이  성 공 할  땐&웃 고 ./");
ds_map_add(global.text_data_en, "obj_questionasker_648", "당 신 이  실 패 할  땐&소 리 를  지 르 셨 죠 ./");
ds_map_add(global.text_data_en, "obj_questionasker_649", "그 리 고  항 상 ,&항 상 .../");
ds_map_add(global.text_data_en, "obj_questionasker_650", "아 니 ! 거 기  말 고 !&저 쪽 으 로  가 야 지 ! 라 고&속 삭 이 셨 죠 ./");
ds_map_add(global.text_data_en, "obj_questionasker_651", "어 찌 보 면 ,&이 게  바 로  사 랑&아 닐 까 요 ??/%%");
ds_map_add(global.text_data_en, "obj_questionasker_657", "정 답 이 에 요 ./");
ds_map_add(global.text_data_en, "obj_questionasker_658", "알 피 스  박 사 님 이&사 랑 에  빠 지 신&상 대 는 .../");
ds_map_add(global.text_data_en, "obj_questionasker_659", "아 무 도  몰 라 요 ./");
ds_map_add(global.text_data_en, "obj_questionasker_660", "자 , 알 피 스  님 은&저  바 깥  어 딘 가 에 서 ./");
ds_map_add(global.text_data_en, "obj_questionasker_661", "누 군 가 가  자 기 를&지 켜 보 고  있 을  거 라&생 각 한 답 니 다 ./");
ds_map_add(global.text_data_en, "obj_questionasker_662", '자 기 를  "귀 엽 다 "고&여 기 거 나  자 기 한 테&"관 심  있 는 " 사 람&말 이 에 요 ./');
ds_map_add(global.text_data_en, "obj_questionasker_663", "안 녕 하 세 요 ,&이 론 적 으 로 만&존 재 하 는  분 ./");
ds_map_add(global.text_data_en, "obj_questionasker_664", "알 피 스  박 사 님 이&당 신 을&좋 아 하 신 대 요 ./");
ds_map_add(global.text_data_en, "obj_questionasker_665", "당 신 이  진 짜 로&존 재 하 시 는  게&아 니 라  아 쉽 네 요 ./");
ds_map_add(global.text_data_en, "obj_questionasker_666", "*조 롱 하 는  웃 음&녹 음  테 이 프 */%%");
ds_map_add(global.text_data_en, "obj_questionasker_691", "저 -저 기 ^1, 이 거  조 사 를&좀  해 봤 었 거 든 !/");
ds_map_add(global.text_data_en, "obj_questionasker_692", "저 기  바 깥  어 딘 가 엔&다 른  우 주 가&있 을  거 야 !/");
ds_map_add(global.text_data_en, "obj_questionasker_693", "어 -언 젠 간 ^1, 아 마 도 ^1,&그  사 람 들 을  만 날&수 도  있 을  거 야 .../%%");
ds_map_add(global.text_data_en, "obj_questionasker_704", '당 신 ,&"냥 냥  고 양 이 소 녀 "에&대 해 서 도  그  말&했 었 어 요 ./');
ds_map_add(global.text_data_en, "obj_questionasker_705", "하 지 만  당 신 에 게&유 리 한  조 건 을&드 리 도 록  하 죠 ./");
ds_map_add(global.text_data_en, "obj_questionasker_706", "거 기 ^1, 만 약  밖 에&계 시 다 면 .../");
ds_map_add(global.text_data_en, "obj_questionasker_707", "지 금  당 장  저 희 에 게&신 호 를  줘 보 시 는  건 ^1,&어 떠 신 가 요 ?/%%");
ds_map_add(global.text_data_en, "obj_questionasker_725", "자 , 증 명  됐 네 요 ,&그 렇 죠 ?/%%");
ds_map_add(global.text_data_en, "obj_questionasker_745", "이 런  이 런  이 런 ./");
ds_map_add(global.text_data_en, "obj_questionasker_746", "알 피 스  박 사 님 이&당 신 을  도 와 준  덕 에 .../");
ds_map_add(global.text_data_en, "obj_questionasker_747", "쇼 에  극 적 인&긴 장 감 이  없 잖 아 요 !/");
ds_map_add(global.text_data_en, "obj_questionasker_748", "이 렇 게  계 속  갈  수 는&없 단  말 입 니 다 !!/");
ds_map_add(global.text_data_en, "obj_questionasker_749", "하 지 만 ./");
ds_map_add(global.text_data_en, "obj_questionasker_750", "하 지 만 !!!/");
ds_map_add(global.text_data_en, "obj_questionasker_751", "이 건  그 냥&첫  화 였 을&뿐 이 었 어 요 !!/");
ds_map_add(global.text_data_en, "obj_questionasker_752", "다 음  시 간 엔 ,&더  많 은  드 라 마 !/");
ds_map_add(global.text_data_en, "obj_questionasker_753", "더  많 은  로 맨 스 !!!/");
ds_map_add(global.text_data_en, "obj_questionasker_754", "더  많 은  피 바 다 가&기 다 리 고  있 습 니 다 !!!/");
ds_map_add(global.text_data_en, "obj_questionasker_755", "다 음  시 간 에  봐 요 ,&달 링 ...!!!/%%");
ds_map_add(global.text_data_en, "obj_readable_modernbook_59", "%%");
ds_map_add(global.text_data_en, "obj_readable_modernbook_60", "* (나 는  여 기 서 ..^1.&* 이  책 을  쓰 고  있 어 .)/");
ds_map_add(global.text_data_en, "obj_readable_modernbook_61", "* (한  사 람 이  들 어 와 서&  내  책 을  집 었 어 ...)/");
ds_map_add(global.text_data_en, "obj_readable_modernbook_62", "* (그 리 고  읽 고  있 잖 아 ...!)/");
ds_map_add(global.text_data_en, "obj_readable_modernbook_63", "* 아 ^1, 미 안 해 ^1.&* 그  책 , 아 직  완 성 이&  덜  된  거 야 ./%%");
ds_map_add(global.text_data_en, "obj_readable_modernbook_68", "* (미 완 성 된  책 들 이 다 .)/%%");
ds_map_add(global.text_data_en, "obj_readable_room1_64", "%%");
ds_map_add(global.text_data_en, "obj_readable_room1_65", "* 두 려 움  없 는  자 만 이  나 아 가 리 라 .&  용 맹 한  자 , 어 리 석 은  자 .&  둘  다  가 운 데  길 은  걷 지  않 는 다 ./%%");
ds_map_add(global.text_data_en, "obj_readable_room1_66", "* 앞 으 로  나 아 가 라 ./%%");
ds_map_add(global.text_data_en, "obj_readable_room1_67", "* 서 쪽  방 은  동 쪽  방 의&  청 사 진 이 다 ./%%");
ds_map_add(global.text_data_en, "obj_readable_room1_68", "* 네  개 의  회 색  바 위  중&  세  개 는  밀 어 주 길&  바 라 고  있 다 ./%%");
ds_map_add(global.text_data_en, "obj_readable_room1_69", "* (벽 에  난  금  사 이 에&  개 미 만 한  개 구 리 가  있 다 ...^1)&* (당 신 에 게  손 을  흔 든 다 .)/%%");
ds_map_add(global.text_data_en, "obj_readable_room1_69_console_1", "* (벽 에  작 은  금 이  나  있 다 .)/");
ds_map_add(global.text_data_en, "obj_readable_room1_69_console_2", "* (사 이 에  개 구 리 가  있 다 ...^2)&* (잠 깐 ^1! 두  마 리 가  있 어 !)/");
ds_map_add(global.text_data_en, "obj_readable_room1_69_console_3", "* (당 신 은  굉 장 하 고 , 아 무 나 &  느 낄  수  없 는  경 험 을  했 다...)/");
ds_map_add(global.text_data_en, "obj_readable_room1_69_console_4", "* (... 두  마 리  개 구 리 를  본 &  사 람 만 이  느 낄  수  있 는 .)/%%");
ds_map_add(global.text_data_en, "obj_readable_room1_70", "* 스 위 치 는  하 나 뿐 이 다 ./%%");
ds_map_add(global.text_data_en, "obj_readable_room1_71", "* 멀 리  있 는  문 은  출 구 가&  아 니 다 ^1.&* 발 상 의  전 환 을  강 조 할  뿐 ./%%");
ds_map_add(global.text_data_en, "obj_readable_room1_72", "* 이 걸  읽 게  된 다 면 ^1,&  파 란  스 위 치 를  누 르 시 오 ./%%");
ds_map_add(global.text_data_en, "obj_readable_room1_73", "* 이 걸  읽 게  된 다 면 ^1,&  빨 간  스 위 치 를  누 르 시 오 ./%%");
ds_map_add(global.text_data_en, "obj_readable_room1_74", "* 이 걸  읽 게  된 다 면 ^1,&  초 록  스 위 치 를  누 르 시 오 ./%%");
ds_map_add(global.text_data_en, "obj_readable_room1_75", "* 이  책 들 은  다  해 졌 다 ..^1.&* 여 러  번  읽 은  것  같 다 ./%%");
ds_map_add(global.text_data_en, "obj_readable_room1_78", "* (낡 은  201X년  연 말  달 력 이 다 .)&* (한  날 짜 에  동 그 라 미 가&  쳐 져  있 다 .)/%%");
ds_map_add(global.text_data_en, "obj_readable_room1_79", "\R* (내 가  왔 던  날 짜 .)/%%");
ds_map_add(global.text_data_en, "obj_readable_room1_81", "* 도 구 들 은  안 전 하 게&  쓰 기  위 해  날 이  무 디 게&  갈 아 졌 다 ./%%");
ds_map_add(global.text_data_en, "obj_readable_room1_82", "* 정 원  가 꾸 는  도 구 들  같 다 ./%%");
ds_map_add(global.text_data_en, "obj_readable_room1_83", "* 멋 진  장 난 감 들 이 다 ^2!&* 하 나 도  흥 미 롭 지  않 다 ./%%");
