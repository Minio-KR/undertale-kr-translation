ds_map_add(global.text_data_en, "obj_countermiddle_116", "* 완 벽 해 요 ^1!&* 잘 했 어 요 ^1, 대 단 해 !/");
ds_map_add(global.text_data_en, "obj_countermiddle_117", "* 이 제  케 이 크 를&  굽 기  위 한  재 료 를&  다  모 았 어 요 !/");
ds_map_add(global.text_data_en, "obj_countermiddle_118", "\W* \Y우 유\W ...&* \Y설 탕\W ...&* \Y달 걀\W .../");
