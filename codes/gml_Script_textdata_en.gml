ds_map_add(global.text_data_en, "SCR_TEXT_3614", "\E1* 음 .../");
ds_map_add(global.text_data_en, "SCR_TEXT_3615", "\E0* 너  아 까 부 터  되 게&  조 용 한  것  같 네 .../");
ds_map_add(global.text_data_en, "SCR_TEXT_3616", "\W*\E8 \R아 스 고 어 \W 님 을  만 나 는  게&  거 -걱 정 돼 ...?/");
