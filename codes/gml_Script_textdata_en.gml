ds_map_add(global.text_data_en, "obj_sosorry_437", "\E8완 전  진 짜  같 거 든 !/%%");
ds_map_add(global.text_data_en, "obj_sosorry_445", "\E1망 쳤 어 .&나  진 짜  망 쳤 어 .&안  돼 ./");
ds_map_add(global.text_data_en, "obj_sosorry_446", "\E2그 냥  보 통  연 필&쓸 게 !&열 심 히  할 게 !/%%");
ds_map_add(global.text_data_en, "obj_sosorry_453", "\E8준 비 됐 어 !?/");
ds_map_add(global.text_data_en, "obj_sosorry_454", "\E0지 금  다  그 렸 어 ./");
ds_map_add(global.text_data_en, "obj_sosorry_455", "\M6여 기  네  그 림 !&어 때 !?/");
ds_map_add(global.text_data_en, "obj_sosorry_456", "\E2너 의  가 장  깊 은&내 면 을  나 타 내 는&거 야 .../");
ds_map_add(global.text_data_en, "obj_sosorry_457", "\E7굉 장 하 지 ^1, 그 치 !?/");
ds_map_add(global.text_data_en, "obj_sosorry_458", ".../");
ds_map_add(global.text_data_en, "obj_sosorry_459", "\E8(내  그 림 이&끔 찍 한 가  봐 .)/");
ds_map_add(global.text_data_en, "obj_sosorry_460", "\M0그 럼 !/");
ds_map_add(global.text_data_en, "obj_sosorry_461", "\E2그 렇 게&  생 각 해 도  돼 !/");
ds_map_add(global.text_data_en, "obj_sosorry_462", "\E7안 녕 !/");
ds_map_add(global.text_data_en, "obj_sosorry_463", "\E8나 중 에  봐 !/");
ds_map_add(global.text_data_en, "obj_sosorry_464", "\E2사 요 나 라 !/");
ds_map_add(global.text_data_en, "obj_sosorry_465", "\E1만 나 서  반 가 웠 어 !/");
ds_map_add(global.text_data_en, "obj_sosorry_466", "\E7Hasta la vista./");
ds_map_add(global.text_data_en, "obj_sosorry_467", "\E9.../");
ds_map_add(global.text_data_en, "obj_sosorry_468", "\E2가 야 겠 다 ./%%");
ds_map_add(global.text_data_en, "obj_sosorry_785", "* 적 은  긴 장 하 는  것  같 다 .");
ds_map_add(global.text_data_en, "obj_sosorry_786", "* 적 은  불 안 해 하 고&  있 는  것  같 다 .");
ds_map_add(global.text_data_en, "obj_sosorry_787", "* 적 은  손 가 락 을&  굴 착 기 처 럼  두 드 리 고  있 다 .");
ds_map_add(global.text_data_en, "obj_sosorry_788", "* 적 은  혼 란 스 러 워  하 는  것  같 다 .");
ds_map_add(global.text_data_en, "obj_sosorry_789", "* 적 은  당 신 과  똑 같 이  하 기&  위 해  당 신 의  움 직 임 을&  따 라 하 려  한 다 .");
ds_map_add(global.text_data_en, "obj_sosorry_790", "* 적 은  최 면  3D 뺑 뺑 이&  공 격 을  사 용 한 다 .");
ds_map_add(global.text_data_en, "obj_sosorry_791", "* 퍼 리 ... 냄 새 가  난 다 .");
ds_map_add(global.text_data_en, "obj_sosorry_792", "* 이 대 로  좋 은 건 가 !?.");
ds_map_add(global.text_data_en, "obj_sosorry_793", "* 적 은  사 신 의  모 습 을&  보 고  사 과 하 고  있 다 .");
ds_map_add(global.text_data_en, "obj_sosorry_826", "* 정 말  미 안&* 이  녀 석 은  분 명  어 울 리 지&  않 는  곳 에  있 다 !/^");
ds_map_add(global.text_data_en, "obj_sosorry_838", "* 당 신 은  손 을  흔 든 다 ^1.&* 조 금  정 신 이  팔 린  것  같 다 ./^");
ds_map_add(global.text_data_en, "obj_sosorry_841", "* 당 신 은  인 사 한 다 ^1.&* 조 금  정 신 이  팔 린  것  같 다 ./^");
ds_map_add(global.text_data_en, "obj_sosorry_844", "* 당 신 은  웃 는 다 ^1.&* 조 금  정 신 이  팔 린  것  같 다 ./^");
ds_map_add(global.text_data_en, "obj_sosorry_847", "* 당 신 은  기 침 을  한 다 ^1.&* 조 금  정 신 이  팔 린  것  같 다 ./^");
ds_map_add(global.text_data_en, "obj_sosorry_850", "* 당 신 은  운 다 ^1.&* 조 금  정 신 이  팔 린  것  같 다 ./^");
ds_map_add(global.text_data_en, "obj_sosorry_950", "\E0오 ^1, 그 리 고  말 야 .../");
ds_map_add(global.text_data_en, "obj_sosorry_951", "\E1아 까  일 들  말 야 ./");
ds_map_add(global.text_data_en, "obj_sosorry_952", "\E4어 ./");
ds_map_add(global.text_data_en, "obj_sosorry_953", "\E2미 안 ,/%%");
ds_map_add(global.text_data_en, "obj_sosorry_1007", "\E1어 어 어 어 어 , 안  돼 !!&그 건  좀  너 무&진 짜  같 잖 아 !/%%");
ds_map_add(global.text_data_en, "obj_spaghetti_98", "* (얼 어 붙 은  스 파 게 티&  한  그 릇 이 다 .)/");
ds_map_add(global.text_data_en, "obj_spaghetti_99", "* (너 무  차 가 워 서 ^1,&  테 이 블 에  붙 어 버 렸 다 ...)/%%");
ds_map_add(global.text_data_en, "obj_spaghetti_102", "* (미 지 근 한  스 파 게 티&  한  그 릇 이 다 .)/");
ds_map_add(global.text_data_en, "obj_spaghetti_103", "* (누 군 가 가  먹 으 려&  하 다 가  그 냥 ..^1.)&* (포 기 한  것  같 다 .)/%%");
ds_map_add(global.text_data_en, "obj_spagnot_98", "* 파 피 루 스 가  남 긴&  쪽 지 다 .../");
ds_map_add(global.text_data_en, "obj_spagnot_99", "\TP %");
ds_map_add(global.text_data_en, "obj_spagnot_100", "인간!! 이 스파게티를&즐겨주길 바란다./");
ds_map_add(global.text_data_en, "obj_spagnot_101", "(넌 잘 모르겠지만,&이 스파게티는...)/");
ds_map_add(global.text_data_en, "obj_spagnot_102", "(널 꾀어내기 위한&함정이다!!!)/");
ds_map_add(global.text_data_en, "obj_spagnot_103", "(먹느라 너무 바빠서...)/");
ds_map_add(global.text_data_en, "obj_spagnot_104", "(네가 앞으로 나아가고&있지 않다는 것도&알아채지 못하겠지!!!)/");
ds_map_add(global.text_data_en, "obj_spagnot_105", "(위대한 파피루스 님에게&또 철저히&농락당했군!!!)/");
ds_map_add(global.text_data_en, "obj_spagnot_106", " &      녜-헤-헤^1,&         파피루스/%%");
ds_map_add(global.text_data_en, "obj_spagnot_110", "* 파 피 루 스 가  남 긴&  쪽 지 다 .../");
ds_map_add(global.text_data_en, "obj_spagnot_111", "\TP %");
ds_map_add(global.text_data_en, "obj_spagnot_112", "어째서인지 스파게티가&아직도 이곳에 있군./");
ds_map_add(global.text_data_en, "obj_spagnot_113", "그런고로 이 스파게티를&모두에게 기부하도록&하겠습니다./");
ds_map_add(global.text_data_en, "obj_spagnot_114", "네 입을 위한&놀이터인 거지!/");
ds_map_add(global.text_data_en, "obj_spagnot_115", " &      녜-헤-헤^1,&         파피루스/%%");
ds_map_add(global.text_data_en, "obj_spagnot_120", "* 지 렁 이 같 은  글 씨 로&  쓰 여  있 어  읽 을  수&  없 다 ./%%");
ds_map_add(global.text_data_en, "obj_spagnot_124", "뭐 라 고 !^1?&이 건  불 가 능 해 ./%%");
ds_map_add(global.text_data_en, "obj_spagnot_127", "미안해^1, 언다인이 도착할&때까지 게스트룸에&널 가둬 둬야 해./");
ds_map_add(global.text_data_en, "obj_spagnot_128", "마음 놓고 네 집처럼&편히 쉬고 있어!!!/");
ds_map_add(global.text_data_en, "obj_spagnot_129", "편안한 안식과&휴식 보장/");
ds_map_add(global.text_data_en, "obj_spagnot_130", " & - 녜스러운^1,&        파피루스/%%");
ds_map_add(global.text_data_en, "obj_spagnot_134", "제발 탈출하기 전에&미리 말 좀 해 줘!!!/");
ds_map_add(global.text_data_en, "obj_spagnot_135", "갑자기 네가 사라지면&걱정돼서 죽을 것&같단 말이야!!!/");
ds_map_add(global.text_data_en, "obj_spagnot_136", " &  - 뼛속까지 좀 강한,&  파피루스/%%");
ds_map_add(global.text_data_en, "obj_spagnot_140", "만약 네가 그저&편히 지낼 장소를&찾는 거면.../");
ds_map_add(global.text_data_en, "obj_spagnot_141", "그냥 재워 달라고 해!!!&나랑 싸울 필요는&없어!!!/");
ds_map_add(global.text_data_en, "obj_spagnot_142", " & - 편히 묵으시오,&   파피루스/%%");
ds_map_add(global.text_data_en, "obj_spagnot_147", "* (쪽 지 의  필 기 는  매 우  이 상 하 다 ,&  글 쓰 는  도 중 에  종 이 가  멋 대 로&  움 직 인  것  같 다 .)/");
ds_map_add(global.text_data_en, "obj_spagnot_148", "* (쓰 여  있 길 ..^1.)&* (점 심  먹 으 러  감 ...?)/%%");
ds_map_add(global.text_data_en, "obj_spagnot_153", "* (반 대 편  함 선 을  쏴 라 ^1!)&* (상 자 를  옮 기 고&  임 무 를  완 수 하 라 .)/%%");
ds_map_add(global.text_data_en, "obj_spagnot_158", "* (반 대 편  함 선 을  쏴 라 ^1!)&* (단  한  발  뿐 이 다 .)/%%");
ds_map_add(global.text_data_en, "obj_spagnot_163", "* (주 목 ^1!)/");
ds_map_add(global.text_data_en, "obj_spagnot_164", "* (오 른 쪽 의  으 스 스 한&  골 목 으 로  들 어 가 면&  멋 진  거 래 를  할  수  있 어 요 !)/%%");
ds_map_add(global.text_data_en, "obj_spiderb_220", "무 슨  일 이 야 ,&자 기 ?/%%");
ds_map_add(global.text_data_en, "obj_spiderb_224", ".../%%");
ds_map_add(global.text_data_en, "obj_spiderb_225", "아 냐 , 아 냐&이 제 는  갈&시 간 이 야 ~/%%");
ds_map_add(global.text_data_en, "obj_spiderb_226", "...&뭐 ... 아 마&한  입&정 도 는 ~/%%");
ds_map_add(global.text_data_en, "obj_spiderb_227", "물 론 ,&농 담 이 야 ~/%%");
ds_map_add(global.text_data_en, "obj_spiderb_228", "한  입 에  꿀 꺽&삼 켜 지 는  게&괜 찮 다 면  말 야 ~&아 후 후 후 ~/%%");
ds_map_add(global.text_data_en, "obj_spiderb_229", "아 후 후 후 ~&음 , 계 속  여 기&있 어 도  별 로&상 관 은  없 는 데 ~/%%");
ds_map_add(global.text_data_en, "obj_spiderb_230", "거 미 줄 에&걸 려  있 으 니&편 하 지 ?/%%");
ds_map_add(global.text_data_en, "obj_spiderb_231", "이 젠  갈&시 간 이 야 ~/%%");
ds_map_add(global.text_data_en, "obj_spiderb_232", "아 후 후 후 ~&뭐  하 는&거 야 ~/%%");
ds_map_add(global.text_data_en, "obj_spiderb_236", "%%%");
ds_map_add(global.text_data_en, "obj_spiderb_240", "왜  그 렇 게  창 백 해 ?&자 부 심 을  가 지 라 고 ~/%%");
ds_map_add(global.text_data_en, "obj_spiderb_245", "맛 있 는  케 이 크 가&될  거 잖 아 ~&아 후 후 후 ~/%%");
ds_map_add(global.text_data_en, "obj_spiderb_250", "놓 아 달 라 고 ^1?&멍 청 한  소 리&하 지  마 ~/%%");
ds_map_add(global.text_data_en, "obj_spiderb_255", "네  영 혼 으 로&모 든  거 미 들 이&행 복 해 질  거 야 ~~~/%%");
ds_map_add(global.text_data_en, "obj_spiderb_256", "너  때 문 에&손 님 들 이  다&무 서 워 하 잖 아 !/%%");
ds_map_add(global.text_data_en, "obj_spiderb_261", "내  정 신  좀  봐 !&애 완 동 물 을&소 개 해  주 는  걸&잊 었 네 ~/");
ds_map_add(global.text_data_en, "obj_spiderb_262", "아 침  식 사  시 간 이 야 ,&그 렇 지 ?&둘 이  잘  놀 아 봐 ~/%%");
ds_map_add(global.text_data_en, "obj_spiderb_267", "너 에  대 해&경 고 한  사 람 이&말 이 야 .../%%");
ds_map_add(global.text_data_en, "obj_spiderb_272", "네  영 혼 에  많 은&돈 을  걸 었 거 든 ./%%");
ds_map_add(global.text_data_en, "obj_spiderb_273", "진 짜  괴 짜  같 았 어 ./%%");
ds_map_add(global.text_data_en, "obj_spiderb_278", "예 쁜  미 소 였 지 ~&그 리 고 ...&아 후 후 ~/%%");
ds_map_add(global.text_data_en, "obj_spiderb_279", "자 기 랑  여 기 서&도 망 쳐 야  한 다 고&하 는  거  있 지 ~~~&아 후 후 후 ~~~/%%");
ds_map_add(global.text_data_en, "obj_spiderb_284", "이 상 하 겠 지 만 ,&난  정 말  그  사 람 이&어 둠  속 에 서 ... 형 체 가&바 뀌 는  걸  봤 어 ...?/%%");
ds_map_add(global.text_data_en, "obj_spiderb_285", "내 가  빠 져 나 갈  수&있 는  길 까 지&열 어 줬 다 니 까 ~/%%");
ds_map_add(global.text_data_en, "obj_spiderb_291", "점 심  시 간 이 네 , &그 렇 지 ? 애 완 동 물 한 테&먹 이  주 는  걸  잊 었 네 ~/%%");
ds_map_add(global.text_data_en, "obj_spiderb_296", "그  돈 이 면 , 이 젠&거 미 들 이  재 결 합 을&할  수  있 다 고 ~/%%");
ds_map_add(global.text_data_en, "obj_spiderb_297", "내 가  여 길  탈 출 하 면&핫 랜 드 의  다 른&구 역 을  막 겠 대 ~/%%");
ds_map_add(global.text_data_en, "obj_spiderb_302", "못  들 어 봤 어 ?&거 미 들 은  몇  세 대 나&폐 허 에  갇 혀&있 었 다 고 !/%%");
ds_map_add(global.text_data_en, "obj_spiderb_303", "바 보  괴 짜  같 으 니 ~&거 미 는  절 대  거 미 줄 을&떠 나 지  않 는 걸 ~/");
ds_map_add(global.text_data_en, "obj_spiderb_304", "(과 자  팔  땐&빼 고 ~)/%%");
ds_map_add(global.text_data_en, "obj_spiderb_309", "문 을  지 나 가 더 라 도 ,&스 노 우 딘 의  치 명 적 인&추 위 는  버 틸  수&없 을  거 야 ./%%");
ds_map_add(global.text_data_en, "obj_spiderb_310", "아 ^1, 지 금  약 간&후 회 되 는  게  있 어 .../%%");
ds_map_add(global.text_data_en, "obj_spiderb_315", "하 지 만  네  영 혼 에&걸 린  돈 이 면 , 따 뜻 한&리 무 진 을  렌 트 할  수&있 을  거 야 ~/%%");
ds_map_add(global.text_data_en, "obj_spiderb_316", "그 래 ^1, 기 회 가  있 었 을&때  그  녀 석 을  거 미 줄 로&싸  놓 아 야  했 어 ~/%%");
ds_map_add(global.text_data_en, "obj_spiderb_321", "그 럼  남 은  돈 으 론 ...^1?&멋 진  휴 가 를&보 낼  수  있 었 겠 지 ~/");
ds_map_add(global.text_data_en, "obj_spiderb_322", "아 님  거 미  야 구 장 을&짓 거 나 ~/%%");
ds_map_add(global.text_data_en, "obj_spiderb_323", "아 주  먹 음 직 스 러 운&도 넛 을  만 들  수&있 었 을  것  같 았 거 든 ~/%%");
ds_map_add(global.text_data_en, "obj_spiderb_328", "이 야 기 는  여 기 까 지 ...&저 녁  시 간 이 지 ?&아 후 후 후 후 ~/%%");
ds_map_add(global.text_data_en, "obj_spiderb_336", "너 무  파 랗 게&질 려 있 진  마 ^1,&자 기 ~/%%");
ds_map_add(global.text_data_en, "obj_spiderb_599", "* 머 펫 이  당 신 에 게&  거 미  한  컵 을  부 었 다 .");
ds_map_add(global.text_data_en, "obj_spiderb_600", "* 모 든  거 미 들 이  음 악 에  맞 춰&  박 수 를  치 고  있 다 .");
ds_map_add(global.text_data_en, "obj_spiderb_601", "* 머 펫 은  다 른  거 미 들 과&  함 께  춤 을  추 고  있 다 .");
ds_map_add(global.text_data_en, "obj_spiderb_602", "* 머 펫 은  당 신  주 위 로&  거 미 줄 을  옭 아 맸 다 .");
ds_map_add(global.text_data_en, "obj_spiderb_603", "* 갓  구 운  거 미 줄  냄 새 가  난 다 .");
