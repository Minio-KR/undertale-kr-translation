ds_map_add(global.text_data_en, "SCR_TEXT_4505", "* (좋 아 ^1, 이 젠  노 란 색&  이 름 을  쓰 지  말 라 고&  당 부 해 야 겠 네 .)/%%");
ds_map_add(global.text_data_en, "SCR_TEXT_4511", "* 개 굴 ^1, 개 굴 ^1.&* (노 란 색  이 름 이&  없 는  건  어 때 ?)/");
ds_map_add(global.text_data_en, "SCR_TEXT_4512", "                     다 시 &         꽤 나         되 돌 려 &         훌 륭 해       줘 \C");
