ds_map_add(global.text_data_en, "obj_readable_room1_164", "* 바 닥 에 는  포 도 라 니 안 이  든&  상 자 가  있 다 ./%%");
ds_map_add(global.text_data_en, "obj_readable_room1_198", "* (괴 물 들 의  장 례 식 에  대 한&  학 교  리 포 트 다 .)/");
ds_map_add(global.text_data_en, "obj_readable_room1_199", "* 괴 물 들 의  장 례 식 은 ^1,&  말 하 자 면 ^2, 진 짜  멋 지 다 ./");
ds_map_add(global.text_data_en, "obj_readable_room1_200", "* 괴 물 들 은  늙 어 서  죽 으 면 ^1,&  먼 지 로  변 한 다 ./");
ds_map_add(global.text_data_en, "obj_readable_room1_201", "* 장 례 식 에 서 ^1, 그  먼 지 를  모 아&  그  사 람 이  제 일  좋 아 했 던&  것  위 에  뿌 린 다 ./");
ds_map_add(global.text_data_en, "obj_readable_room1_202", "* 그 러 면  그 들 의  정 수 가&  그  물 건 에 서&  살 아 가 는  것 이 다 .../");
ds_map_add(global.text_data_en, "obj_readable_room1_203", "* 어 어 어 ^1, 글 자  수  제 한&  아 직  못  채 웠 나 ^1?&* 더  이 상  쓰 기  싫 은 데 ./%%");
ds_map_add(global.text_data_en, "obj_readable_room1_208", "\W* 엄 마 가  그 러 는 데  잠 을  자 면&  \Y최 대  HP보 다  더  높 게\W &  회 복 할  수  있 대 요 ./");
ds_map_add(global.text_data_en, "obj_readable_room1_209", "* ... 최 대  HP가  뭐 예 요 ?/%%");
ds_map_add(global.text_data_en, "obj_readable_room1_213", "* 엄 마 가  그 러 는 데  이 제  우 린&  지 상 으 로  나 갈  수  있 대 요 !/");
ds_map_add(global.text_data_en, "obj_readable_room1_214", "* ...근 데  그 게  좋 은  거 예 요 ^1?&  이 사 가 기  싫 은 데 ./%%");
ds_map_add(global.text_data_en, "obj_readable_room1_219", "* (그 냥  인 형 이 다 .)/%%");
ds_map_add(global.text_data_en, "obj_readable_room1_228", '* "영 혼 을  취 하 는  힘 "./');
ds_map_add(global.text_data_en, "obj_readable_room1_229", "* 이 것 이  인 간 들 이&  두 려 워 했 던  힘 이 다 ./%%");
ds_map_add(global.text_data_en, "obj_readable_room1_235", "* (고 대 의  글 이  벽 을  덮 고  있 다 ..^1.&  겨 우  읽 을  수  있 다 .)/");
ds_map_add(global.text_data_en, "obj_readable_room1_236", '* "인 간 과  괴 물 의  전 쟁 "./%%');
ds_map_add(global.text_data_en, "obj_readable_room1_241", "* 북 쪽  방 은  위 대 한  보 물 을&  숨 기 고  있 다 ./%%");
ds_map_add(global.text_data_en, "obj_readable_room1_247", "* 다 치 고 , 패 배 하 고 ,&  목 숨 이  아 까 웠 던  우 린 ,&  인 간 들 에 게  항 복 했 다 ./");
ds_map_add(global.text_data_en, "obj_readable_room1_248", "* 인 간 들  중  가 장  위 대 한&  일 곱  마 법 사 가  마 법  주 문 으 로&  우 리 를  지 하 에  가 둬  놓 았 다 ./");
ds_map_add(global.text_data_en, "obj_readable_room1_249", "* 무 엇 이 든  결 계 를  넘 어 올  수&  있 지 만 , 오 직  강 력 한  영 혼 을&  가 진  자 만 이  나 갈  수  있 다 ./%%");
ds_map_add(global.text_data_en, "obj_readable_room1_256", "* 그 렇 지 만 ...&* 예 언 이  있 다 ./");
ds_map_add(global.text_data_en, "obj_readable_room1_257", "* 천 사 ...&* 지 상 을  목 격 한  적 이&  있 는  천 사 가 .../");
ds_map_add(global.text_data_en, "obj_readable_room1_258", "* 돌 아 올  것 이 다 .&* 그 리 고  지 하  세 계 는&  텅  비 게  될  것 이 다 ./%%");
ds_map_add(global.text_data_en, "obj_readable_room1_263", "* 고 대 의  글 자  위 에&  21가 지  다 른  맛 의  목 록 이&  칠 해 져  있 다 ./%%");
ds_map_add(global.text_data_en, "obj_readable_room1_269", "* 에 취 ^1!&* 벌 레 는  걸 리 지  않 고 ^1,&  감 기 에  걸 려 버 렸 네 .../%%");
ds_map_add(global.text_data_en, "obj_readable_room1_274", "* 우 리 의  힘 을  두 려 워 한&  인 간 들 은 ^1, 전 쟁 을  선 포 했 다 ./");
ds_map_add(global.text_data_en, "obj_readable_room1_275", "* 그 들 은  갑 자 기  공 격 했 고 ,&  자 비 란  없 었 다 ./%%");
ds_map_add(global.text_data_en, "obj_readable_room1_280", "* 촛 불 이 나  마 법 이  없 을  때 ^1,&  괴 물 들 은  크 리 스 털 을&  이 용 해  방 향 을  찾 는 다 ./%%");
ds_map_add(global.text_data_en, "obj_readable_room1_292", "* (다  낡 은 , 고 양 이  귀 가  달 린&  여 자 의  피 규 어 다 .)/%%");
ds_map_add(global.text_data_en, "obj_readable_room1_293", "* (너 무  어 두 워 서&  볼  수  없 다 .)/%%");
ds_map_add(global.text_data_en, "obj_readable_room1_299", "* (과 학  서 적 들 이 다 ^1.)&* (먼 지 투 성 이 다 .)/%%");
ds_map_add(global.text_data_en, "obj_readable_room1_304", "* (냉 장 고 다 ^1.)&* (이 상 하 게  따 뜻 하 다 .)/%%");
ds_map_add(global.text_data_en, "obj_readable_room1_306", "* (너 무  어 두 워 서&  볼  수  없 다 .)/%%");
ds_map_add(global.text_data_en, "obj_readable_room1_312", "* 우 유 ^1? 달 걀 ^1? 냉 장 고 에 ^1?/");
ds_map_add(global.text_data_en, "obj_readable_room1_313", "* 아 니 죠 ^1, 달 링 ^1!&* 감 기 에  걸 릴 걸 요 !!!/%%");
ds_map_add(global.text_data_en, "obj_readable_room1_320", "* 따 르 릉 .../");
ds_map_add(global.text_data_en, "obj_readable_room1_321", "\TS \E3 \F6 \TA %");
ds_map_add(global.text_data_en, "obj_readable_room1_322", "* 음 ^1, 과 자 를  가 져 오 는  게&  정 말  좋 은  생 각 일 까 ?/");
ds_map_add(global.text_data_en, "obj_readable_room1_323", "\E8* 뭐 , 널  판 단 하 지 는&  말 아 야  할  것  같 네 .../");
ds_map_add(global.text_data_en, "obj_readable_room1_324", "\E0* 결 국 엔 , 난  잠 옷  입 고&  감 자 칩 이 나  먹 는&  녀 석 인  거 야 !/");
ds_map_add(global.text_data_en, "obj_readable_room1_325", "\E5* 어 어 , 내  말 은 ..^1.&* 저 -저 기 ^1, 오 른 쪽 으 로&  가  봐 !/%%");
ds_map_add(global.text_data_en, "obj_readable_room1_328", "* 따 르 릉 .../");
ds_map_add(global.text_data_en, "obj_readable_room1_329", "\TS \E3 \F6 \TA %");
ds_map_add(global.text_data_en, "obj_readable_room1_330", "* 저 -저 기 ^1!&* 오 른 쪽 으 로  가 !/%%");
ds_map_add(global.text_data_en, "obj_readable_room1_347", "* 난  찬  음 식 이  싫 어 ./");
ds_map_add(global.text_data_en, "obj_readable_room1_349", "\E0* 알 피 스 는  내  냉 장 고 를&  대 신  음 식 을  데 우 도 록&  개 조 해  줬 지 !/");
ds_map_add(global.text_data_en, "obj_readable_room1_350", "\E6* 뜨 거 운  냉 장 고 ..^1.&* 세 계  최 고 의&  발 명 품 이 야 !/%%");
ds_map_add(global.text_data_en, "obj_readable_room1_354", "\E6* 뜨 거 운  냉 장 고 ..^1.&* 세 계  최 고 의&  발 명 품 이 야 !/%%");
ds_map_add(global.text_data_en, "obj_readable_room1_360", "* 이  오 븐 은&  최 고 급  MTT 제 품 이 지 ./");
ds_map_add(global.text_data_en, "obj_readable_room1_361", "\E4* 하 지 만  있 지 ,&  기 술 이  아 무 리&  발 전 한 다  해 도 .../");
ds_map_add(global.text_data_en, "obj_readable_room1_362", "\E0* 화 염  마 법 으 로  만 드 는&  홈 메 이 드  요 리 는&  이 길  수 가  없 어 ./%%");
